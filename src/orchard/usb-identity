#!/bin/sh
# Stable USB identity, shared by installed-system and RAM gadgets. The boot
# stage copies serial-number from Apple's tree; never publish it in the clear.
set -eu
tree=${ORCHARD_DEVICE_TREE:-/proc/device-tree}
board=$(tr '\000' '\n' < "$tree/compatible" | head -1)
serial=
if [ -r "$tree/serial-number" ]; then
    serial=$(tr -d '\000' < "$tree/serial-number")
fi
if [ -n "$serial" ]; then
    id=$(printf 'orchard-%s' "$serial" | sha256sum | cut -c1-12)
    printf 'BOARD:%s ID:%s\n' "${board#apple,}" "$id"
else
    # Keep rescue serial and SSH reachable on trees without a hardware ID.
    # This legacy fallback cannot retain the host's accessory approval.
    echo 'orchard: no device-tree serial-number; using per-boot USB identity' >&2
    printf 'BOOT:%s BOARD:%s\n' "$(cat /proc/sys/kernel/random/boot_id)" "${board#apple,}"
fi
