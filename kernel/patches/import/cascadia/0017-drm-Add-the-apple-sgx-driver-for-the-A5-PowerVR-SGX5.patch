+	[B_794]		= { "794",	0x14000, 0x100000, SRC_ZERO },
+	[B_798]		= { "798",	0x1000,	0x1000, SRC_ZERO },
+	[B_79C]		= { "79c",	0x8000,	0x1000, SRC_ZERO },
+	[B_7A0]		= { "7a0",	0x28000, 0x1000, SRC_ZERO },
