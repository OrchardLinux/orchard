From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rzxvx <rrzxznewid@gmail.com>
Date: Sat, 26 Sep 2026 21:21:08 +0300
Subject: [PATCH] ARM: apple: S5L bring-up workarounds and trace points in core
 code

Imported unchanged from Project Cascadia (https://github.com/rzxvx/Project-Cascadia) at c20b85e:
  patches/tree/0001-cascadia.patch

Cascadia history of these files: rzxvx <rrzxznewid@gmail.com> (3 commits).

[Orchard: imported for the armv7-a5 platform; see kernel/sources.toml]
---
 arch/arm/kernel/entry-armv.S | 10 +++++
 arch/arm/kernel/smp.c        |  3 +-
 arch/arm/mm/alignment.c      |  9 ++--
 init/main.c                  | 87 +++++++++++++++++++++++++++++++++++-
 kernel/fork.c                | 24 ++++++++++
 5 files changed, 126 insertions(+), 7 deletions(-)

diff --git a/arch/arm/kernel/entry-armv.S b/arch/arm/kernel/entry-armv.S
index 1dfae1af8..e4084f15d 100644
--- a/arch/arm/kernel/entry-armv.S
+++ b/arch/arm/kernel/entry-armv.S
@@ -224,6 +224,15 @@ ENDPROC(__dabt_svc)
 	.align	5
 __irq_svc:
 	svc_entry
+	@ P105 aic1q24: like lab IRQ stub — force SPSR.I, skip C irq_enter/exit.
+	ldr	r0, =apple_aic1_early_irq_escape
+	ldrb	r0, [r0]
+	cmp	r0, #0
+	beq	1001f
+	ldr	r5, [sp, #S_PSR]
+	orr	r5, r5, #PSR_I_BIT
+	svc_exit r5, irq = 1
+1001:
 	irq_handler from_user=0
 
 #ifdef CONFIG_PREEMPTION
@@ -235,6 +244,7 @@ __irq_svc:
 	blne	svc_preempt
 #endif
 
+	ldr	r5, [sp, #S_PSR]
 	svc_exit r5, irq = 1			@ return from exception
  UNWIND(.fnend		)
 ENDPROC(__irq_svc)
diff --git a/arch/arm/kernel/smp.c b/arch/arm/kernel/smp.c
index 3431c0553..2d46adad3 100644
--- a/arch/arm/kernel/smp.c
+++ b/arch/arm/kernel/smp.c
@@ -469,7 +469,8 @@ asmlinkage void secondary_start_kernel(struct task_struct *task)
 	complete(&cpu_running);
 
 	local_irq_enable();
-	local_fiq_enable();
+	/* Cascadia: the A5's AIC delivers everything as IRQ; FIQ stays off on
+	 * secondaries until something is known to need it. */
 	local_abt_enable();
 
 	/*
diff --git a/arch/arm/mm/alignment.c b/arch/arm/mm/alignment.c
index 3c6ddb1af..c9e36089c 100644
--- a/arch/arm/mm/alignment.c
+++ b/arch/arm/mm/alignment.c
@@ -343,7 +343,7 @@ do_alignment_ldrhstrh(unsigned long addr, u32 instr, struct pt_regs *regs)
 
 	ai_half += 1;
 
-	if (user_mode(regs))
+	if (user_mode(regs) || addr < TASK_SIZE)
 		goto user;
 
 	if (LDST_L_BIT(instr)) {
@@ -405,7 +405,7 @@ do_alignment_ldrdstrd(unsigned long addr, u32 instr, struct pt_regs *regs)
 
 	ai_dword += 1;
 
-	if (user_mode(regs))
+	if (user_mode(regs) || addr < TASK_SIZE)
 		goto user;
 
 	if (load) {
@@ -454,7 +454,8 @@ do_alignment_ldrstr(unsigned long addr, u32 instr, struct pt_regs *regs)
 
 	ai_word += 1;
 
-	if ((!LDST_P_BIT(instr) && LDST_W_BIT(instr)) || user_mode(regs))
+	if ((!LDST_P_BIT(instr) && LDST_W_BIT(instr)) || user_mode(regs) ||
+	    addr < TASK_SIZE)
 		goto trans;
 
 	if (LDST_L_BIT(instr)) {
@@ -545,7 +546,7 @@ do_alignment_ldmstm(unsigned long addr, u32 instr, struct pt_regs *regs)
 	}
 #endif
 
-	if (user_mode(regs)) {
+	if (user_mode(regs) || addr < TASK_SIZE) {
 		unsigned int __ua_flags = uaccess_save_and_enable();
 		for (regbits = REGMASK_BITS(instr), rd = 0; regbits;
 		     regbits >>= 1, rd += 1)
diff --git a/init/main.c b/init/main.c
index c4778edae..296545649 100644
--- a/init/main.c
+++ b/init/main.c
@@ -698,6 +698,12 @@ static void __init setup_command_line(char *command_line)
 
 static __initdata DECLARE_COMPLETION(kthreadd_done);
 
+#ifdef CONFIG_ARCH_APPLE_S5L
+void p105_fb_dbg(const char *msg);
+pid_t __init apple_s5l_rest_spawn_init(int (*fn)(void *), void *arg,
+				       unsigned long flags);
+#endif
+
 static noinline void __ref __noreturn rest_init(void)
 {
 	struct task_struct *tsk;
@@ -709,7 +715,13 @@ static noinline void __ref __noreturn rest_init(void)
 	 * the init task will end up wanting to create kthreads, which, if
 	 * we schedule it before we create kthreadd, will OOPS.
 	 */
+#ifdef CONFIG_ARCH_APPLE_S5L
+	p105_fb_dbg("rest_init");
+	p105_fb_dbg("pre_spawn");
+	pid = apple_s5l_rest_spawn_init(kernel_init, NULL, CLONE_FS);
+#else
 	pid = user_mode_thread(kernel_init, NULL, CLONE_FS);
+#endif
 	/*
 	 * Pin init on the boot CPU. Task migration is not properly working
 	 * until sched_init_smp() has been run. It will set the allowed
@@ -1277,7 +1289,10 @@ int __init_or_module do_one_initcall(initcall_t fn)
 	}
 	if (irqs_disabled()) {
 		strlcat(msgbuf, "disabled interrupts ", sizeof(msgbuf));
-		local_irq_enable();
+#ifdef CONFIG_ARCH_APPLE_S5L
+		if (!early_boot_irqs_disabled)
+#endif
+			local_irq_enable();
 	}
 	WARN(msgbuf[0], "initcall %pS returned with %s\n", fn, msgbuf);
 
@@ -1466,6 +1481,64 @@ static int __ref kernel_init(void *unused)
 	 */
 	wait_for_completion(&kthreadd_done);
 
+	/*
+	 * P105AP: AIC bring-up before initcalls.
+	 */
+#ifdef CONFIG_ARCH_APPLE_S5L
+	{
+		void apple_aic1_quiesce(void);
+		void apple_aic1_hw_quiesce(void);
+		void apple_aic1_enable(void);
+		void apple_aic1_arm_cpu0(void);
+		extern bool apple_aic1_early_irq_escape;
+
+		p105_fb_dbg("irq_quiesce");
+		apple_aic1_quiesce();
+		apple_aic1_hw_quiesce();
+		/* CFG off; keep early_irq_escape for sticky nIRQ */
+		p105_fb_dbg("irq_try");
+		early_boot_irqs_disabled = false;
+		local_irq_enable();
+		p105_fb_dbg("irq_on");
+		local_irq_disable();
+		apple_aic1_enable();
+		apple_aic1_arm_cpu0();
+		local_irq_enable();
+		p105_fb_dbg("irq_arm");
+		local_irq_disable();
+		early_boot_irqs_disabled = true;
+		p105_fb_dbg("irq_frz");
+	}
+#else
+#endif
+	p105_fb_dbg("init_go");
+#ifdef CONFIG_ARCH_APPLE_S5L
+	{
+		void apple_aic1_release_escape(void);
+		void apple_aic1_quiesce(void);
+		void apple_aic1_hw_quiesce_quiet(void);
+		void apple_aic1_rearm(void);
+
+		p105_fb_dbg("init_go");
+		apple_aic1_quiesce();
+		apple_aic1_hw_quiesce_quiet();
+		/* FIX (2026-09-14): both quiesce calls above clear CFG.ENABLE and zero
+		 * TARGET_CPU for all 192 lines.  Without this re-arm the AIC stays dead
+		 * for the whole of do_initcalls(), which is why every /proc/interrupts
+		 * counter (incl. IPIs) stayed at 0. */
+		apple_aic1_rearm();
+		p105_fb_dbg("irq_rearm");
+		early_boot_irqs_disabled = false;
+		p105_fb_dbg("irq_thaw");
+		local_irq_enable();
+		p105_fb_dbg("thaw_on");
+		apple_aic1_release_escape();
+		p105_fb_dbg("esc_off");
+	}
+#endif
+#ifdef CONFIG_ARCH_APPLE_S5L
+	p105_fb_dbg("kt_done");
+#endif
 	kernel_init_freeable();
 	/* need to finish all async __init code before freeing the memory */
 	async_synchronize_full();
@@ -1475,6 +1548,13 @@ static int __ref kernel_init(void *unused)
 	ftrace_free_init_mem();
 	kgdb_free_init_mem();
 	exit_boot_config();
+#ifdef CONFIG_ARCH_APPLE_S5L
+	{
+		void p105_fb_dbg_shutdown(void);
+
+		p105_fb_dbg_shutdown();
+	}
+#endif
 	free_initmem();
 	mark_readonly();
 
@@ -1492,7 +1572,10 @@ static int __ref kernel_init(void *unused)
 	do_sysctl_args();
 
 	if (ramdisk_execute_command) {
-		ret = run_init_process(ramdisk_execute_command);
+	#ifdef CONFIG_ARCH_APPLE_S5L
+	p105_fb_dbg("init_run");
+#endif
+	ret = run_init_process(ramdisk_execute_command);
 		if (!ret)
 			return 0;
 		pr_err("Failed to execute %s (error %d)\n",
diff --git a/kernel/fork.c b/kernel/fork.c
index 22f43721d..eb4f68a52 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -2814,7 +2814,14 @@ pid_t kernel_clone(struct kernel_clone_args *args)
 		task_unlock(p);
 	}
 
+#ifdef CONFIG_ARCH_APPLE_S5L
+void p105_fb_dbg(const char *msg);
+	p105_fb_dbg("kc_wake");
+#endif
 	wake_up_new_task(p);
+#ifdef CONFIG_ARCH_APPLE_S5L
+	p105_fb_dbg("kc_woke");
+#endif
 
 	/* forking complete and child started to run, tell ptracer */
 	if (unlikely(trace))
@@ -2825,7 +2832,13 @@ pid_t kernel_clone(struct kernel_clone_args *args)
 			ptrace_event_pid(PTRACE_EVENT_VFORK_DONE, pid);
 	}
 
+#ifdef CONFIG_ARCH_APPLE_S5L
+	p105_fb_dbg("kc_put");
+#endif
 	put_pid(pid);
+#ifdef CONFIG_ARCH_APPLE_S5L
+	p105_fb_dbg("kc_out");
+#endif
 	return nr;
 }
 
@@ -2851,8 +2864,19 @@ pid_t kernel_thread(int (*fn)(void *), void *arg, const char *name,
 /*
  * Create a user mode thread.
  */
+#ifdef CONFIG_ARCH_APPLE_S5L
+void p105_fb_dbg(const char *msg);
+#endif
+
 pid_t user_mode_thread(int (*fn)(void *), void *arg, unsigned long flags)
 {
+#ifdef CONFIG_ARCH_APPLE_S5L
+	static int apple_fork_fb_left = 32;
+	if (apple_fork_fb_left > 0) {
+		apple_fork_fb_left--;
+		p105_fb_dbg("umt_in");
+	}
+#endif
 	struct kernel_clone_args args = {
 		.flags		= ((lower_32_bits(flags) | CLONE_VM |
 				    CLONE_UNTRACED) & ~CSIGNAL),
