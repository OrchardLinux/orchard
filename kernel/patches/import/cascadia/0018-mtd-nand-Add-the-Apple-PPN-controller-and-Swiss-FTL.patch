--- /dev/null
+++ b/drivers/mtd/nand/apple/Kbuild
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Apple A5 PPN NAND controller and Swiss FTL.
+#
+# In the tree, CONFIG_APPLE_SFTL_WRITE selects the write path; as an external
+# module build it is on unless SFTL_READONLY=1.  The test-only failure
+# injection is CONFIG_APPLE_PPN_FAULT_INJECT in the tree, PPN_FAULT_INJECT=1
+# for an external build; off by default in both.
+ifneq ($(KBUILD_EXTMOD),)
+CONFIG_APPLE_PPN := m
+CONFIG_APPLE_SFTL := m
+ifneq ($(SFTL_READONLY),1)
+CONFIG_APPLE_SFTL_WRITE := y
+endif
+ifeq ($(PPN_FAULT_INJECT),1)
+ccflags-y += -DCONFIG_APPLE_PPN_FAULT_INJECT
+endif
+endif
+obj-$(CONFIG_APPLE_PPN) += apple_ppn.o
+obj-$(CONFIG_APPLE_SFTL) += apple_ftl.o
+apple_ftl-y := apple_ftl_main.o sftl_map.o sftl_mount.o sftl_format.o sftl_lwvm.o
+ifeq ($(CONFIG_APPLE_SFTL_WRITE),y)
+apple_ftl-y += sftl_write.o
+else
+ccflags-y += -DSFTL_NO_WRITE
+endif
diff --git a/drivers/mtd/nand/apple/Kconfig b/drivers/mtd/nand/apple/Kconfig
new file mode 100644
index 000000000000..72963c68b5b9
--- /dev/null
+++ b/drivers/mtd/nand/apple/Kconfig
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config APPLE_PPN
+	tristate "Apple A5 PPN NAND controller (PIO)"
+	depends on ARCH_APPLE_S5L || COMPILE_TEST
+	help
+	  The FMI/FMC controller of the Apple A5 and its PPN NAND package,
+	  driven by PIO.  Only the package on the iPad mini 1 (P105) is
+	  supported.  Program and erase need the allow_write parameter.
+
+config APPLE_SFTL
+	tristate "Swiss FTL block devices on the Apple PPN NAND"
+	depends on APPLE_PPN && BLOCK
+	help
+	  Exposes the iOS Swiss FTL and its LwVM volumes as block devices.
+	  Read-only unless enable_write and write_volume are set.
+
+config APPLE_SFTL_WRITE
+	bool "Program, erase and the FTL writer"
+	depends on APPLE_SFTL
+	default y
+	help
+	  Builds the program and erase sequences and the FTL write path.
+	  Without it nothing in either driver can change the NAND.  With it,
+	  writing still needs apple_ppn.allow_write, apple_ftl.enable_write
+	  and apple_ftl.write_volume on the command line.
+
+config APPLE_PPN_FAULT_INJECT
+	bool "Test-only program and erase failure injection"
+	depends on APPLE_SFTL_WRITE
+	default n
+	help
+	  Adds apple_ppn parameters (inject_program, inject_mode,
+	  inject_erase) that make a program or an erase look failed, for
+	  testing the FTL's bad-block handling.  Say N.
diff --git a/drivers/mtd/nand/apple/apple_ftl_main.c b/drivers/mtd/nand/apple/apple_ftl_main.c
new file mode 100644
index 000000000000..53674b239277
--- /dev/null
+++ b/drivers/mtd/nand/apple/apple_ftl_main.c
@@ -0,0 +1,538 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Swiss FTL block devices for the iPad mini 1 PPN NAND.
+ *
+ * Exposes the FTL as ftl0 (all reported LBAs) and ftl0pN (one per LwVM
+ * volume).  Everything is read-only unless enable_write is set on the kernel
+ * command line, the controller permits it, and the volume is the one named
+ * by write_volume; even then System, Data and effaceable volumes refuse.
+ *
+ * Written from devices/a5/docs/research/p105-nand-spec.md.  Credit: the
+ * on-media format shared with the iPhone 5 and the first write path on this
+ * package are the work of crystal-lized.
+ */
+
+#include <linux/blk-mq.h>
+#include <linux/blkdev.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/reboot.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+
+#include "apple_ppn.h"
+#include "sftl.h"
+#include "sftl_port.h"
+
+#define FTL_NAME		"ftl"
+#define FTL_MAX_DISKS		(SFTL_MAX_PARTS + 1)
+#define FTL_WHOLE_DISK		((u32)-1)
+#define MAX_REQ_LBAS		(SFTL_BATCH_PAGES * SFTL_LBAS_PER_PAGE)
+#define EFFACEABLE_ATTRS	0x3000000000000ull
+
+static bool auto_mount = true;
+module_param(auto_mount, bool, 0444);
+
+static bool enable_write;
+module_param(enable_write, bool, 0444);
+MODULE_PARM_DESC(enable_write, "Allow the FTL to write");
+
+static char *write_volume = "";
+module_param(write_volume, charp, 0444);
+MODULE_PARM_DESC(write_volume, "Name of the only LwVM volume that may be written");
+
+static bool skip_checkpoint;
+module_param(skip_checkpoint, bool, 0644);
+MODULE_PARM_DESC(skip_checkpoint,
+		 "Test only: unmount without the final checkpoint, as a crash would");
+
+static unsigned int verify_every = SFTL_VERIFY_DEFAULT;
+module_param(verify_every, uint, 0444);
+MODULE_PARM_DESC(verify_every, "Read back every Nth programmed page (1 = all)");
+
+struct ftl_instance;
+
+struct ftl_disk {
+	struct gendisk *gd;
+	struct ftl_instance *inst;
+	u32 part;			/* partition index, or FTL_WHOLE_DISK */
+	u32 nlbas;
+	bool writable;
+};
+
+struct ftl_instance {
+	struct apple_ppn *ppn;
+	struct sftl fs;
+	struct sftl_lwvm lv;
+	struct mutex lock;		/* serialises every media operation */
+	struct blk_mq_tag_set tag_set;
+	struct ftl_disk disk[FTL_MAX_DISKS];
+	unsigned int ndisks;
+	bool writing;
+	bool going;
+	u8 *xfer;			/* MAX_REQ_LBAS * 4 KiB */
+	u8 *tmp_lba;
+};
+
+static DEFINE_MUTEX(ftl_global_lock);
+static struct ftl_instance *ftl_mounted;
+static int ftl_major;
+
+/* ---- glue between the portable core and the PPN driver ---------------- */
+
+static int glue_read(void *hw, unsigned int bank, unsigned int block, unsigned int page,
+		     bool slc, u8 *data, u8 *meta, u8 *status)
+{
+	return apple_ppn_read_page(hw, bank, block, page, slc, data, meta, status);
+}
+
+static int glue_erase(void *hw, unsigned int bank, unsigned int block)
+{
+	return apple_ppn_erase(hw, bank, block);
+}
+
+static int glue_program(void *hw, const struct sftl_prog *pages, unsigned int n)
+{
+	return apple_ppn_program(hw, pages, n);
+}
+
+static const struct sftl_ops ftl_glue_ops = {
+	.read_page = glue_read,
+	.erase_block = glue_erase,
+	.program = glue_program,
+};
+
+/* ---- block device ------------------------------------------------------ */
+
+/* Disk-relative LBA to FTL LBA. */
+static int disk_to_ftl(const struct ftl_disk *d, u32 rel, u32 *lba)
+{
+	if (rel >= d->nlbas)
+		return -EINVAL;
+	if (d->part == FTL_WHOLE_DISK) {
+		*lba = rel;
+		return 0;
+	}
+	return sftl_part_lba(&d->inst->lv.part[d->part], rel, lba);
+}
+
+static int do_read(struct ftl_disk *d, u32 rel, u32 count, u8 *buf)
+{
+	struct ftl_instance *in = d->inst;
+	u32 i, lba;
+	int ret;
+
+	for (i = 0; i < count; i++) {
+		ret = disk_to_ftl(d, rel + i, &lba);
+		if (ret)
+			return ret;
+		ret = sftl_read_lba(&in->fs, lba, buf + i * SFTL_LBA_SIZE, NULL);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+/* Write in maximal runs of contiguous FTL LBAs: a run ends at a chunk edge. */
+static int do_write(struct ftl_disk *d, u32 rel, u32 count, const u8 *buf)
+{
+	struct ftl_instance *in = d->inst;
+	u32 i = 0;
+
+	while (i < count) {
+		u32 start, lba, n = 1;
+		int ret;
+
+		ret = disk_to_ftl(d, rel + i, &start);
+		if (ret)
+			return ret;
+		while (i + n < count) {
+			ret = disk_to_ftl(d, rel + i + n, &lba);
+			if (ret)
+				return ret;
+			if (lba != start + n)
+				break;
+			n++;
+		}
+		ret = sftl_write(&in->fs, start, n, buf + i * SFTL_LBA_SIZE);
+		if (ret)
+			return ret;
+		i += n;
+	}
+	return 0;
+}
+
+static blk_status_t ftl_queue_rq(struct blk_mq_hw_ctx *hctx,
+				 const struct blk_mq_queue_data *bd)
+{
+	struct request *rq = bd->rq;
+	struct ftl_disk *d = rq->q->disk->private_data;
+	struct ftl_instance *in = d->inst;
+	struct req_iterator iter;
+	struct bio_vec bv;
+	u32 rel = (u32)(blk_rq_pos(rq) >> 3);
+	u32 count = blk_rq_bytes(rq) / SFTL_LBA_SIZE;
+	u32 done = 0;
+	blk_status_t st = BLK_STS_OK;
+	int ret = 0;
+
+	blk_mq_start_request(rq);
+
+	if (req_op(rq) == REQ_OP_FLUSH) {
+		blk_mq_end_request(rq, BLK_STS_OK);
+		return BLK_STS_OK;
+	}
+	if (req_op(rq) != REQ_OP_READ && req_op(rq) != REQ_OP_WRITE) {
+		blk_mq_end_request(rq, BLK_STS_NOTSUPP);
+		return BLK_STS_OK;
+	}
+	if (req_op(rq) == REQ_OP_WRITE && !d->writable) {
+		blk_mq_end_request(rq, BLK_STS_IOERR);
+		return BLK_STS_OK;
+	}
+	if (count > MAX_REQ_LBAS || rel + count > d->nlbas) {
+		blk_mq_end_request(rq, BLK_STS_IOERR);
+		return BLK_STS_OK;
+	}
+
+	mutex_lock(&in->lock);
+	if (in->going) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (req_op(rq) == REQ_OP_READ) {
+		ret = do_read(d, rel, count, in->xfer);
+		if (!ret)
+			rq_for_each_segment(bv, rq, iter) {
+				memcpy_to_bvec(&bv, in->xfer + done);
+				done += bv.bv_len;
+			}
+	} else {
+		rq_for_each_segment(bv, rq, iter) {
+			memcpy_from_bvec(in->xfer + done, &bv);
+			done += bv.bv_len;
+		}
+		ret = do_write(d, rel, count, in->xfer);
+	}
+unlock:
+	mutex_unlock(&in->lock);
+
+	if (ret) {
+		pr_err_ratelimited("apple_ftl: %s rel %u count %u: %d\n",
+				   req_op(rq) == REQ_OP_WRITE ? "write" : "read",
+				   rel, count, ret);
+		st = BLK_STS_IOERR;
+	}
+	blk_mq_end_request(rq, st);
+	return BLK_STS_OK;
+}
+
+static const struct blk_mq_ops ftl_mq_ops = {
+	.queue_rq = ftl_queue_rq,
+};
+
+static const struct block_device_operations ftl_fops = {
+	.owner = THIS_MODULE,
+};
+
+static bool volume_allowed(const struct sftl_part *p)
+{
+	if (!enable_write || !write_volume[0])
+		return false;
+	if (!sysfs_streq(p->name, write_volume))
+		return false;
+	if (!strcasecmp(p->name, "System") || !strcasecmp(p->name, "Data"))
+		return false;
+	if (p->attrs & EFFACEABLE_ATTRS)
+		return false;
+	return true;
+}
+
+static int create_disk(struct ftl_instance *in, u32 part, u32 nlbas, bool writable,
+		       const char *name)
+{
+	struct queue_limits lim = {
+		.logical_block_size = SFTL_LBA_SIZE,
+		.physical_block_size = SFTL_PAGE_SIZE,
+		.max_hw_sectors = MAX_REQ_LBAS << 3,
+		.max_segments = USHRT_MAX,
+		.max_segment_size = UINT_MAX,
+	};
+	struct ftl_disk *d = &in->disk[in->ndisks];
+	struct gendisk *gd;
+	int ret;
+
+	gd = blk_mq_alloc_disk(&in->tag_set, &lim, d);
+	if (IS_ERR(gd))
+		return PTR_ERR(gd);
+	gd->major = ftl_major;
+	gd->first_minor = in->ndisks;
+	gd->minors = 1;
+	gd->flags |= GENHD_FL_NO_PART;
+	gd->fops = &ftl_fops;
+	gd->private_data = d;
+	strscpy(gd->disk_name, name, sizeof(gd->disk_name));
+	set_capacity(gd, (sector_t)nlbas << 3);
+	set_disk_ro(gd, !writable);
+
+	d->gd = gd;
+	d->inst = in;
+	d->part = part;
+	d->nlbas = nlbas;
+	d->writable = writable;
+	in->ndisks++;
+
+	ret = add_disk(gd);
+	if (ret) {
+		in->ndisks--;
+		put_disk(gd);
+		d->gd = NULL;
+	}
+	return ret;
+}
+
+static int create_disks(struct ftl_instance *in)
+{
+	u32 i;
+	int ret;
+	char name[DISK_NAME_LEN];
+
+	ret = create_disk(in, FTL_WHOLE_DISK, in->fs.reported_lbas, false, FTL_NAME "0");
+	if (ret)
+		return ret;
+	for (i = 0; i < in->lv.nparts; i++) {
+		struct sftl_part *p = &in->lv.part[i];
+		bool w = in->writing && volume_allowed(p);
+
+		snprintf(name, sizeof(name), FTL_NAME "0p%u", i);
+		ret = create_disk(in, i, p->nlbas, w, name);
+		if (ret)
+			return ret;
+		pr_info("apple_ftl: %s = %s (%u LBAs)%s\n", name, p->name, p->nlbas,
+			w ? " writable" : "");
+	}
+	return 0;
+}
+
+static void remove_disks(struct ftl_instance *in)
+{
+	unsigned int i;
+
+	for (i = 0; i < in->ndisks; i++) {
+		if (in->disk[i].gd) {
+			del_gendisk(in->disk[i].gd);
+			put_disk(in->disk[i].gd);
+			in->disk[i].gd = NULL;
+		}
+	}
+	in->ndisks = 0;
+}
+
+static void instance_free(struct ftl_instance *in)
+{
+	sftl_writer_stop(&in->fs);
+	sftl_exit(&in->fs);
+	vfree(in->xfer);
+	kfree(in->tmp_lba);
+	if (in->ppn)
+		apple_ppn_put(in->ppn);
+	kfree(in);
+}
+
+/* Checkpoint when needed.  On return the writer is stopped from committing again. */
+static void final_checkpoint(struct ftl_instance *in)
+{
+	int ret;
+
+	if (!in->writing)
+		return;
+	if (skip_checkpoint) {
+		pr_warn("apple_ftl: final checkpoint skipped (skip_checkpoint)\n");
+		return;
+	}
+	mutex_lock(&in->lock);
+	ret = sftl_checkpoint(&in->fs);
+	mutex_unlock(&in->lock);
+	if (ret)
+		pr_err("apple_ftl: final checkpoint failed: %d\n", ret);
+}
+
+static int ftl_do_mount(void)
+{
+	struct ftl_instance *in;
+	struct apple_ppn *ppn;
+	int ret;
+
+	if (ftl_mounted)
+		return -EBUSY;
+	ppn = apple_ppn_get();
+	if (!ppn) {
+		pr_err("apple_ftl: controller is not bound\n");
+		return -ENODEV;
+	}
+	in = kzalloc(sizeof(*in), GFP_KERNEL);
+	if (!in) {
+		apple_ppn_put(ppn);
+		return -ENOMEM;
+	}
+	in->ppn = ppn;
+	mutex_init(&in->lock);
+	in->xfer = vmalloc(MAX_REQ_LBAS * SFTL_LBA_SIZE);
+	if (!in->xfer) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+	ret = sftl_init(&in->fs, &ftl_glue_ops, ppn);
+	if (ret)
+		goto err_free;
+
+	ret = sftl_mount(&in->fs);
+	if (ret) {
+		pr_err("apple_ftl: mount failed: %d\n", ret);
+		goto err_free;
+	}
+	pr_info("apple_ftl: context sb %u, replayed %u LBAs\n", in->fs.ctx_sb,
+		in->fs.replay_applied);
+
+	ret = sftl_lwvm_load(&in->fs, &in->lv);
+	if (ret) {
+		pr_err("apple_ftl: LwVM header refused: %d\n", ret);
+		goto err_free;
+	}
+
+	if (enable_write) {
+		if (!apple_ppn_write_allowed(ppn)) {
+			pr_err("apple_ftl: enable_write set but controller not allow_write\n");
+			ret = -EPERM;
+			goto err_free;
+		}
+		ret = sftl_writer_start(&in->fs, verify_every);
+		if (ret) {
+			pr_err("apple_ftl: writer refused: %d\n", ret);
+			goto err_free;
+		}
+		in->writing = true;
+	}
+
+	in->tag_set.ops = &ftl_mq_ops;
+	in->tag_set.nr_hw_queues = 1;
+	in->tag_set.queue_depth = 4;
+	in->tag_set.numa_node = NUMA_NO_NODE;
+	in->tag_set.flags = BLK_MQ_F_BLOCKING;
+	ret = blk_mq_alloc_tag_set(&in->tag_set);
+	if (ret)
+		goto err_free;
+
+	ret = create_disks(in);
+	if (ret) {
+		remove_disks(in);
+		blk_mq_free_tag_set(&in->tag_set);
+		goto err_free;
+	}
+
+	ftl_mounted = in;
+	return 0;
+
+err_free:
+	instance_free(in);
+	return ret;
+}
+
+static void ftl_do_unmount(void)
+{
+	struct ftl_instance *in = ftl_mounted;
+
+	if (!in)
+		return;
+	ftl_mounted = NULL;
+
+	mutex_lock(&in->lock);
+	in->going = true;
+	mutex_unlock(&in->lock);
+
+	remove_disks(in);
+	blk_mq_free_tag_set(&in->tag_set);
+	in->going = false;
+	final_checkpoint(in);
+	instance_free(in);
+}
+
+static int ftl_reboot(struct notifier_block *nb, unsigned long code, void *data)
+{
+	mutex_lock(&ftl_global_lock);
+	if (ftl_mounted)
+		final_checkpoint(ftl_mounted);
+	mutex_unlock(&ftl_global_lock);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block ftl_reboot_nb = {
+	.notifier_call = ftl_reboot,
+};
+
+static int mount_param_set(const char *val, const struct kernel_param *kp)
+{
+	bool want;
+	int ret;
+
+	ret = kstrtobool(val, &want);
+	if (ret)
+		return ret;
+	mutex_lock(&ftl_global_lock);
+	if (want)
+		ret = ftl_do_mount();
+	else
+		ftl_do_unmount();
+	mutex_unlock(&ftl_global_lock);
+	return ret;
+}
+
+static int mount_param_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%d\n", ftl_mounted ? 1 : 0);
+}
+
+static const struct kernel_param_ops mount_param_ops = {
+	.set = mount_param_set,
+	.get = mount_param_get,
+};
+module_param_cb(mount, &mount_param_ops, NULL, 0200);
+MODULE_PARM_DESC(mount, "Write 1 to mount the FTL and create the block devices");
+
+static int __init apple_ftl_init(void)
+{
+	int ret;
+
+	ftl_major = register_blkdev(0, FTL_NAME);
+	if (ftl_major < 0)
+		return ftl_major;
+	register_reboot_notifier(&ftl_reboot_nb);
+	if (auto_mount) {
+		mutex_lock(&ftl_global_lock);
+		ret = ftl_do_mount();
+		mutex_unlock(&ftl_global_lock);
+		if (ret)
+			pr_info("apple_ftl: not mounted at load (%d); write 1 to 'mount'\n", ret);
+	}
+	return 0;
+}
+
+static void __exit apple_ftl_exit(void)
+{
+	mutex_lock(&ftl_global_lock);
+	ftl_do_unmount();
+	mutex_unlock(&ftl_global_lock);
+	unregister_reboot_notifier(&ftl_reboot_nb);
+	unregister_blkdev(ftl_major, FTL_NAME);
+}
+
+module_init(apple_ftl_init);
+module_exit(apple_ftl_exit);
+
+MODULE_DESCRIPTION("Swiss FTL for the iPad mini 1 PPN NAND");
+MODULE_AUTHOR("Project Cascadia; format findings by crystal-lized");
+MODULE_LICENSE("GPL");
diff --git a/drivers/mtd/nand/apple/apple_ppn.c b/drivers/mtd/nand/apple/apple_ppn.c
new file mode 100644
index 000000000000..3d9e3f272e6e
--- /dev/null
+++ b/drivers/mtd/nand/apple/apple_ppn.c
@@ -0,0 +1,1090 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PPN NAND controller (FMI/FMC) on the Apple A5, PIO only.
+ *
+ * Written from the behavioural specification
+ * devices/a5/docs/research/p105-nand-spec.md; no DMA, no sequencer.
+ *
+ * Credit: that the on-media format of this package is the same on the A5 as
+ * on the iPhone 5, and the write path that first proved program and erase
+ * possible on it, are the work of crystal-lized (iPhone 5, S5L8950X series,
+ * 2026), who allows this work to build on theirs.
+ */
+
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "apple_ppn.h"
+#include "sftl.h"
+
+#define FMI0_BASE		0x31200000
+#define FMI1_BASE		0x31300000
+#define FMI_WINDOW		0x100000
+
+/* FMI registers. */
+#define F_CONFIG		0x00
+#define F_CONTROL		0x04
+#define F_STATUS		0x0c
+#define F_INT_EN		0x10
+#define F_DATA			0x14
+#define F_DMA_STATUS		0x1c
+#define F_PIO			0x34
+#define F_ECC_INIT		0x80014
+
+#define CONTROL_RX		3
+#define CONTROL_TX		5
+#define CONTROL_STOP		6
+#define PIO_CONFIG_DATA		5
+#define PIO_CONFIG_ID		0
+#define DMA_READY_BITS		0x18
+#define PIO_MAX_BURST		1024u
+#define STATUS_DONE		BIT(1)
+#define STATUS_POLL_DONE	BIT(8)
+#define FMI_ALL_EVENTS		0x10f
+#define FMC_ALL_EVENTS		0x31ffff
+
+/* FMC registers. */
+#define FMC_OFF			0x40000
+#define C_ON			(FMC_OFF + 0x00)
+#define C_IF_CTRL		(FMC_OFF + 0x08)
+#define C_CE_CTRL		(FMC_OFF + 0x0c)
+#define C_RW_CTRL		(FMC_OFF + 0x10)
+#define C_CMD			(FMC_OFF + 0x14)
+#define C_ADDR0			(FMC_OFF + 0x18)
+#define C_ADDR1			(FMC_OFF + 0x1c)
+#define C_ADDRNUM		(FMC_OFF + 0x20)
+#define C_DATANUM		(FMC_OFF + 0x24)
+#define C_INT_MASK		(FMC_OFF + 0x40)
+#define C_STATUS		(FMC_OFF + 0x44)
+#define C_NAND_STATUS		(FMC_OFF + 0x48)
+#define C_STATUS_MASK		(FMC_OFF + 0x4c)
+
+#define RW_CMD1			0x01
+#define RW_CMD2			0x02
+#define RW_ADDR			0x08
+#define RW_POLL			0x50
+#define ST_MATCH		0x20
+
+#define ON_SDR			1
+#define IF_CTRL_TIMING		0x23210
+#define IF_CTRL_LOW_POWER	0xffff
+#define IF_CTRL_POLL_CLEAR	0x100000
+
+/* NAND opcodes. */
+#define OP_RESET		0xff
+#define OP_READ_ID		0x90
+#define OP_GET_FEAT		0xee
+#define OP_SET_FEAT		0xef
+#define OP_FEAT_CONFIRM		0xe7
+#define OP_PARAM		0x92
+#define OP_PARAM_CONFIRM	0x97
+#define OP_READ			0x0a
+#define OP_READ_CONFIRM		0x37
+#define OP_DATA_OUT		0x7a
+#define OP_END			0x77
+#define OP_PROGRAM		0x8a
+#define OP_PROG_CONFIRM		0x17
+#define OP_ERASE		0x6a
+#define OP_ERASE_CONFIRM	0xd7
+#define OP_STATUS_WAIT		0x79
+#define OP_RAW_STATUS		0x7d77
+
+#define ST_READY		0x40
+#define ST_GENERAL_ERR		0x10
+#define ST_FAIL			0x01
+
+#define FEAT_FIRMWARE		0x9080
+#define FEAT_BAD_BLOCK		0x84
+#define FEAT_POWER_STATE	0x0180
+#define POWER_STATE_ASYNC	2
+#define BAD_BLOCK_BYTES		133u
+
+#define NBUS			2
+#define NCAU			2
+#define BUS_CE			0		/* the one populated CE on each bus */
+#define ROW_ADDR_BYTES		4		/* program and erase, PPN 1.5 and later */
+#define FULL_ADDR_BYTES		8		/* read: byte count, column, row */
+#define RAW_PAGE_BYTES		16448u
+#define UNIT_SECTOR_BYTES	1028u
+#define UNIT_SECTORS		4u
+#define RAW_UNIT_DATA1		1024u
+#define RAW_UNIT_META		16u
+#define RAW_UNIT_DATA2		3072u
+
+#define WAIT_PHASE_US		100000
+#define WAIT_STATUS_US		2000000
+#define WAIT_ERASE_US		2000000
+#define WAIT_RESET_MS		50
+
+static bool hold_probe;
+module_param(hold_probe, bool, 0644);
+MODULE_PARM_DESC(hold_probe, "Defer probing the hardware until cleared and bound");
+
+static bool allow_write;
+module_param(allow_write, bool, 0444);
+MODULE_PARM_DESC(allow_write, "Permit program and erase operations");
+
+#if defined(CONFIG_APPLE_PPN_FAULT_INJECT) && !defined(SFTL_NO_WRITE)
+#define PPN_INJECT	1
+/*
+ * Test only (CONFIG_APPLE_PPN_FAULT_INJECT): make the media look as if a
+ * program or an erase failed.  Release kernels leave this out.
+ */
+static int inject_program = -1;
+module_param(inject_program, int, 0644);
+MODULE_PARM_DESC(inject_program, "Test only: the Nth page program from now fails (-1 off)");
+static int inject_mode = 1;
+module_param(inject_mode, int, 0644);
+MODULE_PARM_DESC(inject_mode, "Test only: 1 = the failing page is not programmed, 2 = programmed then reported failed");
+static int inject_erase = -1;
+module_param(inject_erase, int, 0644);
+MODULE_PARM_DESC(inject_erase, "Test only: the Nth block erase from now fails (-1 off)");
+
+static bool inject_erase_now(void)
+{
+	return inject_erase >= 0 && inject_erase-- == 0;
+}
+
+/* 0: no failure; 1: fail without programming; 2: program, then report a failure. */
+static int inject_program_now(void)
+{
+	if (inject_program < 0 || inject_program-- != 0)
+		return 0;
+	return inject_mode == 2 ? 2 : 1;
+}
+#else
+#define PPN_INJECT	0
+
+static inline bool inject_erase_now(void)
+{
+	return false;
+}
+
+static inline int inject_program_now(void)
+{
+	return 0;
+}
+#endif
+
+struct ppn_bus {
+	void __iomem *fmi;
+	u32 if_ctrl;			/* what a software reset writes back */
+};
+
+struct apple_ppn {
+	struct device *dev;
+	struct ppn_bus bus[NBUS];
+	struct mutex lock;
+	bool gone;
+};
+
+static struct apple_ppn *ppn_singleton;
+static DEFINE_MUTEX(ppn_global_lock);
+
+static inline u32 rd(const struct ppn_bus *b, unsigned long reg)
+{
+	return readl(b->fmi + reg);
+}
+
+static inline void wr(const struct ppn_bus *b, unsigned long reg, u32 v)
+{
+	writel(v, b->fmi + reg);
+}
+
+static int wait_phase(const struct ppn_bus *b, u32 bits)
+{
+	u32 v;
+	int ret;
+
+	ret = readl_poll_timeout(b->fmi + C_STATUS, v,
+				 (v & bits) == bits, 1, WAIT_PHASE_US);
+	if (ret)
+		return ret;
+	wr(b, C_STATUS, bits);
+	return 0;
+}
+
+static void clear_events(const struct ppn_bus *b)
+{
+	wr(b, C_INT_MASK, 0);
+	wr(b, F_INT_EN, 0);
+	wr(b, C_STATUS, FMC_ALL_EVENTS);
+	wr(b, F_STATUS, FMI_ALL_EVENTS);
+}
+
+/* Software reset of a bus: no NAND reset. */
+static void bus_soft_reset(const struct ppn_bus *b)
+{
+	wr(b, F_CONTROL, CONTROL_STOP);
+	wr(b, C_ON, ON_SDR);
+	wr(b, C_IF_CTRL, b->if_ctrl);
+}
+
+static void ce_select(const struct ppn_bus *b)
+{
+	wr(b, C_CE_CTRL, BIT(BUS_CE));
+}
+
+static void ce_deselect(const struct ppn_bus *b)
+{
+	wr(b, C_CE_CTRL, 0);
+}
+
+static int cmd_only(const struct ppn_bus *b, u32 op)
+{
+	wr(b, C_CMD, op);
+	wr(b, C_RW_CTRL, RW_CMD1);
+	return wait_phase(b, RW_CMD1);
+}
+
+static void set_addr(const struct ppn_bus *b, u32 addr, unsigned int nbytes)
+{
+	wr(b, C_ADDR0, addr);
+	wr(b, C_ADDRNUM, (nbytes + 7) & 7);
+}
+
+static int cmd_addr_cmd(const struct ppn_bus *b, u32 op1, u32 op2, u32 addr,
+			unsigned int nbytes)
+{
+	wr(b, C_CMD, op1 | op2 << 8);
+	set_addr(b, addr, nbytes);
+	wr(b, C_RW_CTRL, RW_CMD1 | RW_CMD2 | RW_ADDR);
+	return wait_phase(b, RW_CMD1 | RW_CMD2 | RW_ADDR);
+}
+
+static int cmd_addr(const struct ppn_bus *b, u32 op, u32 addr, unsigned int nbytes)
+{
+	wr(b, C_CMD, op);
+	set_addr(b, addr, nbytes);
+	wr(b, C_RW_CTRL, RW_CMD1 | RW_ADDR);
+	return wait_phase(b, RW_CMD1 | RW_ADDR);
+}
+
+/* Read command with the full address: byte count, byte column, row. */
+static int cmd_read_full(const struct ppn_bus *b, u32 row)
+{
+	wr(b, C_CMD, OP_READ | OP_READ_CONFIRM << 8);
+	wr(b, C_ADDR0, RAW_PAGE_BYTES);
+	wr(b, C_ADDR1, row);
+	wr(b, C_ADDRNUM, (FULL_ADDR_BYTES + 7) & 7);
+	wr(b, C_RW_CTRL, RW_CMD1 | RW_CMD2 | RW_ADDR);
+	return wait_phase(b, RW_CMD1 | RW_CMD2 | RW_ADDR);
+}
+
+/*
+ * Arm a status poll on the bus.  Separated from waiting for it so the program
+ * path can have one poll running per bus.
+ */
+static void poll_start(const struct ppn_bus *b)
+{
+	clear_events(b);
+	wr(b, C_IF_CTRL, b->if_ctrl & ~IF_CTRL_POLL_CLEAR);
+	wr(b, C_STATUS_MASK, 0x4040);
+	wr(b, C_DATANUM, 0);
+	wr(b, C_INT_MASK, ST_MATCH);
+	wr(b, C_RW_CTRL, RW_POLL);
+}
+
+static bool poll_ready(const struct ppn_bus *b)
+{
+	return rd(b, F_STATUS) & STATUS_POLL_DONE;
+}
+
+static u8 poll_finish(const struct ppn_bus *b)
+{
+	u8 status = (u8)rd(b, C_NAND_STATUS);
+
+	wr(b, F_STATUS, STATUS_POLL_DONE);
+	wr(b, C_RW_CTRL, 0);
+	wr(b, C_IF_CTRL, b->if_ctrl);
+	return status;
+}
+
+static void poll_abort(const struct ppn_bus *b)
+{
+	wr(b, C_RW_CTRL, 0);
+	wr(b, C_IF_CTRL, b->if_ctrl);
+}
+
+static int poll_wait(const struct ppn_bus *b, unsigned int timeout_us, u8 *status)
+{
+	ktime_t end = ktime_add_us(ktime_get(), timeout_us);
+
+	poll_start(b);
+	while (!poll_ready(b)) {
+		if (ktime_after(ktime_get(), end)) {
+			poll_abort(b);
+			return -ETIMEDOUT;
+		}
+		cpu_relax();
+	}
+	*status = poll_finish(b);
+	return 0;
+}
+
+/* Operation status: 0x77 0x7d, then poll. */
+static int op_status(const struct ppn_bus *b, u8 *status)
+{
+	int ret;
+
+	wr(b, C_CMD, OP_RAW_STATUS);
+	wr(b, C_RW_CTRL, RW_CMD1 | RW_CMD2);
+	ret = wait_phase(b, RW_CMD1 | RW_CMD2);
+	if (ret)
+		return ret;
+	return poll_wait(b, WAIT_STATUS_US, status);
+}
+
+static int wait_fifo(const struct ppn_bus *b)
+{
+	u32 v;
+
+	return readl_poll_timeout(b->fmi + F_DMA_STATUS, v, v & DMA_READY_BITS,
+				  1, WAIT_PHASE_US);
+}
+
+/* One PIO burst, n bytes (multiple of 4, at most PIO_MAX_BURST). */
+static int rx_burst(const struct ppn_bus *b, u8 *buf, unsigned int n)
+{
+	int ret;
+
+	wr(b, F_CONFIG, PIO_CONFIG_DATA);
+	wr(b, F_PIO, ((n << 8) & 0x7fc00) | 1);
+	wr(b, F_CONTROL, CONTROL_RX);
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	ioread32_rep(b->fmi + F_DATA, buf, n / 4);
+	return 0;
+}
+
+static int wait_tx_done(const struct ppn_bus *b)
+{
+	u32 v;
+	int ret;
+
+	ret = readl_poll_timeout(b->fmi + F_STATUS, v, v & STATUS_DONE, 1, WAIT_PHASE_US);
+	if (!ret)
+		wr(b, F_STATUS, STATUS_DONE);
+	return ret;
+}
+
+static int tx_burst(const struct ppn_bus *b, const u8 *buf, unsigned int n)
+{
+	int ret;
+
+	wr(b, F_CONFIG, PIO_CONFIG_DATA);
+	wr(b, F_PIO, ((n << 8) & 0x7fc00) | 1);
+	wr(b, F_CONTROL, CONTROL_TX);
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	iowrite32_rep(b->fmi + F_DATA, buf, n / 4);
+	return wait_tx_done(b);
+}
+
+/*
+ * One 4112-byte unit, one start, four sectors of 1028 bytes.  The stream is
+ * 1024 data, 16 metadata, 3072 data, so the metadata straddles sectors 0 and 1.
+ */
+static int rx_unit(const struct ppn_bus *b, u8 *data, u8 *meta)
+{
+	void __iomem *fifo = b->fmi + F_DATA;
+	int ret;
+
+	clear_events(b);
+	wr(b, F_CONFIG, PIO_CONFIG_DATA);
+	wr(b, F_PIO, (UNIT_SECTOR_BYTES << 8) | UNIT_SECTORS);
+	wr(b, F_CONTROL, CONTROL_RX);
+
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	ioread32_rep(fifo, data, 256);
+	ioread32_rep(fifo, meta, 1);
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	ioread32_rep(fifo, meta + 4, 3);
+	ioread32_rep(fifo, data + 1024, 254);
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	ioread32_rep(fifo, data + 2040, 257);
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	ioread32_rep(fifo, data + 3068, 257);
+	return 0;
+}
+
+#ifndef SFTL_NO_WRITE
+/*
+ * Transmit one 4112-byte unit the way a unit is received: one start, four
+ * sectors of 1028 bytes, the 16 metadata bytes 1024 bytes into the stream.
+ * The end of the unit is the done bit, as on the set-feature transmit.
+ */
+static int tx_unit(const struct ppn_bus *b, const u8 *data, const u8 *meta)
+{
+	void __iomem *fifo = b->fmi + F_DATA;
+	int ret;
+
+	clear_events(b);
+	wr(b, F_CONFIG, PIO_CONFIG_DATA);
+	wr(b, F_PIO, (UNIT_SECTOR_BYTES << 8) | UNIT_SECTORS);
+	wr(b, F_CONTROL, CONTROL_TX);
+
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	iowrite32_rep(fifo, data, 256);
+	iowrite32_rep(fifo, meta, 1);
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	iowrite32_rep(fifo, meta + 4, 3);
+	iowrite32_rep(fifo, data + 1024, 254);
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	iowrite32_rep(fifo, data + 2040, 257);
+	ret = wait_fifo(b);
+	if (ret)
+		return ret;
+	iowrite32_rep(fifo, data + 3068, 257);
+	return wait_tx_done(b);
+}
+
+static unsigned int tx_shape;
+module_param(tx_shape, uint, 0644);
+MODULE_PARM_DESC(tx_shape, "Page transmit: 0 = one start per 4112-byte unit, 1 = bursts of up to 1024 bytes");
+
+/* The burst form: one start per piece of at most 1024 bytes. */
+static int tx_unit_bursts(const struct ppn_bus *b, const u8 *data, const u8 *meta)
+{
+	unsigned int off;
+	int ret;
+
+	ret = tx_burst(b, data, RAW_UNIT_DATA1);
+	if (ret)
+		return ret;
+	ret = tx_burst(b, meta, RAW_UNIT_META);
+	for (off = 0; !ret && off < RAW_UNIT_DATA2; off += PIO_MAX_BURST)
+		ret = tx_burst(b, data + RAW_UNIT_DATA1 + off,
+			       min(RAW_UNIT_DATA2 - off, PIO_MAX_BURST));
+	return ret;
+}
+
+static int tx_page(const struct ppn_bus *b, const u8 *data, const u8 *meta)
+{
+	unsigned int u;
+	int ret = 0;
+
+	for (u = 0; !ret && u < SFTL_LBAS_PER_PAGE; u++) {
+		const u8 *d = data + u * SFTL_LBA_SIZE, *m = meta + u * SFTL_META_LBA;
+
+		ret = tx_shape ? tx_unit_bursts(b, d, m) : tx_unit(b, d, m);
+	}
+	return ret;
+}
+#endif
+
+static u32 make_row(unsigned int cau, unsigned int block, unsigned int page, bool slc)
+{
+	return page | block << 8 | cau << 19 | (slc ? BIT(23) : 0);
+}
+
+static int nand_reset(const struct ppn_bus *b)
+{
+	int ret;
+
+	ce_select(b);
+	udelay(10);
+	ret = cmd_only(b, OP_RESET);
+	ce_deselect(b);
+	return ret;
+}
+
+static int read_id(const struct ppn_bus *b, u8 *id)
+{
+	u32 words[2], v;
+	int ret;
+
+	ce_select(b);
+	clear_events(b);
+	wr(b, C_CMD, OP_READ_ID);
+	set_addr(b, 0, 1);
+	wr(b, C_RW_CTRL, RW_CMD1 | RW_ADDR);
+	ret = wait_phase(b, RW_CMD1 | RW_ADDR);
+	if (ret)
+		goto out;
+	wr(b, F_CONFIG, PIO_CONFIG_ID);
+	wr(b, F_PIO, (8 << 8) | 1);
+	wr(b, F_CONTROL, CONTROL_RX);
+	ret = readl_poll_timeout(b->fmi + F_STATUS, v, v & STATUS_DONE, 1, WAIT_PHASE_US);
+	if (ret)
+		goto out;
+	words[0] = rd(b, F_DATA);
+	words[1] = rd(b, F_DATA);
+	memcpy(id, words, 8);
+out:
+	ce_deselect(b);
+	bus_soft_reset(b);
+	return ret;
+}
+
+/*
+ * Get feature: data in bursts of up to 1024 bytes; a tail shorter than a word
+ * goes as one last 4-byte burst.
+ */
+static int get_feature(const struct ppn_bus *b, u32 feature, u8 *buf, unsigned int n)
+{
+	unsigned int done = 0;
+	u8 st;
+	int ret;
+
+	ce_select(b);
+	clear_events(b);
+	ret = cmd_addr_cmd(b, OP_GET_FEAT, OP_FEAT_CONFIRM, feature, 2);
+	if (!ret)
+		ret = op_status(b, &st);
+	if (!ret && st != ST_READY)
+		ret = -EIO;
+	if (!ret)
+		ret = cmd_only(b, OP_DATA_OUT);
+	while (!ret && done < n) {
+		unsigned int left = n - done;
+
+		if (left >= 4) {
+			unsigned int chunk = min(left, PIO_MAX_BURST) & ~3u;
+
+			ret = rx_burst(b, buf + done, chunk);
+			done += chunk;
+		} else {
+			u8 tail[4];
+
+			ret = rx_burst(b, tail, 4);
+			memcpy(buf + done, tail, left);
+			done = n;
+		}
+	}
+	wr(b, F_CONTROL, CONTROL_STOP);
+	if (!ret)
+		ret = cmd_only(b, OP_END);
+	ce_deselect(b);
+	return ret;
+}
+
+/* Set feature: one 4-byte word out. */
+static int set_feature(const struct ppn_bus *b, u32 feature, u32 value)
+{
+	__le32 v = cpu_to_le32(value);
+	u8 st;
+	int ret;
+
+	ce_select(b);
+	wr(b, F_CONTROL, CONTROL_STOP);
+	ret = cmd_addr(b, OP_SET_FEAT, feature, 2);
+	if (!ret) {
+		clear_events(b);
+		ret = tx_burst(b, (const u8 *)&v, 4);
+	}
+	if (!ret)
+		ret = cmd_only(b, OP_FEAT_CONFIRM);
+	if (!ret)
+		ret = op_status(b, &st);
+	if (!ret && st != ST_READY)
+		ret = -EIO;
+	if (!ret)
+		ret = cmd_only(b, OP_END);
+	wr(b, F_CONTROL, CONTROL_STOP);
+	ce_deselect(b);
+	bus_soft_reset(b);
+	return ret;
+}
+
+static int read_params(const struct ppn_bus *b, u8 *buf)
+{
+	u8 st;
+	int ret;
+
+	ce_select(b);
+	clear_events(b);
+	ret = cmd_addr_cmd(b, OP_PARAM, OP_PARAM_CONFIRM, 0, 1);
+	if (!ret)
+		ret = op_status(b, &st);
+	if (!ret && st != ST_READY)
+		ret = -EIO;
+	if (!ret)
+		ret = cmd_only(b, OP_DATA_OUT);
+	if (!ret)
+		ret = rx_burst(b, buf, 512);
+	if (!ret)
+		ret = cmd_only(b, OP_END);
+	ce_deselect(b);
+	return ret;
+}
+
+static int check_params(struct apple_ppn *p, const u8 *buf)
+{
+	if (memcmp(buf, "PPN Device Info", 15) ||
+	    get_unaligned_le32(buf + 0x10) != NCAU ||
+	    get_unaligned_le32(buf + 0x18) != SFTL_BLOCKS ||
+	    get_unaligned_le32(buf + 0x20) != SFTL_MLC_PAGES ||
+	    get_unaligned_le32(buf + 0x24) != SFTL_SLC_PAGES ||
+	    get_unaligned_le32(buf + 0x34) != SFTL_PAGE_SIZE + SFTL_META_PAGE) {
+		dev_err(p->dev, "unexpected device parameters: %*ph\n", 64, buf);
+		return -ENODEV;
+	}
+	return 0;
+}
+
+/*
+ * Full bring-up of both buses, used at probe and to recover from a general
+ * error.  The order is the one that works on this package; only the populated
+ * chip enable of each bus is touched.
+ */
+static int ppn_bringup(struct apple_ppn *p)
+{
+	u8 *buf;
+	u8 fw[16], bbt[BAD_BLOCK_BYTES], id[8];
+	unsigned int n, c;
+	int ret;
+
+	buf = kmalloc(512, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	for (n = 0; n < NBUS; n++) {
+		struct ppn_bus *b = &p->bus[n];
+
+		b->if_ctrl = 0;
+		bus_soft_reset(b);
+		wr(b, F_ECC_INIT, 0);
+	}
+
+	for (n = 0; n < NBUS; n++) {
+		struct ppn_bus *b = &p->bus[n];
+
+		ret = nand_reset(b);
+		if (ret) {
+			dev_err(p->dev, "bus %u: reset command timed out\n", n);
+			goto out;
+		}
+		msleep(WAIT_RESET_MS);
+		b->if_ctrl = IF_CTRL_LOW_POWER;
+		wr(b, C_IF_CTRL, b->if_ctrl);
+
+		ret = read_id(b, id);
+		if (ret || memcmp(id, "PPN", 3) || id[3] != 1 || id[4] != 5 || id[5] != 5) {
+			dev_err(p->dev, "bus %u: id %*ph (ret %d)\n", n, 8, id, ret);
+			ret = ret ? ret : -ENODEV;
+			goto out;
+		}
+	}
+
+	ret = read_params(&p->bus[0], buf);
+	if (!ret)
+		ret = check_params(p, buf);
+	if (ret)
+		goto out;
+
+	for (n = 0; n < NBUS; n++) {
+		ret = set_feature(&p->bus[n], FEAT_POWER_STATE, POWER_STATE_ASYNC);
+		if (ret) {
+			dev_err(p->dev, "bus %u: power state: %d\n", n, ret);
+			goto out;
+		}
+	}
+
+	for (n = 0; n < NBUS; n++) {
+		p->bus[n].if_ctrl = IF_CTRL_TIMING;
+		wr(&p->bus[n], C_IF_CTRL, IF_CTRL_TIMING);
+	}
+
+	ret = get_feature(&p->bus[0], FEAT_FIRMWARE, fw, sizeof(fw));
+	if (ret)
+		goto out;
+	if (memcmp(fw, "040472P_HYNIX_B_", 16)) {
+		dev_err(p->dev, "firmware %*ph not tested, refusing\n", 16, fw);
+		ret = -ENODEV;
+		goto out;
+	}
+
+	/* The bad-block tables are not used, but are always read here. */
+	for (n = 0; n < NBUS; n++) {
+		for (c = 0; c < NCAU; c++) {
+			ret = get_feature(&p->bus[n], FEAT_BAD_BLOCK | c << 8, bbt, sizeof(bbt));
+			if (ret) {
+				dev_err(p->dev, "bus %u cau %u: bad-block table: %d\n", n, c, ret);
+				goto out;
+			}
+		}
+	}
+out:
+	kfree(buf);
+	return ret;
+}
+
+static int read_page_once(struct apple_ppn *p, unsigned int bank, unsigned int block,
+			  unsigned int page, bool slc, u8 *data, u8 *meta, u8 *status)
+{
+	const struct ppn_bus *b = &p->bus[bank & 1];
+	u8 st;
+	int ret;
+
+	bus_soft_reset(b);
+	ce_select(b);
+	clear_events(b);
+	ret = cmd_read_full(b, make_row(bank >> 1, block, page, slc));
+	if (!ret)
+		ret = op_status(b, &st);
+	if (ret)
+		goto out;
+	*status = st;
+	/* The package has committed to the data; a general error ends it here. */
+	if (!(st & ST_GENERAL_ERR)) {
+		unsigned int u;
+
+		ret = cmd_only(b, OP_DATA_OUT);
+		for (u = 0; !ret && u < SFTL_LBAS_PER_PAGE; u++)
+			ret = rx_unit(b, data + u * SFTL_LBA_SIZE, meta + u * SFTL_META_LBA);
+		if (!ret)
+			ret = cmd_only(b, OP_END);
+	}
+out:
+	ce_deselect(b);
+	bus_soft_reset(b);
+	return ret;
+}
+
+int apple_ppn_read_page(struct apple_ppn *p, unsigned int bank, unsigned int block,
+			unsigned int page, bool slc, u8 *data, u8 *meta, u8 *status)
+{
+	int ret, attempt;
+
+	mutex_lock(&p->lock);
+	if (p->gone) {
+		ret = -ENODEV;
+		goto out;
+	}
+	for (attempt = 0; attempt < 2; attempt++) {
+		*status = 0;
+		ret = read_page_once(p, bank, block, page, slc, data, meta, status);
+		if (!ret && !(*status & ST_GENERAL_ERR))
+			break;
+		dev_warn(p->dev, "read bank %u block %u page %u slc %d: ret %d status %#x\n",
+			 bank, block, page, slc, ret, *status);
+		if (attempt == 0 && ppn_bringup(p)) {
+			ret = -EIO;
+			break;
+		}
+	}
+	if (!ret && (*status & ST_GENERAL_ERR))
+		ret = -EIO;
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_ppn_read_page);
+
+#ifdef SFTL_NO_WRITE
+/* The read-only build carries no program or erase sequence at all. */
+int apple_ppn_erase(struct apple_ppn *p, unsigned int bank, unsigned int block)
+{
+	return -EPERM;
+}
+EXPORT_SYMBOL_GPL(apple_ppn_erase);
+
+int apple_ppn_program(struct apple_ppn *p, const struct sftl_prog *pages, unsigned int n)
+{
+	return -EPERM;
+}
+EXPORT_SYMBOL_GPL(apple_ppn_program);
+
+#else
+int apple_ppn_erase(struct apple_ppn *p, unsigned int bank, unsigned int block)
+{
+	const struct ppn_bus *b = &p->bus[bank & 1];
+	u8 st;
+	int ret;
+
+	if (!allow_write)
+		return -EPERM;
+	if (inject_erase_now()) {
+		dev_warn(p->dev, "erase bank %u block %u: injected failure\n", bank, block);
+		return -EIO;
+	}
+	mutex_lock(&p->lock);
+	if (p->gone) {
+		ret = -ENODEV;
+		goto out;
+	}
+	bus_soft_reset(b);
+	ce_select(b);
+	clear_events(b);
+	ret = cmd_addr_cmd(b, OP_ERASE, OP_ERASE_CONFIRM,
+			   make_row(bank >> 1, block, 0, false), ROW_ADDR_BYTES);
+	if (!ret)
+		ret = cmd_only(b, OP_STATUS_WAIT);
+	if (!ret)
+		ret = poll_wait(b, WAIT_ERASE_US, &st);
+	if (!ret)
+		ret = op_status(b, &st);
+	if (!ret)
+		ret = cmd_only(b, OP_END);
+	ce_deselect(b);
+	bus_soft_reset(b);
+	if (!ret && st != ST_READY) {
+		dev_err(p->dev, "erase bank %u block %u status %#x\n", bank, block, st);
+		ret = -EIO;
+	}
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_ppn_erase);
+
+/* Issue a program on the bus up to its confirm, then arm the status poll. */
+static int program_start(const struct ppn_bus *b, const struct sftl_prog *pg)
+{
+	int ret;
+
+	bus_soft_reset(b);
+	ce_select(b);
+	clear_events(b);
+	ret = cmd_addr(b, OP_PROGRAM, make_row(pg->bank >> 1, pg->block, pg->page, pg->slc),
+		       ROW_ADDR_BYTES);
+	if (ret)
+		return ret;
+	/* As on the set-feature transmit, the confirm follows with no stop. */
+	ret = tx_page(b, pg->data, pg->meta);
+	if (!ret)
+		ret = cmd_only(b, OP_PROG_CONFIRM);
+	if (!ret)
+		ret = cmd_only(b, OP_STATUS_WAIT);
+	if (ret)
+		return ret;
+	poll_start(b);
+	return 0;
+}
+
+/*
+ * Program a batch.  Pages are programmed one per CE at a time; the two buses
+ * overlap, which is what gives the write speed.
+ */
+int apple_ppn_program(struct apple_ppn *p, const struct sftl_prog *pages, unsigned int n)
+{
+	unsigned int i, next[NBUS] = { 0, 0 }, count[NBUS] = { 0, 0 };
+	const struct sftl_prog *busy[NBUS] = { NULL, NULL };
+	bool inject_fail[NBUS] = { false, false };
+	ktime_t started[NBUS] = { 0, 0 };
+	int ret = 0;
+
+	if (!allow_write)
+		return -EPERM;
+	for (i = 0; i < n; i++)
+		count[pages[i].bank & 1]++;
+
+	mutex_lock(&p->lock);
+	if (p->gone) {
+		ret = -ENODEV;
+		goto out;
+	}
+	while (!ret && (next[0] < count[0] || next[1] < count[1] || busy[0] || busy[1])) {
+		for (i = 0; i < NBUS; i++) {
+			const struct ppn_bus *b = &p->bus[i];
+
+			if (busy[i]) {
+				u8 st;
+
+				if (!poll_ready(b)) {
+					if (ktime_us_delta(ktime_get(), started[i]) >
+					    WAIT_STATUS_US) {
+						dev_err(p->dev, "program timeout bus %u\n", i);
+						ret = -ETIMEDOUT;
+					}
+					continue;
+				}
+				st = poll_finish(b);
+				ce_deselect(b);
+				bus_soft_reset(b);
+				if (PPN_INJECT && inject_fail[i]) {
+					dev_warn(p->dev, "program bank %u block %u page %u: injected failure (programmed)\n",
+						 busy[i]->bank, busy[i]->block, busy[i]->page);
+					st |= ST_FAIL;
+					inject_fail[i] = false;
+				}
+				if (st & (ST_GENERAL_ERR | ST_FAIL)) {
+					dev_err(p->dev, "program bank %u block %u page %u: status %#x\n",
+						busy[i]->bank, busy[i]->block, busy[i]->page, st);
+					ret = -EIO;
+				}
+				busy[i] = NULL;
+			}
+			if (!ret && !busy[i] && next[i] < count[i]) {
+				/* This bus's next page, in batch order. */
+				unsigned int k, seen = 0;
+
+				for (k = 0; k < n; k++) {
+					if ((pages[k].bank & 1) != i)
+						continue;
+					if (seen++ == next[i])
+						break;
+				}
+				switch (inject_program_now()) {
+				case 1:
+					dev_warn(p->dev, "program bank %u block %u page %u: injected failure (not programmed)\n",
+						 pages[k].bank, pages[k].block, pages[k].page);
+					ret = -EIO;
+					break;
+				case 2:
+					inject_fail[i] = true;
+					break;
+				}
+				if (ret)
+					break;
+				ret = program_start(b, &pages[k]);
+				if (ret) {
+					dev_err(p->dev, "program start bus %u: %d\n", i, ret);
+					break;
+				}
+				busy[i] = &pages[k];
+				started[i] = ktime_get();
+				next[i]++;
+			}
+		}
+		cpu_relax();
+	}
+	/* Leave nothing armed behind us. */
+	for (i = 0; i < NBUS; i++) {
+		if (busy[i]) {
+			poll_abort(&p->bus[i]);
+			ce_deselect(&p->bus[i]);
+			bus_soft_reset(&p->bus[i]);
+		}
+	}
+	if (ret == -EIO) {
+		int r = ppn_bringup(p);
+
+		if (r)
+			dev_err(p->dev, "recovery failed: %d\n", r);
+	}
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_ppn_program);
+#endif
+
+bool apple_ppn_write_allowed(struct apple_ppn *p)
+{
+	return allow_write;
+}
+EXPORT_SYMBOL_GPL(apple_ppn_write_allowed);
+
+struct apple_ppn *apple_ppn_get(void)
+{
+	struct apple_ppn *p;
+
+	mutex_lock(&ppn_global_lock);
+	p = ppn_singleton;
+	if (p && !try_module_get(THIS_MODULE))
+		p = NULL;
+	if (p)
+		get_device(p->dev);
+	mutex_unlock(&ppn_global_lock);
+	return p;
+}
+EXPORT_SYMBOL_GPL(apple_ppn_get);
+
+void apple_ppn_put(struct apple_ppn *p)
+{
+	put_device(p->dev);
+	module_put(THIS_MODULE);
+}
+EXPORT_SYMBOL_GPL(apple_ppn_put);
+
+static int apple_ppn_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct apple_ppn *p;
+	int ret;
+
+	if (hold_probe)
+		return -ENXIO;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = dev;
+	mutex_init(&p->lock);
+	/*
+	 * Claim both register windows, so nothing else maps them while the
+	 * driver owns the controller: another driver's request fails, and with
+	 * CONFIG_IO_STRICT_DEVMEM neither can /dev/mem.
+	 */
+	if (!devm_request_mem_region(dev, FMI0_BASE, FMI_WINDOW, "apple-ppn bus 0") ||
+	    !devm_request_mem_region(dev, FMI1_BASE, FMI_WINDOW, "apple-ppn bus 1")) {
+		dev_err(dev, "PPN register windows are in use by something else\n");
+		return -EBUSY;
+	}
+	p->bus[0].fmi = devm_ioremap(dev, FMI0_BASE, FMI_WINDOW);
+	p->bus[1].fmi = devm_ioremap(dev, FMI1_BASE, FMI_WINDOW);
+	if (!p->bus[0].fmi || !p->bus[1].fmi)
+		return -ENOMEM;
+
+	ret = ppn_bringup(p);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ppn_global_lock);
+	ppn_singleton = p;
+	mutex_unlock(&ppn_global_lock);
+	platform_set_drvdata(pdev, p);
+	dev_info(dev, "PPN controller ready (PIO%s)\n",
+		 allow_write ? ", program/erase enabled" : ", read-only");
+	return 0;
+}
+
+static void apple_ppn_remove(struct platform_device *pdev)
+{
+	struct apple_ppn *p = platform_get_drvdata(pdev);
+
+	mutex_lock(&ppn_global_lock);
+	ppn_singleton = NULL;
+	mutex_unlock(&ppn_global_lock);
+	mutex_lock(&p->lock);
+	p->gone = true;
+	mutex_unlock(&p->lock);
+}
+
+static const struct of_device_id apple_ppn_of_match[] = {
+	{ .compatible = "apple,s5l8942-ppn" },
+	{ .compatible = "apple,s5l8940x-ppn" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apple_ppn_of_match);
+
+static struct platform_driver apple_ppn_driver = {
+	.probe = apple_ppn_probe,
+	.remove_new = apple_ppn_remove,
+	.driver = {
+		.name = "apple-ppn",
+		.of_match_table = apple_ppn_of_match,
+	},
+};
+module_platform_driver(apple_ppn_driver);
+
+MODULE_DESCRIPTION("Apple A5 PPN NAND controller (PIO)");
+MODULE_AUTHOR("Project Cascadia; hardware findings by crystal-lized");
+MODULE_LICENSE("GPL");
