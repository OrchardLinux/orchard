+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Interface between the PPN controller driver and the Swiss FTL. */
+#ifndef APPLE_PPN_H
+#define APPLE_PPN_H
+
+#include <linux/types.h>
+
+struct apple_ppn;
+struct sftl_prog;
+
+/* Grab the single bound controller, or NULL if none is bound. */
+struct apple_ppn *apple_ppn_get(void);
+void apple_ppn_put(struct apple_ppn *ppn);
+
+/* True when the controller was loaded with allow_write=1. */
+bool apple_ppn_write_allowed(struct apple_ppn *ppn);
+
+int apple_ppn_read_page(struct apple_ppn *ppn, unsigned int bank,
+			unsigned int block, unsigned int page, bool slc,
+			u8 *data, u8 *meta, u8 *status);
+int apple_ppn_erase(struct apple_ppn *ppn, unsigned int bank,
+		    unsigned int block);
+int apple_ppn_program(struct apple_ppn *ppn, const struct sftl_prog *pages,
+		      unsigned int n);
+
+#endif
diff --git a/drivers/mtd/nand/apple/sftl.h b/drivers/mtd/nand/apple/sftl.h
new file mode 100644
index 000000000000..729381a8ae54
--- /dev/null
+++ b/drivers/mtd/nand/apple/sftl.h
@@ -0,0 +1,450 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Swiss FTL for the iPad mini 1 (P105) PPN NAND: interface of the portable
+ * core.  The core is plain C: it builds both inside the kernel (apple_ftl) and
+ * in the offline test harness (devices/a5/tools/nand-offline).
+ *
+ * The on-media format and required behaviour are described in
+ * devices/a5/docs/research/p105-nand-spec.md.  That the format on this package
+ * is the same as on the iPhone 5, and the write path that first proved it
+ * writable, are the work of crystal-lized.
+ */
+#ifndef SFTL_H
+#define SFTL_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#else
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <errno.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#endif
+
+#define SFTL_BANKS		4
+#define SFTL_BLOCKS		1064
+#define SFTL_MLC_PAGES		256
+#define SFTL_SLC_PAGES		128
+#define SFTL_LBA_SIZE		4096u
+#define SFTL_LBAS_PER_PAGE	4u
+#define SFTL_PAGE_SIZE		16384u
+#define SFTL_META_LBA		16u
+#define SFTL_META_PAGE		(SFTL_META_LBA * SFTL_LBAS_PER_PAGE)
+#define SFTL_LBAS_PER_SB	4096u
+#define SFTL_NUM_SB		1055u
+#define SFTL_TOTAL_LBAS		3906266u	/* reported + 16 hidden */
+#define SFTL_CTX_LBAS		56u	/* the fixed part: sections 1, 2, 3, 5, 6, 4 */
+#define SFTL_CTX_PAGES		14u
+#define SFTL_TREE_LBAS		32u	/* tree LBAs inside the fixed part */
+#define SFTL_CTX_TREE_VBA	24u	/* VBA of the first tree LBA */
+/*
+ * The tree may run on past the fixed part, in VBAs that follow it (iOS does
+ * this when the map is fragmented); this is the most a Linux context writes.
+ */
+#define SFTL_TREE_MAX_LBAS	512u
+#define SFTL_CTX_MAX_PAGES	((SFTL_CTX_TREE_VBA + SFTL_TREE_MAX_LBAS) / SFTL_LBAS_PER_PAGE)
+
+/* In-memory and on-media "no mapping" VBA. */
+#define SFTL_UNMAPPED		0x7fffffu
+
+/* LBA tokens in BTOC entries and metadata. */
+#define SFTL_TOKEN_PAD		0xffff0000u
+#define SFTL_TOKEN_DELETE	0xffff0001u
+#define SFTL_TOKEN_MIN		0xffff0000u
+
+/* Metadata type byte. */
+#define SFTL_MT_USER		0x01
+#define SFTL_MT_INTERNAL	0x02
+#define SFTL_MT_BTOC		0x1c
+#define SFTL_MT_CONTEXT		0x1f
+#define SFTL_MT_VFL		0x20
+#define SFTL_MT_ERASED		0xff
+
+/* Superblock array "type". */
+#define SFTL_SB_AWAIT_ERASE	1
+#define SFTL_SB_CLOSED		3
+#define SFTL_SB_OPEN		4
+#define SFTL_SB_OPEN_ALT	5
+#define SFTL_SB_CONTEXT		7
+#define SFTL_SB_NONE		8
+#define SFTL_SB_ERASED		9
+
+/* Package read/program status. */
+#define SFTL_ST_OK		0x40
+#define SFTL_ST_REFRESH		0x42
+#define SFTL_ST_RETIRED		0x45
+#define SFTL_ST_ERASED		0x49
+
+#define SFTL_BATCH_PAGES	32u
+#define SFTL_SPARE_FLOOR	6u
+#define SFTL_SPARE_RESERVE	3u
+#define SFTL_MAX_VICTIMS	4u
+#define SFTL_VERIFY_DEFAULT	16u
+#define SFTL_FAIL_DEPTH		3u	/* failures handled inside one another */
+#define SFTL_FAIL_MAX		8u	/* failures per session before the writer stops */
+#define SFTL_RESCUE_LBAS	(SFTL_BATCH_PAGES * SFTL_LBAS_PER_PAGE)
+#define SFTL_MAX_CTX		8u
+#define SFTL_REPLAY_LOG		64u
+#define SFTL_PAD_RUN_MAX	16u
+
+struct sftl_prog {
+	u8 bank;
+	bool slc;		/* SLC row; the FTL always programs MLC */
+	u16 block;
+	u16 page;
+	const u8 *data;
+	const u8 *meta;
+};
+
+/*
+ * What the core needs from the device below.  read_page() returns a negative
+ * errno only when no status could be had at all; status bytes are handed back
+ * through *status and judged by the core.  program() is a whole batch; a
+ * non-zero return means at least one page of it did not make it.
+ */
+struct sftl_ops {
+	int (*read_page)(void *hw, unsigned int bank, unsigned int block,
+			 unsigned int page, bool slc, u8 *data, u8 *meta,
+			 u8 *status);
+	int (*erase_block)(void *hw, unsigned int bank, unsigned int block);
+	int (*program)(void *hw, const struct sftl_prog *pages, unsigned int n);
+};
+
+/* One entry of the on-media superblock array. */
+struct sftl_sb_rec {
+	u8 type;
+	u8 btoc_flags;
+	u16 valid;
+	u16 reserved;
+	u16 erases;
+};
+
+/* Per-superblock user sequence summary (also on media). */
+struct sftl_useq {
+	u32 min, max, avg, count;
+};
+
+/* The physical shape of a superblock: the banks that carry it, in order. */
+struct sftl_sb_shape {
+	u8 width;
+	u8 bank[SFTL_BANKS];
+};
+
+/* First-VBA facts for one superblock, from the mount-time scan. */
+struct sftl_sb_probe {
+	u8 first_type;
+	u8 flags;
+	u64 first_weave;
+};
+
+struct sftl_replay_item {
+	u32 sb;
+	bool closed;
+	u32 applied;
+};
+
+/*
+ * The map is a two-level table: a directory of 1024-entry leaves indexed by
+ * LBA >> 10.  A NULL leaf means "all unmapped", so memory stays proportional
+ * to the space actually in use.  Mapped entries are the VBA.
+ */
+struct sftl_map {
+	u32 **leaf;
+	u32 nleaf;
+};
+
+struct sftl_btoc_entry {
+	u32 weave_offset;
+	u32 user;
+	u32 lba;
+	u32 count;
+};
+
+struct sftl_frontier {
+	u32 sb;			/* SFTL_UNMAPPED when none open */
+	u32 capacity;		/* VBAs in the superblock */
+	u32 next;		/* next data VBA offset */
+	u64 first_weave;
+	u64 last_weave;
+	bool first_set;
+	u32 nent;
+};
+
+struct sftl_writer {
+	u8 *pool;			/* SFTL_BATCH_PAGES of data, then meta */
+	u8 *meta_pool;
+	struct sftl_prog prog[SFTL_BATCH_PAGES];
+	u32 *pend_lba;			/* (lba, vba) pairs of the open batch */
+	u32 *pend_vba;
+	unsigned int pend_n;
+	unsigned int npages;
+
+	struct sftl_btoc_entry *entries;
+	struct sftl_frontier fr;
+
+	u8 *check_data;
+	u8 check_meta[SFTL_META_PAGE];
+	u8 *btoc_img;
+	u8 *ctx_pages;			/* SFTL_CTX_MAX_PAGES of data, then meta */
+	struct sftl_prog *ctx_prog;
+
+	u32 *gc_list;
+	u8 *victim_map;
+	u32 pending_erase[SFTL_MAX_VICTIMS * 2 + SFTL_MAX_CTX];
+	unsigned int n_pending;
+
+	unsigned int verify_every;
+	u32 prog_counter;
+	bool wedged;
+	bool dirty;
+
+	/* Test fence: one superblock only, never a reclaim; commit if allowed. */
+	bool fenced;
+	bool fence_commit;
+	u32 fence_sb;
+
+	/* Program and erase failures (spec 4.9). */
+	u8 *bad_map;			/* SBs given up in this session */
+	u8 *rescue_data;		/* per depth: one batch of LBAs */
+	u8 *rescue_meta;
+	u32 *rescue_lba;
+	u32 *fail_list;			/* per depth: LBAs to move out */
+	unsigned int fail_depth;
+	unsigned int failures;
+	bool need_commit;		/* a failure was handled: commit soon */
+	bool hold_commit;		/* test only: leave that commit to the caller */
+};
+
+struct sftl {
+	const struct sftl_ops *ops;
+	void *hw;
+
+	/* VFL */
+	u16 *usage[SFTL_BANKS];
+	u32 reported_lbas;
+	u32 vfl_block;
+	u32 vfl_log_pages;
+	struct sftl_sb_shape shape[SFTL_NUM_SB];
+	u32 sig_bank, sig_block;
+
+	/* Superblock facts */
+	struct sftl_sb_probe probe[SFTL_NUM_SB];
+	struct sftl_sb_rec *rec;
+	struct sftl_useq *useq;
+	u32 *reads;
+	u8 *stats;
+
+	/* Context */
+	u32 ctx_sb;
+	u64 ctx_weave;
+	u32 ctx_lbas;			/* LBAs of the loaded context, all sections */
+	u32 ctx_list[SFTL_MAX_CTX];	/* context superblocks seen on media */
+	unsigned int n_ctx;
+
+	/* Map */
+	struct sftl_map map;
+	u32 total_lbas;			/* mapped space including hidden LBAs */
+	u32 tree_runs;
+	u32 tree_used;
+	u32 mapped_before;
+
+	/* Replay */
+	struct sftl_replay_item replay_log[SFTL_REPLAY_LOG];
+	unsigned int n_replay;
+	u32 replay_applied;
+	bool replayed;
+	/* SBs whose replay walk met a page that did not read back (torn, failed) */
+	u8 torn[(SFTL_NUM_SB + 7) / 8];
+	u64 next_weave;
+
+	/* I/O */
+	u8 *io_data;
+	u8 *io_meta;
+	u8 *aux_data;
+	u8 aux_meta[SFTL_META_PAGE];
+	u8 *cache_data;
+	u8 cache_meta[SFTL_META_PAGE];
+	bool cache_valid;
+	u8 cache_bank;
+	u16 cache_block;
+	u16 cache_page;
+
+	struct sftl_writer *wr;
+};
+
+/* LwVM view. */
+#define SFTL_MAX_PARTS 8
+#define SFTL_LWVM_CHUNKS 1024
+
+struct sftl_part {
+	char name[36];
+	u64 start, end, attrs;
+	u32 nlbas;
+	u16 chunk[SFTL_LWVM_CHUNKS];	/* logical chunk -> physical chunk */
+	u32 nchunks;
+};
+
+struct sftl_lwvm {
+	u32 nparts;
+	u64 media_size;
+	struct sftl_part part[SFTL_MAX_PARTS];
+};
+
+/* Little-endian accessors, used for all media structures. */
+static inline u16 sftl_get16(const u8 *p)
+{
+	return (u16)p[0] | (u16)p[1] << 8;
+}
+
+static inline u32 sftl_get32(const u8 *p)
+{
+	return (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+
+static inline u64 sftl_get48(const u8 *p)
+{
+	return (u64)sftl_get32(p) | (u64)sftl_get16(p + 4) << 32;
+}
+
+static inline u64 sftl_get64(const u8 *p)
+{
+	return (u64)sftl_get32(p) | (u64)sftl_get32(p + 4) << 32;
+}
+
+static inline void sftl_put16(u8 *p, u16 v)
+{
+	p[0] = (u8)v;
+	p[1] = (u8)(v >> 8);
+}
+
+static inline void sftl_put32(u8 *p, u32 v)
+{
+	p[0] = (u8)v;
+	p[1] = (u8)(v >> 8);
+	p[2] = (u8)(v >> 16);
+	p[3] = (u8)(v >> 24);
+}
+
+static inline void sftl_put48(u8 *p, u64 v)
+{
+	sftl_put32(p, (u32)v);
+	sftl_put16(p + 4, (u16)(v >> 32));
+}
+
+static inline u32 sftl_vba(u32 sb, u32 offset)
+{
+	return sb * SFTL_LBAS_PER_SB + offset;
+}
+
+static inline u32 sftl_sb_of(u32 vba)
+{
+	return vba / SFTL_LBAS_PER_SB;
+}
+
+/* The superblock's capacity in VBAs. */
+static inline u32 sftl_capacity(const struct sftl *fs, u32 sb)
+{
+	return (u32)fs->shape[sb].width * (SFTL_LBAS_PER_SB / SFTL_BANKS);
+}
+
+/*
+ * VBA to physical: VBAs stripe dense over the banks that exist, four LBAs per
+ * page.  Returns false for a VBA outside the superblock's capacity.
+ */
+static inline bool sftl_locate(const struct sftl *fs, u32 vba, u32 *bank,
+			       u32 *page, u32 *slot)
+{
+	u32 sb = sftl_sb_of(vba);
+	u32 o = vba % SFTL_LBAS_PER_SB;
+	const struct sftl_sb_shape *sh;
+	u32 row;
+
+	if (sb >= SFTL_NUM_SB)
+		return false;
+	sh = &fs->shape[sb];
+	if (!sh->width || o >= (u32)sh->width * 1024)
+		return false;
+	row = o / SFTL_LBAS_PER_PAGE;
+	*slot = o % SFTL_LBAS_PER_PAGE;
+	*bank = sh->bank[row % sh->width];
+	*page = row / sh->width;
+	return true;
+}
+
+/* sftl_map.c */
+int sftl_map_init(struct sftl_map *m, u32 lbas);
+void sftl_map_free(struct sftl_map *m);
+u32 sftl_map_get(const struct sftl_map *m, u32 lba);
+int sftl_map_set(struct sftl_map *m, u32 lba, u32 vba);
+u32 sftl_map_count_mapped(const struct sftl_map *m, u32 lbas);
+
+/* sftl_mount.c */
+int sftl_init(struct sftl *fs, const struct sftl_ops *ops, void *hw);
+void sftl_exit(struct sftl *fs);
+int sftl_load_vfl(struct sftl *fs);
+int sftl_scan(struct sftl *fs);
+int sftl_load_context(struct sftl *fs);
+int sftl_replay(struct sftl *fs);
+int sftl_mount(struct sftl *fs);
+int sftl_read_lba(struct sftl *fs, u32 lba, u8 *out, u8 *meta16);
+int sftl_read_vba(struct sftl *fs, u32 vba, u8 *data, u8 *meta16);
+int sftl_read_page_cached(struct sftl *fs, u32 bank, u32 block, u32 page,
+			  u8 *data, u8 *meta);
+int sftl_recount_valid(struct sftl *fs);
+bool sftl_sb_closed(struct sftl *fs, u32 sb, u8 *last_meta);
+int sftl_read_btoc(struct sftl *fs, u32 sb, u32 *nb, u8 *img);
+void sftl_summarize_useq(const u8 *btoc, u32 entries, struct sftl_useq *out);
+
+/* sftl_format.c: producing the on-media images (shared by mount tests and writer). */
+u32 sftl_ctx_tree_lbas(u32 used);
+int sftl_ctx_build(struct sftl *fs, u32 sb, u64 weave, u8 *pages, u8 *metas,
+		   u32 *nlbas_out);
+int sftl_tree_serialize(struct sftl *fs, u8 *lbas, u32 max_lbas, u32 *runs_out,
+			u32 *used_out);
+void sftl_btoc_append(struct sftl_btoc_entry *ent, u32 *n, u64 first_weave,
+		      u32 lba, u64 weave, u32 user);
+u32 sftl_btoc_build(const struct sftl_btoc_entry *ent, u32 n, u8 *img, u32 *nb_out,
+		    u32 force_nb);
+
+/* sftl_write.c; absent from a read-only build */
+#ifdef SFTL_NO_WRITE
+static inline int sftl_writer_start(struct sftl *fs, unsigned int verify_every)
+{
+	return -EROFS;
+}
+static inline void sftl_writer_stop(struct sftl *fs) { }
+static inline int sftl_write(struct sftl *fs, u32 lba, u32 count, const u8 *src)
+{
+	return -EROFS;
+}
+static inline int sftl_checkpoint(struct sftl *fs)
+{
+	return 0;
+}
+#else
+int sftl_writer_start(struct sftl *fs, unsigned int verify_every);
+void sftl_writer_stop(struct sftl *fs);
+int sftl_write(struct sftl *fs, u32 lba, u32 count, const u8 *src);
+int sftl_checkpoint(struct sftl *fs);
+int sftl_checkpoint_due(struct sftl *fs);
+int sftl_writer_fence(struct sftl *fs, u32 sb, bool allow_commit);
+int sftl_context_write(struct sftl *fs, u32 sb);
+int sftl_gc_plan(struct sftl *fs, u32 *victims, u32 *nv, u32 *lbas, u32 *count);
+int sftl_gc(struct sftl *fs);
+int sftl_writer_seal(struct sftl *fs);
+int sftl_erase_spare(struct sftl *fs, u32 sb);
+#endif
+
+/* sftl_lwvm.c */
+u32 sftl_crc32(const u8 *p, u32 len);
+int sftl_lwvm_parse(const u8 *hdr, const u8 *backup, struct sftl_lwvm *out);
+int sftl_lwvm_load(struct sftl *fs, struct sftl_lwvm *out);
+int sftl_part_lba(const struct sftl_part *p, u32 rel_lba, u32 *lba);
+
+#endif
diff --git a/drivers/mtd/nand/apple/sftl_format.c b/drivers/mtd/nand/apple/sftl_format.c
new file mode 100644
index 000000000000..dedb3fb75dcc
--- /dev/null
+++ b/drivers/mtd/nand/apple/sftl_format.c
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Serialising on-media structures: BTOC images, the tree, the context. */
+#include "sftl.h"
+#include "sftl_port.h"
+
+void sftl_btoc_append(struct sftl_btoc_entry *ent, u32 *n, u64 first_weave,
+		      u32 lba, u64 weave, u32 user)
+{
+	u32 off = (u32)(weave - first_weave);
+
+	if (*n && lba != SFTL_TOKEN_DELETE) {
+		struct sftl_btoc_entry *last = &ent[*n - 1];
+		bool same_run = last->weave_offset + last->count == off;
+
+		/* Data runs continue in LBA order; PAD runs are one entry. */
+		if (same_run && lba < SFTL_TOKEN_MIN && last->lba < SFTL_TOKEN_MIN &&
+		    last->lba + last->count == lba) {
+			last->count++;
+			return;
+		}
+		if (same_run && lba == SFTL_TOKEN_PAD && last->lba == SFTL_TOKEN_PAD &&
+		    last->count < SFTL_PAD_RUN_MAX) {
+			last->count++;
+			return;
+		}
+	}
+	ent[*n].weave_offset = off;
+	ent[*n].user = user;
+	ent[*n].lba = lba;
+	ent[*n].count = 1;
+	(*n)++;
+}
+
+/*
+ * img must hold 2 pages.  force_nb, when non-zero, overrides the choice of 4
+ * or 8.  Returns the bytes used (nb LBAs).
+ */
+u32 sftl_btoc_build(const struct sftl_btoc_entry *ent, u32 n, u8 *img, u32 *nb_out,
+		    u32 force_nb)
+{
+	u32 nb = force_nb ? force_nb : (n + 1 <= SFTL_PAGE_SIZE / 16 ? 4 : 8);
+	u32 i;
+
+	memset(img, 0, nb * SFTL_LBA_SIZE);
+	for (i = 0; i < n; i++) {
+		sftl_put32(img + 16 * i, ent[i].weave_offset);
+		sftl_put32(img + 16 * i + 4, ent[i].user);
+		sftl_put32(img + 16 * i + 8, ent[i].lba);
+		sftl_put32(img + 16 * i + 12, ent[i].count);
+	}
+	*nb_out = nb;
+	return nb * SFTL_LBA_SIZE;
+}
+
+/*
+ * Serialise the map as tree LBAs into lbas (max_lbas of them, zeroed first):
+ * each LBA is its first covered LBA, 0xfffffff0, then up to 511 (start, span)
+ * runs, ended by 0xffffffff when not full.  -ENOSPC if max_lbas is too few.
+ */
+int sftl_tree_serialize(struct sftl *fs, u8 *lbas, u32 max_lbas, u32 *runs_out,
+			u32 *used_out)
+{
+	u32 lba = 0, lidx = 0, total = 0;
+
+	memset(lbas, 0, (size_t)max_lbas * SFTL_LBA_SIZE);
+	while (lba < fs->total_lbas) {
+		u8 *img;
+		u32 r = 0;
+
+		if (lidx >= max_lbas)
+			return -ENOSPC;
+		img = lbas + (size_t)lidx * SFTL_LBA_SIZE;
+		sftl_put32(img, lba);
+		sftl_put32(img + 4, 0xfffffff0u);
+		while (r < 511 && lba < fs->total_lbas) {
+			u32 start = sftl_map_get(&fs->map, lba);
+			u32 span = 1;
+
+			if (start == SFTL_UNMAPPED) {
+				while (lba + span < fs->total_lbas &&
+				       sftl_map_get(&fs->map, lba + span) == SFTL_UNMAPPED)
+					span++;
+			} else {
+				while (lba + span < fs->total_lbas &&
+				       sftl_map_get(&fs->map, lba + span) == start + span)
+					span++;
+			}
+			sftl_put32(img + 8 + 8 * r, start);
+			sftl_put32(img + 12 + 8 * r, span);
+			lba += span;
+			r++;
+			total++;
+		}
+		if (r < 511)
+			sftl_put32(img + 8 + 8 * r, 0xffffffffu);
+		lidx++;
+	}
+	if (runs_out)
+		*runs_out = total;
+	if (used_out)
+		*used_out = lidx;
+	return 0;
+}
+
+/*
+ * Tree LBAs a context carries for a tree of 'used' LBAs: at least the 32 of
+ * the fixed part, else used rounded up to 16, with no empty LBA when used is
+ * already a multiple.  iOS contexts seen: 26 used in 32; 172, 173, 174 and
+ * 176 used, all in 176.
+ */
+u32 sftl_ctx_tree_lbas(u32 used)
+{
+	u32 n = (used + 15) & ~15u;
+
+	return n < SFTL_TREE_LBAS ? SFTL_TREE_LBAS : n;
+}
+
+static void put_ctx_meta(u8 *m, u8 section, u64 weave, u32 off, u32 len)
+{
+	memset(m, 0, SFTL_META_LBA);
+	m[0] = SFTL_MT_CONTEXT;
+	m[1] = section;
+	sftl_put48(m + 2, weave);
+	sftl_put16(m + 8, (u16)off);
+	sftl_put16(m + 10, (u16)len);
+	sftl_put32(m + 12, 0xffffffffu);
+}
+
+static u32 section_len(u32 total, u32 per_lba, u32 idx)
+{
+	u64 done = (u64)idx * per_lba;
+
+	if (done >= total)
+		return 0;
+	return total - done < per_lba ? total - (u32)done : per_lba;
+}
+
+/*
+ * Build a context copy at superblock sb with base weave 'weave': 'pages' holds
+ * SFTL_CTX_MAX_PAGES * 16 KiB, 'metas' SFTL_CTX_MAX_PAGES * 64 bytes.  On
+ * return *nlbas_out is the number of LBAs to program (a multiple of 4).
+ * -ENOSPC when the tree needs more than SFTL_TREE_MAX_LBAS.
+ */
+int sftl_ctx_build(struct sftl *fs, u32 sb, u64 weave, u8 *pages, u8 *metas,
+		   u32 *nlbas_out)
+{
+	u32 i, lba = 0, used = 0, ntree;
+	u8 *tree = pages + 6 * SFTL_PAGE_SIZE;
+	int ret;
+
+	memset(pages, 0, SFTL_CTX_MAX_PAGES * SFTL_PAGE_SIZE);
+	memset(metas, 0xff, SFTL_CTX_MAX_PAGES * SFTL_META_PAGE);
+	/* Base. */
+	sftl_put32(pages, 1);
+	sftl_put32(pages + 4, sb);
+	sftl_put32(pages + SFTL_PAGE_SIZE - 4, SFTL_NUM_SB);
+	for (i = 0; i < 4; i++, lba++)
+		put_ctx_meta(metas + lba * SFTL_META_LBA, 1, weave + lba, 0, 0);
+
+	/* Stats. */
+	memcpy(pages + SFTL_PAGE_SIZE, fs->stats, SFTL_PAGE_SIZE);
+	for (i = 0; i < 4; i++, lba++)
+		put_ctx_meta(metas + lba * SFTL_META_LBA, 2, weave + lba, 0, 0);
+
+	/* SB array. */
+	for (i = 0; i < SFTL_NUM_SB; i++) {
+		u8 *e = pages + 2 * SFTL_PAGE_SIZE + 8 * i;
+
+		e[0] = fs->rec[i].type;
+		e[1] = fs->rec[i].btoc_flags;
+		sftl_put16(e + 2, fs->rec[i].valid);
+		sftl_put16(e + 4, fs->rec[i].reserved);
+		sftl_put16(e + 6, fs->rec[i].erases);
+	}
+	for (i = 0; i < 4; i++, lba++)
+		put_ctx_meta(metas + lba * SFTL_META_LBA, 3, weave + lba,
+			     i * 512, section_len(SFTL_NUM_SB, 512, i));
+
+	/* User sequences. */
+	for (i = 0; i < SFTL_NUM_SB; i++) {
+		u8 *e = pages + 3 * SFTL_PAGE_SIZE + 16 * i;
+
+		sftl_put32(e, fs->useq[i].min);
+		sftl_put32(e + 4, fs->useq[i].max);
+		sftl_put32(e + 8, fs->useq[i].avg);
+		sftl_put32(e + 12, fs->useq[i].count);
+	}
+	for (i = 0; i < 8; i++, lba++)
+		put_ctx_meta(metas + lba * SFTL_META_LBA, 5, weave + lba,
+			     i * 256, section_len(SFTL_NUM_SB, 256, i));
+
+	/* Read counts. */
+	for (i = 0; i < SFTL_NUM_SB; i++)
+		sftl_put32(pages + 5 * SFTL_PAGE_SIZE + 4 * i, fs->reads[i]);
+	for (i = 0; i < 4; i++, lba++)
+		put_ctx_meta(metas + lba * SFTL_META_LBA, 6, weave + lba,
+			     i * 1024, section_len(SFTL_NUM_SB, 1024, i));
+
+	/* Tree, then empty tree LBAs up to the count the layout asks for. */
+	ret = sftl_tree_serialize(fs, tree, SFTL_TREE_MAX_LBAS, NULL, &used);
+	if (ret)
+		return ret;
+	ntree = sftl_ctx_tree_lbas(used);
+	for (i = used; i < ntree; i++) {
+		u8 *img = tree + (size_t)i * SFTL_LBA_SIZE;
+
+		sftl_put32(img, 0xffffffffu);
+		sftl_put32(img + 4, 0xffffffffu);
+	}
+	for (i = 0; i < ntree; i++, lba++)
+		put_ctx_meta(metas + lba * SFTL_META_LBA, 4, weave + lba, 0, 0);
+	*nlbas_out = lba;
+	return 0;
+}
diff --git a/drivers/mtd/nand/apple/sftl_lwvm.c b/drivers/mtd/nand/apple/sftl_lwvm.c
new file mode 100644
index 000000000000..f23443e08366
--- /dev/null
+++ b/drivers/mtd/nand/apple/sftl_lwvm.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* LwVM header parsing and partition address translation. */
+#include "sftl.h"
+#include "sftl_port.h"
+
+#define LWVM_MAGIC_0	0xcf88906au
+#define CHUNK_LBAS	4096u
+#define CHUNK_BYTES	(CHUNK_LBAS * 4096ull)
+#define ENTRY_OFF	0x200
+#define MAP_OFF		0x800
+#define MAP_HEADER	0xf000
+#define MAP_FREE	0xf111
+#define MAP_PAST	0xf3ff
+
+static u32 crc32_update(u32 crc, u8 byte)
+{
+	unsigned int b;
+
+	crc ^= byte;
+	for (b = 0; b < 8; b++)
+		crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1)));
+	return crc;
+}
+
+u32 sftl_crc32(const u8 *p, u32 len)
+{
+	u32 crc = 0xffffffffu;
+	u32 i;
+
+	for (i = 0; i < len; i++)
+		crc = crc32_update(crc, p[i]);
+	return ~crc;
+}
+
+/* The header's CRC covers all 4096 bytes with its own field read as zero. */
+static u32 header_crc(const u8 *hdr)
+{
+	u32 crc = 0xffffffffu;
+	u32 i;
+
+	for (i = 0; i < SFTL_LBA_SIZE; i++)
+		crc = crc32_update(crc, (i >= 0x2c && i < 0x30) ? 0 : hdr[i]);
+	return ~crc;
+}
+
+static void utf16_to_ascii(const u8 *in, char *out, unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i + 1 < n; i++) {
+		u16 c = sftl_get16(in + 2 * i);
+
+		if (!c)
+			break;
+		out[i] = c < 0x80 ? (char)c : '?';
+	}
+	out[i] = 0;
+}
+
+int sftl_lwvm_parse(const u8 *hdr, const u8 *backup, struct sftl_lwvm *out)
+{
+	u32 i, j;
+
+	if (sftl_get32(hdr) != LWVM_MAGIC_0)
+		return -EINVAL;
+	if (header_crc(hdr) != sftl_get32(hdr + 0x2c))
+		return -EINVAL;
+	if (backup && memcmp(hdr, backup, SFTL_LBA_SIZE))
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	out->media_size = sftl_get64(hdr + 0x20);
+	out->nparts = sftl_get32(hdr + 0x28);
+	if (out->nparts > SFTL_MAX_PARTS)
+		return -EINVAL;
+	for (i = 0; i < out->nparts; i++) {
+		const u8 *e = hdr + ENTRY_OFF + 128 * i;
+		struct sftl_part *p = &out->part[i];
+
+		p->start = sftl_get64(e + 32);
+		p->end = sftl_get64(e + 40);
+		p->attrs = sftl_get64(e + 48);
+		utf16_to_ascii(e + 56, p->name, sizeof(p->name));
+		if (p->end <= p->start || p->end > out->media_size)
+			return -EINVAL;
+		p->nlbas = (u32)((p->end - p->start) / SFTL_LBA_SIZE);
+		for (j = 0; j < SFTL_LWVM_CHUNKS; j++)
+			p->chunk[j] = 0xffff;
+	}
+	for (j = 0; j < SFTL_LWVM_CHUNKS; j++) {
+		u16 v = sftl_get16(hdr + MAP_OFF + 2 * j);
+		u32 pn, idx;
+
+		if (v == MAP_HEADER || v == MAP_FREE || v == MAP_PAST)
+			continue;
+		pn = v >> 12;
+		idx = v & 0xfff;
+		if (pn >= out->nparts || idx >= SFTL_LWVM_CHUNKS)
+			return -EINVAL;
+		out->part[pn].chunk[idx] = (u16)j;
+		if (idx >= out->part[pn].nchunks)
+			out->part[pn].nchunks = idx + 1;
+	}
+	for (i = 0; i < out->nparts; i++) {
+		struct sftl_part *p = &out->part[i];
+		u64 chunks = (p->end - p->start + CHUNK_BYTES - 1);
+
+#ifdef __KERNEL__
+		do_div(chunks, CHUNK_BYTES);
+#else
+		chunks /= CHUNK_BYTES;
+#endif
+		if (chunks != p->nchunks)
+			return -EINVAL;
+		for (j = 0; j < p->nchunks; j++)
+			if (p->chunk[j] == 0xffff)
+				return -EINVAL;
+	}
+	return 0;
+}
+
+int sftl_lwvm_load(struct sftl *fs, struct sftl_lwvm *out)
+{
+	u8 *a, *b;
+	int ret;
+
+	a = sftl_alloc(SFTL_LBA_SIZE * 2);
+	if (!a)
+		return -ENOMEM;
+	b = a + SFTL_LBA_SIZE;
+	ret = sftl_read_lba(fs, 0, a, NULL);
+	if (!ret)
+		ret = sftl_read_lba(fs, 4095, b, NULL);
+	if (!ret)
+		ret = sftl_lwvm_parse(a, b, out);
+	sftl_free(a);
+	return ret;
+}
+
+/* Partition-relative LBA to FTL LBA, through the chunk map. */
+int sftl_part_lba(const struct sftl_part *p, u32 rel_lba, u32 *lba)
+{
+	u32 chunk = rel_lba / CHUNK_LBAS;
+	u32 pc;
+
+	if (rel_lba >= p->nlbas || chunk >= p->nchunks)
+		return -EINVAL;
+	pc = p->chunk[chunk];
+	if (pc == 0xffff)
+		return -EIO;
+	*lba = pc * CHUNK_LBAS + rel_lba % CHUNK_LBAS;
+	return 0;
+}
diff --git a/drivers/mtd/nand/apple/sftl_map.c b/drivers/mtd/nand/apple/sftl_map.c
new file mode 100644
index 000000000000..7a51164fc6fd
--- /dev/null
+++ b/drivers/mtd/nand/apple/sftl_map.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* LBA map: a directory of lazily allocated leaves. */
+#include "sftl.h"
+#include "sftl_port.h"
+
+#define LEAF_SHIFT	10
+#define LEAF_ENTRIES	(1u << LEAF_SHIFT)
+#define LEAF_MASK	(LEAF_ENTRIES - 1)
+
+int sftl_map_init(struct sftl_map *m, u32 lbas)
+{
+	m->nleaf = (lbas + LEAF_MASK) >> LEAF_SHIFT;
+	m->leaf = sftl_alloc(m->nleaf * sizeof(*m->leaf));
+	return m->leaf ? 0 : -ENOMEM;
+}
+
+void sftl_map_free(struct sftl_map *m)
+{
+	u32 i;
+
+	if (!m->leaf)
+		return;
+	for (i = 0; i < m->nleaf; i++)
+		sftl_free(m->leaf[i]);
+	sftl_free(m->leaf);
+	m->leaf = NULL;
+}
+
+u32 sftl_map_get(const struct sftl_map *m, u32 lba)
+{
+	const u32 *leaf = m->leaf[lba >> LEAF_SHIFT];
+
+	return leaf ? leaf[lba & LEAF_MASK] : SFTL_UNMAPPED;
+}
+
+int sftl_map_set(struct sftl_map *m, u32 lba, u32 vba)
+{
+	u32 **slot = &m->leaf[lba >> LEAF_SHIFT];
+
+	if (!*slot) {
+		u32 i;
+
+		if (vba == SFTL_UNMAPPED)
+			return 0;
+		*slot = sftl_alloc(LEAF_ENTRIES * sizeof(u32));
+		if (!*slot)
+			return -ENOMEM;
+		for (i = 0; i < LEAF_ENTRIES; i++)
+			(*slot)[i] = SFTL_UNMAPPED;
+	}
+	(*slot)[lba & LEAF_MASK] = vba;
+	return 0;
+}
+
+u32 sftl_map_count_mapped(const struct sftl_map *m, u32 lbas)
+{
+	u32 lba, n = 0;
+
+	for (lba = 0; lba < lbas; lba++)
+		if (sftl_map_get(m, lba) != SFTL_UNMAPPED)
+			n++;
+	return n;
+}
diff --git a/drivers/mtd/nand/apple/sftl_mount.c b/drivers/mtd/nand/apple/sftl_mount.c
new file mode 100644
index 000000000000..dc7ab4c50de0
--- /dev/null
+++ b/drivers/mtd/nand/apple/sftl_mount.c
@@ -0,0 +1,950 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Swiss FTL mount: VFL context, context superblock, tree, replay.
+ * All of this is read-only; the writer is in sftl_write.c.
+ */
+#include "sftl.h"
+#include "sftl_port.h"
+
+#define VFL_BLOCK_A		1062
+#define VFL_BLOCK_B		1063
+#define VFL_HDR_SECTION		0xffff
+#define VFL_MAX_LOG		256
+#define CTX_SECTIONS		6
+
+static const struct {
+	u8 flag;
+	u8 lbas;
+} ctx_layout[CTX_SECTIONS] = {
+	{ 1, 4 }, { 2, 4 }, { 3, 4 }, { 5, 8 }, { 6, 4 }, { 4, 32 },
+};
+
+int sftl_init(struct sftl *fs, const struct sftl_ops *ops, void *hw)
+{
+	unsigned int i;
+
+	memset(fs, 0, sizeof(*fs));
+	fs->ops = ops;
+	fs->hw = hw;
+	for (i = 0; i < SFTL_BANKS; i++) {
+		fs->usage[i] = sftl_alloc(SFTL_BLOCKS * sizeof(u16));
+		if (!fs->usage[i])
+			return -ENOMEM;
+	}
+	fs->rec = sftl_alloc(SFTL_NUM_SB * sizeof(*fs->rec));
+	fs->useq = sftl_alloc(SFTL_NUM_SB * sizeof(*fs->useq));
+	fs->reads = sftl_alloc(SFTL_NUM_SB * sizeof(*fs->reads));
+	fs->stats = sftl_alloc(SFTL_PAGE_SIZE);
+	fs->io_data = sftl_alloc(SFTL_PAGE_SIZE);
+	fs->io_meta = sftl_alloc(SFTL_META_PAGE);
+	fs->cache_data = sftl_alloc(SFTL_PAGE_SIZE);
+	fs->aux_data = sftl_alloc(SFTL_PAGE_SIZE);
+	if (!fs->aux_data)
+		return -ENOMEM;
+	if (!fs->rec || !fs->useq || !fs->reads || !fs->stats || !fs->io_data ||
+	    !fs->io_meta || !fs->cache_data)
+		return -ENOMEM;
+	return 0;
+}
+
+void sftl_exit(struct sftl *fs)
+{
+	unsigned int i;
+
+	for (i = 0; i < SFTL_BANKS; i++)
+		sftl_free(fs->usage[i]);
+	sftl_free(fs->rec);
+	sftl_free(fs->useq);
+	sftl_free(fs->reads);
+	sftl_free(fs->stats);
+	sftl_free(fs->io_data);
+	sftl_free(fs->io_meta);
+	sftl_free(fs->cache_data);
+	sftl_free(fs->aux_data);
+	sftl_map_free(&fs->map);
+}
+
+static bool status_ok(u8 st)
+{
+	return st == SFTL_ST_OK || st == SFTL_ST_REFRESH;
+}
+
+static int read_page(struct sftl *fs, u32 bank, u32 block, u32 page, bool slc,
+		     u8 *data, u8 *meta, u8 *st)
+{
+	return fs->ops->read_page(fs->hw, bank, block, page, slc, data, meta, st);
+}
+
+/* The VFL log of one bank: position -> (block, page). */
+struct vfl_entry {
+	bool present;
+	u16 section;
+	u8 block_b;
+	u8 page;
+};
+
+static int vfl_scan_log(struct sftl *fs, u32 bank, struct vfl_entry *log,
+			u32 *max_hdr, u32 *pages_b)
+{
+	int have_header = 0;
+	u32 k;
+	u32 blk;
+
+	*max_hdr = 0;
+	*pages_b = 0;
+	for (blk = 0; blk < 2; blk++) {
+		u32 block = blk ? VFL_BLOCK_B : VFL_BLOCK_A;
+
+		for (k = 0; k < SFTL_SLC_PAGES; k++) {
+			u8 st;
+			int ret = read_page(fs, bank, block, k, true,
+					    fs->io_data, fs->io_meta, &st);
+			u32 pos, section;
+
+			if (ret)
+				return ret;
+			if (st == SFTL_ST_ERASED)
+				break;
+			if (!status_ok(st) || fs->io_meta[0] != SFTL_MT_VFL)
+				return -EIO;
+			pos = ~sftl_get32(fs->io_meta + 4);
+			section = sftl_get16(fs->io_meta + 1);
+			if (pos >= VFL_MAX_LOG)
+				return -EIO;
+			log[pos].present = true;
+			log[pos].section = (u16)section;
+			log[pos].block_b = (u8)blk;
+			log[pos].page = (u8)k;
+			if (section == VFL_HDR_SECTION &&
+			    (!have_header || pos > *max_hdr)) {
+				*max_hdr = pos;
+				have_header = 1;
+			}
+			if (blk)
+				*pages_b = k + 1;
+		}
+	}
+	return have_header ? 0 : -ENOENT;
+}
+
+static int vfl_read_tables(struct sftl *fs, u32 bank, struct vfl_entry *log,
+			   u32 hdr_pos)
+{
+	u32 positions[SFTL_BANKS];
+	u32 n;
+	u8 st;
+	int ret;
+
+	ret = read_page(fs, bank,
+			log[hdr_pos].block_b ? VFL_BLOCK_B : VFL_BLOCK_A,
+			log[hdr_pos].page, true, fs->io_data, fs->io_meta, &st);
+	if (ret)
+		return ret;
+	if (!status_ok(st))
+		return -EIO;
+	if (sftl_get32(fs->io_data) != 0xffffffffu ||
+	    sftl_get16(fs->io_data + 12) != SFTL_NUM_SB)
+		return -EIO;
+	fs->reported_lbas = sftl_get32(fs->io_data + 4);
+	for (n = 0; n < SFTL_BANKS; n++)
+		positions[n] = sftl_get32(fs->io_data + 0x200 + 32 * n);
+
+	for (n = 0; n < SFTL_BANKS; n++) {
+		u32 pos = positions[n];
+		u32 b;
+
+		if (pos >= VFL_MAX_LOG || !log[pos].present ||
+		    log[pos].section != n)
+			return -EIO;
+		ret = read_page(fs, bank,
+				log[pos].block_b ? VFL_BLOCK_B : VFL_BLOCK_A,
+				log[pos].page, true, fs->io_data, fs->io_meta,
+				&st);
+		if (ret)
+			return ret;
+		if (!status_ok(st))
+			return -EIO;
+		for (b = 0; b < SFTL_BLOCKS; b++)
+			fs->usage[n][b] = sftl_get16(fs->io_data + 2 * b);
+	}
+	return 0;
+}
+
+int sftl_load_vfl(struct sftl *fs)
+{
+	struct vfl_entry *log;
+	u32 bank, n, sb;
+	int ret = -ENOENT;
+
+	log = sftl_alloc(VFL_MAX_LOG * sizeof(*log));
+	if (!log)
+		return -ENOMEM;
+	for (bank = 0; bank < SFTL_BANKS; bank++) {
+		u32 hdr, pages_b;
+
+		memset(log, 0, VFL_MAX_LOG * sizeof(*log));
+		ret = vfl_scan_log(fs, bank, log, &hdr, &pages_b);
+		if (ret)
+			continue;
+		ret = vfl_read_tables(fs, bank, log, hdr);
+		if (ret)
+			continue;
+		fs->vfl_block = pages_b ? VFL_BLOCK_B : VFL_BLOCK_A;
+		fs->vfl_log_pages = pages_b;
+		break;
+	}
+	sftl_free(log);
+	if (ret)
+		return ret;
+
+	fs->sig_bank = SFTL_BANKS;
+	for (n = 0; n < SFTL_BANKS; n++) {
+		u32 b;
+
+		for (b = 0; b < SFTL_BLOCKS; b++) {
+			if (fs->usage[n][b] == 0xc101) {
+				fs->sig_bank = n;
+				fs->sig_block = b;
+			}
+		}
+	}
+	for (sb = 0; sb < SFTL_NUM_SB; sb++) {
+		struct sftl_sb_shape *sh = &fs->shape[sb];
+
+		sh->width = 0;
+		for (n = 0; n < SFTL_BANKS; n++)
+			if (fs->usage[n][sb] == 0)
+				sh->bank[sh->width++] = (u8)n;
+	}
+	return 0;
+}
+
+/* First VBA of every superblock; collects the context candidates. */
+int sftl_scan(struct sftl *fs)
+{
+	u32 sb;
+
+	fs->n_ctx = 0;
+	for (sb = 0; sb < SFTL_NUM_SB; sb++) {
+		struct sftl_sb_probe *pr = &fs->probe[sb];
+		u8 st;
+		int ret;
+
+		pr->first_type = SFTL_MT_ERASED;
+		pr->first_weave = 0;
+		pr->flags = 0;
+		if (!fs->shape[sb].width)
+			continue;
+		ret = read_page(fs, fs->shape[sb].bank[0], sb, 0, false,
+				fs->io_data, fs->io_meta, &st);
+		if (ret)
+			return ret;
+		if (st == SFTL_ST_ERASED)
+			continue;
+		if (!status_ok(st)) {
+			sftl_warn("sb %u first page status %#x", sb, st);
+			pr->first_type = 0;
+			continue;
+		}
+		pr->first_type = fs->io_meta[0];
+		pr->flags = fs->io_meta[1];
+		pr->first_weave = sftl_get48(fs->io_meta + 2);
+		if (pr->first_type == SFTL_MT_CONTEXT && pr->flags == 1 &&
+		    fs->n_ctx < SFTL_MAX_CTX)
+			fs->ctx_list[fs->n_ctx++] = sb;
+	}
+	return 0;
+}
+
+static int tree_ingest(struct sftl *fs, const u8 *lba_img, u32 *cursor,
+		       u32 *runs)
+{
+	u32 pos = sftl_get32(lba_img);
+	u32 i;
+
+	if (sftl_get32(lba_img + 4) != 0xfffffff0u || pos != *cursor)
+		return -EIO;
+	for (i = 0; i < 511; i++) {
+		u32 vba = sftl_get32(lba_img + 8 + 8 * i);
+		u32 span = sftl_get32(lba_img + 12 + 8 * i);
+		u32 j;
+
+		if (vba == 0xffffffffu)
+			break;
+		if (span == 0 || *cursor + span > fs->total_lbas)
+			return -EIO;
+		for (j = 0; j < span; j++) {
+			int ret = sftl_map_set(&fs->map, *cursor + j,
+					       vba == SFTL_UNMAPPED ?
+					       SFTL_UNMAPPED : vba + j);
+			if (ret)
+				return ret;
+		}
+		*cursor += span;
+		(*runs)++;
+	}
+	return 0;
+}
+
+/* Read one context copy; on success its map and SB tables are loaded. */
+static int context_try(struct sftl *fs, u32 sb)
+{
+	u32 cursor = 0, runs = 0, used = 0;
+	u32 i;
+	u64 base = fs->probe[sb].first_weave;
+	u32 sec = 0, sec_idx = 0;
+	u8 *pagebuf;
+	int ret;
+
+	pagebuf = sftl_alloc(SFTL_CTX_PAGES * SFTL_PAGE_SIZE +
+			     SFTL_CTX_PAGES * SFTL_META_PAGE);
+	if (!pagebuf)
+		return -ENOMEM;
+
+	for (i = 0; i < SFTL_CTX_PAGES; i++) {
+		u32 row = i;
+		u32 w = fs->shape[sb].width;
+		u8 st;
+
+		ret = read_page(fs, fs->shape[sb].bank[row % w], sb, row / w,
+				false, pagebuf + i * SFTL_PAGE_SIZE,
+				pagebuf + SFTL_CTX_PAGES * SFTL_PAGE_SIZE +
+				i * SFTL_META_PAGE, &st);
+		if (ret)
+			goto out;
+		if (!status_ok(st)) {
+			ret = -EIO;
+			goto out;
+		}
+	}
+
+	for (i = 0; i < SFTL_CTX_LBAS; i++) {
+		const u8 *meta = pagebuf + SFTL_CTX_PAGES * SFTL_PAGE_SIZE +
+				 (i / 4) * SFTL_META_PAGE + (i % 4) * SFTL_META_LBA;
+
+		if (sec_idx == ctx_layout[sec].lbas) {
+			sec++;
+			sec_idx = 0;
+		}
+		if (meta[0] != SFTL_MT_CONTEXT || meta[1] != ctx_layout[sec].flag ||
+		    sftl_get48(meta + 2) != base + i) {
+			ret = -EIO;
+			goto out;
+		}
+		sec_idx++;
+	}
+
+	/* Stats section is LBAs 4..7 = page 1. */
+	memcpy(fs->stats, pagebuf + 1 * SFTL_PAGE_SIZE, SFTL_PAGE_SIZE);
+
+	/* SB array, page 2. */
+	{
+		const u8 *p = pagebuf + 2 * SFTL_PAGE_SIZE;
+
+		for (i = 0; i < SFTL_NUM_SB; i++) {
+			const u8 *e = p + 8 * i;
+
+			fs->rec[i].type = e[0];
+			fs->rec[i].btoc_flags = e[1];
+			fs->rec[i].valid = sftl_get16(e + 2);
+			fs->rec[i].reserved = sftl_get16(e + 4);
+			fs->rec[i].erases = sftl_get16(e + 6);
+		}
+		/* User sequences, pages 3-4. */
+		p = pagebuf + 3 * SFTL_PAGE_SIZE;
+		for (i = 0; i < SFTL_NUM_SB; i++) {
+			fs->useq[i].min = sftl_get32(p + 16 * i);
+			fs->useq[i].max = sftl_get32(p + 16 * i + 4);
+			fs->useq[i].avg = sftl_get32(p + 16 * i + 8);
+			fs->useq[i].count = sftl_get32(p + 16 * i + 12);
+		}
+		/* Read counts, page 5. */
+		p = pagebuf + 5 * SFTL_PAGE_SIZE;
+		for (i = 0; i < SFTL_NUM_SB; i++)
+			fs->reads[i] = sftl_get32(p + 4 * i);
+	}
+
+	/*
+	 * Tree: from page 6, 32 LBAs in the contexts iOS writes, and for as long
+	 * as the metadata continues the section in contexts with a longer one.
+	 */
+	sftl_map_free(&fs->map);
+	fs->total_lbas = SFTL_TOTAL_LBAS;
+	ret = sftl_map_init(&fs->map, fs->total_lbas);
+	if (ret)
+		goto out;
+	{
+		u32 t, limit = sftl_capacity(fs, sb) - SFTL_CTX_TREE_VBA;
+		bool ended = false;
+
+		for (t = 0; t < limit; t++) {
+			const u8 *img;
+
+			if (t < SFTL_TREE_LBAS) {
+				img = pagebuf + 6 * SFTL_PAGE_SIZE + t * SFTL_LBA_SIZE;
+			} else {
+				u32 o = 24 + t, bank, page, slot;
+				u8 st;
+				const u8 *m;
+
+				if (!sftl_locate(fs, sftl_vba(sb, o), &bank, &page, &slot))
+					break;
+				if (slot == 0) {
+					ret = read_page(fs, bank, sb, page, false, fs->io_data,
+							fs->io_meta, &st);
+					if (ret)
+						goto out;
+					if (!status_ok(st))
+						break;
+				}
+				m = fs->io_meta + slot * SFTL_META_LBA;
+				if (m[0] != SFTL_MT_CONTEXT || m[1] != 4 ||
+				    sftl_get48(m + 2) != base + o)
+					break;
+				img = fs->io_data + slot * SFTL_LBA_SIZE;
+			}
+			/* Empty tree LBAs end the tree but still belong to the context. */
+			if (sftl_get32(img) == 0xffffffffu &&
+			    sftl_get32(img + 4) == 0xffffffffu)
+				ended = true;
+			if (ended)
+				continue;
+			ret = tree_ingest(fs, img, &cursor, &runs);
+			if (ret)
+				goto out;
+			used++;
+		}
+		fs->ctx_lbas = SFTL_CTX_TREE_VBA + t;
+	}
+	if (used > SFTL_TREE_LBAS)
+		sftl_warn("context sb %u: tree of %u LBAs, longer than the usual %u",
+			  sb, used, SFTL_TREE_LBAS);
+	if (cursor != fs->total_lbas)
+		sftl_info("context sb %u: tree covers %u LBAs of %u", sb, cursor, fs->total_lbas);
+
+	fs->ctx_sb = sb;
+	fs->ctx_weave = base;
+	fs->tree_runs = runs;
+	fs->tree_used = used;
+	fs->mapped_before = sftl_map_count_mapped(&fs->map, fs->total_lbas);
+	ret = 0;
+out:
+	sftl_free(pagebuf);
+	return ret;
+}
+
+int sftl_load_context(struct sftl *fs)
+{
+	u32 order[SFTL_MAX_CTX];
+	unsigned int i, j, n = fs->n_ctx;
+
+	for (i = 0; i < n; i++)
+		order[i] = fs->ctx_list[i];
+	/* Newest base weave first. */
+	for (i = 0; i < n; i++)
+		for (j = i + 1; j < n; j++)
+			if (fs->probe[order[j]].first_weave >
+			    fs->probe[order[i]].first_weave) {
+				u32 t = order[i];
+
+				order[i] = order[j];
+				order[j] = t;
+			}
+	for (i = 0; i < n; i++) {
+		int ret = context_try(fs, order[i]);
+
+		if (!ret)
+			return 0;
+		sftl_warn("context sb %u unusable (%d), trying older", order[i],
+			  ret);
+	}
+	return -ENOENT;
+}
+
+bool sftl_sb_closed(struct sftl *fs, u32 sb, u8 *last_meta)
+{
+	u32 cap = sftl_capacity(fs, sb);
+	u32 bank, page, slot;
+	u8 st;
+
+	if (!cap || !sftl_locate(fs, sftl_vba(sb, cap - 1), &bank, &page, &slot))
+		return false;
+	if (read_page(fs, bank, sb, page, false, fs->io_data, fs->io_meta, &st))
+		return false;
+	if (!status_ok(st) || fs->io_meta[slot * SFTL_META_LBA] != SFTL_MT_BTOC)
+		return false;
+	if (last_meta)
+		memcpy(last_meta, fs->io_meta + slot * SFTL_META_LBA, SFTL_META_LBA);
+	return true;
+}
+
+/* Read a BTOC image of nb LBAs into img (at most 2 pages). */
+int sftl_read_btoc(struct sftl *fs, u32 sb, u32 *nb, u8 *img)
+{
+	u8 meta[SFTL_META_LBA];
+	u32 cap = sftl_capacity(fs, sb);
+	u32 i;
+
+	if (!sftl_sb_closed(fs, sb, meta))
+		return -ENOENT;
+	*nb = sftl_get16(meta + 12);
+	if (*nb != 4 && *nb != 8)
+		return -EIO;
+	for (i = 0; i < *nb; i += SFTL_LBAS_PER_PAGE) {
+		u32 bank, page, slot;
+		u8 st;
+		int ret;
+
+		if (!sftl_locate(fs, sftl_vba(sb, cap - *nb + i), &bank, &page, &slot))
+			return -EIO;
+		ret = read_page(fs, bank, sb, page, false,
+				img + i * SFTL_LBA_SIZE, fs->io_meta, &st);
+		if (ret)
+			return ret;
+		if (!status_ok(st))
+			return -EIO;
+	}
+	return 0;
+}
+
+void sftl_summarize_useq(const u8 *btoc, u32 entries, struct sftl_useq *out)
+{
+	u64 sum = 0;
+	u32 i, mn = 0xffffffffu, mx = 0;
+
+	for (i = 0; i < entries; i++) {
+		u32 u = sftl_get32(btoc + 16 * i + 4);
+
+		if (u < mn)
+			mn = u;
+		if (u > mx)
+			mx = u;
+		sum += u;
+	}
+	if (entries == 0) {
+		out->min = out->max = out->avg = 0;
+	} else {
+		u64 avg = sum;
+
+#ifdef __KERNEL__
+		do_div(avg, entries);
+#else
+		avg /= entries;
+#endif
+		out->min = mn;
+		out->max = mx;
+		out->avg = (u32)avg;
+	}
+	out->count = entries;
+}
+
+/*
+ * Replay of a single mapping.  Replay is applied in weave order per LBA via
+ * rp_weave[]: a later (higher-weave) write of an LBA wins whatever the order
+ * in which superblocks are walked.
+ */
+struct replay_state {
+	u64 min_weave;		/* apply only weaves above this */
+	struct sftl_map guard;	/* lba -> weave - min_weave (0 = none) */
+};
+
+static bool replay_newer(struct replay_state *rs, u32 lba, u64 weave)
+{
+	u32 cur = sftl_map_get(&rs->guard, lba);
+	u32 off;
+
+	if (weave <= rs->min_weave)
+		return false;
+	off = (u32)(weave - rs->min_weave);
+	if (cur != SFTL_UNMAPPED && cur >= off)
+		return false;
+	return sftl_map_set(&rs->guard, lba, off) == 0;
+}
+
+static void note_weave(struct sftl *fs, u64 weave)
+{
+	if (weave >= fs->next_weave)
+		fs->next_weave = weave + 1;
+}
+
+static int apply_data(struct sftl *fs, struct replay_state *rs, u32 lba,
+		      u64 weave, u32 vba)
+{
+	if (lba >= fs->total_lbas)
+		return -EIO;
+	note_weave(fs, weave);
+	if (!replay_newer(rs, lba, weave))
+		return 0;
+	return sftl_map_set(&fs->map, lba, vba);
+}
+
+/* A DELETE token's payload: u32 n, then n (lba, count). */
+static int apply_delete(struct sftl *fs, struct replay_state *rs, u32 vba,
+			u64 weave)
+{
+	u32 bank, page, slot;
+	u8 st;
+	int ret;
+	u8 *payload;
+	u32 i, n;
+
+	if (!sftl_locate(fs, vba, &bank, &page, &slot))
+		return -EIO;
+	ret = read_page(fs, bank, sftl_sb_of(vba), page, false,
+			fs->aux_data, fs->aux_meta, &st);
+	if (ret)
+		return ret;
+	if (!status_ok(st))
+		return -EIO;
+	payload = fs->aux_data + slot * SFTL_LBA_SIZE;
+	n = sftl_get32(payload);
+	if (n > (SFTL_LBA_SIZE - 4) / 8)
+		return -EIO;
+	note_weave(fs, weave);
+	for (i = 0; i < n; i++) {
+		u32 lba = sftl_get32(payload + 4 + 8 * i);
+		u32 cnt = sftl_get32(payload + 8 + 8 * i);
+		u32 j;
+
+		if (lba >= fs->total_lbas || cnt > fs->total_lbas - lba)
+			return -EIO;
+		for (j = 0; j < cnt; j++) {
+			if (!replay_newer(rs, lba + j, weave))
+				continue;
+			ret = sftl_map_set(&fs->map, lba + j, SFTL_UNMAPPED);
+			if (ret)
+				return ret;
+		}
+	}
+	return 0;
+}
+
+static int replay_sb_btoc(struct sftl *fs, struct replay_state *rs, u32 sb,
+			  u32 *applied)
+{
+	u8 *btoc;
+	u32 nb, i, pos = 0;
+	u64 first = fs->probe[sb].first_weave;
+	int ret;
+
+	btoc = sftl_alloc(2 * SFTL_PAGE_SIZE);
+	if (!btoc)
+		return -ENOMEM;
+	ret = sftl_read_btoc(fs, sb, &nb, btoc);
+	if (ret)
+		goto out;
+	{
+		u8 meta[SFTL_META_LBA];
+
+		/* max_weave_add may include the BTOC itself (iOS's "+nb"). */
+		if (sftl_sb_closed(fs, sb, meta))
+			note_weave(fs, first + sftl_get32(meta + 8) - 1);
+	}
+	for (i = 0; i < nb * SFTL_LBA_SIZE / 16; i++) {
+		const u8 *e = btoc + 16 * i;
+		u32 woff = sftl_get32(e);
+		u32 lba = sftl_get32(e + 8);
+		u32 cnt = sftl_get32(e + 12);
+		u32 j;
+
+		if (cnt == 0)
+			break;
+		if (lba >= SFTL_TOKEN_MIN) {
+			if (lba == SFTL_TOKEN_DELETE) {
+				if (cnt != 1) {
+					ret = -EIO;
+					goto out;
+				}
+				ret = apply_delete(fs, rs, sftl_vba(sb, pos),
+						   first + woff);
+				if (ret)
+					goto out;
+			} else {
+				/* PAD: a run of VBAs that carry nothing. */
+				note_weave(fs, first + woff + cnt - 1);
+			}
+			pos += cnt;
+			continue;
+		}
+		for (j = 0; j < cnt; j++) {
+			ret = apply_data(fs, rs, lba + j, first + woff + j,
+					 sftl_vba(sb, pos + j));
+			if (ret)
+				goto out;
+		}
+		pos += cnt;
+		(*applied) += cnt;
+	}
+	if (pos > sftl_capacity(fs, sb) - nb)
+		ret = -EIO;
+out:
+	sftl_free(btoc);
+	return ret;
+}
+
+static int replay_sb_walk(struct sftl *fs, struct replay_state *rs, u32 sb,
+			  u32 *applied)
+{
+	u32 cap = sftl_capacity(fs, sb);
+	u32 o;
+
+	for (o = 0; o < cap; o += SFTL_LBAS_PER_PAGE) {
+		u32 bank, page, slot, i;
+		u8 st;
+		int ret;
+
+		if (!sftl_locate(fs, sftl_vba(sb, o), &bank, &page, &slot))
+			return -EIO;
+		ret = read_page(fs, bank, sb, page, false, fs->io_data,
+				fs->io_meta, &st);
+		if (ret)
+			return ret;
+		if (st == SFTL_ST_ERASED)
+			return 0;
+		if (!status_ok(st)) {
+			/*
+			 * Spec 4.9: a program that failed leaves a page that is
+			 * not taken; what it held was written again elsewhere
+			 * with a higher weave, or never acknowledged.
+			 */
+			sftl_warn("replay walk sb %u offset %u: status %#x, page skipped",
+				  sb, o, st);
+			fs->torn[sb / 8] |= 1 << (sb % 8);
+			continue;
+		}
+		if (fs->io_meta[0] == SFTL_MT_BTOC)
+			return 0;
+		for (i = 0; i < SFTL_LBAS_PER_PAGE; i++) {
+			const u8 *m = fs->io_meta + i * SFTL_META_LBA;
+			u64 weave = sftl_get48(m + 2);
+			u32 lba = sftl_get32(m + 8);
+
+			if (m[0] != SFTL_MT_USER && m[0] != SFTL_MT_INTERNAL)
+				return 0;
+			note_weave(fs, weave);
+			if (weave <= rs->min_weave)
+				continue;
+			(*applied)++;
+			if (lba == SFTL_TOKEN_PAD)
+				continue;
+			if (lba == SFTL_TOKEN_DELETE) {
+				ret = apply_delete(fs, rs, sftl_vba(sb, o + i), weave);
+				if (ret)
+					return ret;
+				continue;
+			}
+			if (lba >= fs->total_lbas) {
+				sftl_err("replay walk sb %u offset %u: lba %#x type %#x weave %llu",
+					 sb, o + i, lba, m[0], (unsigned long long)weave);
+				return -EIO;
+			}
+			ret = apply_data(fs, rs, lba, weave, sftl_vba(sb, o + i));
+			if (ret)
+				return ret;
+		}
+	}
+	return 0;
+}
+
+int sftl_replay(struct sftl *fs)
+{
+	u32 *set;
+	u64 *weaves;
+	struct replay_state rs;
+	u32 sb, n = 0, i, j;
+	int ret;
+
+	rs.min_weave = fs->ctx_weave;
+	memset(fs->torn, 0, sizeof(fs->torn));
+	ret = sftl_map_init(&rs.guard, fs->total_lbas);
+	if (ret)
+		return ret;
+	set = sftl_alloc(SFTL_NUM_SB * sizeof(*set));
+	weaves = sftl_alloc(SFTL_NUM_SB * sizeof(*weaves));
+	if (!set || !weaves) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	note_weave(fs, fs->ctx_weave + fs->ctx_lbas - 1);
+	for (sb = 0; sb < SFTL_NUM_SB; sb++) {
+		const struct sftl_sb_probe *pr = &fs->probe[sb];
+		u8 t = fs->rec[sb].type;
+		bool fresh = pr->first_type != SFTL_MT_ERASED &&
+			     pr->first_type != SFTL_MT_CONTEXT &&
+			     pr->first_type != 0 &&
+			     pr->first_weave > fs->ctx_weave;
+		bool open_rec = (t == SFTL_SB_OPEN || t == SFTL_SB_OPEN_ALT) &&
+				pr->first_type != SFTL_MT_ERASED &&
+				pr->first_type != SFTL_MT_CONTEXT;
+
+		note_weave(fs, pr->first_weave);
+		if (fresh || open_rec) {
+			set[n] = sb;
+			weaves[n] = pr->first_weave;
+			n++;
+		}
+	}
+
+	/* Ascending first weave. */
+	for (i = 1; i < n; i++) {
+		for (j = i; j > 0 && weaves[j - 1] > weaves[j]; j--) {
+			u64 tw = weaves[j];
+			u32 ts = set[j];
+
+			weaves[j] = weaves[j - 1];
+			set[j] = set[j - 1];
+			weaves[j - 1] = tw;
+			set[j - 1] = ts;
+		}
+	}
+
+	fs->n_replay = 0;
+	fs->replay_applied = 0;
+	for (i = 0; i < n; i++) {
+		u32 s = set[i];
+		const struct sftl_sb_probe *pr = &fs->probe[s];
+		bool fresh = pr->first_weave > fs->ctx_weave;
+		bool closed = sftl_sb_closed(fs, s, NULL);
+		u32 applied = 0;
+
+		if (closed && fresh)
+			ret = replay_sb_btoc(fs, &rs, s, &applied);
+		else
+			ret = replay_sb_walk(fs, &rs, s, &applied);
+		if (ret) {
+			sftl_err("replay of sb %u failed: %d", s, ret);
+			goto out;
+		}
+		if (fs->n_replay < SFTL_REPLAY_LOG) {
+			fs->replay_log[fs->n_replay].sb = s;
+			fs->replay_log[fs->n_replay].closed = closed;
+			fs->replay_log[fs->n_replay].applied = applied;
+			fs->n_replay++;
+		}
+		fs->replay_applied += applied;
+		if (applied)
+			fs->replayed = true;
+	}
+	ret = 0;
+out:
+	sftl_map_free(&rs.guard);
+	sftl_free(set);
+	sftl_free(weaves);
+	return ret;
+}
+
+int sftl_mount(struct sftl *fs)
+{
+	int ret;
+
+	ret = sftl_load_vfl(fs);
+	if (ret) {
+		sftl_err("no usable VFL context (%d)", ret);
+		return ret;
+	}
+	ret = sftl_scan(fs);
+	if (ret)
+		return ret;
+	ret = sftl_load_context(fs);
+	if (ret) {
+		sftl_err("no usable FTL context (%d)", ret);
+		return ret;
+	}
+	return sftl_replay(fs);
+}
+
+/* Read-through a one-page cache keyed by physical address. */
+int sftl_read_page_cached(struct sftl *fs, u32 bank, u32 block, u32 page,
+			  u8 *data, u8 *meta)
+{
+	u8 st;
+	int ret;
+
+	if (!(fs->cache_valid && fs->cache_bank == bank &&
+	      fs->cache_block == block && fs->cache_page == page)) {
+		ret = read_page(fs, bank, block, page, false, fs->cache_data,
+				fs->cache_meta, &st);
+		if (ret)
+			return ret;
+		if (!status_ok(st)) {
+			fs->cache_valid = false;
+			return -EIO;
+		}
+		fs->cache_valid = true;
+		fs->cache_bank = (u8)bank;
+		fs->cache_block = (u16)block;
+		fs->cache_page = (u16)page;
+	}
+	if (data)
+		memcpy(data, fs->cache_data, SFTL_PAGE_SIZE);
+	if (meta)
+		memcpy(meta, fs->cache_meta, SFTL_META_PAGE);
+	return 0;
+}
+
+/* Read one VBA's data (optional) and metadata (optional). */
+int sftl_read_vba(struct sftl *fs, u32 vba, u8 *data, u8 *meta16)
+{
+	u32 bank, page, slot;
+	int ret;
+
+	if (!sftl_locate(fs, vba, &bank, &page, &slot))
+		return -EIO;
+	ret = sftl_read_page_cached(fs, bank, sftl_sb_of(vba), page, NULL, NULL);
+	if (ret)
+		return ret;
+	if (data)
+		memcpy(data, fs->cache_data + slot * SFTL_LBA_SIZE, SFTL_LBA_SIZE);
+	if (meta16)
+		memcpy(meta16, fs->cache_meta + slot * SFTL_META_LBA, SFTL_META_LBA);
+	return 0;
+}
+
+/* Read one mapped LBA, checking that the media agrees it is that LBA. */
+int sftl_read_lba(struct sftl *fs, u32 lba, u8 *out, u8 *meta16)
+{
+	u32 vba;
+	u8 meta[SFTL_META_LBA];
+	int ret;
+
+	if (lba >= fs->total_lbas)
+		return -EINVAL;
+	vba = sftl_map_get(&fs->map, lba);
+	if (vba == SFTL_UNMAPPED) {
+		memset(out, 0, SFTL_LBA_SIZE);
+		if (meta16)
+			memset(meta16, 0, SFTL_META_LBA);
+		return 0;
+	}
+	ret = sftl_read_vba(fs, vba, out, meta);
+	if (ret)
+		return ret;
+	if (sftl_get32(meta + 8) != lba) {
+		sftl_err("lba %u at vba %#x: media says lba %u", lba, vba,
+			 sftl_get32(meta + 8));
+		return -EIO;
+	}
+	if (meta16)
+		memcpy(meta16, meta, SFTL_META_LBA);
+	return 0;
+}
+
+/* Recompute the valid counters from the map (used by the writer at start). */
+int sftl_recount_valid(struct sftl *fs)
+{
+	u32 lba, sb;
+
+	for (sb = 0; sb < SFTL_NUM_SB; sb++)
+		fs->rec[sb].valid = 0;
+	for (lba = 0; lba < fs->total_lbas; lba++) {
+		u32 vba = sftl_map_get(&fs->map, lba);
+
+		if (vba == SFTL_UNMAPPED)
+			continue;
+		if (sftl_sb_of(vba) >= SFTL_NUM_SB)
+			return -EIO;
+		fs->rec[sftl_sb_of(vba)].valid++;
+	}
+	return 0;
+}
diff --git a/drivers/mtd/nand/apple/sftl_port.h b/drivers/mtd/nand/apple/sftl_port.h
new file mode 100644
index 000000000000..29cd3fc2d06d
--- /dev/null
+++ b/drivers/mtd/nand/apple/sftl_port.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Host/kernel shims for the portable Swiss FTL core. */
+#ifndef SFTL_PORT_H
+#define SFTL_PORT_H
+
+#ifdef __KERNEL__
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/string.h>
+#include <linux/printk.h>
+#include <linux/sort.h>
+
+#define sftl_alloc(n)	kvzalloc((n), GFP_KERNEL)
+#define sftl_free(p)	kvfree(p)
+#define sftl_info(fmt, ...)	pr_info("sftl: " fmt "\n", ##__VA_ARGS__)
+#define sftl_warn(fmt, ...)	pr_warn("sftl: " fmt "\n", ##__VA_ARGS__)
+#define sftl_err(fmt, ...)	pr_err("sftl: " fmt "\n", ##__VA_ARGS__)
+#else
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+static inline void *sftl_alloc(size_t n)
+{
+	return calloc(1, n);
+}
+
+#define sftl_free(p)	free(p)
+#define sftl_info(fmt, ...)	printf("sftl: " fmt "\n", ##__VA_ARGS__)
+#define sftl_warn(fmt, ...)	printf("sftl: WARN " fmt "\n", ##__VA_ARGS__)
+#define sftl_err(fmt, ...)	printf("sftl: ERR " fmt "\n", ##__VA_ARGS__)
+#endif
+
+#endif
diff --git a/drivers/mtd/nand/apple/sftl_write.c b/drivers/mtd/nand/apple/sftl_write.c
new file mode 100644
index 000000000000..a162bc9cfead
--- /dev/null
+++ b/drivers/mtd/nand/apple/sftl_write.c
@@ -0,0 +1,1188 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Swiss FTL writer: one frontier superblock, BTOC at close, context commits,
+ * and reclaim.  See the spec sections 4.8 and 7.
+ */
+#include "sftl.h"
+#include "sftl_port.h"
+
+static int fail_wedge(struct sftl *fs, const char *why, int err)
+{
+	sftl_err("writer stopped: %s (%d)", why, err);
+	fs->wr->wedged = true;
+	return err ? err : -EIO;
+}
+
+/* Queued for erase after the next commit: never a spare before then. */
+static bool erase_pending(const struct sftl *fs, u32 sb)
+{
+	const struct sftl_writer *w = fs->wr;
+	unsigned int i;
+
+	for (i = 0; i < w->n_pending; i++)
+		if (w->pending_erase[i] == sb)
+			return true;
+	return false;
+}
+
+static bool sb_bad(const struct sftl *fs, u32 sb)
+{
+	return (fs->wr->bad_map[sb / 8] >> (sb % 8)) & 1;
+}
+
+/*
+ * Give up a superblock for this session after a program or erase failure:
+ * type 1 with nothing valid, as spec 4.9 asks.  The VFL is never touched;
+ * if the block is really bad, iOS meets the failure and retires it itself.
+ */
+static void mark_bad(struct sftl *fs, u32 sb)
+{
+	fs->wr->bad_map[sb / 8] |= 1 << (sb % 8);
+	fs->rec[sb].type = SFTL_SB_AWAIT_ERASE;
+	fs->rec[sb].btoc_flags = 0;
+	fs->wr->need_commit = true;
+}
+
+static u32 spare_count(struct sftl *fs, bool four_banks)
+{
+	u32 sb, n = 0;
+
+	for (sb = 0; sb < SFTL_NUM_SB; sb++) {
+		const struct sftl_sb_rec *r = &fs->rec[sb];
+
+		if (r->type != SFTL_SB_ERASED &&
+		    !(r->type == SFTL_SB_AWAIT_ERASE && r->valid == 0))
+			continue;
+		if (!fs->shape[sb].width || sb == fs->wr->fr.sb || erase_pending(fs, sb) ||
+		    sb_bad(fs, sb))
+			continue;
+		if (four_banks && fs->shape[sb].width != SFTL_BANKS)
+			continue;
+		n++;
+	}
+	return n;
+}
+
+static int erase_sb(struct sftl *fs, u32 sb)
+{
+	u32 i;
+
+	if (fs->cache_valid && fs->cache_block == sb)
+		fs->cache_valid = false;
+	for (i = 0; i < fs->shape[sb].width; i++) {
+		int ret = fs->ops->erase_block(fs->hw, fs->shape[sb].bank[i], sb);
+
+		if (ret)
+			return ret;
+	}
+	fs->rec[sb].erases++;
+	fs->rec[sb].type = SFTL_SB_ERASED;
+	fs->rec[sb].btoc_flags = 0;
+	fs->rec[sb].valid = 0;
+	memset(&fs->useq[sb], 0, sizeof(fs->useq[sb]));
+	return 0;
+}
+
+/*
+ * Pick the least worn spare, erase it, return its number or negative.  A
+ * spare whose erase fails is given up and the next one tried.
+ */
+static int take_spare(struct sftl *fs, bool four_banks)
+{
+	unsigned int tries;
+
+	for (tries = 0; tries < 4; tries++) {
+		u32 sb, best = SFTL_NUM_SB;
+		int ret;
+
+		for (sb = 0; sb < SFTL_NUM_SB; sb++) {
+			const struct sftl_sb_rec *r = &fs->rec[sb];
+
+			if (r->type != SFTL_SB_ERASED &&
+			    !(r->type == SFTL_SB_AWAIT_ERASE && r->valid == 0))
+				continue;
+			if (!fs->shape[sb].width || sb == fs->wr->fr.sb ||
+			    erase_pending(fs, sb) || sb_bad(fs, sb))
+				continue;
+			if (four_banks && fs->shape[sb].width != SFTL_BANKS)
+				continue;
+			if (fs->wr->fenced && sb != fs->wr->fence_sb)
+				continue;
+			if (best == SFTL_NUM_SB || r->erases < fs->rec[best].erases)
+				best = sb;
+		}
+		if (best == SFTL_NUM_SB)
+			return -ENOSPC;
+		ret = erase_sb(fs, best);
+		if (!ret)
+			return (int)best;
+		sftl_warn("erase of sb %u failed (%d): not used in this session", best, ret);
+		mark_bad(fs, best);
+		if (++fs->wr->failures > SFTL_FAIL_MAX)
+			break;
+	}
+	return -EIO;
+}
+
+static int open_frontier(struct sftl *fs)
+{
+	struct sftl_frontier *fr = &fs->wr->fr;
+	int sb;
+
+	if (spare_count(fs, true) < 2)
+		return -ENOSPC;
+	sb = take_spare(fs, false);
+	if (sb < 0)
+		return sb;
+	fs->rec[sb].type = SFTL_SB_OPEN;
+	fr->sb = (u32)sb;
+	fr->capacity = sftl_capacity(fs, sb);
+	fr->next = 0;
+	fr->first_set = false;
+	fr->nent = 0;
+	return 0;
+}
+
+static u32 nb_for_entries(u32 entries)
+{
+	return entries + 1 <= SFTL_PAGE_SIZE / 16 ? 4 : 8;
+}
+
+/* Would a page with up to 4 more entries still fit? */
+static bool frontier_has_room(const struct sftl_frontier *fr)
+{
+	u32 ents = fr->nent + SFTL_LBAS_PER_PAGE;
+
+	if (ents + 1 > 2 * SFTL_PAGE_SIZE / 16)
+		return false;
+	return fr->next + SFTL_LBAS_PER_PAGE <= fr->capacity - nb_for_entries(ents);
+}
+
+static void remap(struct sftl *fs, u32 lba, u32 vba)
+{
+	u32 old = sftl_map_get(&fs->map, lba);
+
+	if (old != SFTL_UNMAPPED)
+		fs->rec[sftl_sb_of(old)].valid--;
+	sftl_map_set(&fs->map, lba, vba);
+	fs->rec[sftl_sb_of(vba)].valid++;
+}
+
+static int frontier_fail(struct sftl *fs, const char *what, int err);
+
+static int batch_flush(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+	unsigned int i;
+	int ret;
+
+	if (!w->npages)
+		return 0;
+	ret = fs->ops->program(fs->hw, w->prog, w->npages);
+	fs->cache_valid = false;
+	if (ret)
+		return frontier_fail(fs, "program", ret);
+	for (i = 0; i < w->npages; i++) {
+		u8 st;
+		const struct sftl_prog *p = &w->prog[i];
+
+		if (++w->prog_counter % w->verify_every)
+			continue;
+		ret = fs->ops->read_page(fs->hw, p->bank, p->block, p->page, false,
+					 w->check_data, w->check_meta, &st);
+		if (ret)
+			return frontier_fail(fs, "verify read", ret);
+		if ((st != SFTL_ST_OK && st != SFTL_ST_REFRESH) ||
+		    memcmp(w->check_data, p->data, SFTL_PAGE_SIZE) ||
+		    memcmp(w->check_meta, p->meta, SFTL_META_PAGE))
+			return frontier_fail(fs, "verify", -EIO);
+	}
+	for (i = 0; i < w->pend_n; i++)
+		remap(fs, w->pend_lba[i], w->pend_vba[i]);
+	w->pend_n = 0;
+	w->npages = 0;
+	w->dirty = true;
+	return 0;
+}
+
+static u64 take_weave(struct sftl *fs)
+{
+	return fs->next_weave++;
+}
+
+/* Start a page at the frontier; returns the batch index. */
+static unsigned int page_begin(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+	unsigned int idx = w->npages;
+	struct sftl_prog *p = &w->prog[idx];
+	u32 vba = sftl_vba(w->fr.sb, w->fr.next);
+	u32 bank, page, slot;
+
+	sftl_locate(fs, vba, &bank, &page, &slot);
+	p->bank = (u8)bank;
+	p->slc = false;
+	p->block = (u16)w->fr.sb;
+	p->page = (u16)page;
+	p->data = w->pool + idx * SFTL_PAGE_SIZE;
+	p->meta = w->meta_pool + idx * SFTL_META_PAGE;
+	w->npages++;
+	return idx;
+}
+
+/* Fill slot of the current page.  src == NULL with lba == PAD writes zeros. */
+static void slot_fill(struct sftl *fs, unsigned int idx, unsigned int slot,
+		      u32 lba, const u8 *src, u8 type, u32 user, bool keep_user)
+{
+	struct sftl_writer *w = fs->wr;
+	struct sftl_frontier *fr = &w->fr;
+	u8 *data = w->pool + idx * SFTL_PAGE_SIZE + slot * SFTL_LBA_SIZE;
+	u8 *meta = w->meta_pool + idx * SFTL_META_PAGE + slot * SFTL_META_LBA;
+	u64 weave = take_weave(fs);
+
+	if (!keep_user)
+		user = (u32)(weave >> 16);
+	if (src)
+		memcpy(data, src, SFTL_LBA_SIZE);
+	else
+		memset(data, 0, SFTL_LBA_SIZE);
+	meta[0] = type;
+	meta[1] = 0;
+	sftl_put48(meta + 2, weave);
+	sftl_put32(meta + 8, lba);
+	sftl_put32(meta + 12, user);
+
+	if (!fr->first_set) {
+		fr->first_weave = weave;
+		fr->first_set = true;
+	}
+	fr->last_weave = weave;
+	sftl_btoc_append(w->entries, &fr->nent, fr->first_weave, lba, weave, user);
+
+	if (lba < SFTL_TOKEN_MIN) {
+		w->pend_lba[w->pend_n] = lba;
+		w->pend_vba[w->pend_n] = sftl_vba(fr->sb, fr->next);
+		w->pend_n++;
+	}
+	fr->next++;
+}
+
+/* Close the open frontier: write its BTOC into the last nb VBAs. */
+static int frontier_close(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+	struct sftl_frontier *fr = &w->fr;
+	struct sftl_prog prog[2];
+	u8 metas[2 * SFTL_META_PAGE];
+	u32 nb, i, np, sb = fr->sb;
+	int ret;
+
+	if (sb == SFTL_UNMAPPED)
+		return 0;
+	if (!fr->first_set) {
+		/* Opened but never written: put it back. */
+		fs->rec[sb].type = SFTL_SB_ERASED;
+		fr->sb = SFTL_UNMAPPED;
+		return 0;
+	}
+	/*
+	 * Every closed superblock iOS leaves on the media is written front to
+	 * back with no hole before its BTOC: fill what is left with PAD.  A
+	 * page of PAD adds at most one BTOC entry (runs of 16).
+	 */
+	for (;;) {
+		unsigned int idx, s;
+
+		nb = nb_for_entries(fr->nent + 1);
+		if (fr->next + SFTL_LBAS_PER_PAGE > fr->capacity - nb)
+			break;
+		if (w->npages == SFTL_BATCH_PAGES) {
+			ret = batch_flush(fs);
+			if (ret)
+				return ret;
+		}
+		idx = page_begin(fs);
+		for (s = 0; s < SFTL_LBAS_PER_PAGE; s++)
+			slot_fill(fs, idx, s, SFTL_TOKEN_PAD, NULL, SFTL_MT_USER, 0, false);
+	}
+	ret = batch_flush(fs);
+	if (ret)
+		return ret;
+	sb = fr->sb;		/* a failure in the PAD fill moves to another SB */
+	/* The BTOC follows the data directly: 4 VBAs when that is all that is left. */
+	nb = nb_for_entries(fr->nent);
+	if (nb == 4 && fr->next + 8 <= fr->capacity)
+		nb = 8;
+	sftl_btoc_build(w->entries, fr->nent, w->btoc_img, &nb, nb);
+	np = nb / SFTL_LBAS_PER_PAGE;
+	memset(metas, 0, sizeof(metas));
+	for (i = 0; i < nb; i++) {
+		u8 *m = metas + i * SFTL_META_LBA;
+
+		m[0] = SFTL_MT_BTOC;
+		m[1] = (u8)(nb << 1);
+		sftl_put48(m + 2, fr->first_weave);
+		sftl_put32(m + 8, (u32)(fr->last_weave - fr->first_weave + 1));
+		sftl_put16(m + 12, (u16)nb);
+		sftl_put16(m + 14, 0xffff);
+	}
+	for (i = 0; i < np; i++) {
+		u32 bank, page, slot;
+
+		sftl_locate(fs, sftl_vba(sb, fr->capacity - nb + i * SFTL_LBAS_PER_PAGE),
+			    &bank, &page, &slot);
+		prog[i].bank = (u8)bank;
+		prog[i].slc = false;
+		prog[i].block = (u16)sb;
+		prog[i].page = (u16)page;
+		prog[i].data = w->btoc_img + i * SFTL_PAGE_SIZE;
+		prog[i].meta = metas + i * SFTL_META_PAGE;
+	}
+	ret = fs->ops->program(fs->hw, prog, np);
+	fs->cache_valid = false;
+	for (i = 0; !ret && i < np; i++) {
+		u8 st;
+
+		ret = fs->ops->read_page(fs->hw, prog[i].bank, sb, prog[i].page, false,
+					 w->check_data, w->check_meta, &st);
+		if (!ret && (st != SFTL_ST_OK || memcmp(w->check_data, prog[i].data,
+		    SFTL_PAGE_SIZE) || memcmp(w->check_meta, prog[i].meta, SFTL_META_PAGE)))
+			ret = -EIO;
+	}
+	if (ret) {
+		/* Its data are all mapped: move them out and close where they land. */
+		ret = frontier_fail(fs, "BTOC", ret);
+		return ret ? ret : frontier_close(fs);
+	}
+	sftl_summarize_useq(w->btoc_img, fr->nent, &fs->useq[sb]);
+	fs->rec[sb].type = SFTL_SB_CLOSED;
+	fs->rec[sb].btoc_flags = (u8)(nb << 1);
+	fr->sb = SFTL_UNMAPPED;
+	return 0;
+}
+
+static int ensure_room(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+	int ret;
+
+	if (w->fr.sb != SFTL_UNMAPPED && !frontier_has_room(&w->fr)) {
+		ret = batch_flush(fs);
+		if (!ret)
+			ret = frontier_close(fs);
+		if (ret)
+			return ret;
+	}
+	if (w->fr.sb == SFTL_UNMAPPED) {
+		ret = batch_flush(fs);
+		if (ret)
+			return ret;
+		return open_frontier(fs);
+	}
+	if (w->npages == SFTL_BATCH_PAGES)
+		return batch_flush(fs);
+	return 0;
+}
+
+static int gc_move(struct sftl *fs, const u32 *list, u32 n);
+static int reclaim(struct sftl *fs);
+
+static int read_sibling(struct sftl *fs, u32 vba, u8 *buf, u8 *meta16)
+{
+	return sftl_read_vba(fs, vba, buf, meta16);
+}
+
+/* ---- keeping the tree inside its 32 LBAs -------------------------------- */
+
+#define TREE_RUN_LIMIT		(SFTL_TREE_MAX_LBAS * 511u - 64u)
+#define COMPACT_WINDOW		1024u
+#define COMPACT_TOP_WINDOWS	8u
+#define COMPACT_MAX_PASSES	32u
+
+static bool continues_run(u32 prev_vba, u32 vba)
+{
+	if (vba == SFTL_UNMAPPED)
+		return prev_vba == SFTL_UNMAPPED;
+	return prev_vba != SFTL_UNMAPPED && prev_vba + 1 == vba;
+}
+
+/*
+ * A Linux context holds at most SFTL_TREE_MAX_LBAS tree LBAs of runs.  When
+ * the map fragments past that, rewrite the most fragmented windows
+ * contiguously (as GC does: type and user kept) so the commit can go through.
+ */
+static int tree_compact(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+	u32 nwin = fs->total_lbas / COMPACT_WINDOW + 1;
+	u32 *breaks;
+	u32 pass;
+	int ret = 0;
+
+	breaks = sftl_alloc(nwin * sizeof(*breaks));
+	if (!breaks)
+		return -ENOMEM;
+
+	for (pass = 0; pass < COMPACT_MAX_PASSES; pass++) {
+		u32 lba, prev = SFTL_UNMAPPED, runs = 1, n = 0, t;
+		u32 top[COMPACT_TOP_WINDOWS];
+
+		memset(breaks, 0, nwin * sizeof(*breaks));
+		for (lba = 0; lba < fs->total_lbas; lba++) {
+			u32 v = sftl_map_get(&fs->map, lba);
+
+			if (lba && !continues_run(prev, v)) {
+				runs++;
+				breaks[lba / COMPACT_WINDOW]++;
+			}
+			prev = v;
+		}
+		if (runs <= TREE_RUN_LIMIT)
+			goto out;
+
+		for (t = 0; t < COMPACT_TOP_WINDOWS; t++) {
+			u32 best = nwin, i;
+
+			for (i = 0; i < nwin; i++)
+				if (breaks[i] > 1 && (best == nwin || breaks[i] > breaks[best]))
+					best = i;
+			top[t] = best;
+			if (best == nwin)
+				break;
+			breaks[best] = 0;
+		}
+		if (!t) {
+			ret = -ENOSPC;
+			goto out;
+		}
+		while (t--) {
+			u32 start = top[t] * COMPACT_WINDOW;
+			u32 end = start + COMPACT_WINDOW;
+
+			if (end > fs->total_lbas)
+				end = fs->total_lbas;
+			for (lba = start; lba < end; lba++)
+				if (sftl_map_get(&fs->map, lba) != SFTL_UNMAPPED)
+					w->gc_list[n++] = lba;
+		}
+		sftl_info("tree: %u runs, compacting %u LBAs", runs, n);
+		ret = gc_move(fs, w->gc_list, n);
+		if (ret)
+			goto out;
+	}
+	ret = -ENOSPC;
+out:
+	sftl_free(breaks);
+	return ret;
+}
+
+/*
+ * Build a context from the current state and program it to sb, which must be
+ * freshly erased and marked as a context in the SB array; verify every page.
+ * On success the base weave and length are in fs->ctx_weave and ctx_lbas,
+ * and the weave counter has moved past the context.
+ */
+int sftl_context_write(struct sftl *fs, u32 sb)
+{
+	struct sftl_writer *w = fs->wr;
+	struct sftl_prog *prog = w->ctx_prog;
+	u8 *metas = w->ctx_pages + SFTL_CTX_MAX_PAGES * SFTL_PAGE_SIZE;
+	u64 weave = fs->next_weave;
+	u32 i, nlbas = 0, np;
+	int ret;
+
+	if (fs->shape[sb].width != SFTL_BANKS)
+		return -EINVAL;
+	ret = sftl_ctx_build(fs, sb, weave, w->ctx_pages, metas, &nlbas);
+	if (ret)
+		return fail_wedge(fs, "context build", ret);
+	np = nlbas / SFTL_LBAS_PER_PAGE;
+	for (i = 0; i < np; i++) {
+		prog[i].bank = fs->shape[sb].bank[i % SFTL_BANKS];
+		prog[i].slc = false;
+		prog[i].block = (u16)sb;
+		prog[i].page = (u16)(i / SFTL_BANKS);
+		prog[i].data = w->ctx_pages + i * SFTL_PAGE_SIZE;
+		prog[i].meta = metas + i * SFTL_META_PAGE;
+	}
+	fs->next_weave = weave + nlbas;
+	ret = fs->ops->program(fs->hw, prog, np);
+	fs->cache_valid = false;
+	for (i = 0; !ret && i < np; i++) {
+		u8 st;
+
+		ret = fs->ops->read_page(fs->hw, prog[i].bank, sb, prog[i].page,
+					 false, w->check_data, w->check_meta, &st);
+		if (!ret && (st != SFTL_ST_OK ||
+		    memcmp(w->check_data, prog[i].data, SFTL_PAGE_SIZE) ||
+		    memcmp(w->check_meta, prog[i].meta, SFTL_META_PAGE)))
+			ret = -EIO;
+	}
+	if (ret) {
+		/* The media failed, not the build: the caller may try another SB. */
+		sftl_warn("context on sb %u failed (%d)", sb, ret);
+		return -EAGAIN;
+	}
+	fs->ctx_weave = weave;
+	fs->ctx_lbas = nlbas;
+	sftl_info("context written to sb %u: weave %llu, %u LBAs (%u pages)", sb,
+		  (unsigned long long)weave, nlbas, np);
+	return 0;
+}
+
+/*
+ * Commit: close the frontier, write a new context to a fresh superblock and
+ * verify every page.  Older contexts and victims are erased only after that.
+ */
+static int commit(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+	u64 weave;
+	u32 i, new_sb, keep = fs->ctx_sb;
+	int ret, sb;
+
+	if (w->fenced && !w->fence_commit)
+		return fail_wedge(fs, "commit while fenced", -EPERM);
+	ret = tree_compact(fs);
+	if (ret)
+		return fail_wedge(fs, "tree does not fit a context", ret);
+	ret = batch_flush(fs);
+	if (ret)
+		return ret;
+	ret = frontier_close(fs);
+	if (ret)
+		return ret;
+
+	sb = take_spare(fs, true);
+	if (sb < 0)
+		return fail_wedge(fs, "no spare for context", sb);
+	new_sb = (u32)sb;
+	fs->rec[new_sb].type = SFTL_SB_CONTEXT;
+
+	/* Every context older than the one we keep is retired by this one. */
+	for (i = 0; i < fs->n_ctx; i++) {
+		u32 c = fs->ctx_list[i];
+
+		if (c != keep && fs->rec[c].type == SFTL_SB_CONTEXT) {
+			fs->rec[c].type = SFTL_SB_AWAIT_ERASE;
+			fs->rec[c].valid = 0;
+			if (w->n_pending < SFTL_MAX_VICTIMS * 2 + SFTL_MAX_CTX)
+				w->pending_erase[w->n_pending++] = c;
+		}
+	}
+
+	for (i = 0; ; i++) {
+		ret = sftl_context_write(fs, new_sb);
+		if (ret != -EAGAIN)
+			break;
+		mark_bad(fs, new_sb);
+		if (i == 2 || ++w->failures > SFTL_FAIL_MAX)
+			return fail_wedge(fs, "context program", -EIO);
+		sb = take_spare(fs, true);
+		if (sb < 0)
+			return fail_wedge(fs, "no spare for context", sb);
+		new_sb = (u32)sb;
+		fs->rec[new_sb].type = SFTL_SB_CONTEXT;
+	}
+	if (ret)
+		return ret;
+	weave = fs->ctx_weave;
+
+	/* The new context stands: retire and erase what it replaced. */
+	for (i = 0; i < w->n_pending; i++) {
+		if (w->pending_erase[i] == new_sb)
+			return fail_wedge(fs, "new context queued for erase", -EIO);
+		ret = erase_sb(fs, w->pending_erase[i]);
+		if (ret) {
+			/* It holds nothing valid already: give it up and go on. */
+			sftl_warn("erase of sb %u after commit failed (%d)",
+				  w->pending_erase[i], ret);
+			mark_bad(fs, w->pending_erase[i]);
+			fs->rec[w->pending_erase[i]].valid = 0;
+			w->failures++;
+		}
+	}
+	w->n_pending = 0;
+
+	fs->n_ctx = 0;
+	fs->ctx_list[fs->n_ctx++] = new_sb;
+	if (keep != new_sb && fs->rec[keep].type == SFTL_SB_CONTEXT)
+		fs->ctx_list[fs->n_ctx++] = keep;
+	fs->ctx_sb = new_sb;
+	fs->replayed = false;
+	w->dirty = false;
+	w->need_commit = false;
+	sftl_info("committed context on sb %u, weave %llu", new_sb,
+		  (unsigned long long)weave);
+	return 0;
+}
+
+int sftl_checkpoint_due(struct sftl *fs)
+{
+	return fs->wr && !fs->wr->wedged &&
+	       (fs->wr->dirty || fs->replayed || fs->wr->need_commit);
+}
+
+int sftl_checkpoint(struct sftl *fs)
+{
+	if (!fs->wr)
+		return -EROFS;
+	if (fs->wr->wedged)
+		return -EIO;
+	if (!sftl_checkpoint_due(fs))
+		return 0;
+	return commit(fs);
+}
+
+/*
+ * Restrict the writer to one superblock, for the device ladder: the frontier
+ * or a commit's context may only go there, reclaim refuses, and commit refuses
+ * unless allowed.  The superblock must be an erased spare with four banks.
+ */
+int sftl_writer_fence(struct sftl *fs, u32 sb, bool allow_commit)
+{
+	struct sftl_writer *w = fs->wr;
+
+	if (!w)
+		return -EROFS;
+	if (sb >= SFTL_NUM_SB || fs->rec[sb].type != SFTL_SB_ERASED ||
+	    fs->shape[sb].width != SFTL_BANKS || w->fr.sb != SFTL_UNMAPPED)
+		return -EINVAL;
+	w->fenced = true;
+	w->fence_commit = allow_commit;
+	w->fence_sb = sb;
+	return 0;
+}
+
+/* Flush what is pending and close the frontier with its BTOC; no commit. */
+int sftl_writer_seal(struct sftl *fs)
+{
+	int ret;
+
+	if (!fs->wr)
+		return -EROFS;
+	if (fs->wr->wedged)
+		return -EIO;
+	ret = batch_flush(fs);
+	return ret ? ret : frontier_close(fs);
+}
+
+/* Run one reclaim now: move the victims' live LBAs, commit, erase them. */
+int sftl_gc(struct sftl *fs)
+{
+	if (!fs->wr)
+		return -EROFS;
+	if (fs->wr->wedged)
+		return -EIO;
+	return reclaim(fs);
+}
+
+/* Move the LBA list (in list order) to the frontier, keeping type and user. */
+static int gc_move(struct sftl *fs, const u32 *list, u32 n)
+{
+	struct sftl_writer *w = fs->wr;
+	u8 meta[SFTL_META_LBA];
+	u32 i = 0;
+	int ret;
+
+	while (i < n) {
+		unsigned int idx, s;
+
+		ret = ensure_room(fs);
+		if (ret)
+			return ret;
+		idx = page_begin(fs);
+		for (s = 0; s < SFTL_LBAS_PER_PAGE; s++) {
+			u32 lba;
+
+			if (i >= n) {
+				slot_fill(fs, idx, s, SFTL_TOKEN_PAD, NULL,
+					  SFTL_MT_USER, 0, false);
+				continue;
+			}
+			lba = list[i++];
+			ret = read_sibling(fs, sftl_map_get(&fs->map, lba),
+					   w->check_data, meta);
+			if (ret)
+				return fail_wedge(fs, "gc read", ret);
+			slot_fill(fs, idx, s, lba, w->check_data, meta[0],
+				  sftl_get32(meta + 12), true);
+		}
+	}
+	return batch_flush(fs);
+}
+
+/*
+ * A program or verify failed on the frontier (spec 4.9): program nothing more
+ * into that SB, leave it unclosed, give it up, and put everything it held on
+ * a new frontier: the failed batch from memory, then every LBA the map still
+ * places in it, read back, keeping type and user.  A commit follows soon.
+ */
+static int frontier_fail(struct sftl *fs, const char *what, int err)
+{
+	struct sftl_writer *w = fs->wr;
+	struct sftl_frontier *fr = &w->fr;
+	unsigned int d = w->fail_depth, i, s, k = 0;
+	u32 sb = fr->sb, lba, n = 0;
+	u8 *rd, *rm;
+	u32 *rl, *list;
+	int ret;
+
+	if (sb == SFTL_UNMAPPED || d >= SFTL_FAIL_DEPTH || ++w->failures > SFTL_FAIL_MAX)
+		return fail_wedge(fs, what, err);
+	sftl_warn("%s failed on sb %u (%d): giving it up, moving its data", what, sb, err);
+	rd = w->rescue_data + (size_t)d * SFTL_RESCUE_LBAS * SFTL_LBA_SIZE;
+	rm = w->rescue_meta + d * SFTL_RESCUE_LBAS * SFTL_META_LBA;
+	rl = w->rescue_lba + d * SFTL_RESCUE_LBAS;
+	list = w->fail_list + d * SFTL_LBAS_PER_SB;
+	w->fail_depth++;
+
+	/* The failed batch: its data are still in memory. */
+	for (i = 0; i < w->npages; i++) {
+		for (s = 0; s < SFTL_LBAS_PER_PAGE; s++) {
+			const u8 *m = w->meta_pool + i * SFTL_META_PAGE + s * SFTL_META_LBA;
+
+			lba = sftl_get32(m + 8);
+			if (lba >= SFTL_TOKEN_MIN)
+				continue;
+			memcpy(rd + (size_t)k * SFTL_LBA_SIZE,
+			       w->pool + i * SFTL_PAGE_SIZE + s * SFTL_LBA_SIZE, SFTL_LBA_SIZE);
+			memcpy(rm + k * SFTL_META_LBA, m, SFTL_META_LBA);
+			rl[k++] = lba;
+		}
+	}
+	w->npages = 0;
+	w->pend_n = 0;
+	mark_bad(fs, sb);
+	fr->sb = SFTL_UNMAPPED;
+
+	/* What the map still places in the failed SB, other than the batch. */
+	for (lba = 0; lba < fs->total_lbas && n < SFTL_LBAS_PER_SB; lba++) {
+		u32 v = sftl_map_get(&fs->map, lba), j;
+
+		if (v == SFTL_UNMAPPED || sftl_sb_of(v) != sb)
+			continue;
+		for (j = 0; j < k && rl[j] != lba; j++)
+			;
+		if (j == k)
+			list[n++] = lba;
+	}
+
+	for (i = 0; i < k; i += SFTL_LBAS_PER_PAGE) {
+		unsigned int idx;
+
+		ret = ensure_room(fs);
+		if (ret)
+			goto out;
+		idx = page_begin(fs);
+		for (s = 0; s < SFTL_LBAS_PER_PAGE; s++) {
+			const u8 *m = rm + (i + s) * SFTL_META_LBA;
+
+			if (i + s < k)
+				slot_fill(fs, idx, s, rl[i + s], rd + (size_t)(i + s) * SFTL_LBA_SIZE,
+					  m[0], sftl_get32(m + 12), true);
+			else
+				slot_fill(fs, idx, s, SFTL_TOKEN_PAD, NULL, SFTL_MT_USER, 0, false);
+		}
+	}
+	ret = batch_flush(fs);
+	if (!ret)
+		ret = gc_move(fs, list, n);
+	if (!ret) {
+		fs->rec[sb].valid = 0;
+		sftl_info("sb %u given up: %u LBAs from the failed batch and %u more moved",
+			  sb, k, n);
+	}
+out:
+	w->fail_depth--;
+	return ret ? fail_wedge(fs, "moving data off a failed SB", ret) : 0;
+}
+
+static int victim_cmp(const struct sftl_sb_rec *a, const struct sftl_sb_rec *b)
+{
+	return (int)a->valid - (int)b->valid;
+}
+
+/*
+ * Choose up to SFTL_MAX_VICTIMS closed, non-static SBs, fewest valid first,
+ * at most 2048 live LBAs in all past the first, and list their live LBAs in
+ * LBA order into w->gc_list.  No media access.  Returns the victim count.
+ */
+static u32 pick_victims(struct sftl *fs, u32 *victims, u32 *count_out, u32 *live_out)
+{
+	struct sftl_writer *w = fs->wr;
+	u32 nv = 0, sb, lba, count = 0, live = 0;
+
+	memset(w->victim_map, 0, (SFTL_NUM_SB + 7) / 8);
+	for (;;) {
+		u32 best = SFTL_NUM_SB;
+
+		for (sb = 0; sb < SFTL_NUM_SB; sb++) {
+			const struct sftl_sb_rec *r = &fs->rec[sb];
+
+			if (r->type != SFTL_SB_CLOSED || (r->btoc_flags & 1) ||
+			    !fs->shape[sb].width || sb == fs->ctx_sb ||
+			    (w->victim_map[sb / 8] >> (sb % 8)) & 1)
+				continue;
+			if (best == SFTL_NUM_SB ||
+			    victim_cmp(r, &fs->rec[best]) < 0)
+				best = sb;
+		}
+		if (best == SFTL_NUM_SB)
+			break;
+		if (nv && live + fs->rec[best].valid > 2048)
+			break;
+		live += fs->rec[best].valid;
+		w->victim_map[best / 8] |= 1 << (best % 8);
+		victims[nv++] = best;
+		if (nv == SFTL_MAX_VICTIMS)
+			break;
+	}
+	for (lba = 0; nv && lba < fs->total_lbas && count < SFTL_MAX_VICTIMS * 4096; lba++) {
+		u32 vba = sftl_map_get(&fs->map, lba);
+
+		if (vba == SFTL_UNMAPPED)
+			continue;
+		sb = sftl_sb_of(vba);
+		if ((w->victim_map[sb / 8] >> (sb % 8)) & 1)
+			w->gc_list[count++] = lba;
+	}
+	*count_out = count;
+	*live_out = live;
+	return nv;
+}
+
+/* What a reclaim would do now: its victims and the live LBAs it would move. */
+int sftl_gc_plan(struct sftl *fs, u32 *victims, u32 *nv, u32 *lbas, u32 *count)
+{
+	u32 live;
+
+	if (!fs->wr)
+		return -EROFS;
+	*nv = pick_victims(fs, victims, count, &live);
+	if (*count != live)
+		return -EIO;
+	memcpy(lbas, fs->wr->gc_list, *count * sizeof(u32));
+	return *nv ? 0 : -ENOSPC;
+}
+
+/* Up to SFTL_MAX_VICTIMS closed, non-static SBs; then a checkpoint. */
+static int reclaim(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+	u32 victims[SFTL_MAX_VICTIMS];
+	u32 nv, i, sb, count = 0, live = 0;
+	int ret;
+
+	if (w->fenced)
+		return fail_wedge(fs, "reclaim while fenced", -EPERM);
+	nv = pick_victims(fs, victims, &count, &live);
+	if (!nv)
+		return -ENOSPC;
+	if (count != live)
+		return fail_wedge(fs, "reclaim list mismatch", -EIO);
+
+	sftl_info("reclaim: %u victims, %u live LBAs", nv, count);
+	if (count) {
+		/* Prefer a clean frontier if the current one cannot hold them. */
+		if (w->fr.sb != SFTL_UNMAPPED && w->fr.capacity - w->fr.next < count + 8) {
+			ret = batch_flush(fs);
+			if (!ret)
+				ret = frontier_close(fs);
+			if (ret)
+				return ret;
+		}
+		ret = gc_move(fs, w->gc_list, count);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < nv; i++) {
+		sb = victims[i];
+		if (fs->rec[sb].valid != 0)
+			return fail_wedge(fs, "victim still valid", -EIO);
+		fs->rec[sb].type = SFTL_SB_AWAIT_ERASE;
+		w->pending_erase[w->n_pending++] = sb;
+	}
+	return commit(fs);
+}
+
+int sftl_write(struct sftl *fs, u32 lba, u32 count, const u8 *src)
+{
+	struct sftl_writer *w = fs->wr;
+	u8 meta[SFTL_META_LBA];
+	int ret;
+
+	if (!w)
+		return -EROFS;
+	if (w->wedged)
+		return -EIO;
+	if (lba + count > fs->reported_lbas || lba + count < lba)
+		return -EINVAL;
+
+	while (spare_count(fs, true) < SFTL_SPARE_FLOOR) {
+		u32 before = spare_count(fs, true);
+
+		ret = reclaim(fs);
+		if (ret)
+			return ret;
+		if (spare_count(fs, true) <= before)
+			break;
+	}
+	if (spare_count(fs, true) < SFTL_SPARE_RESERVE)
+		return -ENOSPC;
+
+	while (count) {
+		u32 base = lba & ~(SFTL_LBAS_PER_PAGE - 1);
+		u32 n = SFTL_LBAS_PER_PAGE - (lba - base);
+		unsigned int idx, s;
+
+		if (n > count)
+			n = count;
+		ret = ensure_room(fs);
+		if (ret)
+			return ret;
+		idx = page_begin(fs);
+		for (s = 0; s < SFTL_LBAS_PER_PAGE; s++) {
+			u32 l = base + s;
+
+			if (l >= lba && l < lba + n) {
+				slot_fill(fs, idx, s, l, src + (l - lba) * SFTL_LBA_SIZE,
+					  SFTL_MT_USER, 0, false);
+				continue;
+			}
+			{
+				u32 vba = l < fs->total_lbas ?
+					  sftl_map_get(&fs->map, l) : SFTL_UNMAPPED;
+
+				if (vba == SFTL_UNMAPPED) {
+					slot_fill(fs, idx, s, SFTL_TOKEN_PAD, NULL,
+						  SFTL_MT_USER, 0, false);
+				} else {
+					ret = read_sibling(fs, vba, w->check_data, meta);
+					if (ret)
+						return fail_wedge(fs, "sibling read", ret);
+					slot_fill(fs, idx, s, l, w->check_data, meta[0],
+						  sftl_get32(meta + 12), true);
+				}
+			}
+		}
+		src += n * SFTL_LBA_SIZE;
+		lba += n;
+		count -= n;
+	}
+	ret = batch_flush(fs);
+	if (!ret && w->need_commit && !w->hold_commit)
+		ret = commit(fs);
+	return ret;
+}
+
+/*
+ * Erase a spare again, for recovery after an erase that was cut off.  Anything
+ * that is not a spare (valid data, the context, the frontier, a queued
+ * reclaim victim) is refused.  A failed erase gives the SB up for the session.
+ */
+int sftl_erase_spare(struct sftl *fs, u32 sb)
+{
+	const struct sftl_sb_rec *r;
+	int ret;
+
+	if (!fs->wr || fs->wr->wedged)
+		return -EIO;
+	if (sb >= SFTL_NUM_SB || !fs->shape[sb].width)
+		return -EINVAL;
+	r = &fs->rec[sb];
+	if (sb == fs->ctx_sb || sb == fs->wr->fr.sb || r->valid || erase_pending(fs, sb) ||
+	    (r->type != SFTL_SB_ERASED && r->type != SFTL_SB_AWAIT_ERASE))
+		return -EINVAL;
+	ret = erase_sb(fs, sb);
+	if (ret)
+		mark_bad(fs, sb);
+	return ret;
+}
+
+/*
+ * Spec 4.9 at mount: an open SB whose replay walk met a page that did not read
+ * back (a program that failed or was cut off, by a crash or by anything else
+ * driving the controller) is given up like a failed frontier: every LBA the
+ * map places in it is moved, and it is listed waiting for erase with nothing
+ * valid, so neither Linux nor iOS programs into it again before an erase.
+ */
+static int give_up_torn(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+	u32 sb, lba, n;
+	int ret;
+
+	for (sb = 0; sb < SFTL_NUM_SB; sb++) {
+		if (!((fs->torn[sb / 8] >> (sb % 8)) & 1))
+			continue;
+		if (fs->rec[sb].type != SFTL_SB_OPEN) {
+			sftl_warn("sb %u: a page did not read back at replay, but the SB is closed; kept",
+				  sb);
+			continue;
+		}
+		n = 0;
+		for (lba = 0; lba < fs->total_lbas && n < SFTL_LBAS_PER_SB; lba++) {
+			u32 v = sftl_map_get(&fs->map, lba);
+
+			if (v != SFTL_UNMAPPED && sftl_sb_of(v) == sb)
+				w->fail_list[n++] = lba;
+		}
+		sftl_warn("sb %u: a page did not read back at replay: giving it up, moving %u LBAs",
+			  sb, n);
+		mark_bad(fs, sb);
+		ret = gc_move(fs, w->fail_list, n);
+		if (ret)
+			return ret;
+		fs->rec[sb].valid = 0;
+	}
+	return 0;
+}
+
+/* Set up the writer: reconcile the SB array with what is on the media. */
+int sftl_writer_start(struct sftl *fs, unsigned int verify_every)
+{
+	struct sftl_writer *w;
+	u8 *sig;
+	u32 sb;
+	int ret;
+
+	if (fs->sig_bank >= SFTL_BANKS) {
+		sftl_err("no signature block in the VFL");
+		return -EINVAL;
+	}
+	sig = sftl_alloc(SFTL_PAGE_SIZE);
+	if (!sig)
+		return -ENOMEM;
+	{
+		static const u32 expected[] = {
+			0x776d7278, 0, 6, 1, 1, 0, 2, 2, 0x20000, 0, 1, 0, 16, 2,
+		};
+		u8 st;
+		unsigned int i;
+
+		ret = fs->ops->read_page(fs->hw, fs->sig_bank, fs->sig_block, 0, true,
+					 sig, fs->io_meta, &st);
+		if (!ret && st != SFTL_ST_OK)
+			ret = -EIO;
+		if (!ret && (sftl_get32(sig + 32) != 1 ||
+			     sftl_get32(sig + 36) != 0x600))
+			ret = -EPERM;
+		for (i = 0; !ret && i < 14; i++)
+			if (sftl_get32(sig + 128 + 4 * i) != expected[i])
+				ret = -EPERM;
+	}
+	sftl_free(sig);
+	if (ret) {
+		sftl_err("signature block mismatch; refusing to write (%d)", ret);
+		return ret;
+	}
+
+	w = sftl_alloc(sizeof(*w));
+	if (!w)
+		return -ENOMEM;
+	fs->wr = w;
+	w->verify_every = verify_every ? verify_every : SFTL_VERIFY_DEFAULT;
+	w->fr.sb = SFTL_UNMAPPED;
+	w->pool = sftl_alloc(SFTL_BATCH_PAGES * SFTL_PAGE_SIZE);
+	w->meta_pool = sftl_alloc(SFTL_BATCH_PAGES * SFTL_META_PAGE);
+	w->pend_lba = sftl_alloc(SFTL_BATCH_PAGES * SFTL_LBAS_PER_PAGE * sizeof(u32));
+	w->pend_vba = sftl_alloc(SFTL_BATCH_PAGES * SFTL_LBAS_PER_PAGE * sizeof(u32));
+	w->entries = sftl_alloc(2 * SFTL_PAGE_SIZE / 16 * sizeof(*w->entries));
+	w->check_data = sftl_alloc(SFTL_PAGE_SIZE);
+	w->btoc_img = sftl_alloc(2 * SFTL_PAGE_SIZE);
+	w->ctx_pages = sftl_alloc(SFTL_CTX_MAX_PAGES * (SFTL_PAGE_SIZE + SFTL_META_PAGE));
+	w->ctx_prog = sftl_alloc(SFTL_CTX_MAX_PAGES * sizeof(*w->ctx_prog));
+	w->gc_list = sftl_alloc(SFTL_MAX_VICTIMS * 4096 * sizeof(u32));
+	w->victim_map = sftl_alloc((SFTL_NUM_SB + 7) / 8);
+	w->bad_map = sftl_alloc((SFTL_NUM_SB + 7) / 8);
+	w->rescue_data = sftl_alloc((size_t)SFTL_FAIL_DEPTH * SFTL_RESCUE_LBAS * SFTL_LBA_SIZE);
+	w->rescue_meta = sftl_alloc(SFTL_FAIL_DEPTH * SFTL_RESCUE_LBAS * SFTL_META_LBA);
+	w->rescue_lba = sftl_alloc(SFTL_FAIL_DEPTH * SFTL_RESCUE_LBAS * sizeof(u32));
+	w->fail_list = sftl_alloc(SFTL_FAIL_DEPTH * SFTL_LBAS_PER_SB * sizeof(u32));
+	if (!w->pool || !w->meta_pool || !w->pend_lba || !w->pend_vba ||
+	    !w->entries || !w->check_data || !w->btoc_img || !w->ctx_pages || !w->ctx_prog ||
+	    !w->gc_list || !w->victim_map || !w->bad_map || !w->rescue_data ||
+	    !w->rescue_meta || !w->rescue_lba || !w->fail_list) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+
+	ret = sftl_recount_valid(fs);
+	if (ret)
+		goto fail;
+
+	/* Bring the SB array in line with the media (spec 4.7, 4.8). */
+	for (sb = 0; sb < SFTL_NUM_SB; sb++) {
+		const struct sftl_sb_probe *pr = &fs->probe[sb];
+		struct sftl_sb_rec *r = &fs->rec[sb];
+
+		if (!fs->shape[sb].width)
+			continue;
+		if (pr->first_type == SFTL_MT_ERASED) {
+			if (r->valid) {
+				sftl_err("sb %u: erased but %u LBAs mapped", sb, r->valid);
+				ret = -EIO;
+				goto fail;
+			}
+			r->type = SFTL_SB_ERASED;
+			r->btoc_flags = 0;
+		} else if (pr->first_type == SFTL_MT_CONTEXT) {
+			r->type = SFTL_SB_CONTEXT;
+		} else if (pr->first_weave > fs->ctx_weave ||
+			   r->type == SFTL_SB_OPEN || r->type == SFTL_SB_OPEN_ALT) {
+			u8 last[SFTL_META_LBA];
+
+			if (sftl_sb_closed(fs, sb, last)) {
+				u32 nb, ents;
+
+				r->type = SFTL_SB_CLOSED;
+				r->btoc_flags = last[1];
+				ret = sftl_read_btoc(fs, sb, &nb, w->btoc_img);
+				if (ret)
+					goto fail;
+				for (ents = 0; ents < nb * SFTL_LBA_SIZE / 16; ents++)
+					if (!sftl_get32(w->btoc_img + 16 * ents + 12))
+						break;
+				sftl_summarize_useq(w->btoc_img, ents, &fs->useq[sb]);
+			} else {
+				r->type = SFTL_SB_OPEN;
+				r->btoc_flags = 0;
+			}
+		}
+	}
+	w->dirty = false;
+	ret = give_up_torn(fs);
+	if (ret)
+		goto fail;
+	return 0;
+fail:
+	sftl_writer_stop(fs);
+	return ret;
+}
+
+void sftl_writer_stop(struct sftl *fs)
+{
+	struct sftl_writer *w = fs->wr;
+
+	if (!w)
+		return;
+	sftl_free(w->pool);
+	sftl_free(w->meta_pool);
+	sftl_free(w->pend_lba);
+	sftl_free(w->pend_vba);
+	sftl_free(w->entries);
+	sftl_free(w->check_data);
+	sftl_free(w->btoc_img);
+	sftl_free(w->ctx_pages);
+	sftl_free(w->ctx_prog);
+	sftl_free(w->gc_list);
+	sftl_free(w->victim_map);
+	sftl_free(w->bad_map);
+	sftl_free(w->rescue_data);
+	sftl_free(w->rescue_meta);
+	sftl_free(w->rescue_lba);
+	sftl_free(w->fail_list);
+	sftl_free(w);
+	fs->wr = NULL;
+}
