+/* I2S0 (the A5X's, the S5L8940X's): 16-bit samples, one a FIFO word.  A
+ * card records only where the device tree gives a capture channel. */
+static struct snd_soc_dai_driver s5x_dai = {
+	.name = "s5l-i2s0",
