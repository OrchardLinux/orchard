From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Thu, 19 Nov 2026 00:26:06 +0100
Subject: [PATCH] arm64: dts: apple: wire the J120 charging trial battery gauge

Assisted-by: LLM
---
 .../boot/dts/apple/t8011-j120-charging.dts    |  1 +
 arch/arm64/boot/dts/apple/t8011-j120-hdq.dtsi | 31 +++++++++++++++++++
 2 files changed, 32 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t8011-j120-hdq.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8011-j120-charging.dts b/arch/arm64/boot/dts/apple/t8011-j120-charging.dts
index d4a099437..15acef055 100644
--- a/arch/arm64/boot/dts/apple/t8011-j120-charging.dts
+++ b/arch/arm64/boot/dts/apple/t8011-j120-charging.dts
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* Local RAM experiment only. No automatic charger/event activation. */
 #include "t8011-j120.dts"
+#include "t8011-j120-hdq.dtsi"
 
 &i2c0 {
 	tristar_test: port-controller@1a {
diff --git a/arch/arm64/boot/dts/apple/t8011-j120-hdq.dtsi b/arch/arm64/boot/dts/apple/t8011-j120-hdq.dtsi
new file mode 100644
index 000000000..467a55e2a
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8011-j120-hdq.dtsi
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+&{/soc} {
+	serial5: serial@20a0d4000 {
+		compatible = "apple,t8010-uart", "apple,s5l-uart";
+		reg = <0x2 0x0a0d4000 0x0 0x4000>;
+		reg-io-width = <4>;
+		interrupt-parent = <&aic>;
+		interrupts = <0 221 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkref>, <&clkref>;
+		clock-names = "uart", "clk_uart_baud0";
+		power-domains = <&ps_uart5>;
+		pinctrl-0 = <&battery_swi_pins>;
+		pinctrl-names = "default";
+		status = "okay";
+
+		hdq {
+			compatible = "apple,j120-hdq-uart", "ti,hdq-uart";
+
+			fuel-gauge {
+				compatible = "apple,j120-bq27540", "ti,bq27540-hdq";
+			};
+		};
+	};
+};
+
+&pinctrl_ap {
+	battery_swi_pins: battery-swi-pins {
+		pinmux = <APPLE_PINMUX(163, 1)>;
+	};
+};
