From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:39:57 +0100
Subject: [PATCH] arm64: dts: apple: enable J120 touch, Wi-Fi and accelerometer

Wire the J120 SPI3 touchscreen, August analog rail, Autumn WLAN enable and T8011 Wi-Fi-only PCIe/DART resources. Add AOP SRAM/mailbox resources and target 1 with the measured accelerometer mounting matrix. Use bootloader aliases for per-unit touch/WLAN/AOP data. Existing August backlight support is retained; charging, Bluetooth, storage, native display, GPU and video remain outside this change.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8011-j120.dts  | 243 ++++++++++++++++++++++
 arch/arm64/boot/dts/apple/t8011-pmgr.dtsi |  14 +-
 arch/arm64/boot/dts/apple/t8011.dtsi      |  26 +++
 3 files changed, 277 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8011-j120.dts b/arch/arm64/boot/dts/apple/t8011-j120.dts
index 1b49bb5c9..0c6e23a13 100644
--- a/arch/arm64/boot/dts/apple/t8011-j120.dts
+++ b/arch/arm64/boot/dts/apple/t8011-j120.dts
@@ -13,4 +13,247 @@
 / {
 	compatible = "apple,j120", "apple,t8011", "apple,arm-platform";
 	model = "Apple iPad Pro 2 (12.9-inch) (Wi-Fi)";
+
+	aliases {
+		aop = &aop;
+		touchscreen0 = &touchscreen;
+		wifi0 = &wifi;
+	};
+
+	/* WLAN REG_ON is driven by the Autumn PMIC. */
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&autumn_gpio 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		status = "okay";
+	};
+
+	/* Runtime ADT clock ID 0x134; the bootloader configures this source. */
+	spi3_nclk: clock-spi3-nclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <61538461>;
+		clock-output-names = "spi3-nclk";
+	};
+};
+
+&aop {
+	/* Runtime firmware region ends at the bootloader's RECFG reservation. */
+	reg = <0x2 0x10800000 0x0 0x4000>,
+	      <0x2 0x10000500 0x0 0x100>,
+	      <0x2 0x10e00000 0x0 0xd8000>;
+	firmware-name = "apple/aop-ipad7.bin", "apple/aop-ipad7-ext.bin";
+	apple,aop-target = <1>;
+	status = "okay";
+};
+
+&aop_accel {
+	mount-matrix = "-1", "0", "0",
+		       "0", "-1", "0",
+		       "0", "0", "1";
+};
+
+&{/soc} {
+	spi3: spi@20a08c000 {
+		compatible = "apple,t8011-spi", "apple,t8010-spi", "apple,spi";
+		reg = <0x2 0x0a08c000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 215 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&spi3_nclk>;
+		power-domains = <&ps_spi3>;
+		cs-gpios = <&pinctrl_ap 203 GPIO_ACTIVE_LOW>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		/* Preserve the bootloader's SPI pad mux. */
+		status = "okay";
+
+		touchscreen: touchscreen@0 {
+			compatible = "apple,j120-touchscreen";
+			reg = <0>;
+			spi-max-frequency = <24390243>;
+			spi-cpha;
+			spi-cpol;
+			interrupt-parent = <&pinctrl_ap>;
+			interrupts = <104 IRQ_TYPE_EDGE_FALLING>;
+			reset-gpios = <&pinctrl_ap 103 GPIO_ACTIVE_LOW>;
+			power-ldo-gpios = <&pinctrl_ap 120 GPIO_ACTIVE_HIGH>;
+			ana-supply = <&touch_analog>;
+			clocks = <&touchclk>;
+			pinctrl-names = "display-sync-active", "display-sync-inactive";
+			pinctrl-0 = <&touch_sync_active>;
+			pinctrl-1 = <&touch_sync_inactive>;
+			firmware-name = "apple/j120-touch-K1F18,3.z2fw";
+			touchscreen-size-x = <2048>;
+			touchscreen-size-y = <2732>;
+			/* Calibration is supplied per unit by m1n1 via touchscreen0. */
+			status = "okay";
+		};
+	};
+
+	wlan_uart2: wlan-platform-control@20a0c8000 {
+		compatible = "apple,t8010-wlan-uart-provider";
+		reg = <0x2 0x0a0c8000 0x0 0x4000>;
+		pinctrl-0 = <&wlan_uart2_pins>;
+		pinctrl-names = "default";
+		power-domains = <&ps_uart2>;
+		status = "okay";
+	};
+
+	pcie0_dart2: iommu@603008000 {
+		compatible = "apple,t8011-dart", "apple,s5l8960x-dart";
+		reg = <0x6 0x03008000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 277 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_pcie>;
+		#iommu-cells = <5>;
+		apple,error-reflector = /bits/ 64 <0x20fffc000>;
+		apple,fetch-config = <0x000e0303>;
+		apple,diag-config = <0x00000100>;
+		status = "okay";
+	};
+
+	pcie0: pcie@610000000 {
+		compatible = "apple,j120-pcie", "apple,t8011-pcie";
+		device_type = "pci";
+		reg = <0x6 0x10000000 0x0 0x1000000>,
+		      <0x6 0x00000000 0x0 0x8000>,
+		      <0x6 0x00008000 0x0 0x4000>,
+		      <0x6 0x0a000000 0x0 0x40000>,
+		      <0x6 0x01000000 0x0 0x4000>,
+		      <0x6 0x02000000 0x0 0x4000>,
+		      <0x6 0x03000000 0x0 0x4000>,
+		      <0x6 0x04000000 0x0 0x4000>,
+		      <0x6 0x05000000 0x0 0x4000>,
+		      <0x6 0x06000000 0x0 0x4000>;
+		reg-names = "config", "rc", "phy", "phy-ip",
+			    "port0", "port1", "port2", "port3", "port4", "port5";
+
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 270 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 273 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 276 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 279 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 282 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 285 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "port0", "port1", "port2", "port3", "port4", "port5";
+		interrupt-controller;
+		#interrupt-cells = <1>;
+
+		msi-controller;
+		msi-parent = <&pcie0>;
+		msi-ranges = <&aic AIC_IRQ 288 IRQ_TYPE_EDGE_RISING 32>;
+		apple,msi-doorbell = <0xbffff000>;
+
+		/* Bus 1 serves the only enabled child, Wi-Fi on port 2. */
+		iommu-map = <0x100 &pcie0_dart2 0 0x0 0x80000000 0x0 0x3ffff000 1>;
+		iommu-map-mask = <0xff00>;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		bus-range = <0 8>;
+		ranges = <0x43000000 0x6 0x20000000 0x6 0x20000000 0x1 0xa0000000>,
+			 <0x02000000 0x0 0xc0000000 0x7 0xc0000000 0x0 0x40000000>;
+
+		power-domains = <&ps_pcie>;
+		clocks = <&ps_pcie_aux>, <&ps_pcie_ref>;
+		clock-names = "aux", "ref";
+		pinctrl-0 = <&wifi_clkreq>;
+		pinctrl-names = "default";
+		status = "okay";
+
+		pci@2,0 {
+			compatible = "apple,j120-wifi-pcie-port", "pciclass,0604";
+			device_type = "pci";
+			reg = <0x1000 0x0 0x0 0x0 0x0>;
+			bus-range = <1 1>;
+			max-link-speed = <1>;
+			reset-gpios = <&pinctrl_ap 100 GPIO_ACTIVE_LOW>;
+			apple,msi-vector-range = <16 4>;
+			apple,manual-availability-iommu = <&pcie0_dart2 0>;
+			apple,endpoint-power-after-link-setup;
+			apple,wlan-uart = <&wlan_uart2>;
+			vdd-supply = <&wlan_vdd>;
+
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges;
+
+			wifi: wifi@0,0 {
+				compatible = "pci14e4,43dc";
+				reg = <0x10000 0x0 0x0 0x0 0x0>;
+				brcm,board-type = "apple,j120";
+
+			};
+		};
+	};
+};
+
+&august_pmic {
+	touch_analog: regulator-touch-analog {
+		compatible = "apple,august-touch-analog-regulator";
+		regulator-name = "touch-analog";
+	};
+};
+
+/* Touch reference clock; the consumer controls its gate. */
+&pmgr {
+	touchclk: clock-controller@78000 {
+		compatible = "apple,t8011-touch-clock", "apple,t8010-touch-clock";
+		reg = <0x78000 0x8>;
+		#clock-cells = <0>;
+		clocks = <&clkref>;
+		clock-output-names = "touchclk";
+		clock-frequency = <24000000>;
+		status = "okay";
+	};
+};
+
+/* Native GPIO function modes: active peripheral 1, inactive GPIO output. */
+&pinctrl_ap {
+	compatible = "apple,t8011-pinctrl", "apple,s8000-pinctrl", "apple,pinctrl";
+
+	wifi_clkreq: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(101, 1)>;
+	};
+
+	wlan_uart2_pins: wlan-uart2-pins {
+		pinmux = <APPLE_PINMUX(150, 1)>,
+			 <APPLE_PINMUX(152, 1)>;
+	};
+
+	touch_sync_active: touch-sync-active-pins {
+		pinmux = <APPLE_PINMUX(205, 1)>,
+			 <APPLE_PINMUX(206, 1)>,
+			 <APPLE_PINMUX(207, 1)>;
+	};
+
+	touch_sync_inactive: touch-sync-inactive-pins {
+		pinmux = <APPLE_PINMUX(207, 0)>,
+			 <APPLE_PINMUX(206, 0)>,
+			 <APPLE_PINMUX(205, 0)>;
+	};
+};
+
+/* Only the qualified WLAN enable GPIO is available to consumers. */
+&autumn_pmic {
+	autumn_gpio: gpio {
+		compatible = "apple,d2401-pmic-gpio";
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-reserved-ranges = <0 1>, <2 18>;
+		status = "okay";
+	};
+};
+
+&aop_mbox {
+	status = "okay";
+};
+
+&ps_pcie_aux {
+	status = "okay";
+};
+
+&ps_pcie_ref {
+	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/apple/t8011-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8011-pmgr.dtsi
index 773b3fe7a..9e3ea29e2 100644
--- a/arch/arm64/boot/dts/apple/t8011-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8011-pmgr.dtsi
@@ -104,11 +104,12 @@ ps_pms: power-controller@80120 {
 		apple,always-on; /* Core device */
 	};
 
-	ps_pcie_ref: power-controller@80148 {
+	ps_pcie_ref: clock-controller@80148 {
 		compatible = "apple,t8010-pmgr-pwrstate", "apple,pmgr-pwrstate";
 		reg = <0x80148 4>;
-		#power-domain-cells = <0>;
-		#reset-cells = <0>;
+		#clock-cells = <0>;
+		apple,clock-gate-only;
+		status = "disabled";
 		label = "pcie_ref";
 	};
 
@@ -632,11 +633,12 @@ ps_pcie: power-controller@80328 {
 		label = "pcie";
 	};
 
-	ps_pcie_aux: power-controller@80330 {
+	ps_pcie_aux: clock-controller@80330 {
 		compatible = "apple,t8010-pmgr-pwrstate", "apple,pmgr-pwrstate";
 		reg = <0x80330 4>;
-		#power-domain-cells = <0>;
-		#reset-cells = <0>;
+		#clock-cells = <0>;
+		apple,clock-gate-only;
+		status = "disabled";
 		label = "pcie_aux";
 	};
 
diff --git a/arch/arm64/boot/dts/apple/t8011.dtsi b/arch/arm64/boot/dts/apple/t8011.dtsi
index 01c3a0d55..9fa6dae21 100644
--- a/arch/arm64/boot/dts/apple/t8011.dtsi
+++ b/arch/arm64/boot/dts/apple/t8011.dtsi
@@ -364,6 +364,32 @@ pmgr_mini: power-management@210200000 {
 			reg = <0x2 0x10200000 0 0x84000>;
 		};
 
+		aop: aop@210800000 {
+			compatible = "apple,t8011-aop";
+			reg = <0x2 0x10800000 0x0 0x4000>,
+			      <0x2 0x10000500 0x0 0x100>,
+			      <0x2 0x10e00000 0x0 0xa0000>;
+			reg-names = "akf", "control", "sram";
+			mboxes = <&aop_mbox>;
+			mbox-names = "mbox";
+			status = "disabled";
+
+			aop_accel: accel {
+				compatible = "apple,t8010-aop-accel";
+			};
+		};
+
+		aop_mbox: mbox@210804000 {
+			compatible = "apple,t8010-a7iop-mailbox";
+			reg = <0x2 0x10804000 0x0 0x1000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 142 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 145 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
 		wdt: watchdog@2102b0000 {
 			compatible = "apple,t8010-wdt", "apple,wdt";
 			reg = <0x2 0x102b0000 0x0 0x4000>;
