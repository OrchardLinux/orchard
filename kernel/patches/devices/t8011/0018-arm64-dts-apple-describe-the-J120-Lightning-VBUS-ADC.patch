From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Sat, 21 Nov 2026 16:40:47 +0100
Subject: [PATCH] arm64: dts: apple: describe the J120 Lightning VBUS ADC

Enable read-only input voltage telemetry on J120.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8011-j120.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8011-j120.dts b/arch/arm64/boot/dts/apple/t8011-j120.dts
index b57d4daf5..877718c65 100644
--- a/arch/arm64/boot/dts/apple/t8011-j120.dts
+++ b/arch/arm64/boot/dts/apple/t8011-j120.dts
@@ -367,6 +367,13 @@ &ps_pcie_ref {
 	status = "okay";
 };
 
+&i2c1 {
+	adc@13 {
+		compatible = "apple,orion-bellatrix-vbus";
+		reg = <0x13>;
+	};
+};
+
 &i2c3 {
 	status = "okay";
 
