 		aop = &aop;
 		bluetooth0 = &bluetooth;
 		nvme-hmb = &nvme_hmb;
@@ -55,26 +56,6 @@
 		clock-output-names = "spi3-nclk";
 	};
 
-	/*
-	 * Smart Cover hall sensors: D2400 GPIO 0 ("halleffect1") and 10
-	 * ("halleffect") in the ADT /buttons node, low while the cover is
-	 * closed. Reported as SW_MACHINE_COVER, as on the iPad 6; the PMU
