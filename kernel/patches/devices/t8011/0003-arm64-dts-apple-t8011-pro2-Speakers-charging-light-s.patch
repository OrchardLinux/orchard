 		mca4: mca@20a0b0000 {
 			compatible = "apple,t8010-mca-i2s";
 			reg = <0x2 0x0a0b0000 0x0 0x4000>,
@@ -318,6 +337,17 @@
 			status = "disabled";
 		};
 
+		/*
+		 * The H9G display pipe. Only its registers are described: the
+		 * boot framebuffer names it so that the boot scanout cadence
+		 * can be switched (simpledrm).
+		 */
