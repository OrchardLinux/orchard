+			compatible = "apple,t8011-h9g-display";
+			reg = <0x2 0x06000000 0x0 0xe0000>;
+			status = "disabled";
+		};
+
 		pdm: pdm@20a0b4000 {
 			compatible = "apple,t8011-pdm";
 			reg = <0x2 0x0a0b4000 0x0 0x1000>,
