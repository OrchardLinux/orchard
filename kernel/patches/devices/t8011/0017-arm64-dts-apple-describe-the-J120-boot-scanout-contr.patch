From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Sat, 21 Nov 2026 16:07:49 +0100
Subject: [PATCH] arm64: dts: apple: describe the J120 boot scanout controller

Reuse the firmware framebuffer while switching H9G between the verified two and four subframe cadences. Keep the boot cadence on other hardware and restore it on driver removal.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8011-j120.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8011-j120.dts b/arch/arm64/boot/dts/apple/t8011-j120.dts
index c413f9169..b57d4daf5 100644
--- a/arch/arm64/boot/dts/apple/t8011-j120.dts
+++ b/arch/arm64/boot/dts/apple/t8011-j120.dts
@@ -80,7 +80,17 @@ &aop_accel {
 		       "0", "0", "1";
 };
 
+&framebuffer0 {
+	display = <&j120_display>;
+};
+
 &{/soc} {
+	j120_display: display-controller@206000000 {
+		compatible = "apple,t8011-h9g-display";
+		reg = <0x2 0x06000000 0x0 0xe0000>;
+		status = "disabled";
+	};
+
 	spi3: spi@20a08c000 {
 		compatible = "apple,t8011-spi", "apple,t8010-spi", "apple,spi";
 		reg = <0x2 0x0a08c000 0x0 0x4000>;
