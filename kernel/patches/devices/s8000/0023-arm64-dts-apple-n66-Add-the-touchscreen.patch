From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 14:36:24 +0100
Subject: [PATCH] arm64: dts: apple: n66: Add the touchscreen

The controller sits on SPI2 (chip select AP GPIO 44, attention 142,
reset 75, 124 ns bit period in the ADT). Its analog supply is the
Chestnut display PMU's touch rail, its core supply Antigua's LDO 25. The
touchscreen0 alias lets the loader pass the unit's calibration.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s8000-n66.dts | 60 +++++++++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s8000-n66.dts b/arch/arm64/boot/dts/apple/s8000-n66.dts
index 8d3c424cf..5dfd932af 100644
--- a/arch/arm64/boot/dts/apple/s8000-n66.dts
+++ b/arch/arm64/boot/dts/apple/s8000-n66.dts
@@ -15,6 +15,16 @@ / {
 
 	aliases {
 		als0 = &als;	/* the loader copies the ADT's alsCalibration here */
+		spi2 = &spi2;
+		touchscreen0 = &touchscreen;	/* the loader copies the ADT calibration */
+	};
+
+	/* ADT arm-io clock-frequencies of the spi2 clock-id (303) */
+	spi2_nclk: clock-spi2-nclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <61538461>;
+		clock-output-names = "spi2-nclk";
 	};
 };
 
@@ -41,3 +51,53 @@ als: light-sensor@29 {
 		interrupts-extended = <&pinctrl_ap 131 IRQ_TYPE_LEVEL_LOW>;
 	};
 };
+
+
+
+&i2c0 {
+	/* ADT display-pmu,chestnut @0x27: touch power_ana = dpLE(0x302) */
+	display-pmu@27 {
+		compatible = "apple,chestnut-pmic";
+		reg = <0x27>;
+
+		touch_ana: regulator-touch-hv {
+			compatible = "apple,chestnut-touch-hv-regulator";
+			regulator-name = "touch-analog";
+		};
+	};
+};
+
+&{/soc/i2c@20a110000/pmic@74} {
+	/* ADT multi-touch power_ldo = pmuL(0x219) */
+	touch_core: regulator-touch-core {
+		compatible = "apple,antigua-touch-core-regulator";
+		regulator-name = "touch-core";
+	};
+};
+
+/* ADT /arm-io/spi2/multi-touch: multi-touch,n66 */
+&spi2 {
+	clocks = <&spi2_nclk>;
+	cs-gpios = <&pinctrl_ap 44 GPIO_ACTIVE_LOW>;	/* function-enable_cs */
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,n66-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <8064516>;		/* ADT 124 ns bit period */
+		interrupts-extended = <&pinctrl_ap 142 IRQ_TYPE_EDGE_FALLING>;
+		attn-gpios = <&pinctrl_ap 142 GPIO_ACTIVE_LOW>;
+		reset-gpios = <&pinctrl_ap 75 GPIO_ACTIVE_LOW>;	/* function-reset */
+		ana-supply = <&touch_ana>;
+		core-supply = <&touch_core>;
+		clocks = <&touchclk>;
+		firmware-name = "apple/n66-fwstart.z2fw";
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <1920>;
+		touchscreen-inverted-y;
+	};
+};
+
+&touchclk {
+	status = "okay";
+};
