From: brkosebay <brkosebay@users.noreply.github.com>
Date: Sun, 08 Nov 2026 16:00:00 +0100
Subject: [PATCH] arm64: dts: apple: G5P render, autoboot, META71C and boot-origin policy

Carry the original-firmware G5P render/compute ABI and extraction recipe into the system kernel, with typed query/compute follow-ups and qualified WC cache handling. Start firmware at probe, install META71C 340 on every firmware image, select dirty-start mode 3 from the incoming kexec DT marker (cold mode 1), and quiet recurring diagnostics.

Integration fixups are folded into the final delta. Device observations apply
to the integration build; the isolated topic requires qualification.

Assisted-by: LLM
---

diff --git a/arch/arm64/boot/dts/apple/s8003-j71t.dts b/arch/arm64/boot/dts/apple/s8003-j71t.dts
index 733cefc66..7e4d67d7f 100644
--- a/arch/arm64/boot/dts/apple/s8003-j71t.dts
+++ b/arch/arm64/boot/dts/apple/s8003-j71t.dts
@@ -24,3 +24,7 @@ &touchscreen {
 &wifi {
 	brcm,board-type = "apple,feara";
 };
+
+&gpu_diag {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/s8003.dtsi b/arch/arm64/boot/dts/apple/s8003.dtsi
index b51588941..67cdd227a 100644
--- a/arch/arm64/boot/dts/apple/s8003.dtsi
+++ b/arch/arm64/boot/dts/apple/s8003.dtsi
@@ -336,3 +336,20 @@ map0 {
  * the S8003 (APL1022) on 16nm. There are some minor differences
  * such as timing in cpufreq state transistions.
  */
+
+/* G5P resources; enable only on a board qualified with this driver. */
+&{/soc} {
+	gpu_diag: gpu@201000000 {
+		status = "disabled";
+		compatible = "gpu,s8003";
+		reg = <0x2 0x01000000 0x0 0x100000>,
+		      <0x2 0x01e00000 0x0 0x100000>;
+		reg-names = "rgx", "fender";
+		power-domains = <&ps_gfx>;
+		interrupts = <AIC_IRQ 170 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 171 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 172 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 173 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 174 IRQ_TYPE_LEVEL_HIGH>;
+	};
+};
