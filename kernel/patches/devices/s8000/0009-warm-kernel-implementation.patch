From: brkosebay <brkosebay@users.noreply.github.com>
Date: Sun, 08 Nov 2026 16:00:00 +0100
Subject: [PATCH] arm64: dts: apple: Warm Restart evidence, reset guard and pristine DT

Preserve warm power-domain holds and the ADBE boot framebuffer, add bounded shutdown checkpoints and the cold-reset guard, and retain a correctly mapped ramoops reservation across kexec. Embed per-board pristine DTBs in the matching initrd and archive the actual running boot's pristine tree before updates replace its files. Kernel/module/BLS pairing must remain explicit; DFU is known to erase the retained logs. The new Orchard cold-baseline and three-hop ladder is pending.

Integration fixups are folded into the final delta. Device observations apply
to the integration build; the isolated topic requires qualification.

Assisted-by: LLM
---

diff --git a/arch/arm64/include/asm/mmu.h b/arch/arm64/include/asm/mmu.h
index 5e1211c54..bd22a913d 100644
--- a/arch/arm64/include/asm/mmu.h
+++ b/arch/arm64/include/asm/mmu.h
@@ -62,6 +62,7 @@ static inline bool arm64_kernel_unmapped_at_el0(void)
 
 extern void arm64_memblock_init(void);
 extern void paging_init(void);
+extern void apple_soc_publish_pstore(void);
 extern void bootmem_init(void);
 extern void create_mapping_noalloc(phys_addr_t phys, unsigned long virt,
 				   phys_addr_t size, pgprot_t prot);
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 29c6100f0..45c23e3d9 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -332,6 +332,7 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	arm64_memblock_init();
 
 	paging_init();
+	apple_soc_publish_pstore();
 
 	acpi_table_upgrade();
 
diff --git a/arch/arm64/mm/init.c b/arch/arm64/mm/init.c
index fbf215ecc..affb37089 100644
--- a/arch/arm64/mm/init.c
+++ b/arch/arm64/mm/init.c
@@ -22,6 +22,8 @@
 #include <linux/sort.h>
 #include <linux/of.h>
 #include <linux/of_fdt.h>
+#include <linux/libfdt.h>
+#include <linux/io.h>
 #include <linux/dma-direct.h>
 #include <linux/dma-map-ops.h>
 #include <linux/efi.h>
@@ -193,6 +195,91 @@ static int __init early_mem(char *p)
 }
 early_param("mem", early_mem);
 
+static phys_addr_t apple_soc_pstore_fdt __initdata;
+
+/*
+ * Reserve before paging/CMA/crashkernel, without touching the linear map:
+ * paging_init() has not built it yet. Prepare the replacement FDT through a
+ * temporary early mapping and publish its linear alias only after paging.
+ * Never choose a fresh address in kdump; reuse the first kernel's region.
+ */
+static void __init apple_soc_reserve_pstore(void)
+{
+	void *fdt = initial_boot_params, *copy;
+	phys_addr_t base, copy_pa;
+	fdt64_t reg[2];
+	char name[40];
+	int parent, node, size, ret;
+
+	if (!IS_BUILTIN(CONFIG_PSTORE_RAM) || !fdt ||
+	    (fdt_node_check_compatible(fdt, 0, "apple,s8000") &&
+	     fdt_node_check_compatible(fdt, 0, "apple,s8003")))
+		return;
+	if (fdt_node_offset_by_compatible(fdt, -1, "ramoops") >= 0)
+		return;
+	if (is_kdump_kernel()) {
+		pr_warn("Apple pstore: no inherited region in capture kernel\n");
+		return;
+	}
+	parent = fdt_path_offset(fdt, "/reserved-memory");
+	if (parent < 0 || fdt_address_cells(fdt, parent) != 2 ||
+	    fdt_size_cells(fdt, parent) != 2)
+		return;
+
+	/* Existing firmware, kernel and initrd reservations are already known. */
+	base = memblock_phys_alloc(SZ_2M, SZ_2M);
+	if (!base)
+		return;
+	size = fdt_totalsize(fdt) + SZ_4K;
+	copy_pa = memblock_phys_alloc(size, SMP_CACHE_BYTES);
+	if (!copy_pa)
+		goto free_region;
+	copy = early_memremap(copy_pa, size);
+	if (!copy)
+		goto free_copy;
+	ret = fdt_open_into(fdt, copy, size);
+	if (ret)
+		goto unmap_copy;
+	parent = fdt_path_offset(copy, "/reserved-memory");
+	snprintf(name, sizeof(name), "ramoops@%llx", (u64)base);
+	node = fdt_add_subnode(copy, parent, name);
+	if (node < 0)
+		goto unmap_copy;
+	reg[0] = cpu_to_fdt64(base);
+	reg[1] = cpu_to_fdt64(SZ_2M);
+	if (fdt_setprop(copy, node, "compatible", "ramoops", sizeof("ramoops")) ||
+	    fdt_setprop(copy, node, "reg", reg, sizeof(reg)) ||
+	    fdt_setprop(copy, node, "no-map", NULL, 0) ||
+	    fdt_setprop_u32(copy, node, "record-size", SZ_1M) ||
+	    fdt_setprop_u32(copy, node, "console-size", SZ_1M) ||
+	    fdt_setprop_u32(copy, node, "max-reason", 2) ||
+	    fdt_add_mem_rsv(copy, base, SZ_2M))
+		goto unmap_copy;
+	/* No cached linear alias of ramoops' write-combined persistent mapping. */
+	if (memblock_mark_nomap(base, SZ_2M))
+		goto unmap_copy;
+	early_memunmap(copy, size);
+	apple_soc_pstore_fdt = copy_pa;
+	pr_info("Apple pstore: reserved 2 MiB at %pa, carried in kexec FDT\n", &base);
+	return;
+
+unmap_copy:
+	early_memunmap(copy, size);
+free_copy:
+	memblock_phys_free(copy_pa, size);
+free_region:
+	memblock_phys_free(base, SZ_2M);
+	pr_warn("Apple pstore: reservation failed\n");
+}
+
+/* The linear map now exists; unflattening must see the prepared FDT. */
+void __init apple_soc_publish_pstore(void)
+{
+	if (apple_soc_pstore_fdt)
+		early_init_dt_verify(phys_to_virt(apple_soc_pstore_fdt),
+				     apple_soc_pstore_fdt);
+}
+
 void __init arm64_memblock_init(void)
 {
 	s64 linear_region_size = PAGE_END - _PAGE_OFFSET(vabits_actual);
@@ -298,6 +385,7 @@ void __init arm64_memblock_init(void)
 	}
 
 	early_init_fdt_scan_reserved_mem();
+	apple_soc_reserve_pstore();
 }
 
 void __init bootmem_init(void)
diff --git a/fs/pstore/ram.c b/fs/pstore/ram.c
index 2eb0d4fa2..45b9b51df 100644
--- a/fs/pstore/ram.c
+++ b/fs/pstore/ram.c
@@ -9,6 +9,7 @@
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
 #include <linux/kernel.h>
+#include <linux/crash_dump.h>
 #include <linux/err.h>
 #include <linux/module.h>
 #include <linux/version.h>
@@ -729,6 +730,13 @@ static int ramoops_probe(struct platform_device *pdev)
 	phys_addr_t paddr;
 	int err = -EINVAL;
 
+	/* Leave the original panic/console records intact across phoenix. */
+	if (is_kdump_kernel() && (of_machine_is_compatible("apple,s8000") ||
+	     of_machine_is_compatible("apple,s8003"))) {
+		pr_info("capture kernel: preserving Apple records for the full boot\n");
+		return -ENODEV;
+	}
+
 	/*
 	 * Only a single ramoops area allowed at a time, so fail extra
 	 * probes.
