From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 14:36:24 +0100
Subject: [PATCH] arm64: dts: apple: s800-0-3: Add SPI2

The ADT's /arm-io/spi2 (spi-1,samsung): AIC 190, power state spi2.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s800-0-3.dtsi | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index 2338d6429..f9e1affe6 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -106,6 +106,19 @@ spi1: spi@20a084000 {
 			status = "disabled";
 		};
 
+		/* ADT /arm-io/spi2: spi-1,samsung, AIC 190, clock-id 303 */
+		spi2: spi@20a088000 {
+			compatible = "apple,s8000-spi", "apple,spi";
+			reg = <0x2 0x0a088000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 190 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkref>;
+			power-domains = <&ps_spi2>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 		spi3: spi@20a08c000 {
 			compatible = "apple,s8000-spi", "apple,spi";
 			reg = <0x2 0x0a08c000 0x0 0x4000>;
