From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 8 Nov 2026 17:15:00 +0100
Subject: [PATCH] arm64: dts: apple: select certified AOP reload through DT

A retained AOP must not be reset as though it were a fresh boot. Select
retained reload through device-tree data, preserving ordinary
initialization for other hardware.

Assisted-by: LLM
---
 .../arm64/boot/dts/apple/s800-0-3-common.dtsi |  1 +
 arch/arm64/boot/dts/apple/s800-0-3.dtsi       | 37 ++++++++++++++++++
 arch/arm64/boot/dts/apple/s8003-j71t.dts      | 39 +++++++++++++++++++
 3 files changed, 77 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3-common.dtsi b/arch/arm64/boot/dts/apple/s800-0-3-common.dtsi
index 354533f26..338182cf5 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3-common.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3-common.dtsi
@@ -11,6 +11,7 @@
 
 / {
 	aliases {
+		aop = &aop; /* Used by loader */
 		ausbphy0 = &ausbphy0;
 		nvme-hmb = &nvme_hmb; /* Used by loader */
 		serial0 = &serial0;
diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index 3277a73bb..75ec4a403 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -415,6 +415,43 @@
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 4 IRQ_TYPE_LEVEL_HIGH>;
 		};
+
+		aop: aop@210800000 {
+			compatible = "apple,s8000-aop";
+			reg = <0x2 0x10800000 0x0 0x4000>,
+			      <0x2 0x10000600 0x0 0x4>,
+			      <0x2 0x10e00000 0x0 0x9b000>;
+			reg-names = "akf", "control", "sram";
+			mboxes = <&aop_mbox>;
+			mbox-names = "mbox";
+			status = "disabled";
+
+			aop_accel: accel {
+				compatible = "apple,s8000-aop-accel";
+			};
+
+			aop_gyro: gyro {
+				compatible = "apple,s8000-aop-gyro";
+			};
+
+			aop_pressure: pressure {
+				compatible = "apple,s8000-aop-pressure";
+			};
+		};
+
+		aop_mbox: mbox@210804000 {
+			compatible = "apple,s8000-a7iop-mailbox", "apple,t8010-a7iop-mailbox";
+			reg = <0x2 0x10804000 0x0 0x1000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 130 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 131 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 132 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 133 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
 	};
 
 	timer {
diff --git a/arch/arm64/boot/dts/apple/s8003-j71t.dts b/arch/arm64/boot/dts/apple/s8003-j71t.dts
index 733cefc66..2728cbd5f 100644
--- a/arch/arm64/boot/dts/apple/s8003-j71t.dts
+++ b/arch/arm64/boot/dts/apple/s8003-j71t.dts
@@ -16,6 +16,45 @@
 	model = "Apple iPad 5 (Wi-Fi) (TSMC)";
 };
 
+/ {
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/* Same tail page as release6, never a firmware DMA grant. */
+		aop_shutdown: aop-shutdown@8583fc000 {
+			reg = <0x8 0x583fc000 0 0x4000>;
+			no-map;
+		};
+	};
+};
+
+&aop {
+	apple,certified-reload;
+	memory-region = <&aop_shutdown>;
+	apple,observe-domains = <&ps_aop_gpio &ps_aop &ps_aop_busif
+				 &ps_aop_cpu &ps_aop_filter>;
+	apple,spi0-domain = <&ps_spi0>;
+	firmware-name = "apple/aop-ipad6f.bin", "apple/aop-ipad6f-ext.bin";
+	status = "okay";
+};
+
+/*
+ * The AOP reports the accelerometer in its sensor frame, which is the
+ * device frame (x right, y up, z out of the screen) negated: flat, screen up
+ * reads z = -1 g, upright y = -1 g. iio-sensor-proxy takes upright as
+ * negative y and needs z flipped.
+ */
+&aop_accel {
+	mount-matrix = "1", "0", "0",
+		       "0", "1", "0",
+		       "0", "0", "-1";
+};
+
+&aop_mbox {
+	status = "okay";
+};
+
 &touchscreen {
 	firmware-name = "apple/j71t-fwstart.z2fw";
 };
