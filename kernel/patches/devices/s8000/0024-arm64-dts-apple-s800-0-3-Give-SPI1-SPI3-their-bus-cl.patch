From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 23 Nov 2026 22:44:04 +0800
Subject: [PATCH] arm64: dts: apple: s800-0-3: Give SPI1-SPI3 their bus clocks

The ADT's arm-io clock-frequencies, which hold the SPI bus clocks
(61.5 MHz for spi1, spi2 and spi3), are the same in the IPSW device
trees of every A9 board: N66, N66m, N71, N71m, N69, N69u, J71s, J72s,
J71t and J72t. Describe the clocks once with the SoC instead of in the
iPad 5 and iPhone 6s Plus files, so every board that uses one of these
buses gets the right rate.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s800-0-3.dtsi    | 31 +++++++++++++++++++---
 arch/arm64/boot/dts/apple/s8000-n66.dts    |  9 -------
 arch/arm64/boot/dts/apple/s800x-ipad5.dtsi | 17 ------------
 3 files changed, 28 insertions(+), 29 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index f9e1aff..453d56b 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -25,6 +25,31 @@
 		clock-output-names = "clkref";
 	};
 
+	/*
+	 * The SPI bus clocks: the ADT arm-io clock-frequencies of their
+	 * clock-ids, the same on every A9 board.
+	 */
+	spi1_nclk: clock-spi1-nclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <61538461>;
+		clock-output-names = "spi1-nclk";
+	};
+
+	spi2_nclk: clock-spi2-nclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <61538461>;
+		clock-output-names = "spi2-nclk";
+	};
+
+	spi3_nclk: clock-spi3-nclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <61538461>;
+		clock-output-names = "spi3-nclk";
+	};
+
 	cpus {
 		#address-cells = <2>;
 		#size-cells = <0>;
@@ -99,7 +124,7 @@
 			reg = <0x2 0x0a084000 0x0 0x4000>;
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 189 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&clkref>;
+			clocks = <&spi1_nclk>;
 			power-domains = <&ps_spi1>;
 			#address-cells = <1>;
 			#size-cells = <0>;
@@ -112,7 +137,7 @@
 			reg = <0x2 0x0a088000 0x0 0x4000>;
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 190 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&clkref>;
+			clocks = <&spi2_nclk>;
 			power-domains = <&ps_spi2>;
 			#address-cells = <1>;
 			#size-cells = <0>;
@@ -124,7 +149,7 @@
 			reg = <0x2 0x0a08c000 0x0 0x4000>;
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 191 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&clkref>;
+			clocks = <&spi3_nclk>;
 			power-domains = <&ps_spi3>;
 			#address-cells = <1>;
 			#size-cells = <0>;
diff --git a/arch/arm64/boot/dts/apple/s8000-n66.dts b/arch/arm64/boot/dts/apple/s8000-n66.dts
index 5dfd932..8c637f5 100644
--- a/arch/arm64/boot/dts/apple/s8000-n66.dts
+++ b/arch/arm64/boot/dts/apple/s8000-n66.dts
@@ -18,14 +18,6 @@
 		spi2 = &spi2;
 		touchscreen0 = &touchscreen;	/* the loader copies the ADT calibration */
 	};
-
-	/* ADT arm-io clock-frequencies of the spi2 clock-id (303) */
-	spi2_nclk: clock-spi2-nclk {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <61538461>;
-		clock-output-names = "spi2-nclk";
-	};
 };
 
 &pcie0_dart0 {
@@ -77,7 +69,6 @@
 
 /* ADT /arm-io/spi2/multi-touch: multi-touch,n66 */
 &spi2 {
-	clocks = <&spi2_nclk>;
 	cs-gpios = <&pinctrl_ap 44 GPIO_ACTIVE_LOW>;	/* function-enable_cs */
 	status = "okay";
 
diff --git a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
index 20cf0f8..e51631d 100644
--- a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
@@ -76,21 +76,6 @@
 		};
 	};
 
-	/* ADT arm-io clock-frequencies of the spi1 and spi3 clock-ids */
-	spi1_nclk: clock-spi1-nclk {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <61538461>;
-		clock-output-names = "spi1-nclk";
-	};
-
-	spi3_nclk: clock-spi3-nclk {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <61538461>;
-		clock-output-names = "spi3-nclk";
-	};
-
 	/*
 	 * CS42L81 on SPI1 (control) and MCA0 (data): built-in speakers,
 	 * 3.5 mm headphones and the two built-in microphones (ADT
@@ -323,7 +308,6 @@
 };
 
 &spi1 {
-	clocks = <&spi1_nclk>;
 	/* ADT function-spi_cs0 */
 	cs-gpios = <&pinctrl_ap 16 GPIO_ACTIVE_LOW>;
 	status = "okay";
@@ -343,7 +327,6 @@
 };
 
 &spi3 {
-	clocks = <&spi3_nclk>;
 	cs-gpios = <&pinctrl_ap 102 GPIO_ACTIVE_LOW>;
 	status = "okay";
 
