From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:32:54 +0000
Subject: [PATCH] arm64: dts: apple: s800-0-3: Add the memory port monitor

Describe the MCC port-monitor window shared by S8000 and S8003 so the
apple_amc PMU can count CPU and graphics memory traffic.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s800-0-3.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index 779118fe3..bc8d381e2 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -70,6 +70,11 @@ soc {
 		nonposted-mmio;
 		ranges;
 
+		amc_pmu: pmu@200000500 {
+			compatible = "apple,s8000-amc-pmu";
+			reg = <0x2 0x500 0x0 0xa0>;
+		};
+
 		cpufreq: performance-controller@202220000 {
 			compatible = "apple,s8000-cluster-cpufreq", "apple,t8103-cluster-cpufreq", "apple,cluster-cpufreq";
 			reg = <0x2 0x02220000 0 0x1000>;
