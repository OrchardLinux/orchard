From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:48:29 +0100
Subject: [PATCH] arm64: dts: apple: t7000: Describe the iPod touch 6
 touchscreen

Enable SPI2 and the PMGR touch clock on N102. Its Apple device tree
gives chip select 185, interrupt 3, reset 2, Chestnut analog supply
dpLE(0x302) and D2186 core supply pmuL(0x20e). The touchscreen alias
lets the loader supply the unit calibration. Invert the N1 raw Y
axis to map its bottom origin to the display top.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t7000-n102.dts | 45 ++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-n102.dts b/arch/arm64/boot/dts/apple/t7000-n102.dts
index 96192af..a2a8411 100644
--- a/arch/arm64/boot/dts/apple/t7000-n102.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n102.dts
@@ -16,6 +16,11 @@
 	model = "Apple iPod touch 6";
 	chassis-type = "handset";
 
+	aliases {
+		spi2 = &spi2;
+		touchscreen0 = &touchscreen;
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -72,15 +77,55 @@
 	status = "okay";
 };
 
+&spi2 {
+	cs-gpios = <&pinctrl 185 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,n102-touchscreen";
+		reg = <0>;
+		/* The N1 driver requests an 83 ns SPI bit period. */
+		spi-max-frequency = <12048192>;
+		interrupts-extended = <&pinctrl 3 IRQ_TYPE_EDGE_FALLING>;
+		attn-gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
+		reset-gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
+		ana-supply = <&touch_ana>;
+		core-supply = <&touch_core>;
+		clocks = <&touchclk>;
+		firmware-name = "apple/n102-fwstart.z2fw";
+		touchscreen-size-x = <640>;
+		touchscreen-size-y = <1136>;
+		touchscreen-inverted-y;
+	};
+};
+
+&touchclk {
+	status = "okay";
+};
 &i2c0 {
 	status = "okay";
 
+	display-pmu@27 {
+		compatible = "apple,chestnut-pmic";
+		reg = <0x27>;
+
+		touch_ana: regulator-touch-hv {
+			compatible = "apple,chestnut-touch-hv-regulator";
+			regulator-name = "touch-analog";
+		};
+	};
+
 	pmic@74 {
 		compatible = "apple,adi-pmic", "apple,i2c-pmic";
 		reg = <0x74>;
 		#address-cells = <1>;
 		#size-cells = <1>;
 
+		touch_core: regulator-touch-core {
+			compatible = "apple,d2186-touch-core-regulator";
+			regulator-name = "touch-core";
+		};
+
 		rtc@5c0 {
 			compatible = "apple,adi-pmic-rtc", "apple,amber-pmic-rtc";
 			reg = <0x5c0 0x10>;
