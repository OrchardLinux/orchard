From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 21:15:00 +0100
Subject: [PATCH] arm64: dts: apple: t7000-n102: Use Apple 0006-default OCV
 curve and Rint

Update the N102 simple-battery node with key points from
AppleARMPMUCharger's battery-data["0006-default"] OCV curve for
battery-family 6 (3400..4275 mV for 0..99%) and add the 200 mOhm
factory internal resistance used for read-only charging IR compensation.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t7000-n102.dts | 29 +++++++++++++++--------------
 1 file changed, 15 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t7000-n102.dts b/arch/arm64/boot/dts/apple/t7000-n102.dts
index 30cf9ab6cc2565ffc473cf0f74fc1496e35dc4a8..0cb7660019a1bc659f7882bf05720881e130e8a9 100644
--- a/arch/arm64/boot/dts/apple/t7000-n102.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n102.dts
@@ -65,9 +65,8 @@
 
 	/*
 	 * Design capacity (1080 mAh) and shutdown voltage (3400 mV) come from
-	 * the board's firmware device tree. The OCV curve is an approximate
-	 * 4.35 V Li-ion profile anchored at 3400 mV = 0% until measured on
-	 * hardware.
+	 * the board's firmware device tree (battery-family 6). The OCV curve
+	 * comes from AppleARMPMUCharger battery-data["0006-default"].
 	 */
 	n102_battery: battery {
 		compatible = "simple-battery";
@@ -75,18 +74,20 @@
 		charge-full-design-microamp-hours = <1080000>;
 		voltage-min-design-microvolt = <3400000>;
 		voltage-max-design-microvolt = <4350000>;
+		factory-internal-resistance-micro-ohms = <200000>;
 		ocv-capacity-celsius = <20>;
-		ocv-capacity-table-0 = <4350000 100>,
-				       <4220000 90>,
-				       <4100000 80>,
-				       <3990000 70>,
-				       <3900000 60>,
-				       <3840000 50>,
-				       <3800000 40>,
-				       <3770000 30>,
-				       <3740000 20>,
-				       <3680000 10>,
-				       <3580000 5>,
+		ocv-capacity-table-0 = <4275000 99>,
+				       <4176000 90>,
+				       <4075000 80>,
+				       <3970000 70>,
+				       <3897000 60>,
+				       <3835000 50>,
+				       <3797000 40>,
+				       <3771000 30>,
+				       <3741000 20>,
+				       <3689000 10>,
+				       <3669000 5>,
+				       <3460000 1>,
 				       <3400000 0>;
 	};
 };
