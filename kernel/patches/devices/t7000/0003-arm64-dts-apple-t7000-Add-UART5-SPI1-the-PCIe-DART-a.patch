From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Ballard <tom.ballard08@googlemail.com>
Date: Thu, 5 Nov 2026 19:31:44 +0000
Subject: [PATCH] arm64: dts: apple: t7000: Add UART5, SPI1, the PCIe DART and
 the PCIe controller
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Describe the A8 blocks the iPad mini 4's battery gauge, touchscreen and
Wi-Fi need, disabled until a board enables them: UART5 (the HDQ line to
the gauge, with its pin 57 in UART mode), SPI1 with its 60 MHz clock
(ADT clock ID 0x12d, clock-frequencies[45]), the DART in front of PCIe
port 1 with its error reflector, fetch and diag configuration, and the
PCIe root complex with its MSI range and power domains.

The A8 apcie has two root ports (ADT #ports = 2), so the controller maps
the config, rc, port0 and port1 windows and takes the two port
interrupts (AIC 212 and 215). Everything else, MSI vectors 224-255 with
the doorbell at 0xbffff000, the ranges and the DART, matches the J96 ADT
and the A8X's values.

The nodes follow the T7001 ones from Martin Puškáč's iPad Air 2 port.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t7000.dtsi | 80 ++++++++++++++++++++++++++++
 1 file changed, 80 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000.dtsi b/arch/arm64/boot/dts/apple/t7000.dtsi
index 8b257ef23..72a2e7d52 100644
--- a/arch/arm64/boot/dts/apple/t7000.dtsi
+++ b/arch/arm64/boot/dts/apple/t7000.dtsi
@@ -26,6 +26,14 @@ clkref: clock-ref {
 		clock-output-names = "clkref";
 	};
 
+	spi1_clk: clock-spi1 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		/* ADT clock ID 0x12d: clock-frequencies[45]. */
+		clock-frequency = <60000000>;
+		clock-output-names = "spi1";
+	};
+
 	spi2_clk: clock-spi2 {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
@@ -140,6 +148,18 @@ serial0: serial@20a0c0000 {
 			status = "disabled";
 		};
 
+		serial5: serial@20a0d4000 {
+			compatible = "apple,t7000-uart", "apple,t8010-uart", "apple,s5l-uart";
+			reg = <0x2 0x0a0d4000 0x0 0x4000>;
+			reg-io-width = <4>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 163 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkref>, <&clkref>;
+			clock-names = "uart", "clk_uart_baud0";
+			power-domains = <&ps_uart5>;
+			status = "disabled";
+		};
+
 		serial6: serial@20a0d8000 {
 			compatible = "apple,s5l-uart";
 			reg = <0x2 0x0a0d8000 0x0 0x4000>;
@@ -209,6 +229,18 @@ i2c3: i2c@20a113000 {
 			status = "disabled";
 		};
 
+		spi1: spi@20a084000 {
+			compatible = "apple,t7000-spi", "apple,spi";
+			reg = <0x2 0x0a084000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 153 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&spi1_clk>;
+			power-domains = <&ps_spi1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 		spi2: spi@20a088000 {
 			compatible = "apple,t7000-spi", "apple,spi";
 			reg = <0x2 0x0a088000 0x0 0x4000>;
@@ -354,6 +386,54 @@ i2c3_pins: i2c3-pins {
 				pinmux = <APPLE_PINMUX(87, 1)>,
 					 <APPLE_PINMUX(86, 1)>;
 			};
+
+			uart5_pins: uart5-pins {
+				pinmux = <APPLE_PINMUX(57, 1)>;
+			};
+		};
+
+		/*
+		 * The ADT gives this DART 8 KiB at 0x602002000, inside the PCIe
+		 * port 1 block; its registers end below 0x100.
+		 */
+		pcie_dart1: iommu@602002000 {
+			compatible = "apple,t7000-dart", "apple,s5l8960x-dart";
+			reg = <0x6 0x02002000 0x0 0x2000>;
+			#iommu-cells = <5>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 216 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_pcie>;
+			/* ADT dart-apcie1: error-reflector, fetch-config, diag-config */
+			apple,error-reflector = /bits/ 64 <0x20ffff000>;
+			apple,fetch-config = <0x000e0303>;
+			apple,diag-config = <0x00000100>;
+			status = "disabled";
+		};
+
+		/* The A8 root complex has two root ports; the A8X has four. */
+		pcie: pcie@610000000 {
+			compatible = "apple,t7000-pcie";
+			device_type = "pci";
+			reg = <0x6 0x10000000 0x0 0x1000000>,
+			      <0x6 0x00000000 0x0 0x2000>,
+			      <0x6 0x01004000 0x0 0x1000>,
+			      <0x6 0x02004000 0x0 0x1000>;
+			reg-names = "config", "rc", "port0", "port1";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 212 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 215 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "port0", "port1";
+			msi-controller;
+			msi-parent = <&pcie>;
+			msi-ranges = <&aic AIC_IRQ 224 IRQ_TYPE_EDGE_RISING 32>;
+			apple,msi-doorbell = <0xbffff000>;
+			bus-range = <0 8>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x43000000 0x6 0x20000000 0x6 0x20000000 0x1 0xa0000000>,
+				 <0x02000000 0x0 0xc0000000 0x7 0xc0000000 0x0 0x40000000>;
+			power-domains = <&ps_pcie>, <&ps_pcie_ref>, <&ps_pcie_aux>;
+			status = "disabled";
 		};
 	};
 
