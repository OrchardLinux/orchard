From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:40:24 +0100
Subject: [PATCH] arm64: dts: apple: t7000: Describe the iPod touch 6 LED
 driver

Link the DWI backlight to the LM3534 at I2C0 address 0x63. The
boot firmware configures the display and DWI still sets brightness.

Assisted-by: LLM
Signed-off-by: Berkay Kösebay <brkosebay@users.noreply.github.com>
Link: https://github.com/OrchardLinux/orchard/pull/231#issuecomment-7138590680
---
 arch/arm64/boot/dts/apple/t7000-n102.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-n102.dts b/arch/arm64/boot/dts/apple/t7000-n102.dts
index a2a8411..14fe8a4 100644
--- a/arch/arm64/boot/dts/apple/t7000-n102.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n102.dts
@@ -69,6 +69,10 @@
 	apple,always-on;
 };
 
+&dwi_bl {
+	apple,led-driver = <&backlight_driver>;
+};
+
 &framebuffer0 {
 	power-domains = <&ps_disp0 &ps_mipi_dsi>;
 };
@@ -105,6 +109,12 @@
 &i2c0 {
 	status = "okay";
 
+
+	backlight_driver: led-controller@63 {
+		compatible = "ti,lm3534";
+		reg = <0x63>;
+	};
+
 	display-pmu@27 {
 		compatible = "apple,chestnut-pmic";
 		reg = <0x27>;
