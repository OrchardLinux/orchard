From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Ballard <tom.ballard08@googlemail.com>
Date: Thu, 5 Nov 2026 19:33:30 +0000
Subject: [PATCH] arm64: dts: apple: t7000-j96: Add the touchscreen

Describe the iPad mini 4's N1 touchscreen on SPI1 from the ADT's
spi1/multi-touch functions: chip select GPIO 15, reset GPIO 56,
interrupt GPIO 106, LDO enable GPIO 47, the D2207 analog supply
pmuL(0x20e) and the touch clock (TCLK, the same arguments as on the
iPad Air 2). m1n1 adds the calibration through the touchscreen0 alias.

On a J96, raw X ran from left to right and raw Y from the bottom of the
panel to the top, so Y is inverted, as on the iPad 5 and iPad Air 2.
The bus ran at 1 MHz there; this uses the period iOS selects (83 ns),
as on the iPad Air 2.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t7000-j96.dts | 38 +++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-j96.dts b/arch/arm64/boot/dts/apple/t7000-j96.dts
index b494b89c1..a93754a30 100644
--- a/arch/arm64/boot/dts/apple/t7000-j96.dts
+++ b/arch/arm64/boot/dts/apple/t7000-j96.dts
@@ -14,6 +14,7 @@ / {
 
 	aliases {
 		serial5 = &serial5;
+		touchscreen0 = &touchscreen;
 		wifi0 = &wifi0;
 	};
 
@@ -29,6 +30,11 @@ wlan_vdd: regulator-wlan-vdd {
 
 &i2c0 {
 	pmic@3c {
+		touch_analog: regulator-touch-analog {
+			compatible = "apple,d2207-touch-analog-regulator";
+			regulator-name = "touch-analog";
+		};
+
 		pmu_gpio: gpio {
 			compatible = "apple,d2207-pmic-gpio";
 			gpio-controller;
@@ -89,3 +95,35 @@ wifi0: wifi@0,0 {
 		};
 	};
 };
+
+/*
+ * The N1 touchscreen, from the ADT spi1/multi-touch functions: chip select
+ * GPIO 15, reset GPIO 56, interrupt GPIO 106, LDO enable GPIO 47, analog
+ * supply pmuL(0x20e) and the PMGR touch clock at 32768 Hz. Its display
+ * sync (GPIO 78) stays as iBoot left it.
+ */
+&spi1 {
+	cs-gpios = <&pinctrl 15 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,j96-touchscreen";
+		reg = <0>;
+		/* N1 selects 83 ns; the controller rounds up to divider 5 */
+		spi-max-frequency = <12048192>;
+		interrupts-extended = <&pinctrl 106 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&pinctrl 56 GPIO_ACTIVE_LOW>;
+		power-ldo-gpios = <&pinctrl 47 GPIO_ACTIVE_HIGH>;
+		ana-supply = <&touch_analog>;
+		clocks = <&touchclk>;
+		firmware-name = "apple/j96-fwstart.z2fw";
+		touchscreen-size-x = <1536>;
+		touchscreen-size-y = <2048>;
+		/* Raw Y runs from the bottom of the panel to the top. */
+		touchscreen-inverted-y;
+	};
+};
+
+&touchclk {
+	status = "okay";
+};
