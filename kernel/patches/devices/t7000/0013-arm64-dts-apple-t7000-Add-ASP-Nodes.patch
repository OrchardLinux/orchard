From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nick Chan <towinchenmi@gmail.com>
Date: Tue, 1 Sep 2026 11:22:31 +0800
Subject: [PATCH] arm64: dts: apple: t7000: Add ASP Nodes

XXX TODO

[Orchard: from HoolockLinux/linux ans1 ed8528f (c13623f9ac9b), unchanged.
It describes the A8 storage coprocessor (ANS1) and its mailbox, with the
firmware region m1n1 fills in through the asp alias.]
Signed-off-by: Nick Chan <towinchenmi@gmail.com>
---
 arch/arm64/boot/dts/apple/t7000-common.dtsi | 12 +++++++++++
 arch/arm64/boot/dts/apple/t7000.dtsi        | 23 +++++++++++++++++++++
 2 files changed, 35 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-common.dtsi b/arch/arm64/boot/dts/apple/t7000-common.dtsi
index 0d40a5753..11f251162 100644
--- a/arch/arm64/boot/dts/apple/t7000-common.dtsi
+++ b/arch/arm64/boot/dts/apple/t7000-common.dtsi
@@ -12,6 +12,7 @@
 / {
 	aliases {
 		ausbphy0 = &ausbphy0; /* Used by loader */
+		asp = &ans;
 		serial0 = &serial0;
 		serial6 = &serial6;
 	};
@@ -32,6 +33,17 @@
 		#size-cells = <2>;
 		ranges;
 
+		ans_firmware: ans-firmware {
+			/* Filled in by bootloder */
+			reg = <0 0 0 0>;
+			no-map;
+		};
 		/* To be filled by loader */
 	};
 };
+
+&ans {
+	memory-region = <&ans_firmware>;
+	memory-region-names = "firmware";
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t7000.dtsi b/arch/arm64/boot/dts/apple/t7000.dtsi
index 1a165a7b8..3a93dbe2e 100644
--- a/arch/arm64/boot/dts/apple/t7000.dtsi
+++ b/arch/arm64/boot/dts/apple/t7000.dtsi
@@ -152,6 +152,29 @@
 			#performance-domain-cells = <0>;
 		};
 
+		ans: block@208040000 {
+			compatible = "apple,t7000-ans", "apple,s5l8960x-ans";
+			reg = <0x2 0x08040000 0x0 0x1000>;
+			mboxes = <&ans_mbox>;
+			power-domains = <&ps_ans>;
+			resets = <&ps_ans>;
+			status = "disabled";
+		};
+
+		ans_mbox: mbox@208041000 {
+			compatible = "apple,t7000-akf-mailbox-v1", "apple,akf-mailbox-v1";
+			reg = <0x2 0x08041000 0x0 0x1000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 36 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 37 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 38 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 39 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+				"recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			power-domains = <&ps_ans>;
+		};
+
 		serial0: serial@20a0c0000 {
 			compatible = "apple,s5l-uart";
 			reg = <0x2 0x0a0c0000 0x0 0x4000>;
