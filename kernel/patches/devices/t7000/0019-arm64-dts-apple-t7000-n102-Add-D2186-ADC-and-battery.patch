From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 15:10:00 +0100
Subject: [PATCH] arm64: dts: apple: t7000-n102: Add D2186 ADC and battery

Describe the Dialog D2186 PMIC housekeeping ADC and read-only battery
monitor on the iPod touch 6 (N102), which has no standalone fuel-gauge
IC.

Battery design parameters come from the board's firmware device tree
(1080 mAh design capacity, 3400 mV shutdown voltage). The 3400..4350 mV
Li-ion OCV capacity table is an approximation until measured on hardware.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t7000-n102.dts | 48 ++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-n102.dts b/arch/arm64/boot/dts/apple/t7000-n102.dts
index 9d042aef505f049304b5061f7fdf18545f90847a..30cf9ab6cc2565ffc473cf0f74fc1496e35dc4a8 100644
--- a/arch/arm64/boot/dts/apple/t7000-n102.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n102.dts
@@ -62,6 +62,33 @@
 			linux,code = <KEY_VOLUMEUP>;
 		};
 	};
+
+	/*
+	 * Design capacity (1080 mAh) and shutdown voltage (3400 mV) come from
+	 * the board's firmware device tree. The OCV curve is an approximate
+	 * 4.35 V Li-ion profile anchored at 3400 mV = 0% until measured on
+	 * hardware.
+	 */
+	n102_battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		charge-full-design-microamp-hours = <1080000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4350000>;
+		ocv-capacity-celsius = <20>;
+		ocv-capacity-table-0 = <4350000 100>,
+				       <4220000 90>,
+				       <4100000 80>,
+				       <3990000 70>,
+				       <3900000 60>,
+				       <3840000 50>,
+				       <3800000 40>,
+				       <3770000 30>,
+				       <3740000 20>,
+				       <3680000 10>,
+				       <3580000 5>,
+				       <3400000 0>;
+	};
 };
 
 /*
@@ -212,6 +239,27 @@
 			regulator-name = "touch-core";
 		};
 
+		pmu_adc: adc@500 {
+			compatible = "apple,d2186-adc";
+			reg = <0x500 0x24>;
+			#io-channel-cells = <1>;
+		};
+
+		battery {
+			compatible = "apple,d2186-battery";
+			monitored-battery = <&n102_battery>;
+			io-channels = <&pmu_adc 4>,
+				      <&pmu_adc 1>,
+				      <&pmu_adc 2>,
+				      <&pmu_adc 15>,
+				      <&pmu_adc 9>;
+			io-channel-names = "vbat",
+					   "ich",
+					   "tbat",
+					   "vbus",
+					   "ibus";
+		};
+
 		rtc@5c0 {
 			compatible = "apple,adi-pmic-rtc", "apple,amber-pmic-rtc";
 			reg = <0x5c0 0x10>;
-- 
2.47.0
