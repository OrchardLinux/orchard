From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:00:00 +0100
Subject: [PATCH] arm64: dts: apple: t7000-n102: Add Wi-Fi and Bluetooth

Wire the iPod touch 6's BCM4345B1 combo module ("bacchus") from its ADT:

- PMIC GPIO: the Dialog D2186 PMIC (pmu@74) drives Bluetooth power
  enable on GPIO 8 and Wi-Fi REG_ON on GPIO 10; all other PMIC GPIO
  lines remain reserved as iBoot left them.
- Wi-Fi: BCM4345 (pci14e4,43ab) on PCIe port 1 behind pcie_dart1, with
  PERST# on GPIO 77, DEVICE_WAKE on GPIO 200, REG_ON as a fixed
  regulator on D2186 GPIO 10, Gen1 link speed, board type
  "apple,bacchus", and trivial country-code mapping. m1n1 fills the MAC
  address through the wifi0 alias.
- Bluetooth: on UART1 with hardware flow control, power enable on D2186
  GPIO 8, BT_WAKE on GPIO 50, starting at 115,200 baud, and linked to
  wifi0 via apple,wlan so hci_bcm picks the vendor Patchram matching the
  Wi-Fi OTP. m1n1 fills the device address through the bluetooth0 alias.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t7000-n102.dts | 76 ++++++++++++++++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-n102.dts b/arch/arm64/boot/dts/apple/t7000-n102.dts
index 14fe8a4..7723574 100644
--- a/arch/arm64/boot/dts/apple/t7000-n102.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n102.dts
@@ -17,10 +17,22 @@
 	chassis-type = "handset";
 
 	aliases {
+		bluetooth0 = &bluetooth;
+		serial1 = &serial1;
+		wifi0 = &wifi0;
 		spi2 = &spi2;
 		touchscreen0 = &touchscreen;
 	};
 
+	/* Wi-Fi REG_ON is D2186 GPIO 10 (ADT uart4/wlan function-reg_on). */
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&pmu_gpio 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		off-on-delay-us = <100000>;
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -73,6 +85,62 @@
 	apple,led-driver = <&backlight_driver>;
 };
 
+&pcie_dart1 {
+	status = "okay";
+};
+
+/*
+ * The BCM4345 on root port 1 (ADT apcie/pci-bridge1): PERST# GPIO 77,
+ * DEVICE_WAKE GPIO 200, Gen1. Port 0 has nothing attached. CLKREQ#
+ * (GPIO 41) is not described, as on the T7001 and mini 4.
+ */
+&pcie {
+	/* ADT dart-apcie1 vm-offset and vm-size; SID 0 */
+	iommu-map = <0x100 &pcie_dart1 0 0x0 0x80000000 0x0 0x3ffff000 1>;
+	iommu-map-mask = <0xff00>;
+	status = "okay";
+
+	pci@1,0 {
+		device_type = "pci";
+		reg = <0x800 0x0 0x0 0x0 0x0>;
+		bus-range = <1 1>;
+		reset-gpios = <&pinctrl 77 GPIO_ACTIVE_LOW>;
+		max-link-speed = <1>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi0: wifi@0,0 {
+			compatible = "pci14e4,43ab";
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+			device-wake-gpios = <&pinctrl 200 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&wlan_vdd>;
+			brcm,board-type = "apple,bacchus";
+			brcm,ccode-map-trivial;
+		};
+	};
+};
+
+/*
+ * The BCM4345B1's Bluetooth on UART1, from the ADT uart1/bluetooth node:
+ * power enable on D2186 GPIO 8, BT_WAKE on GPIO 50. m1n1 adds the device
+ * address. Starts at 115,200 baud; the ADT allows 3 Mbit/s.
+ */
+&serial1 {
+	pinctrl-0 = <&uart1_pins>;
+	pinctrl-names = "default";
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth: bluetooth {
+		compatible = "apple,n102-bcm4345b1-bt";
+		current-speed = <115200>;
+		shutdown-gpios = <&pmu_gpio 8 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&pinctrl 50 GPIO_ACTIVE_HIGH>;
+		apple,wlan = <&wifi0>;
+	};
+};
+
 &framebuffer0 {
 	power-domains = <&ps_disp0 &ps_mipi_dsi>;
 };
@@ -131,6 +199,14 @@
 		#address-cells = <1>;
 		#size-cells = <1>;
 
+		pmu_gpio: gpio {
+			compatible = "apple,d2186-pmic-gpio";
+			gpio-controller;
+			#gpio-cells = <2>;
+			/* Only Bluetooth (8) and Wi-Fi (10) REG_ON are used; the others stay as iBoot left them. */
+			gpio-reserved-ranges = <0 8>, <9 1>, <11 10>;
+		};
+
 		touch_core: regulator-touch-core {
 			compatible = "apple,d2186-touch-core-regulator";
 			regulator-name = "touch-core";
