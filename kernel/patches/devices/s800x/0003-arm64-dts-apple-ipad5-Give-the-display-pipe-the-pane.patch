From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 17 Nov 2026 23:07:27 +0100
Subject: [PATCH] arm64: dts: apple: ipad5: Give the display pipe the panel
 supply and backlight

The ADT displayport node's function-lcd_ldo is PMU GPIO 22 on every iPad 5
board: the panel supply, which iOS switches off when the display sleeps.
Hand it and the DWI backlight to the display pipe, which now turns the
panel off in system sleep. Both are post-init providers: the pipe's probe
does not wait for the PMU or the backlight, and the driver looks them up
before the first sleep. Line 22 is no longer reserved.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s800x-ipad5.dtsi | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
index 93347fc..de87722 100644
--- a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
@@ -191,13 +191,13 @@
 
 		/*
 		 * 0, 10: Smart Cover halls; 13: Bluetooth power enable;
-		 * 14: WLAN REG_ON.
+		 * 14: WLAN REG_ON; 22: panel supply (lcd_ldo).
 		 */
 		pmu_gpio: gpio {
 			compatible = "apple,d2365-pmic-gpio";
 			gpio-controller;
 			#gpio-cells = <2>;
-			gpio-reserved-ranges = <1 9>, <11 2>, <15 9>;
+			gpio-reserved-ranges = <1 9>, <11 2>, <15 7>, <23 1>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
 			interrupts-extended = <&pinctrl_ap 76 IRQ_TYPE_LEVEL_LOW>;
@@ -428,7 +428,15 @@
 	};
 };
 
+/*
+ * ADT displayport function-lcd_ldo = PMU GPIO 22: the panel supply, off in
+ * system sleep as on iOS. Neither it nor the backlight holds up the
+ * pipe's probe; the driver looks them up before the first sleep.
+ */
 &disp0 {
+	apple,lcd-ldo-gpios = <&pmu_gpio 22 GPIO_ACTIVE_HIGH>;
+	backlight = <&dwi_bl>;
+	post-init-providers = <&pmu_gpio>, <&dwi_bl>;
 	status = "okay";
 };
 
