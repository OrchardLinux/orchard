From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Fri, 30 Oct 2026 01:18:20 +0800
Subject: [PATCH 1/2] arm64: dts: apple: t8010: Describe the GPU

The A10's GPU is a PowerVR Rogue core behind Apple's "Fender" power and
control block, driven by Apple's GFX firmware on the gfx-kf coprocessor
(an AppleA7IOP V2). Describe the core, Fender and the coprocessor as one
node with three register ranges, its power domain, the firmware name and
an operating-points table, plus the coprocessor's mailbox. The table is
left empty: the bootloader fills it from the Apple device tree (sgx
perf-states), so no per-device clock data lives here. Enable the GPU on
the iPad 6, with the gpu alias the bootloader looks for.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-j71b.dts | 10 +++++++
 arch/arm64/boot/dts/apple/t8010.dtsi     | 37 ++++++++++++++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8010-j71b.dts b/arch/arm64/boot/dts/apple/t8010-j71b.dts
index 63e8573..2adcae9 100644
--- a/arch/arm64/boot/dts/apple/t8010-j71b.dts
+++ b/arch/arm64/boot/dts/apple/t8010-j71b.dts
@@ -83,3 +83,13 @@
 &nco {
 	status = "okay";
 };
+
+/ {
+	aliases {
+		gpu = &gpu;
+	};
+};
+
+&gpu {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8010.dtsi b/arch/arm64/boot/dts/apple/t8010.dtsi
index 5f68659..d415a9c 100644
--- a/arch/arm64/boot/dts/apple/t8010.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010.dtsi
@@ -149,6 +149,16 @@
 #endif
 	};
 
+	/*
+	 * The GPU's performance states. The bootloader (m1n1) fills one entry
+	 * per powered state from the Apple device tree's sgx node: opp-hz,
+	 * opp-microvolt and opp-level, the state number the GPU's power
+	 * controller takes. The table stays empty without it.
+	 */
+	gpu_opp: opp-table-gpu {
+		compatible = "operating-points-v2";
+	};
+
 	soc {
 		compatible = "simple-bus";
 		#address-cells = <2>;
@@ -308,6 +318,33 @@
 			status = "disabled";
 		};
 
+		gpu: gpu@201000000 {
+			compatible = "apple,t8010-gpu";
+			reg = <0x2 0x01000000 0x0 0x100000>,
+			      <0x2 0x01d00000 0x0 0x5000>,
+			      <0x2 0x01d20000 0x0 0x4000>;
+			reg-names = "rgx", "fender", "iop";
+			mboxes = <&gpu_mbox>;
+			power-domains = <&ps_gfx>;
+			operating-points-v2 = <&gpu_opp>;
+			firmware-name = "apple/gfx-t8010.bin";
+			status = "disabled";
+		};
+
+		gpu_mbox: mbox@201d24000 {
+			compatible = "apple,t8010-a7iop-mailbox";
+			reg = <0x2 0x01d24000 0x0 0x1000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 189 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 190 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 191 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 192 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			power-domains = <&ps_gfx>;
+		};
+
 		sio: dma-controller@20ae00000 {
 			compatible = "apple,t8010-sio";
 			reg = <0x2 0x0ae00000 0x0 0x10000>,
