From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:39:57 +0100
Subject: [PATCH] arm64: dts: apple: s800-0-3: Add the NCO and MCA2

Describe the NCO (ADT /arm-io/nco, nco,s8000: the T8010 block at the
same address, five channels 0x4000 apart) with its 800 MHz reference
(the n66 ADT's clock-frequencies entry for clock-id 269), and MCA2, the
iPhones' speaker TDM link on pad 2: SmartIO endpoint 0x2c, MCLK control
word 0x20a002008, AIC 203, bitclock from NCO channel 2.

The NCO, MCA2, SmartIO and I2C1 are SoC blocks every S8000 and S8003
has, so they are enabled here; boards add only their wiring (the
i2s-switch route and what sits on the bus). The iPad 5's SmartIO
override is no longer needed.

Assisted-by: LLM
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 arch/arm64/boot/dts/apple/s800-0-3.dtsi    | 47 +++++++++++++++++++++-
 arch/arm64/boot/dts/apple/s800x-ipad5.dtsi |  4 --
 2 files changed, 45 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index 29f9d1dc3..646ea1f3d 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -50,6 +50,18 @@ spi3_nclk: clock-spi3-nclk {
 		clock-output-names = "spi3-nclk";
 	};
 
+	/*
+	 * The NCO's reference: the ADT's clock-frequencies entry for the
+	 * NCO's first clock-id (269), 800 MHz on the n66. A board whose ADT
+	 * says otherwise overrides it.
+	 */
+	nco_clkref: clock-ref-nco {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <800000000>;
+		clock-output-names = "nco_ref";
+	};
+
 	cpus {
 		#address-cells = <2>;
 		#size-cells = <0>;
@@ -260,6 +272,28 @@ mca0: mca@20a0a0000 {
 			status = "disabled";
 		};
 
+		/*
+		 * ADT /arm-io/mca2: the speaker TDM link of the iPhones (pad 2),
+		 * SmartIO endpoint 0x2c, bitclock from NCO 2.
+		 */
+		mca2: mca@20a0a8000 {
+			compatible = "apple,s8000-mca-tdm";
+			reg = <0x2 0x0a0a8000 0x0 0x4000>,
+			      <0x2 0x0a002008 0x0 0x4>;
+			reg-names = "mca", "mclk";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 203 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_mca2>;
+			clocks = <&nco 2>;
+			clock-names = "bitclk";
+			dmas = <&sio 0x2c>;
+			dma-names = "tx";
+			#clock-cells = <0>;
+			clock-output-names = "mca2-mclk";
+			#sound-dai-cells = <0>;
+			status = "okay";
+		};
+
 		serial0: serial@20a0c0000 {
 			compatible = "apple,s5l-uart";
 			reg = <0x2 0x0a0c0000 0x0 0x4000>;
@@ -335,7 +369,7 @@ i2c1: i2c@20a111000 {
 			power-domains = <&ps_i2c1>;
 			#address-cells = <1>;
 			#size-cells = <0>;
-			status = "disabled";
+			status = "okay";
 		};
 
 		i2c2: i2c@20a112000 {
@@ -368,7 +402,7 @@ sio: dma-controller@20ae00000 {
 			firmware-name = "apple/s8000-smartio.bin";
 			dma-channels = <64>;
 			#dma-cells = <1>;
-			status = "disabled";
+			status = "okay";
 		};
 
 		bus@20c000000 {
@@ -468,6 +502,15 @@ touchclk: clock-controller@78000 {
 			};
 		};
 
+		/* ADT /arm-io/nco: nco,s8000, five channels 0x4000 apart */
+		nco: clock-controller@20e044000 {
+			compatible = "apple,s8000-nco", "apple,t8010-nco";
+			reg = <0x2 0x0e044000 0x0 0x14000>;
+			clocks = <&nco_clkref>;
+			#clock-cells = <1>;
+			status = "okay";
+		};
+
 		pmgr_misc: power-management@20e068000 {
 			compatible = "apple,s8000-pmgr-misc";
 			reg = <0x2 0x0e068000 0x0 0x4>;
diff --git a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
index dfd1b2d42..376c15bd1 100644
--- a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
@@ -324,10 +324,6 @@ battery: fuel-gauge {
 	};
 };
 
-&sio {
-	status = "okay";
-};
-
 &spi1 {
 	/* ADT function-spi_cs0 */
 	cs-gpios = <&pinctrl_ap 16 GPIO_ACTIVE_LOW>;
