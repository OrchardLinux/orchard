From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 10 Nov 2026 07:49:21 +0800
Subject: [PATCH] arm64: dts: apple: t8010: Add the VXD video decoder

Describe the decoder as the Apple device trees of the iPad 6 and iPad 7
do (vxd@8100000, two register ranges, AIC interrupt 172, the vdec0
power domain) and enable it on those tablets.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi |  4 ++++
 arch/arm64/boot/dts/apple/t8010.dtsi       | 14 ++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index 1b025dabba43..d2b8bdce4f9f 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -351,6 +351,10 @@ usbdev_role: endpoint {
 	};
 };
 
+&vxd {
+	status = "okay";
+};
+
 &wlan_uart2 {
 	pinctrl-0 = <&wlan_uart2_pins>;
 	pinctrl-names = "default";
diff --git a/arch/arm64/boot/dts/apple/t8010.dtsi b/arch/arm64/boot/dts/apple/t8010.dtsi
index d42aace6e799..64fdf4dbbb59 100644
--- a/arch/arm64/boot/dts/apple/t8010.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010.dtsi
@@ -348,6 +348,20 @@ gpu_mbox: mbox@201d24000 {
 			power-domains = <&ps_gfx>;
 		};
 
+		/*
+		 * Imagination MSVDX ("VXD") H.264 decoder, ADT vxd@8100000. It
+		 * has its own two-level GART, so no DART.
+		 */
+		vxd: video-codec@208100000 {
+			compatible = "apple,t8010-vxd";
+			reg = <0x2 0x08100000 0x0 0x30000>,
+			      <0x2 0x08130000 0x0 0x1000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 172 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_vdec0>;
+			status = "disabled";
+		};
+
 		sio: dma-controller@20ae00000 {
 			compatible = "apple,t8010-sio";
 			reg = <0x2 0x0ae00000 0x0 0x10000>,
