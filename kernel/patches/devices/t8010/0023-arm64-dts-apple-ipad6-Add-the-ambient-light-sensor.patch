From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Fri, 13 Nov 2026 05:50:00 +0800
Subject: [PATCH] arm64: dts: apple: ipad6: Add the ambient light sensor

The iPad 6 has the iPad 7's CT819 light sensor: Apple's device tree of
both boards has i2c2 als1 "als,ct819" at 0x39 with GPIO 27 level-low.
It was described in t8010-ipad7.dtsi only, which includes
t8010-ipad6.dtsi; move the node and its als0 alias (for m1n1's
calibration) there, so the iPad 6 (J71b/J72b) gets it and the iPad 7
keeps it unchanged.

Assisted-by: LLM
---
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index 441ce32..ed59564 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -13,6 +13,7 @@
 	chassis-type = "tablet";
 
 	aliases {
+		als0 = &als;
 		bluetooth0 = &bluetooth;
 		touchscreen0 = &touchscreen;
 		wifi0 = &wifi;
@@ -233,6 +234,21 @@
 	};
 };
 
+/*
+ * The ambient light sensor, as in Apple's device tree of the iPad 6 and
+ * iPad 7 (i2c2 als1, als,ct819 at 0x39, GPIO 27 level-low).
+ */
+&i2c2 {
+	status = "okay";
+
+	/* m1n1 adds apple,als-calibration from the ADT */
+	als: light-sensor@39 {
+		compatible = "apple,ct819", "amstaos,tsl2581";
+		reg = <0x39>;
+		interrupts-extended = <&pinctrl_ap 27 IRQ_TYPE_LEVEL_LOW>;
+	};
+};
+
 &i2s_switch {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
index e0dff4b..9a6899d 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
@@ -13,12 +13,6 @@
  */
 #include "t8010-ipad6.dtsi"
 
-/ {
-	aliases {
-		als0 = &als;
-	};
-};
-
 /* The iPad 7 port controller is Bellatrix, with its own charger policy. */
 /delete-node/ &tristar_charger;
 /delete-node/ &tristar;
@@ -85,17 +79,6 @@
 	};
 };
 
-&i2c2 {
-	status = "okay";
-
-	/* m1n1 adds apple,als-calibration from the ADT */
-	als: light-sensor@39 {
-		compatible = "apple,ct819", "amstaos,tsl2581";
-		reg = <0x39>;
-		interrupts-extended = <&pinctrl_ap 27 IRQ_TYPE_LEVEL_LOW>;
-	};
-};
-
 &d2365_pmic {
 	d2365_charger: charger@180 {
 		compatible = "apple,j172-d2365-charger", "apple,d2365-charger";
-- 
