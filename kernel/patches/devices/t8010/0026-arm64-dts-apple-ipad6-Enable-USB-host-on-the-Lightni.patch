From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Fri, 13 Nov 2026 12:00:00 +0100
Subject: [PATCH] arm64: dts: apple: ipad6: Enable USB host on the Lightning
 port

The iPad 6 Lightning port has the iPad 5's hardware: the Apple device
trees of J71b and J72b give the same Tristar (tristar,cbtl1610 on i2c0
at 0x1a), the same D2365 PMU, and the same accessory rail in the dock
node (function-acc_pwr and function-acc_sw_en on PMU LDO5,
function-acc_sleep_pwr 0x220) as J71t. Enable the role switch with the
PMIC and the Tristar, and point the Lightning charger at it, as on the
iPad 5.

The iPad 7 shares this file but has no Tristar charger node; its role
switch stays disabled.

Not yet tested on an iPad 6.

[Orchard: harmonizes orchard PR #126, commit 864b4971, onto the iPad 6]

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi | 8 ++++++++
 arch/arm64/boot/dts/apple/t8010-ipad7.dtsi | 7 +++++++
 2 files changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index fe76af181..fa7b40ac2 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -207,6 +207,7 @@ tristar_charger: charger@180 {
 				     <72 IRQ_TYPE_EDGE_RISING>,
 				     <77 IRQ_TYPE_EDGE_RISING>;
 			apple,tristar = <&tristar>;
+			apple,usb-role-switch = <&usb_role>;
 			input-current-limit-microamp = <2400000>;
 
 			/* The charger decides when USB data may come on. */
@@ -427,6 +428,13 @@ usbdev_role: endpoint {
 	};
 };
 
+/* Lightning host role: accessory power from LDO5, ACC routing by the Tristar. */
+&usb_role {
+	apple,pmic = <&d2365_pmic>;
+	apple,tristar = <&tristar>;
+	status = "okay";
+};
+
 &vxd {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
index f493f505f..de3f38768 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
@@ -22,6 +22,13 @@ &aop {
 /delete-node/ &tristar_charger;
 /delete-node/ &tristar;
 
+/* Without the Tristar accessory policy the port stays a USB device. */
+&usb_role {
+	/delete-property/ apple,pmic;
+	/delete-property/ apple,tristar;
+	status = "disabled";
+};
+
 &usbdev {
 	/delete-property/ usb-psy-name;
 	/delete-property/ usb-role-switch;
