From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 24 Nov 2026 06:21:58 +0800
Subject: [PATCH] arm64: dts: apple: s800x: Wi-Fi and Bluetooth on the iPhone 6s too

The IPSW device trees of the iPhone 6s (N71, N71m) wire the BCM4350
module exactly as the 6s Plus does (iOS 15.8.8 n71ap, n71map: uart1
bluetooth, uart4 wlan and pci-bridge1 match the n66ap's apart from
phandles): Wi-Fi on PCIe port 1 with PERST# GPIO 161, CLKREQ# 165 and
DEVICE_WAKE 73, REG_ON on D2255 GPIO 10, the platform control on UART4,
and the BCM4350C5's Bluetooth on UART1 with power on D2255 GPIO 8 and
BT_WAKE on AP GPIO 71. Only the module differs: "albarossa" instead of
"pinotnoir", and its firmware, NVRAM and Patchram come from its own
files.

Move the description to the file both models include and leave the
module name to each model. The 6s Plus DTBs are unchanged (compared
sorted, without phandles). The iPhone SE has a BCM4345 ("hans") on the
same port and is not described here.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s800x-6s.dtsi  | 115 +++++++++++++++++++++++
 arch/arm64/boot/dts/apple/s800x-n66.dtsi | 105 +--------------------
 arch/arm64/boot/dts/apple/s800x-n71.dtsi |   5 +
 3 files changed, 123 insertions(+), 102 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s800x-6s.dtsi b/arch/arm64/boot/dts/apple/s800x-6s.dtsi
index 8c4a896c7..cba029208 100644
--- a/arch/arm64/boot/dts/apple/s800x-6s.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-6s.dtsi
@@ -49,6 +49,121 @@
 	};
 };
 
+/*
+ * Wi-Fi and Bluetooth of the iPhone 6s and 6s Plus. The IPSW device trees
+ * of N66, N66m, N71 and N71m (iOS 15.8.8) wire a BCM4350 module the same
+ * way: Wi-Fi on PCIe port 1 (PERST# GPIO 161, CLKREQ# 165, DEVICE_WAKE 73),
+ * REG_ON on D2255 GPIO 10 and the platform control on UART4; Bluetooth
+ * (BCM4350C5, bluetooth,n88) on UART1 with power on D2255 GPIO 8 and
+ * BT_WAKE on AP GPIO 71. Only the module differs: "pinotnoir" in the 6s
+ * Plus, "albarossa" in the 6s. The iPhone SE has a BCM4345 instead.
+ */
+/ {
+	aliases {
+		bluetooth0 = &bluetooth;	/* the loader adds the device address */
+		serial1 = &serial1;
+		wifi0 = &wifi0;		/* the loader adds the MAC and calibration */
+	};
+
+	/* ADT uart4/wlan function-reg_on: D2255 GPIO 10 */
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&pmu_gpio 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		off-on-delay-us = <100000>;
+	};
+};
+
+&pcie0 {
+	pinctrl-0 = <&wifi_clkreq_pins>;
+	pinctrl-names = "default";
+
+	/*
+	 * Wi-Fi, from the ADT pci-bridge1: PERST# GPIO 161, CLKREQ# 165,
+	 * DEVICE_WAKE 73, 2.5 GT/s. The module has no host wake on an AP
+	 * GPIO; iOS takes it as a D2255 event.
+	 */
+	pci@1,0 {
+		device_type = "pci";
+		reg = <0x800 0x0 0x0 0x0 0x0>;
+		bus-range = <2 2>;
+		reset-gpios = <&pinctrl_ap 161 GPIO_ACTIVE_LOW>;
+		max-link-speed = <1>;
+		aspm-no-l0s;
+		aspm-no-l1;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * BCM4350 (14e4:43a3); bus 2 maps to pcie0_dart1. The model
+		 * files name the module (ADT uart4/wlan module-instance).
+		 */
+		wifi0: wifi@0,0 {
+			compatible = "pci14e4,43a3";
+			reg = <0x20000 0x0 0x0 0x0 0x0>;
+			apple,wlan-uart = <&wlan_uart4>;
+			device-wake-gpios = <&pinctrl_ap 73 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&wlan_vdd>;
+			/* cfg80211's country goes to the firmware as <ISO code>/0 */
+			brcm,ccode-map-trivial;
+		};
+	};
+};
+
+&pinctrl_ap {
+	/*
+	 * Port 1 CLKREQ# (ADT pci-bridge1 function-clkreq) in its peripheral
+	 * function: iBoot doesn't set it up for Wi-Fi on a tethered boot.
+	 */
+	wifi_clkreq_pins: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(165, 1)>;
+	};
+
+	/* ADT uart4 function-tx and function-rts */
+	wlan_uart4_pins: wlan-uart4-pins {
+		pinmux = <APPLE_PINMUX(28, 1)>,
+			 <APPLE_PINMUX(30, 1)>;
+	};
+
+	/* ADT uart1: TX 24 and RTS 26; RX and CTS follow them */
+	bluetooth_uart1_pins: bluetooth-uart1-pins {
+		pinmux = <APPLE_PINMUX(24, 1)>,
+			 <APPLE_PINMUX(25, 1)>,
+			 <APPLE_PINMUX(26, 1)>,
+			 <APPLE_PINMUX(27, 1)>;
+	};
+};
+
+&wlan_uart4 {
+	pinctrl-0 = <&wlan_uart4_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+/*
+ * The BCM4350C5's Bluetooth on UART1, from the ADT uart1/bluetooth node:
+ * power enable on D2255 GPIO 8, BT_WAKE on AP GPIO 71, 3 Mbit/s
+ * transport-speed. The Patchram follows the Wi-Fi module vendor (USI or
+ * Murata) that brcmfmac reads from the OTP.
+ */
+&serial1 {
+	pinctrl-0 = <&bluetooth_uart1_pins>;
+	pinctrl-names = "default";
+	uart-has-rtscts;
+
+	bluetooth: bluetooth {
+		compatible = "apple,n66-bcm4350c5-bt";
+		current-speed = <115200>;
+		max-speed = <3000000>;
+		shutdown-gpios = <&pmu_gpio 8 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&pinctrl_ap 71 GPIO_ACTIVE_HIGH>;
+		apple,wlan = <&wifi0>;
+	};
+};
+
 &framebuffer0 {
 	power-domains = <&ps_disp0 &ps_mipi_dsi>;
 };
diff --git a/arch/arm64/boot/dts/apple/s800x-n66.dtsi b/arch/arm64/boot/dts/apple/s800x-n66.dtsi
index 6984485ab..c064335de 100644
--- a/arch/arm64/boot/dts/apple/s800x-n66.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-n66.dtsi
@@ -23,106 +23,7 @@
 	constant-charge-current-max-microamp = <1924000>;
 };
 
