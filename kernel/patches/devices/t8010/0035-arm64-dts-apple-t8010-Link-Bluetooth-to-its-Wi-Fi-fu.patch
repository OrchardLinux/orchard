From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Duke Eagleman <301139544+jerricky26@users.noreply.github.com>
Date: Tue, 17 Nov 2026 18:08:27 -0500
Subject: [PATCH] arm64: dts: apple: t8010: Link Bluetooth to its Wi-Fi
 function

Point the Bluetooth node of the iPad 6 and 7 and the iPhone 7 (D11,
D111) at the Wi-Fi function of the same module, so the Bluetooth
Patchram follows the module vendor read from the Wi-Fi OTP. The D10
and D101 have no Wi-Fi node yet and keep the generic names.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-d11.dts    | 4 ++++
 arch/arm64/boot/dts/apple/t8010-d111.dts   | 4 ++++
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi | 1 +
 3 files changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8010-d11.dts b/arch/arm64/boot/dts/apple/t8010-d11.dts
index f8185fd33418..014eb7da559c 100644
--- a/arch/arm64/boot/dts/apple/t8010-d11.dts
+++ b/arch/arm64/boot/dts/apple/t8010-d11.dts
@@ -31,6 +31,10 @@
 	};
 };
 
+&bluetooth {
+	apple,wlan = <&wifi0>;
+};
+
 &pcie0 {
 	iommu-map = <0x100 &pcie0_dart0 0 0x0 0x80000000 0x0 0x3c000000 1>,
 		    <0x200 &pcie0_dart3 0 0x0 0x80000000 0x0 0x3ffff000 1>;
diff --git a/arch/arm64/boot/dts/apple/t8010-d111.dts b/arch/arm64/boot/dts/apple/t8010-d111.dts
index 05e3f230b146..468a9d4cefc3 100644
--- a/arch/arm64/boot/dts/apple/t8010-d111.dts
+++ b/arch/arm64/boot/dts/apple/t8010-d111.dts
@@ -31,6 +31,10 @@
 	};
 };
 
+&bluetooth {
+	apple,wlan = <&wifi0>;
+};
+
 &pcie0 {
 	iommu-map = <0x100 &pcie0_dart0 0 0x0 0x80000000 0x0 0x3c000000 1>,
 		    <0x200 &pcie0_dart2 0 0x0 0x80000000 0x0 0x3ffff000 1>;
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index ad609e8b3b68..b96346355788 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -453,6 +453,7 @@
 		max-speed = <3000000>;
 		shutdown-gpios = <&pmu_gpio 13 GPIO_ACTIVE_HIGH>;
 		device-wakeup-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
+		apple,wlan = <&wifi>;
 	};
 };
 
