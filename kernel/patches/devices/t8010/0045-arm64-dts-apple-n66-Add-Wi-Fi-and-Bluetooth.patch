From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:44:12 +0100
Subject: [PATCH] arm64: dts: apple: n66: Add Wi-Fi and Bluetooth

The iPhone 6s Plus has a BCM4350 "pinotnoir" module from USI or Murata.
From the ADT:

- Wi-Fi on PCIe port 1 (pci-bridge1: PERST# GPIO 161, CLKREQ# 165,
  DEVICE_WAKE 73, 2.5 GT/s), with REG_ON on D2255 GPIO 10 and its
  platform control on UART4.
- Bluetooth (BCM4350C5) on UART1 at up to 3 Mbit/s, with power enable on
  D2255 GPIO 8 and BT_WAKE on AP GPIO 71.

The D2255 GPIO controller goes to the file every A9 iPhone includes:
the IPSW device trees of all six (N66, N66m, N71, N71m, N69, N69u) use
D2255 lines 8 and 10 for this, and only those two are exposed. Neither
function has a host wake on an AP GPIO (iOS takes both as D2255
events), so none is described. The Samsung and TSMC N66 share the
module description.

On a Samsung N66 RAM boot the BCM4350/8 enumerated on port 1, brcmfmac
loaded its firmware and scanned 31 networks, and Bluetooth loaded the
USI Patchram and found LE devices.

Assisted-by: LLM
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 arch/arm64/boot/dts/apple/s800x-iphone.dtsi |  15 ++-
 arch/arm64/boot/dts/apple/s800x-n66.dtsi    | 104 ++++++++++++++++++++
 2 files changed, 118 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/s800x-iphone.dtsi b/arch/arm64/boot/dts/apple/s800x-iphone.dtsi
index 3498ce5ea..5e346b201 100644
--- a/arch/arm64/boot/dts/apple/s800x-iphone.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-iphone.dtsi
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0+ OR MIT
 /*
- * Touchscreen, ambient light sensor and panel link of the A9 iPhones
+ * Touchscreen, ambient light sensor, panel link and D2255 GPIOs of the A9
+ * iPhones
  *
  * The IPSW device trees of N66, N66m, N71, N71m, N69 and N69u wire both
  * the same way: the touch controller on SPI2 with the same GPIOs, bit
@@ -34,6 +35,18 @@ touch_core: regulator-touch-core {
 			compatible = "apple,antigua-touch-core-regulator";
 			regulator-name = "touch-core";
 		};
+
+		/*
+		 * Every A9 iPhone's D2255 (pmu,d2255) switches Bluetooth power
+		 * on line 8 and Wi-Fi REG_ON on line 10; the other lines stay
+		 * as iBoot left them.
+		 */
+		pmu_gpio: gpio {
+			compatible = "apple,d2255-pmic-gpio";
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-reserved-ranges = <0 8>, <9 1>, <11 10>;
+		};
 	};
 };
 
diff --git a/arch/arm64/boot/dts/apple/s800x-n66.dtsi b/arch/arm64/boot/dts/apple/s800x-n66.dtsi
index 34fc1191c..6984485ab 100644
--- a/arch/arm64/boot/dts/apple/s800x-n66.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-n66.dtsi
@@ -22,3 +22,107 @@ &touchscreen {
 &battery_info {
 	constant-charge-current-max-microamp = <1924000>;
 };
+
+/ {
+	aliases {
+		bluetooth0 = &bluetooth;	/* the loader adds the device address */
+		serial1 = &serial1;
+		wifi0 = &wifi0;		/* the loader adds the MAC and calibration */
+	};
+
+	/* ADT uart4/wlan function-reg_on: D2255 GPIO 10 */
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&pmu_gpio 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		off-on-delay-us = <100000>;
+	};
+};
+
+&pcie0 {
+	pinctrl-0 = <&wifi_clkreq_pins>;
+	pinctrl-names = "default";
+
+	/*
+	 * Wi-Fi, from the ADT pci-bridge1: PERST# GPIO 161, CLKREQ# 165,
+	 * DEVICE_WAKE 73, 2.5 GT/s. The module has no host wake on an AP
+	 * GPIO; iOS takes it as a D2255 event.
+	 */
+	pci@1,0 {
+		device_type = "pci";
+		reg = <0x800 0x0 0x0 0x0 0x0>;
+		bus-range = <2 2>;
+		reset-gpios = <&pinctrl_ap 161 GPIO_ACTIVE_LOW>;
+		max-link-speed = <1>;
+		aspm-no-l0s;
+		aspm-no-l1;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		/* BCM4350 (14e4:43a3) "pinotnoir"; bus 2 maps to pcie0_dart1 */
+		wifi0: wifi@0,0 {
+			compatible = "pci14e4,43a3";
+			reg = <0x20000 0x0 0x0 0x0 0x0>;
+			apple,wlan-uart = <&wlan_uart4>;
+			device-wake-gpios = <&pinctrl_ap 73 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&wlan_vdd>;
+			brcm,board-type = "apple,pinotnoir";
+			/* cfg80211's country goes to the firmware as <ISO code>/0 */
+			brcm,ccode-map-trivial;
+		};
+	};
+};
+
+&pinctrl_ap {
+	/*
+	 * Port 1 CLKREQ# (ADT pci-bridge1 function-clkreq) in its peripheral
+	 * function: iBoot doesn't set it up for Wi-Fi on a tethered boot.
+	 */
+	wifi_clkreq_pins: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(165, 1)>;
+	};
+
+	/* ADT uart4 function-tx and function-rts */
+	wlan_uart4_pins: wlan-uart4-pins {
+		pinmux = <APPLE_PINMUX(28, 1)>,
+			 <APPLE_PINMUX(30, 1)>;
+	};
+
+	/* ADT uart1: TX 24 and RTS 26; RX and CTS follow them */
+	bluetooth_uart1_pins: bluetooth-uart1-pins {
+		pinmux = <APPLE_PINMUX(24, 1)>,
+			 <APPLE_PINMUX(25, 1)>,
+			 <APPLE_PINMUX(26, 1)>,
+			 <APPLE_PINMUX(27, 1)>;
+	};
+};
+
+&wlan_uart4 {
+	pinctrl-0 = <&wlan_uart4_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+/*
+ * The BCM4350C5's Bluetooth on UART1, from the ADT uart1/bluetooth node:
+ * power enable on D2255 GPIO 8, BT_WAKE on AP GPIO 71, 3 Mbit/s
+ * transport-speed. The Patchram follows the Wi-Fi module vendor (USI or
+ * Murata) that brcmfmac reads from the OTP.
+ */
+&serial1 {
+	pinctrl-0 = <&bluetooth_uart1_pins>;
+	pinctrl-names = "default";
+	uart-has-rtscts;
+
+	bluetooth: bluetooth {
+		compatible = "apple,n66-bcm4350c5-bt";
+		current-speed = <115200>;
+		max-speed = <3000000>;
+		shutdown-gpios = <&pmu_gpio 8 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&pinctrl_ap 71 GPIO_ACTIVE_HIGH>;
+		apple,wlan = <&wifi0>;
+	};
+};
