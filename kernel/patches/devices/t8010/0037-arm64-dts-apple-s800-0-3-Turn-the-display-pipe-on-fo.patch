@@ -466,19 +464,30 @@
 	status = "okay";
 };
 
-#ifdef S800X_IPAD5_DISPLAY_PIPE
 /*
- * ADT displayport function-lcd_ldo = PMU GPIO 22: the panel supply, off in
- * system sleep as on iOS. Neither it nor the backlight holds up the
- * pipe's probe; the driver looks them up before the first sleep.
+ * The panel link is eDP (ADT displayport): the pipe holds the dp domain and
+ * gets the DisplayPort transmitter's window (0x206700000). ADT displayport
+ * function-lcd_ldo = PMU GPIO 22: the panel supply, off in system sleep as
+ * on iOS. Neither it nor the backlight holds up the pipe's probe; the driver
+ * looks them up before the first sleep.
  */
 &disp0 {
+	reg = <0x2 0x06200000 0x0 0x100000>,
+	      <0x2 0x06400000 0x0 0x8000>,
+	      <0x2 0x06440000 0x0 0x8000>,
+	      <0x2 0x06480000 0x0 0x8000>,
+	      <0x2 0x064c0000 0x0 0x8000>,
+	      <0x2 0x06500000 0x0 0x1c>,
+	      <0x2 0x06304000 0x0 0x4000>,
+	      <0x2 0x06300000 0x0 0x4000>,
+	      <0x2 0x06700000 0x0 0x1000>;
+	reg-names = "adp", "disp-a", "disp-b", "disp-c", "disp-d",
+		    "side", "dart0", "dart1", "dp";
+	power-domains = <&ps_disp0>, <&ps_dp>;
 	apple,lcd-ldo-gpios = <&pmu_gpio 22 GPIO_ACTIVE_HIGH>;
 	backlight = <&dwi_bl>;
 	post-init-providers = <&pmu_gpio>, <&dwi_bl>;
-	status = "okay";
 };
-#endif /* S800X_IPAD5_DISPLAY_PIPE */
 
