From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 24 Nov 2026 00:16:56 +0800
Subject: [PATCH] arm64: dts: apple: t8010: Enable the VXD decoder on every A10
 device

The VXD video decoder is part of the SoC, and every A10 board's Apple
device tree has it, but only the iPad 6 and iPad 7 enabled it. Enable
it in t8010-common.dtsi so the iPhone 7 and 7 Plus get hardware
decoding too; their firmware recipes carry its firmware.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-common.dtsi | 5 +++++
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi  | 4 ----
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8010-common.dtsi b/arch/arm64/boot/dts/apple/t8010-common.dtsi
index ae29a94..3ac069c 100644
--- a/arch/arm64/boot/dts/apple/t8010-common.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-common.dtsi
@@ -67,3 +67,8 @@
 &serial0 {
 	status = "okay";
 };
+
+/* The VXD decoder is part of the SoC: every A10 device has it (ADT vxd). */
+&vxd {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index b963463..5051f0e 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -523,10 +523,6 @@
 	status = "okay";
 };
 
-&vxd {
-	status = "okay";
-};
-
 &wlan_uart2 {
 	pinctrl-0 = <&wlan_uart2_pins>;
 	pinctrl-names = "default";
-- 
