From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:40:11 +0100
Subject: [PATCH] arm64: dts: apple: n66: Add the loudspeaker

The iPhone 6s Plus loudspeaker is a CS35L19 at i2c1 0x40 (ADT
audio-control,cs35l19, reset AP GPIO 70) on the TDM link of pad 2, fed
by MCA2: 8 slots of 16 bits, the speaker in slot 1. Route aud2 to pin2,
describe the amplifier with the 6s Plus's speaker-config and tie both
together in a simple-audio-card, in the file the Samsung (N66) and TSMC
(N66m) models share.

iOS clocks this link from the CS42L71 codec's ASP; without a CS42L71
driver, MCA2 provides the clocks and the codec is left untouched. The
Taptic Engine's CS35L19 (0x41) is not described.

Assisted-by: LLM
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 arch/arm64/boot/dts/apple/s800x-n66.dtsi | 54 ++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s800x-n66.dtsi b/arch/arm64/boot/dts/apple/s800x-n66.dtsi
index 34fc1191c..08a9f59ac 100644
--- a/arch/arm64/boot/dts/apple/s800x-n66.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-n66.dtsi
@@ -18,6 +18,60 @@ &touchscreen {
 	touchscreen-size-y = <1920>;
 };
 
+/ {
+	/*
+	 * The loudspeaker: MCA2 to the CS35L19 at i2c1 0x40 on the TDM link of
+	 * pad 2, speaker in slot 1 of 8 x 16 bit (ADT mca2/audio-speaker). iOS
+	 * clocks this link from the CS42L71 codec, which has no driver yet;
+	 * here MCA2 provides the clocks and the codec's port stays untouched.
+	 */
+	sound-speaker {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "iPhone Speaker";
+		simple-audio-card,format = "dsp_a";
+		simple-audio-card,bitclock-master = <&speaker_cpu>;
+		simple-audio-card,frame-master = <&speaker_cpu>;
+		simple-audio-card,widgets = "Speaker", "Speaker";
+		simple-audio-card,routing = "Speaker", "SPK";
+
+		speaker_cpu: simple-audio-card,cpu {
+			sound-dai = <&mca2>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&speaker_amp>;
+			dai-tdm-slot-num = <8>;
+			dai-tdm-slot-width = <16>;
+			dai-tdm-slot-rx-mask = <0 1 0 0 0 0 0 0>;
+		};
+	};
+};
+
+/* ADT mca2 function-i2s_route: aud2 -> pin2 */
+&mca2 {
+	apple,i2s-switch = <&i2s_switch 2 2>;
+};
+
+&i2c1 {
+	/*
+	 * ADT i2c1/audio-speaker: audio-control,cs35l19 @0x40, reset AP GPIO
+	 * 70 (0x46), interrupt AP GPIO 68 (unused). speaker-config is the
+	 * 6s Plus's 20-byte blob (N66 ADT). The Taptic Engine's CS35L19 (@0x41,
+	 * reset 116) is left alone.
+	 */
+	speaker_amp: amplifier@40 {
+		compatible = "cirrus,cs35l19";
+		reg = <0x40>;
+		reset-gpios = <&pinctrl_ap 70 GPIO_ACTIVE_LOW>;
+		clocks = <&mca2>;
+		clock-names = "mclk";
+		apple,speaker-config = /bits/ 8 <0xaa 0x30 0x02 0x70 0x6a 0x80 0x30
+						 0x1e 0x02 0x04 0x14 0x89 0x8c 0x10
+						 0x73 0x03 0x05 0xd0 0x04 0x40>;
+		#sound-dai-cells = <0>;
+	};
+};
+
 /* ADT charger charge-limits[0] */
 &battery_info {
 	constant-charge-current-max-microamp = <1924000>;
