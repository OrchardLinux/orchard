From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Fri, 13 Nov 2026 05:00:00 +0800
Subject: [PATCH] arm64: dts: apple: ipad6: Add the Smart Cover

The iPad 6 has the iPad 5's Smart Cover hall sensors on the same PMIC
lines: Apple's device tree for both boards names PMIC GPIO 0
"halleffect" and GPIO 10 "halleffect1" (/arm-io/i2c0/pmu event names,
/buttons function-button_halleffect{,1} with the same flags). Describe
them as on the iPad 5: two polled SW_MACHINE_COVER switches,
the two lines taken out of the reserved ranges, and their events 0x30
and 0x3a as wake-only, so that opening the cover wakes the iPad.

Measured on a J71b by reading the PMIC input register (0x186): both
lines read 1 with the cover open and 0 with it closed, so the assumed
active-low polarity is right.

Assisted-by: LLM
---
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index cd4e184..d6ec2b6 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -59,6 +59,42 @@
 		};
 	};
 
+	/*
+	 * Smart Cover hall sensors: PMIC GPIO 0 ("halleffect") and 10
+	 * ("halleffect1") in the ADT /buttons node. Both read low while the
+	 * cover is closed (measured on a J71b). Reported as
+	 * SW_MACHINE_COVER, not as a lid switch, so that closing the cover
+	 * doesn't suspend the system. Each line is its own device, so that
+	 * one the PMIC keeps for itself can't take the other down.
+	 */
+	smart-cover {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+		label = "iPad Smart Cover";
+
+		cover-switch {
+			label = "Smart Cover (PMIC GPIO 0)";
+			gpios = <&pmu_gpio 0 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_MACHINE_COVER>;
+			debounce-interval = <50>;
+		};
+	};
+
+	smart-cover-aux {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+		label = "iPad Smart Cover 2";
+
+		cover-switch {
+			label = "Smart Cover (PMIC GPIO 10)";
+			gpios = <&pmu_gpio 10 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_MACHINE_COVER>;
+			debounce-interval = <50>;
+		};
+	};
+
 	battery_info: battery {
 		compatible = "simple-battery";
 		charge-full-design-microamp-hours = <8827000>;
@@ -136,10 +172,12 @@
 			compatible = "apple,d2365-pmic-gpio";
 			gpio-controller;
 			#gpio-cells = <2>;
-			gpio-reserved-ranges = <0 13>, <15 9>;
+			gpio-reserved-ranges = <1 9>, <11 2>, <15 9>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
 			interrupts-extended = <&pinctrl_ap 38 IRQ_TYPE_LEVEL_LOW>;
+			/* Smart Cover hall sensors (lines 0 and 10): wake only. */
+			apple,wake-events = <0x30 0x3a>;
 		};
 
 		rtc@500 {
-- 
