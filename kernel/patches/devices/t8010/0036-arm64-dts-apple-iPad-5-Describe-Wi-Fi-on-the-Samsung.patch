From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 23 Nov 2026 22:45:00 +0800
Subject: [PATCH] arm64: dts: apple: iPad 5: Describe Wi-Fi on the Samsung
 models too

The Wi-Fi port sat behind S800X_IPAD5_PCIE because only the S8003's
root complex was described. The S8000's is now, and the IPSW device
trees of J71s and J72s have the same Wi-Fi port, reg_on PMU GPIO and
module as J71t and J72t (pci-bridge1, uart2/wlan; feara on the Wi-Fi
models, fearb on the cellular ones). Their firmware recipes already
make the brcmfmac files. Describe Wi-Fi for all four boards.

Only the display pipe, which is described for the S8003 alone, stays
behind a define, now named after it.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s8000-j71s.dts   |  5 +++
 arch/arm64/boot/dts/apple/s8000-j72s.dts   |  5 +++
 arch/arm64/boot/dts/apple/s8003-j71t.dts   |  2 +-
 arch/arm64/boot/dts/apple/s8003-j72t.dts   |  2 +-
 arch/arm64/boot/dts/apple/s800x-ipad5.dtsi | 36 ++++++++++------------
 5 files changed, 29 insertions(+), 21 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s8000-j71s.dts b/arch/arm64/boot/dts/apple/s8000-j71s.dts
index e7dbefd..5e63058 100644
--- a/arch/arm64/boot/dts/apple/s8000-j71s.dts
+++ b/arch/arm64/boot/dts/apple/s8000-j71s.dts
@@ -17,3 +17,8 @@
 &touchscreen {
 	firmware-name = "apple/j71s-fwstart.z2fw";
 };
+
+/* ADT uart2/wlan module-instance */
+&wifi {
+	brcm,board-type = "apple,feara";
+};
diff --git a/arch/arm64/boot/dts/apple/s8000-j72s.dts b/arch/arm64/boot/dts/apple/s8000-j72s.dts
index 5115e29..68041e0 100644
--- a/arch/arm64/boot/dts/apple/s8000-j72s.dts
+++ b/arch/arm64/boot/dts/apple/s8000-j72s.dts
@@ -17,3 +17,8 @@
 &touchscreen {
 	firmware-name = "apple/j72s-fwstart.z2fw";
 };
+
+/* ADT uart2/wlan module-instance */
+&wifi {
+	brcm,board-type = "apple,fearb";
+};
diff --git a/arch/arm64/boot/dts/apple/s8003-j71t.dts b/arch/arm64/boot/dts/apple/s8003-j71t.dts
index 018ad6c..cfcda72 100644
--- a/arch/arm64/boot/dts/apple/s8003-j71t.dts
+++ b/arch/arm64/boot/dts/apple/s8003-j71t.dts
@@ -6,7 +6,7 @@
 
 /dts-v1/;
 
-#define S800X_IPAD5_PCIE
+#define S800X_IPAD5_DISPLAY_PIPE
 
 #include "s8003.dtsi"
 #include "s800x-ipad5.dtsi"
diff --git a/arch/arm64/boot/dts/apple/s8003-j72t.dts b/arch/arm64/boot/dts/apple/s8003-j72t.dts
index a3e0dea..d7421f6 100644
--- a/arch/arm64/boot/dts/apple/s8003-j72t.dts
+++ b/arch/arm64/boot/dts/apple/s8003-j72t.dts
@@ -6,7 +6,7 @@
 
 /dts-v1/;
 
-#define S800X_IPAD5_PCIE
+#define S800X_IPAD5_DISPLAY_PIPE
 
 #include "s8003.dtsi"
 #include "s800x-ipad5.dtsi"
diff --git a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
index 4002f41..65c7f8c 100644
--- a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
@@ -2,10 +2,10 @@
 /*
  * Apple iPad 5 common device tree
  *
- * J71s, J72s, J71t and J72t are wired the same; only J72t's Wi-Fi module
- * differs. Storage and Wi-Fi sit behind the PCIe root complex, which is
- * described for the S8003 only: the S8003 boards define S800X_IPAD5_PCIE
- * before including this file.
+ * J71s, J72s, J71t and J72t are wired the same; only the cellular models'
+ * Wi-Fi module differs. The display pipe is described for the S8003 only:
+ * the S8003 boards define S800X_IPAD5_DISPLAY_PIPE before including this
+ * file.
  *
  * Copyright (c) 2022, Konrad Dybcio <konradybcio@kernel.org>
  */
@@ -393,8 +393,6 @@
 	status = "okay";
 };
 
-#ifdef S800X_IPAD5_PCIE
-
 / {
 	aliases {
 		wifi0 = &wifi;
@@ -411,18 +409,6 @@
 	};
 };
 
-/*
- * ADT displayport function-lcd_ldo = PMU GPIO 22: the panel supply, off in
- * system sleep as on iOS. Neither it nor the backlight holds up the
- * pipe's probe; the driver looks them up before the first sleep.
- */
-&disp0 {
-	apple,lcd-ldo-gpios = <&pmu_gpio 22 GPIO_ACTIVE_HIGH>;
-	backlight = <&dwi_bl>;
-	post-init-providers = <&pmu_gpio>, <&dwi_bl>;
-	status = "okay";
-};
-
 &pcie0 {
 	pinctrl-0 = <&wifi_clkreq_pins>;
 	pinctrl-names = "default";
@@ -480,7 +466,19 @@
 	status = "okay";
 };
 
-#endif /* S800X_IPAD5_PCIE */
+#ifdef S800X_IPAD5_DISPLAY_PIPE
+/*
+ * ADT displayport function-lcd_ldo = PMU GPIO 22: the panel supply, off in
+ * system sleep as on iOS. Neither it nor the backlight holds up the
+ * pipe's probe; the driver looks them up before the first sleep.
+ */
+&disp0 {
+	apple,lcd-ldo-gpios = <&pmu_gpio 22 GPIO_ACTIVE_HIGH>;
+	backlight = <&dwi_bl>;
+	post-init-providers = <&pmu_gpio>, <&dwi_bl>;
+	status = "okay";
+};
+#endif /* S800X_IPAD5_DISPLAY_PIPE */
 
 /*
  * The Lightning charger sets the data role: USB data stays off until the
