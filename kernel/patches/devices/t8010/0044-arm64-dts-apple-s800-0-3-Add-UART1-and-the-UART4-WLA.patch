From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:44:12 +0100
Subject: [PATCH] arm64: dts: apple: s800-0-3: Add UART1 and the UART4 WLAN
 platform control

Every A9 board has UART1: the iPhones' Bluetooth controller sits on it
and the iPads have a debug port there, so enable it. UART4 carries the
ADT's "wlan" node (the Wi-Fi module's platform control,
wlan-pcie-uart,bcm4350) on the A9 iPhones, where the iPad 5 uses UART2;
describe that role disabled, as for UART2, since the iPads' UART4 holds
no Wi-Fi control (only an unused NFC node).

Assisted-by: LLM
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 arch/arm64/boot/dts/apple/s800-0-3.dtsi | 26 +++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index 29f9d1dc3..193ac3871 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -273,6 +273,18 @@ serial0: serial@20a0c0000 {
 			status = "disabled";
 		};
 
+		serial1: serial@20a0c4000 {
+			compatible = "apple,s8000-uart", "apple,t8010-uart", "apple,s5l-uart";
+			reg = <0x2 0x0a0c4000 0x0 0x4000>;
+			reg-io-width = <4>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 193 IRQ_TYPE_LEVEL_HIGH>;
+			/* Use the bootloader-enabled clocks for now. */
+			clocks = <&clkref>, <&clkref>;
+			clock-names = "uart", "clk_uart_baud0";
+			power-domains = <&ps_uart1>;
+		};
+
 		/*
 		 * uart2 carries the ADT's "wlan" node (wlan-pcie-uart,bcm4355):
 		 * the platform-control function of the PCIe Wi-Fi module.
@@ -297,6 +309,20 @@ serial3: serial@20a0cc000 {
 			status = "disabled";
 		};
 
+		/*
+		 * The A9 iPhones put the ADT's "wlan" node (wlan-pcie-uart,
+		 * bcm4350/bcm4345) on uart4 instead. This node is that role,
+		 * not the plain UART, so the boards that have it enable it:
+		 * the iPads have their Wi-Fi control on uart2 and only an
+		 * unused NFC node on uart4.
+		 */
+		wlan_uart4: wlan-platform-control@20a0d0000 {
+			compatible = "apple,t8010-wlan-uart-provider";
+			reg = <0x2 0x0a0d0000 0x0 0x4000>;
+			power-domains = <&ps_uart4>;
+			status = "disabled";
+		};
+
 		serial5: serial@20a0d4000 {
 			compatible = "apple,s8000-uart", "apple,t8010-uart", "apple,s5l-uart";
 			reg = <0x2 0x0a0d4000 0x0 0x4000>;
