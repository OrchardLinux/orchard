From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Sun, 15 Nov 2026 17:33:25 +0800
Subject: [PATCH] arm64: dts: apple: ipad6: Give PMU event 16 to the RTC alarm

The iPad 6 and 7 share the iPad 5's D2365 RTC and charger events.
Move event 16 from the charger to rtc@500 as on the iPad 5.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index 214dfc4..0683877 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -186,6 +186,9 @@
 			reg = <0x500 0x10>;
 			nvmem-cells = <&rtc_offset>;
 			nvmem-cell-names = "rtc_offset";
+			interrupt-parent = <&pmu_gpio>;
+			interrupts = <16 IRQ_TYPE_EDGE_RISING>;
+			wakeup-source;
 		};
 
 		tristar_charger: charger@180 {
@@ -195,11 +198,11 @@
 			interrupt-parent = <&pmu_gpio>;
 			/*
 			 * The PMU line, ADC done, then the events the iPadOS
-			 * charger subscribes to.
+			 * charger subscribes to, except RTC event 16, which
+			 * belongs to the RTC alarm.
 			 */
 			interrupts = <240 IRQ_TYPE_EDGE_RISING>,
 				     <176 IRQ_TYPE_EDGE_RISING>,
-				     <16 IRQ_TYPE_EDGE_RISING>,
 				     <40 IRQ_TYPE_EDGE_RISING>,
 				     <41 IRQ_TYPE_EDGE_RISING>,
 				     <42 IRQ_TYPE_EDGE_RISING>,
