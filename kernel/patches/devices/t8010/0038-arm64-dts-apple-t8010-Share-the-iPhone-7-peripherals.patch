From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 24 Nov 2026 00:16:56 +0800
Subject: [PATCH] arm64: dts: apple: t8010: Share the iPhone 7 peripherals with
 every model

Only the iPhone 7 Plus (D11, D111) described its Wi-Fi, touchscreen,
battery gauge, charger and ambient-light sensor; the iPhone 7 (D10, D101)
had none of them. Apple's iOS 15.8.8 device trees give all four models
the same pins, buses, addresses and power functions for these parts:
spi2 multi-touch (reset 161, interrupt 166, chip select 81), the chestnut
touch rail at i2c0 0x27, the SN2400 charger at i2c1 0x75, the HDQ gauge on
uart5, the light sensor at i2c2 0x29 and the PMU Wi-Fi rail on GPIO 10.
The Wi-Fi sits on PCIe port 3 on the Qualcomm models (D10, D11) and on
port 2 on the Intel models (D101, D111), as on the Plus.

Move these parts to t8010-7.dtsi. Each board keeps what differs: its
Wi-Fi port and module (kristoff, elsa, sven, olaf), its touch firmware
(D10.mtprops profile C1F5D,2 on the iPhone 7) and panel size. The
iPhone 7 lists the iPhone 7 Plus of its baseband family as the fallback
for the touch, gauge and Wi-Fi power drivers. Bluetooth now follows the
Wi-Fi module's vendor on the iPhone 7 too.

Also enable the AOP on all four with Apple's iPhone 7 AOP firmware
(aopfw-t8010aop), for the accelerometer, gyroscope, compass and pressure
sensor; its audio service doesn't exist on the iPhone.

The D11 and D111 trees are unchanged apart from the AOP. Untested on
hardware.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-7.dtsi   | 148 +++++++++++++++++++++++
 arch/arm64/boot/dts/apple/t8010-d10.dts  |  61 ++++++++++
 arch/arm64/boot/dts/apple/t8010-d101.dts |  61 ++++++++++
 arch/arm64/boot/dts/apple/t8010-d11.dts  | 127 ++-----------------
 arch/arm64/boot/dts/apple/t8010-d111.dts | 127 ++-----------------
 5 files changed, 288 insertions(+), 236 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8010-7.dtsi b/arch/arm64/boot/dts/apple/t8010-7.dtsi
index ab47fe1..7373105 100644
--- a/arch/arm64/boot/dts/apple/t8010-7.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-7.dtsi
@@ -132,3 +132,151 @@
 	apple,always-on;
 	apple,manual-pm;
 };
+
+/*
+ * The parts below are the same on all four iPhone 7 models: Apple's device
+ * trees (iOS 15.8.8 DeviceTree.d10ap, d101ap, d11ap, d111ap) give them the
+ * same pins, buses, addresses and power functions. Each board names its own
+ * touch firmware, panel size and Wi-Fi module, and the PCIe port its Wi-Fi
+ * sits on: port 3 on the Qualcomm models (D10, D11), port 2 on the Intel
+ * models (D101, D111), whose port 3 holds the baseband.
+ */
+/ {
+	aliases {
+		touchscreen0 = &touchscreen;
+		wifi0 = &wifi0;
+	};
+
+	battery_info: battery {
+		compatible = "simple-battery";
+		constant-charge-current-max-microamp = <1950000>;
+	};
+
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&pmu_gpio 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		off-on-delay-us = <2500>;
+	};
+};
+
+/*
+ * Apple's iPhone 7 AOP firmware (aopfw-t8010aop) serves the accelerometer,
+ * gyroscope, compass and pressure sensor. Its mount-matrix has not been
+ * measured on a phone yet, so the sensors report in the AOP's own frame.
+ */
+&aop {
+	firmware-name = "apple/aop-t8010.bin", "apple/aop-t8010-ext.bin";
+	status = "okay";
+};
+
+/* No audio service in the iPhone 7 AOP: the microphones are on the codec. */
+&aop_audio {
+	status = "disabled";
+};
+
+&aop_mbox {
+	status = "okay";
+};
+
+&bluetooth {
+	apple,wlan = <&wifi0>;
+};
+
+&i2c0 {
+	status = "okay";
+
+	pmic@27 {
+		compatible = "apple,chestnut-pmic";
+		reg = <0x27>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		touch_hv: regulator-touch-hv {
+			compatible = "apple,chestnut-touch-hv-regulator";
+			regulator-name = "touch-hv";
+		};
+	};
+};
+
+&i2c1 {
+	charger@75 {
+		compatible = "apple,sn2400";
+		reg = <0x75>;
+
+		sn2400_charger: charger {
+			compatible = "apple,sn2400-charger";
+			monitored-battery = <&battery_info>;
+			input-current-limit-microamp = <2000000>;
+			mux-states = <&hdq_mux 0>;
+			mux-state-names = "hdq";
+		};
+
+		hdq_mux: hdq-mux {
+			compatible = "apple,sn2400-hdq-mux";
+			#mux-state-cells = <1>;
+		};
+	};
+};
+
+&i2c2 {
+	status = "okay";
+
+	light-sensor@29 {
+		compatible = "apple,ct821", "amstaos,tsl2581";
+		reg = <0x29>;
+		interrupts-extended = <&pinctrl_ap 141 IRQ_TYPE_LEVEL_LOW>;
+	};
+};
+
+&pinctrl_ap {
+	battery_swi_pins: battery-swi-pins {
+		pinmux = <APPLE_PINMUX(173, 1)>;
+	};
+};
+
+&serial5 {
+	pinctrl-0 = <&battery_swi_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	onewire {
+		compatible = "ti,hdq-uart";
+		mux-states = <&hdq_mux 1>;
+		mux-state-names = "hdq";
+
+		fuel_gauge: fuel-gauge {
+			compatible = "ti,bq27545-hdq";
+			monitored-battery = <&battery_info>;
+		};
+	};
+};
+
+&spi2 {
+	cs-gpios = <&pinctrl_ap 81 GPIO_ACTIVE_LOW>;
+	dmas = <&sio 0x18>;
+	dma-names = "tx";
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		reg = <0>;
+		spi-max-frequency = <3000000>;
+		spi-cpol;
+		spi-cpha;
+		apple,z2-no-init-ack;
+		interrupts-extended = <&pinctrl_ap 166 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&pinctrl_ap 161 GPIO_ACTIVE_LOW>;
+		hv-supply = <&touch_hv>;
+		core-supply = <&touch_core>;
+		clocks = <&touchclk>;
+	};
+};
+
+&sio {
+	status = "okay";
+};
+
+&touchclk {
+	clock-frequency = <32768>;
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-d10.dts b/arch/arm64/boot/dts/apple/t8010-d10.dts
index 39cdd12..b1fc1f2 100644
--- a/arch/arm64/boot/dts/apple/t8010-d10.dts
+++ b/arch/arm64/boot/dts/apple/t8010-d10.dts
@@ -12,3 +12,64 @@
 	compatible = "apple,d10", "apple,t8010", "apple,arm-platform";
 	model = "Apple iPhone 7 (Qualcomm)";
 };
+
+/*
+ * The D10 has the touch controller, battery gauge and Wi-Fi power
+ * sequence of the iPhone 7 Plus with the same baseband (D11), whose driver
+ * entries are the fallback.
+ */
+&fuel_gauge {
+	compatible = "apple,d10-bq27545",
+	             "apple,d11-bq27545",
+	             "ti,bq27545-hdq";
+};
+
+&pcie0 {
+	iommu-map = <0x100 &pcie0_dart0 0 0x0 0x80000000 0x0 0x3c000000 1>,
+		    <0x200 &pcie0_dart3 0 0x0 0x80000000 0x0 0x3ffff000 1>;
+	pinctrl-0 = <&wifi_clkreq>;
+	pinctrl-names = "default";
+
+	pci@3,0 {
+		device_type = "pci";
+		reg = <0x1800 0x0 0x0 0x0 0x0>;
+		bus-range = <2 2>;
+		max-link-speed = <1>;
+		apple,manual-availability-iommu = <&pcie0_dart3 0>;
+		reset-gpios = <&pinctrl_ap 15 GPIO_ACTIVE_LOW>;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi0: wifi@0,0 {
+			compatible = "apple,d10-bcm4355-wifi",
+			             "apple,d11-bcm4355-wifi",
+			             "pci14e4,43dc";
+			reg = <0x20000 0x0 0x0 0x0 0x0>;
+			device-wake-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&wlan_vdd>;
+			apple,antenna-sku = "XX";
+			brcm,board-type = "apple,kristoff";
+			brcm,ccode-map-trivial;
+		};
+	};
+};
+
+&pcie0_dart3 {
+	status = "okay";
+};
+
+&pinctrl_ap {
+	wifi_clkreq: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(19, 1)>;
+	};
+};
+
+&touchscreen {
+	compatible = "apple,d10-touchscreen",
+	             "apple,d11-touchscreen";
+	firmware-name = "apple/dfrmtfw-d10-c1f5d-2.bin";
+	touchscreen-size-x = <750>;
+	touchscreen-size-y = <1334>;
+};
