From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Fri, 13 Nov 2026 07:00:00 +0800
Subject: [PATCH] arm64: dts: apple: ipad7: Use the iPad 6 Lightning port

Apple's device tree of the iPad 7 (J171) has the iPad 6's Lightning
port hardware: the cbtl1610 Tristar at i2c0 0x1a, the same USB complex
and otgphyctrl, the dock accessory power on LDO5 and the k48 charger.
Its Bellatrix (i2c1 orion-ic, 0x13) belongs to dock-orion, the Smart
Connector, not to the Lightning port.

Stop deleting the Tristar, its charger and the USB role switch, and
drop the D2365 charger node that took Bellatrix as its USB power
source: the iPad 7 now identifies its charger (BrickID, BC1.2, an Apple
host's grant) instead of staying at 500 mA, wakes on plug, and gets USB
host through the camera adapter like the iPad 6. The Bellatrix node
stays. Untested on the iPad 7.

Assisted-by: LLM
---
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
index de3f387..0564832 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
@@ -18,22 +18,12 @@
 	firmware-name = "apple/aop-ipad7c.bin", "apple/aop-ipad7c-ext.bin";
 };
 
-/* The iPad 7 port controller is Bellatrix, with its own charger policy. */
-/delete-node/ &tristar_charger;
-/delete-node/ &tristar;
-
-/* Without the Tristar accessory policy the port stays a USB device. */
-&usb_role {
-	/delete-property/ apple,pmic;
-	/delete-property/ apple,tristar;
-	status = "disabled";
-};
-
-&usbdev {
-	/delete-property/ usb-psy-name;
-	/delete-property/ usb-role-switch;
-	/delete-node/ port;
-};
+/*
+ * The Lightning port is the iPad 6's: Apple's device tree has the same
+ * cbtl1610 Tristar at i2c0 0x1a, USB complex, otgphyctrl and dock
+ * accessory power, so the iPad 6 charger and USB role switch apply.
+ * Bellatrix (i2c1 orion-ic) belongs to dock-orion, the Smart Connector.
+ */
 
 &battery_info {
 	charge-full-design-microamp-hours = <8557000>;
@@ -83,6 +73,7 @@
 	sda-gpios = <&pinctrl_ap 39 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
 	status = "okay";
 
+	/* The Smart Connector's controller (dock-orion), not the Lightning port */
 	usb_power: usb-power@13 {
 		compatible = "apple,bellatrix";
 		reg = <0x13>;
@@ -91,17 +82,6 @@
 	};
 };
 
-&d2365_pmic {
-	d2365_charger: charger@180 {
-		compatible = "apple,j172-d2365-charger", "apple,d2365-charger";
-		reg = <0x180 0x1e>, <0xa00 0x0d>;
-		reg-names = "status", "control";
-		interrupt-parent = <&pmu_gpio>;
-		interrupts = <72 IRQ_TYPE_EDGE_RISING>;
-		power-supplies = <&usb_power>;
-	};
-};
-
 &touchscreen {
 	compatible = "apple,j172-touchscreen";
 	spi-max-frequency = <24000000>;
-- 
