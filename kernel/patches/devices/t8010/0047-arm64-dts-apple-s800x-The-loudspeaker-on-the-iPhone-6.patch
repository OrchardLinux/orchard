From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 24 Nov 2026 06:24:02 +0800
Subject: [PATCH] arm64: dts: apple: s800x: The loudspeaker on the iPhone 6s too

The IPSW device trees of the iPhone 6s (N71, N71m) describe the same
loudspeaker as the 6s Plus's (iOS 15.8.8): the CS35L19-family amplifier
at i2c1 0x40 with its reset on AP GPIO 70 and the same speaker-config,
and MCA2 with the same iisConfig, SmartIO channels and aud2-to-pin2
route. Move the speaker to the file both models include.

Take speaker-config from the IPSW device tree: it is the same record in
all four, while the 6s Plus that was tested had one byte (12, register
0x3a) different in its live device tree, which iBoot fills in per unit.
A shared file carries the template, not one unit's value.

MCA2's compatible names the 6s link's setup, which the iPhone SE does
not share (other slots and SmartIO FIFO words in its ADT) and the iPad
5 does not use, so leave MCA2 disabled in s800-0-3.dtsi and enable it
with the route where the link is described. The NCO, SmartIO and I2C1
stay on for every A9 board.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s800-0-3.dtsi  |  8 +--
 arch/arm64/boot/dts/apple/s800x-6s.dtsi  | 62 ++++++++++++++++++++++++
 arch/arm64/boot/dts/apple/s800x-n66.dtsi | 54 ---------------------
 3 files changed, 67 insertions(+), 57 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index 2e9e86d0a..6f3dcf41a 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -273,8 +273,10 @@
 		};
 
 		/*
-		 * ADT /arm-io/mca2: the speaker TDM link of the iPhones (pad 2),
-		 * SmartIO endpoint 0x2c, bitclock from NCO 2.
+		 * ADT /arm-io/mca2: the speaker TDM link of the iPhone 6s and 6s
+		 * Plus (pad 2), SmartIO endpoint 0x2c, bitclock from NCO 2. The
+		 * compatible names that link's setup, so the boards that have
+		 * the link enable it.
 		 */
 		mca2: mca@20a0a8000 {
 			compatible = "apple,s8000-mca-tdm";
@@ -291,7 +293,7 @@
 			#clock-cells = <0>;
 			clock-output-names = "mca2-mclk";
 			#sound-dai-cells = <0>;
-			status = "okay";
+			status = "disabled";
 		};
 
 		serial0: serial@20a0c0000 {
diff --git a/arch/arm64/boot/dts/apple/s800x-6s.dtsi b/arch/arm64/boot/dts/apple/s800x-6s.dtsi
index cba029208..7dba5a1e2 100644
--- a/arch/arm64/boot/dts/apple/s800x-6s.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-6s.dtsi
@@ -164,6 +164,68 @@
 	};
 };
 
+/*
+ * The loudspeaker of the iPhone 6s and 6s Plus: the IPSW device trees of
+ * N66, N66m, N71 and N71m (iOS 15.8.8) describe the same amplifier, link
+ * and route (i2c1/audio-speaker, mca2/audio-speaker). The iPhone SE's
+ * MCA2 link differs (other slots and SmartIO FIFO words).
+ */
+/ {
+	/*
+	 * The loudspeaker: MCA2 to the CS35L19 at i2c1 0x40 on the TDM link of
+	 * pad 2, speaker in slot 1 of 8 x 16 bit (ADT mca2/audio-speaker). iOS
+	 * clocks this link from the CS42L71 codec, which has no driver yet;
+	 * here MCA2 provides the clocks and the codec's port stays untouched.
+	 */
+	sound-speaker {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "iPhone Speaker";
+		simple-audio-card,format = "dsp_a";
+		simple-audio-card,bitclock-master = <&speaker_cpu>;
+		simple-audio-card,frame-master = <&speaker_cpu>;
+		simple-audio-card,widgets = "Speaker", "Speaker";
+		simple-audio-card,routing = "Speaker", "SPK";
+
+		speaker_cpu: simple-audio-card,cpu {
+			sound-dai = <&mca2>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&speaker_amp>;
+			dai-tdm-slot-num = <8>;
+			dai-tdm-slot-width = <16>;
+			dai-tdm-slot-rx-mask = <0 1 0 0 0 0 0 0>;
+		};
+	};
+};
+
+/* ADT mca2 function-i2s_route: aud2 -> pin2 */
+&mca2 {
+	apple,i2s-switch = <&i2s_switch 2 2>;
+	status = "okay";
+};
+
+&i2c1 {
+	/*
+	 * ADT i2c1/audio-speaker: audio-control,cs35l19 @0x40, reset AP GPIO
+	 * 70 (0x46), interrupt AP GPIO 68 (unused). speaker-config is the
+	 * IPSW device tree's 20-byte record, the same in the 6s and 6s Plus
+	 * (iOS 15.8.8); iBoot may adjust it per unit. The Taptic Engine's
+	 * CS35L19 (@0x41, reset 116) is left alone.
+	 */
+	speaker_amp: amplifier@40 {
+		compatible = "cirrus,cs35l19";
+		reg = <0x40>;
+		reset-gpios = <&pinctrl_ap 70 GPIO_ACTIVE_LOW>;
+		clocks = <&mca2>;
+		clock-names = "mclk";
+		apple,speaker-config = /bits/ 8 <0xaa 0x30 0x02 0x70 0x6a 0x80 0x30
+						 0x1e 0x02 0x04 0x14 0x89 0x8a 0x10
+						 0x73 0x03 0x05 0xd0 0x04 0x40>;
+		#sound-dai-cells = <0>;
+	};
+};
+
 &framebuffer0 {
 	power-domains = <&ps_disp0 &ps_mipi_dsi>;
 };
diff --git a/arch/arm64/boot/dts/apple/s800x-n66.dtsi b/arch/arm64/boot/dts/apple/s800x-n66.dtsi
index 4e687fea7..c064335de 100644
--- a/arch/arm64/boot/dts/apple/s800x-n66.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-n66.dtsi
@@ -18,60 +18,6 @@
 	touchscreen-size-y = <1920>;
 };
 
