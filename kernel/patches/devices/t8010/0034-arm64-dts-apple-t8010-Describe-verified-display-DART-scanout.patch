From 6b012d7280861afb8365c708e5992aa1644fe644 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Mon, 16 Nov 2026 19:29:13 +0100
Subject: [PATCH] arm64: dts: apple: t8010: Describe verified display DART
 scanout

Fullscreen imported buffers otherwise require a compositor pass on the
1536x2048 iPad 6 panel. Describe the display DART and SMMU with their ADT
windows, reflector, configuration and fault interrupts, and give disp0 a
deferred-attach scanout master. Reuse the same map-before-attach and mandatory
pipe-CRC gate as S8003; no unchecked T8010 translation path is introduced.

Use the display back-end domain, which keeps its front end powered, because
there is no separate DISP0_DART domain in the current PMGR description.
The ADT's smmu-options=2 and dart-options=5 are noted for hardware testers;
no speculative properties or register writes are added for them.
disp0 is enabled on the iPad 6 and, through the shared iPad 6 include, on
the iPad 7. On the iPad 7 the display driver rejects the boot framebuffer
size at probe, before any DART code runs, so it stays on simpledrm and the
scanout master is never attached there. Translated scanout is untested on
A10 hardware.

Affects: Apple A10 iPad 6 display scanout; the iPad 7 stays on simpledrm.

Assisted-by: LLM
Signed-off-by: Berkay Kösebay <brkosebay@users.noreply.github.com>
Link: https://github.com/OrchardLinux/orchard/pull/231#issuecomment-7138590680
---
 arch/arm64/boot/dts/apple/t8010.dtsi | 30 ++++++++++++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8010.dtsi b/arch/arm64/boot/dts/apple/t8010.dtsi
index 73262df..d4be88a 100644
--- a/arch/arm64/boot/dts/apple/t8010.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010.dtsi
@@ -613,8 +613,8 @@
 
 		/*
 		 * iBoot leaves the eDP link, the panel and the pipe running; the
-		 * driver adopts that mode. The display DART (dart-disp0) is only
-		 * read, to check that the scanout bypasses translation.
+		 * driver adopts that mode. The display DART (dart-disp0) stays
+		 * in bypass until the driver maps and verifies translated scanout.
 		 */
 		disp0: display-controller@206200000 {
 			compatible = "apple,t8010-display-pipe", "apple,s8000-display-pipe";
@@ -631,6 +631,32 @@
 				     <AIC_IRQ 155 IRQ_TYPE_LEVEL_HIGH>;
 			power-domains = <&ps_disp0_fe>, <&ps_disp0_be>, <&ps_dp>;
 			status = "disabled";
+
+			/* Map the live boot framebuffer before enabling translation. */
+			scanout {
+				iommus = <&disp0_dart 0>, <&disp0_dart 1>,
+					 <&disp0_dart 2>, <&disp0_dart 3>;
+				apple,dart-deferred-attach;
+			};
+		};
+
+		/* Disabled until the display driver maps and verifies scanout. */
+		disp0_dart: iommu@206304000 {
+			compatible = "apple,t8010-dart", "apple,s5l8960x-dart";
+			reg = <0x2 0x06304000 0x0 0x4000>,
+			      <0x2 0x06300000 0x0 0x4000>;
+			reg-names = "dart", "smmu";
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 156 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 157 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "dart", "smmu";
+			/* No separate DISP0_DART domain; BE keeps FE powered too. */
+			power-domains = <&ps_disp0_be>;
+			apple,error-reflector = /bits/ 64 <0x20fffc000>;
+			apple,fetch-config = <0x000e0303>;
+			apple,diag-config = <0x00000100>;
+			status = "disabled";
 		};
 
 		pmgr: power-management@20e000000 {
