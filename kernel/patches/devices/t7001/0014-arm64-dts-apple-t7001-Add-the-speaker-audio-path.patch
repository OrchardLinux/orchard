From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:16:24 +0100
Subject: [PATCH] arm64: dts: apple: t7001: Add the speaker audio path

Describe the blocks the iPad Air 2's speakers are played through, all
disabled: the SmartIO DMA coprocessor (AppleA7IOP version 1, endpoints
from Apple's device tree), the i2s-switch, MCA3 (the speaker link, NCO
channel 3, MCLK word at 0x20a00200c) and the NCO with its reference
clock. The NCO reference rate is filled in by iBoot in Apple's device
tree, so the board sets it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 arch/arm64/boot/dts/apple/t7001.dtsi | 61 ++++++++++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7001.dtsi b/arch/arm64/boot/dts/apple/t7001.dtsi
index 892ff78bd..8716534b6 100644
--- a/arch/arm64/boot/dts/apple/t7001.dtsi
+++ b/arch/arm64/boot/dts/apple/t7001.dtsi
@@ -30,6 +30,17 @@ clkref: clock-ref {
 		clock-output-names = "clkref";
 	};
 
+	/*
+	 * The NCO's reference. Its rate is in the clock-frequencies table that
+	 * iBoot fills in (the NCO's first clock-id); the IPSW ADT leaves it 0,
+	 * so each board sets it.
+	 */
+	nco_clkref: clock-ref-nco {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-output-names = "nco_ref";
+	};
+
 	spi3_clk: clock-spi3 {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
@@ -165,6 +176,47 @@ ans_mbox: mbox@208041000 {
 			power-domains = <&ps_ans>;
 		};
 
+		/* ADT i2s-switch,t7001: AppleAE2I2SSwitch3, as on S8000 */
+		i2s_switch: syscon@20a003000 {
+			compatible = "apple,t7001-i2s-switch", "syscon";
+			reg = <0x2 0x0a003000 0x0 0x1000>;
+			status = "disabled";
+		};
+
+		mca3: mca@20a0ac000 {
+			compatible = "apple,t7001-mca";
+			reg = <0x2 0x0a0ac000 0x0 0x4000>,
+			      <0x2 0x0a00200c 0x0 0x4>;
+			reg-names = "mca", "mclk";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 172 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_mca3>;
+			clocks = <&nco 3>;
+			clock-names = "bitclk";
+			dmas = <&sio 0x2e>;
+			dma-names = "tx";
+			#clock-cells = <0>;
+			clock-output-names = "mca3-mclk";
+			#sound-dai-cells = <0>;
+			status = "disabled";
+		};
+
+		sio: dma-controller@20ae00000 {
+			compatible = "apple,t7000-sio";
+			reg = <0x2 0x0ae00000 0x0 0x2000>;
+			reg-names = "a7iop";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 149 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 148 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 151 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 150 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_sio>;
+			firmware-name = "apple/t7000-smartio.bin";
+			dma-channels = <64>;
+			#dma-cells = <1>;
+			status = "disabled";
+		};
+
 		serial0: serial@20a0c0000 {
 			compatible = "apple,s5l-uart";
 			reg = <0x2 0x0a0c0000 0x0 0x4000>;
@@ -341,6 +393,15 @@ pmgr: power-management@20e000000 {
 			reg = <0x2 0xe000000 0 0x24000>;
 		};
 
+		/* Five channels 0x1000 apart; MCA0-4 use 0, 1, 3 and 4 */
+		nco: clock-controller@20e011000 {
+			compatible = "apple,t7001-nco";
+			reg = <0x2 0x0e011000 0x0 0x5000>;
+			clocks = <&nco_clkref>;
+			#clock-cells = <1>;
+			status = "disabled";
+		};
+
 		wdt: watchdog@20e027000 {
 			compatible = "apple,t7000-wdt", "apple,wdt";
 			reg = <0x2 0x0e027000 0x0 0x1000>;
-- 
2.56.0

