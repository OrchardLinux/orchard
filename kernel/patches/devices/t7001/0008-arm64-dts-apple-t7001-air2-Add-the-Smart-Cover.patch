From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Fri, 13 Nov 2026 05:40:00 +0800
Subject: [PATCH] arm64: dts: apple: t7001-air2: Add the Smart Cover

The iPad Air 2 has the iPad Smart Cover's two hall sensors on the PMIC:
Apple's device tree names PMIC GPIO 12 "halleffect" and GPIO 10
"halleffect1" (/arm-io/i2c0/pmu event names; /buttons
function-button_halleffect{,1}). Describe them as on the iPad 5 and 6,
as two polled SW_MACHINE_COVER switches, and take both lines out of the
reserved ranges. The flags match the iPad 6's, where both lines read low
while the cover is closed. Unlike the D2365 boards, opening the cover
does not wake this one from sleep: the D2207 GPIO driver has no event
controller.

Assisted-by: LLM
---
diff --git a/arch/arm64/boot/dts/apple/t7001-air2.dtsi b/arch/arm64/boot/dts/apple/t7001-air2.dtsi
index 64374d9..4deccfa 100644
--- a/arch/arm64/boot/dts/apple/t7001-air2.dtsi
+++ b/arch/arm64/boot/dts/apple/t7001-air2.dtsi
@@ -63,6 +63,42 @@
 		};
 	};
 
+	/*
+	 * Smart Cover hall sensors: PMIC GPIO 12 ("halleffect") and 10
+	 * ("halleffect1") in the ADT /buttons node, with the same flags as on
+	 * the iPad 6, where both read low while the cover is closed. Reported
+	 * as SW_MACHINE_COVER, not as a lid switch, so that closing the cover
+	 * doesn't suspend the system. Each line is its own device, so that
+	 * one the PMIC keeps for itself can't take the other down.
+	 */
+	smart-cover {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+		label = "iPad Smart Cover";
+
+		cover-switch {
+			label = "Smart Cover (PMIC GPIO 12)";
+			gpios = <&pmu_gpio 12 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_MACHINE_COVER>;
+			debounce-interval = <50>;
+		};
+	};
+
+	smart-cover-aux {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+		label = "iPad Smart Cover 2";
+
+		cover-switch {
+			label = "Smart Cover (PMIC GPIO 10)";
+			gpios = <&pmu_gpio 10 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_MACHINE_COVER>;
+			debounce-interval = <50>;
+		};
+	};
+
 	memory@800000000 {
 		device_type = "memory";
 		reg = <0x8 0 0 0>; /* To be filled by loader */
@@ -114,7 +150,8 @@
 			gpio-controller;
 			#gpio-cells = <2>;
 			/* Only Bluetooth (2) and Wi-Fi (3) REG_ON are used; the other lines stay as iBoot left them. */
-			gpio-reserved-ranges = <0 2>, <4 17>;
+			gpio-reserved-ranges = <0 2>, <4 6>, <11 1>, <13 8>;
+			/* Lines 10 and 12 are the Smart Cover hall sensors. */
 		};
 
 		rtc@5c0 {
-- 
2.54.0
