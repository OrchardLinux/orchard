From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shayne Legault <8741557+shaynelegault@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:20:15 -0600
Subject: [PATCH] ARM: dts: apple: Select the P105 H2FMI variant

Put the P105-specific compatible before the S5L8940X fallback on the
flash controller. This selects the match data whose normal-block erase is
qualified only for the measured 64 GB package geometry.

Assisted-by: LLM
---
 arch/arm/boot/dts/apple/s5l8942x-p105.dts | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/apple/s5l8942x-p105.dts b/arch/arm/boot/dts/apple/s5l8942x-p105.dts
index c2de0dfea..5f839703a 100644
--- a/arch/arm/boot/dts/apple/s5l8942x-p105.dts
+++ b/arch/arm/boot/dts/apple/s5l8942x-p105.dts
@@ -695,9 +695,10 @@
 		 * known -- a NAND reset drops the PPN to SDR and only a reboot
 		 * through iBEC gets DDR back.
 		 *
-		 * Read-only.  See docs/research/p105-nand.md. */
+		 * See docs/research/p105-nand.md.
+		 */
 		nand: flash-controller@1200000 {
-			compatible = "apple,s5l8940x-fmi";
+			compatible = "apple,p105ap-fmi", "apple,s5l8940x-fmi";
 			reg = <0x1200000 0x1000>,	/* FMI0 */
 			      <0x1240000 0x1000>,	/* FMC0 */
 			      <0x1280000 0x1000>,	/* ECC0 */
