From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 23 Nov 2026 23:15:47 +0800
Subject: [PATCH] arm64: dts: apple: s5l8960x: Battery gauge on every A7 iPad

The battery gauge was described for the J72 alone. Apple's device trees
put the same gauge on the same line on every A7 iPad: a
gas-gauge,bq27540 under UART5 (0x20a0b4000, irq 145), the HDQ line, on
the J71-J73, J85-J87 and J85m-J87m (iOS 12.5.7 and 12.5.8). Move it to
the iPad Air's and the iPad mini 2's shared files, with the gauge
profile the J72 measured (remaining capacity paired with full charge
capacity).

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi  | 17 +++++++++++++++++
 arch/arm64/boot/dts/apple/s5l8960x-j72.dts    | 12 ------------
 arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi | 17 +++++++++++++++++
 3 files changed, 34 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi b/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
index c41a24d54..90ea90829 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
+++ b/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
@@ -222,3 +222,20 @@ wifi@20c000050 {
 		device-ready-gpios = <&pinctrl 164 GPIO_ACTIVE_HIGH>;
 	};
 };
+
+/*
+ * The battery gauge on UART5's HDQ line: a BQ27540 by Apple's device tree
+ * (/arm-io/uart5/gas-gauge), the same on every A7 iPad. It runs the gauge
+ * firmware profile measured on the J72.
+ */
+&serial5 {
+	status = "okay";
+
+	onewire {
+		compatible = "ti,hdq-uart";
+
+		fuel-gauge {
+			compatible = "apple,j72-bq27545", "ti,bq27545-hdq";
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/s5l8960x-j72.dts b/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
index 7e08e0c99..f168323d7 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
+++ b/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
@@ -61,18 +61,6 @@ &ans {
 	status = "okay";
 };
 
-&serial5 {
-	status = "okay";
-
-	onewire {
-		compatible = "ti,hdq-uart";
-
-		fuel-gauge {
-			compatible = "apple,j72-bq27545", "ti,bq27545-hdq";
-		};
-	};
-};
-
 &touchclk {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi b/arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi
index a6b39550d..0e5d66b90 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi
+++ b/arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi
@@ -178,3 +178,20 @@ wifi@20c000060 {
 		device-ready-gpios = <&pinctrl 164 GPIO_ACTIVE_HIGH>;
 	};
 };
+
+/*
+ * The battery gauge on UART5's HDQ line: a BQ27540 by Apple's device tree
+ * (/arm-io/uart5/gas-gauge), the same on every A7 iPad. It runs the gauge
+ * firmware profile measured on the J72.
+ */
+&serial5 {
+	status = "okay";
+
+	onewire {
+		compatible = "ti,hdq-uart";
+
+		fuel-gauge {
+			compatible = "apple,j72-bq27545", "ti,bq27545-hdq";
+		};
+	};
+};
