From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 20:42:11 +0100
Subject: [PATCH] arm64: dts: apple: s5l8960x-j85: Add the speakers

Enable the speaker path of the iPad mini 2 (Wi-Fi): the two CS35L19
amplifiers on I2C2 (0x40 with its reset on GPIO 114, 0x41) with the ADT
speaker-config records, MCLK from MCA1, and a simple-audio-card "J85
Speakers" with the primary amplifier driving the DSP A frame. SmartIO
and the i2s-switch are already on for every A7 board.

Both speakers play, the left channel on the left speaker, and the card
survives suspend and resume.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/s5l8960x-j85.dts | 53 ++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x-j85.dts b/arch/arm64/boot/dts/apple/s5l8960x-j85.dts
index aefb7b36d..85026519a 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-j85.dts
+++ b/arch/arm64/boot/dts/apple/s5l8960x-j85.dts
@@ -12,3 +12,56 @@ / {
 	compatible = "apple,j85", "apple,s5l8960x", "apple,arm-platform";
 	model = "Apple iPad mini 2 (Wi-Fi)";
 };
+
+/*
+ * Speakers, from the ADT (iOS 12.5.8 16H88): two CS35L19 amplifiers on
+ * I2C2 (audio-speaker0 at 0x40 with its reset on GPIO 114, the secondary
+ * audio-speaker1 at 0x41), fed by MCA1 (aud1 to pin1) over TDM, 8 x 16-bit
+ * slots, amplifier n in slot n. The MCA is a consumer: the primary
+ * amplifier drives the frame from the 12 MHz MCLK of MCA1. SmartIO
+ * endpoint 0x2a carries the samples. The speaker-config records are the
+ * ADT's (identical for both amplifiers). Full scale is bounded to -12 dB
+ * in the MCA; the amplifiers' digital volume starts at 0 dB. iOS feeds
+ * the amplifiers' alive watchdog through the ADT's function-alive, GPIO
+ * 161; the driver keeps the watchdog off instead, so it is not described.
+ */
+&mca1 {
+	status = "okay";
+};
+
+&i2c2 {
+	status = "okay";
+
+	speaker_amps: audio-amplifier@40 {
+		compatible = "cirrus,cs35l19";
+		reg = <0x40>, <0x41>;
+		reg-names = "primary", "secondary";
+		reset-gpios = <&pinctrl 114 GPIO_ACTIVE_LOW>;
+		clocks = <&mca1>;
+		clock-names = "mclk";
+		cirrus,speaker-config = /bits/ 8 <
+			0x49 0x30 0x02 0x70 0x6a 0x80 0x30 0x1e 0x02 0x04
+			0x14 0x89 0x8a 0x10 0x74 0x03 0x05 0x00 0x00 0x40
+			0x49 0x30 0x02 0x70 0x6a 0x80 0x30 0x1e 0x02 0x04
+			0x14 0x89 0x8a 0x10 0x74 0x03 0x05 0x00 0x00 0x40>;
+		#sound-dai-cells = <0>;
+	};
+};
+
+/ {
+	sound-speakers {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "J85 Speakers";
+		simple-audio-card,format = "dsp_a";
+		simple-audio-card,bitclock-master = <&speaker_codec>;
+		simple-audio-card,frame-master = <&speaker_codec>;
+
+		simple-audio-card,cpu {
+			sound-dai = <&mca1>;
+		};
+
+		speaker_codec: simple-audio-card,codec {
+			sound-dai = <&speaker_amps>;
+		};
+	};
+};
