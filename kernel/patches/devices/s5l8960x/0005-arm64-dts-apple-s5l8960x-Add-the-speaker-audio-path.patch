From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
Date: Sat, 7 Nov 2026 17:43:07 +0800
Subject: [PATCH] arm64: dts: apple: s5l8960x: Add the speaker audio path

Describe the A7 blocks the iPad Air's speakers are played through: the
SmartIO DMA coprocessor (AppleA7IOP version 1), the i2s-switch, MCA0
with its MCLK word at 0x20a002000, and SPI3, the codec's control bus.
Registers, interrupts and DMA endpoints are those of Apple's device
tree for the J72 (iOS 12.5.7 16H81); the trees of every A7 iPad (J71,
J73, J85-J87, J85m-J87m, iOS 12.5.8) list the same SmartIO, i2s-switch
and MCA0, with the same i2s_route (aud0 to pin0) for MCA0. SPI3's rate
is filled in by iBoot, so it gets the 60 MHz fixed clock SPI2 uses, the
rate the J72 codec link ran at.

The SmartIO, the i2s-switch and MCA0 are on for every A7 board; their
firmware, the same bytes in every A7 kernelcache, comes from each
board's recipe. SPI3 stays off here: it carries the iPad Air's codec,
but the iPad mini 3's Touch ID sensor, and the iPad mini 2 leaves it
unused.

[Orchard: from thisiscamk/ipad-air-j72-linux eebfca9,
 code/current/audio/audio.dts, moved from his runtime overlay into the
 SoC tree: the SmartIO and SPI3 nodes as he had them, plus
 dma-channels; the i2s-switch as its own syscon node instead of a
 third MCA register window; MCA0 on apple,s5l8960x-mca with its ADT
 interrupt and route.]
Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s5l8960x.dtsi | 66 +++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x.dtsi b/arch/arm64/boot/dts/apple/s5l8960x.dtsi
index fede9a06d..a6c2cc9fa 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x.dtsi
+++ b/arch/arm64/boot/dts/apple/s5l8960x.dtsi
@@ -40,6 +40,17 @@ spi2_clk: clock-spi2 {
 		clock-output-names = "spi2";
 	};
 
+	/*
+	 * SPI3's rate is in the clock table iBoot fills in (clock-id 0x135);
+	 * 60 MHz as for SPI2, the rate the iPad Air's codec link ran at.
+	 */
+	spi3_clk: clock-spi3 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <60000000>;
+		clock-output-names = "spi3";
+	};
+
 	cpus {
 		#address-cells = <2>;
 		#size-cells = <0>;
@@ -114,6 +125,12 @@ ans_mbox: mbox@208041000 {
 			power-domains = <&ps_ans>;
 		};
 
+		/* Apple's i2s-switch,s5l8960x: AppleAE2I2SSwitch3, as on S8000 */
+		i2s_switch: syscon@20a003000 {
+			compatible = "apple,s5l8960x-i2s-switch", "syscon";
+			reg = <0x2 0x0a003000 0x0 0x1000>;
+		};
+
 		spi1: spi@20a084000 {
 			compatible = "apple,s5l8960x-spi";
 			reg = <0x2 0x0a084000 0x0 0x4000>;
@@ -142,6 +159,19 @@ spi2: spi@20a088000 {
 			status = "disabled";
 		};
 
+		/* Pins as the boot loader leaves them */
+		spi3: spi@20a08c000 {
+			compatible = "apple,s5l8960x-spi";
+			reg = <0x2 0x0a08c000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 139 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&spi3_clk>;
+			power-domains = <&ps_spi3>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 		serial0: serial@20a0a0000 {
 			compatible = "apple,s5l-uart";
 			reg = <0x2 0x0a0a0000 0x0 0x4000>;
@@ -168,6 +198,26 @@ serial5: serial@20a0b4000 {
 			status = "disabled";
 		};
 
+		/*
+		 * MCA0: Apple's mca,s5l8960x, mca-version 1. Its i2s_route, aud0 to
+		 * pin0, is the same in the device tree of every A7 iPad.
+		 */
+		mca0: mca@20a0c0000 {
+			compatible = "apple,s5l8960x-mca";
+			reg = <0x2 0x0a0c0000 0x0 0x4000>,
+			      <0x2 0x0a002000 0x0 0x4>;
+			reg-names = "mca", "mclk";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 147 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_mca0>;
+			dmas = <&sio 0x28>;
+			dma-names = "tx";
+			apple,i2s-switch = <&i2s_switch 0 0>;
+			#clock-cells = <0>;
+			clock-output-names = "mca0-mclk";
+			#sound-dai-cells = <0>;
+		};
+
 		i2c0: i2c@20a110000 {
 			compatible = "apple,s5l8960x-i2c", "apple,i2c";
 			reg = <0x2 0x0a110000 0x0 0x1000>;
@@ -234,6 +284,22 @@ touchclk: clock-controller@20a118000 {
 			status = "disabled";
 		};
 
+		/* SmartIO: AppleA7IOP version 1, the DMA engine of the MCAs */
+		sio: dma-controller@20ae00000 {
+			compatible = "apple,s5l8960x-sio";
+			reg = <0x2 0x0ae00000 0x0 0x2000>;
+			reg-names = "a7iop";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 133 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 132 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 135 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 134 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_sio>;
+			firmware-name = "apple/s5l8960x-smartio.bin";
+			dma-channels = <64>;
+			#dma-cells = <1>;
+		};
+
 		bus@20c000000 {
 			compatible = "apple,s5l8960x-usb-complex", "simple-pm-bus";
 			#address-cells = <2>;
