From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Sun, 22 Nov 2026 22:43:55 +0100
Subject: [PATCH] arm64: dts: apple: s5l8960x-j85: Add the touchscreen

From the iPad mini 2's Apple device tree (spi1/multi-touch): an N1
controller on SPI1 with its chip select on GPIO 71, the attention line
on GPIO 15, reset on GPIO 23 and display sync on GPIO 119, the 32,768 Hz
reference from PWM0 and its analog supply and core LDO on the D2089.
The N1 runtime switches only the analog supply, so the core LDO, which
iBoot leaves on, stays on. Chip select returns to a GPIO in the SPI
sleep state. The loader adds the unit's calibration through the
touchscreen0 alias.

On a J85, the controller boots from the J85.mtprops packet at every
boot and reports contacts, in a RAM boot and from an installed system.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/s5l8960x-j85.dts | 62 ++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x-j85.dts b/arch/arm64/boot/dts/apple/s5l8960x-j85.dts
index aefb7b36d..4c12a01a8 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-j85.dts
+++ b/arch/arm64/boot/dts/apple/s5l8960x-j85.dts
@@ -11,4 +11,66 @@
 / {
 	compatible = "apple,j85", "apple,s5l8960x", "apple,arm-platform";
 	model = "Apple iPad mini 2 (Wi-Fi)";
+
+	aliases {
+		touchscreen0 = &touchscreen; /* Used by loader */
+	};
+};
+
+&pinctrl {
+	spi1_sleep_pins: spi1-sleep-pins {
+		pinmux = <APPLE_PINMUX(71, 0)>;
+	};
+
+	touch_sync_active: touch-sync-active-pins {
+		pinmux = <APPLE_PINMUX(119, 1)>;
+	};
+
+	touch_sync_inactive: touch-sync-inactive-pins {
+		pinmux = <APPLE_PINMUX(119, 0)>;
+	};
+};
+
+&{/soc/i2c@20a110000/pmic@3c} {
+	touch_analog: regulator-touch-analog {
+		compatible = "apple,d2089-touch-analog-regulator";
+		regulator-name = "touch-analog";
+	};
+
+	/* The N1 runtime switches only the analog supply; keep the LDO on. */
+	touch_core: regulator-touch-core {
+		compatible = "apple,d2089-touch-core-regulator";
+		regulator-name = "touch-core";
+		regulator-always-on;
+	};
+};
+
+&touchclk {
+	status = "okay";
+};
+
+&spi1 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-1 = <&spi1_sleep_pins>;
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,j85-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <1000000>;
+		interrupt-parent = <&pinctrl>;
+		interrupts = <15 IRQ_TYPE_EDGE_FALLING>;
+		attn-gpios = <&pinctrl 15 GPIO_ACTIVE_LOW>;
+		reset-gpios = <&pinctrl 23 GPIO_ACTIVE_LOW>;
+		clocks = <&touchclk>;
+		ana-supply = <&touch_analog>;
+		pinctrl-names = "display-sync-active", "display-sync-inactive";
+		pinctrl-0 = <&touch_sync_active>;
+		pinctrl-1 = <&touch_sync_inactive>;
+		touchscreen-size-x = <1536>;
+		touchscreen-size-y = <2048>;
+		touchscreen-inverted-y;
+		firmware-name = "apple/j85-fwstart.z2fw";
+		/* apple,z2-cal-blob: the unit's calibration, filled in by the loader */
+	};
 };
