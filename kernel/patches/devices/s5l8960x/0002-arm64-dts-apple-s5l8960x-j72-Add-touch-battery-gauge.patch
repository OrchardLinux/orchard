From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:00:00 +0800
Subject: [PATCH] arm64: dts: apple: s5l8960x-j72: Add touch, battery gauge and
 storage

Wire the iPad Air (Cellular)'s hardware that runs on its A7 blocks:

- the N1 touchscreen on SPI2: attention on GPIO 111, reset on GPIO 15,
  display sync on pin 119, the touch reference clock and the D2089
  analog and core supplies; the chip select returns to a GPIO when the
  controller is unbound. The firmware comes from the firmware recipe
  and the unit's calibration from the loader (touchscreen0 alias);
- the BQ27545 gauge on UART5's HDQ line;
- internal storage: the ANS, with its firmware region filled in by the
  loader and its power domain kept on.

[Orchard: from thisiscamk/ipad-air-j72-linux 2a257d6,
 code/current/kernel/0001-j72-installed-kernel-snapshot.patch
 (arch/arm64/boot/dts/apple/s5l8960x-j72.dts). The separate D2089 bias
 regulator is gone (the analog supply keeps the bias), the gauge uses
 the w1-uart HDQ master with the generic BQ27545 binding instead of his
 ti,bq27540-hdq-uart serdev frontend, and the SoC nodes live in
 s5l8960x.dtsi.]
Assisted-by: LLM
Signed-off-by: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
---
 arch/arm64/boot/dts/apple/s5l8960x-j72.dts | 91 ++++++++++++++++++++++
 1 file changed, 91 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x-j72.dts b/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
index afb71b888..7e08e0c99 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
+++ b/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
@@ -11,4 +11,95 @@
 / {
 	compatible = "apple,j72", "apple,s5l8960x", "apple,arm-platform";
 	model = "Apple iPad Air (Cellular)";
+
+	aliases {
+		touchscreen0 = &touchscreen; /* Used by loader */
+	};
+
+	reserved-memory {
+		ans_firmware: ans-firmware {
+			/* Filled in by the loader. */
+			reg = <0 0 0 0>;
+			no-map;
+		};
+	};
+};
+
+&pinctrl {
+	spi2_sleep_pins: spi2-sleep-pins {
+		pinmux = <APPLE_PINMUX(79, 0)>;
+	};
+
+	touch_sync_active: touch-sync-active-pins {
+		pinmux = <APPLE_PINMUX(119, 1)>;
+	};
+
+	touch_sync_inactive: touch-sync-inactive-pins {
+		pinmux = <APPLE_PINMUX(119, 0)>;
+	};
+};
+
+&{/soc/i2c@20a110000/pmic@3c} {
+	touch_analog: regulator-touch-analog {
+		compatible = "apple,d2089-touch-analog-regulator";
+		regulator-name = "touch-analog";
+	};
+
+	touch_core: regulator-touch-core {
+		compatible = "apple,d2089-touch-core-regulator";
+		regulator-name = "touch-core";
+	};
+};
+
+&ps_ans {
+	apple,always-on;
+};
+
+&ans {
+	memory-region = <&ans_firmware>;
+	memory-region-names = "firmware";
+	status = "okay";
+};
+
+&serial5 {
+	status = "okay";
+
+	onewire {
+		compatible = "ti,hdq-uart";
+
+		fuel-gauge {
+			compatible = "apple,j72-bq27545", "ti,bq27545-hdq";
+		};
+	};
+};
+
+&touchclk {
+	status = "okay";
+};
+
+&spi2 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-1 = <&spi2_sleep_pins>;
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,j72-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <1000000>;
+		interrupt-parent = <&pinctrl>;
+		interrupts = <111 IRQ_TYPE_EDGE_FALLING>;
+		attn-gpios = <&pinctrl 111 GPIO_ACTIVE_LOW>;
+		reset-gpios = <&pinctrl 15 GPIO_ACTIVE_LOW>;
+		clocks = <&touchclk>;
+		ana-supply = <&touch_analog>;
+		core-supply = <&touch_core>;
+		pinctrl-names = "display-sync-active", "display-sync-inactive";
+		pinctrl-0 = <&touch_sync_active>;
+		pinctrl-1 = <&touch_sync_inactive>;
+		touchscreen-size-x = <14621>;
+		touchscreen-size-y = <19539>;
+		touchscreen-inverted-y;
+		firmware-name = "apple/j72-fwstart.z2fw";
+		/* apple,z2-cal-blob: the unit's calibration, filled in by the loader */
+	};
 };
