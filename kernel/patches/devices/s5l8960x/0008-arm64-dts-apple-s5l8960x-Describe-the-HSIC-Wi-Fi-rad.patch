From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 23 Nov 2026 23:15:38 +0800
Subject: [PATCH] arm64: dts: apple: s5l8960x: Describe the HSIC Wi-Fi radio of
 the A7 iPads

Every A7 iPad has a BCM43241 on an HSIC link. Describe where, from
Apple's device trees (/arm-io/usb-complex/usb-ehciN/wlan, iOS 12.5.7 and
12.5.8), so that apple-a7-wlan and brcmfmac find it on each of them:

  iPad Air (J71, J72, J73)          EHCI0 port 3, HSIC PHY at +0x50
                                    (HSIC1_PHY under USB2HOST0), irq 163
  iPad mini 2 and 3 (J85-J87,       EHCI1 port 1, HSIC PHY at +0x60
  J85m-J87m)                        (HSIC2_PHY under USB2HOST1), irq 165

HOST_READY is GPIO 163 and DEVICE_READY GPIO 164 on all nine, and the
reset is the D2089's GPIO3 (the ADT's function-device_reset).

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi  | 21 +++++++++++++++++++
 arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi | 21 +++++++++++++++++++
 2 files changed, 42 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi b/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
index cbbe6ab57..c41a24d54 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
+++ b/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
@@ -201,3 +201,24 @@ usbdev_role: endpoint {
 		};
 	};
 };
+
+/ {
+	/*
+	 * The BCM43241 Wi-Fi radio on HSIC, where the device trees of
+	 * the J71, J72 and J73 put it (/arm-io/usb-complex/usb-ehci0/wlan):
+	 * EHCI0 root port 3, its HSIC PHY at usb-complex +0x50, HOST_READY
+	 * on GPIO 163, DEVICE_READY on GPIO 164 and the reset on the D2089's
+	 * GPIO3. apple-a7-wlan owns it.
+	 */
+	wifi@20c000050 {
+		compatible = "apple,s5l8960x-hsic-wlan";
+		reg = <0x2 0x0c000050 0x0 0x10>, <0x2 0x0c200000 0x0 0x10000>;
+		reg-names = "phy", "ehci";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 163 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_hsic1_phy>;
+		apple,ehci-port = <3>;
+		host-ready-gpios = <&pinctrl 163 GPIO_ACTIVE_HIGH>;
+		device-ready-gpios = <&pinctrl 164 GPIO_ACTIVE_HIGH>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi b/arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi
index 09ebe61e9..a6b39550d 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi
+++ b/arch/arm64/boot/dts/apple/s5l8960x-mini2.dtsi
@@ -157,3 +157,24 @@ usbdev_role: endpoint {
 		};
 	};
 };
+
+/ {
+	/*
+	 * The BCM43241 Wi-Fi radio on HSIC, where the device trees of
+	 * the J85-J87 and J85m-J87m put it (/arm-io/usb-complex/usb-ehci1/wlan):
+	 * EHCI1 root port 1, its HSIC PHY at usb-complex +0x60, HOST_READY
+	 * on GPIO 163, DEVICE_READY on GPIO 164 and the reset on the D2089's
+	 * GPIO3. apple-a7-wlan owns it.
+	 */
+	wifi@20c000060 {
+		compatible = "apple,s5l8960x-hsic-wlan";
+		reg = <0x2 0x0c000060 0x0 0x10>, <0x2 0x0c400000 0x0 0x10000>;
+		reg-names = "phy", "ehci";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 165 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_hsic2_phy>;
+		apple,ehci-port = <1>;
+		host-ready-gpios = <&pinctrl 163 GPIO_ACTIVE_HIGH>;
+		device-ready-gpios = <&pinctrl 164 GPIO_ACTIVE_HIGH>;
+	};
+};
