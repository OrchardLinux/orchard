From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Tue, 24 Nov 2026 16:56:38 +0100
Subject: [PATCH] arm64: dts: apple: s5l8960x: Add the Smart Cover on the iPad
 Air

Apple's device trees of the iPad Air (J71-J73) name D2089 PMIC GPIO 12
"halleffect" and GPIO 10 "halleffect1" (/buttons
function-button_halleffect{,1}), the lines the iPad Air 2 uses. On a J71
line 12 reads low with the cover closed and high with it open. Describe
it as on the Air 2, as a polled SW_MACHINE_COVER switch, active low.

Make the D2089 event controller a GPIO controller for that, with every
line but 10 and 12 reserved: by the same device trees the PMIC's other
lines are Bluetooth power (2), the Wi-Fi reset (3), which apple-a7-wlan
drives itself, the battery gauge (5) and, on the cellular boards, the
baseband (4, 8, 16).

The iPad mini 2 and 3 name the same lines, but on a J85 line 12 reads low
whatever the cover or a magnet does, and 0x63-0x65 of the PMIC never
change; a cover switch there would report a closed cover from boot. They
get no cover until its input is found.

Assisted-by: LLM
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi | 34 ++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi b/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
index a886fba..a908124 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
+++ b/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
@@ -75,6 +75,30 @@
 			linux,code = <KEY_MUTE>;
 		};
 	};
+
+	/*
+	 * Smart Cover hall sensors: D2089 GPIO 12 ("halleffect") and 10
+	 * ("halleffect1") in the ADT /buttons node, the same lines as on the
+	 * iPad Air 2. Line 12 is reported, active low as on the Air 2 and the
+	 * iPad 6: on a J71 it reads low while the cover is closed and high
+	 * while it is open. Reported as SW_MACHINE_COVER, not as a lid
+	 * switch, so that closing the cover doesn't suspend the system.
+	 * Polled: which PMU event a line raises is not established on the
+	 * D2089, so the cover doesn't wake the system.
+	 */
+	smart-cover {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+		label = "iPad Smart Cover";
+
+		cover-switch {
+			label = "Smart Cover (PMIC GPIO 12)";
+			gpios = <&pmu_events 12 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_MACHINE_COVER>;
+			debounce-interval = <50>;
+		};
+	};
 };
 
 &framebuffer0 {
@@ -149,6 +173,16 @@
 		interrupt-controller;
 		#interrupt-cells = <2>;
 		interrupts-extended = <&pinctrl 103 IRQ_TYPE_LEVEL_LOW>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		/*
+		 * Of the 17 lines only the Smart Cover hall sensors, 10 and
+		 * 12, are exposed. The others stay as iBoot left them: the
+		 * Bluetooth power enable (2), the Wi-Fi reset (3, apple-a7-wlan
+		 * owns it), the battery gauge (5) and, on the cellular boards,
+		 * the baseband's (4, 8, 16), by Apple's device trees.
+		 */
+		gpio-reserved-ranges = <0 10>, <11 1>, <13 4>;
 	};
 
 	/*
