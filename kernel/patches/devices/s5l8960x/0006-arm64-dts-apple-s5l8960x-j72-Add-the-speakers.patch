From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
Date: Sat, 7 Nov 2026 17:43:07 +0800
Subject: [PATCH] arm64: dts: apple: s5l8960x-j72: Add the speakers

Enable the iPad Air's speaker path: the CS42L81 codec on SPI3 (chip
select GPIO 99, speaker mute GPIO 94, as in Apple's
/arm-io/spi3/audio-codec), clocked from MCA0's MCLK, and MCA0 routed
to the codec's pad (aud0 to pin0, the ADT's i2s_route). A
simple-audio-card, "J72 Speakers", joins them with the codec as the
I2S clock provider, as on the iPad 5. The speaker gain is capped at
-3 dB, the SPI clock at 100 kHz, the values both speakers played at on
a J72. Headphones and microphones are not described yet.

[Orchard: from thisiscamk/ipad-air-j72-linux eebfca9,
 code/current/audio/audio.dts, moved from his runtime overlay into the
 board tree; the card is named "J72 Speakers" instead of "J72 Audio
 Test" and gets the iPad 5 card's speaker widget and pin switch.]
Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s5l8960x-j72.dts | 57 ++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x-j72.dts b/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
index 7e08e0c99..cd88b7643 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
+++ b/arch/arm64/boot/dts/apple/s5l8960x-j72.dts
@@ -16,6 +16,31 @@
 		touchscreen0 = &touchscreen; /* Used by loader */
 	};
 
+	/*
+	 * The speakers: the CS42L81 on SPI3 (control) and MCA0 (data), as in
+	 * Apple's /arm-io/spi3/audio-codec and /arm-io/mca0/audio-codec. The
+	 * codec drives both speakers as one stereo pair. Headphones and
+	 * microphones are not described yet.
+	 */
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "J72 Speakers";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&codec_dai>;
+		simple-audio-card,frame-master = <&codec_dai>;
+		simple-audio-card,widgets = "Speaker", "Speakers";
+		simple-audio-card,routing = "Speakers", "SPKOUT";
+		simple-audio-card,pin-switches = "Speakers";
+
+		simple-audio-card,cpu {
+			sound-dai = <&mca0>;
+		};
+
+		codec_dai: simple-audio-card,codec {
+			sound-dai = <&cs42l81>;
+		};
+	};
+
 	reserved-memory {
 		ans_firmware: ans-firmware {
 			/* Filled in by the loader. */
@@ -73,6 +98,38 @@
 	};
 };
 
+&i2s_switch {
+	status = "okay";
+};
+
+/* ADT function-i2s_route: aud0 to pin0 */
+&mca0 {
+	apple,i2s-switch = <&i2s_switch 0 0>;
+	status = "okay";
+};
+
+&sio {
+	status = "okay";
+};
+
+&spi3 {
+	/* ADT function-spi_cs0 */
+	cs-gpios = <&pinctrl 99 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	cs42l81: audio-codec@0 {
+		compatible = "cirrus,cs42l81";
+		reg = <0>;
+		spi-max-frequency = <100000>;
+		clocks = <&mca0>;
+		clock-names = "mclk";
+		/* ADT function-spkr_mute */
+		mute-gpios = <&pinctrl 94 GPIO_ACTIVE_LOW>;
+		cirrus,speaker-max-gain = <(-300)>;
+		#sound-dai-cells = <0>;
+	};
+};
+
 &touchclk {
 	status = "okay";
 };
