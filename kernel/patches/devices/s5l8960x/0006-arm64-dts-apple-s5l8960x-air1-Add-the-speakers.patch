From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
Date: Sat, 7 Nov 2026 17:43:07 +0800
Subject: [PATCH] arm64: dts: apple: s5l8960x-air1: Add the speakers

Enable the iPad Air's speaker path: the CS42L81 codec on SPI3 (chip
select GPIO 99, speaker mute GPIO 94, as in Apple's
/arm-io/spi3/audio-codec), clocked from MCA0's MCLK, which the SoC tree
routes to the codec's pad. A simple-audio-card, "iPad Air Speakers",
joins them with the codec as the I2S clock provider, as on the iPad 5.
The speaker gain is capped at -3 dB, the SPI clock at 100 kHz, the
values both speakers played at on a J72. Headphones and microphones are
not described yet.

The J71, J72 and J73 device trees (iOS 12.5.7 and 12.5.8) describe the
same codec on the same pins, so the speakers are in the iPad Air's
shared file. The iPad mini 2 and 3 play their speakers through two
CS35L19 amplifiers on I2C2 and MCA1 instead, which have no driver.

[Orchard: from thisiscamk/ipad-air-j72-linux eebfca9,
 code/current/audio/audio.dts, moved from his runtime overlay into the
 iPad Air tree; the card is named "iPad Air Speakers" instead of "J72
 Audio Test" and gets the iPad 5 card's speaker widget and pin switch.]
Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi | 44 ++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi b/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
index 26b646f9d..5e465a16a 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
+++ b/arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi
@@ -14,6 +14,32 @@
 / {
 	chassis-type = "tablet";
 
+	/*
+	 * The speakers: the CS42L81 on SPI3 (control) and MCA0 (data), as in
+	 * Apple's /arm-io/spi3/audio-codec and /arm-io/mca0/audio-codec, the
+	 * same in the J71, J72 and J73 trees. The codec drives both speakers
+	 * as one stereo pair. Headphones and microphones are not described
+	 * yet.
+	 */
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "iPad Air Speakers";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&codec_dai>;
+		simple-audio-card,frame-master = <&codec_dai>;
+		simple-audio-card,widgets = "Speaker", "Speakers";
+		simple-audio-card,routing = "Speakers", "SPKOUT";
+		simple-audio-card,pin-switches = "Speakers";
+
+		simple-audio-card,cpu {
+			sound-dai = <&mca0>;
+		};
+
+		codec_dai: simple-audio-card,codec {
+			sound-dai = <&cs42l81>;
+		};
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -92,3 +118,21 @@ rtc_offset: rtc-offset@4 {
 		};
 	};
 };
+
+&spi3 {
+	/* ADT function-spi_cs0 */
+	cs-gpios = <&pinctrl 99 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	cs42l81: audio-codec@0 {
+		compatible = "cirrus,cs42l81";
+		reg = <0>;
+		spi-max-frequency = <100000>;
+		clocks = <&mca0>;
+		clock-names = "mclk";
+		/* ADT function-spkr_mute */
+		mute-gpios = <&pinctrl 94 GPIO_ACTIVE_LOW>;
+		cirrus,speaker-max-gain = <(-300)>;
+		#sound-dai-cells = <0>;
+	};
+};
