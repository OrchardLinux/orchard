From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 20:41:57 +0100
Subject: [PATCH] arm64: dts: apple: s5l8960x: Add MCA1

Describe the A7's MCA1, disabled, as the J85's device tree has it (iOS
12.5.8 16H88): registers at 0x20a0c4000, its MCLK word at 0x20a002004,
AIC 148, SmartIO endpoint 0x2a for TX and the i2s-switch route aud1 to
pin1. It is the iPad mini 2's speaker link (apple,s5l8960x-mca-tdm).

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/s5l8960x.dtsi | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s5l8960x.dtsi b/arch/arm64/boot/dts/apple/s5l8960x.dtsi
index a6c2cc9fa..616ce06a0 100644
--- a/arch/arm64/boot/dts/apple/s5l8960x.dtsi
+++ b/arch/arm64/boot/dts/apple/s5l8960x.dtsi
@@ -218,6 +218,28 @@ mca0: mca@20a0c0000 {
 			#sound-dai-cells = <0>;
 		};
 
+		/*
+		 * MCA1: Apple's mca,s5l8960x, mca-version 1, the speaker link of
+		 * the iPad mini 2 (J85 ADT, iOS 12.5.8: aud1 to pin1, SmartIO
+		 * 0x2a TX, its MCLK word at 0x20a002004).
+		 */
+		mca1: mca@20a0c4000 {
+			compatible = "apple,s5l8960x-mca-tdm";
+			reg = <0x2 0x0a0c4000 0x0 0x4000>,
+			      <0x2 0x0a002004 0x0 0x4>;
+			reg-names = "mca", "mclk";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 148 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_mca1>;
+			dmas = <&sio 0x2a>;
+			dma-names = "tx";
+			apple,i2s-switch = <&i2s_switch 1 1>;
+			#clock-cells = <0>;
+			clock-output-names = "mca1-mclk";
+			#sound-dai-cells = <0>;
+			status = "disabled";
+		};
+
 		i2c0: i2c@20a110000 {
 			compatible = "apple,s5l8960x-i2c", "apple,i2c";
 			reg = <0x2 0x0a110000 0x0 0x1000>;
