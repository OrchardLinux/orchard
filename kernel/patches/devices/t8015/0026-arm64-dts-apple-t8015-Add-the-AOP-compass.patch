From 42fc74d022ab0c58a0445a04f840a43663646a0e Mon Sep 17 00:00:00 2001
From: Dugs <dugahol@protonmail.com>
Date: Fri, 27 Nov 2026 00:05:39 +1030
Subject: [PATCH] arm64: dts: apple: t8015: Add the AOP compass

The A11's AOP serves its magnetometer as the compass service. Its
factory calibration puts the field on the device's axes, so the node
needs no mount matrix.

Assisted-by: LLM
Signed-off-by: Dugs <dugahol@protonmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8015.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8015.dtsi b/arch/arm64/boot/dts/apple/t8015.dtsi
index 0bfb33c..99c596d 100644
--- a/arch/arm64/boot/dts/apple/t8015.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015.dtsi
@@ -718,6 +718,16 @@
 			aop_pressure: pressure {
 				compatible = "apple,t8010-aop-pressure";
 			};
+
+			/*
+			 * The A11's own magnetometer service (an Alps HSCDTD601A).
+			 * Its factory sensitivity matrix, which m1n1 copies from the
+			 * ADT, also turns the chip's axes onto the device's, so it
+			 * needs no mount matrix.
+			 */
+			aop_compass: compass {
+				compatible = "apple,t8015-aop-compass";
+			};
 		};
 
 		aop_mbox: mbox@234808000 {
-- 
2.55.0

