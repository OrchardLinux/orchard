From 9b4669788554291caefdf7829b69faad28feb1f2 Mon Sep 17 00:00:00 2001
From: Dugs <dugahol@protonmail.com>
Date: Thu, 26 Nov 2026 20:57:15 +1030
Subject: [PATCH 6/6] arm64: dts: apple: t8015-8plus: Add the Touch ID sensor

Add spi3, the Touch ID sensor's bus, to the T8015, and on the iPhone 8
Plus describe the sensor and the two SMC-switched supplies it runs from.
The sensor needs SPI mode 2; Apple's device tree runs it at 8 MHz, but
only 1 and 4 MHz have been tested.

Assisted-by: LLM
Signed-off-by: Dugs <dugahol@protonmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8015-8plus.dtsi | 28 ++++++++++++++++++++++
 arch/arm64/boot/dts/apple/t8015.dtsi       | 12 ++++++++++
 2 files changed, 40 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8015-8plus.dtsi b/arch/arm64/boot/dts/apple/t8015-8plus.dtsi
index ea291a9..6a8e76a 100644
--- a/arch/arm64/boot/dts/apple/t8015-8plus.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015-8plus.dtsi
@@ -7,3 +7,31 @@
 
 /* The 8 Plus has minor differences like 1 more camera, 1 GiB of RAM more and a bigger display. */
 #include "t8015-8.dtsi"
+
+&smc {
+	smc_regulators: regulators {
+		compatible = "apple,t8015-smc-regulator";
+
+		mesa_1v8: mesa-1v8 {
+			regulator-name = "mesa-1v8";
+		};
+
+		mesa_3v0: mesa-3v0 {
+			regulator-name = "mesa-3v0";
+		};
+	};
+};
+
+&spi3 {
+	status = "okay";
+
+	/* Touch ID sensor: SPI mode 2 (clock idles high, sample on the first edge) */
+	touch-id@0 {
+		compatible = "apple,mesa";
+		reg = <0>;
+		spi-max-frequency = <4000000>;
+		spi-cpol;
+		vdd18-supply = <&mesa_1v8>;
+		vdd30-supply = <&mesa_3v0>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8015.dtsi b/arch/arm64/boot/dts/apple/t8015.dtsi
index 861e59a..2720b8d 100644
--- a/arch/arm64/boot/dts/apple/t8015.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015.dtsi
@@ -335,6 +335,18 @@
 			status = "disabled";
 		};
 
+		spi3: spi@22e40c000 {
+			compatible = "apple,t8015-spi", "apple,t8010-spi", "apple,spi";
+			reg = <0x2 0x2e40c000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 294 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkref>;
+			power-domains = <&ps_spi3>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 		serial0: serial@22e600000 {
 			compatible = "apple,s5l-uart";
 			reg = <0x2 0x2e600000 0x0 0x4000>;
-- 
2.55.0

