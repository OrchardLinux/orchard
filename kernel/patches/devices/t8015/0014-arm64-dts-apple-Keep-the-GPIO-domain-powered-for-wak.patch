+++ b/arch/arm64/boot/dts/apple/s5l8960x-pmgr.dtsi
@@ -100,6 +100,8 @@ ps_gpio: power-controller@20040 {
 		#power-domain-cells = <0>;
 		#reset-cells = <0>;
 		label = "gpio";
+		apple,always-on; /* Button and PMU wake IRQs over s2idle */
+		apple,manual-pm;
 	};
 
