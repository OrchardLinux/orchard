 arch/arm64/boot/dts/apple/t7000-bcm4345.dtsi | 80 +++++++++++++++++
 arch/arm64/boot/dts/apple/t7000-common.dtsi  | 15 ++++
 arch/arm64/boot/dts/apple/t7000-n102.dts     | 94 ++------------------
 arch/arm64/boot/dts/apple/t7000-n56.dts      | 10 +++
 arch/arm64/boot/dts/apple/t7000-n61.dts      | 10 +++
 6 files changed, 133 insertions(+), 85 deletions(-)
