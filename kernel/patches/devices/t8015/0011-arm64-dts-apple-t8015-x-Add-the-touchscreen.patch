From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Martins <eduardo@martins.ws>
Date: Thu, 5 Nov 2026 13:17:34 -0600
Subject: [PATCH] arm64: dts: apple: t8015-x: Add the touchscreen

From the iPhone X ADT: the Acorn display PMU at 0x2a on i2c3 supplies
the touch controller, which sits on spi1 with chip select GPIO 0x8a,
its interrupt on AOP GPIO 21 (active low) and its reset on GPIO 0x21.
The touch clock runs at 24 MHz. The touchscreen0 alias lets m1n1 copy
the unit's calibrations from the ADT.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8015-x.dtsi | 40 ++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8015-x.dtsi b/arch/arm64/boot/dts/apple/t8015-x.dtsi
index 21abe9e45..d83b51c8a 100644
--- a/arch/arm64/boot/dts/apple/t8015-x.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015-x.dtsi
@@ -10,6 +10,11 @@
 
 / {
 	chassis-type = "handset";
+
+	/* m1n1 copies the ADT's touch calibrations to this node. */
+	aliases {
+		touchscreen0 = &touchscreen;
+	};
 };
 
 &apcie {
@@ -37,3 +42,38 @@ wifi_clkreq: wifi-clkreq-pins {
 		pinmux = <APPLE_PINMUX(163, 1)>;
 	};
 };
+
+&i2c3 {
+	status = "okay";
+
+	pmic@2a {
+		compatible = "apple,acorn-pmic";
+		reg = <0x2a>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		touch_ana: regulator-touch-analog {
+			compatible = "apple,acorn-touch-analog-regulator";
+			regulator-name = "touch-analog";
+		};
+	};
+};
+
+/* The touch controller ("hid-transport,k1"), chip select GPIO 0x8a. */
+&spi1 {
+	cs-gpios = <&pinctrl_ap 138 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,d221-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <4000000>;
+		interrupts-extended = <&pinctrl_aop 21 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&pinctrl_ap 33 GPIO_ACTIVE_LOW>;
+		ana-supply = <&touch_ana>;
+		clocks = <&touchclk>;
+		firmware-name = "apple/d221-touch.bin";
+		touchscreen-size-x = <1125>;
+		touchscreen-size-y = <2436>;
+	};
+};
