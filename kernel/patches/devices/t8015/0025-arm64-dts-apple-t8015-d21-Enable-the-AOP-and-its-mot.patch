From f381574c55109ed4e8a521054ca40dd648500451 Mon Sep 17 00:00:00 2001
From: Dugs <dugahol@protonmail.com>
Date: Thu, 26 Nov 2026 22:48:54 +1030
Subject: [PATCH 4/4] arm64: dts: apple: t8015-d21: Enable the AOP and its
 motion sensors

Start the AOP with the IPSW's firmware and give the accelerometer and
gyroscope their mount matrices, measured on the phone.

Tested on an iPhone 8 Plus (D21): the accelerometer, gyroscope and
barometer bind with the unit's factory calibration, and iio-sensor-proxy
reports face-up, face-down, normal, right-up, left-up and bottom-up
correctly.

Assisted-by: LLM
Signed-off-by: Dugs <dugahol@protonmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8015-d21.dts | 35 +++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8015-d21.dts b/arch/arm64/boot/dts/apple/t8015-d21.dts
index e83c2d3..4e95d1d 100644
--- a/arch/arm64/boot/dts/apple/t8015-d21.dts
+++ b/arch/arm64/boot/dts/apple/t8015-d21.dts
@@ -69,3 +69,38 @@
 &touchclk {
 	clock-frequency = <32768>;
 };
+
+/ {
+	aliases {
+		aop = &aop; /* m1n1 passes the AOP its boot arguments and calibration */
+	};
+};
+
+/* The AOP firmware comes from the IPSW (Firmware/AOP/aopfw-iphone10aop). */
+&aop {
+	firmware-name = "apple/aop-t8015.bin", "apple/aop-t8015-ext.bin";
+	status = "okay";
+};
+
+&aop_mbox {
+	status = "okay";
+};
+
+/*
+ * Measured on an iPhone 8 Plus: the accelerometer reports gravity on the
+ * device's axes (x right, y up, z out of the screen), as on the iPad 5 and
+ * the A9 iPhones: upright y = -1 g, flat screen up z = -1 g. iio-sensor-proxy
+ * takes upright as negative y and needs z flipped. The gyroscope turns
+ * positive about z when the phone spins anticlockwise screen up.
+ */
+&aop_accel {
+	mount-matrix = "1", "0", "0",
+		       "0", "1", "0",
+		       "0", "0", "-1";
+};
+
+&aop_gyro {
+	mount-matrix = "1", "0", "0",
+		       "0", "1", "0",
+		       "0", "0", "1";
+};
