From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Martins <eduardo@martins.ws>
Date: Thu, 5 Nov 2026 14:30:52 -0600
Subject: [PATCH] arm64: dts: apple: t8015: Add the iPhone X OLED brightness

The A11's DSI host is at 0x218400000 (ADT mipi-dsim). The iPhone X ADT's
backlight node gives DBVMin 139, DBVMax 2047 and a boot level of 740.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8015-x.dtsi | 8 ++++++++
 arch/arm64/boot/dts/apple/t8015.dtsi   | 7 +++++++
 2 files changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8015-x.dtsi b/arch/arm64/boot/dts/apple/t8015-x.dtsi
index d83b51c8a..55efb1f74 100644
--- a/arch/arm64/boot/dts/apple/t8015-x.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015-x.dtsi
@@ -77,3 +77,11 @@ touchscreen: touchscreen@0 {
 		touchscreen-size-y = <2436>;
 	};
 };
+
+/* The OLED panel's brightness, from the ADT's backlight node. */
+&dsi_bl {
+	max-brightness = <2047>;
+	apple,min-dbv = <139>;
+	default-brightness-level = <740>;
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8015.dtsi b/arch/arm64/boot/dts/apple/t8015.dtsi
index cacf7e0c7..58850628a 100644
--- a/arch/arm64/boot/dts/apple/t8015.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015.dtsi
@@ -431,6 +431,13 @@ pmgr: power-management@232000000 {
 			reg = <0x2 0x32000000 0 0x8c000>;
 		};
 
+		dsi_bl: backlight@218400000 {
+			compatible = "apple,t8015-dsi-bl", "apple,dsi-bl";
+			reg = <0x2 0x18400000 0x0 0x100>;
+			power-domains = <&ps_mipi_dsi>;
+			status = "disabled";
+		};
+
 		dwi_bl: backlight@232200080 {
 			compatible = "apple,t8015-dwi-bl", "apple,dwi-bl";
 			reg = <0x2 0x32200080 0x0 0x8>;
