From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dugs <dugahol@protonmail.com>
Date: Mon, 23 Nov 2026 19:58:03 +0800
Subject: [PATCH] arm64: dts: apple: t8015-d21: Add the touchscreen

The iPhone 8 Plus touch controller on spi1 with the values of the
contributor's working D21 device trees (iPhOmarchy dtb/d21-boot-wifi.dts
and diamond/payload/README-irqlevel.md): 3 MHz, CPOL/CPHA, no init ack,
interrupt GPIO 102 level-low, reset GPIO 33, chip select GPIO 138, the
chestnut touch-HV switch (i2c0 0x27) as hv-supply, the touch clock, and
1080x1920. The rBK3 core rail is not a supply: the driver switches it
through the SMC. The touchscreen0 alias lets m1n1 copy the ADT's touch
calibration into the node, which the driver requires at probe.

The firmware name is the C1F5E,4 container, the personality whose boot
sequence the JADE insmod line repeats (10003058=6, 10003458=1).

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8015-d21.dts | 48 +++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8015-d21.dts b/arch/arm64/boot/dts/apple/t8015-d21.dts
index a902ba7f1..12d0e1477 100644
--- a/arch/arm64/boot/dts/apple/t8015-d21.dts
+++ b/arch/arm64/boot/dts/apple/t8015-d21.dts
@@ -11,4 +11,52 @@
 / {
 	compatible = "apple,d21", "apple,t8015", "apple,arm-platform";
 	model = "Apple iPhone 8 Plus (Global)";
+
+	/* m1n1 copies the ADT's touch calibrations to this node. */
+	aliases {
+		touchscreen0 = &touchscreen;
+	};
+};
+
+/* The display PMIC, ADT "display-pmu,chestnut". */
+&i2c0 {
+	status = "okay";
+
+	pmic@27 {
+		compatible = "apple,chestnut-pmic";
+		reg = <0x27>;
+
+		/* ADT multi-touch function-power_ana = dpLE(0x302) */
+		touch_hv: regulator-touch-hv {
+			compatible = "apple,chestnut-touch-hv-regulator";
+		};
+	};
+};
+
+/*
+ * The touch controller (ADT "hid-transport,k1"), chip select GPIO 138.
+ * The core rail (ADT function-power_ldo = pKW4('rBK3', 0x5020000)) is
+ * switched by the driver through the SMC, so it is not a supply here.
+ * The line is level-low in hardware; the driver sets that type anyway,
+ * and declaring it keeps a module reload from a type mismatch.
+ */
+&spi1 {
+	cs-gpios = <&pinctrl_ap 138 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,d21-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <3000000>;
+		spi-cpol;
+		spi-cpha;
+		apple,z2-no-init-ack;
+		interrupts-extended = <&pinctrl_ap 102 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&pinctrl_ap 33 GPIO_ACTIVE_LOW>;
+		hv-supply = <&touch_hv>;
+		clocks = <&touchclk>;
+		firmware-name = "apple/dfrmtfw-d21-c1f5e-4.bin";
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <1920>;
+	};
 };
