From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Sat, 7 Nov 2026 18:33:29 +0800
Subject: [PATCH] block/partitions: Add the Apple LwVM partition table

Older iOS releases partition the flash of iPhones and iPads with the
Lightweight Volume Manager (LwVM). Read its header, fall back to the copy
at the end of the first chunk when the CRC does not match, and add every
partition whose chunks are stored in order and back to back. Scattered
partitions cannot be one block range and are skipped with a message.

Partitions keep their LwVM index as their number, and their UUID and name
become PARTUUID and PARTNAME, so a root on LwVM can be named on the
command line like any other partition.

The format follows Shayne Legault's LwVM reader in Orchard
(shaynelegault/orchard#94, boot/lwvm/lwvm.c and src/orchard/lwvm.py).

Assisted-by: LLM
---
 block/partitions/Kconfig  |   8 ++
 block/partitions/Makefile |   1 +
 block/partitions/check.h  |   1 +
 block/partitions/core.c   |   3 +
 block/partitions/lwvm.c   | 197 ++++++++++++++++++++++++++++++++++++++
 5 files changed, 210 insertions(+)
 create mode 100644 block/partitions/lwvm.c

diff --git a/block/partitions/Kconfig b/block/partitions/Kconfig
index 7aff4eb81c60..95a7f2625759 100644
--- a/block/partitions/Kconfig
+++ b/block/partitions/Kconfig
@@ -255,6 +255,14 @@ config EFI_PARTITION
 	  Say Y here if you would like to use hard disks under Linux which
 	  were partitioned using EFI GPT.
 
+config LWVM_PARTITION
+	bool "Apple LwVM partition support" if PARTITION_ADVANCED
+	select CRC32
+	help
+	  Say Y here to read the Lightweight Volume Manager (LwVM) partition
+	  table that older iOS releases use on the flash of iPhones and iPads.
+	  Partitions whose chunks are not stored contiguously are skipped.
+
 config SYSV68_PARTITION
 	bool "SYSV68 partition table support" if PARTITION_ADVANCED
 	default y if VME
diff --git a/block/partitions/Makefile b/block/partitions/Makefile
index a7f05cdb02a8..cdc7348b1b98 100644
