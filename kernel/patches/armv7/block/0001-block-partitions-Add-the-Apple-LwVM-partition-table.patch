--- a/block/partitions/core.c
+++ b/block/partitions/core.c
@@ -52,6 +52,9 @@ static int (*const check_part[])(struct parsed_partitions *) = {
 #ifdef CONFIG_LDM_PARTITION
 	ldm_partition,		/* this must come before msdos */
