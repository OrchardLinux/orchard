From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shayne <8741557+shaynelegault@users.noreply.github.com>
Date: Wed, 18 Nov 2026 21:58:40 -0600
Subject: [PATCH] mtd: apple-h2fmi: Verify normal-view block erase before reuse

Add a provider erase operation for a single bus, CAU and physical block. Check the queue and operation status, then read all 128 physical pages and their OOB before returning success. Stop the bus on ambiguous completion. Exclude bootstrap blocks and keep the P105 match data disabled pending hardware qualification.

Assisted-by: LLM
Signed-off-by: Shayne Legault <8741557+shaynelegault@users.noreply.github.com>
Link: https://github.com/OrchardLinux/orchard/pull/226#issuecomment-7133476475
---
 drivers/mtd/devices/mtd-apple-h2fmi-test.c |  43 ++++++++
 drivers/mtd/devices/mtd-apple-h2fmi.c      | 108 ++++++++++++++++++---
 drivers/mtd/devices/mtd-apple-h2fmi.h      |  21 ++++
 include/linux/mtd/apple-ppn.h              |   7 ++
 4 files changed, 166 insertions(+), 13 deletions(-)

diff --git a/drivers/mtd/devices/mtd-apple-h2fmi-test.c b/drivers/mtd/devices/mtd-apple-h2fmi-test.c
index 419c04cc8..b22c500e3 100644
--- a/drivers/mtd/devices/mtd-apple-h2fmi-test.c
+++ b/drivers/mtd/devices/mtd-apple-h2fmi-test.c
@@ -101,6 +101,30 @@ static void h2fmi_row_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, row, 0xc27ffU);
 }
 
+static void h2fmi_erase_row_test(struct kunit *test)
+{
+	u8 params[H2FMI_PARAMS_SIZE];
+	struct h2fmi_geometry g;
+	u32 row = 0xdeadbeef;
+
+	h2fmi_test_params(params, ppn_16gb);
+	KUNIT_ASSERT_EQ(test, h2fmi_parse_geometry(params, sizeof(params), &g), 0);
+	KUNIT_EXPECT_EQ(test, h2fmi_erase_row(&g, 0, 1, &row), -EOPNOTSUPP);
+	h2fmi_test_params(params, ppn_64gb);
+	KUNIT_ASSERT_EQ(test, h2fmi_parse_geometry(params, sizeof(params), &g), 0);
+	KUNIT_EXPECT_EQ(test, h2fmi_erase_row(&g, 8, 1, &row), -EINVAL);
+	KUNIT_EXPECT_EQ(test, h2fmi_erase_row(&g, 0, 2088, &row), -EINVAL);
+	KUNIT_EXPECT_EQ(test, h2fmi_erase_row(&g, 0, 0, &row), -EPERM);
+	KUNIT_EXPECT_EQ(test, h2fmi_erase_row(&g, 7, 2056, &row), -EPERM);
+	KUNIT_EXPECT_EQ(test, h2fmi_erase_row(&g, 7, 2086, &row), -EPERM);
+	KUNIT_EXPECT_EQ(test, h2fmi_erase_row(&g, 7, 2087, &row), -EPERM);
+	KUNIT_EXPECT_EQ(test, row, 0xdeadbeefU);
+	KUNIT_ASSERT_EQ(test, h2fmi_erase_row(&g, 0, 2048, &row), 0);
+	KUNIT_EXPECT_EQ(test, row, 0x40000U);
+	KUNIT_ASSERT_EQ(test, h2fmi_erase_row(&g, 1, 1, &row), 0);
+	KUNIT_EXPECT_EQ(test, row, 0x80080U);
+}
+
 static void h2fmi_slc_row_test(struct kunit *test)
 {
 	u8 params[H2FMI_PARAMS_SIZE];
@@ -137,6 +161,23 @@ static void h2fmi_slc_row_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, h2fmi_slc_row(&g, 0, 0, 128, &row), -EINVAL);
 }
 
+static void h2fmi_raw_page_erased_test(struct kunit *test)
+{
+	u8 *raw = kunit_kmalloc(test, H2FMI_PAGE_RAW, GFP_KERNEL);
+	unsigned int status;
+
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	memset(raw, 0xff, H2FMI_PAGE_RAW);
+	for (status = 0; status <= 0xff; status++)
+		KUNIT_EXPECT_EQ(test, h2fmi_raw_page_erased(status, raw),
+				status == PPN_ST_ERASED);
+	raw[H2FMI_CHUNK_LO] = 0xfe;
+	KUNIT_EXPECT_FALSE(test, h2fmi_raw_page_erased(PPN_ST_ERASED, raw));
+	raw[H2FMI_CHUNK_LO] = 0xff;
+	raw[H2FMI_PAGE_RAW - 1] = 0x7f;
+	KUNIT_EXPECT_FALSE(test, h2fmi_raw_page_erased(PPN_ST_ERASED, raw));
+}
+
 static void h2fmi_status_test(struct kunit *test)
 {
 	unsigned int status;
@@ -170,6 +211,8 @@ static struct kunit_case h2fmi_test_cases[] = {
 	KUNIT_CASE(h2fmi_geometry_test),
 	KUNIT_CASE(h2fmi_invalid_geometry_test),
 	KUNIT_CASE(h2fmi_row_test),
+	KUNIT_CASE(h2fmi_erase_row_test),
+	KUNIT_CASE(h2fmi_raw_page_erased_test),
 	KUNIT_CASE(h2fmi_status_test),
 	KUNIT_CASE(h2fmi_slc_row_test),
 	KUNIT_CASE(h2fmi_program_status_test),
diff --git a/drivers/mtd/devices/mtd-apple-h2fmi.c b/drivers/mtd/devices/mtd-apple-h2fmi.c
index 46a6bc603..661bd0d1f 100644
--- a/drivers/mtd/devices/mtd-apple-h2fmi.c
+++ b/drivers/mtd/devices/mtd-apple-h2fmi.c
@@ -22,8 +22,8 @@
  * CAU. Raw MTD offsets are independent of the iOS logical block addresses.
  *
  * Pages are read and programmed whole, data and metadata together.  The
- * driver has no erase: a page is only programmed when it reads back erased,
- * and every program is read back and compared before it is reported done.
+ * raw MTD devices provide no erase. A page is only programmed when it
+ * reads back erased, and every program is read back and compared.
  * Logical-address translation and allocation belong to the FTL above.
  */
 
@@ -38,6 +38,7 @@
 #include <linux/mtd/mtd.h>
 #include <linux/mutex.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/slab.h>
 
 #include "mtd-apple-h2fmi.h"
@@ -73,7 +74,7 @@
 #define FMC_STATUS_MASK		0x4c
 
 /* Every command sequence the driver issues.  A sequence that is not listed
- * does not run; in particular there is no erase. */
+ * does not run. Only the single-row final erase command is needed. */
 static const u8 h2fmi_ops[][2] = {
 	{ 0x70, 0x00 },		/* read status */
 	{ 0x92, 0x97 },		/* PPN device parameters */
@@ -83,7 +84,8 @@ static const u8 h2fmi_ops[][2] = {
 	{ 0x0a, 0x37 },		/* PPN page read */
 	{ 0x8a, 0x00 },		/* PPN program, address phase */
 	{ 0x17, 0x00 },		/* PPN program confirm */
-	{ 0x79, 0x00 },		/* PPN program status */
+	{ 0x79, 0x00 },		/* PPN mutation status */
+	{ 0x6a, 0xd7 },		/* PPN erase, one normal row */
 };
 
 struct h2fmi_bus {
@@ -102,6 +104,10 @@ struct h2fmi_die {
 	u8 cau;
 };
 
+struct h2fmi_variant {
+	bool normal_erase_qualified;
+};
+
 struct h2fmi {
 	struct device *dev;
 	struct h2fmi_bus bus[H2FMI_BUSES];
@@ -109,6 +115,7 @@ struct h2fmi {
 	struct h2fmi_die *die;
 	unsigned int ndies;
 	struct platform_device *sftl;
+	struct apple_ppn_ops ppn_ops;
 };
 
 /*
@@ -418,7 +425,7 @@ static int h2fmi_data_in(struct h2fmi *fmi, struct h2fmi_bus *b,
 	return 0;
 }
 
-/* Program status uses 79, as in iBEC's write_bootpage path. */
+/* Both page programming and the iBEC erase queue use status command 79. */
 static int h2fmi_write_status(struct h2fmi *fmi, struct h2fmi_bus *b, u8 *status)
 {
 	int ret = h2fmi_cmd1(fmi, b, 0x79);
@@ -508,8 +515,7 @@ static int h2fmi_program_page(struct h2fmi *fmi, struct h2fmi_bus *b,
 				     b->page, H2FMI_PAGE_RAW, &status);
 	if (ret)
 		goto out;
-	if (status != PPN_ST_ERASED ||
-	    memchr_inv(b->page, 0xff, H2FMI_PAGE_RAW)) {
+	if (!h2fmi_raw_page_erased(status, b->page)) {
 		ret = -EEXIST;
 		goto out;
 	}
@@ -647,17 +653,84 @@ static int h2fmi_ppn_program(void *priv, unsigned int bus, unsigned int cau,
 	return h2fmi_program_page(fmi, &fmi->bus[bus], cau, block, page, data, oob);
 }
 
-static const struct apple_ppn_ops h2fmi_ppn_ops = {
-	.read_page = h2fmi_ppn_read,
-	.program_page = h2fmi_ppn_program,
-};
+/*
+ * The single-row iBEC erase queue sends 6A/D7, checks queue status (79)
+ * and operation status (77/7D), then ends the operation (77). Do not
+ * retry an uncertain erase. The caller holds the bus lock through readback.
+ */
+static int h2fmi_erase_transaction(struct h2fmi *fmi, struct h2fmi_bus *b, u32 row)
+{
+	u32 on, if_ctrl;
+	u8 queued = 0, completed = 0;
+	int ret;
+
+	if (b->failed)
+		return -EIO;
+	on = readl(b->fmc + FMC_ON);
+	if_ctrl = readl(b->fmc + FMC_IF_CTRL);
+	if (on != 5)
+		return -EIO;
+
+	writel(1u << H2FMI_CE, b->fmc + FMC_CE_CTRL);
+	h2fmi_clear_irqs(b);
+	ret = h2fmi_cmd_addr_cmd(fmi, b, 0x6a, 0xd7, row, 4);
+	if (!ret)
+		ret = h2fmi_write_status(fmi, b, &queued);
+	if (!ret)
+		ret = h2fmi_status(fmi, b, &completed);
+	if (!ret)
+		ret = h2fmi_cmd1(fmi, b, 0x77);
+	writel(0, b->fmc + FMC_CE_CTRL);
+	h2fmi_device_reset(b, on, if_ctrl);
+	if (!ret && (queued != PPN_ST_GOOD || completed != PPN_ST_GOOD)) {
+		dev_err(fmi->dev, "PPN erase row %08x: queue %02x, completion %02x\n",
+			row, queued, completed);
+		ret = -EIO;
+	}
+	return ret;
+}
+
+static int h2fmi_ppn_erase(void *priv, unsigned int bus, unsigned int cau,
+			   unsigned int block)
+{
+	struct h2fmi *fmi = priv;
+	struct h2fmi_bus *b;
+	unsigned int page;
+	u32 row;
+	u8 status;
+	int ret;
+
+	if (bus >= H2FMI_BUSES)
+		return -EINVAL;
+	b = &fmi->bus[bus];
+	ret = h2fmi_erase_row(&b->geometry, cau, block, &row);
+	if (ret)
+		return ret;
+
+	mutex_lock(&b->lock);
+	ret = h2fmi_erase_transaction(fmi, b, row);
+	for (page = 0; !ret && page < b->geometry.pages; page++) {
+		ret = h2fmi_read_transaction(fmi, b, 0x0a, 0x37, row + page, 4,
+					     b->page, H2FMI_PAGE_RAW, &status);
+		if (!ret && !h2fmi_raw_page_erased(status, b->page)) {
+			dev_err(fmi->dev, "PPN erase readback row %08x: status %02x\n",
+				row + page, status);
+			ret = -EIO;
+		}
+	}
+	if (ret)
+		b->failed = true;
+	mutex_unlock(&b->lock);
+	return ret;
+}
 
 static int h2fmi_register_sftl(struct h2fmi *fmi)
 {
+	const struct h2fmi_variant *variant = device_get_match_data(fmi->dev);
 	const struct h2fmi_geometry *g = &fmi->bus[0].geometry;
 	struct apple_ppn provider = {
 		.dev = fmi->dev,
-		.ops = &h2fmi_ppn_ops,
+		.ops = &fmi->ppn_ops,
 		.priv = fmi,
 		.buses = H2FMI_BUSES,
 		.caus = g->caus,
@@ -669,6 +742,10 @@ static int h2fmi_register_sftl(struct h2fmi *fmi)
 	if (!IS_ENABLED(CONFIG_MTD_APPLE_SFTL) || g->caus != 8 ||
 	    g->blocks != 2088 || g->pages != 128 || g->slc_pages != 64)
 		return 0;
+	fmi->ppn_ops.read_page = h2fmi_ppn_read;
+	fmi->ppn_ops.program_page = h2fmi_ppn_program;
+	if (variant && variant->normal_erase_qualified)
+		fmi->ppn_ops.erase_block = h2fmi_ppn_erase;
 	fmi->sftl = platform_device_register_data(fmi->dev, "apple-sftl",
 						 PLATFORM_DEVID_AUTO,
 						 &provider, sizeof(provider));
@@ -947,8 +1024,13 @@ static void h2fmi_remove(struct platform_device *pdev)
 		mtd_device_unregister(&fmi->mtd[i]);
 }
 
+/* Normal/SLC aliasing and the physical erase extent remain unqualified. */
+static const struct h2fmi_variant s5l8940x_ppn = {
+	.normal_erase_qualified = false,
+};
+
 static const struct of_device_id h2fmi_of_match[] = {
-	{ .compatible = "apple,s5l8940x-fmi" },
+	{ .compatible = "apple,s5l8940x-fmi", .data = &s5l8940x_ppn },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, h2fmi_of_match);
diff --git a/drivers/mtd/devices/mtd-apple-h2fmi.h b/drivers/mtd/devices/mtd-apple-h2fmi.h
index aeb812f33..1ebcade9d 100644
--- a/drivers/mtd/devices/mtd-apple-h2fmi.h
+++ b/drivers/mtd/devices/mtd-apple-h2fmi.h
@@ -86,6 +86,22 @@ static inline int h2fmi_page_row(const struct h2fmi_geometry *g,
 	return 0;
 }
 
+/* The single-row erase trace is available only for the 64 GB package. */
+static inline int h2fmi_erase_row(const struct h2fmi_geometry *g,
+				 unsigned int cau, unsigned int block, u32 *row)
+{
+	if (g->caus != 8 || g->blocks != 2088 || g->pages != 128 ||
+	    g->slc_pages != 64 || g->page_bits != 7 ||
+	    g->block_bits != 12 || g->cau_bits != 3)
+		return -EOPNOTSUPP;
+	if (cau >= g->caus || block >= g->blocks)
+		return -EINVAL;
+	/* SLC-view bootstrap members may occupy any of the last 32 blocks. */
+	if (!block || block >= g->blocks - 32)
+		return -EPERM;
+	return h2fmi_page_row(g, cau, block, 0, row);
+}
+
 /* The VFL bootstrap's packed requests set the bit above the CAU field.
  * Keep this view separate from normal MTD offsets. Its address encoding
  * follows the saved firmware; live context selection is a separate step.
@@ -120,6 +136,11 @@ static inline int h2fmi_page_status(u8 status)
 	}
 }
 
+static inline bool h2fmi_raw_page_erased(u8 status, const u8 *raw)
+{
+	return status == PPN_ST_ERASED && !memchr_inv(raw, 0xff, H2FMI_PAGE_RAW);
+}
+
 /* CMD 79 reports ready at bit 6 and program failure at bits 0 and 4. */
 static inline int h2fmi_program_status(u8 status)
 {
diff --git a/include/linux/mtd/apple-ppn.h b/include/linux/mtd/apple-ppn.h
index 73fba467d..04b4b935a 100644
--- a/include/linux/mtd/apple-ppn.h
+++ b/include/linux/mtd/apple-ppn.h
@@ -18,6 +18,13 @@ struct apple_ppn_ops {
 	int (*read_page)(void *priv, unsigned int bus, unsigned int cau,
 			 unsigned int block, unsigned int page, bool context,
 			 u8 *data, u8 *oob, u8 *status);
+	/* Optional. Caller owns the complete physical erase extent in all views.
+	 * Success means one normal-view CAU/block was erased and every byte
+	 * of data and OOB read back blank. On failure the extent may have
+	 * changed and must not be returned to the allocator.
+	 */
+	int (*erase_block)(void *priv, unsigned int bus, unsigned int cau,
+			   unsigned int block);
 };
 
 struct apple_ppn {
