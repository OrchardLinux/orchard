 drivers/mtd/apple-sftl-provider-test.c | 143 +++++++++++++++++
 drivers/mtd/apple-sftl-provider.c      | 204 +++++++++++++++++++++++++
 drivers/mtd/apple-sftl-provider.h      |  49 ++++++
 4 files changed, 398 insertions(+), 2 deletions(-)
 create mode 100644 drivers/mtd/apple-sftl-provider-test.c
 create mode 100644 drivers/mtd/apple-sftl-provider.c
 create mode 100644 drivers/mtd/apple-sftl-provider.h

