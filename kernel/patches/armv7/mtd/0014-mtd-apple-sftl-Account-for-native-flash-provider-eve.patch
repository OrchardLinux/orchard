diff --git a/drivers/mtd/apple-sftl-provider-test.c b/drivers/mtd/apple-sftl-provider-test.c
new file mode 100644
index 000000000..a033aacdb
--- /dev/null
+++ b/drivers/mtd/apple-sftl-provider-test.c
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "apple-sftl-provider.h"
+
+struct provider_fixture {
+	struct apple_sftl_provider_stats stats;
+	u8 vfl[88];
+	u8 lower[464];
+	u8 output[464];
+};
+
+static struct provider_fixture *provider_fixture(struct kunit *test)
+{
+	return kunit_kzalloc(test, sizeof(struct provider_fixture), GFP_KERNEL);
+}
+
+static void provider_tlv_snapshot(struct kunit *test)
+{
+	struct provider_fixture *f = provider_fixture(test);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_read_stats(&f->stats, 254, f->output, 464),
+			-ENODATA);
+	memset(f->vfl, 0xa5, sizeof(f->vfl));
+	memset(f->lower, 0x5a, sizeof(f->lower));
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_seed(&f->stats, f->vfl, 88, f->lower, 464), 0);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_read_stats(&f->stats, 255, f->output, 88), 88);
+	KUNIT_EXPECT_MEMEQ(test, f->output, f->vfl, 88);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_read_stats(&f->stats, 254, f->output, 464), 464);
+	KUNIT_EXPECT_MEMEQ(test, f->output, f->lower, 464);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_read_stats(&f->stats, 254, f->output, 88),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_read_stats(&f->stats, 252, f->output, 464),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_submit(&f->stats, 99, 1), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_read_stats(&f->stats, 254, f->output, 464),
+			-ENODATA);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_seed(&f->stats, f->vfl, 88, f->lower, 464), 0);
+	apple_sftl_provider_lost(&f->stats);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_vfl(&f->stats, APPLE_SFTL_VFL_PROGRAM, 4),
+			-ENODATA);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_seed(&f->stats, f->vfl, 88, f->lower, 463),
+			-EINVAL);
+}
+
+static void provider_vfl_counts(struct kunit *test)
+{
+	struct provider_fixture *f = provider_fixture(test);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	put_unaligned_le64(0xfffffffffffffffcULL, f->vfl);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_seed(&f->stats, f->vfl, 88, f->lower, 464), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_vfl(&f->stats, APPLE_SFTL_VFL_PROGRAM, 8), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_vfl(&f->stats, APPLE_SFTL_VFL_READ, 19), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_vfl(&f->stats, APPLE_SFTL_VFL_ERASE, 0), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_vfl(&f->stats, APPLE_SFTL_VFL_SCATTER_BEGIN, 0), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_vfl(&f->stats, APPLE_SFTL_VFL_SCATTER_ADD, 0), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_vfl(&f->stats, APPLE_SFTL_VFL_SCATTER_ADD, 0), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_vfl(&f->stats, APPLE_SFTL_VFL_SCATTER_FLUSH, 13), 0);
+	put_unaligned_le64(4, f->vfl);
+	put_unaligned_le64(32, f->vfl + 8);
+	put_unaligned_le64(1, f->vfl + 16);
+	put_unaligned_le64(1, f->vfl + 24);
+	put_unaligned_le64(1, f->vfl + 40);
+	put_unaligned_le64(2, f->vfl + 48);
+	put_unaligned_le64(1, f->vfl + 56);
+	put_unaligned_le64(1, f->vfl + 64);
+	put_unaligned_le64(1, f->vfl + 72);
+	KUNIT_EXPECT_MEMEQ(test, f->stats.vfl, f->vfl, sizeof(f->vfl));
+	KUNIT_EXPECT_MEMEQ(test, f->stats.lower, f->lower, sizeof(f->lower));
+}
+
+static void provider_lower_results(struct kunit *test)
+{
+	const u8 flags[] = { 0, 0x1f, 1, 0x10 };
+	struct provider_fixture *f = provider_fixture(test);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	put_unaligned_le64(0xffffffffULL, f->lower + 8);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_seed(&f->stats, f->vfl, 88, f->lower, 464), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_submit(&f->stats, APPLE_SFTL_LOWER_READ, 4), 0);
+	put_unaligned_le64(0x100000003ULL, f->lower + 8);
+	KUNIT_EXPECT_MEMEQ(test, f->stats.lower, f->lower, sizeof(f->lower));
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_complete(&f->stats, APPLE_SFTL_LOWER_READ,
+							   0x40, NULL, 4), 0);
+	KUNIT_EXPECT_MEMEQ(test, f->stats.lower, f->lower, sizeof(f->lower));
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_complete(&f->stats, APPLE_SFTL_LOWER_READ,
+							   0, flags, ARRAY_SIZE(flags)), 0);
+	put_unaligned_le64(1, f->lower + 120);
+	put_unaligned_le64(1, f->lower + 128);
+	put_unaligned_le64(2, f->lower + 136);
+	put_unaligned_le64(1, f->lower + 448);
+	put_unaligned_le64(1, f->lower + 456);
+	KUNIT_EXPECT_MEMEQ(test, f->stats.lower, f->lower, sizeof(f->lower));
+
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_submit(&f->stats, APPLE_SFTL_LOWER_PROGRAM, 4), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_complete(&f->stats, APPLE_SFTL_LOWER_PROGRAM,
+							   0, flags, ARRAY_SIZE(flags)), 0);
+	put_unaligned_le64(4, f->lower);
+	put_unaligned_le64(2, f->lower + 144);
+	put_unaligned_le64(2, f->lower + 152);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_submit(&f->stats, APPLE_SFTL_LOWER_ERASE, 4), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_complete(&f->stats, APPLE_SFTL_LOWER_ERASE,
+							   0, flags, ARRAY_SIZE(flags)), 0);
+	put_unaligned_le64(4, f->lower + 16);
+	put_unaligned_le64(2, f->lower + 160);
+	put_unaligned_le64(2, f->lower + 168);
+	KUNIT_EXPECT_MEMEQ(test, f->stats.lower, f->lower, sizeof(f->lower));
+
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_submit(&f->stats, APPLE_SFTL_LOWER_SINGLE_ERASE, 1), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_single_erase_done(&f->stats, true), 0);
+	KUNIT_ASSERT_EQ(test, apple_sftl_provider_submit(&f->stats, APPLE_SFTL_LOWER_SYNC, 1), 0);
+	put_unaligned_le64(5, f->lower + 16);
+	put_unaligned_le64(1, f->lower + 24);
+	put_unaligned_le64(1, f->lower + 104);
+	put_unaligned_le64(3, f->lower + 168);
+	KUNIT_EXPECT_MEMEQ(test, f->stats.lower, f->lower, sizeof(f->lower));
+	KUNIT_EXPECT_MEMEQ(test, f->stats.vfl, f->vfl, sizeof(f->vfl));
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_complete(&f->stats, APPLE_SFTL_LOWER_ERASE, 0,
+							   NULL, 4), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, apple_sftl_provider_read_stats(&f->stats, 254, f->output, 464),
+			-ENODATA);
+}
+
+static struct kunit_case provider_cases[] = {
+	KUNIT_CASE(provider_tlv_snapshot),
+	KUNIT_CASE(provider_vfl_counts),
+	KUNIT_CASE(provider_lower_results),
+	{}
+};
+
+static struct kunit_suite provider_suite = {
+	.name = "apple-sftl-provider",
+	.test_cases = provider_cases,
+};
+kunit_test_suite(provider_suite);
+MODULE_LICENSE("GPL");
diff --git a/drivers/mtd/apple-sftl-provider.c b/drivers/mtd/apple-sftl-provider.c
new file mode 100644
index 000000000..5fcb0eae1
--- /dev/null
+++ b/drivers/mtd/apple-sftl-provider.c
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Replay the native 13G36 provider accounting from an observed checkpoint. */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "apple-sftl-provider.h"
+
+static void add_count(u8 *record, size_t offset, u32 count)
+{
+	u8 *field = record + offset;
+
+	put_unaligned_le64(get_unaligned_le64(field) + count, field);
+}
+
+void apple_sftl_provider_lost(struct apple_sftl_provider_stats *stats)
+{
+	stats->valid = false;
+}
+EXPORT_SYMBOL_GPL(apple_sftl_provider_lost);
+
+static int unknown_event(struct apple_sftl_provider_stats *stats)
+{
+	apple_sftl_provider_lost(stats);
+	return -EOPNOTSUPP;
+}
+
+int apple_sftl_provider_seed(struct apple_sftl_provider_stats *stats, const u8 *vfl,
+			     size_t vfl_bytes, const u8 *lower, size_t lower_bytes)
+{
+	if (!vfl || !lower || vfl_bytes != sizeof(stats->vfl) ||
+	    lower_bytes != sizeof(stats->lower)) {
+		apple_sftl_provider_lost(stats);
+		return -EINVAL;
+	}
+	memcpy(stats->vfl, vfl, vfl_bytes);
+	memcpy(stats->lower, lower, lower_bytes);
+	stats->valid = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_sftl_provider_seed);
+
+/* The argument is the number of logical 4 KiB chunks in a native program,
+ * contiguous read or scatter flush. The other events count one call.
+ * Scatter flush receives the group's actual sum of 16-bit element widths.
+ */
+int apple_sftl_provider_vfl(struct apple_sftl_provider_stats *stats,
+			    enum apple_sftl_vfl_event event, u32 chunks)
+{
+	u32 calls;
+
+	if (!stats->valid)
+		return -ENODATA;
+
+	switch (event) {
+	case APPLE_SFTL_VFL_PROGRAM:
+		if (!chunks || chunks % 4)
+			return unknown_event(stats);
+		add_count(stats->vfl, 0, chunks);
+		calls = 64;
+		break;
+	case APPLE_SFTL_VFL_READ:
+		add_count(stats->vfl, 8, chunks);
+		calls = 24;
+		break;
+	case APPLE_SFTL_VFL_SCATTER_FLUSH:
+		add_count(stats->vfl, 8, chunks);
+		calls = 56;
+		break;
+	case APPLE_SFTL_VFL_ERASE:
+		if (chunks)
+			return unknown_event(stats);
+		add_count(stats->vfl, 16, 1);
+		calls = 72;
+		break;
+	case APPLE_SFTL_VFL_SCATTER_BEGIN:
+	case APPLE_SFTL_VFL_SCATTER_ADD:
+		if (chunks)
+			return unknown_event(stats);
+		calls = event == APPLE_SFTL_VFL_SCATTER_BEGIN ? 40 : 48;
+		break;
+	default:
+		return unknown_event(stats);
+	}
+	add_count(stats->vfl, calls, 1);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_sftl_provider_vfl);
+
+/* Batch dispatch (0x8108b278) charges rows before entering the physical
+ * provider. Single-row erase (0x8108aba4) and sync (0x8108ad6c) take
+ * separate native entry points.
+ */
+int apple_sftl_provider_submit(struct apple_sftl_provider_stats *stats,
+			       enum apple_sftl_lower_op op, u16 rows)
+{
+	u32 offset;
+
+	if (!stats->valid)
+		return -ENODATA;
+	switch (op) {
+	case APPLE_SFTL_LOWER_READ:
+		offset = 8;
+		break;
+	case APPLE_SFTL_LOWER_PROGRAM:
+		offset = 0;
+		break;
+	case APPLE_SFTL_LOWER_ERASE:
+		offset = 16;
+		break;
+	case APPLE_SFTL_LOWER_SINGLE_ERASE:
+		if (rows != 1)
+			return unknown_event(stats);
+		add_count(stats->lower, 104, 1);
+		offset = 16;
+		break;
+	case APPLE_SFTL_LOWER_SYNC:
+		if (rows != 1)
+			return unknown_event(stats);
+		offset = 24;
+		break;
+	default:
+		return unknown_event(stats);
+	}
+	add_count(stats->lower, offset, rows);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_sftl_provider_submit);
+
+/* Native completion (0x81089c68) reads element flags at +38, stride 12.
+ * The caller must retain the original provider result through translation.
+ */
+int apple_sftl_provider_complete(struct apple_sftl_provider_stats *stats,
+				 enum apple_sftl_lower_op op, u8 vector_status,
+				 const u8 *row_status, u16 rows)
+{
+	u32 i;
+
+	if (!stats->valid)
+		return -ENODATA;
+	if (op != APPLE_SFTL_LOWER_READ && op != APPLE_SFTL_LOWER_PROGRAM &&
+	    op != APPLE_SFTL_LOWER_ERASE)
+		return unknown_event(stats);
+	if (vector_status == 0x40)
+		return 0;
+	if (rows && !row_status)
+		return unknown_event(stats);
+	for (i = 0; i < rows; i++) {
+		u8 flags = row_status[i];
+
+		if (op == APPLE_SFTL_LOWER_READ) {
+			if (flags & BIT(3))
+				add_count(stats->lower, 120, 1);
+			else if (flags & BIT(0))
+				add_count(stats->lower, 128, 1);
+			if (flags & BIT(4))
+				add_count(stats->lower, 136, 1);
+			if (flags & BIT(1))
+				add_count(stats->lower, 448, 1);
+			if (flags & BIT(2))
+				add_count(stats->lower, 456, 1);
+		} else {
+			bool program = op == APPLE_SFTL_LOWER_PROGRAM;
+
+			if (flags & BIT(0))
+				add_count(stats->lower, program ? 152 : 168, 1);
+			if (flags & BIT(4))
+				add_count(stats->lower, program ? 144 : 160, 1);
+		}
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_sftl_provider_complete);
+
+int apple_sftl_provider_single_erase_done(struct apple_sftl_provider_stats *stats,
+					  bool post_erase_sync_failed)
+{
+	if (!stats->valid)
+		return -ENODATA;
+	if (post_erase_sync_failed)
+		add_count(stats->lower, 168, 1);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_sftl_provider_single_erase_done);
+
+int apple_sftl_provider_read_stats(void *priv, u32 id, u8 *data, size_t bytes)
+{
+	const struct apple_sftl_provider_stats *stats = priv;
+
+	if (!stats || !stats->valid)
+		return -ENODATA;
+	if (!data)
+		return -EINVAL;
+	if (id == 255 && bytes == sizeof(stats->vfl))
+		memcpy(data, stats->vfl, bytes);
+	else if (id == 254 && bytes == sizeof(stats->lower))
+		memcpy(data, stats->lower, bytes);
+	else
+		return -EINVAL;
+	return (int)bytes;
+}
+EXPORT_SYMBOL_GPL(apple_sftl_provider_read_stats);
diff --git a/drivers/mtd/apple-sftl-provider.h b/drivers/mtd/apple-sftl-provider.h
new file mode 100644
index 000000000..716910925
--- /dev/null
+++ b/drivers/mtd/apple-sftl-provider.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _APPLE_SFTL_PROVIDER_H
+#define _APPLE_SFTL_PROVIDER_H
+
+#include <linux/types.h>
+
+/* IOFlashStorage-730 provider records from the 64 GB P105. Start zeroed.
+ * The provider must serialize updates/snapshots, observe every event since
+ * the seed and call apple_sftl_provider_lost() if that continuity is lost.
+ */
+struct apple_sftl_provider_stats {
+	u8 vfl[88];	/* TLV 255 */
+	u8 lower[464];	/* TLV 254 */
+	bool valid;
+};
+
+enum apple_sftl_vfl_event {
+	APPLE_SFTL_VFL_PROGRAM,
+	APPLE_SFTL_VFL_READ,
+	APPLE_SFTL_VFL_ERASE,
+	APPLE_SFTL_VFL_SCATTER_BEGIN,
+	APPLE_SFTL_VFL_SCATTER_ADD,
+	APPLE_SFTL_VFL_SCATTER_FLUSH,
+};
+
+/* The first three values match the measured lower-provider batch opcodes. */
+enum apple_sftl_lower_op {
+	APPLE_SFTL_LOWER_READ = 1,
+	APPLE_SFTL_LOWER_PROGRAM,
+	APPLE_SFTL_LOWER_ERASE,
+	APPLE_SFTL_LOWER_SINGLE_ERASE,
+	APPLE_SFTL_LOWER_SYNC,
+};
+
+int apple_sftl_provider_seed(struct apple_sftl_provider_stats *stats, const u8 *vfl,
+			     size_t vfl_bytes, const u8 *lower, size_t lower_bytes);
+void apple_sftl_provider_lost(struct apple_sftl_provider_stats *stats);
+int apple_sftl_provider_vfl(struct apple_sftl_provider_stats *stats,
+			    enum apple_sftl_vfl_event event, u32 chunks);
+int apple_sftl_provider_submit(struct apple_sftl_provider_stats *stats,
+			       enum apple_sftl_lower_op op, u16 rows);
+int apple_sftl_provider_complete(struct apple_sftl_provider_stats *stats,
+				 enum apple_sftl_lower_op op, u8 vector_status,
+				 const u8 *row_status, u16 rows);
+int apple_sftl_provider_single_erase_done(struct apple_sftl_provider_stats *stats,
+					  bool post_erase_sync_failed);
+int apple_sftl_provider_read_stats(void *priv, u32 id, u8 *data, size_t bytes);
+
+#endif
