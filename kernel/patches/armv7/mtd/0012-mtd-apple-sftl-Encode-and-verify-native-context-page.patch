diff --git a/drivers/mtd/apple-sftl-account-test.c b/drivers/mtd/apple-sftl-account-test.c
new file mode 100644
index 000000000..ee60d3f9c
--- /dev/null
+++ b/drivers/mtd/apple-sftl-account-test.c
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "apple-sftl-account.h"
+#include "apple-sftl-test-fixture.h"
+
+#define TEST_ACCOUNT_RECORDS 36
+#define TEST_VALID_STAT_OFFSET (4 + 8 * 16 + 8)
+
+static void account_fixture(struct kunit *test, struct apple_sftl_checkpoint *image)
+{
+	u32 i;
+
+	image->count = TEST_ACCOUNT_RECORDS;
+	image->records = kunit_kcalloc(test, image->count, sizeof(*image->records),
+				       GFP_KERNEL);
+	if (!image->records)
+		return;
+	apple_sftl_test_native_prefix(image->records);
+	for (i = 32; i < image->count; i++) {
+		image->records[i].meta[0] = 0x1f;
+		image->records[i].meta[1] = 4;
+		put_unaligned_le32(U32_MAX, image->records[i].meta + 12);
+	}
+}
+
+static void account_recompute_valid_lbas(struct kunit *test)
+{
+	struct apple_sftl_extent runs[] = {
+		{ 0, 3, 512 * APPLE_SFTL_STRIDE - 1 },
+		{ 3, APPLE_SFTL_LOGICAL_PAGES - 4, APPLE_SFTL_NO_ADDRESS },
+		{ APPLE_SFTL_LOGICAL_PAGES - 1, 1, 2085 * APPLE_SFTL_STRIDE + 1 },
+	};
+	struct apple_sftl_snapshot map = { .runs = runs, .nr_runs = ARRAY_SIZE(runs) };
+	struct apple_sftl_checkpoint image = {};
+	u8 *stats, *entry;
+
+	account_fixture(test, &image);
+	KUNIT_ASSERT_NOT_NULL(test, image.records);
+	stats = image.records[4].data;
+	entry = image.records[8].data;
+	/* A previously referenced donor has a stale count of four. */
+	put_unaligned_le16(4, entry + 2);
+	put_unaligned_le64(4, stats + TEST_VALID_STAT_OFFSET);
+	entry[0] = 3;
+	entry[1] = 16;
+	put_unaligned_le16(111, entry + 6);
+	stats[12] = 0xac;
+	image.records[16].data[7] = 0x76;
+	KUNIT_ASSERT_EQ(test, apple_sftl_account_map(&image, &map), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(entry + 2), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(entry + 511 * 8 + 2), 1);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(image.records[9].data + 2), 2);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(image.records[12].data + 37 * 8 + 2), 1);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(stats + TEST_VALID_STAT_OFFSET), 4ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(entry), 0x1003);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(entry + 6), 111);
+	KUNIT_EXPECT_EQ(test, stats[12], (u8)0xac);
+	KUNIT_EXPECT_EQ(test, image.records[16].data[7], (u8)0x76);
+	runs[2].provider = APPLE_SFTL_NO_ADDRESS;
+	KUNIT_ASSERT_EQ(test, apple_sftl_account_map(&image, &map), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(stats + TEST_VALID_STAT_OFFSET), 3ULL);
+}
+
+static void account_invalid_layout_or_map(struct kunit *test)
+{
+	struct apple_sftl_extent runs[] = {
+		{ 0, 1, APPLE_SFTL_STRIDE }, { 1, APPLE_SFTL_LOGICAL_PAGES - 1, APPLE_SFTL_NO_ADDRESS },
+	};
+	struct apple_sftl_snapshot map = { .runs = runs, .nr_runs = ARRAY_SIZE(runs) };
+	struct apple_sftl_checkpoint image = {};
+	u8 *stats;
+
+	account_fixture(test, &image);
+	KUNIT_ASSERT_NOT_NULL(test, image.records);
+	stats = image.records[4].data;
+	put_unaligned_le16(1, image.records[9].meta + 8);
+	KUNIT_EXPECT_EQ(test, apple_sftl_account_map(&image, &map), -EOPNOTSUPP);
+	put_unaligned_le16(512, image.records[9].meta + 8);
+	put_unaligned_le32(U32_MAX, stats + 8);
+	KUNIT_EXPECT_EQ(test, apple_sftl_account_map(&image, &map), -EOPNOTSUPP);
+	put_unaligned_le32(2, stats + 8);
+	put_unaligned_le64(1, stats + TEST_VALID_STAT_OFFSET);
+	KUNIT_EXPECT_EQ(test, apple_sftl_account_map(&image, &map), -EBADMSG);
+	put_unaligned_le64(0, stats + TEST_VALID_STAT_OFFSET);
+	runs[1].length--;
+	KUNIT_EXPECT_EQ(test, apple_sftl_account_map(&image, &map), -EBADMSG);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(stats + TEST_VALID_STAT_OFFSET), 0ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(image.records[8].data + 8 + 2), 0);
+}
+
+static void account_footer_user_sequence(struct kunit *test)
+{
+	struct apple_sftl_user_seq summary = {};
+	u8 footer[APPLE_SFTL_META * 4] = {};
+	u32 high[] = { U32_MAX - 15, U32_MAX, 10, U32_MAX - 1 };
+	u32 i;
+
+	for (i = 0; i < ARRAY_SIZE(high); i++) {
+		put_unaligned_le32(high[i], footer + i * APPLE_SFTL_META + 4);
+		put_unaligned_le32(i + 1, footer + i * APPLE_SFTL_META + 12);
+	}
+	apple_sftl_summarize_user_seq(&summary, footer, ARRAY_SIZE(high));
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data), 10U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data + 4), U32_MAX - 1);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data + 8), 2863311528U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data + 12), 3U);
+	apple_sftl_summarize_user_seq(&summary, footer + APPLE_SFTL_META, 1);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data + 8), 0U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data + 12), 1U);
+	apple_sftl_summarize_user_seq(&summary, footer, 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data), 0U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data + 4), 0U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(summary.data + 12), 1U);
+}
+
+static void account_context_and_retired_donor(struct kunit *test)
+{
+	struct apple_sftl_checkpoint image = {};
+	struct apple_sftl_snapshot snapshot = {};
+	u32 blocks[] = { 4, 1100 };
+	u8 footer[APPLE_SFTL_META] = { 0x1c, 8 };
+	u8 *p, *donor, *reads, *free, *data;
+
+	account_fixture(test, &image);
+	KUNIT_ASSERT_NOT_NULL(test, image.records);
+	snapshot.nr_opaque = APPLE_SFTL_ACCOUNT_RECORDS;
+	snapshot.opaque = image.records;
+	p = image.records[10].data + 76 * 8;
+	image.records[8].data[4 * 8] = 7;
+	KUNIT_EXPECT_FALSE(test, apple_sftl_account_context_pair(&snapshot, blocks));
+	p[0] = 7;
+	KUNIT_EXPECT_TRUE(test, apple_sftl_account_context_pair(&snapshot, blocks));
+	put_unaligned_le16(1, p + 2);
+	KUNIT_EXPECT_FALSE(test, apple_sftl_account_context_pair(&snapshot, blocks));
+
+	donor = image.records[10].data + 77 * 8; /* Block 1101. */
+	reads = image.records[29].data + 77 * 4;
+	free = image.records[4].data + TEST_VALID_STAT_OFFSET + 16;
+	data = free + 16;
+	donor[0] = 3;
+	donor[1] = 8;
+	put_unaligned_le16(47, donor + 6);
+	put_unaligned_le16(4, footer + 12);
+	put_unaligned_le16(0xffff, footer + 14);
+	put_unaligned_le32(517, reads);
+	put_unaligned_le64(10, free);
+	put_unaligned_le64(12, data);
+	put_unaligned_le16(5, donor + 2);
+	KUNIT_EXPECT_EQ(test, apple_sftl_account_retire(&image, 1101, footer), -EOPNOTSUPP);
+	put_unaligned_le16(0, donor + 2);
+	footer[1] = 9;
+	KUNIT_EXPECT_EQ(test, apple_sftl_account_retire(&image, 1101, footer), -EOPNOTSUPP);
+	footer[1] = 8;
+	put_unaligned_le64(0, data);
+	KUNIT_EXPECT_EQ(test, apple_sftl_account_retire(&image, 1101, footer), -EBADMSG);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(reads), 517U);
+	KUNIT_EXPECT_EQ(test, donor[0], (u8)3);
+	put_unaligned_le64(12, data);
+	KUNIT_ASSERT_EQ(test, apple_sftl_account_retire(&image, 1101, footer), 0);
+	KUNIT_EXPECT_EQ(test, donor[0], (u8)9);
+	KUNIT_EXPECT_EQ(test, donor[1], (u8)8);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(donor + 6), 47);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(reads), 0U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(free), 11ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(data), 11ULL);
+	KUNIT_EXPECT_EQ(test, apple_sftl_account_retire(&image, 1101, footer), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(free), 11ULL);
+}
+
+static struct kunit_case account_cases[] = {
+	KUNIT_CASE(account_recompute_valid_lbas),
+	KUNIT_CASE(account_invalid_layout_or_map),
+	KUNIT_CASE(account_footer_user_sequence),
+	KUNIT_CASE(account_context_and_retired_donor),
+	{}
+};
+
+static struct kunit_suite account_suite = {
+	.name = "apple-sftl-accounting",
+	.test_cases = account_cases,
+};
+kunit_test_suite(account_suite);
+MODULE_LICENSE("GPL");
diff --git a/drivers/mtd/apple-sftl-account.c b/drivers/mtd/apple-sftl-account.c
new file mode 100644
index 000000000..56115e81c
--- /dev/null
+++ b/drivers/mtd/apple-sftl-account.c
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SwissPPNFTL accounting on 13G36 64 GB media. cxtSaveSB at 0x8108e7e4
+ * serializes the resident valid-LBA count into bytes 2..3 of each entry.
+ * Stat 9 counts all valid LBAs, including internal keys past the disk end.
+ */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "apple-sftl-account.h"
+#include "apple-sftl-reclaim.h"
+
+#define SFTL_STATS_START	4
+#define SFTL_SB_START		8
+#define SFTL_USER_SEQ_START	16
+#define SFTL_READ_COUNT_START	28
+#define SFTL_SB_ENTRY_BYTES	8
+#define SFTL_SB_PER_RECORD	(APPLE_SFTL_CHUNK / SFTL_SB_ENTRY_BYTES)
+
+bool apple_sftl_native_context_tag(u32 index, const u8 *meta)
+{
+	u32 start = 0, entries = 0, stride = 0;
+	u8 subtype;
+
+	if (index < SFTL_STATS_START)
+		subtype = 1;
+	else if (index < SFTL_SB_START)
+		subtype = 2;
+	else if (index < SFTL_USER_SEQ_START) {
+		subtype = 3;
+		stride = SFTL_SB_PER_RECORD;
+		start = (index - SFTL_SB_START) * stride;
+	} else if (index < SFTL_READ_COUNT_START) {
+		subtype = 5;
+		stride = APPLE_SFTL_CHUNK / 16;
+		start = (index - SFTL_USER_SEQ_START) * stride;
+	} else if (index < APPLE_SFTL_ACCOUNT_RECORDS) {
+		subtype = 6;
+		stride = APPLE_SFTL_CHUNK / 4;
+		start = (index - SFTL_READ_COUNT_START) * stride;
+	} else {
+		subtype = 4;
+	}
+	if (start < APPLE_SFTL_SUBBLOCKS)
+		entries = min(stride, APPLE_SFTL_SUBBLOCKS - start);
+	return meta && meta[0] == 0x1f && meta[1] == subtype &&
+		get_unaligned_le16(meta + 8) == start &&
+		get_unaligned_le16(meta + 10) == entries &&
+		get_unaligned_le32(meta + 12) == U32_MAX;
+}
+
+/* Native close (0x8108bd60) samples the user sequence high word once per
+ * footer run. Lengths and skipped U32_MAX values do not enter the mean.
+ */
+void apple_sftl_summarize_user_seq(struct apple_sftl_user_seq *out, const u8 *runs, u32 count)
+{
+	u32 i, low = U32_MAX, high = 0, samples = 0;
+	u64 sum = 0;
+
+	for (i = 0; i < count; i++, runs += APPLE_SFTL_META) {
+		u32 seq = get_unaligned_le32(runs + 4);
+
+		if (seq == U32_MAX)
+			continue;
+		low = min(low, seq);
+		high = max(high, seq);
+		sum += seq;
+		samples++;
+	}
+	if (!samples) {
+		low = 0;
+		samples = 1;
+	}
+	put_unaligned_le32(low, out->data);
+	put_unaligned_le32(high, out->data + 4);
+	put_unaligned_le32(div_u64(sum, samples), out->data + 8);
+	put_unaligned_le32(samples, out->data + 12);
+}
+EXPORT_SYMBOL_GPL(apple_sftl_summarize_user_seq);
+
+static bool sftl_native_prefix(const struct apple_sftl_context_record *records, u32 count)
+{
+	u32 i;
+
+	if (!records || count < APPLE_SFTL_ACCOUNT_RECORDS ||
+	    get_unaligned_le32(records[3].data + APPLE_SFTL_CHUNK - 4) != APPLE_SFTL_SUBBLOCKS)
+		return false;
+	for (i = 0; i < APPLE_SFTL_ACCOUNT_RECORDS; i++)
+		if (!apple_sftl_native_context_tag(i, records[i].meta))
+			return false;
+	return true;
+}
+
+static u8 *sftl_sb_entry(struct apple_sftl_context_record *records, u32 block)
+{
+	u32 record = SFTL_SB_START + block / SFTL_SB_PER_RECORD;
+	u32 offset = block % SFTL_SB_PER_RECORD * SFTL_SB_ENTRY_BYTES;
+
+	return records[record].data + offset;
+}
+
+bool apple_sftl_account_context_pair(const struct apple_sftl_snapshot *snapshot,
+				    const u32 blocks[2])
+{
+	u32 i;
+
+	if (!snapshot || snapshot->nr_opaque != APPLE_SFTL_ACCOUNT_RECORDS || !blocks ||
+	    blocks[0] == blocks[1] || !sftl_native_prefix(snapshot->opaque, snapshot->nr_opaque))
+		return false;
+	for (i = 0; i < 2; i++) {
+		const u8 *entry;
+
+		if (!blocks[i] || blocks[i] >= APPLE_SFTL_SUBBLOCKS)
+			return false;
+		entry = sftl_sb_entry(snapshot->opaque, blocks[i]);
+		/* Recovery assigns class 7 to context (0x1f) at 0x8108d762.
+		 * The context allocator independently assigns it at 0x810937a4.
+		 */
+		if (entry[0] != 7 || get_unaligned_le16(entry + 2))
+			return false;
+	}
+	return true;
+}
+EXPORT_SYMBOL_GPL(apple_sftl_account_context_pair);
+
+int apple_sftl_account_user_seq(struct apple_sftl_snapshot *snapshot,
+				const struct apple_sftl_user_seq *updates)
+{
+	u32 block, per_record = APPLE_SFTL_CHUNK / sizeof(*updates);
+
+	if (snapshot->nr_opaque != APPLE_SFTL_ACCOUNT_RECORDS ||
+	    !sftl_native_prefix(snapshot->opaque, snapshot->nr_opaque))
+		return -EBADMSG;
+	for (block = 0; block < APPLE_SFTL_SUBBLOCKS; block++) {
+		u32 record = SFTL_USER_SEQ_START + block / per_record;
+		u32 offset = block % per_record * sizeof(*updates);
+
+		/* A native close always has a nonzero sample count. */
+		if (get_unaligned_le32(updates[block].data + 12))
+			memcpy(snapshot->opaque[record].data + offset,
+			       updates[block].data, sizeof(*updates));
+	}
+	return 0;
+}
+
+static int sftl_account_layout(const struct apple_sftl_checkpoint *image)
+{
+	u32 i;
+
+	if (image->count <= APPLE_SFTL_ACCOUNT_RECORDS || image->count % 4 ||
+	    !sftl_native_prefix(image->records, image->count))
+		return -EOPNOTSUPP;
+	for (i = APPLE_SFTL_ACCOUNT_RECORDS; i < image->count; i++)
+		if (!apple_sftl_native_context_tag(i, image->records[i].meta))
+			return -EOPNOTSUPP;
+	return 0;
+}
+
+static u8 *sftl_stats(struct apple_sftl_checkpoint *image)
+{
+	u8 *payload = image->records[SFTL_STATS_START].data;
+	u32 i, offset = sizeof(u32);
+
+	/* The measured stats payload is a word-counted TLV list. IDs 1..43
+	 * carry 64-bit counters, followed by two private variable-size blobs.
+	 */
+	if (get_unaligned_le32(payload) != 45)
+		return NULL;
+	for (i = 0; i < 45; i++) {
+		u32 id, words;
+
+		if (offset > APPLE_SFTL_CHUNK - 8)
+			return NULL;
+		id = get_unaligned_le32(payload + offset);
+		words = get_unaligned_le32(payload + offset + 4);
+		offset += 8;
+		if (words > (APPLE_SFTL_CHUNK - offset) / 4 ||
+		    (i < 43 && (id != i + 1 || words != 2)) ||
+		    (i == 43 && (id != 255 || words != 22)) ||
+		    (i == 44 && (id != 254 || words != 116)))
+			return NULL;
+		offset += words * 4;
+	}
+	return payload;
+}
+
+/* sftl_stats has checked all of the fixed-size leading counters. */
+static u8 *sftl_stat(u8 *stats, u32 id)
+{
+	return stats + sizeof(u32) + (id - 1) * 16 + 8;
+}
+
+/* Apply the native post-GC state of a verified, presently unmapped donor.
+ * It is dirty/free (9) at this point. Erase success and wear are later events.
+ */
+int apple_sftl_account_retire(struct apple_sftl_checkpoint *image, u32 block, const u8 *footer_meta)
+{
+	u32 reads_per_record = APPLE_SFTL_CHUNK / sizeof(u32);
+	u8 *entry, *reads, *stats;
+	u64 data, free;
+	u16 chunks;
+	int ret;
+
+	if (!image || !image->records || !footer_meta || !block || block >= APPLE_SFTL_SUBBLOCKS)
+		return -EINVAL;
+	ret = sftl_account_layout(image);
+	if (ret)
+		return ret;
+	chunks = get_unaligned_le16(footer_meta + 12);
+	if (footer_meta[0] != 0x1c || chunks < 4 || chunks > 32 || chunks % 4 ||
+	    footer_meta[1] >> 1 != chunks || get_unaligned_le16(footer_meta + 14) != 0xffff)
+		return -EOPNOTSUPP;
+	entry = sftl_sb_entry(image->records, block);
+	if (entry[0] != 3 || entry[1] != footer_meta[1] || get_unaligned_le16(entry + 2))
+		return -EOPNOTSUPP;
+	stats = sftl_stats(image);
+	if (!stats)
+		return -EOPNOTSUPP;
+	free = get_unaligned_le64(sftl_stat(stats, 10));
+	data = get_unaligned_le64(sftl_stat(stats, 11));
+	if (free >= APPLE_SFTL_SUBBLOCKS || !data || data > APPLE_SFTL_SUBBLOCKS - free)
+		return -EBADMSG;
+	reads = image->records[SFTL_READ_COUNT_START + block / reads_per_record].data +
+		(block % reads_per_record) * sizeof(u32);
