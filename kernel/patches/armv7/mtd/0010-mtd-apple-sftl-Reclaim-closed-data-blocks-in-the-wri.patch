+	ret = apple_sftl_snapshot(sftl, 65536, &snapshot);
+	if (ret)
+		return ret;
+	map = *snapshot;
+	if (internal_key)
+		ret = sftl_test_gc_internal_key(f, &map);
+	if (!ret)
+		ret = apple_sftl_checkpoint_build(&map, blocks, f->checkpoint_slot ? 2 : 1, 16,
