+	if (checkpoint == GC_CHECKPOINT_AFTER_OVERWRITE || checkpoint == GC_CHECKPOINT_WITH_INTERNAL_KEY)
+		ret = sftl_test_gc_save(f, sftl, checkpoint == GC_CHECKPOINT_WITH_INTERNAL_KEY);
