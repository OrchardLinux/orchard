 		if (head[0] != 1 && head[0] != 2)
 			continue;
 		pages = hweight16(sftl->lanes[block]) * sftl->geo->pages;
-		ret = sftl_read_address(sftl, block * stride + (pages - 1) * 4, &chunk);
-		if (ret)
+		ret = sftl_read_open(sftl, block * stride + (pages - 1) * 4, &chunk);
