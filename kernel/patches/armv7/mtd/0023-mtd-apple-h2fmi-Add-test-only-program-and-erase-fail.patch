From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rzxvx <rrzxznewid@gmail.com>
Date: Fri, 20 Nov 2026 06:36:50 +0800
Subject: [PATCH] mtd: apple-h2fmi: Add test-only program and erase failure
 injection

The translation layer's give-up paths can be exercised on synthetic
media, but Cascadia also ran them on a 16 GB P105: its driver makes the
Nth program fail, either before the page is programmed or after, and
the Nth erase fail, and a script writes files on ext4 meanwhile, then
checks them after a remount, with e2fsck and with iOS.

Offer the same in H2FMI behind CONFIG_MTD_APPLE_H2FMI_FAULT_INJECT
(default n), through the kernel's fault-injection framework instead of
module parameters: debugfs apple-h2fmi/fail_program fails a program
before it starts, fail_program_landed reports failure after the page
was programmed and read back (and resets the packages as a real failure
does), and fail_erase fails an erase before it starts. Each takes the
usual attributes; interval N with times 1 fails the Nth operation.

Add Cascadia's script as a KUnit case on synthetic media: a program
that fails before reaching the NAND, later one that lands but reports
failure, under a stream of writes; every write succeeds and the data
survive a fresh load with a writable journal.

Ported from Cascadia (https://github.com/rzxvx/Project-Cascadia) commits
c0d5a20 ("a5: apple_ppn: test-only program/erase failure injection;
device fault script") and 9c6bac2 ("a5: apple_ppn: failure injection
only with CONFIG_APPLE_PPN_FAULT_INJECT (default n)"), files apple_ppn.c
and devices/a5/tools/nand-faults/faults.sh, as of Cascadia ad28ba4.

Assisted-by: LLM
---
 drivers/mtd/apple-sftl-test.c         | 43 +++++++++++++++++++
 drivers/mtd/devices/Kconfig           | 14 ++++++
 drivers/mtd/devices/mtd-apple-h2fmi.c | 61 ++++++++++++++++++++++++++-
 3 files changed, 117 insertions(+), 1 deletion(-)

diff --git a/drivers/mtd/apple-sftl-test.c b/drivers/mtd/apple-sftl-test.c
index 87be0c43c..e9ae55f46 100644
--- a/drivers/mtd/apple-sftl-test.c
+++ b/drivers/mtd/apple-sftl-test.c
@@ -1168,6 +1168,48 @@ static void sftl_test_append_uncertain_program_replays(struct kunit *test)
 	apple_sftl_free(sftl);
 }
 
+/* Cascadia's device fault script (tools/nand-faults/faults.sh) on synthetic
+ * media: a program that fails before reaching the NAND, later one that
+ * lands but reports failure, each under a stream of writes. Every write
+ * succeeds, and the data survive a fresh load with a writable journal.
+ */
+static void sftl_test_fault_ladder(struct kunit *test)
+{
+	struct sftl_fixture *f = sftl_test_fixture(test, SFTL_NO_FAULT);
+	struct apple_sftl *sftl = NULL;
+	struct apple_sftl_info info;
+	u8 *data = kunit_kmalloc(test, 16384, GFP_KERNEL);
+	unsigned int page;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	KUNIT_ASSERT_EQ(test, apple_sftl_load(&f->provider, &sftl), 0);
+	f->fail_program = 6;
+	for (page = 0; page < 24; page++) {
+		if (page == 12) {
+			f->fail_program = f->programs + 4;
+			f->uncertain_program = true;
+		}
+		memset(data, 'A' + page, 16384);
+		KUNIT_ASSERT_EQ(test, apple_sftl_write(sftl, TEST_APPEND_BASE + page * 4, data, 4), 0);
+	}
+	/* Two blocks were given up; the third holds everything. */
+	KUNIT_EXPECT_NOT_NULL(test, sftl_test_written(f, 2, 0, 23));
+	KUNIT_EXPECT_NULL(test, sftl_test_written(f, 2, 0, 24));
+	KUNIT_EXPECT_EQ(test, f->program_outside, 0U);
+	apple_sftl_free(sftl);
+	sftl = NULL;
+	KUNIT_ASSERT_EQ(test, apple_sftl_load(&f->provider, &sftl), 0);
+	apple_sftl_get_info(sftl, &info);
+	KUNIT_EXPECT_FALSE(test, info.read_only);
+	KUNIT_EXPECT_EQ(test, info.journal_sequence, info.sequence);
+	for (page = 0; page < 96; page++) {
+		KUNIT_ASSERT_EQ(test, apple_sftl_read(sftl, TEST_APPEND_BASE + page, data), 0);
+		sftl_test_expect_fill(test, data, 'A' + page / 4);
+	}
+	apple_sftl_free(sftl);
+}
+
 static void sftl_test_append_interrupted_footer_replays(struct kunit *test)
 {
 	static const struct {
@@ -3682,6 +3724,7 @@ static struct kunit_case apple_sftl_cases[] = {
 	KUNIT_CASE(sftl_test_append_failure_moves_live_pages),
 	KUNIT_CASE(sftl_test_append_failures_exhaust_blocks),
 	KUNIT_CASE(sftl_test_append_uncertain_program_replays),
+	KUNIT_CASE(sftl_test_fault_ladder),
 	KUNIT_CASE(sftl_test_append_interrupted_footer_replays),
 	KUNIT_CASE(sftl_test_append_torn_metadata),
 	KUNIT_CASE(sftl_test_torn_page_at_load),
diff --git a/drivers/mtd/devices/Kconfig b/drivers/mtd/devices/Kconfig
index 33ab36b71..ef6a7facd 100644
--- a/drivers/mtd/devices/Kconfig
+++ b/drivers/mtd/devices/Kconfig
@@ -224,6 +224,20 @@ config MTD_APPLE_H2FMI
 
 	  If unsure, say N.
 
+config MTD_APPLE_H2FMI_FAULT_INJECT
+	bool "Test-only program and erase failure injection"
+	depends on MTD_APPLE_H2FMI && FAULT_INJECTION_DEBUG_FS
+	default n
+	help
+	  Adds debugfs fault-injection attributes under apple-h2fmi/ that
+	  make a page program fail before or after it reaches the NAND, or a
+	  block erase fail, to exercise the translation layer's failure
+	  handling on a tablet.  A failure reported after programming resets
+	  the packages as a real one does.
+
+	  Never enable this on a device whose NAND holds data you need.
+	  Say N.
+
 config MTD_APPLE_H2FMI_KUNIT_TEST
 	tristate "KUnit tests for Apple H2FMI PPN geometry" if !KUNIT_ALL_TESTS
 	depends on KUNIT
diff --git a/drivers/mtd/devices/mtd-apple-h2fmi.c b/drivers/mtd/devices/mtd-apple-h2fmi.c
index 6431bd7e7..b24d13e90 100644
--- a/drivers/mtd/devices/mtd-apple-h2fmi.c
+++ b/drivers/mtd/devices/mtd-apple-h2fmi.c
@@ -30,7 +30,9 @@
  * Logical-address translation and allocation belong to the FTL above.
  */
 
+#include <linux/debugfs.h>
 #include <linux/delay.h>
+#include <linux/fault-inject.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
@@ -120,6 +122,46 @@ struct h2fmi_bus {
 /* Resets after failed transactions in one driver instance. */
 #define H2FMI_MAX_RESETS	8
 
+/*
+ * Test-only failure injection (CONFIG_MTD_APPLE_H2FMI_FAULT_INJECT), as
+ * Cascadia's driver offers it for exercising the translation layer's
+ * failure paths on a tablet: debugfs apple-h2fmi/fail_program makes a page
+ * program fail without programming, fail_program_landed reports failure
+ * after the page was programmed and read back, and fail_erase fails a
+ * block erase before it starts. Each takes the usual fault-injection
+ * attributes (probability, interval, times, ...).
+ */
+#ifdef CONFIG_MTD_APPLE_H2FMI_FAULT_INJECT
+static DECLARE_FAULT_ATTR(h2fmi_fail_program);
+static DECLARE_FAULT_ATTR(h2fmi_fail_program_landed);
+static DECLARE_FAULT_ATTR(h2fmi_fail_erase);
+
+static void h2fmi_remove_debugfs(void *dir)
+{
+	debugfs_remove_recursive(dir);
+}
+
+static int h2fmi_fault_init(struct device *dev)
+{
+	struct dentry *dir = debugfs_create_dir("apple-h2fmi", NULL);
+
+	fault_create_debugfs_attr("fail_program", dir, &h2fmi_fail_program);
+	fault_create_debugfs_attr("fail_program_landed", dir, &h2fmi_fail_program_landed);
+	fault_create_debugfs_attr("fail_erase", dir, &h2fmi_fail_erase);
+	dev_warn(dev, "test-only failure injection is built in\n");
+	return devm_add_action_or_reset(dev, h2fmi_remove_debugfs, dir);
+}
+
+#define h2fmi_inject(attr)	should_fail(&(attr), 1)
+#else
+static int h2fmi_fault_init(struct device *dev)
+{
+	return 0;
+}
+
+#define h2fmi_inject(attr)	false
+#endif
+
 struct h2fmi_die {
 	struct h2fmi *fmi;
 	u8 bus;
@@ -1000,6 +1042,11 @@ static int h2fmi_program_page(struct h2fmi *fmi, struct h2fmi_bus *b,
 		ret = -EEXIST;
 		goto out;
 	}
+	if (h2fmi_inject(h2fmi_fail_program)) {
+		dev_warn(fmi->dev, "PPN program row %08x: injected failure\n", row);
+		ret = -EIO;
+		goto out;
+	}
 	ret = h2fmi_program_transaction(fmi, b, row, expected);
 	if (ret)
 		goto out;
@@ -1013,6 +1060,12 @@ static int h2fmi_program_page(struct h2fmi *fmi, struct h2fmi_bus *b,
 			row, status, ret);
 		goto out;
 	}
+	if (h2fmi_inject(h2fmi_fail_program_landed)) {
+		dev_warn(fmi->dev, "PPN program row %08x: injected failure after programming\n",
+			 row);
+		h2fmi_fail(fmi);
+		ret = -EIO;
+	}
 out:
 	mutex_unlock(&b->lock);
 	kfree(expected);
@@ -1214,6 +1267,10 @@ static int h2fmi_ppn_erase(void *priv, unsigned int bus, unsigned int cau,
 	if (ret)
 		return ret;
 
+	if (h2fmi_inject(h2fmi_fail_erase)) {
+		dev_warn(fmi->dev, "PPN erase row %08x: injected failure\n", row);
+		return -EIO;
+	}
 	ret = h2fmi_lock(fmi, b);
 	if (ret)
 		return ret;
@@ -1523,7 +1580,9 @@ static int h2fmi_probe(struct platform_device *pdev)
 		}
 	}
 
-	ret = h2fmi_register_sftl(fmi);
+	ret = h2fmi_fault_init(&pdev->dev);
+	if (!ret)
+		ret = h2fmi_register_sftl(fmi);
 	if (ret) {
 		for (i = 0; i < fmi->ndies; i++)
 			mtd_device_unregister(&fmi->mtd[i]);
