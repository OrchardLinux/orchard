From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shayne Legault <8741557+shaynelegault@users.noreply.github.com>
Date: Fri, 6 Nov 2026 13:14:19 -0600
Subject: [PATCH] phy: apple-s5l-usb: Roll back host supplies when startup
 fails

PHY core does not call the driver's power_off callback after power_on
returns an error. Once the host callback enables LPO or HSIC, a deferred
HSIC lookup, regulator failure or failed EHCI/OHCI gate can therefore
leave its supply references enabled.

Unwind references acquired by the failed call in reverse order and clear
the matching state flags. Preserve references that were already enabled
before the call so a later retry or power_off balances their ownership.

[Orchard: from shaynelegault/orchard#90 96a4f74 (source 2f23b4e39917);
 moved to patches/armv7/usb; dropped the test notes from the commit
 message]

Assisted-by: LLM
---
 drivers/phy/phy-apple-s5l-usb.c | 27 ++++++++++++++++++++++-----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/drivers/phy/phy-apple-s5l-usb.c b/drivers/phy/phy-apple-s5l-usb.c
index 04beb3b7b381..4182d8bfeffb 100644
--- a/drivers/phy/phy-apple-s5l-usb.c
+++ b/drivers/phy/phy-apple-s5l-usb.c
@@ -342,6 +342,7 @@ static const struct phy_ops s5l_usbphy_ops = {
 static int s5l_hostphy_power_on(struct phy *phy)
 {
 	struct s5l_usbphy *p = phy_get_drvdata(phy);
+	bool lpo_enabled = false, hsic_enabled = false;
 	int ret;
 
 	/* The 32 kHz clock first, the way a chip expects its sleep clock
@@ -361,6 +362,7 @@ static int s5l_hostphy_power_on(struct phy *phy)
 		if (ret)
 			return ret;
 		p->lpo_supply_on = true;
+		lpo_enabled = true;
 		msleep(10);
 	}
 
@@ -368,8 +370,10 @@ static int s5l_hostphy_power_on(struct phy *phy)
 		struct regulator *r = devm_regulator_get_optional(p->dev, "hsic");
 
 		if (IS_ERR(r)) {
-			if (PTR_ERR(r) == -EPROBE_DEFER)
-				return -EPROBE_DEFER;
+			if (PTR_ERR(r) == -EPROBE_DEFER) {
+				ret = -EPROBE_DEFER;
+				goto err_disable_lpo;
+			}
 			dev_warn(p->dev, "no hsic-supply (%ld): the HSIC device stays unpowered\n",
 				 PTR_ERR(r));
 		} else {
@@ -379,17 +383,18 @@ static int s5l_hostphy_power_on(struct phy *phy)
 	if (p->hsic_supply && !p->hsic_supply_on) {
 		ret = regulator_enable(p->hsic_supply);
 		if (ret)
-			return ret;
+			goto err_disable_lpo;
 		p->hsic_supply_on = true;
+		hsic_enabled = true;
 		msleep(10);
 	}
 
 	ret = s5l_pmgr_on(p, PMGR_USB_EHCI);
 	if (ret)
-		return ret;
+		goto err_disable_hsic;
 	ret = s5l_pmgr_on(p, PMGR_USB_OHCI0);
 	if (ret)
-		return ret;
+		goto err_disable_hsic;
 	if (p->usbcplx)
 		writel(readl(p->usbcplx) | USBCPLX_HSIC_EN, p->usbcplx);
 
@@ -397,6 +402,18 @@ static int s5l_hostphy_power_on(struct phy *phy)
 		 readl(p->pmgr + PMGR_USB_EHCI), readl(p->pmgr + PMGR_USB_OHCI0),
 		 p->usbcplx ? readl(p->usbcplx) : 0);
 	return 0;
+
+err_disable_hsic:
+	if (hsic_enabled) {
+		regulator_disable(p->hsic_supply);
+		p->hsic_supply_on = false;
+	}
+err_disable_lpo:
+	if (lpo_enabled) {
+		regulator_disable(p->lpo_supply);
+		p->lpo_supply_on = false;
+	}
+	return ret;
 }
 
 static int s5l_hostphy_power_off(struct phy *phy)
