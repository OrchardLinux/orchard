From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stephen Cox <stephencoxmail@gmail.com>
Date: Fri, 6 Nov 2026 16:35:12 +1300
Subject: [PATCH] irqchip/apple-aic1: start the clockevent before workqueue
 setup

Kernel threads can sleep on a timer in wait_task_inactive() during
workqueue setup. Start the AIC clockevent after rearming interrupts so
that sleep can finish before the usual early initcall. Retain the
initcall and permit only one probe.

[Orchard: from rzxvx/Project-Cascadia 7d956cd88cbc; adapted the early
clockevent setup to the imported ARMv7 tree.]

Link: https://github.com/rzxvx/Project-Cascadia/pull/35
Link: https://github.com/OrchardLinux/orchard/issues/79
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Assisted-by: LLM
---
 drivers/irqchip/irq-apple-aic1.c | 30 ++++++++++++++++--------------
 init/main.c                      |  2 ++
 2 files changed, 18 insertions(+), 14 deletions(-)

diff --git a/drivers/irqchip/irq-apple-aic1.c b/drivers/irqchip/irq-apple-aic1.c
index f1387fe30..d5b18c363 100644
--- a/drivers/irqchip/irq-apple-aic1.c
+++ b/drivers/irqchip/irq-apple-aic1.c
@@ -132,6 +132,7 @@ static struct apple_aic1 *apple_aic1;
 static unsigned int aic1_handler_entries;
 
 void apple_a9_gic_drain(void);
+int __init apple_aic1_timer_start(void);
 extern bool apple_aic1_early_irq_escape;
 
 static void aic1_tmr_event(struct apple_aic1 *aic);
@@ -999,26 +1000,22 @@ static bool __init aic1_tmr_try(struct apple_aic1 *aic, u32 win,
 	return false;
 }
 
+static bool aic1_tmr_tried __initdata;
+
 /*
- * Register only on a timer seen to fire.  Failing leaves the system exactly as
- * it was -- the SOF tick carries on -- so this cannot cost a boot.
- *
- * early_initcall: dwc2 decides whether to take Start-of-Frame interrupts
- * when it first initialises the core, at device_initcall, and it asks whether
- * this timer is live; and it must come before smp_init().  Until it runs there
- * is no clockevent at all and jiffies stand still -- harmless on one CPU, but
- * with CPU1 online the first RCU grace period waits for ever and the boot
- * stops here.  Registered first, it hands CPU1 a clockevent of its own through
- * the STARTING callback as CPU1 comes up, the same order as onlining CPU1 by
- * hand.  The AIC is re-armed and interrupts are on before any initcall runs
- * (init/main.c), so the probe below still sees the timer fire.
+ * Probe once interrupts are usable. The boot CPU needs a clockevent before
+ * workqueue_init() starts kernel threads: kthread_bind() can sleep on an
+ * hrtimer in wait_task_inactive() before early initcalls. Registering here
+ * also gives CPU1 its clockevent as it comes online and lets dwc2 decide
+ * whether the USB SOF fallback is needed when it probes.
  */
-static int __init aic1_timer_init(void)
+int __init apple_aic1_timer_start(void)
 {
 	struct apple_aic1 *aic = apple_aic1;
 
-	if (!aic)
+	if (!aic || aic1_tmr_tried)
 		return 0;
+	aic1_tmr_tried = true;
 
 	pr_err("AIC-TIMER: timebase at %#llx; trying the AIC's own timer (recipe from iBEC 12H321)\n",
 	       aic1_time(aic));
@@ -1053,6 +1050,11 @@ static int __init aic1_timer_init(void)
 	       aic1_tmr_percpu ? "one per CPU" : "CPU0 only");
 	return 0;
 }
+
+static int __init aic1_timer_init(void)
+{
+	return apple_aic1_timer_start();
+}
 early_initcall(aic1_timer_init);
 
 IRQCHIP_DECLARE(apple_aic1, "aic,1", aic1_of_init);
diff --git a/init/main.c b/init/main.c
index 4cb431401..c56cc011e 100644
--- a/init/main.c
+++ b/init/main.c
@@ -1505,6 +1505,7 @@ static int __ref kernel_init(void *unused)
 		void apple_aic1_quiesce(void);
 		void apple_aic1_hw_quiesce(bool read_back);
 		void apple_aic1_rearm(void);
+		int __init apple_aic1_timer_start(void);
 
 		apple_aic1_quiesce();
 		apple_aic1_hw_quiesce(false);
@@ -1516,6 +1517,7 @@ static int __ref kernel_init(void *unused)
 		early_boot_irqs_disabled = false;
 		local_irq_enable();
 		apple_aic1_release_escape();
+		apple_aic1_timer_start();
 	}
 #endif
 	kernel_init_freeable();
