+/* Validate the J120 profile before enabling link clocks or programming PCIe. */
+static int apple_j120_pcie_parse(struct apple_h9p_pcie *pcie)
+{
+	struct device_node *np = pcie->dev->of_node;
+	struct platform_device *dart_pdev;
+	struct device_node *mapped;
+	struct resource dart_res;
+	resource_size_t dart_base;
+	unsigned int port;
+	u32 aperture;
+	u32 map[8], doorbell, mask;
+	int ret;
+
+	if (pcie->num_ports != 6 || pcie->lane_cfg ||
+	    pcie->preinit_phy_ports || pcie->link_retry_ports ||
+	    pcie->hardware_trained_phy_ports || pcie->inherited_perst_ports)
+		return -EOPNOTSUPP;
+
+	if (pcie->enabled_ports != BIT(2))
+		return -EOPNOTSUPP;
+	port = 2;
+	aperture = 0x3ffff000;
+	dart_base = 0x603008000ULL;
+	if (pcie->msi_first[port] != 16 || pcie->msi_count[port] != 4 ||
+	    pcie->max_link_speed[port] != H9P_LINK_SPEED_2_5GT ||
+	    pcie->deferred_power_ports != BIT(2) ||
+	    !of_device_is_compatible(pcie->port_nodes[port], "apple,j120-wifi-pcie-port") ||
+	    !of_property_present(pcie->port_nodes[port], "vdd-supply") ||
+	    !of_property_present(pcie->port_nodes[port], "apple,wlan-uart"))
+		return -EINVAL;
+	if (!pcie->manual_dart[port] || pcie->manual_dart_sid[port] ||
+	    !of_device_is_compatible(pcie->port_nodes[port], "pciclass,0604"))
+		return -EINVAL;
+
+	ret = of_property_count_u32_elems(np, "iommu-map");
+	if (ret != ARRAY_SIZE(map))
+		return -EINVAL;
+	ret = of_property_read_u32_array(np, "iommu-map", map, ARRAY_SIZE(map));
+	if (ret)
+		return ret;
+	if (map[0] != 0x100 || map[2] || map[3] || map[4] != 0x80000000 ||
+	    map[5] || map[6] != aperture || map[7] != 1)
+		return -EINVAL;
+	mapped = of_find_node_by_phandle(map[1]);
+	if (!mapped)
+		return -EINVAL;
+	ret = of_address_to_resource(mapped, 0, &dart_res);
+	if (!ret && (mapped != pcie->manual_dart[port] ||
+		     !of_device_is_available(mapped) ||
+		     !of_device_is_compatible(mapped, "apple,s5l8960x-dart") ||
+		     dart_res.start != dart_base ||
+		     resource_size(&dart_res) != 0x4000))
+		ret = -EINVAL;
+	of_node_put(mapped);
+	if (ret)
+		return ret;
+
+	ret = of_property_read_u32(np, "iommu-map-mask", &mask);
+	if (ret || mask != 0xff00)
+		return -EINVAL;
+	ret = of_property_read_u32(np, "apple,msi-doorbell", &doorbell);
+	if (ret || doorbell != H9P_DEFAULT_MSI_DOORBELL)
+		return -EINVAL;
+
+	/* Wait for DART registration before starting the shared PHY. */
+	dart_pdev = of_find_device_by_node(pcie->manual_dart[port]);
+	if (!dart_pdev)
+		return -EPROBE_DEFER;
+	ret = device_is_bound(&dart_pdev->dev) ? 0 : -EPROBE_DEFER;
+	platform_device_put(dart_pdev);
+	return ret;
+}
