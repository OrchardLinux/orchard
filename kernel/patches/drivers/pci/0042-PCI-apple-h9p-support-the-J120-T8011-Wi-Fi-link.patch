+static void apple_j120_pcie_power_off(void *data)
+{
+	struct apple_h9p_pcie *pcie = data;
+	void __iomem *base = pcie->base_port[2];
+	int ret;
+
+	h9p_rmw(base + H9P_PORT_LTSSMCTL, H9P_PORT_LTSSM_ENABLE, 0);
+	readl(base + H9P_PORT_LTSSMCTL);
+	ret = gpiod_direction_output(pcie->perst[2], 1);
+	if (ret)
+		dev_warn(pcie->dev, "failed to assert Wi-Fi PERST#: %d\n", ret);
+	pci_pwrctrl_power_off_devices(pcie->dev);
+	pcie->pwrctrl_powered = false;
