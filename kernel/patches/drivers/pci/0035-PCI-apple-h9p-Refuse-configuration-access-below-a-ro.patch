From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 15 Nov 2026 18:21:11 +0800
Subject: [PATCH] PCI: apple-h9p: Refuse configuration access below a root port
 that is down

The configuration accessors refuse a root port that is not enabled, but
pass every request for the buses below it on to the hardware. Once a
port can be down while its devices still exist, such a request goes to
an unpowered port.

Answer requests below a root port that is not enabled with
PCIBIOS_DEVICE_NOT_FOUND, and reads with all ones, without touching the
hardware.

[Orchard: from orchard PR #117, commit 40a8b18d]
Assisted-by: LLM
---
 drivers/pci/controller/pcie-apple-h9p.c | 26 +++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/drivers/pci/controller/pcie-apple-h9p.c b/drivers/pci/controller/pcie-apple-h9p.c
index 0d3347895..eba0906a0 100644
--- a/drivers/pci/controller/pcie-apple-h9p.c
+++ b/drivers/pci/controller/pcie-apple-h9p.c
@@ -1233,6 +1233,24 @@ static void apple_h9p_limit_config_field(u32 *val, int where, int size,
 	*val = (*val & ~mask) | (value & mask);
 }
 
+/*
+ * Devices below a root port that is down must not be reached: with the port
+ * unpowered a configuration request has nowhere to go.
+ */
+static bool apple_h9p_config_blocked(struct pci_bus *bus)
+{
+	struct pci_config_window *cfg = bus->sysdata;
+	struct apple_h9p_pcie *pcie = apple_h9p_pcie_lookup(cfg->parent);
+	struct pci_bus *root = bus;
+
+	if (!pcie || bus->number == cfg->busr.start)
+		return false;
+	while (root->parent && root->parent->parent)
+		root = root->parent;
+	return root->self && !(READ_ONCE(pcie->enabled_ports) &
+			      BIT(PCI_SLOT(root->self->devfn)));
+}
+
 static int apple_h9p_pcie_config_read(struct pci_bus *bus, unsigned int devfn,
 				      int where, int size, u32 *val)
 {
@@ -1252,6 +1270,11 @@ static int apple_h9p_pcie_config_read(struct pci_bus *bus, unsigned int devfn,
 		pcie = NULL;
 	}
 
+	if (apple_h9p_config_blocked(bus)) {
+		PCI_SET_ERROR_RESPONSE(val);
+		return PCIBIOS_DEVICE_NOT_FOUND;
+	}
+
 	ret = pci_generic_config_read(bus, devfn, where, size, val);
 	if (ret != PCIBIOS_SUCCESSFUL || !pcie)
 		return ret;
@@ -1289,6 +1312,9 @@ static int apple_h9p_pcie_config_write(struct pci_bus *bus, unsigned int devfn,
 			return PCIBIOS_DEVICE_NOT_FOUND;
 	}
 
+	if (apple_h9p_config_blocked(bus))
+		return PCIBIOS_DEVICE_NOT_FOUND;
+
 	if (where <= PCI_INTERRUPT_LINE && where + size > PCI_INTERRUPT_LINE)
 		val |= 0xffu << ((PCI_INTERRUPT_LINE - where) << 3);
 
