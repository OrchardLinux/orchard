From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 15 Nov 2026 18:20:54 +0800
Subject: [PATCH] nvme-pci: apple-ans: Stop the controller before it loses
 power in sleep

The ANS storage controller of the A9 and A10 loses power with its PCIe
port in system sleep. nvme_suspend() shuts such a controller down but
leaves CC.EN set, and power cycling the port of a controller in that
state hangs the SoC.

Stop it the way iOS does (AppleEmbeddedNVMeController on sleep: freeze
the queue, shut the controller down, keep no state). With the I/O queues
drained and the NVMMU idle, send the shutdown notification and require
it to complete, then clear CC.EN, wait for RDY to drop, take the
controller off the bus and retire every NVMMU translation. Only then is
the host told that the port may be powered off. Resume is the reset that
follows any suspend, which brings the controller up as after boot.

A stop that fails does not continue into sleep: the controller is reset
and the suspend returns -EBUSY.

The ANS host data selects this per SoC, for S8003 and T8010.

[Orchard: from orchard PR #117, commit 40a8b18d, and the stop it builds
 on from orchard PR #105, commit d2247b1c. Left out: the kexec handoff,
 the cold reset and the diagnostics. The stop is selected by the ANS
 host data instead of the board's device tree, and the DART is saved and
 restored by its own PM callbacks.]
Assisted-by: LLM
Signed-off-by: Berkay Kösebay <brkosebay@users.noreply.github.com>
Link: https://github.com/OrchardLinux/orchard/pull/231#issuecomment-7138590680
---
 drivers/nvme/host/pci-apple-ans.c       | 26 +++++++
 drivers/nvme/host/pci-internal.h        |  9 +++
 drivers/nvme/host/pci.c                 | 97 ++++++++++++++++++++++++-
 drivers/pci/controller/pcie-apple-h9p.c | 52 +++++++++++++
 include/linux/apple-ans.h               | 19 +++++
 5 files changed, 199 insertions(+), 4 deletions(-)

diff --git a/drivers/nvme/host/pci-apple-ans.c b/drivers/nvme/host/pci-apple-ans.c
index 5ba239e47..96da756a2 100644
--- a/drivers/nvme/host/pci-apple-ans.c
+++ b/drivers/nvme/host/pci-apple-ans.c
@@ -55,12 +55,16 @@ struct apple_ans_nvme_req {
  *                  than after CAP.TO (0: CAP.TO only)
  * @late_bus_master: let the controller master the bus only after the
  *                   preinit has stopped it and reset the NVMMU slots
+ * @sleep_stop: the controller's port loses power in system sleep: stop the
+ *              controller first, as iOS (AppleEmbeddedNVMeController) does,
+ *              and bring it up from reset on resume
  */
 struct apple_ans_host {
 	u32 l1ss_ctl1;
 	unsigned int enable_settle_ms;
 	unsigned int rdy_timeout_ms;
 	bool late_bus_master;
+	bool sleep_stop;
 };
 
 static const struct apple_ans_host apple_ans_host_s8003 = {
@@ -72,10 +76,12 @@ static const struct apple_ans_host apple_ans_host_s8003 = {
 	.enable_settle_ms = 100,
 	.rdy_timeout_ms = 5000,
 	.late_bus_master = true,
+	.sleep_stop = true,
 };
 
 static const struct apple_ans_host apple_ans_host_t8010 = {
 	.l1ss_ctl1 = APPLE_ANS_L1SS_CTL1_T8010,
+	.sleep_stop = true,
 };
 
 struct apple_ans_nvme {
@@ -148,6 +154,7 @@ static int nvme_pci_apple_ans_init(struct nvme_dev *dev, int node)
 
 	ans->host = match->data;
 	dev->late_bus_master = ans->host->late_bus_master;
+	dev->sleep_stop = ans->host->sleep_stop;
 	spin_lock_init(&ans->req_lock);
 	dev->dma_data = ans;
 	return 0;
@@ -593,6 +600,23 @@ static blk_status_t nvme_pci_apple_ans_map_data(struct request *req)
 	return status;
 }
 
+static int nvme_pci_apple_ans_drain(struct nvme_dev *dev)
+{
+	return apple_ans_nvmmu_drain(dev->dev);
+}
+
+/* Retire every translation, then let the host power the port off */
+static int nvme_pci_apple_ans_stopped(struct nvme_dev *dev)
+{
+	int ret;
+
+	ret = nvme_pci_apple_ans_reset_dma(dev);
+	if (ret)
+		return ret;
+
+	return apple_ans_stopped(dev->dev);
+}
+
 static u32 nvme_pci_apple_ans_queue_depth(struct nvme_dev *dev, u32 depth)
 {
 	return min_t(u32, depth, APPLE_ANS_NVMMU_MAX_REQS);
@@ -611,6 +635,8 @@ const struct nvme_pci_dma_ops nvme_pci_apple_ans_ops = {
 	.prepare_enable = nvme_pci_apple_ans_prepare_enable,
 	.write_cc	= nvme_pci_apple_ans_write_cc,
 	.read_csts	= nvme_pci_apple_ans_read_csts,
+	.drain		= nvme_pci_apple_ans_drain,
+	.stopped	= nvme_pci_apple_ans_stopped,
 	.map_data	= nvme_pci_apple_ans_map_data,
 	.unmap_data	= nvme_pci_apple_ans_unmap_data,
 	.queue_depth	= nvme_pci_apple_ans_queue_depth,
diff --git a/drivers/nvme/host/pci-internal.h b/drivers/nvme/host/pci-internal.h
index a62777abd..e789f1e2e 100644
--- a/drivers/nvme/host/pci-internal.h
+++ b/drivers/nvme/host/pci-internal.h
@@ -40,6 +40,13 @@ struct nvme_pci_dma_ops {
 	/* Controller register hooks for CC writes and CSTS reads (optional) */
 	int (*write_cc)(struct nvme_dev *dev, u32 cc);
 	int (*read_csts)(struct nvme_dev *dev, u32 *csts);
+	/*
+	 * Stop for sleep (optional, see nvme_dev.sleep_stop): @drain before
+	 * the shutdown, with the I/O queues idle; @stopped once the
+	 * controller is disabled and off the bus.
+	 */
+	int (*drain)(struct nvme_dev *dev);
+	int (*stopped)(struct nvme_dev *dev);
 	blk_status_t (*map_data)(struct request *req);
 	bool (*unmap_data)(struct request *req);
 	u32 (*queue_depth)(struct nvme_dev *dev, u32 depth);
@@ -80,6 +87,8 @@ struct nvme_dev {
 	void *dma_data;
 	/* Enable bus mastering only once the glue's preinit has run */
 	bool late_bus_master;
+	/* The controller loses power in system sleep: stop it completely */
+	bool sleep_stop;
 
 	/* shadow doorbell buffer support: */
 	__le32 *dbbuf_dbs;
diff --git a/drivers/nvme/host/pci.c b/drivers/nvme/host/pci.c
index 9ffe2fb74..b7725f49b 100644
--- a/drivers/nvme/host/pci.c
+++ b/drivers/nvme/host/pci.c
@@ -13,6 +13,7 @@
 #include <linux/init.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
+#include <linux/iopoll.h>
 #include <linux/kstrtox.h>
 #include <linux/memremap.h>
 #include <linux/mm.h>
@@ -3283,11 +3284,58 @@ static bool nvme_pci_ctrl_is_dead(struct nvme_dev *dev)
 	return (csts & NVME_CSTS_CFS) || !(csts & NVME_CSTS_RDY);
 }
 
-static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
+/*
+ * A controller that loses power in sleep: after the shutdown notification
+ * completed, clear CC.EN, wait for RDY to drop and take the controller off
+ * the bus, as iOS does before it powers the port off. A controller that was
+ * shut down but is still enabled must not have its port power cycled.
+ */
+static int nvme_dev_stop_after_shutdown(struct nvme_dev *dev, int shutdown_ret)
+{
+	struct pci_dev *pdev = to_pci_dev(dev->dev);
+	struct nvme_ctrl *ctrl = &dev->ctrl;
+	u32 csts = ~0U, cc;
+	int ret, err;
+
+	ret = ctrl->ops->reg_read32(ctrl, NVME_REG_CSTS, &csts);
+	if (shutdown_ret || ret || (csts & NVME_CSTS_CFS) ||
+	    (csts & NVME_CSTS_SHST_MASK) != NVME_CSTS_SHST_CMPLT) {
+		pci_clear_master(pdev);
+		return -EBUSY;
+	}
+	ctrl->ctrl_config &= ~(NVME_CC_ENABLE | NVME_CC_SHN_MASK);
+	ret = ctrl->ops->reg_write32(ctrl, NVME_REG_CC, ctrl->ctrl_config);
+	if (!ret) {
+		ret = read_poll_timeout(ctrl->ops->reg_read32, err,
+					err || !(csts & NVME_CSTS_RDY),
+					1000, 2000000, false, ctrl,
+					NVME_REG_CSTS, &csts);
+		if (!ret)
+			ret = err;
+	}
+	if (ret)
+		goto block_dma;
+	cc = readl(dev->bar + NVME_REG_CC);
+	if ((csts & NVME_CSTS_CFS) ||
+	    (cc & (NVME_CC_ENABLE | NVME_CC_SHN_MASK)))
+		ret = -EBUSY;
+block_dma:
+	pci_clear_master(pdev);
+	return ret;
+}
+
+/*
+ * @stop: stop the controller for a sleep in which it loses power (implies
+ * @shutdown). Returns an error if the controller could not be stopped; it
+ * is disabled as far as possible and the caller has to reset it. If the I/O
+ * queues don't drain, nothing is stopped.
+ */
+static int __nvme_dev_disable(struct nvme_dev *dev, bool shutdown, bool stop)
 {
 	enum nvme_ctrl_state state = nvme_ctrl_state(&dev->ctrl);
 	struct pci_dev *pdev = to_pci_dev(dev->dev);
 	bool dead;
+	int ret = 0;
 
 	mutex_lock(&dev->shutdown_lock);
 	dead = nvme_pci_ctrl_is_dead(dev);
@@ -3298,15 +3346,30 @@ static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
 		 * Give the controller a chance to complete all entered requests
 		 * if doing a safe shutdown.
 		 */
-		if (!dead && shutdown)
-			nvme_wait_freeze_timeout(&dev->ctrl);
+		if (!dead && shutdown &&
+		    nvme_wait_freeze_timeout(&dev->ctrl) <= 0 && stop) {
+			nvme_unfreeze(&dev->ctrl);
+			mutex_unlock(&dev->shutdown_lock);
+			return -EBUSY;
+		}
 	}
 
 	nvme_quiesce_io_queues(&dev->ctrl);
 
+	if (stop && (dead || !dev->ctrl.queue_count))
+		ret = -EBUSY;
 	if (!dead && dev->ctrl.queue_count > 0) {
+		int shutdown_ret;
+
+		if (stop) {
+			nvme_sync_io_queues(&dev->ctrl);
+			if (dev->dma_ops && dev->dma_ops->drain)
+				ret = dev->dma_ops->drain(dev);
+		}
 		nvme_delete_io_queues(dev);
-		nvme_disable_ctrl(&dev->ctrl, shutdown);
+		shutdown_ret = nvme_disable_ctrl(&dev->ctrl, shutdown);
+		if (stop && !ret)
+			ret = nvme_dev_stop_after_shutdown(dev, shutdown_ret);
 		nvme_poll_irqdisable(&dev->queues[0]);
 	}
 	nvme_suspend_io_queues(dev);
@@ -3329,7 +3392,16 @@ static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
 		if (dev->ctrl.admin_q && !blk_queue_dying(dev->ctrl.admin_q))
 			nvme_unquiesce_admin_queue(&dev->ctrl);
 	}
+	if (stop && !ret && dev->dma_ops && dev->dma_ops->stopped)
+		ret = dev->dma_ops->stopped(dev);
 	mutex_unlock(&dev->shutdown_lock);
+
+	return ret;
+}
+
+static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
+{
+	__nvme_dev_disable(dev, shutdown, false);
 }
 
 static int nvme_disable_prepare_reset(struct nvme_dev *dev, bool shutdown)
@@ -3990,6 +4062,23 @@ static int nvme_suspend(struct device *dev)
 
 	ndev->last_ps = U32_MAX;
 
+	/*
+	 * The controller loses power: stop it completely. If that fails, bring
+	 * it back with a reset and refuse the sleep.
+	 */
+	if (ndev->sleep_stop) {
+		if (!nvme_wait_reset(ctrl))
+			return -EBUSY;
+		ret = __nvme_dev_disable(ndev, true, true);
+		if (ret) {
+			dev_err(dev, "controller not stopped for sleep: %d\n",
+				ret);
+			nvme_try_sched_reset(ctrl);
+			return -EBUSY;
+		}
+		return 0;
+	}
+
 	/*
 	 * The platform does not remove power for a kernel managed suspend so
 	 * use host managed nvme power settings for lowest idle power if
diff --git a/drivers/pci/controller/pcie-apple-h9p.c b/drivers/pci/controller/pcie-apple-h9p.c
index c467dacd9..0d3347895 100644
--- a/drivers/pci/controller/pcie-apple-h9p.c
+++ b/drivers/pci/controller/pcie-apple-h9p.c
@@ -584,6 +584,8 @@ struct apple_h9p_nvmmu {
 	void __iomem *base;
 	/* Programmed: the ANS glue may map through it */
 	bool ready;
+	/* The ANS glue stopped the controller and retired its translations */
+	bool ans_stopped;
 	/* Serializes the invalidate FIFO wait and the invalidate write */
 	spinlock_t inv_lock;
 	/* With the invalidate FIFO: tags mapped since their last invalidate */
@@ -1834,6 +1836,56 @@ int apple_ans_nvmmu_map(struct device *dev, unsigned int tag,
 }
 EXPORT_SYMBOL_GPL(apple_ans_nvmmu_map);
 
+/* The host of the ANS endpoint @dev on the storage port, or NULL */
+static struct apple_h9p_pcie *apple_ans_endpoint_host(struct device *dev)
+{
+	struct device *host = dev;
+	struct apple_h9p_pcie *pcie;
+
+	while (host && host->bus == dev->bus)
+		host = host->parent;
+	if (!host || !host->parent)
+		return NULL;
+	pcie = apple_h9p_pcie_lookup(host->parent);
+	if (!pcie || apple_h9p_pcie_device_port(pcie, dev) != 0)
+		return NULL;
+	return pcie;
+}
+
+int apple_ans_nvmmu_drain(struct device *dev)
+{
+	struct apple_h9p_pcie *pcie = apple_ans_endpoint_host(dev);
+	u32 fifo;
+
+	if (!pcie || !pcie->nvmmu.ready)
+		return -ENODEV;
+	if (!pcie->hw->nvmmu_inv_fifo)
+		return 0;
+	if (!bitmap_empty(pcie->nvmmu.mapped, APPLE_ANS_NVMMU_MAX_REQS))
+		return -EBUSY;
+
+	return readl_poll_timeout(pcie->base_port[0] +
+				  S8003_PORT_NVMMU_INV_FIFO, fifo,
+				  fifo & S8003_PORT_NVMMU_INV_FIFO_EMPTY, 10,
+				  S8003_NVMMU_INV_FIFO_TIMEOUT_US);
+}
+EXPORT_SYMBOL_GPL(apple_ans_nvmmu_drain);
+
+int apple_ans_stopped(struct device *dev)
+{
+	struct apple_h9p_pcie *pcie = apple_ans_endpoint_host(dev);
+	int ret;
+
+	/* The last invalidate has to leave the FIFO as well */
+	ret = apple_ans_nvmmu_drain(dev);
+	if (ret)
+		return ret;
+
+	WRITE_ONCE(pcie->nvmmu.ans_stopped, true);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_ans_stopped);
+
 static bool apple_h9p_ltssm_link_up(u32 ltssm)
 {
 	return ltssm >= H9P_PORT_LTSSM_L0 && ltssm <= H9P_PORT_LTSSM_L1_IDLE;
diff --git a/include/linux/apple-ans.h b/include/linux/apple-ans.h
index a59861010..96910c2cc 100644
--- a/include/linux/apple-ans.h
+++ b/include/linux/apple-ans.h
@@ -21,7 +21,26 @@ struct device;
 int apple_ans_nvmmu_map(struct device *dev, unsigned int tag,
 			const u64 *pages, unsigned int npages,
 			bool to_memory, dma_addr_t *iova);
+/*
+ * System sleep, in which the storage port loses power.
+ * apple_ans_nvmmu_drain(): no request is mapped and the NVMMU has no
+ * invalidation left to do. apple_ans_stopped(): the controller is disabled
+ * and off the bus and its translations are retired, so the host may power
+ * the port off.
+ */
+int apple_ans_nvmmu_drain(struct device *dev);
+int apple_ans_stopped(struct device *dev);
 #else
+static inline int apple_ans_nvmmu_drain(struct device *dev)
+{
+	return -ENODEV;
+}
+
+static inline int apple_ans_stopped(struct device *dev)
+{
+	return -ENODEV;
+}
+
 static inline int apple_ans_nvmmu_map(struct device *dev, unsigned int tag,
 				      const u64 *pages, unsigned int npages,
 				      bool to_memory, dma_addr_t *iova)
