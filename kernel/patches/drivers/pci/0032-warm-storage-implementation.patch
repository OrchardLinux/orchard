diff --git a/kernel/power/power.h b/kernel/power/power.h
index 75b638438..1de8fe895 100644
--- a/kernel/power/power.h
+++ b/kernel/power/power.h
@@ -240,6 +240,7 @@ static inline void suspend_test_finish(const char *label) {}
 /* kernel/power/main.c */
 extern int pm_notifier_call_chain_robust(unsigned long val_up, unsigned long val_down);
 extern int pm_notifier_call_chain(unsigned long val);
+int pm_suspend_precheck_call_chain(suspend_state_t state);
 #endif
 
 #ifdef CONFIG_HIGHMEM
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index 57c442686..4c5da415a 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -591,6 +591,13 @@ static int enter_state(suspend_state_t state)
 	if (!mutex_trylock(&system_transition_mutex))
 		return -EBUSY;
 
+	error = pm_suspend_precheck_call_chain(state);
+	if (error) {
+		dpm_save_failed_step(SUSPEND_PREPARE);
+		mutex_unlock(&system_transition_mutex);
+		return error;
+	}
+
 	if (state == PM_SUSPEND_TO_IDLE)
 		s2idle_begin();
 
