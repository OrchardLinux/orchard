+int apple_ans_sleep_begin(struct device *dev)
+{
+	struct apple_h9p_pcie *pcie = apple_ans_endpoint_host(dev);
+
+	if (!pcie || h9p_suspend != 2 || !apple_s8003_handoff_enabled())
+		return -EBUSY;
+	WRITE_ONCE(pcie->ans_sleep_stopped, false);
+	return 0;
