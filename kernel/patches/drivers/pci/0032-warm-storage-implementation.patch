+static bool apple_h9p_sleep_consumer_busy(void)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	struct usb_role_switch *sw;
+	struct path root;
+	bool busy;
+
+	get_fs_root(current->fs, &root);
+	busy = root.dentry->d_sb->s_bdev &&
+	       MAJOR(root.dentry->d_sb->s_bdev->bd_dev) == NBD_MAJOR;
+	path_put(&root);
+
+	np = of_find_compatible_node(NULL, NULL, "gpu,s8003");
+	if (np) {
+		pdev = of_find_device_by_node(np);
+		if (pdev) {
+			busy |= pdev->dev.driver && pm_runtime_active(&pdev->dev);
+			put_device(&pdev->dev);
+		}
+		of_node_put(np);
+	}
+	np = of_find_compatible_node(NULL, NULL, "apple,s8000-usb-role-switch");
+	if (np) {
+		sw = usb_role_switch_find_by_fwnode(of_fwnode_handle(np));
+		if (!IS_ERR_OR_NULL(sw)) {
+			busy |= usb_role_switch_get_role(sw) == USB_ROLE_HOST;
+			usb_role_switch_put(sw);
+		}
+		of_node_put(np);
+	}
+	return busy;
+}
+
+static int apple_h9p_sleep_precheck(struct notifier_block *nb,
+				   unsigned long action, void *unused)
+{
+	struct apple_h9p_pcie *pcie = container_of(nb, struct apple_h9p_pcie,
+						 sleep_precheck);
+
+	if (action != PM_SUSPEND_TO_IDLE)
+		return NOTIFY_DONE;
+	if (h9p_suspend != 2 || !apple_s8003_handoff_enabled() ||
+	    apple_h9p_sleep_consumer_busy()) {
+		dev_warn(pcie->dev, "sleep refused before sync: suspend=2 and ans_keep_power=1 ans_boot_mode=handoff required; active GPU/USB host or NBD root forbidden\n");
+		return notifier_from_errno(-EBUSY);
+	}
+	return NOTIFY_DONE;
+}
+
+static void apple_h9p_sleep_unregister(void *data)
+{
+	struct apple_h9p_pcie *pcie = data;
+
+	unregister_pm_suspend_precheck_notifier(&pcie->sleep_precheck);
+}
+
+static int apple_h9p_sleep_register(struct apple_h9p_pcie *pcie)
+{
+	int ret;
+
+	if (!of_device_is_compatible(pcie->dev->of_node, "apple,s8003-pcie"))
+		return 0;
+	pcie->sleep_precheck.notifier_call = apple_h9p_sleep_precheck;
+	ret = register_pm_suspend_precheck_notifier(&pcie->sleep_precheck);
+	if (ret)
+		return ret;
+	return devm_add_action_or_reset(pcie->dev, apple_h9p_sleep_unregister, pcie);
+}
+
+static int apple_h9p_s8003_suspend(struct device *dev)
+{
+	struct apple_h9p_pcie *pcie = apple_h9p_pcie_lookup(dev);
+	int ret;
+
+	if (!of_device_is_compatible(dev->of_node, "apple,s8003-pcie"))
+		return 0;
+	if (h9p_suspend != 2 || !apple_s8003_handoff_enabled() ||
+	    !READ_ONCE(pcie->ans_sleep_stopped) || !apple_s8003_port_powered(pcie))
+		return -EBUSY;
+	cancel_delayed_work_sync(&pcie->late_work);
+	ret = gpiod_direction_output(pcie->perst[0], 1);
+	if (ret)
+		return ret;
+	apple_s8003_drain_link(pcie, READ_ONCE(ans_sleep_flush));
+	ret = apple_s8003_port_stop(pcie, 0);
+	if (ret) {
+		/* PM skips resume for a parent whose suspend failed. Restore now. */
+		apple_s8003_powered_reset(pcie, READ_ONCE(ans_sleep_flush));
+		return ret;
+	}
+	pcie->ans_sleep_powered = true;
+	dev_info(dev, "ANS sleep powered under PERST; no full-cycle fallback\n");
+	return 0;
+}
+
+static int apple_h9p_s8003_resume(struct device *dev)
+{
+	struct apple_h9p_pcie *pcie = apple_h9p_pcie_lookup(dev);
+	int ret;
+
+	apple_h9p_crash_resume_test(dev);
+
+	if (!of_device_is_compatible(dev->of_node, "apple,s8003-pcie") ||
+	    !pcie->ans_sleep_powered)
+		return 0;
+	ret = apple_s8003_powered_reset(pcie, READ_ONCE(ans_sleep_flush));
+	pcie->ans_sleep_powered = false;
+	WRITE_ONCE(pcie->ans_sleep_stopped, false);
+	if (ret)
+		dev_err(dev, "ANS powered resume failed %d; endpoint isolated under PERST\n", ret);
+	else
+		dev_info(dev, "ANS powered resume trained, try=first\n");
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(apple_h9p_s8003_pm_ops,
+			       apple_h9p_s8003_suspend, apple_h9p_s8003_resume);
