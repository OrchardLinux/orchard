 		dev_warn(dev->ctrl.device,
 			 "I/O tag %d (%04x) opcode %#x (%s) QID %d timeout, reset controller\n",
@@ -2804,7 +2863,32 @@ static umode_t nvme_pci_attrs_are_visible(struct kobject *kobj,
 	return a->mode;
 }
 
+static ssize_t apple_ans_diag_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct nvme_dev *ndev = to_nvme_dev(dev_get_drvdata(dev));
+	u32 cc, csts;
+
+	if (ndev->dma_ops != &nvme_pci_apple_ans_ops)
+		return -EOPNOTSUPP;
+	if (!sysfs_streq(buf, "host") && !sysfs_streq(buf, "endpoint"))
+		return -EINVAL;
+	mutex_lock(&ndev->shutdown_lock);
+	nvme_apple_ans_dump(ndev, "sysfs");
+	if (sysfs_streq(buf, "endpoint") && apple_ans_link_up(ndev->dev) > 0) {
+		if (!ndev->dma_ops->read_csts(ndev, &csts)) {
+			cc = readl(ndev->bar + NVME_REG_CC);
+			dev_info(dev, "ANS endpoint CC %#x CSTS %#x\n", cc, csts);
+		}
+	}
+	mutex_unlock(&ndev->shutdown_lock);
+	return count;
+}
+static DEVICE_ATTR_WO(apple_ans_diag);
+
 static struct attribute *nvme_pci_attrs[] = {
+	&dev_attr_apple_ans_diag.attr,
 	&dev_attr_cmb.attr,
 	&dev_attr_cmbloc.attr,
 	&dev_attr_cmbsz.attr,
@@ -3283,11 +3367,69 @@ static bool nvme_pci_ctrl_is_dead(struct nvme_dev *dev)
 	return (csts & NVME_CSTS_CFS) || !(csts & NVME_CSTS_RDY);
 }
 
-static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
+/* SPDX-License-Identifier: GPL-2.0-only */
+static bool apple_ans_sleep_pair = true;
+module_param(apple_ans_sleep_pair, bool, 0644);
+static bool apple_ans_sleep_cc0_ok;
+module_param(apple_ans_sleep_cc0_ok, bool, 0644);
+
+static int nvme_apple_ans_sleep_precheck(struct notifier_block *nb,
+					  unsigned long action, void *unused)
+{
+	if (action == PM_SUSPEND_TO_IDLE &&
+	    of_machine_is_compatible("apple,s8003") &&
+	    !READ_ONCE(apple_ans_sleep_pair))
+		return notifier_from_errno(-EBUSY);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block nvme_apple_ans_sleep_nb = {
+	.notifier_call = nvme_apple_ans_sleep_precheck,
+};
+
+/* SHST alone does not certify a stopped controller. Keep endpoint MMIO before
+ * clearing BME and retiring translations, as in suspend-r1c/r1d. */
+static int nvme_apple_ans_sleep_disable(struct nvme_dev *dev, int shutdown_ret)
+{
+	struct pci_dev *pdev = to_pci_dev(dev->dev);
+	u32 csts = ~0U, cc, expected;
+	int ret, err;
+
+	ret = dev->dma_ops->read_csts(dev, &csts);
+	if (shutdown_ret || ret || (csts & NVME_CSTS_CFS) ||
+	    (csts & NVME_CSTS_SHST_MASK) != NVME_CSTS_SHST_CMPLT) {
+		pci_clear_master(pdev);
+		return -EBUSY;
+	}
+	dev->ctrl.ctrl_config &= ~(NVME_CC_ENABLE | NVME_CC_SHN_MASK);
+	expected = dev->ctrl.ctrl_config;
+	ret = dev->dma_ops->write_cc(dev, expected);
+	if (!ret) {
+		ret = read_poll_timeout(dev->dma_ops->read_csts, err,
+				       err || !(csts & NVME_CSTS_RDY),
+				       1000, 2000000, false, dev, &csts);
+		if (!ret)
+			ret = err;
+	}
+	if (ret)
+		goto block_dma;
+	cc = readl(dev->bar + NVME_REG_CC);
+	if ((!kexec_in_progress && csts) || (csts & NVME_CSTS_CFS) ||
+	    (cc & (NVME_CC_ENABLE | NVME_CC_SHN_MASK)) ||
+	    (!kexec_in_progress && cc != expected &&
+	     !(READ_ONCE(apple_ans_sleep_cc0_ok) && !cc)))
+		ret = -EBUSY;
+block_dma:
+	pci_clear_master(pdev);
+	return ret;
+}
+
+static int nvme_dev_disable_paired(struct nvme_dev *dev, bool shutdown, bool paired)
 {
 	enum nvme_ctrl_state state = nvme_ctrl_state(&dev->ctrl);
 	struct pci_dev *pdev = to_pci_dev(dev->dev);
 	bool dead;
+	int ret = paired ? -EBUSY : 0;
 
 	mutex_lock(&dev->shutdown_lock);
 	dead = nvme_pci_ctrl_is_dead(dev);
@@ -3298,15 +3440,26 @@ static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
 		 * Give the controller a chance to complete all entered requests
 		 * if doing a safe shutdown.
 		 */
-		if (!dead && shutdown)
-			nvme_wait_freeze_timeout(&dev->ctrl);
+		if (!dead && shutdown && nvme_wait_freeze_timeout(&dev->ctrl) <= 0 && paired)
+			panic("Apple ANS: outgoing I/O did not drain; refusing kexec");
 	}
 
 	nvme_quiesce_io_queues(&dev->ctrl);
 
+	if (paired && (dead || !dev->ctrl.queue_count))
+		panic("Apple ANS: dead outgoing controller; refusing kexec");
 	if (!dead && dev->ctrl.queue_count > 0) {
+		if (paired) {
+			nvme_sync_io_queues(&dev->ctrl);
+			ret = apple_ans_nvmmu_drain(dev->dev);
+			if (ret)
+				panic("Apple ANS: outgoing drain failed %d; refusing kexec", ret);
+		}
 		nvme_delete_io_queues(dev);
-		nvme_disable_ctrl(&dev->ctrl, shutdown);
+		dev_info(dev->dev, "Apple ANS: shutdown starting NVMe SHN paired=%u\n", paired);
+		ret = nvme_disable_ctrl(&dev->ctrl, shutdown);
+		if (paired)
+			ret = nvme_apple_ans_sleep_disable(dev, ret);
 		nvme_poll_irqdisable(&dev->queues[0]);
 	}
 	nvme_suspend_io_queues(dev);
@@ -3329,7 +3482,15 @@ static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
 		if (dev->ctrl.admin_q && !blk_queue_dying(dev->ctrl.admin_q))
 			nvme_unquiesce_admin_queue(&dev->ctrl);
 	}
+	if (paired && !ret)
+		ret = apple_ans_sleep_stopped(dev->dev);
 	mutex_unlock(&dev->shutdown_lock);
+	return ret;
+}
+
+static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
+{
+	nvme_dev_disable_paired(dev, shutdown, false);
 }
 
 static int nvme_disable_prepare_reset(struct nvme_dev *dev, bool shutdown)
@@ -3775,7 +3936,10 @@ static int nvme_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	struct nvme_dev *dev;
 	int result = -ENOMEM;
 
+	if (!nvme_pci_apple_ans_probe_allowed(pdev))
+		return -EPROBE_DEFER;
 	dev = nvme_pci_alloc_dev(pdev, id);
+
 	if (IS_ERR(dev))
 		return PTR_ERR(dev);
 
@@ -3920,6 +4084,12 @@ static void nvme_shutdown(struct pci_dev *pdev)
 {
 	struct nvme_dev *dev = pci_get_drvdata(pdev);
 
+	if (kexec_in_progress && apple_ans_is_s8003(dev->dev) &&
+	    dev->dma_ops == &nvme_pci_apple_ans_ops && !apple_ans_handoff_begin(dev->dev)) {
+		if (!nvme_wait_reset(&dev->ctrl) || nvme_dev_disable_paired(dev, true, true))
+			panic("Apple ANS: refusing unsafe powered kexec handoff");
+		return;
+	}
 	nvme_disable_prepare_reset(dev, true);
 }
 
@@ -3970,6 +4140,14 @@ static int nvme_resume(struct device *dev)
 	struct nvme_dev *ndev = pci_get_drvdata(to_pci_dev(dev));
 	struct nvme_ctrl *ctrl = &ndev->ctrl;
 
+	if (apple_ans_is_s8003(ndev->dev) && ndev->dma_ops == &nvme_pci_apple_ans_ops &&
+	    ndev->last_ps == U32_MAX) {
+		int ret = apple_ans_dart_set_active(ndev->dev, true);
+
+		if (ret)
+			return ret;
+	}
+
 	if (ndev->last_ps == U32_MAX ||
 	    nvme_set_power_state(ctrl, ndev->last_ps) != 0)
 		goto reset;
@@ -3989,6 +4167,19 @@ static int nvme_suspend(struct device *dev)
 	int ret = -EBUSY;
 
 	ndev->last_ps = U32_MAX;
+	if (apple_ans_is_s8003(ndev->dev) && ndev->dma_ops == &nvme_pci_apple_ans_ops) {
+		if (!READ_ONCE(apple_ans_sleep_pair) || apple_ans_sleep_begin(ndev->dev))
+			return -EBUSY;
+		if (nvme_ctrl_state(ctrl) != NVME_CTRL_LIVE ||
+		    !nvme_change_ctrl_state(ctrl, NVME_CTRL_RESETTING))
+			return -EBUSY;
+		ret = nvme_dev_disable_paired(ndev, true, true);
+		if (ret) {
+			apple_ans_dart_set_active(ndev->dev, true);
+			nvme_try_sched_reset(ctrl);
+		}
+		return ret;
+	}
 
