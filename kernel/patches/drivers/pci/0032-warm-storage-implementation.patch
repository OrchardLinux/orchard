 static int nvme_pci_apple_ans_write_cc(struct nvme_dev *dev, u32 cc)
 {
 	struct apple_ans_nvme *ans = nvme_pci_apple_ans(dev);
 
+	if (nvme_pci_apple_ans_check_link(dev))
+		return -EIO;
 	writel(cc, dev->bar + NVME_REG_CC);
 	if (!ans)
 		return 0;
@@ -349,6 +379,8 @@ static int nvme_pci_apple_ans_read_csts(struct nvme_dev *dev, u32 *csts)
 	struct apple_ans_nvme *ans = nvme_pci_apple_ans(dev);
 	unsigned long deadline;
 
+	if (nvme_pci_apple_ans_check_link(dev))
+		return -EIO;
 	*csts = readl(dev->bar + NVME_REG_CSTS);
 	if (!ans || !ans->cc_written || !ans->host->rdy_timeout_ms ||
 	    (ans->cc & NVME_CC_SHN_MASK))
@@ -360,6 +392,8 @@ static int nvme_pci_apple_ans_read_csts(struct nvme_dev *dev, u32 *csts)
 	    time_after(jiffies, deadline)) {
 		dev_err(dev->dev, "ANS RDY timeout (CC %#x, CSTS %#x)\n",
 			ans->cc, *csts);
+		ans->host_fault = true;
+		apple_ans_host_dump(dev->dev, "RDY deadline");
 		return -ETIMEDOUT;
