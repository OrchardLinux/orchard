From: brkosebay <brkosebay@users.noreply.github.com>
Date: Sun, 08 Nov 2026 16:00:00 +0100
Subject: [PATCH] PCI: apple-h9p: PCI/NVMe: retain the stopped ANS handoff across kexec

Pair the S8003 H9P powered handoff with an ANS stop certificate covering SHST, CC/RDY, BME, queue/tag retirement, final NVMMU FIFO acknowledgement and endpoint DART shutdown. Include the final fatal-kexec drain/isolation correction and the modular kexec-state export required by NVMe. Failed stops withhold the certificate; failed powered resume stays under PERST. Real suspend/resume and the Orchard warm ladder remain pending, with no automatic suspend enablement.

Integration fixups are folded into the final delta. Device observations apply
to the integration build; the isolated topic requires qualification.

Assisted-by: LLM
---

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 1ee6add55..7906595cd 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -35,6 +35,7 @@
 #include <linux/types.h>
 
 #include <linux/apple-dart.h>
+#include <linux/apple-ans.h>
 
 #include "dma-iommu.h"
 
@@ -1009,6 +1010,37 @@ apple_dart_setup_translation(struct apple_dart_domain *domain,
 	return dart->hw->invalidate_tlb(stream_map);
 }
 
+int apple_ans_dart_set_active(struct device *dev, bool active)
+{
+	struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
+	struct apple_dart_master_cfg *cfg = dev_iommu_priv_get(dev);
+	struct apple_dart_stream_map *map;
+	struct apple_dart_domain *d;
+	int i, ret;
+
+	if (!of_machine_is_compatible("apple,j71t") || !domain || !cfg ||
+	    !cfg->stream_maps[0].dart ||
+	    (domain->type != IOMMU_DOMAIN_DMA && domain->type != IOMMU_DOMAIN_DMA_FQ))
+		return -ENODEV;
+	d = to_dart_domain(domain);
+	for_each_stream_map(i, cfg, map) {
+		if (map->dart->hw->type != DART_S5L8960X)
+			return -EOPNOTSUPP;
+		if (!active) {
+			apple_dart_hw_disable_dma(map);
+			continue;
+		}
+		ret = apple_dart_setup_translation(d, map);
+		if (ret)
+			return ret;
+	}
+	if (active)
+		WRITE_ONCE(d->flush_error, 0);
+	dev_info(dev, "Apple ANS: DART force_active(%u) complete\n", active);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_ans_dart_set_active);
+
 static int apple_dart_finalize_domain(struct apple_dart_domain *dart_domain,
 				      struct apple_dart_master_cfg *cfg)
 {
