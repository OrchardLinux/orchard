+/* release6: caller froze and synchronized I/O, before SHN. */
+/* Lab 0018: caller synchronized queues and stopped CC/RDY before this. */
+int apple_ans_nvmmu_reset(struct device *dev)
+{
+	struct apple_h9p_pcie *pcie = apple_ans_endpoint_host(dev);
+	struct apple_h9p_nvmmu *nvmmu;
+	int ret;
+
+	if (!pcie || !(pcie->enabled_ports & BIT(0)))
+		return -ENODEV;
+	nvmmu = &pcie->nvmmu;
+	if (!nvmmu->ready)
+		return -ENODEV;
+	memset(nvmmu->tcb, 0, nvmmu->tcb_size);
+	memset(nvmmu->tcb_table, 0, nvmmu->tcb_table_size);
+	memset(nvmmu->tcb_sgl, 0, nvmmu->tcb_sgl_size);
+	ret = apple_h9p_nvmmu_program(pcie);
+	WRITE_ONCE(nvmmu->poisoned, !!ret);
+	if (ret)
+		return ret;
+	bitmap_zero(nvmmu->mapped, APPLE_ANS_NVMMU_MAX_REQS);
+	dev_info(dev, "NVMMU: stopped-controller cache/SART rebuilt\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_ans_nvmmu_reset);
+
+bool apple_ans_is_s8003(struct device *dev)
+{
+	return apple_ans_endpoint_host(dev) != NULL;
+}
+EXPORT_SYMBOL_GPL(apple_ans_is_s8003);
