+	if ((flush & 2) && (readl(pcie->base_port[0] + S8003_PORT_LINKSTS) & BIT(0))) {
+		h9p_rmw(pcie->base_port[0] + H9P_PORT_LTSSMCTL, 0, H9P_PORT_LTSSM_ENABLE);
+		readl_poll_timeout(pcie->base_port[0] + S8003_PORT_LINKSTS, val,
+				   !(val & BIT(0)), 10, 100000);
+		return apple_s8003_port_stop(pcie, 0);
+	}
+	return 0;
+}
+
+static int apple_s8003_powered_reset(struct apple_h9p_pcie *pcie, unsigned int flush)
+{
+	int ret;
