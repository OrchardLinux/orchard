From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:27:24 +0100
Subject: [PATCH] dt-bindings: pci: apple,t8010-pcie: Add the S8000

The S8000 (Samsung A9) has the S8003's root complex without the
"phy-ip" register window, so its node has eight register windows. The
rest, power domains instead of clocks and the storage-port NVMMU,
follows the S8003.

Assisted-by: LLM
---
 .../bindings/pci/apple,t8010-pcie.yaml        | 48 ++++++++++++++++---
 1 file changed, 41 insertions(+), 7 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml b/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
index bf96da5b1..d03cbf0ee 100644
--- a/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
@@ -4,17 +4,17 @@
 $id: http://devicetree.org/schemas/pci/apple,t8010-pcie.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple S8003, T7000, T8010 and T8015 PCIe host controller
+title: Apple S8000, S8003, T7000, T8010 and T8015 PCIe host controller
 
 maintainers:
   - Paul Praschl <praschlpaul@g-p.at>
 
 description: |
-  Apple A9/S8003 (TSMC), A10/T8010 and A11/T8015 devices use the H8P/H9P
-  PCIe root complex for internal storage and Wi-Fi. It exposes one ECAM
-  window shared by up to four root ports, controller-specific PHY and port
-  register windows, and a local MSI block. The SoCs share this register map
-  but need different power-up and link training sequences.
+  Apple A9 (S8000, Samsung; S8003, TSMC), A10/T8010 and A11/T8015 devices
+  use the H8P/H9P PCIe root complex for internal storage and Wi-Fi. It
+  exposes one ECAM window shared by up to four root ports, controller-specific
+  PHY and port register windows, and a local MSI block. The SoCs share this
+  register map but need different power-up and link training sequences.
 
   The storage port also contains an NVMMU which translates the proprietary
   Apple ANS FlatDMA format. Unlike a general-purpose IOMMU, this block uses a
@@ -22,6 +22,9 @@ description: |
   window. The PCIe driver owns that NVMMU state and exposes it only to the ANS
   NVMe glue.
 
+  The S8000 has the S8003's root complex without its "phy-ip" window: its
+  PHY lanes are set up through the "phy" window alone.
+
   The T8015 has no PCIe storage port: its NVMe controller is the separate
   ANS2 block, so the T8015 has no storage-port NVMMU and none of its
   properties.
@@ -113,6 +116,7 @@ allOf:
           compatible:
             contains:
               enum:
+                - apple,s8000-pcie
                 - apple,t7000-pcie
                 - apple,t8015-pcie
     then:
@@ -143,11 +147,39 @@ allOf:
         - clock-names
         - apple,nvmmu-iova
         - apple,nvme-hmb
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,s8000-pcie
+    then:
+      properties:
+        reg:
+          minItems: 8
+          maxItems: 8
+        reg-names:
+          items:
+            - const: config
+            - const: rc
+            - const: phy
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
+            - const: nvmmu
+        interrupts:
+          minItems: 5
+        interrupt-names:
+          minItems: 5
+      required:
+        - apple,nvmmu-iova
+        - apple,nvme-hmb
 
 properties:
   compatible:
     oneOf:
       - enum:
+          - apple,s8000-pcie
           - apple,s8003-pcie
           - apple,t7000-pcie
           - apple,t8010-pcie
@@ -340,7 +372,9 @@ if:
   properties:
     compatible:
       contains:
-        const: apple,s8003-pcie
+        enum:
+          - apple,s8000-pcie
+          - apple,s8003-pcie
 then:
   properties:
     clocks: false
