 	int irq;
 	int ret;
 
@@ -1630,55 +1692,10 @@ static int apple_h9p_setup_nvmmu(struct apple_h9p_pcie *pcie)
 	}
 
 	spin_lock_init(&nvmmu->inv_lock);
