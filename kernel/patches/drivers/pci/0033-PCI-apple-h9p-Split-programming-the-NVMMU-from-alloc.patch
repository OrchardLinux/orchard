 {
 	struct apple_h9p_nvmmu *nvmmu = &pcie->nvmmu;
@@ -1561,7 +1623,7 @@ static int apple_h9p_setup_nvmmu(struct apple_h9p_pcie *pcie)
 	struct device_node *mem_np;
 	struct resource res;
 	resource_size_t size;
