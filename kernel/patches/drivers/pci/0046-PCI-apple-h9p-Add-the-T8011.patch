+		dev_err(pcie->dev, "common PHY initialization wait failed: %d (RC[%#x]=%#x)\n",
+			ret, T8011_RC_COMMON_STAT,
+			readl(pcie->base_rc + T8011_RC_COMMON_STAT));
+		return ret;
+	}
+
+	h9p_rmw(pcie->base_rc + 0x30, BIT(0), 0);
+	apple_t8011_apply_common_tunables(pcie);
+	return 0;
+}
