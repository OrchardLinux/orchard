From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Tue, 24 Nov 2026 03:00:54 +0800
Subject: [PATCH] dt-bindings: pci: apple,t8010-pcie: Add the T8011

The A10X (T8011) has the H9P root complex with six root ports and the
storage-port NVMMU: eleven register windows and seven interrupts. Root
ports can name the MSI vectors the firmware assigns them (the ADT's
msi-vector-base and #msi-vectors), which on the T8011 are not eight per
port.

[Orchard: from OrchardLinux/orchard#205 (tompta1, 09038adf),
 kernel/patches/drivers/pci/0041; the board-named "apple,j120-pcie" and
 "apple,j120-wifi-pcie-port" compatibles dropped for "apple,t8011-pcie", the
 NVMMU window, interrupt and properties described, the port WLAN UART
 property dropped (it belongs to the Wi-Fi device node).]

Assisted-by: LLM
---
 .../bindings/pci/apple,t8010-pcie.yaml        | 100 +++++++++++++++---
 1 file changed, 86 insertions(+), 14 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml b/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
index d03cbf0ee..cb43a5307 100644
--- a/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
@@ -4,18 +4,21 @@
 $id: http://devicetree.org/schemas/pci/apple,t8010-pcie.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple S8000, S8003, T7000, T8010 and T8015 PCIe host controller
+title: Apple S8000, S8003, T7000, T8010, T8011 and T8015 PCIe host controller
 
 maintainers:
   - Paul Praschl <praschlpaul@g-p.at>
 
 description: |
-  Apple A9 (S8000, Samsung; S8003, TSMC), A10/T8010 and A11/T8015 devices
-  use the H8P/H9P PCIe root complex for internal storage and Wi-Fi. It
+  Apple A9 (S8000, Samsung; S8003, TSMC), A10/T8010, A10X/T8011 and
+  A11/T8015 devices use the H8P/H9P PCIe root complex for internal storage and Wi-Fi. It
   exposes one ECAM window shared by up to four root ports, controller-specific
   PHY and port register windows, and a local MSI block. The SoCs share this
   register map but need different power-up and link training sequences.
 
+  The T8011 has six root ports and different common and pipe-clock
+  registers; its storage port is port 0, with the NVMMU.
+
   The storage port also contains an NVMMU which translates the proprietary
   Apple ANS FlatDMA format. Unlike a general-purpose IOMMU, this block uses a
   loader-provided, physically contiguous host-memory buffer and a fixed IOVA
@@ -110,6 +113,65 @@ allOf:
       required:
         - clocks
         - clock-names
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8011-pcie
+    then:
+      properties:
+        reg:
+          minItems: 11
+          maxItems: 11
+        reg-names:
+          items:
+            - const: config
+            - const: rc
+            - const: phy
+            - const: phy-ip
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
+            - const: port4
+            - const: port5
+            - const: nvmmu
+        interrupts:
+          minItems: 7
+          maxItems: 7
+        interrupt-names:
+          items:
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
+            - const: port4
+            - const: port5
+            - const: nvmmu
+        apple,preinit-phy-port-mask: false
+      required:
+        - clocks
+        - clock-names
+        - apple,nvmmu-iova
+        - apple,nvme-hmb
+    else:
+      properties:
+        interrupts:
+          maxItems: 5
+        interrupt-names:
+          items:
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
+            - const: nvmmu
+      patternProperties:
+        '^pci@[45],0$': false
+        '^pci@[0-3],0$':
+          properties:
+            apple,phy-lane:
+              maximum: 3
+
   - if:
       not:
         properties:
@@ -118,6 +180,7 @@ allOf:
               enum:
                 - apple,s8000-pcie
                 - apple,t7000-pcie
+                - apple,t8011-pcie
                 - apple,t8015-pcie
     then:
       properties:
@@ -125,7 +188,6 @@ allOf:
           minItems: 9
           maxItems: 9
         reg-names:
-          maxItems: 9
           items:
             - const: config
             - const: rc
@@ -183,6 +245,7 @@ properties:
           - apple,s8003-pcie
           - apple,t7000-pcie
           - apple,t8010-pcie
+          - apple,t8011-pcie
           - apple,t8015-pcie
       - items:
           - const: apple,j172-pcie
@@ -190,27 +253,24 @@ properties:
 
   reg:
     minItems: 4
-    maxItems: 9
+    maxItems: 11
 
   reg-names:
     minItems: 4
-    maxItems: 9
+    maxItems: 11
 
   interrupts:
     description:
       One state interrupt for each root port followed, on the SoCs with a
       storage-port NVMMU, by its fault interrupt.
     minItems: 2
-    maxItems: 5
+    maxItems: 7
 
   interrupt-names:
     minItems: 2
+    maxItems: 7
     items:
-      - const: port0
-      - const: port1
-      - const: port2
-      - const: port3
-      - const: nvmmu
+      enum: [port0, port1, port2, port3, port4, port5, nvmmu]
 
   clocks:
     minItems: 2
@@ -270,7 +330,7 @@ properties:
     const: 1
 
 patternProperties:
-  '^pci@[0-3],0$':
+  '^pci@[0-5],0$':
     type: object
     properties:
       reg:
@@ -300,9 +360,21 @@ patternProperties:
           the controller's Link Capabilities registers when runtime speed
           retraining is not implemented for the port.
 
+      apple,msi-vector-range:
+        $ref: /schemas/types.yaml#/definitions/uint32-array
+        description:
+          First local MSI vector and number of consecutive vectors assigned to
+          this port. The range must fit the host MSI window, be aligned to its
+          power-of-two size and not overlap another enabled port. When omitted,
+          the port uses eight vectors starting at eight times its port index.
+        items:
+          - minimum: 0
+            maximum: 31
+          - enum: [1, 2, 4, 8]
+
       apple,phy-lane:
         $ref: /schemas/types.yaml#/definitions/uint32
-        maximum: 3
+        maximum: 5
         description:
           PHY IP calibration lane used by this root port. If omitted, the
           root-port number is used.
