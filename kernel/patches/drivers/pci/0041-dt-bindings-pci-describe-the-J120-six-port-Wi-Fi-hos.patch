From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:39:54 +0100
Subject: [PATCH] dt-bindings: pci: describe the J120 six-port Wi-Fi host

Describe T8011 controller resources and its J120 Wi-Fi port, four-vector MSI allocation, deferred endpoint power and WLAN UART dependency. Keep the storage NVMMU outside this profile.

Assisted-by: LLM
---
 .../bindings/pci/apple,t8010-pcie.yaml        | 116 ++++++++++++++++--
 1 file changed, 104 insertions(+), 12 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml b/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
index bf96da5b1..74cc83f72 100644
--- a/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,t8010-pcie.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/pci/apple,t8010-pcie.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple S8003, T7000, T8010 and T8015 PCIe host controller
+title: Apple S8003, T7000, T8010, T8011 and T8015 PCIe host controller
 
 maintainers:
   - Paul Praschl <praschlpaul@g-p.at>
@@ -16,6 +16,10 @@ description: |
   register windows, and a local MSI block. The SoCs share this register map
   but need different power-up and link training sequences.
 
+  The T8011 has six root ports and different common/pipe-clock registers.
+  The J120 description exposes its Wi-Fi port with a four-vector MSI range;
+  its storage-port NVMMU is omitted from this description.
+
   The storage port also contains an NVMMU which translates the proprietary
   Apple ANS FlatDMA format. Unlike a general-purpose IOMMU, this block uses a
   loader-provided, physically contiguous host-memory buffer and a fixed IOVA
@@ -107,6 +111,78 @@ allOf:
       required:
         - clocks
         - clock-names
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8011-pcie
+    then:
+      properties:
+        reg:
+          minItems: 10
+          maxItems: 10
+        reg-names:
+          items:
+            - const: config
+            - const: rc
+            - const: phy
+            - const: phy-ip
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
+            - const: port4
+            - const: port5
+        interrupts:
+          minItems: 6
+          maxItems: 6
+        interrupt-names:
+          items:
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
+            - const: port4
+            - const: port5
+        apple,nvmmu-iova: false
+        apple,nvme-hmb: false
+        apple,preinit-phy-port-mask: false
+        pci@2,0:
+          type: object
+          properties:
+            compatible:
+              items:
+                - const: apple,j120-wifi-pcie-port
+                - const: pciclass,0604
+            vdd-supply:
+              description: WLAN REG_ON supply controlled before enumeration.
+          required:
+            - compatible
+            - apple,wlan-uart
+            - vdd-supply
+            - apple,endpoint-power-after-link-setup
+      required:
+        - clocks
+        - clock-names
+        - pci@2,0
+    else:
+      properties:
+        interrupts:
+          maxItems: 5
+        interrupt-names:
+          items:
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
+            - const: nvmmu
+      patternProperties:
+        '^pci@[45],0$': false
+        '^pci@[0-3],0$':
+          properties:
+            apple,phy-lane:
+              maximum: 3
+
   - if:
       not:
         properties:
@@ -114,6 +190,7 @@ allOf:
             contains:
               enum:
                 - apple,t7000-pcie
+                - apple,t8011-pcie
                 - apple,t8015-pcie
     then:
       properties:
@@ -121,7 +198,6 @@ allOf:
           minItems: 9
           maxItems: 9
         reg-names:
-          maxItems: 9
           items:
             - const: config
             - const: rc
@@ -152,33 +228,33 @@ properties:
           - apple,t7000-pcie
           - apple,t8010-pcie
           - apple,t8015-pcie
+      - items:
+          - const: apple,j120-pcie
+          - const: apple,t8011-pcie
       - items:
           - const: apple,j172-pcie
           - const: apple,t8010-pcie
 
   reg:
     minItems: 4
-    maxItems: 9
+    maxItems: 10
 
   reg-names:
     minItems: 4
-    maxItems: 9
+    maxItems: 10
 
   interrupts:
     description:
       One state interrupt for each root port followed, on the SoCs with a
       storage-port NVMMU, by its fault interrupt.
     minItems: 2
-    maxItems: 5
+    maxItems: 6
 
   interrupt-names:
     minItems: 2
+    maxItems: 6
     items:
-      - const: port0
-      - const: port1
-      - const: port2
-      - const: port3
-      - const: nvmmu
+      enum: [port0, port1, port2, port3, port4, port5, nvmmu]
 
   clocks:
     minItems: 2
@@ -238,7 +314,7 @@ properties:
     const: 1
 
 patternProperties:
-  '^pci@[0-3],0$':
+  '^pci@[0-5],0$':
     type: object
     properties:
       reg:
@@ -268,9 +344,25 @@ patternProperties:
           the controller's Link Capabilities registers when runtime speed
           retraining is not implemented for the port.
 
+      apple,wlan-uart:
+        $ref: /schemas/types.yaml#/definitions/phandle
+        description: WLAN UART provider required before enabling REG_ON.
+
+      apple,msi-vector-range:
+        $ref: /schemas/types.yaml#/definitions/uint32-array
+        description:
+          First local MSI vector and number of consecutive vectors assigned to
+          this port. The range must fit the host MSI window, be aligned to its
+          power-of-two size and not overlap another enabled port. When omitted,
+          the port uses eight vectors starting at eight times its port index.
+        items:
+          - minimum: 0
+            maximum: 31
+          - enum: [1, 2, 4, 8]
+
       apple,phy-lane:
         $ref: /schemas/types.yaml#/definitions/uint32
-        maximum: 3
+        maximum: 5
         description:
           PHY IP calibration lane used by this root port. If omitted, the
           root-port number is used.
