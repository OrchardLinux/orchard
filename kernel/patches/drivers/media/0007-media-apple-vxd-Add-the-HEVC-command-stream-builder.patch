diff --git a/drivers/media/platform/apple/vxd/Makefile b/drivers/media/platform/apple/vxd/Makefile
index 7f692f8..0877a60 100644
--- a/drivers/media/platform/apple/vxd/Makefile
+++ b/drivers/media/platform/apple/vxd/Makefile
@@ -2,6 +2,6 @@
 apple-vxd-y := apple-vxd-core.o apple-vxd-gart.o apple-vxd-fw.o \
 	       apple-vxd-mbox.o apple-vxd-cmd.o apple-vxd-cmdbuf.o \
 	       apple-vxd-v4l2.o apple-vxd-h264.o apple-vxd-h264-parse.o \
-	       apple-vxd-h264-cmd.o
+	       apple-vxd-h264-cmd.o apple-vxd-hevc-cmd.o
 
 obj-$(CONFIG_VIDEO_APPLE_VXD) += apple-vxd.o
