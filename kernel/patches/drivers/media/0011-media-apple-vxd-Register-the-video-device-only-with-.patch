From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 16 Nov 2026 00:31:43 +0800
Subject: [PATCH] media: apple-vxd: Register the video device only with its
 firmware

The driver registered its video and media devices in probe and asked
for the DEVA firmware only on the first open. Without the firmware file
the system had a /dev/video node whose open() always failed with
-ENOENT. Userspace that enumerates V4L2 devices does not expect that:
WirePlumber 0.5's V4L2 monitor never finished creating the device, and
its stalled event queue left the sound card without a profile, so a
missing video decoder firmware cost the system its audio (seen on an
iPad 7, J171).

Ask for the firmware from probe with firmware_request_nowait_nowarn()
and register the V4L2 and media devices from its callback, once the
image is loaded and its size has been checked. Without the file the
driver stays bound, registers nothing and says once which file is
missing. The image is kept until the driver is unbound; the MTX still
boots from it on the first open, so a node that exists can always be
booted from, and a system with the firmware behaves as before.

remove() cancels a request that is still pending, or waits for its
callback, before it tears down what the callback may have registered.

Reported-by: Duke Eagleman <301139544+jerricky26@users.noreply.github.com>
Link: https://github.com/OrchardLinux/orchard/pull/132
Assisted-by: LLM
---
 drivers/media/platform/apple/vxd/Kconfig      |  3 +-
 .../media/platform/apple/vxd/apple-vxd-core.c | 10 +-
 .../media/platform/apple/vxd/apple-vxd-fw.c   | 94 ++++++++++++++-----
 .../media/platform/apple/vxd/apple-vxd-v4l2.c | 10 +-
 drivers/media/platform/apple/vxd/apple-vxd.h  |  8 +-
 5 files changed, 94 insertions(+), 31 deletions(-)

diff --git a/drivers/media/platform/apple/vxd/Kconfig b/drivers/media/platform/apple/vxd/Kconfig
index ef785fc8..09aed55f 100644
--- a/drivers/media/platform/apple/vxd/Kconfig
+++ b/drivers/media/platform/apple/vxd/Kconfig
@@ -14,7 +14,8 @@ config VIDEO_APPLE_VXD
 	  firmware. It is exposed as a V4L2 stateless H.264 decoder, and as
 	  an HEVC (H.265 Main) decoder on the SoCs whose decoder has it.
 
-	  The driver needs the DEVA firmware as apple/vxd-deva.bin.
+	  The driver needs the DEVA firmware as apple/vxd-deva.bin. Without
+	  that file it registers no video device.
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called apple-vxd.
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-core.c b/drivers/media/platform/apple/vxd/apple-vxd-core.c
index 2940978f..a9777b0f 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-core.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-core.c
@@ -5,8 +5,9 @@
  * Copyright (c) 2026 Berkay Kösebay <brkosebay@users.noreply.github.com>
  *
  * Probe powers the vdec domain, maps the 1 MiB register window, reads the
- * core identity and registers the V4L2 decoder. The DEVA firmware boots
- * on the first open of the video node (apple-vxd-fw.c).
+ * core identity and asks for the DEVA firmware file. The V4L2 decoder is
+ * registered once that file is loaded, and the firmware boots on the first
+ * open of the video node (apple-vxd-fw.c).
  */
 
 #include <linux/delay.h>
@@ -373,7 +374,7 @@ static int apple_vxd_probe(struct platform_device *pdev)
 	if (!ret)
 		ret = apple_vxd_hevc_register(vxd);
 	if (!ret)
-		ret = apple_vxd_v4l2_init(vxd);
+		ret = apple_vxd_fw_request(vxd);
 	if (ret)
 		goto err_gart_fini;
 
@@ -391,9 +392,12 @@ static void apple_vxd_remove(struct platform_device *pdev)
 {
 	struct apple_vxd_dev *vxd = platform_get_drvdata(pdev);
 
+	/* No video node appears from here on. */
+	apple_vxd_fw_request_cancel(vxd);
 	cancel_delayed_work_sync(&vxd->watchdog_work);
 	apple_vxd_v4l2_cleanup(vxd);
 	apple_vxd_fw_cleanup(vxd);
+	apple_vxd_fw_release(vxd);
 	/* fw_cleanup failed every fence: let a pending job finish first. */
 	flush_work(&vxd->job_done_work);
 	cancel_delayed_work_sync(&vxd->watchdog_work);
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-fw.c b/drivers/media/platform/apple/vxd/apple-vxd-fw.c
index 753ca494..7590f5db 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-fw.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-fw.c
@@ -20,6 +20,7 @@
 #include <linux/dma-mapping.h>
 #include <linux/firmware.h>
 #include <linux/iopoll.h>
+#include <linux/module.h>
 #include <linux/pm_runtime.h>
 #include <linux/slab.h>
 
@@ -292,7 +293,7 @@ static void vxd_post_boot_init(struct apple_vxd_dev *vxd)
 
 int apple_vxd_boot_firmware(struct apple_vxd_dev *vxd)
 {
-	const struct firmware *fw;
+	const struct firmware *fw = vxd->fw;
 	u32 fw_words;
 	int ret;
 
@@ -312,23 +313,10 @@ int apple_vxd_boot_firmware(struct apple_vxd_dev *vxd)
 
 	/*
 	 * AllocateFirmwareBuffer [E]: a 4-byte-aligned coherent buffer of
-	 * blob_size, GART-mapped (the MTX fetches through its own MMU), and
-	 * the firmware must fit under 0x10000 MTX words.
+	 * blob_size, GART-mapped (the MTX fetches through its own MMU).  The
+	 * image was loaded and checked before the video node was registered
+	 * (apple_vxd_fw_request()).
 	 */
-	ret = request_firmware(&fw, APPLE_VXD_FW_NAME, vxd->dev);
-	if (ret) {
-		dev_err(vxd->dev, "firmware %s not available: %d\n",
-			APPLE_VXD_FW_NAME, ret);
-		goto out_put;
-	}
-
-	if (!fw->size || (fw->size & 3) ||
-	    fw->size / sizeof(u32) >= APPLE_VXD_FW_MAX_WORDS) {
-		dev_err(vxd->dev, "firmware size %zu is not usable (< 0x10000 words)\n",
-			fw->size);
-		ret = -EINVAL;
-		goto out_release;
-	}
 	fw_words = fw->size / sizeof(u32);
 	vxd->fw_blob_size = fw->size;
 
@@ -337,7 +325,7 @@ int apple_vxd_boot_firmware(struct apple_vxd_dev *vxd)
 					   &vxd->fw_dma, GFP_KERNEL);
 	if (!vxd->fw_vaddr) {
 		ret = -ENOMEM;
-		goto out_release;
+		goto out_put;
 	}
 
 	/* Device VA = low 32 bits of the DMA address (identity GART). */
@@ -352,9 +340,6 @@ int apple_vxd_boot_firmware(struct apple_vxd_dev *vxd)
 	}
 
 	memcpy(vxd->fw_vaddr, fw->data, fw->size);
-	release_firmware(fw);
-	/* Every later failure unwinds through out_release: no double free. */
-	fw = NULL;
 
 	/*
 	 * The eight command buffers are mapped now, before the MTX and its
@@ -427,8 +412,6 @@ int apple_vxd_boot_firmware(struct apple_vxd_dev *vxd)
 out_fwbuf:
 	dma_free_coherent(vxd->dev, vxd->fw_size, vxd->fw_vaddr, vxd->fw_dma);
 	vxd->fw_vaddr = NULL;
-out_release:
-	release_firmware(fw);
 out_put:
 	pm_runtime_put_autosuspend(vxd->dev);
 	mutex_unlock(&vxd->power_lock);
@@ -457,3 +440,68 @@ void apple_vxd_fw_cleanup(struct apple_vxd_dev *vxd)
 	if (was_loaded)
 		pm_runtime_put_autosuspend(vxd->dev);
 }
+
+/*
+ * The firmware file is in (or is not there): the decoder becomes visible to
+ * userspace only now and only with a usable image, so that a registered
+ * video node can always be opened.  The image is kept until the driver is
+ * unbound; the MTX still boots from it on the first open.
+ */
+static void apple_vxd_fw_ready(const struct firmware *fw, void *context)
+{
+	struct apple_vxd_dev *vxd = context;
+
+	if (!fw) {
+		dev_warn(vxd->dev,
+			 "firmware %s not found, not registering the video decoder\n",
+			 APPLE_VXD_FW_NAME);
+		return;
+	}
+
+	/* The image must fit under 0x10000 MTX words [E]. */
+	if (!fw->size || (fw->size & 3) ||
+	    fw->size / sizeof(u32) >= APPLE_VXD_FW_MAX_WORDS) {
+		dev_err(vxd->dev,
+			"firmware %s: size %zu is not usable (< 0x10000 words), not registering the video decoder\n",
+			APPLE_VXD_FW_NAME, fw->size);
+		goto err_release;
+	}
+
+	vxd->fw = fw;
+	if (apple_vxd_v4l2_init(vxd))
+		goto err_clear;
+
+	return;
+
+err_clear:
+	vxd->fw = NULL;
+err_release:
+	release_firmware(fw);
+}
+
+/*
+ * Ask for the firmware file without holding up probe.  The video node is
+ * registered from the callback, when the file is there.
+ */
+int apple_vxd_fw_request(struct apple_vxd_dev *vxd)
+{
+	return firmware_request_nowait_nowarn(THIS_MODULE, APPLE_VXD_FW_NAME,
+					      vxd->dev, GFP_KERNEL, vxd,
+					      apple_vxd_fw_ready);
+}
+
+/*
+ * End a request that has not been answered yet, or wait for its callback;
+ * afterwards vxd->fw and the V4L2 registration no longer change.
+ */
+void apple_vxd_fw_request_cancel(struct apple_vxd_dev *vxd)
+{
+	request_firmware_nowait_cancel(vxd->dev, vxd, apple_vxd_fw_ready);
+}
+
+/* After apple_vxd_fw_cleanup(): nothing boots from the image any more. */
+void apple_vxd_fw_release(struct apple_vxd_dev *vxd)
+{
+	release_firmware(vxd->fw);
+	vxd->fw = NULL;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c b/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
index 9664bb80..1d69d70b 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
@@ -893,9 +893,9 @@ static int apple_vxd_open(struct file *filp)
 	int ret;
 
 	/*
-	 * The DEVA firmware boots on the first open, when the firmware file
-	 * can be read, and keeps running (and the block powered) until the
-	 * driver is unbound. Later opens find it running.
+	 * The DEVA firmware boots on the first open, from the image loaded
+	 * before this node was registered, and keeps running (and the block
+	 * powered) until the driver is unbound. Later opens find it running.
 	 */
 	ret = apple_vxd_boot_firmware(vxd);
 	if (ret)
@@ -1034,6 +1034,10 @@ int apple_vxd_v4l2_init(struct apple_vxd_dev *vxd)
 
 void apple_vxd_v4l2_cleanup(struct apple_vxd_dev *vxd)
 {
+	/* Never registered: the firmware file was missing or unusable. */
+	if (!vxd->m2m_dev)
+		return;
+
 	media_device_unregister(&vxd->mdev);
 	v4l2_m2m_unregister_media_controller(vxd->m2m_dev);
 	video_unregister_device(&vxd->vdev);
diff --git a/drivers/media/platform/apple/vxd/apple-vxd.h b/drivers/media/platform/apple/vxd/apple-vxd.h
index 1db55c1c..227e0c08 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd.h
+++ b/drivers/media/platform/apple/vxd/apple-vxd.h
@@ -46,6 +46,8 @@
 #define APPLE_VXD_FW_NAME		"apple/vxd-deva.bin"
 #define APPLE_VXD_FW_MAX_WORDS		0x10000
 
+struct firmware;
+
 /*
  * DT advertises h264-playback-level = 42: H.264 level 4.2, 1920x1088 [E].
  * Tile decode exists (H264DecoderSupportsTileDecode = true) and could lift
@@ -306,7 +308,8 @@ struct apple_vxd_dev {
 	u32 pipe_status_2_max;		/* max per-pipe 0x40c4 & 3 */
 	u32 cfg_flags;			/* InitializeCoreConfig core[0x54] */
 
-	/* Firmware buffer and boot results. */
+	/* Firmware image, buffer and boot results. */
+	const struct firmware *fw;	/* set before the video node exists */
 	bool fw_loaded;			/* MTX up: ready magic seen */
 	void *fw_vaddr;
 	dma_addr_t fw_dma;
@@ -458,6 +461,9 @@ void apple_vxd_dev_buf_free(struct apple_vxd_dev *vxd,
 			    struct apple_vxd_dev_buf *buf);
 
 /* fw.c */
+int apple_vxd_fw_request(struct apple_vxd_dev *vxd);
+void apple_vxd_fw_request_cancel(struct apple_vxd_dev *vxd);
+void apple_vxd_fw_release(struct apple_vxd_dev *vxd);
 int apple_vxd_boot_firmware(struct apple_vxd_dev *vxd);
 void apple_vxd_fw_cleanup(struct apple_vxd_dev *vxd);
 
