From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 10 Nov 2026 21:24:51 +0100
Subject: [PATCH] media: apple-vxd: Prepare for a second coded format

The coded-format table was the H.264 unit's own array, installed whole
by apple_vxd_h264_register(). Make it a table of pointers in the device
that each codec unit appends to with apple_vxd_register_coded_fmt(), so
a second codec can sit next to H.264 without the core knowing about it.
The first unit registered stays the default OUTPUT format.

Add apple_vxd_buf_aux_cpu() and apple_vxd_buf_aux_size() next to
apple_vxd_buf_aux_va(): a codec that keeps per-picture state in the
CAPTURE side buffer needs to read and write it.

apple_vxd_cmdbuf_pair_chunk_end() had no user. Make it match the HEVC
per-picture chunk it was written for: AppleD5500 (0xfffffff0062b7ab0)
zeroes 0x40 - (pairs & 7) * 8 bytes past the write pointer and neither
counts them in the packet's byte count nor advances over them.

H.264 output is unchanged: its host command-stream compare still matches
the reference generator on all 76 pictures.

Assisted-by: LLM
---
 .../media/platform/apple/vxd/apple-vxd-cmd.c  | 25 +++++------
 .../media/platform/apple/vxd/apple-vxd-h264.c | 10 +----
 .../media/platform/apple/vxd/apple-vxd-v4l2.c | 42 +++++++++++++++----
 drivers/media/platform/apple/vxd/apple-vxd.h  | 17 ++++++--
 4 files changed, 62 insertions(+), 32 deletions(-)

diff --git a/drivers/media/platform/apple/vxd/apple-vxd-cmd.c b/drivers/media/platform/apple/vxd/apple-vxd-cmd.c
index 03340ed33..fa93cd965 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-cmd.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-cmd.c
@@ -318,29 +318,30 @@ int apple_vxd_cmdbuf_chunk_end_exact(struct apple_vxd_cmdbuf *cb,
 }
 
 /*
- * Close a chunk made only of 0x000f0000 pairs (the per-picture kind-4
- * chunk, 0x62b7ab0): pad by 0x40 - (pairs & 7) * 8 bytes, a full 64 when
- * the pair count is a multiple of eight, and report the byte count
- * including that pad (the kext measures it after the pad; the message
- * sends it as a pair count, >> 3).
+ * Close a chunk made only of 0x000f0000 pairs (the HEVC per-picture kind-4
+ * chunk, 0x62b7ab0): report its byte count (the message sends it as a pair
+ * count, >> 3), then zero 0x40 - (pairs & 7) * 8 bytes past it, a full 64
+ * when the pair count is a multiple of eight.  The kext writes that pad
+ * past its write pointer and neither counts it nor advances over it, so
+ * this must be the buffer's last chunk.
  */
 int apple_vxd_cmdbuf_pair_chunk_end(struct apple_vxd_cmdbuf *cb, u32 *offset,
 				    u32 *bytes)
 {
 	size_t pad;
-	int ret;
 
 	if (cb->group_open || cb->used - cb->chunk_start != cb->npairs * 8)
 		cb->error = true;
-	if (cb->error)
+	pad = VXD_CMD_CHUNK_ALIGN - (cb->npairs & 7) * 8;
+	if (cb->error || pad > cb->size - cb->used) {
+		cb->error = true;
 		return -ENOSPC;
+	}
 
 	*offset = cb->chunk_start;
-	pad = VXD_CMD_CHUNK_ALIGN - (cb->npairs & 7) * 8;
-	ret = vxd_cmd_pad(cb, pad);
-	if (!ret)
-		*bytes = cb->used - *offset;
-	return ret;
+	*bytes = cb->used - cb->chunk_start;
+	memset((u8 *)cb->vaddr + cb->used, 0, pad);
+	return 0;
 }
 
 /*
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-h264.c b/drivers/media/platform/apple/vxd/apple-vxd-h264.c
index 726df7525..ca289e11d 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-h264.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-h264.c
@@ -557,14 +557,8 @@ static const struct apple_vxd_coded_fmt_desc apple_vxd_h264_fmt = {
 	.decoded_fmts = apple_vxd_h264_decoded_fmts,
 };
 
-static const struct apple_vxd_coded_fmt_desc apple_vxd_coded_fmts[] = {
-	apple_vxd_h264_fmt,
-};
-
-/* Fills the device's coded-format table, before any V4L2 node exists. */
+/* Adds H.264 to the device's coded formats, before any V4L2 node exists. */
 int apple_vxd_h264_register(struct apple_vxd_dev *vxd)
 {
-	vxd->coded_fmts = apple_vxd_coded_fmts;
-	vxd->num_coded_fmts = ARRAY_SIZE(apple_vxd_coded_fmts);
-	return 0;
+	return apple_vxd_register_coded_fmt(vxd, &apple_vxd_h264_fmt);
 }
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c b/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
index e9467232d..c5e429df7 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-v4l2.c
@@ -97,8 +97,8 @@ apple_vxd_find_coded_fmt_desc(struct apple_vxd_ctx *ctx, u32 fourcc)
 	unsigned int i;
 
 	for (i = 0; i < vxd->num_coded_fmts; i++)
-		if (vxd->coded_fmts[i].fourcc == fourcc)
-			return &vxd->coded_fmts[i];
+		if (vxd->coded_fmts[i]->fourcc == fourcc)
+			return vxd->coded_fmts[i];
 	return NULL;
 }
 
@@ -107,7 +107,7 @@ static void apple_vxd_reset_coded_fmt(struct apple_vxd_ctx *ctx)
 	struct v4l2_format *f = &ctx->coded_fmt;
 
 	/* apple_vxd_ctx_init() checked vxd->coded_fmts before calling us. */
-	ctx->coded_fmt_desc = &ctx->vxd->coded_fmts[0];
+	ctx->coded_fmt_desc = ctx->vxd->coded_fmts[0];
 	apple_vxd_reset_fmt(ctx, f, ctx->coded_fmt_desc->fourcc);
 	f->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
 	f->fmt.pix_mp.width = ctx->coded_fmt_desc->frmsize.min_width;
@@ -208,12 +208,12 @@ static int apple_vxd_init_ctrls(struct apple_vxd_ctx *ctx)
 	int ret;
 
 	for (i = 0; i < vxd->num_coded_fmts; i++)
-		nctrls += vxd->coded_fmts[i].ctrls->num_ctrls;
+		nctrls += vxd->coded_fmts[i]->ctrls->num_ctrls;
 
 	v4l2_ctrl_handler_init(&ctx->ctrl_hdl, nctrls);
 
 	for (i = 0; i < vxd->num_coded_fmts; i++) {
-		ret = apple_vxd_add_ctrls(ctx, vxd->coded_fmts[i].ctrls);
+		ret = apple_vxd_add_ctrls(ctx, vxd->coded_fmts[i]->ctrls);
 		if (ret)
 			goto err_free_handler;
 	}
@@ -297,7 +297,7 @@ static int apple_vxd_do_try_output_fmt(struct apple_vxd_ctx *ctx,
 
 	desc = apple_vxd_find_coded_fmt_desc(ctx, pix_mp->pixelformat);
 	if (!desc) {
-		desc = &ctx->vxd->coded_fmts[0];
+		desc = ctx->vxd->coded_fmts[0];
 		pix_mp->pixelformat = desc->fourcc;
 	}
 
@@ -404,7 +404,7 @@ static int apple_vxd_do_enum_output_fmt(struct apple_vxd_ctx *ctx,
 {
 	if (f->index >= ctx->vxd->num_coded_fmts)
 		return -EINVAL;
-	f->pixelformat = ctx->vxd->coded_fmts[f->index].fourcc;
+	f->pixelformat = ctx->vxd->coded_fmts[f->index]->fourcc;
 	return 0;
 }
 
@@ -650,6 +650,18 @@ u32 apple_vxd_buf_aux_va(struct vb2_v4l2_buffer *vbuf)
 	return vxd_buf(vbuf)->aux.va;
 }
 
+/* CPU address of a CAPTURE buffer's side buffer, NULL if it has none. */
+void *apple_vxd_buf_aux_cpu(struct vb2_v4l2_buffer *vbuf)
+{
+	return vxd_buf(vbuf)->aux.va ? vxd_buf(vbuf)->aux.mem.vaddr : NULL;
+}
+
+/* Size of a CAPTURE buffer's side buffer, 0 if it has none. */
+size_t apple_vxd_buf_aux_size(struct vb2_v4l2_buffer *vbuf)
+{
+	return vxd_buf(vbuf)->aux.va ? vxd_buf(vbuf)->aux.mem.size : 0;
+}
+
 static void apple_vxd_buf_queue(struct vb2_buffer *vb)
 {
 	struct apple_vxd_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
@@ -935,11 +947,25 @@ static const struct v4l2_file_operations apple_vxd_fops = {
 
 /* --- registration ------------------------------------------------------ */
 
+/*
+ * Add one coded format to the device's table.  The codec units call this
+ * during probe, before any V4L2 node exists; the first one added is the
+ * default OUTPUT format.
+ */
+int apple_vxd_register_coded_fmt(struct apple_vxd_dev *vxd,
+				 const struct apple_vxd_coded_fmt_desc *desc)
+{
+	if (vxd->num_coded_fmts >= ARRAY_SIZE(vxd->coded_fmts))
+		return -ENOSPC;
+	vxd->coded_fmts[vxd->num_coded_fmts++] = desc;
+	return 0;
+}
+
 int apple_vxd_v4l2_init(struct apple_vxd_dev *vxd)
 {
 	int ret;
 
-	if (!vxd->coded_fmts || !vxd->num_coded_fmts) {
+	if (!vxd->num_coded_fmts) {
 		dev_err(vxd->dev, "v4l2: no coded formats registered, not exposing a node\n");
 		return -ENODEV;
 	}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd.h b/drivers/media/platform/apple/vxd/apple-vxd.h
index 81fef0f1a..f7eab496c 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd.h
+++ b/drivers/media/platform/apple/vxd/apple-vxd.h
@@ -10,7 +10,8 @@
  *   - host<->firmware mailbox: ring geometry, 0x80 init message, push,
  *     IRQ drain, fences (apple-vxd-mbox.c)
  *   - command buffers and their encoders (apple-vxd-cmdbuf.c, -cmd.c)
- *   - the V4L2 stateless H.264 decoder (apple-vxd-v4l2.c, -h264*.c)
+ *   - the V4L2 stateless node (apple-vxd-v4l2.c) and its codec units:
+ *     H.264 (apple-vxd-h264*.c)
  *
  * [E] marks facts taken from the kext.
  */
@@ -61,6 +62,9 @@ enum apple_vxd_image_fmt {
 	APPLE_VXD_IMG_FMT_420_8BIT,
 };
 
+/* One per codec unit. */
+#define APPLE_VXD_MAX_CODED_FMTS	2
+
 /* SoC variant data (compatible table). */
 struct apple_vxd_variant {
 	unsigned int vxd_version;	/* ADT "vxd-version" */
@@ -351,10 +355,11 @@ struct apple_vxd_dev {
 	struct v4l2_m2m_dev *m2m_dev;
 	struct mutex vdev_lock;		/* serializes ioctls */
 	/*
-	 * Coded formats, filled by apple_vxd_h264_register() during probe
-	 * before any V4L2 node exists.
+	 * Coded formats, one per codec unit, added with
+	 * apple_vxd_register_coded_fmt() during probe before any V4L2 node
+	 * exists.
 	 */
-	const struct apple_vxd_coded_fmt_desc *coded_fmts;
+	const struct apple_vxd_coded_fmt_desc *coded_fmts[APPLE_VXD_MAX_CODED_FMTS];
 	unsigned int num_coded_fmts;
 };
 
@@ -495,6 +500,10 @@ int apple_vxd_packet_msg(struct apple_vxd_dev *vxd, u32 *pkt, u16 fence,
 /* v4l2.c */
 u32 apple_vxd_buf_va(struct vb2_v4l2_buffer *vbuf);
 u32 apple_vxd_buf_aux_va(struct vb2_v4l2_buffer *vbuf);
+void *apple_vxd_buf_aux_cpu(struct vb2_v4l2_buffer *vbuf);
+size_t apple_vxd_buf_aux_size(struct vb2_v4l2_buffer *vbuf);
+int apple_vxd_register_coded_fmt(struct apple_vxd_dev *vxd,
+				 const struct apple_vxd_coded_fmt_desc *desc);
 int apple_vxd_v4l2_init(struct apple_vxd_dev *vxd);
 void apple_vxd_v4l2_cleanup(struct apple_vxd_dev *vxd);
 extern const struct v4l2_ctrl_ops apple_vxd_ctrl_ops;
