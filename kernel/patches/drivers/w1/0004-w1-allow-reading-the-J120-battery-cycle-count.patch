From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Fri, 20 Nov 2026 08:56:57 +0100
Subject: [PATCH] w1: allow reading the J120 battery cycle count

Admit the two CycleCount bytes to the J120 HDQ read allowlist. Keep the existing deadline, fail-stop behavior and write exclusion.

Assisted-by: LLM
---
 drivers/w1/masters/w1-uart.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/w1/masters/w1-uart.c b/drivers/w1/masters/w1-uart.c
index 9583af243..69e34d522 100644
--- a/drivers/w1/masters/w1-uart.c
+++ b/drivers/w1/masters/w1-uart.c
@@ -872,7 +872,7 @@ static const struct w1_uart_variant w1_uart_j120_voltage = {
 /* Read-command bytes only; HDQ write opcodes (bit7) are never admitted. */
 static const u8 w1_uart_j120_hdq_read_regs[] = {
 	0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x10,
-	0x11, 0x12, 0x13, 0x14, 0x15, 0x2c, 0x2d,
+	0x11, 0x12, 0x13, 0x14, 0x15, 0x2a, 0x2b, 0x2c, 0x2d,
 };
 
 static const struct w1_uart_variant w1_uart_j120_hdq = {
