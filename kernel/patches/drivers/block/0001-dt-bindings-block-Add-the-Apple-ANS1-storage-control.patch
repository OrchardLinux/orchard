Subject: [PATCH] dt-bindings: block: Add the Apple ANS1 storage controller

[Orchard: from HoolockLinux/linux ans1 ed8528f f9eb00ee2a47.]
Signed-off-by: Nick Chan <towinchenmi@gmail.com>
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/block/apple,s5l8960x-ans.yaml    | 64 +++++++++++++++++++
 1 file changed, 64 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/block/apple,s5l8960x-ans.yaml

diff --git a/Documentation/devicetree/bindings/block/apple,s5l8960x-ans.yaml b/Documentation/devicetree/bindings/block/apple,s5l8960x-ans.yaml
new file mode 100644
index 000000000..4fb0acf40
--- /dev/null
+++ b/Documentation/devicetree/bindings/block/apple,s5l8960x-ans.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/block/apple,s5l8960x-ans.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple ANS1 storage controller
+
+maintainers:
+  - Nick Chan <towinchenmi@gmail.com>
+
+properties:
+  compatible:
+    oneOf:
+      - const: apple,s5l8960x-ans
+      - items:
+          - enum:
+              - apple,t7000-ans
+              - apple,t7001-ans
+          - const: apple,s5l8960x-ans
+
+  reg:
+    maxItems: 1
+    description: AKF co-processor control registers
+
+  power-domains:
+    maxItems: 1
+    description: ANS1 CPU and mailbox power domain
+
+  mboxes:
+    maxItems: 1
+    description: Mailbox of the ANS1 co-processor
+
+  resets:
+    maxItems: 1
+
+  memory-region:
+    maxItems: 1
+    description: Region containing ANS1 firmware
+
+  memory-region-names:
+    const: firmware
+
+required:
+  - compatible
+  - reg
+  - power-domains
+  - mboxes
+  - resets
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    block@8040000 {
+      compatible = "apple,t7000-ans", "apple,s5l8960x-ans";
+      reg = <0x8040000 0x40000>;
+      mboxes = <&ans_mbox>;
+      power-domains = <&ps_ans>;
+      resets = <&ps_ans>;
+    };
