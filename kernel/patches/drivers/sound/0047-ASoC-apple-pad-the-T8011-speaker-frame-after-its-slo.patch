From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Fri, 20 Nov 2026 16:28:50 +0100
Subject: [PATCH] ASoC: apple: pad the T8011 speaker frame after its slots

The native iisConfig helper derives 16-bit slots from the sample widths and writes the frame remainder to MCA_PAD. Preserve that slot alignment while retaining the 256-clock frame.

[Henrik Klee: binding text merged with the A7 MCA description added since]

Assisted-by: LLM
---
 .../devicetree/bindings/sound/apple,s8000-mca.yaml  |  4 ++--
 sound/soc/apple/s8000-mca.c                         | 13 ++++++-------
 2 files changed, 8 insertions(+), 9 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/apple,s8000-mca.yaml b/Documentation/devicetree/bindings/sound/apple,s8000-mca.yaml
index c2adb82f6..935a8523d 100644
--- a/Documentation/devicetree/bindings/sound/apple,s8000-mca.yaml
+++ b/Documentation/devicetree/bindings/sound/apple,s8000-mca.yaml
@@ -28,8 +28,8 @@ description: |
   iPad Air to its codec, which provides the bit and frame clocks as on the
   A9; apple,s5l8960x-mca-tdm the playback-only speaker link (TDM) of the
   iPad mini 2, a consumer of the clocks of its amplifiers, to which it
-  supplies MCLK. The T8011 speaker link uses wider serial slots while
-  keeping 16-bit PCM.
+  supplies MCLK.
+  The T8011 speaker link appends padding clocks after its 16-bit slots.
 
 allOf:
   - $ref: dai-common.yaml#
diff --git a/sound/soc/apple/s8000-mca.c b/sound/soc/apple/s8000-mca.c
index 4a10ea1f0..b42f11007 100644
--- a/sound/soc/apple/s8000-mca.c
+++ b/sound/soc/apple/s8000-mca.c
@@ -297,7 +297,7 @@ struct s8000_mca {
 	struct device *dev;
 	const struct s8000_mca_hw *hw;
 	const struct s8000_mca_regs *regs;
-	unsigned int slot_width;
+	unsigned int frame_padding;
 	void __iomem *base;
 	void __iomem *mclk_reg;
 	struct clk_hw mclk_hw;
@@ -519,11 +519,10 @@ static int mca_hw_params(struct snd_pcm_substream *substream,
 		substream->stream == SNDRV_PCM_STREAM_PLAYBACK ? &mca->dma_tx :
 								 &mca->dma_rx;
 	unsigned int bits = params_width(params);
-	unsigned int pcm_width = params_physical_width(params);
-	unsigned int slot = mca->slot_width ?: pcm_width;
+	unsigned int slot = params_physical_width(params);
 	unsigned int channels = params_channels(params);
 	unsigned int slots = mca->hw->slots, depth;
-	unsigned int frame_bits = mca->hw->frame_bits ?: slot * slots;
+	unsigned int frame_bits = mca->hw->frame_bits ?: slot * slots + mca->frame_padding;
 	unsigned int sync_bits = mca->hw->sync_bits ?: frame_bits / 2;
 	u32 width_code;
 
@@ -581,7 +580,7 @@ static int mca_hw_params(struct snd_pcm_substream *substream,
 		mca->frame |= MCA_FRAME_MASTER;
 	}
 
-	dma->addr_width = pcm_width == 16 ? DMA_SLAVE_BUSWIDTH_2_BYTES :
+	dma->addr_width = slot == 16 ? DMA_SLAVE_BUSWIDTH_2_BYTES :
 				       DMA_SLAVE_BUSWIDTH_4_BYTES;
 	/* informational: the SmartIO limit comes from the shim record */
 	dma->maxburst = substream->stream == SNDRV_PCM_STREAM_PLAYBACK ? depth :
@@ -1200,9 +1199,9 @@ static int s8000_mca_probe(struct platform_device *pdev)
 	if (!mca->hw)
 		return -ENODEV;
 	mca->regs = mca->hw->regs;
-	/* J120 iisConfig spans 256 clocks over eight slots with S16 samples. */
+	/* J120 iisConfig uses eight 16-bit slots and 128 trailing clocks. */
 	if (of_device_is_compatible(dev->of_node, "apple,t8011-mca"))
-		mca->slot_width = 32;
+		mca->frame_padding = 128;
 	spin_lock_init(&mca->hw_lock);
 	mca->irq_mask = MCA_IRQ_ALL;
 	platform_set_drvdata(pdev, mca);
