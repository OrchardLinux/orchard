From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Thu, 19 Nov 2026 23:10:00 +0100
Subject: [PATCH] dt-bindings: sound: maxim,max98925: Add the MAX98721

The MAX98721 is the speaker amplifier of the iPad Air 2. It has no public
datasheet, but every register iOS programs matches the MAX98925 map, so
describe it in the MAX98925 binding. It runs as a TDM consumer and takes
its playback slot from its DAI link, so allow a graph port, and its
interrupt line.

sound-name-prefix comes from dai-common.yaml, which additionalProperties
does not see; use unevaluatedProperties so a board with two amplifiers
can name them apart.

Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/maxim,max98925.yaml        | 41 ++++++++++++++++++-
 1 file changed, 39 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/maxim,max98925.yaml b/Documentation/devicetree/bindings/sound/maxim,max98925.yaml
index 121e8d2..7d42740 100644
--- a/Documentation/devicetree/bindings/sound/maxim,max98925.yaml
+++ b/Documentation/devicetree/bindings/sound/maxim,max98925.yaml
@@ -4,14 +4,20 @@
 $id: http://devicetree.org/schemas/sound/maxim,max98925.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Maxim Integrated MAX98925/MAX98926/MAX98927 speaker amplifier
+title: Maxim Integrated MAX98721/MAX98925/MAX98926/MAX98927 speaker amplifier
 
 maintainers:
   - Ryan Lee <ryans.lee@maximintegrated.com>
 
+description:
+  The MAX98721 is a variant of the MAX98925 found in Apple devices. It runs
+  as a TDM consumer and plays the first slot of its DAI link's
+  dai-tdm-slot-rx-mask.
+
 properties:
   compatible:
     enum:
+      - maxim,max98721
       - maxim,max98925
       - maxim,max98926
       - maxim,max98927
@@ -19,12 +25,19 @@ properties:
   reg:
     maxItems: 1
 
+  interrupts:
+    maxItems: 1
+
   reset-gpios:
     maxItems: 1
 
   '#sound-dai-cells':
     const: 0
 
+  port:
+    $ref: audio-graph-port.yaml#
+    unevaluatedProperties: false
+
   vmon-slot-no:
     $ref: /schemas/types.yaml#/definitions/uint32
     minimum: 0
@@ -73,7 +86,7 @@ allOf:
           minimum: 0
           maximum: 15
 
-additionalProperties: false
+unevaluatedProperties: false
 
 examples:
   - |
@@ -96,3 +109,27 @@ examples:
             imon-slot-no = <0>;
         };
     };
+
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        amplifier@31 {
+            compatible = "maxim,max98721";
+            reg = <0x31>;
+            interrupts-extended = <&pinctrl 8 IRQ_TYPE_LEVEL_LOW>;
+            #sound-dai-cells = <0>;
+            sound-name-prefix = "Amp0";
+
+            port {
+                endpoint {
+                    remote-endpoint = <&speaker_amp0_ep>;
+                    dai-tdm-slot-num = <8>;
+                    dai-tdm-slot-width = <32>;
+                    dai-tdm-slot-rx-mask = <1>;
+                };
+            };
+        };
+    };
