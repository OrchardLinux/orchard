From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:44:35 +0100
Subject: [PATCH] dt-bindings: sound: Add the Cirrus Logic CS35L19

The CS35L19 is a boosted class-D speaker amplifier with a TDM serial
port. The A7 iPad minis use them in pairs on one I2C bus, with one reset
line and one TDM link. Apple's device tree describes the pair at the
primary's address with one 20-byte "speaker-config" record per
amplifier; the binding does the same, with the secondary as a second reg
entry.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/cirrus,cs35l19.yaml        | 97 +++++++++++++++++++
 1 file changed, 97 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/cirrus,cs35l19.yaml

diff --git a/Documentation/devicetree/bindings/sound/cirrus,cs35l19.yaml b/Documentation/devicetree/bindings/sound/cirrus,cs35l19.yaml
new file mode 100644
index 000000000..bbe8487b7
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/cirrus,cs35l19.yaml
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/cirrus,cs35l19.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Cirrus Logic CS35L19 speaker amplifier
+
+maintainers:
+  - ricktav <82380971+ricktav@users.noreply.github.com>
+
+description: |
+  Boosted class-D speaker amplifier with a TDM serial port, found in pairs
+  in the A7 iPad minis. Both parts of a pair share one I2C bus, one reset
+  line and one TDM link; the node describes the pair at the primary's
+  address, as Apple's device tree does, and the secondary is reached as an
+  ancillary device. Amplifier n plays slot n of an 8 x 16-bit frame, which
+  one of them drives from the MCLK it is given.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: cirrus,cs35l19
+
+  reg:
+    minItems: 1
+    items:
+      - description: primary amplifier
+      - description: secondary amplifier
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: primary
+      - const: secondary
+
+  reset-gpios:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: mclk
+
+  cirrus,speaker-config:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 20
+    maxItems: 40
+    description:
+      The "speaker-config" property of the amplifier node in Apple's device
+      tree, 20 bytes per amplifier in reg order.
+
+  cirrus,frame-provider:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 1
+    default: 0
+    description: Index (in reg) of the amplifier that drives the frame.
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - cirrus,speaker-config
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        audio-amplifier@40 {
+            compatible = "cirrus,cs35l19";
+            reg = <0x40>, <0x41>;
+            reg-names = "primary", "secondary";
+            reset-gpios = <&pinctrl 114 GPIO_ACTIVE_LOW>;
+            clocks = <&mca1>;
+            clock-names = "mclk";
+            cirrus,speaker-config = /bits/ 8 <
+                0x49 0x30 0x02 0x70 0x6a 0x80 0x30 0x1e 0x02 0x04
+                0x14 0x89 0x8a 0x10 0x74 0x03 0x05 0x00 0x00 0x40
+                0x49 0x30 0x02 0x70 0x6a 0x80 0x30 0x1e 0x02 0x04
+                0x14 0x89 0x8a 0x10 0x74 0x03 0x05 0x00 0x00 0x40>;
+            #sound-dai-cells = <0>;
+        };
+    };
