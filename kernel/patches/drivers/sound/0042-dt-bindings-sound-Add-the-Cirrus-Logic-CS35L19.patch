From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:44:35 +0100
Subject: [PATCH] dt-bindings: sound: Add the Cirrus Logic CS35L19

The CS35L19 is a boosted class-D speaker amplifier with a TDM serial
port. The A7 iPad minis use them in pairs on one I2C bus, with one reset
line and one TDM link, and the iPhone 6s and 6s Plus one (a CS35L21,
driven the same way) for the loudspeaker. Describe one node per
amplifier with the 20-byte "speaker-config" record of Apple's device
tree; the amplifier whose graph endpoint is the clock provider drives
the frame.

[Orchard: from orchard PR #223, commit 401d1166; one node per
 amplifier, as the driver from Project Cascadia that the iPhone 6s Plus
 uses binds, with the shared reset, the keep-alive line and the graph
 port; apple,speaker-config of 20 bytes instead of the pair's
 cirrus,speaker-config, and the endpoint's clock provider flags instead
 of cirrus,frame-provider]
Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/cirrus,cs35l19.yaml        | 91 +++++++++++++++++++
 1 file changed, 91 insertions(+)

diff --git a/Documentation/devicetree/bindings/sound/cirrus,cs35l19.yaml b/Documentation/devicetree/bindings/sound/cirrus,cs35l19.yaml
new file mode 100644
index 000000000..035babac3
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/cirrus,cs35l19.yaml
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/cirrus,cs35l19.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Cirrus Logic CS35L19 speaker amplifier
+
+maintainers:
+  - ricktav <82380971+ricktav@users.noreply.github.com>
+
+description: |
+  Boosted class-D speaker amplifier with a TDM serial port, a relative of
+  the CS35L33 with Apple's power-on sequence. The CS35L21 is driven the
+  same way. Apple's iPad minis use two on one I2C bus, sharing one reset
+  line and one TDM link; the iPhone 6s and 6s Plus use one for the
+  loudspeaker. Each amplifier is one node and reads the slot its graph
+  endpoint gives it. An amplifier whose endpoint is the bit and frame
+  clock provider drives the frame, from the MCLK it is given.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: cirrus,cs35l19
+
+  reg:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      Shared by the amplifiers of one board, so each of them names it.
+
+  cirrus,keepalive-gpios:
+    maxItems: 1
+    description:
+      Input of the amplifier's alive watchdog. Toggled while the amplifier
+      plays; without it, the watchdog is turned off.
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: mclk
+
+  apple,speaker-config:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 20
+    maxItems: 20
+    description:
+      The "speaker-config" record of the amplifier in Apple's device tree.
+
+  '#sound-dai-cells':
+    const: 0
+
+  port:
+    $ref: audio-graph-port.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        amplifier@40 {
+            compatible = "cirrus,cs35l19";
+            reg = <0x40>;
+            reset-gpios = <&pinctrl 114 GPIO_ACTIVE_LOW>;
+            clocks = <&mca1>;
+            clock-names = "mclk";
+            apple,speaker-config = /bits/ 8 <
+                0x49 0x30 0x02 0x70 0x6a 0x80 0x30 0x1e 0x02 0x04
+                0x14 0x89 0x8a 0x10 0x74 0x03 0x05 0x00 0x00 0x40>;
+            #sound-dai-cells = <0>;
+            sound-name-prefix = "Left";
+        };
+    };
-- 
2.50.1
