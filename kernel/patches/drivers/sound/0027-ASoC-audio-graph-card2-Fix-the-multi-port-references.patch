From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:10:01 +0100
Subject: [PATCH] ASoC: audio-graph-card2: Fix the multi port references

graph_get_next_multi_ep() drops the reference of the port it is given
and returns the next one. Two callers drop that reference again:

- graph_link_init() puts port_cpu/port_codec right after handing it to
  graph_get_next_multi_ep() as multi_cpu_port/multi_codec_port.
- graph_parse_node_multi() hands it the port its caller still owns
  (and frees with __free), so it is put once here and once there.

Each probe of a card with a "multi" node therefore drops the
reference count of the multi node's port@0 below zero; a card that is
probed again after -EPROBE_DEFER then warns "refcount_t: addition on 0;
use-after-free" from of_graph_get_remote_port() in graph_count_normal().

Drop the extra put in graph_link_init(), take a reference of our own in
graph_parse_node_multi(), and also put the endpoints the per-DAI loops
of graph_link_init() and the ports node of graph_counter() leaked.

Seen on an iPad Air 2 (one MCA to two MAX98721 amplifiers, a
"semi-multi" link): three refcount warnings at every deferred probe of
the card; none with this change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 sound/soc/generic/audio-graph-card2.c | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/sound/soc/generic/audio-graph-card2.c b/sound/soc/generic/audio-graph-card2.c
index 9fb3d3df5..e683750f0 100644
--- a/sound/soc/generic/audio-graph-card2.c
+++ b/sound/soc/generic/audio-graph-card2.c
@@ -601,6 +601,9 @@ static int graph_parse_node_multi(struct simple_util_priv *priv,
 	int nm_idx = 0;
 	int nm_max = max(dai_link->num_cpus, dai_link->num_codecs);
 
+	/* graph_get_next_multi_ep() drops the port it is given: keep ours */
+	of_node_get(port);
+
 	/*
 	 * create ch_maps if CPU:Codec = N:M
 	 * DPCM is out of scope
@@ -651,6 +654,7 @@ static int graph_parse_node_multi(struct simple_util_priv *priv,
 		ret = -EINVAL;
 
 multi_err:
+	of_node_put(port);
 	return graph_ret(priv, ret);
 }
 
@@ -753,8 +757,8 @@ static void graph_link_init(struct simple_util_priv *priv,
 
 	if (graph_lnk_is_multi(port_cpu)) {
 		multi_cpu_port = port_cpu;
+		/* this drops the reference of port_cpu */
 		ep_cpu = graph_get_next_multi_ep(&multi_cpu_port, multi_cpu_port_idx++);
-		of_node_put(port_cpu);
 		port_cpu = ep_to_port(ep_cpu);
 	} else {
 		of_node_get(ep_cpu);
@@ -763,8 +767,8 @@ static void graph_link_init(struct simple_util_priv *priv,
 
 	if (graph_lnk_is_multi(port_codec)) {
 		multi_codec_port = port_codec;
+		/* this drops the reference of port_codec */
 		ep_codec = graph_get_next_multi_ep(&multi_codec_port, multi_codec_port_idx++);
-		of_node_put(port_codec);
 		port_codec = ep_to_port(ep_codec);
 	} else {
 		of_node_get(ep_codec);
@@ -806,15 +810,19 @@ static void graph_link_init(struct simple_util_priv *priv,
 	for_each_link_cpus(dai_link, i, dlc) {
 		dlc->ext_fmt = graph_parse_bitframe(ep_cpu);
 
-		if (multi_cpu_port)
+		if (multi_cpu_port) {
+			of_node_put(ep_cpu);
 			ep_cpu = graph_get_next_multi_ep(&multi_cpu_port, multi_cpu_port_idx++);
+		}
 	}
 
 	for_each_link_codecs(dai_link, i, dlc) {
 		dlc->ext_fmt = graph_parse_bitframe(ep_codec);
 
-		if (multi_codec_port)
+		if (multi_codec_port) {
+			of_node_put(ep_codec);
 			ep_codec = graph_get_next_multi_ep(&multi_codec_port, multi_codec_port_idx++);
+		}
 	}
 
 	/*** Don't use port_cpu / port_codec after here ***/
@@ -1115,7 +1123,7 @@ static int graph_counter(struct device_node *lnk)
 	 * ignore first lnk part
 	 */
 	if (graph_lnk_is_multi(lnk)) {
-		struct device_node *ports = port_to_ports(lnk);
+		struct device_node *ports __free(device_node) = port_to_ports(lnk);
 
 		/*
 		 * CPU/Codec = N:M case has many endpoints.
