From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Duke Eagleman <301139544+jerricky26@users.noreply.github.com>
Date: Wed, 11 Nov 2026 12:48:04 -0500
Subject: [PATCH] ASoC: apple: s8000-mca: Add the T8010 headphone I2S link

The iPad 6 and 7 (J71b, J72b, J171, J172) have their CS42L83 headphone
codec on MCA4. The ADT's /arm-io/mca4/audio-codec record is identical on
the four boards: flags 0x13 like the speaker link, two slots with data,
32-bit samples, and SmartIO endpoint 0x30 with a 0x180-byte FIFO and a
0xc0 trigger. The MCA4 i2s-switch route carries the provider flags of
MCA2 (0x30303), not the consumer flags of MCA0 (0x330303), so the MCA
drives the clocks from NCO channel 4.

Linux's CS42L42-family codec driver accepts only standard I2S as a clock
consumer and runs its PLL from SCLK, so the codec needs no MCLK from the
SoC. Add apple,t8010-mca-i2s: 48 kHz S32_LE stereo, a 64 fs I2S frame
(LRCLK at half the frame, one bit of data delay) with the frame bits of
the S8000 I2S link, no attenuation (the codec has volume control).

iOS's frame length for this link has not been decoded, and whether
FRAME bits 6:2 give standard I2S in provider mode has not been measured.
A read-only module parameter, t8010_i2s_frame_flags, overrides those bits
for bring-up.

Assisted-by: LLM
---
 sound/soc/apple/s8000-mca.c | 56 +++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/sound/soc/apple/s8000-mca.c b/sound/soc/apple/s8000-mca.c
index 588ca37..b7e44b1 100644
--- a/sound/soc/apple/s8000-mca.c
+++ b/sound/soc/apple/s8000-mca.c
@@ -135,6 +135,7 @@
  *
  *   J71t mca0 10 00 00 00 02 00 01 00 ...    consumer, I2S, 2 x 16 bit
  *   J71b mca2 01 13 00 00 08 00 01 00 ...    provider, 8 x 16 bit, slots 0-3
+ *   J171 mca4 01 13 00 00 02 00 01 00 ...    provider, 2 slots, slots 0-1
  *
  * Bytes 0xc/0xe of the J71b record are the 128-bit frame and its 1-bit sync
  * pulse: the amplifiers run in TDM mode, as MAX98357 calls it.
@@ -843,6 +844,49 @@ static int s8000_mca_get_route(struct s8000_mca *mca)
 	return 0;
 }
 
+/*
+ * The T8010 headphone link: MCA4 to the CS42L83 jack codec, the ADT's
+ * /arm-io/mca4/audio-codec (iPadOS 17.7.x, identical on J71b, J72b, J171 and
+ * J172): provider (its i2s-switch route has the flags of the speaker MCA2,
+ * not the consumer MCA0), flags 0x13, two slots carrying data, 32-bit samples,
+ * and SmartIO endpoint 0x30 with a 0x180-byte FIFO and a 0xc0 trigger.
+ *
+ * Linux's CS42L42-family driver only takes standard I2S as a clock consumer
+ * and derives its internal MCLK from SCLK with its PLL, so this variant runs
+ * a plain 64 fs I2S frame (two 32-bit slots, LRCLK at half the frame, one bit
+ * of data delay) with the frame bits the S8000 I2S link uses. iOS's frame
+ * length for this link (byte 0xc of the record) has not been decoded and may
+ * differ; the codec does not need it to.
+ */
+static const struct s8000_mca_hw t8010_i2s_mca_hw = {
+	.version = 5,
+	.clock_provider = true,
+	.dai_format = SND_SOC_DAIFMT_I2S,
+	.channels = 2,
+	.slots = 2,
+	.tx_slots = 0x3,
+	.tx_cfg = 0x133,
+	.rx_cfg = 0x137,
+	.rx_slots = 0x3,
+	.formats = SNDRV_PCM_FMTBIT_S32_LE,
+	.frame_flags = MCA_FRAME_DUTY | MCA_FRAME_FMT,
+	.attenuation = 1,
+	.sio_xfer16 = 0x21,
+	.sio_xfer32 = 0x22,
+	.sio_timeout = 0,
+	.sio_fifo = 0x180,
+	.sio_trigger = 0xc0,
+};
+
+/*
+ * Bring-up aid for the I2S variant: the frame bits 6:2 the provider frame is
+ * run with, until the iOS value is known. -1 keeps the default.
+ */
+static int t8010_i2s_frame_flags = -1;
+module_param(t8010_i2s_frame_flags, int, 0444);
+MODULE_PARM_DESC(t8010_i2s_frame_flags,
+		 "T8010 I2S link: FRAME bits 6:2 (bring-up), -1 for the default");
+
 static int s8000_mca_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -859,6 +903,17 @@ static int s8000_mca_probe(struct platform_device *pdev)
 	mca->hw = device_get_match_data(dev);
 	if (!mca->hw)
 		return -ENODEV;
+	if (mca->hw == &t8010_i2s_mca_hw && t8010_i2s_frame_flags >= 0) {
+		struct s8000_mca_hw *hw;
+
+		hw = devm_kmemdup(dev, mca->hw, sizeof(*hw), GFP_KERNEL);
+		if (!hw)
+			return -ENOMEM;
+		hw->frame_flags = t8010_i2s_frame_flags & GENMASK(6, 2);
+		dev_warn(dev, "I2S frame bits overridden: %#x\n",
+			 hw->frame_flags);
+		mca->hw = hw;
+	}
 	spin_lock_init(&mca->hw_lock);
 	mca->irq_mask = MCA_IRQ_ALL;
 	platform_set_drvdata(pdev, mca);
@@ -1011,6 +1066,7 @@ static const struct s8000_mca_hw t8010_mca_hw = {
 static const struct of_device_id s8000_mca_of_match[] = {
 	{ .compatible = "apple,s8000-mca", .data = &s8000_mca_hw },
 	{ .compatible = "apple,t8010-mca", .data = &t8010_mca_hw },
+	{ .compatible = "apple,t8010-mca-i2s", .data = &t8010_i2s_mca_hw },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, s8000_mca_of_match);
