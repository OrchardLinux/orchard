+static int g5p_r73b_latch(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	const u32 id = (1), ms = (0);
+	const u32 fast = (1);
+	const u32 early = (1);
+	const u32 r74 = (1), cap = (1048576);
+	const u32 r74f = (1);
+	const u32 r74g = (1);
+	const u32 r74h = (0);
