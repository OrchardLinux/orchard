diff --git a/drivers/gpu/apple-g5p/boot-layout.h b/drivers/gpu/apple-g5p/boot-layout.h
new file mode 100644
index 000000000..752e6873f
--- /dev/null
+++ b/drivers/gpu/apple-g5p/boot-layout.h
@@ -0,0 +1,306 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_G5P_BOOT_LAYOUT_H
+#define APPLE_G5P_BOOT_LAYOUT_H
+
+#include "bits-compat.h"
+#include "pack.h"
+
+#define G5P_GPU_PAGE 0x4000U
+#define G5P_ROOT_SIZE 0x8000U
+#define G5P_SHARED_SIZE 0x60000U
+#define G5P_IMAGE_VA 0xe1c0000000ULL
+#define G5P_SHARED_VA 0xe1c0200000ULL
+#define G5P_ROOT_VA 0xe1c3200000ULL
+#define G5P_PIO_VA 0xe1c4200000ULL
+#define G5P_PIO_SIZE 0x10000U
+
+/* c95da0 descriptors, sizes at 5940b90; c97b6c packs on 64-byte boundaries. */
+struct g5p_boot_layout {
+	u32 offset[0x90];
+	u8 group[0x90];
+	u32 used[2];
+};
+
+static inline void g5p_put32(u8 *p, u32 value)
+{
+	p[0] = value;
+	p[1] = value >> 8;
+	p[2] = value >> 16;
+	p[3] = value >> 24;
+}
+
+static inline void g5p_put64(u8 *p, u64 value)
+{
+	g5p_put32(p, value);
+	g5p_put32(p + 4, value >> 32);
+}
+
+static inline u32 g5p_meta_address(u64 va)
+{
+	/* ca0744: root range 8 bypasses META caches; other shared RAM is global. */
+	u32 prefix = va >= G5P_ROOT_VA && va < G5P_ROOT_VA + 0x1000000 ?
+			     0x40000000 :
+			     0xc0000000;
+
+	return ((u32)va + 0x40000000) | prefix;
+}
+
+static inline int g5p_plan_layout(struct g5p_boot_layout *p)
+{
+	static const struct {
+		u8 cpu, gpu, group;
+		u32 size;
+	} objects[] = {
+		{ 0x44, 0x50, 0, 0x1490 },
+		{ 0x47, 0x51, 0, 0x990 },
+		{ 0x48, 0x52, 0, 0x8e0 },
+		{ 0x49, 0x53, 0, 0x8c0 },
+		{ 0x4a, 0x54, 0, 0x938 },
+		{ 0x4b, 0x55, 0, 0x28 },
+		{ 0x4c, 0x56, 0, 8 },
+		{ 0x4d, 0x57, 0, 0x78c },
+		{ 0x4e, 0x58, 0, 0x84 },
+		{ 0x5e, 0x5f, 1, 0x2058 },
+		{ 0x70, 0x78, 1, 0x20 },
+		{ 0x71, 0x79, 1, 0x80 },
+		{ 0x72, 0x7a, 1, 0x20 },
+		{ 0x73, 0x7b, 1, 0x20 },
+		{ 0x74, 0x7c, 1, 0x2c00 },
+		{ 0x75, 0x7d, 1, 0xb000 },
+		{ 0x4f, 0x59, 1, 0x36000 },
+		{ 0x76, 0x7e, 1, 0x2c00 },
+		{ 0x77, 0x7f, 1, 0x2400 },
+		{ 0x6c, 0x6e, 1, 0x20 },
+		{ 0x6d, 0x6f, 1, 0x1400 },
+		{ 0x60, 0x62, 1, 0x20 },
+		{ 0x64, 0x66, 1, 0x20 },
+		{ 0x68, 0x6a, 1, 0x20 },
+		{ 0x61, 0x63, 1, 0x1400 },
+		{ 0x65, 0x67, 1, 0x1400 },
+		{ 0x69, 0x6b, 1, 0x1400 },
+		/* Separate c95da0 allocations, placed after the recovered group. */
+		{ 0x5c, 0x5d, 1, 8 },
+		{ 0x85, 0x88, 1, 0x400 },
+		{ 0x84, 0x87, 1, 0x400 },
+		{ 0x86, 0x89, 1, 0x800 },
+	};
+	unsigned int i;
+
+	memset(p, 0, sizeof(*p));
+	for (i = 0; i < ARRAY_SIZE(objects); i++) {
+		u32 group = objects[i].group;
+		u32 off = (p->used[group] + 63) & ~63U;
+
+		p->offset[objects[i].cpu] = off;
+		p->offset[objects[i].gpu] = off;
+		p->group[objects[i].cpu] = group;
+		p->group[objects[i].gpu] = group;
+		p->used[group] = off + objects[i].size;
+	}
+	return p->used[0] <= G5P_ROOT_SIZE && p->used[1] <= G5P_SHARED_SIZE ?
+		       0 :
+		       -EINVAL;
+}
+
+static inline u64 g5p_object_va(const struct g5p_boot_layout *p, u32 slot)
+{
+	return (p->group[slot] ? G5P_SHARED_VA : G5P_ROOT_VA) + p->offset[slot];
+}
+
+static inline u8 *g5p_object(const struct g5p_boot_layout *p, u8 *root,
+			     u8 *shared, u32 slot)
+{
+	return (p->group[slot] ? shared : root) + p->offset[slot];
+}
+
+/* ca9b34 + cab44c + cac314: 40-bit PA, 16 KiB GPU pages. */
+static inline u32 g5p_catalogue_entry(u64 pa)
+{
+	return (u32)(pa >> 8) | 1;
+}
+
+static inline u64 g5p_directory_entry(u64 pa)
+{
+	/* Geometry bytes 3c..3f are 08 05 05 15: size, entry/PA/VA shifts. */
+	return pa | 3;
+}
+
+static inline u64 g5p_leaf_entry(u64 pa, u32 attributes)
+{
+	/* caa6e4 range attributes -> ca9a60: META protect, CC / SLC bypass. */
+	return (pa & 0xfffffff000ULL) | (attributes & 0xc) |
+	       ((u64)(attributes & 0x10) << 58) | 1;
+}
+
+static inline void g5p_make_boot_config(struct g5p_ldr_image *im,
+					const struct g5p_boot_layout *p)
+{
+	static const u32 bases[] = { 0x10000000, 0x20000000, 0x40000000,
+				     0x60001000 };
+	static const u32 sizes[] = { 0x18000, 0x4000, 0x4000, 0x4000 };
+	static const u32 offsets[] = { 0x4000, 0x1c000, 0, 0x20000 };
+	u8 *out = im->data + 0x200;
+	unsigned int seg, i;
+
+	for (seg = 0; seg < 4; seg++) {
+		u64 va = G5P_IMAGE_VA + offsets[seg];
+		u32 reg = 0x04850000 + seg * 16;
+		u32 values[] = { bases[seg] | 0xf02, sizes[seg] - 1, (u32)va,
+				 (u32)(va >> 32) | 0x300000 };
+
+		if (seg == 2) {
+			g5p_put32(out, reg + 12);
+			g5p_put32(out + 4, (u32)(va >> 32) | 0x100);
+			out += 8;
+			continue;
+		}
+		for (i = 0; i < 4; i++, out += 8) {
+			g5p_put32(out, reg + i * 4);
+			g5p_put32(out + 4, values[i]);
+		}
+	}
+	for (i = 0; i < im->config_count; i++, out += 8) {
+		g5p_put32(out, im->config[i][0]);
+		g5p_put32(out + 4, im->config[i][1]);
+	}
+	g5p_put64(out, 0);
+	g5p_put32(out + 8, g5p_meta_address(G5P_IMAGE_VA + 0x3ff8));
+	g5p_put32(im->data + 0x3ff8, g5p_meta_address(g5p_object_va(p, 0x50)));
+	g5p_put32(im->data + 0x3ffc, g5p_meta_address(g5p_object_va(p, 0x5f)));
+}
+
+/* c96be8/c9edcc/ca3ccc. Unknown platform policy fields remain zero. */
+static inline void g5p_make_init(const struct g5p_boot_layout *p, u8 *root,
+				 u8 *shared, const struct g5p_ldr_image *im,
+				 u64 catalogue, u64 timestamp)
+{
+	static const u8 roots[] = {
+		0x62, 0x63, 0x66, 0x67, 0x6a, 0x6b, 0x6e, 0x6f,
+		0x78, 0x7c, 0x79, 0x7d, 0x7a, 0x7e, 0x7b, 0x7f,
+	};
+	static const u8 objects[] = { 0x51, 0x52, 0x53, 0x54, 0x55 };
+	static const u8 tail[] = { 0x58, 0x56, 0x57, 0x88, 0x59 };
+	static const u64 pio_pa[] = { 0x201e00000ULL, 0x20e100000ULL,
+				      0x20e104000ULL, 0x201000000ULL };
+	static const u32 pio_size[] = { 0x5000, 0x4000, 0x4000, 0x20000 };
+	static const u32 pio_offset[] = { 0, 0x8000, 0xc000, 0 };
+	u8 *init = g5p_object(p, root, shared, 0x44);
+	u8 *meta = g5p_object(p, root, shared, 0x4d);
+	u8 *ctrl = g5p_object(p, root, shared, 0x5e);
+	unsigned int i;
+
+	memset(root, 0, G5P_ROOT_SIZE);
+	memset(shared, 0, G5P_SHARED_SIZE);
+	for (i = 0; i < ARRAY_SIZE(roots); i++)
+		g5p_put32(init + i * 4,
+			  g5p_meta_address(g5p_object_va(p, roots[i])));
+	for (i = 0; i < ARRAY_SIZE(objects); i++)
+		g5p_put32(init + 0x64 + i * 4,
+			  g5p_meta_address(g5p_object_va(p, objects[i])));
+	for (i = 0; i < ARRAY_SIZE(tail); i++)
+		g5p_put32(init + 0x44c + i * 4,
+			  g5p_meta_address(g5p_object_va(p, tail[i])));
+	for (i = 0; i < 3; i++) {
+		u8 *channel = g5p_object(p, root, shared, 0x47 + i);
+		u32 ptr = g5p_meta_address(g5p_object_va(p, 0x51 + i));
+
+		g5p_put32(channel + 4, ptr);
+		g5p_put32(channel + 12, ptr + 8);
+	}
+	g5p_put32(g5p_object(p, root, shared, 0x48) + 0x778, 0xffffffff);
+	g5p_put32(init + 0x480,
+		  ((u32)(G5P_IMAGE_VA + 0x24000) + 0x40000000) | 0x40000000);
+	g5p_put64(init + 0x484, G5P_IMAGE_VA + 0x24000);
+	g5p_put32(init + 0x48c, 0x55dc);
+	g5p_put64(meta, 0x600000000ULL);
+	g5p_put64(meta + 8, 0xffc00000);
+	g5p_put64(meta + 0x10, 0x300000000ULL);
+	g5p_put64(meta + 0x18, 0x300000000ULL);
+	for (i = 0; i < ARRAY_SIZE(pio_pa); i++) {
+		u8 *entry = meta + 0x630 + i * 16;
+
+		g5p_put64(entry, pio_pa[i]);
+		g5p_put32(entry + 8, i == 3 ? 0 :
+					      g5p_meta_address(G5P_PIO_VA +
+							       pio_offset[i]));
+		g5p_put32(entry + 12, pio_size[i]);
+	}
+	g5p_put32(meta + 0x6c0, 1);
+	g5p_put32(meta + 0x6c8, 1);
+	g5p_put64(meta + 0x6d8, 0x100000000ULL);
+	g5p_put32(meta + 0x6e0, 1);
+	g5p_put32(meta + 0x6e4, 1);
+	/* readChipInfo version 15 -> tables 5942650/5942674 -> 1,5; N=6. */
+	g5p_put32(meta + 0x704, 1);
+	g5p_put32(meta + 0x708, 5);
+	g5p_put32(meta + 0x70c, 6);
+	g5p_put32(meta + 0x758, 0x14);
+	g5p_put32(meta + 0x75c, 0x4000);
+	g5p_put32(meta + 0x760, 0x1020);
+	g5p_put32(meta + 0x764, im->t1_pc);
+	g5p_put32(meta + 0x768, im->t1_sp);
+	g5p_put64(meta + 0x774, G5P_IMAGE_VA);
+	g5p_put64(meta + 0x77c, 0x300000);
+	g5p_put64(meta + 0x784, timestamp);
+	/* Fixed portion of c974f0; dynamic power-policy fields remain zero. */
+	g5p_put64(g5p_object(p, root, shared, 0x4a) + 8, 0x400000000ULL);
+	g5p_put64(g5p_object(p, root, shared, 0x4a) + 0x10, 0x3f800000);
+	g5p_put64(g5p_object(p, root, shared, 0x4a) + 0x28, 0x100000001ULL);
+	g5p_put32(g5p_object(p, root, shared, 0x4a) + 0x38, 100);
+	g5p_put64(g5p_object(p, root, shared, 0x4a) + 0x8f8, timestamp);
+	g5p_put32(ctrl + 0x24, 0x78);
+	g5p_put32(ctrl + 0x30, 1);
+	g5p_put32(ctrl + 0x1044, g5p_meta_address(g5p_object_va(p, 0x87)));
+	g5p_put32(ctrl + 0x1048, g5p_meta_address(g5p_object_va(p, 0x89)));
+	g5p_put32(ctrl + 0x104c, 1);
+	g5p_put64(g5p_object(p, root, shared, 0x86), catalogue);
+}
+
+/* Explicit boot-time hypotheses; never modify a live root table. */
+static inline void g5p_dc_init_variant(const struct g5p_boot_layout *p,
+				       u8 *root, u8 *shared, u32 variant)
+{
+	/* ca0744 uses 40 aliases for cache bypass. Applying that alias to DC
+	 * is an unverified hypothesis, not recovered normal host behavior.
+	 */
+	if (variant == 1)
+		g5p_put32(root + 0x18, g5p_le32(root + 0x18) & ~0x80000000U);
+	if (variant == 1 || variant == 6)
+		g5p_put32(root + 0x1c, g5p_le32(root + 0x1c) & ~0x80000000U);
+	/* c96be8 chooses this policy from host+1af8 bits; both values exist.
+	 * Whether zero is appropriate for our incomplete policy is unknown.
+	 */
+	if (variant == 5)
+		g5p_put32(shared + p->offset[0x5e] + 0x30, 0);
+	/* MINIM 10001ac8 enters policy1000c0d8 only when meta6c0/6c8
+	 * are both nonzero. Experimental pre-MTS bypass; no live length writes.
+	 */
+	if (variant == 7)
+		g5p_put32(g5p_object(p, root, shared, 0x4d) + 0x6c8, 0);
+
+	/* Round13: recovered iOS inputs; variants 8/9 retain meta6c8=1.
+	 * Neither is a complete DVFS policy (table+3c remains absent).
+	 */
+	if (variant == 8 || variant == 9) {
+		u8 *policy = g5p_object(p, root, shared, 0x4a);
+		u8 *meta = g5p_object(p, root, shared, 0x4d);
+		u8 *control = g5p_object(p, root, shared, 0x5e);
+		static const u32 mhz[] = { 0, 340, 474, 550, 723 };
+
+		g5p_put32(policy + 4, 16);
+		if (variant == 9) {
+			g5p_put32(meta + 0x710, 4);
+			g5p_put32(meta + 0x714, 5);
+			for (u32 i = 0; i < 16; i++)
+				g5p_put32(meta + 0x718 + 4 * i,
+					  i < ARRAY_SIZE(mhz) ? mhz[i] : 0);
+			g5p_put32(control + 0x1028, 3348);
+			g5p_put32(control + 0x102c, 400);
+			g5p_put32(control + 0x1030, 400);
+			g5p_put32(policy + 0x7cc, 400);
+			g5p_put32(policy + 0x6fc, 400);
+		}
+	}
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/boot-r73b.inc b/drivers/gpu/apple-g5p/boot-r73b.inc
new file mode 100644
index 000000000..2407ec142
--- /dev/null
+++ b/drivers/gpu/apple-g5p/boot-r73b.inc
@@ -0,0 +1,1180 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* R73b crash-first IRQ174 diagnostics. Included by boot.inc after struct
+ * g5p_boot. Case zero allocates nothing and keeps the r73 IRQ order.
+ * Rows live in CPU RAM only; they are formatted after the epoch, never in the
+ * IRQ service loop. The first 128 rows are retained, the last 128 roll.
+ */
+#include <linux/hrtimer.h>
+#include <linux/log2.h>
+#include <linux/smp.h>
+#include <linux/utsname.h>
+#include "r87b-attach.h"
+#include "r74e112.h"
+#include "heartbeat116.h"
+
+#define G5P_R73B_ROWS 256
+#define G5P_R73B_HEAD 128
+#define G5P_R73B_IRQ_CAP 8192
+#define G5P_R73B_PANIC_ROWS 32
+#define G5P_R73B_TRACE_ROWS 128
+#define G5P_R73B_TRACE_WORDS 9
+#define G5P_R74_IRQ_CAP 262144
+#define G5P_R74_IRQ_CAP_MAX 1048576
+#define G5P_R74_EVENT_FLOOR (256 + 4 * 65536)
+#define G5P_R74_STAGES 8
+#define G5P_R74_MILESTONES 64
+#define G5P_R74_MAX_TICKS 16
+#define G5P_R74_RGX 9
+#define G5P_R74_WORD1 8
+#define G5P_R74F_KINDS 3
+#define G5P_R74F_OFF_US 1000
+#define G5P_R74F_ON_US 1800
+#define G5P_R74F_BELL_MS 250
+#define G5P_R74F_MMU_SLOTS 2
+#define G5P_R74F_MMU_US 1000
+#define G5P_R74G_GRACE_ALIVES 4
+#define G5P_R74G_GRACE_US 20000
+#define G5P_R74G_COMPANION 0x3980
+#define G5P_R74G_RECOVERIES 0x3994
+#define G5P_R74G_CLASS 0x3998
+#define G5P_R74G_BAD_RING BIT(0)
+#define G5P_R74G_BAD_RECORD BIT(1)
+#define G5P_R74G_BAD_PA BIT(2)
+#define G5P_R74G_BAD_HOST BIT(3)
+#define G5P_R74G_BAD_CACHED BIT(4)
+#define G5P_R74G_BAD_FAILED BIT(5)
+#define G5P_R74G_BAD_COMPANION BIT(6)
+#define G5P_R74G_BAD_MUTATION BIT(7)
+#define G5P_R74H_TAIL 128
+#define G5P_R74H_PHYS_MAX 1024
+#define G5P_R74H_PTES 10
+
+/* First-ALIVE submit: wait (reads only) for a GPC request in flight to finish. */
+static unsigned int boot_alive_settle_us = 2000;
+module_param(boot_alive_settle_us, uint, 0600);
+MODULE_PARM_DESC(
+	boot_alive_settle_us,
+	"default0 (single read, as before); 1..5000: when the first-ALIVE submit reads "
+	"R1+0x1000 with bit 4 set (a GPC performance-state request in flight), re-read "
+	"it every 10 us for up to this long before the unchanged state==1 check, as "
+	"Apple's setGPCPerformanceState waits for bit 4; R1 reads only; latched at map");
+
+enum g5p_r73b_phase {
+	G5P_R73B_RELEASE_ENTRY = 1,
+	G5P_R73B_RELEASE_FIFO,
+	G5P_R73B_RELEASE_GPC,
+	G5P_R73B_RELEASE_EXIT,
+	G5P_R73B_IRQ,
+	G5P_R73B_DRAIN_BEFORE,
+	G5P_R73B_DRAIN_AFTER,
+	G5P_R73B_DRAIN_BUSY,
+	G5P_R73B_CAP,
+	G5P_R73B_EVENTS_EXIT,
+	G5P_R73B_DC_PUBLISHED,
+	G5P_R73B_DC_KICKED,
+	G5P_R73B_WAIT_EXIT,
+	G5P_R73B_EXPORT,
+	G5P_R73B_PHASES,
+};
+
+static const char *const g5p_r73b_phase_names[G5P_R73B_PHASES] = {
+	"unknown",	"release-entry", "release-fifo", "release-gpc",
+	"release-exit", "irq",		 "drain-before", "drain-after",
+	"drain-busy",	"cap",		 "events-exit",	 "dc-published",
+	"dc-kicked",	"wait-exit",	 "export",
+};
+
+enum g5p_r73b_owner {
+	G5P_R73B_NONE,
+	G5P_R73B_OWNER_IRQ,
+	G5P_R73B_OWNER_EVENTS,
+	G5P_R73B_OWNER_PREPARE,
+	G5P_R73B_OWNER_PUBLISH,
+	G5P_R73B_OWNER_KICK,
+	G5P_R73B_OWNER_WAIT,
+};
+
+/* Row columns: event, log lane 0, statistics, trace, device control. */
+static const u8 g5p_r73b_row_slots[5] = { 0x70, 0x71, 0x72, 0x73, 0x6c };
+
+struct g5p_r73b_row {
+	u32 seq; /* sequence + 1, published last; zero means empty/torn */
+	u32 phase;
+	u64 t_ns;
+	u32 irq, ack, released, owner, cap_seen;
+	s32 result;
+	u32 cp[5][2];
+};
+
+enum g5p_r74_step {
+	G5P_R74_IRQ_TEST_REFUSED,
+	G5P_R74_PREPARE_BEGIN,
+	G5P_R74_PREPARE_END,
+	G5P_R74_ATTACH_BEGIN,
+	G5P_R74_ATTACH_PUBLISHED,
+	G5P_R74_ATTACH_DOORBELL_BEGIN,
+	G5P_R74_ATTACH_DOORBELL_END,
+	G5P_R74_ATTACH_CONSUMED,
+	G5P_R74_ATTACH_END,
+	G5P_R74_TA_BEGIN,
+	G5P_R74_TA_PUBLISH,
