index 000000000..085e76650
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-latency123.inc
@@ -0,0 +1,294 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Latency123: runtime A/B knobs for the V3 render path, all default off and all writable
+ * through /sys/module/a9_gpu_drm/parameters on a live boot.  Included from drm-render.inc
+ * before drm-render-v3.inc.  The executor is serial and holds the core lock, so the state
+ * below needs no lock of its own.
+ *
+ *   fw_tick_mask (boot.inc)  ctl+0x04, re-applied before every job (RAM)
+ *   slc_evict_us             while a job is in flight, one pass over slc_evict_mib MiB of
+ *                            cacheable kernel memory at most every N us (the waiter's
+ *                            1-2 ms sample cadence bounds it from below); slc_evict_ops:
+ *                            1 read pass, 2 write pass, 4 Normal-NC read of the firmware's
+ *                            root+shared pages, 8 TLBI VMALLE1IS, 16 DSB SY + SEV
+ *   cpu_sync                 1 dma_sync every job BO (device before, CPU after), 2 clean
+ *                            root+shared to PoC before the publish, 4 clean+invalidate the
+ *                            polled pages before every sample
+ *   lat123_log               one RENDER-L123 line per job (times in ms from the submit ioctl)
+ *   pstate_probe             1 PMGR gfx word at job start/end (always-on block), 2 also one
+ *                            read of Fender +0x1000 at the first sample that shows a fresh
+ *                            engine busy rise (engine running, so the block is powered)
+ *
+ * No other register access.  Temporary: none of this is the fix.
+ */
+
+#include <asm/cacheflush.h>
+#include <asm/tlbflush.h>
+
+#define G5P_L123_OP_READ BIT(0)
+#define G5P_L123_OP_WRITE BIT(1)
+#define G5P_L123_OP_FW_READ BIT(2)
+#define G5P_L123_OP_TLBI BIT(3)
+#define G5P_L123_OP_SEV BIT(4)
+#define G5P_L123_SYNC_BO BIT(0)
+#define G5P_L123_SYNC_REGIONS BIT(1)
+#define G5P_L123_SYNC_POLL BIT(2)
+#define G5P_L123_LINE 64
+
+static struct {
+	void *buf;
+	size_t size;
+	u64 sink;
+	/* per job */
+	u64 exec_ns, next_ns, evict_ns, ps_ns;
+	u32 us, mib, ops, sync, passes, tick, ps;
+	u32 pmgr[2];
+	bool seen[2], idle[2], probed;
+	/* render_user_event_wake: pauses ended by an event, the timeout, a post-event poll, legacy */
+	u32 ew[4];
+	u64 ew_ns;
+} g5p_l123;
+
+/* perf60-fillrate.md §11.3 cut 1 (render-user-evwait.h): the phase wait's pause between RAM samples. */
+static unsigned int render_user_event_wake = 2000; /* release8 default */
+module_param(render_user_event_wake, uint, 0600);
+MODULE_PARM_DESC(
+	render_user_event_wake,
+	"perf60 default0 (release8: sleep 1-2 ms between completion samples); N: sleep "
+	"until the next firmware event (the IRQ thread's decode wakes the waiter), at "
+	"most N us (100..20000) as the safety net, and poll every 100 us once the "
+	"phase's own completion event is latched; read live");
+
+/* A word of a firmware object; objects may straddle the region's 16 KiB pages. */
+static u8 *g5p_l123_word(struct g5p_boot *b, u32 slot, u32 field)
+{
+	u32 off = b->layout.offset[slot] + field;
+	struct g5p_dma_page *page = b->layout.group[slot] ? b->shared : b->root;
+
+	return page[off / G5P_GPU_PAGE].cpu + off % G5P_GPU_PAGE;
+}
+
+static void g5p_l123_pages(struct g5p_dma_page *page, u32 count,
+			   void (*op)(unsigned long start, unsigned long end))
+{
+	for (u32 i = 0; i < count; i++)
+		if (page[i].cpu)
+			op((unsigned long)page[i].cpu,
+			   (unsigned long)page[i].cpu + G5P_GPU_PAGE);
+}
+
+static void g5p_l123_page_of(const void *p,
+			     void (*op)(unsigned long start, unsigned long end))
+{
+	unsigned long start = (unsigned long)p &
+			      ~(unsigned long)(G5P_GPU_PAGE - 1);
+
+	op(start, start + G5P_GPU_PAGE);
+}
+
+/* cpu_sync 4: the pages the waiter samples (rings, TA/3D/PM pages, the idle words). */
+static void g5p_l123_poll_pages(struct g5p_boot *b, u32 e)
+{
+	g5p_l123_page_of(g5p_boot_shared(b, 0x60), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_boot_shared(b, 0x64), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_ru_page(b, 0), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_ru_page(b, 1), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_ru_pm_cpu(b), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_ru_global(b, e) + 0x724, dcache_clean_inval_poc);
+	dsb(sy);
+}
+
+static void g5p_l123_bos(struct g5p_drm *d, struct g5p_rjob *job, bool to_cpu)
+{
+	for (u32 i = 0; i < job->obj_count; i++) {
+		struct sg_table *sgt =
+			to_drm_gem_shmem_obj(job->objs[i].obj)->sgt;
+
+		if (!sgt)
+			continue;
+		if (to_cpu)
+			dma_sync_sgtable_for_cpu(d->drm.dev, sgt,
+						 DMA_BIDIRECTIONAL);
+		else
+			dma_sync_sgtable_for_device(d->drm.dev, sgt,
+						    DMA_BIDIRECTIONAL);
+	}
+}
+
+static u32 g5p_l123_pmgr(struct g5p_diag *g)
+{
+	u32 raw = U32_MAX;
+
+	if (!((0) & 1) || !g->pmgr || regmap_read(g->pmgr, 0x80340, &raw))
+		return U32_MAX;
+	return raw;
+}
+
+/* At the executor's entry: this job's knob values and counters. */
+static void g5p_l123_job_reset(struct g5p_diag *g)
+{
+	g5p_l123.exec_ns = ktime_get_ns();
+	g5p_l123.next_ns = 0;
+	g5p_l123.evict_ns = 0;
+	g5p_l123.ps_ns = 0;
+	g5p_l123.passes = 0;
+	g5p_l123.ps = U32_MAX;
+	g5p_l123.probed = false;
+	memset(g5p_l123.ew, 0, sizeof(g5p_l123.ew));
+	g5p_l123.ew_ns = 0;
+	g5p_l123.seen[0] = false;
+	g5p_l123.seen[1] = false;
+	g5p_l123.us = (0);
+	g5p_l123.mib = clamp((16), 1U, 64U);
+	g5p_l123.ops = (1);
+	g5p_l123.sync = (0);
+	g5p_l123.pmgr[0] = g5p_l123_pmgr(g);
+	g5p_l123.pmgr[1] = U32_MAX;
+}
+
+/* After the job's records are written, before they are cleaned and published.  May sleep. */
+static void g5p_l123_job_prepare(struct g5p_drm *d, struct g5p_rjob *job)
+{
+	struct g5p_boot *b = d->core->boot;
+	u8 *tick = g5p_l123_word(b, G5P_L123_CTL, 4);
+	u32 mask = (0);
+	size_t size = (size_t)g5p_l123.mib << 20;
+
+	if (mask <= G5P_L123_TICK_MASK && g5p_le32(tick) != mask) {
+		g5p_put32(tick, mask);
+		dma_wmb();
+	}
+	g5p_l123.tick = g5p_le32(tick);
+
+	if (!g5p_l123.us ||
+	    !(g5p_l123.ops & (G5P_L123_OP_READ | G5P_L123_OP_WRITE))) {
+		vfree(g5p_l123.buf);
+		g5p_l123.buf = NULL;
+		g5p_l123.size = 0;
+	} else if (g5p_l123.size != size) {
+		vfree(g5p_l123.buf);
+		g5p_l123.buf = vmalloc(size);
+		g5p_l123.size = g5p_l123.buf ? size : 0;
+		if (g5p_l123.buf)
+			memset(g5p_l123.buf, 0x5a, size);
+	}
+
+	if (g5p_l123.sync & G5P_L123_SYNC_BO)
+		g5p_l123_bos(d, job, false);
+	if (g5p_l123.sync & G5P_L123_SYNC_REGIONS) {
+		g5p_l123_pages(b->root, ARRAY_SIZE(b->root), dcache_clean_poc);
+		g5p_l123_pages(b->shared, ARRAY_SIZE(b->shared),
+			       dcache_clean_poc);
+		dsb(sy);
+	}
+	if (g5p_l123.sync & G5P_L123_SYNC_POLL)
+		g5p_l123_poll_pages(b, 0);
+}
+
+/* One streaming pass and the other per-pass operations. */
+static void g5p_l123_evict(struct g5p_boot *b)
+{
+	u64 t0 = ktime_get_ns(), sum = 0;
+	u32 ops = g5p_l123.ops;
+
+	if ((ops & G5P_L123_OP_READ) && g5p_l123.buf) {
+		u64 *p = g5p_l123.buf;
+
+		for (size_t i = 0; i < g5p_l123.size / 8;
+		     i += G5P_L123_LINE / 8)
+			sum += READ_ONCE(p[i]);
+	}
+	if ((ops & G5P_L123_OP_WRITE) && g5p_l123.buf) {
+		u64 *p = g5p_l123.buf;
+
+		for (size_t i = 0; i < g5p_l123.size / 8;
+		     i += G5P_L123_LINE / 8)
+			WRITE_ONCE(p[i], i);
+	}
+	if (ops & G5P_L123_OP_FW_READ) {
+		struct g5p_dma_page *regions[] = { b->root, b->shared };
+		u32 counts[] = { ARRAY_SIZE(b->root), ARRAY_SIZE(b->shared) };
+
+		for (u32 r = 0; r < ARRAY_SIZE(regions); r++)
+			for (u32 i = 0; i < counts[r]; i++)
+				for (u32 at = 0;
+				     regions[r][i].cpu && at < G5P_GPU_PAGE;
+				     at += G5P_L123_LINE)
+					sum += READ_ONCE(*(
+						const u32 *)(regions[r][i].cpu +
+							     at));
+	}
+	if (ops & G5P_L123_OP_TLBI)
+		flush_tlb_all();
+	if (ops & G5P_L123_OP_SEV) {
+		dsb(sy);
+		sev();
+	}
+	WRITE_ONCE(g5p_l123.sink, g5p_l123.sink + sum);
+	g5p_l123.passes++;
+	g5p_l123.evict_ns += ktime_get_ns() - t0;
+}
+
+/* Replaces the waiter's sleep between two RAM samples of engine e.  seen: d->event_serial as
+ * read after the drain and before this sample (render-user-evwait.h).
+ */
+static void g5p_l123_pause(struct g5p_drm *d, struct g5p_diag *g, u32 e,
+			   const struct g5p_rv3_ev *s, u64 seen)
+{
+	u64 now = s->ns, t0;
+	enum g5p_ew_act act;
+	u32 wait_us;
+
+	if (((0) & 2) && !g5p_l123.probed && g5p_l123.seen[e] &&
+	    g5p_l123.idle[e] && !s->idle_ok && !s->failed && !s->proto &&
+	    !g5p_ru_term_failed(&g5p_rv3_term) && !READ_ONCE(g->boot->failed)) {
+		struct g5p_mmio_ticket t;
+
+		/* an R1-only ticket of the register licence (mmio.inc), never a bare read */
+		if (!g5p_mmio_hold(g, &t, G5P_MMIO_CENSUS))
+			g5p_mmio_release(g, &t);
+		g5p_l123.ps = t.gpc;
+		g5p_l123.ps_ns = ktime_get_ns();
+		g5p_l123.probed = true;
+	}
+	g5p_l123.seen[e] = true;
+	g5p_l123.idle[e] = s->idle_ok;
+	if (g5p_l123.us && now >= g5p_l123.next_ns) {
+		g5p_l123_evict(g->boot);
+		g5p_l123.next_ns = now + (u64)g5p_l123.us * NSEC_PER_USEC;
+	}
+	act = g5p_ew_plan(READ_ONCE(render_user_event_wake), s->event,
+			  &wait_us);
+	t0 = ktime_get_ns();
+	if (act == G5P_EW_LEGACY) {
+		usleep_range(1000, 2000);
+		g5p_l123.ew[3]++;
+	} else if (act == G5P_EW_SHORT) {
+		usleep_range(wait_us, wait_us + wait_us / 2);
+		g5p_l123.ew[2]++;
+	} else if (wait_event_hrtimeout(
+			   d->ev_wq,
+			   g5p_ew_woken(seen, READ_ONCE(d->event_serial)),
+			   us_to_ktime(wait_us))) {
+		g5p_l123.ew[1]++; /* -ETIME: the safety net */
+	} else {
+		g5p_l123.ew[0]++;
+	}
+	g5p_l123.ew_ns += ktime_get_ns() - t0;
+	if (g5p_l123.sync & G5P_L123_SYNC_POLL)
+		g5p_l123_poll_pages(g->boot, e);
+}
+
+/* After the receipt.  One line per job while lat123_log is set. */
+static void g5p_l123_job_end(struct g5p_drm *d, struct g5p_rjob *job, u32 seq,
+			     int ret)
+{
+	struct g5p_diag *g = d->core;
+
+	if (!ret && (g5p_l123.sync & G5P_L123_SYNC_BO))
+		g5p_l123_bos(d, job, true);
+	g5p_l123.pmgr[1] = g5p_l123_pmgr(g);
+	{
+		return;
+	}
+}
diff --git a/drivers/gpu/drm/apple-g5p/drm-prime.inc b/drivers/gpu/drm/apple-g5p/drm-prime.inc
new file mode 100644
index 000000000..bd513b969
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-prime.inc
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* PRIME for shmem GEM BOs.
+ *
+ * Export: Mesa WSI/client buffers and kmsro bookkeeping. The dma-buf adds
+ * begin/end_cpu_access, so an importer that CPU-reads (simpledrm's blit,
+ * llvmpipe) gets cache maintenance on the G5P DMA mapping. vmap/mmap reuse
+ * the shmem helpers (write-combined when the device is not DMA-coherent).
+ *
+ * Import: foreign dma-bufs, e.g. simpledrm dumb buffers that the GPU renders
+ * into for scanout. The attachment stays mapped (pinned) for the life of the
+ * GEM object; VM_BIND maps its sg_table. Render jobs listing an imported BO
+ * get whole-buffer cache maintenance and dma_resv fences (drm-render.inc).
+ */
+
+static int g5p_dmabuf_begin_cpu_access(struct dma_buf *buf,
+				       enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj = buf->priv;
+	struct sg_table *sgt = to_drm_gem_shmem_obj(obj)->sgt;
+
+	/* No device mapping yet means no device-owned cache lines either. */
+	if (sgt)
+		dma_sync_sgtable_for_cpu(obj->dev->dev, sgt, DMA_BIDIRECTIONAL);
+	return 0;
+}
+
+static int g5p_dmabuf_end_cpu_access(struct dma_buf *buf,
+				     enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj = buf->priv;
+	struct sg_table *sgt = to_drm_gem_shmem_obj(obj)->sgt;
+
+	if (sgt)
+		dma_sync_sgtable_for_device(obj->dev->dev, sgt,
+					    DMA_BIDIRECTIONAL);
+	return 0;
+}
+
+static const struct dma_buf_ops g5p_dmabuf_ops = {
+	.attach = drm_gem_map_attach,
+	.detach = drm_gem_map_detach,
+	.map_dma_buf = drm_gem_map_dma_buf,
+	.unmap_dma_buf = drm_gem_unmap_dma_buf,
+	.release = drm_gem_dmabuf_release,
+	.mmap = drm_gem_dmabuf_mmap,
+	.vmap = drm_gem_dmabuf_vmap,
+	.vunmap = drm_gem_dmabuf_vunmap,
+	.begin_cpu_access = g5p_dmabuf_begin_cpu_access,
+	.end_cpu_access = g5p_dmabuf_end_cpu_access,
+};
+
+static struct dma_buf *g5p_gem_prime_export(struct drm_gem_object *obj,
+					    int flags)
+{
+	struct dma_buf_export_info info = {
+		.exp_name = KBUILD_MODNAME,
+		.owner = obj->dev->driver->fops->owner,
+		.ops = &g5p_dmabuf_ops,
+		.size = obj->size,
+		.flags = flags,
+		.priv = obj,
+		.resv = obj->resv,
+	};
+
+	return drm_gem_dmabuf_export(obj->dev, &info);
+}
+
+static int g5p_prime_handle_to_fd(struct drm_device *dev, struct drm_file *file,
+				  u32 handle, u32 flags, int *fd)
+{
+	return drm_gem_prime_handle_to_fd(dev, file, handle, flags, fd);
+}
+
+static int g5p_prime_fd_to_handle(struct drm_device *dev, struct drm_file *file,
+				  int fd, u32 *handle)
+{
+	return drm_gem_prime_fd_to_handle(dev, file, fd, handle);
+}
+
+/* Our own export comes back as the same GEM object (the core's identity check
+ * only knows its default ops); anything else is attached and mapped.
+ */
+static struct drm_gem_object *g5p_gem_prime_import(struct drm_device *dev,
+						   struct dma_buf *buf)
+{
+	struct drm_gem_object *obj = buf->priv;
+
+	if (buf->ops == &g5p_dmabuf_ops && obj->dev == dev) {
+		drm_gem_object_get(obj);
+		return obj;
+	}
+	return drm_gem_prime_import(dev, buf);
+}
+
+/* Foreign buffers are GPU READ|WRITE data, never executable, and must be
+ * whole 16KiB GPU pages within the BO size limit.
+ */
+static struct drm_gem_object *
+g5p_prime_import_sg_table(struct drm_device *dev,
+			  struct dma_buf_attachment *attach,
+			  struct sg_table *sgt)
+{
+	struct drm_gem_object *obj;
+
+	if (attach->dmabuf->size & (G5P_GPU_PAGE - 1) ||
+	    attach->dmabuf->size > G5P_MAX_BO_SIZE)
+		return ERR_PTR(-EINVAL);
+	obj = drm_gem_shmem_prime_import_sg_table(dev, attach, sgt);
+	if (!IS_ERR(obj)) {
+		to_g5p_bo(obj)->roles = DRM_G5P_BO_READ | DRM_G5P_BO_WRITE;
+		g5p_bo_track(obj);
+	}
+	return obj;
+}
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-sched.inc b/drivers/gpu/drm/apple-g5p/drm-render-sched.inc
new file mode 100644
index 000000000..21dc64d89
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-render-sched.inc
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * The render scheduler (docs/gpu/multi-client-design.md "Stage 2/3 as built"): one worker on
+ * the ordered render_wq serves the contexts round-robin (core/render-user-sched.h).  Jobs wait
+ * for their inputs on dma-fence callbacks, not in the worker, so one client's unsignalled
+ * fence never holds up another client.  Each picked job runs to completion on the one shared
+ * channel (one credit), exactly as a work item did before; a context's close item runs after
+ * its last job.  Included from drm-render.inc after drm-render-v3.inc.
+ *
+ * The shape is drm_sched's (entity FIFO, run-list RR, dependency callbacks, entity teardown
+ * after the last job), so stage 4 can replace it with drm_sched without a UAPI change.
+ */
+
+static struct dma_fence *g5p_rjob_dep(struct g5p_rjob *job, u32 i)
+{
+	return i < job->input_count ? job->inputs[i] :
+				      job->deps[i - job->input_count];
+}
+
+/* A signalled input: its error, or that of any fence it wraps (array, chain), else 0. */
+static int g5p_render_fence_status(struct dma_fence *fence)
+{
+	struct dma_fence_unwrap cursor;
+	struct dma_fence *part;
+	u32 unwrapped = 0;
+	int ret = dma_fence_get_status(fence);
+
+	if (ret < 0)
+		return ret;
+	dma_fence_unwrap_for_each(part, &cursor, fence) {
+		ret = dma_fence_get_status(part);
+		if (ret <= 0 || ++unwrapped > 4096) {
+			dma_fence_put(cursor.chain);
+			return ret < 0 ? ret : -ETIMEDOUT;
+		}
+	}
+	return 0;
+}
+
+/* Fence callback (any context, the fence lock held): the head job's input signalled. */
+static void g5p_rjob_dep_cb(struct dma_fence *fence, struct dma_fence_cb *cb)
+{
+	struct g5p_rjob *job = container_of(cb, struct g5p_rjob, cb);
+
+	WRITE_ONCE(job->cb_fired, true);
+	mod_delayed_work(job->gpu->render_wq, &job->gpu->rdev->sched_work, 0);
+}
+
+/* Scheduler lock held: no callback of this job stays armed. */
+static void g5p_rjob_disarm(struct g5p_rjob *job)
+{
+	if (job->cb_fence)
+		dma_fence_remove_callback(job->cb_fence, &job->cb);
+	job->cb_fence = NULL;
+}
+
+/*
+ * Scheduler lock held: may the head job of its context run now?  Walks its explicit inputs,
+ * then its implicit dependencies, in order; at the first unsignalled one it arms a callback
+ * and reports the job's input deadline.  A failed input, the deadline (G5P_RU_INPUT_MS after
+ * the submit, as the old in-worker wait) and closed admission make it ready with an error, so
+ * that it fails before the hardware and its fence still signals in order.
+ */
+static bool g5p_rsched_ready(struct g5p_rs_job *node, void *cookie,
+			     unsigned long *deadline)
+{
+	struct g5p_rjob *job = container_of(node, struct g5p_rjob, node);
+
+	if (job->setup_error || job->dep_error)
+		return true;
+	if (g5p_r8_admit_closed(&g5p_r8_state.admit)) {
+		g5p_rjob_disarm(job);
+		job->dep_error = -ESHUTDOWN;
+		return true;
+	}
+	if (job->cb_fence) {
+		if (!READ_ONCE(job->cb_fired))
+			goto pending;
+		job->cb_fence = NULL;
+	}
+	while (job->dep_next < job->input_count + job->dep_count) {
+		struct dma_fence *fence = g5p_rjob_dep(job, job->dep_next);
+
+		if (dma_fence_is_signaled(fence)) {
+			job->dep_error = g5p_render_fence_status(fence);
+			if (job->dep_error)
+				return true;
+			job->dep_next++;
+			continue;
+		}
+		WRITE_ONCE(job->cb_fired, false);
+		if (dma_fence_add_callback(fence, &job->cb, g5p_rjob_dep_cb))
+			continue; /* -ENOENT: signalled meanwhile */
+		job->cb_fence = fence;
+		goto pending;
+	}
+	return true;
+pending:
+	if (time_after_eq(jiffies, job->deadline)) {
+		g5p_rjob_disarm(job);
+		job->dep_error = -ETIMEDOUT;
+		return true;
+	}
+	*deadline = job->deadline;
+	return false;
+}
+
+static void g5p_rsched_kick(struct g5p_drm *d)
+{
+	mod_delayed_work(d->render_wq, &d->rdev->sched_work, 0);
+}
+
+/* Submit, render_submit_lock held: an accepted job joins its context's FIFO. */
+static void g5p_rsched_push(struct g5p_drm *d, struct g5p_render *r,
+			    struct g5p_rjob *job)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&d->rdev->sched_lock, flags);
+	g5p_rs_push(&d->rdev->sched, &r->entity, &job->node);
+	spin_unlock_irqrestore(&d->rdev->sched_lock, flags);
+	g5p_rsched_kick(d);
+}
+
+/* The close item joins the context's entity behind its jobs; false if one is queued. */
+static bool g5p_rsched_close(struct g5p_drm *d, struct g5p_render *r)
+{
+	unsigned long flags;
+	bool queued;
+
+	spin_lock_irqsave(&d->rdev->sched_lock, flags);
+	queued = g5p_rs_close(&d->rdev->sched, &r->entity);
+	spin_unlock_irqrestore(&d->rdev->sched_lock, flags);
+	if (queued)
+		g5p_rsched_kick(d);
+	return queued;
+}
+
+static void g5p_render_run(struct g5p_rjob *job);
+static void g5p_render_close_run(struct g5p_render *r);
+static void g5p_render_close_deferred(struct g5p_drm *d);
+
+/*
+ * The worker: pick, run to completion, repeat; then sleep until a callback, a submit or the
+ * earliest input deadline wakes it.  render_wq is ordered, so this never runs twice at once,
+ * and it is the only writer of the device's job state, as each job's work item was.
+ */
+static void g5p_rsched_work(struct work_struct *work)
+{
+	struct g5p_rdev *rd = container_of(to_delayed_work(work),
+					   struct g5p_rdev, sched_work);
+	struct g5p_drm *d = rd->drm;
+
+	/* Each item drops the references it held; the device must outlive this loop. */
+	drm_dev_get(&d->drm);
+	for (;;) {
+		struct g5p_rs_entity *e;
+		struct g5p_rs_job *node;
+		struct g5p_render *r;
+		struct g5p_context *c;
+		unsigned long flags, wake = 0;
+		bool has_wake;
+		int what;
+
+		/* A lost job blocks the channel: hold every job until the drain is decided, and
+		 * until a recovery the drain or the executor asked for has run.
+		 */
+		if (READ_ONCE(rd->stuck) || READ_ONCE(rd->recovering)) {
+			if (rd->stuck ? g5p_rv3_drain(d) : g5p_rv3_recover(d))
+				continue;
+			queue_delayed_work(d->render_wq, &rd->sched_work,
+					   msecs_to_jiffies(100));
+			break;
+		}
+		spin_lock_irqsave(&rd->sched_lock, flags);
+		what = g5p_rs_pick(&rd->sched, g5p_rsched_ready, d, &e, &node,
+				   &wake, &has_wake);
+		spin_unlock_irqrestore(&rd->sched_lock, flags);
+		if (what == G5P_RS_IDLE) {
+			if (has_wake)
+				queue_delayed_work(
+					d->render_wq, &rd->sched_work,
+					max_t(long, (long)(wake - jiffies), 1));
+			break;
+		}
+		if (what == G5P_RS_JOB) {
+			g5p_render_run(
+				container_of(node, struct g5p_rjob, node));
+			g5p_render_close_deferred(d);
+			continue;
+		}
+		r = container_of(e, struct g5p_render, entity);
+		c = r->ctx;
+		g5p_render_close_run(r);
+		spin_lock_irqsave(&rd->sched_lock, flags);
+		g5p_rs_closed(&rd->sched, e);
+		spin_unlock_irqrestore(&rd->sched_lock, flags);
+		/* The close item's own reference (g5p_render_close()); r may go with it. */
+		g5p_context_put(c);
+		drm_dev_put(&d->drm);
+	}
+	drm_dev_put(&d->drm);
+}
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-unbind.inc b/drivers/gpu/drm/apple-g5p/drm-render-unbind.inc
new file mode 100644
index 000000000..36550c443
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-render-unbind.inc
@@ -0,0 +1,488 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Unbinding firmware slots (docs/gpu/multi-client-design.md §4.5): a closed context's pair
+ * (stage 2, core/render-user-close.h) and the render frontend's share of the reboot quiesce
+ * (core/render-user-quiesce.h, docs/gpu/experiments/mcfold2-kexec.md).
+ * Included from drm-render.inc after drm-render-v3.inc.
+ */
+
+/* The RAM words of `slot` and of its unbind record at ring entry `index`. */
+static void g5p_render_slot_mem(struct g5p_boot *b, u32 slot, u32 index,
+				struct g5p_ru_slot_mem *m)
+{
+	for (u32 j = 0; j < 5; j++) {
+		u32 at = b->layout.offset[0x6d] + (index & 255) * 20 + j * 4;
+
+		m->rec[j] =
+			b->shared[at / G5P_GPU_PAGE].cpu + at % G5P_GPU_PAGE;
+	}
+	m->pa = g5p_boot_shared(b, 0x86) + slot * 8;
+	m->host = g5p_boot_shared(b, 0x84) + slot * 4;
+	m->cached = g5p_boot_shared(b, 0x85) + slot * 4;
+}
+
+/*
+ * Unbind `n` firmware slots in one RAM-only DC3 batch: PA and host tag of each to zero, one
+ * record {3, slot} per slot, one producer store, then the RAM-only wait of a bind and a check
+ * that the firmware's DC3 handler copied the zero tag of every slot.  No doorbell and no
+ * register access, so it is safe after a job retired and while the GPU may be idle-gated.
+ *
+ * The caller holds the core lock (the DC ring has one writer) and has retired every use of
+ * these slots: no job of theirs is queued on the firmware or in flight.  On success the
+ * firmware holds, per slot, PA 0, host and cached tag 0 and CBASE 0, with the slot's PC level
+ * invalidated; the slot may be bound again by a later DC3.  Its translations stay allocated:
+ * freeing them is the caller's step, after this returns 0.  A batch that is not consumed in
+ * time keeps later binds and unbinds refused until the firmware catches up (dc_pending).
+ */
+static int g5p_rv3_unbind_slots(struct g5p_drm *d, const u32 *slots, u32 n,
+				const char *why)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	struct g5p_ru_slot_sample s = {};
+	struct g5p_ru_slot_mem m;
+	u64 pub_ns, consumed_ns = 0;
+	u32 start, cons, target, bad = 0, verified = 0;
+	int ret;
+
+	lockdep_assert_held(&g->lock);
+	if (!g5p_ru_unbind_fits(n))
+		return -EINVAL;
+	for (u32 i = 0; i < n; i++)
+		if (slots[i] < G5P_RU_SLOT_MIN || slots[i] > G5P_RU_SLOT_MAX)
+			return -EINVAL;
+	dma_rmb();
+	start = READ_ONCE(ctl[4]);
+	cons = READ_ONCE(ctl[0]);
+	if (start > 255 || cons != start ||
+	    (rd->dc_pending && cons != rd->dc_wait)) {
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 unbind why=%s refused slots=%u dc=%u/%u pending=%u: ring busy; no "
+			"hardware touched end=v3\n",
+			why, n, cons, start, rd->dc_pending);
+		return -EBUSY;
+	}
+	rd->dc_pending = false;
+	for (u32 i = 0; i < n; i++) {
+		g5p_render_slot_mem(b, slots[i], start + i, &m);
+		g5p_ru_unbind_publish(&m, slots[i]);
+	}
+	target = (start + n) & 255;
+	dma_wmb();
+	pub_ns = ktime_get_ns();
+	smp_store_release(&ctl[4], target);
+	dma_wmb();
+	g5p_rv3_dc_kick(g, start, target, why);
+	ret = g5p_rv3_dc_wait(g, target, &consumed_ns);
+	if (ret == -ETIMEDOUT) {
+		rd->dc_pending = true;
+		rd->dc_wait = target;
+	}
+	dma_rmb();
+	for (u32 i = 0; i < n; i++) {
+		u32 one;
+
+		g5p_render_slot_mem(b, slots[i], start + i, &m);
+		g5p_ru_slot_read(&m, READ_ONCE(ctl[0]), READ_ONCE(ctl[4]), &s);
+		one = g5p_ru_unbind_check(&s, slots[i], target);
+		bad |= one;
+		verified += !one;
+	}
+	if (!ret && bad)
+		ret = -EUCLEAN;
+	dev_emerg(
+		g->dev,
+		"RENDER-V3 unbind why=%s slots=%u verified=%u ret=%d consumed_us=%lld "
+		"dc=%u->%u/%u bad=%#x first=%u last=%u mode=ram-dc3 end=v3\n",
+		why, n, verified, ret, g5p_rv3_us(pub_ns, consumed_ns), start,
+		s.cons, s.prod, bad, slots[0], slots[n - 1]);
+	return ret;
+}
+
+/*
+ * render_user_close_park: bind a closed context's just-unbound pair to the park catalogue, one
+ * DC3 pair as a context's bind (g5p_render_vm_prepare()), checked the same way.  The catalogue
+ * holds the firmware window's entry and the borrowed sink entry, both stable within an epoch, so
+ * rewriting them for a later park never clears what an earlier parked pair resolves through.
+ * Core lock held, between jobs (the close item), RAM only and no register: as the unbind.
+ */
+static int g5p_rv3_park(struct g5p_drm *d, struct g5p_render *r)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	struct g5p_ru_bind_sample s = {};
+	struct g5p_ru_bind_mem m;
+	u64 pub_ns, consumed_ns = 0;
+	u32 start, target, entry, sink, bad = 0;
+	int ret;
+
+	lockdep_assert_held(&g->lock);
+	if (!rd->park.cpu) {
+		ret = g5p_vm_alloc_page(d->drm.dev, &rd->park);
+		if (ret)
+			return ret;
+		memset(rd->park.cpu, 0, G5P_GPU_PAGE);
+	}
+	ret = g5p_render_fw_entry(d, r, &entry);
+	if (ret)
+		return ret;
+	dma_rmb();
+	start = READ_ONCE(ctl[4]);
+	g5p_render_bind_mem(b, r->slot, start, &m);
+	g5p_ru_bind_read(&m, READ_ONCE(ctl[0]), start, &s);
+	if (start > 255 || rd->dc_pending || g5p_ru_bind_busy(&s)) {
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 park refused slots=%u/%u dc=%u/%u pending=%u busy=%#x: the pair stays "
+			"unbound end=v3\n",
+			r->slot[0], r->slot[1], s.cons, start, rd->dc_pending,
+			g5p_ru_bind_busy(&s));
+		return -EBUSY;
+	}
+	sink = b->sink_ready ? g5p_le32(b->catalogue.cpu) : 0;
+	if (g5p_le32(rd->park.cpu + G5P_RU_FIRMWARE_CI * 4) != entry)
+		g5p_put32(rd->park.cpu + G5P_RU_FIRMWARE_CI * 4, entry);
+	if (g5p_le32(rd->park.cpu) != sink)
+		g5p_put32(rd->park.cpu, sink);
+	g5p_table_clean_page(g, &rd->park);
+	dsb(sy);
+	g5p_ru_bind_publish(&m, r->slot, rd->park.dma, G5P_RU_PARK_TAG);
+	target = (start + 2) & 255;
+	dma_wmb();
+	pub_ns = ktime_get_ns();
+	smp_store_release(&ctl[4], target);
+	dma_wmb();
+	g5p_rv3_dc_kick(g, start, target, "park");
+	ret = g5p_rv3_dc_wait(g, target, &consumed_ns);
+	if (ret == -ETIMEDOUT) {
+		rd->dc_pending = true;
+		rd->dc_wait = target;
+	}
+	dma_rmb();
+	g5p_render_bind_mem(b, r->slot, start, &m);
+	g5p_ru_bind_read(&m, READ_ONCE(ctl[0]), READ_ONCE(ctl[4]), &s);
+	if (!ret) {
+		bad = g5p_ru_bind_check(&s, r->slot, rd->park.dma,
+					G5P_RU_PARK_TAG, target);
+		ret = bad ? -EUCLEAN : 0;
+	}
+	rd->parks += !ret;
+	dev_emerg(
+		g->dev,
+		"RENDER-V3 park slots=%u/%u ret=%d consumed_us=%lld dc=%u->%u/%u bad=%#x "
+		"parks=%u pc=%pad end=v3\n",
+		r->slot[0], r->slot[1], ret, g5p_rv3_us(pub_ns, consumed_ns),
+		start, s.cons, s.prod, bad, rd->parks, &rd->park.dma);
+	return ret;
+}
+
+/* Drop what the claim of the device took (g5p_render_device_claim()); the device stays
+ * claimed for render.  Returns whether a context reference was dropped.
+ */
+static bool g5p_render_unclaim(struct g5p_drm *d, struct g5p_render *r)
+{
+	if (!r->claimant)
+		return false;
+	r->claimant = false;
+	if (d->quarantined_context == r->ctx)
+		d->quarantined_context = NULL;
+	return true;
+}
+
+/*
+ * The close item of a TYPED_V3 context (multi-client-design.md "Stage 2/3 as built"): the
+ * scheduler runs it after every job of the context, so every use of the pair has retired or
+ * failed.  RAM only: the unbind is g5p_rv3_unbind_slots() for this pair under the core lock.
+ * After a verified unbind the binding's references go, and the last one frees the VM tables,
+ * render targets and mappings (unpinning the BOs) and returns the slots
+ * (g5p_render_release()).  Anything the firmware may still hold is retained until reboot.
+ */
+/* perf60 (docs/gpu/experiments/perf60-clock.md), corrected by the release8 bench (bench-gaps3,
+ * render-user-pmset.h): the PM writes a previous PM context back (its free list F, through that
+ * context's TA slot) not once at the switch but on the later jobs of the next context, until a
+ * third context runs.  A closed context therefore keeps its slots bound and its set and pages alive
+ * while it is the last job's context or the previous distinct one; its unbind and release run once
+ * it is neither.  At most those two wait.  (The first version held only the last job's context and
+ * released it after one other job; 2 held one job longer, by job records: both released it while
+ * the PM still wrote to it.)  RAM only: bookkeeping and the close item's references.
+ */
+/* release8 default */
+
+/*
+ * A close item follows every job of this context on the ordered render worker.
+ * resident_gone, set under the file lock before queueing it, rejects all later
+ * VM_BIND and context creation. Thus the close item owns vm->maps exclusively.
+ *
+ * Idle VM_BIND UNMAP already drops a user mapping's pages after retirement.
+ * Do that here without releasing the PM's write-back route: no unbind, no
+ * table pruning, no PM set/pool/aux/RT release, no pm_last/pm_prev change. The
+ * PM free list is in the firmware window, never in vm->maps. All user mappings
+ * must pass the same range check as VM_BIND before any PTE is touched.
+ *
+ * No new kick of this detached context can occur. Clean the cleared user PTEs
+ * to PoC, but do not publish a tag, invalidate a slot or access R0. The PM can
+ * keep using its unchanged translations and pages, including cached ones.
+ * Failed/queued/terminal/shutdown epochs keep every BO, as before.
+ */
+static void g5p_render_close_trim(struct g5p_render *r)
+{
+	struct g5p_context *c = r->ctx;
+	struct g5p_drm *d = c->gpu;
+	struct g5p_diag *g = d->core;
+	struct g5p_vm *vm = c->vm;
+	struct g5p_boot *b;
+	struct g5p_ru_close_in in;
+	struct g5p_mapping *m, *tmp;
+	struct g5p_pt *pt;
+	u64 pinned;
+	u32 maps, why;
+
+	if (!vm->map_count || !vm->resident_gone || !r->closing ||
+	    !r->detached || !mutex_trylock(&g->lock))
+		return;
+	b = g->boot;
+	in = (struct g5p_ru_close_in){
+		.retained = r->retained,
+		.bound = r->bound,
+		/* Match close_run: a successfully drained lost job has no user-memory use left. */
+		.bad = READ_ONCE(c->bad) && !r->lost_drained,
+		.term_failed = g5p_ru_term_failed(&g5p_rv3_term),
+		.dev_failed = !b || READ_ONCE(b->failed),
+		.stopped = !b || READ_ONCE(b->stopped),
+		.shutdown = g5p_r8_admit_closed(&g5p_r8_state.admit),
+		.dc_pending = d->rdev->dc_pending,
+		.queued = atomic_read(&r->queued),
+	};
+	if (g5p_ru_close_plan(&in, &why) != G5P_RU_CLOSE_UNBIND)
+		goto out;
+	list_for_each_entry(m, &vm->maps, link)
+		if (!g5p_user_range_valid(m->node.start, m->node.size) ||
+		    (m->node.start < G5P_RU_PRIVATE_VA + G5P_RU_PRIVATE_SIZE &&
+		     G5P_RU_PRIVATE_VA < m->node.start + m->node.size))
+			goto out;
+
+	pinned = vm->pinned_bytes;
+	maps = vm->map_count;
+	list_for_each_entry(m, &vm->maps, link)
+		g5p_vm_clear(vm, d->drm.dev, m->node.start, m->node.size);
+	g5p_table_clean_page(g, &vm->root);
+	list_for_each_entry(pt, &vm->tables, link)
+		g5p_table_clean_page(g, &pt->page);
+	dsb(sy);
+	list_for_each_entry_safe(m, tmp, &vm->maps, link) {
+		vm->mapped_bytes -= m->node.size;
+		drm_mm_remove_node(&m->node);
+		list_del(&m->link);
+		vm->map_count--;
+		g5p_vm_obj_put(vm, m->obj);
+		drm_gem_object_put(m->obj);
+		kfree(m);
+	}
+	dev_info(
+		g->dev,
+		"RENDER-V3 close-trim slots=%u/%u maps=%u unpinned=%lluK remaining=%lluK "
+		"device_pinned=%lluK pm=retained end=v3\n",
+		r->slot[0], r->slot[1], maps, (pinned - vm->pinned_bytes) >> 10,
+		vm->pinned_bytes >> 10, READ_ONCE(d->pinned_bytes) >> 10);
+out:
+	mutex_unlock(&g->lock);
+}
+
+/* render_user_close_defer: may the firmware's PM still write this context's state back? */
+static bool g5p_render_pm_holds(struct g5p_rdev *rd, struct g5p_render *r,
+				u32 mode)
+{
+	return mode && g5p_pmset_holds(rd->pm_last, rd->pm_prev, r);
+}
+
+static void g5p_render_close_run(struct g5p_render *r)
+{
+	struct g5p_context *c = r->ctx;
+	struct g5p_drm *d = c->gpu;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	struct g5p_ru_close_in in;
+	unsigned long deadline = jiffies + 2 * HZ;
+	u32 puts = 0, why;
+	bool locked = false;
+	int plan, ret = 0;
+	u32 mode, k;
+
+	mode = (1);
+	k = d->rdev->close_deferred[0] ? 1 : 0;
+	if (mode && !r->close_defer_run && r->bound &&
+	    g5p_render_pm_holds(d->rdev, r, mode) &&
+	    k < ARRAY_SIZE(d->rdev->close_deferred)) {
+		g5p_render_close_trim(r);
+		/* the deferred close's own references, dropped by g5p_render_close_deferred() */
+		kref_get(&c->ref);
+		drm_dev_get(&d->drm);
+		d->rdev->close_deferred[k] = r;
+		dev_info(
+			g->dev,
+			"RENDER-V3 close-defer slots=%u/%u jobs=%u: the PM may still write its state "
+			"back; unbind once it has moved past it end=v3\n",
+			r->slot[0], r->slot[1], r->jobs);
+		dev_info(
+			g->dev,
+			"RENDER-V3 close-defer2 slots=%u/%u pm=%s pending=%u end=v3\n",
+			r->slot[0], r->slot[1],
+			d->rdev->pm_last == r ? "last" : "previous", k + 1);
+		return;
+	}
+
+	for (;;) {
+		in = (struct g5p_ru_close_in){
+			.retained = r->retained,
+			.bound = r->bound,
+			/* a lost job that drained left the firmware nothing of this context */
+			.bad = READ_ONCE(c->bad) && !r->lost_drained,
+			.term_failed = g5p_ru_term_failed(&g5p_rv3_term),
+			.dev_failed = !b || READ_ONCE(b->failed),
+			.stopped = !b || READ_ONCE(b->stopped),
+			.shutdown = g5p_r8_admit_closed(&g5p_r8_state.admit),
+			/* as g5p_rv3_unbind_slots() refuses it */
+			.dc_pending = b && d->rdev->dc_pending &&
+				      READ_ONCE(((u32 *)g5p_boot_shared(
+					      b, 0x6c))[0]) != d->rdev->dc_wait,
+			.queued = atomic_read(&r->queued),
+		};
+		plan = g5p_ru_close_plan(&in, &why);
+		if (plan != G5P_RU_CLOSE_UNBIND || locked)
+			break;
+		/* Bounded, as a job takes it: never wait forever behind a command in MMIO. */
+		while (!(locked = mutex_trylock(&g->lock)) &&
+		       time_before(jiffies, deadline))
+			msleep(5);
+		if (!locked) {
+			plan = G5P_RU_CLOSE_RETAIN;
+			why = G5P_RU_CLOSE_LOCK;
+			break;
+		}
+		/* Plan again under the lock: the reboot quiesce or a failure may have run. */
+	}
+	if (plan == G5P_RU_CLOSE_UNBIND) {
+		ret = g5p_rv3_unbind_slots(d, r->slot, 2, "close");
+		if (!ret) {
+			r->bound = false;
+			r->retained = false;
+			WRITE_ONCE(c->live, false);
+			puts++;
+			/* the PM may still write this context's free list back through its TA slot */
+			{
+				g5p_rv3_park(d, r);
+			};
+		}
+	}
+	if (plan == G5P_RU_CLOSE_RELEASE ||
+	    (plan == G5P_RU_CLOSE_UNBIND && !ret))
+		puts += g5p_render_unclaim(d, r);
+	if (locked)
+		mutex_unlock(&g->lock);
+	dev_info(
+		g->dev,
+		"RENDER-V3 close slots=%u/%u plan=%s why=%#x ret=%d jobs=%u claimant=%u "
+		"retained=%u end=v3\n",
+		r->slot[0], r->slot[1], g5p_ru_close_name(plan), why, ret,
+		r->jobs, r->claimant, r->retained);
+	while (puts--) {
+		g5p_context_put(c);
+		drm_dev_put(&d->drm);
+	}
+}
+
+/* After a job: a deferred close runs once the last job was another context's. */
+static void g5p_render_close_deferred(struct g5p_drm *d)
+{
+	struct g5p_rdev *rd = d->rdev;
+	u32 mode = (1);
+
+	for (u32 k = 0; k < ARRAY_SIZE(rd->close_deferred); k++) {
+		struct g5p_render *r = rd->close_deferred[k];
+		struct g5p_context *c;
+
+		/* mode 0 now: a pending close still waits until the PM has moved past it */
+		if (!r || g5p_render_pm_holds(rd, r, mode ?: 1))
+			continue;
+		rd->close_deferred[k] = NULL;
+		c = r->ctx;
+		r->close_defer_run = true;
+		dev_info(
+			d->core->dev,
+			"RENDER-V3 close-deferred slots=%u/%u: neither the PM's last nor its previous "
+			"context end=v3\n",
+			r->slot[0], r->slot[1]);
+		g5p_render_close_run(r);
+		g5p_context_put(c);
+		drm_dev_put(&d->drm);
+	}
+	/* keep a pending close in [0]: close_run fills [1] only behind it */
+	if (!rd->close_deferred[0] && rd->close_deferred[1]) {
+		rd->close_deferred[0] = rd->close_deferred[1];
+		rd->close_deferred[1] = NULL;
+	}
+}
+
+/*
+ * The handle of a TYPED_V3 context is gone (DESTROY_CONTEXT, or its file closed): stop VM and
+ * render-target edits and queue the close item behind the context's jobs (g5p_rsched_close()).
+ * File lock held, or the file is closing.  A context that never submitted is released by its
+ * last reference.
+ */
+static void g5p_render_close(struct g5p_context *c)
+{
+	struct g5p_render *r = c->render;
+
+	if (!r->v3_accepted || r->closing)
+		return;
+	r->closing = true;
+	r->detached = true;
+	c->vm->resident_gone = true;
+	/* The close item's references, dropped by the scheduler once it ran. */
+	kref_get(&c->ref);
+	drm_dev_get(&c->gpu->drm);
+	if (!g5p_rsched_close(c->gpu, r)) {
+		g5p_context_put(c);
+		drm_dev_put(&c->gpu->drm);
+	}
+}
+
+/* Reboot quiesce, RAM only and lock free: the TYPED_V3 latch and whether its executor runs.
+ * The executor is RAM-only once the latch is quiet, unless the wake110 experiment (doorbells
+ * after retirement, off in every desktop tuple) is configured.  Called after admission closed;
+ * the scheduler is kicked so that jobs waiting on an input fail now, not at their deadline.
+ */
+static void g5p_kq_drm_state(void *cookie, struct g5p_ru_kq_in *in)
+{
+	struct g5p_drm *d = cookie;
+
+	/* Admission is closed by now: queued jobs blocked on an input fail at once. */
+	g5p_rsched_kick(d);
+
+	/* A channel blocked behind a lost job is a wedged epoch for the quiesce. */
+	in->term_failed = g5p_ru_term_failed(&g5p_rv3_term) ||
+			  READ_ONCE(d->rdev->stuck) ||
+			  READ_ONCE(d->rdev->recovering);
+	in->ram_only = READ_ONCE(d->rdev->v3) &&
+		       !g5p_ru_mmio_ok(&g5p_rv3_term) && !(2);
+	in->executing = READ_ONCE(d->rdev->executing);
+}
+
+/* Reboot quiesce, core lock held: every held user slot, the first claimant's pair included.
+ * Nothing is freed and no context changes state: admission is closed and the boot state is
+ * frozen right after, so no job runs again on this boot.
+ */
+static int g5p_kq_drm_detach(void *cookie, const u32 *slots, u32 n)
+{
+	return g5p_rv3_unbind_slots(cookie, slots, n, "kexec");
+}
+
+static const struct g5p_kq_frontend g5p_kq_drm = {
+	.state = g5p_kq_drm_state,
+	.detach = g5p_kq_drm_detach,
+};
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-v3.h b/drivers/gpu/drm/apple-g5p/drm-render-v3.h
new file mode 100644
index 000000000..ac4dd841e
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-render-v3.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* TYPED_V3 serial executor: per-job state (receipt data). Types only; code: drm-render-v3.inc. */
+#ifndef G5P_DRM_RENDER_V3_H
+#define G5P_DRM_RENDER_V3_H
+
+enum g5p_rv3_phase {
+	G5P_RV3_IDLE,
+	G5P_RV3_ATTACH,
+	G5P_RV3_BIND,
+	G5P_RV3_TA_PUBLISH,
+	G5P_RV3_TA_WAIT,
+	G5P_RV3_TD_PUBLISH,
+	G5P_RV3_TD_WAIT,
+	G5P_RV3_DONE,
+	G5P_RV3_PHASES,
+};
+
+/* g5p_drm.td_want: the 3D completion-event latch is armed for the endpoint in the low byte. */
+#define G5P_RV3_TD_WANT 0x100U
+
+/* One RAM sample of one engine: ring, stamps, channel watermarks, idle words, PM state, and
+ * (3D) whether the matching completion event has been latched.
+ */
+struct g5p_rv3_ev {
+	u64 ns;
+	u32 prod, cons, stamp[2], ctl[5], idle[6], pm80;
+	bool proto, failed, consumed, retired, idle_ok, pm_ok, event;
+};
+
+struct g5p_rv3 {
+	struct g5p_ru_wait ta, td;
+	struct g5p_ru_touch
+		touch[2]; /* RC4a A/B (render-user-touch.h); zero when off */
+	struct g5p_ru_retire rt; /* the 3D predicate (render-user-retire.h) */
+	struct g5p_ru_ta tr; /* the TA predicate (render-user-retire.h) */
+	struct g5p_rv3_ev last[2];
+	u64 td_event_ns; /* decode time of the matching 3D event; 0 = none */
+	u64 ta_event_ns; /* decode time of the first TA event since the publish */
+	u64 attach_ns, job_deadline_ns, ta_pub_ns, td_pub_ns, ta_consumed_ns,
+		td_consumed_ns;
+	u32 phase, grace_end, bell;
+	u32 seq; /* the device sequence this job got; 0 = none */
+	/* wake110 (render-user-wake.h), per engine: the decision, the power evidence word it saw
+	 * (wake111), the two register words it read (U32_MAX = not read), the consumer it saw, the
+	 * type-1 event counts at the phase's arm and at the job's end, the lock window and the
+	 * first type-1 decode time.  Zero when off.
+	 */
+	u32 wk_did[2], wk_power[2], wk_fence[2], wk_gpc[2], wk_cons[2],
+		wk_t1_pub[2], wk_t1_end[2];
+	u64 wk_start_ns[2], wk_done_ns[2], wk_first_ns[2];
+	bool touched; /* the DC3 pair was published: the firmware may reference the job's memory */
+	/* The bind of this job's context published its DC3 pair and then failed: that context is
+	 * lost, the device and the contexts already bound are not.
+	 */
+	bool bind_failed;
+	/* The job was lost alone (render-user-loss.h): its context is dead, the device is not; the
+	 * channel stays blocked behind its stuck phase until the scheduler's drain clears it.
+	 */
+	bool lost;
+};
+
+#endif
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-v3.inc b/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
new file mode 100644
index 000000000..34fbad607
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
@@ -0,0 +1,3038 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * TYPED_V3 serial executor: the control flow that completed the natural TA and the
+ * natural 3D in r96 (docs/gpu/experiments/production-typed-render-kernel.md), on typed
+ * state.  Included from drm-render.inc after g5p_render_execute().
+ *
+ * What it does, in order, for each job a V3 context runs (strictly serial across every context,
+ * render-user-serial.h; only the epoch's job 1 attaches and has hardware evidence):
+ *   0. bind, the first job of every later context (multi-client-design.md §4.2): its own DC3
+ *      pair, published in RAM only, no doorbell, a RAM-only wait for the firmware to consume
+ *      it.  With the TEMPORARY render_user_spare_pairs instead: a pair job 1 pre-bound, taken
+ *      over through the tag path.
+ *   1. attach (job 1): the typed preparation (PM, channels, catalogue entries), then the
+ *      DC3 pair is published and its doorbell is owned by the r74f machinery (r87b
+ *      self-drain: a closed gate is never repaired by the host).  The firmware installs
+ *      the page-table root and the generation tags itself (r74g); the host does NO MMU pass
+ *      and checks the result in RAM only.
+ *   2. TA: record, WORK_CTL and producer, no doorbell; the r74g grace (four ALIVEs or
+ *      20 ms) lets the firmware drain it, and only if it is still pending afterwards the
+ *      first ALIVE decoded owns one fenced fallback doorbell.
+ *   3. TA wait: RAM only (drain, sample, sleep), 20 s per phase by default, 30 s for the
+ *      whole job (render-user-wait.h decides the deadline and closes the race with a
+ *      completion).  tahang1: complete on a coherent target with the PM saved and either
+ *      the idle words clear, the TA completion event, or a 500 ms coherent hold
+ *      (render-user-retire.h); a phase pending 1 s prints one RAM-only `slow` line.  From
+ *      the TA complete on, and after any timeout or fault, the host touches no register.
+ *   4. 3D: record, WORK_CTL and producer, NO doorbell (r96 stage 1: the firmware consumed
+ *      it 2 ms later), RAM-only wait as above.
+ *   RC4a (render_user_touch_ms, default 0 = off): at publish + T of each phase, odd jobs read
+ *   the receipt pages once and even jobs only record the instant (render-user-touch.h); RAM only.
+ *   repeat109: the 3D phase is also complete when its target state is coherent and its completion
+ *   event arrived, even if the engine idle words never clear (render-user-retire.h; the latched
+ *   render_user_idle_settle_ms, default 0, adds a minimum coherent run); one `RENDER-V3 retire`
+ *   receipt line splits the firmware's retirement from the host's decision.  RAM only.
+ *   wake110 (render_user_wake, default 0 = off): right after the producer store of every phase but
+ *   job 1's TA, the A/B's factor phases run Apple's submit kick (R1+0x14 = 7, GPC active, R0+0xb00 =
+ *   0x10 / 0x11) and its control phases the same guards without a register (render-user-wake.h);
+ *   one `RENDER-V3 wake` line per job.  The only register access after the TA complete, licensed
+ *   while no timeout or fault was noted.
+ * Jobs >= 2 (a compositor's next frame, or another context's): no attach, the PM pool is
+ * rebuilt, and both rings are published with no doorbell at all.
+ * Not in this path on purpose: the r74h / r80 / r85-r96 root-cause instrumentation (stream
+ * markers, PM canary, plateau and end banks, region/target dumps), host MMU passes, cache
+ * maintenance MMIO, selector reads, snapshots (they read R0), and any recovery.  A timeout
+ * or fault retains everything; the context is frozen and kept until reboot.
+ *
+ * Terminal state (render-user-terminal.h): the TA complete, a timeout and a fault go through one
+ * first-writer-wins latch, g5p_rv3_terminal().  From then on g5p_ru_mmio_ok() is false, the admission
+ * refuses every job that would start behind a failure (-EIO), and the legacy typed paths that read or
+ * write registers (snapshot, invalidate, run, destroy) refuse.  g5p_rv3_td_hook() is the optional
+ * recovery bridge (terminal note and the observation-only CAPTURE entry); it is nothing without it.
+ */
+
+static const char *const g5p_rv3_phase_names[G5P_RV3_PHASES] = {
+	"idle",	   "attach",	 "bind",    "ta-publish",
+	"ta-wait", "3d-publish", "3d-wait", "done",
+};
+static const char *const g5p_rv3_results[] = { "pending", "complete", "timeout",
+					       "fault" };
+static const char *const g5p_rv3_how[] = { "none", "idle-clear", "idle-stuck",
+					   "hold" };
+
+#include "drm-latency123.inc"
+
+/* perf60 stage 4 (render-user-pmset.h): per-context PM records, the iOS model (one ParamBuffer
+ * per work queue, 6cb9afc/6cb2378).  Latched at the epoch's first attach, with boot_pm_sets:
+ *   1  every context bound after the epoch's first gets its own PM set (control + S, list, F in
+ *      the firmware GiB), its own pool pages and its own aux pages at G5P_RU_PRIVATE_VA in its
+ *      VM; the epoch's first context keeps the device PM.  PM ID 0 everywhere.
+ *   2  as 1, and set s carries PM ID s + 1 (TA W+0x10, TA start, 3D start, tag6).
+ * RAM only, by the executor between jobs.
+ */
+/* release8 default */
+
+/* The PM a context's jobs use: its set, or the device PM. */
+static u8 *g5p_rv3_pm_cpu(struct g5p_boot *b, const struct g5p_render *r)
+{
+	if (r->pm_set >= 0)
+		return b->pm_set[r->pm_set * G5P_PMSET_PAGES + G5P_PMSET_CONTROL]
+			.cpu;
+	return g5p_ru_pm_cpu(b);
+}
+
+static u32 g5p_rv3_pm_meta(const struct g5p_render *r)
+{
+	return g5p_meta_address(
+		r->pm_set >= 0 ? g5p_pmset_va(r->pm_set, G5P_PMSET_CONTROL) :
+				 G5P_SHARED_VA + G5P_R22_PM);
+}
+
+static u32 g5p_rv3_pm_id(const struct g5p_rdev *rd, const struct g5p_render *r)
+{
+	return rd->pm_ctx >= 2 && r->pm_set >= 0 ? g5p_pmset_id(r->pm_set) : 0;
+}
+
+static struct g5p_dma_page *g5p_rv3_pm_aux(struct g5p_rdev *rd,
+					   struct g5p_render *r)
+{
+	return r->pm_aux_mapped ? r->pm_aux : rd->aux;
+}
+
+/* The boot tuple the V3 path is proven under (r96 params.txt), minus the instrumentation:
+ * r73b/r73c/r73e/r73f, r74 with the raised IRQ cap, r74f, r74g, r87b self-drain; no r74h,
+ * no r80..r96 (their IRQ banks read registers), no r75/r79 firmware control, and no fixed
+ * render engine (it is exclusive with the DRM one).
+ */
+static bool g5p_rv3_tuple(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g ? g->boot : NULL;
+	struct g5p_r73b *x = b ? b->r73b : NULL;
+
+	return x && g5p_r74g_on(b) && g5p_r74b_ram_only(g) &&
+	       x->r87b_attach == G5P_R87B_ATTACH_SELF_DRAIN;
+}
+
+/* The admission state of a context and the device, as plain values for g5p_ru_v3_admit(). */
+static struct g5p_ru_v3_state g5p_rv3_state(struct g5p_diag *g,
+					    struct g5p_render *r)
+{
+	const struct g5p_rdev *rd = r->ctx->gpu->rdev;
+
+	return (struct g5p_ru_v3_state){
+		.tuple = g5p_rv3_tuple(g),
+		.v3_accepted = r->v3_accepted,
+		.bound = r->bound,
+		.jobs = r->jobs,
+		.device_up = READ_ONCE(rd->up),
+		.device_v3 = READ_ONCE(rd->v3),
+		.sequence = READ_ONCE(rd->sequence),
+		.slot_ta = r->slot[0],
+		.slot_3d = r->slot[1],
+		.variant = 0 || r->after_ta || 0 || r->v.pm || r->v.memory ||
+			   r->v.rt || r->v.slots,
+		.wait_ms = r->wait_ms,
+		.quiet = !g5p_ru_mmio_ok(&g5p_rv3_term),
+		.terminal_failed = g5p_ru_term_failed(&g5p_rv3_term),
+	};
+}
+
+/* A terminal epoch is a device state (-EIO), the others are about this request. */
+static int g5p_rv3_refusal_errno(int why)
+{
+	if (why == G5P_RU_V3_TERMINAL)
+		return -EIO;
+	return why == G5P_RU_V3_OVERFLOW ? -EOVERFLOW : -EOPNOTSUPP;
+}
+
+/* Submit-time admission: every V3 job refused here has touched nothing. */
+static int g5p_rv3_admit_submit(struct g5p_drm *d, struct g5p_render *r)
+{
+	struct g5p_diag *g = d->core;
+	struct g5p_ru_v3_state st;
+	int why;
+
+	/* The epoch is being replaced: the executor admits the job again under the lock. */
+	if (READ_ONCE(d->rdev->recovering))
+		return 0;
+	st = g5p_rv3_state(g, r);
+	why = g5p_ru_v3_admit(&st, false);
+
+	if (!why)
+		return 0;
+	/* per submit while admission is closed and a client retries: ratelimited */
+	dev_info_ratelimited(
+		g->dev, "RENDER-V3 refused: %s; no hardware touched end=v3\n",
+		g5p_ru_v3_why[why]);
+	return g5p_rv3_refusal_errno(why);
+}
+
+/* Recovery hooks (patches/gpu-recovery), compiled only when that series is applied: core.inc then includes
+ * teardown.inc before this file, and teardown.h defines G5P_TEARDOWN_H.  The CAPTURE entry is observation only
+ * (RAM reads, no register access) and runs only with the recovery module parameter set, once per epoch, on a
+ * timeout or fault.  Without the series both are nothing, and the prod98 kernel does not depend on it.
+ */
+#ifdef G5P_TEARDOWN_H
+static void g5p_rv3_td_hook(struct g5p_diag *g, int kind, const char *why)
+{
+	g5p_td_note_terminal(&g5p_td_state, g5p_ru_td_kind(kind));
+	if ((0) && g5p_ru_term_capture_due(&g5p_rv3_term, kind))
+		g5p_td_capture(g, why);
+}
+#else
+static inline void g5p_rv3_td_hook(struct g5p_diag *g, int kind,
+				   const char *why)
+{
+}
+#endif
+
+/* The terminal state of the epoch: the TA complete, and any timeout or fault.  First writer wins; from the first
+ * note on g5p_ru_mmio_ok() is false and the host touches no register (R0, R1, AIC, doorbell) and no bank.  The r80
+ * flag is set when an r80 block exists, so that a bank that might be latched cannot run behind this path (the V3
+ * tuple forbids r80, so there is none today); the latch above does not depend on it.
+ */
+static void g5p_rv3_terminal(struct g5p_diag *g, int kind, const char *why)
+{
+	bool failed = g5p_ru_term_failed(&g5p_rv3_term);
+
+	if (g5p_ru_term_note(&g5p_rv3_term, kind))
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 terminal kind=%s why=%s mmio=off r0=off export=ram-only end=v3\n",
+			g5p_ru_term_names[g5p_ru_term_kind(&g5p_rv3_term)],
+			why);
+	else if (!failed && g5p_ru_term_failed(&g5p_rv3_term))
+		/* The epoch's TA complete took the latch long ago (job 1): a later timeout or fault
+		 * only makes it sticky-failed, which closes admission for every client.  Say so once.
+		 */
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 terminal kind=%s why=%s latched=%s failed=1 admission=closed end=v3\n",
+			g5p_ru_term_names
+				[kind > G5P_RU_TERM_NONE &&
+						 kind < G5P_RU_TERM_KINDS ?
+					 kind :
+					 G5P_RU_TERM_FAULT],
+			why,
+			g5p_ru_term_names[g5p_ru_term_kind(&g5p_rv3_term)]);
+	g5p_rv3_td_hook(g, kind, why);
+}
+
+/* "Retained boundary" of the r74f machinery -> the errno a job reports.  -EINPROGRESS is
+ * never a job error (the UAPI uses it for "pending").
+ */
+static int g5p_rv3_errno(struct g5p_diag *g, int ret)
+{
+	if (ret != -EINPROGRESS)
+		return ret;
+	switch (READ_ONCE(g->boot->r73b->r74f_stop)) {
+	case G5P_R74F_STOP_ATTACH_NOT_KICKED:
+	case G5P_R74F_STOP_ATTACH_NOT_CONSUMED:
+	case G5P_R74F_STOP_TA_NOT_KICKED:
+	case G5P_R74G_STOP_TA_NOT_CONSUMED:
+	case G5P_R74G_STOP_TA_WINDOW_MISSED:
+		return -ETIMEDOUT;
+	default:
+		return -EIO;
+	}
+}
+
+/*
+ * Interim: on iOS the firmware writes back its own lines with the cache maintenance it runs on
+ * every tick (meta+0x6d4); that needs init words still being recovered (latency123.md), and
+ * this read stands in for it until then.
+ *
+ * While a phase is in flight the firmware does not see its own progress in the root and
+ * shared pages until a coherent read of those lines reaches the fabric: without one, the TA
+ * and 3D stages wait for the firmware tick, for seconds (latency123: key to frame 7.9 s
+ * median; with a Normal-NC read of both regions every 1-2 ms, 0.27 s).  One 32-bit load per
+ * 64-byte line, before every RAM sample of an in-flight phase.  RAM only, and an idle GPU
+ * has no sampler, so it costs nothing then.
+ */
+static void g5p_rv3_fw_touch(struct g5p_boot *b)
+{
+	struct g5p_dma_page *const regions[] = { b->root, b->shared };
+	u32 counts[] = { ARRAY_SIZE(b->root), ARRAY_SIZE(b->shared) };
+
+	for (u32 r = 0; r < ARRAY_SIZE(regions); r++)
+		for (u32 i = 0; i < counts[r]; i++)
+			for (u32 at = 0; at < G5P_GPU_PAGE; at += 64)
+				(void)READ_ONCE(
+					*(const u32 *)(regions[r][i].cpu + at));
+	/* perf60 stage 4: the per-context PM sets are firmware pages like the shared ones */
+	for (u32 i = 0; i < b->pm_sets * G5P_PMSET_PAGES; i++)
+		for (u32 at = 0; at < G5P_GPU_PAGE; at += 64)
+			(void)READ_ONCE(*(const u32 *)(b->pm_set[i].cpu + at));
+}
+
+/* perf60 bell gates, A/B knobs for the multi-context 3D fault on the bell path (render_user_wake=2 only;
+ * 0600, read at every bell, all 0 = no gate).  They run between a phase's producer store and its bell;
+ * in policy state 0 the firmware does not drain a ring on its own, so a gate holds the phase back.
+ * RAM reads, sleeps and barriers only; no register access.
+ *   bell_gap_us      (a) the TA bell waits until this long after the previous job (any context) ended
+ *   bell_idle_ms     (a) the TA bell first waits, up to this, for the 3D engine idle words to read zero
+ *   bell_3d_delay_us (c) mb() and this delay between the 3D producer store and the 3D bell
+ *   bell_ctx_gap_us  (d) mb() and this delay before the TA bell of a job of another context than the last
+ *   bell_touch       (c) the Normal-NC read of the firmware pages (g5p_rv3_fw_touch) right before each bell
+ */
+
+/* perf60 job-start gate: the same waits before the job's own host writes (the PM pool rebuild and
+ * the shared TA/3D work records, g5p_rv3_pm_rebuild() and g5p_ru_job()), which happen before any
+ * publish.  The bell gates above run after them, so they cannot separate "the host rewrites shared
+ * firmware pages while the firmware still finishes the previous job" from a doorbell race.
+ *   job_gap_us   the job's first host write no sooner than this after the previous job ended
+ *   job_idle_ms  then wait up to this (RAM) for the TA and 3D engine idle words to read zero
+ */
+/* perf60 layout (latched at the epoch's first attach, default 0 = the r22 layout):
+ *   render_user_job_slots 2: job seq writes its command, W record and microsequence into slot
+ *       (seq - 1) % 2 of the channel page, so a job never rewrites the record the firmware used for
+ *       the job before it; the pointer ring carries each job's addresses (render-user-layout.h).
+ *   render_user_pm_once 1: the PM pool, list and F are built by the epoch's first attach only and
+ *       never rewritten by the host between jobs; the TA's tag6 record has the firmware rebuild F,
+ *       as on iOS (PM created per queue once; docs/gpu/experiments/freelist-lifetime-production-fix.md).
+ */
+/* release8 default */
+/* release8 default */
+
+/* The record slot of job seq on this epoch's layout. */
+static u32 g5p_rv3_js(const struct g5p_rdev *rd, u32 seq)
+{
+	return rd->job_slots == 2 ? (seq - 1) & 1 : 0;
+}
