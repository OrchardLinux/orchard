+	if (r74 && (!id || r74 > 2 || 0 != (r74 == 1 ? (1 ? 0 : 1) : 4) ||
+		    1 != (r74 == 1) || !(1) || cap < G5P_R74_IRQ_CAP ||
+		    cap > G5P_R74_IRQ_CAP_MAX ||
