+static ssize_t g5p_self_park_write(struct file *file, const char __user *ubuf,
+				   size_t len, loff_t *pos)
+{
+	struct seq_file *m = file->private_data;
+	struct g5p_drm *d = m->private;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b;
+	char buf[16], what[8];
+	u32 v;
+	int ret = len;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = 0;
+	if (sscanf(buf, "%7s %u", what, &v) != 2)
+		return -EINVAL;
+	mutex_lock(&g->lock);
+	b = g->boot;
+	if (!b || !b->maps_ready || !b->self_park) {
+		ret = -ENODEV;
+	} else if (!strcmp(what, "park") && !v && b->park_epoch) {
+		/* a live park epoch is never disarmed: the wake needs the armed record */
+		ret = -EBUSY;
+	} else if (!strcmp(what, "park") && v <= 1) {
+		g5p_park_set(g, v, "debugfs");
+		if (v && !b->self_park_armed)
