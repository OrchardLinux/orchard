+		   b->self_park, b->self_park_armed, b->park_epoch,
+		   READ_ONCE(*(u32 *)(ctl + G5P_PARK_CTL_FLAG)));
+	seq_printf(m, "ovr=%u/%u ceiling=%u\n",
+		   READ_ONCE(*(u32 *)(ctl + 0x1038)),
+		   READ_ONCE(*(u32 *)(ctl + 0x1040)),
+		   READ_ONCE(*(u32 *)(ctl + 0x102c)));
+	seq_printf(m, "policy0=%u sample_ms=%u state=%u target=%u pstate=%u x=%u\n",
+		   g5p_dc_root_word(b, p), g5p_dc_root_word(b, p + 4),
+		   g5p_dc_root_word(b, p + 8), g5p_dc_root_word(b, p + 0x28),
+		   g5p_dc_root_word(b, p + 0x34), g5p_dc_root_word(b, p + 0x38));
+	seq_printf(m, "alive=%u stopped=%u mmio=0\n", b->alive, b->stopped);
