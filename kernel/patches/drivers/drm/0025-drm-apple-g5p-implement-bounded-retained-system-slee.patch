+		return -EBUSY;
+	ret = drm_compat_ioctl(filp, cmd, arg);
+	g5p_sleep_exit(d->core);
+	return ret;
+}
+#endif
+
+static const struct file_operations g5p_drm_fops = {
+	.owner = THIS_MODULE,
+	.open = drm_open,
+	.release = drm_release,
