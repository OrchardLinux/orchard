diff --git a/drivers/gpu/apple-g5p/core.inc b/drivers/gpu/apple-g5p/core.inc
index 709efed16..9177065d4 100644
--- a/drivers/gpu/apple-g5p/core.inc
+++ b/drivers/gpu/apple-g5p/core.inc
@@ -80,6 +80,8 @@ struct g5p_diag {
 	struct regmap *pmgr;
 	/* Serializes commands and all hardware access. */
 	struct mutex lock;
+	atomic_t sleep_gate; /* closed bit plus active host operations */
+	bool sleep_reserved, sleep_off, sleep_boot, sleep_failed, sleep_irq_off;
 	bool powered;
 	bool loaded;
 
@@ -104,6 +106,28 @@ struct g5p_diag {
 	struct g5p_mmio_self *mmio_self;
 };
 
+/* Separate from terminal retirement: refusal must not cancel accepted jobs. */
+static bool g5p_sleep_enter(struct g5p_diag *g)
+{
+	int old = atomic_read(&g->sleep_gate);
+
+	for (;;) {
+		int seen;
+
+		if (old < 0)
+			return false;
+		seen = atomic_cmpxchg(&g->sleep_gate, old, old + 1);
+		if (seen == old)
+			return true;
+		old = seen;
+	}
+}
+
+static void g5p_sleep_exit(struct g5p_diag *g)
+{
+	atomic_dec(&g->sleep_gate);
+}
+
 /* Before every PMGR gfx gate (boot R33 off, dirty-start, kexec quiesce and in-boot recovery
  * cycles): no accessor MMIO from here until g5p_fender_wake_once() brings Fender up again.
  * Apple clears fender+0xc inside setPlatformPower(0), before its gate (G5).
@@ -450,7 +474,7 @@ static DEVICE_ATTR_RO(result);
 /* One bring-up phase, as the command file and the probe-time bring-up run it.  *ran is set
  * when the phase itself ran (and its result was recorded).
  */
-static int g5p_run_phase(struct g5p_diag *g, const char *buf, bool *ran)
+static int g5p_run_phase_locked(struct g5p_diag *g, const char *buf, bool *ran)
 {
 	int ret;
 
@@ -486,6 +510,18 @@ static int g5p_run_phase(struct g5p_diag *g, const char *buf, bool *ran)
 	return ret;
 }
 
+static int g5p_run_phase(struct g5p_diag *g, const char *buf, bool *ran)
+{
+	int ret;
+
+	*ran = false;
+	if (!g5p_sleep_enter(g))
+		return -EBUSY;
+	ret = g5p_run_phase_locked(g, buf, ran);
+	g5p_sleep_exit(g);
+	return ret;
+}
+
 static ssize_t command_store(struct device *dev, struct device_attribute *attr,
 			     const char *buf, size_t count)
 {
@@ -495,8 +531,13 @@ static ssize_t command_store(struct device *dev, struct device_attribute *attr,
 
 	if (!capable(CAP_SYS_RAWIO))
 		return -EPERM;
-	if (sysfs_streq(buf, "td-kexec"))
-		return g5p_td_command(g, buf) ?: count;
+	if (sysfs_streq(buf, "td-kexec")) {
+		if (!g5p_sleep_enter(g))
+			return -EBUSY;
+		ret = g5p_td_command(g, buf);
+		g5p_sleep_exit(g);
+		return ret ?: count;
+	}
 	ret = g5p_run_phase(g, buf, &ran);
 	if (ran)
 		dev_info(dev, "command %.*s result=%d\n", (int)count, buf, ret);
