+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* Apple 20H350: c81b18 -> c9fa10 -> ca0f78; wake c83b18.
+ * Admission is reserved through complete, including another device's abort.
+ * No terminal-retire latch is used for a reversible sleep attempt.
+ */
+static bool g5p_sleep_idle(struct g5p_drm *d)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_render *r;
+	unsigned long flags;
+	bool idle;
+
+	if (rd->cu_sequence || atomic_read(&d->accepted) ||
+	    atomic_read(&d->r8_queued) || READ_ONCE(rd->executing) ||
+	    rd->ahead || rd->stuck || rd->recovering || rd->dc_pending ||
+	    rd->close_deferred[0] || rd->close_deferred[1] ||
+	    g5p_ru_term_failed(&g5p_rv3_term))
+		return false;
+	spin_lock_irqsave(&rd->sched_lock, flags);
+	idle = list_empty(&rd->sched.run);
+	spin_unlock_irqrestore(&rd->sched_lock, flags);
+	if (!idle)
+		return false;
+	/* Re-read the latest TA/3D stamps, including the depth-2 record slot.
+	 * A CPU retirement flag alone is not Apple's all-stamps certificate.
+	 */
+	if (rd->sequence)
+		for (u32 e = 0; e < 2; e++)
+			if (!g5p_ru_retired_pl(g5p_ru_page(d->core->boot, e),
+					       g5p_ru_meta(e), e, rd->sequence,
+					       g5p_rv3_js(rd, rd->sequence),
+					       rd->sequence))
+				return false;
+	mutex_lock(&rd->lock);
+	list_for_each_entry(r, &rd->contexts, rdev_link)
+		for (u32 i = 0; i < 2; i++)
+			if (r->submitted[i] &&
+			    (!r->consumed[i] || !r->retired[i]))
+				idle = false;
+	mutex_unlock(&rd->lock);
+	return idle;
+}
+
+/* R1 only, as Apple's isQuiescent/isStableOff. Never infer bus retirement
+ * from a completed userspace fence or GPC=0 alone.
+ */
+static bool g5p_sleep_certificate(struct g5p_diag *g, bool stable)
+{
+	u32 state, mode;
+
+	if (READ_ONCE(g->boot->failed) || READ_ONCE(g->boot->event_failed) ||
+	    READ_ONCE(g->boot->r73b->early_power_abort))
+		return false;
+	state = readl(g->window[1] + 0x1000);
+
+	if (state & 0x1f)
+		return false;
+	mode = readl(g->window[1]);
+	if (stable && mode >> 30 == 1)
+		return true;
+	return (mode & 0x60000000) == 0x60000000 && !readl(g->window[1] + 8);
+}
+
+static bool g5p_sleep_rings(struct g5p_diag *g)
+{
+	u32 cons, prod;
+
+	for (u32 i = 0; i < G5P_TD_NRING; i++)
+		if (g5p_td_op_ring_read(g, i, &cons, &prod) || cons > 255 ||
+		    cons != prod)
+			return false;
+	return true;
+}
+
+static void g5p_sleep_fail(struct g5p_drm *d, int ret)
+{
+	struct g5p_diag *g = d->core;
+
+	/* RAM only: no retry, ACK or diagnostic MMIO after a failed transition. */
+	if (!g->sleep_irq_off && g->boot->irq_ready) {
+		disable_irq(g->boot->irq);
+		g->sleep_irq_off = true;
+	}
+	g->sleep_failed = true;
+	WRITE_ONCE(g->boot->failed, true);
+	WRITE_ONCE(g->boot->stopped, true);
+	g5p_mmio_gate(g);
+	g5p_rv3_terminal(g, G5P_RU_TERM_FAULT, "sleep-failed");
+	g5p_r8_admit_close(&g5p_r8_state.admit);
+	g5p_rsched_kick(
+		d); /* pending fences fail, including unsignalled inputs */
+	dev_err(g->dev, "GPU-PM frozen ret=%d; no further MMIO\n", ret);
+}
+
+void apple_g5p_system_sleep_complete(struct device *dev)
+{
+	struct g5p_diag *g = dev_get_drvdata(dev);
+
+	if (!g || !g->sleep_reserved || g->sleep_off)
+		return;
+	g->sleep_reserved = false;
+	/* A failed epoch stays terminal, but host close must still be possible. */
+	atomic_andnot(BIT(31), &g->sleep_gate);
+	g5p_rsched_kick(g->event_cookie);
+	dev_info(dev, "GPU-PM complete failed=%u\n", g->sleep_failed);
+}
+
+EXPORT_SYMBOL_GPL(apple_g5p_system_sleep_complete);
+
+static int g5p_system_sleep_prepare(struct device *dev)
+{
+	struct g5p_diag *g = dev_get_drvdata(dev);
+	struct g5p_drm *d;
+	struct g5p_boot *b;
+	struct g5p_kq_ctx c = { .g = g };
+	u64 deadline;
+	int ret = -EBUSY;
+
+	if (!g || !g->event_cookie)
+		return -EBUSY;
+	if (READ_ONCE(g->sleep_reserved))
+		return g->sleep_failed ? -EBUSY : 0;
+	if (atomic_fetch_or(BIT(31), &g->sleep_gate) < 0)
+		return -EBUSY;
+	deadline = ktime_get_ns() + 20 * NSEC_PER_MSEC;
+	while ((atomic_read(&g->sleep_gate) & INT_MAX) &&
+	       ktime_get_ns() < deadline)
+		usleep_range(100, 200);
+	if (atomic_read(&g->sleep_gate) & INT_MAX)
+		goto refuse;
+	if (!g5p_kq_lock(&c))
+		goto refuse;
+	d = g->event_cookie;
+	b = g->boot;
+	if (g->sleep_failed || g5p_r8_admit_closed(&g5p_r8_state.admit) || !b ||
+	    !g->powered || !g->fender_ready || g->mmio_off || !b->released ||
+	    !b->alive || b->failed || b->event_failed || b->stopped ||
+	    !b->irq_ready || !b->r73b ||
+	    READ_ONCE(b->r73b->early_power_abort) || !g5p_sleep_idle(d))
+		goto unlock;
+	/* No submitters, queued work or IRQ-side ALIVE action can publish now. */
+	if (g5p_boot_drain(g) || !g5p_sleep_rings(g))
+		goto unlock;
+	deadline = ktime_get_ns() + 20 * NSEC_PER_MSEC;
+	do {
+		if (g5p_sleep_certificate(g, false)) {
+			g->sleep_reserved = true;
+			ret = 0;
+			break;
+		}
+		usleep_range(100, 200);
+	} while (ktime_get_ns() < deadline);
+unlock:
+	mutex_unlock(&g->lock);
+	if (!ret) {
+		dev_info(dev, "GPU-PM prepared: admission reserved\n");
+		return 0;
+	}
+refuse:
+	atomic_andnot(BIT(31), &g->sleep_gate);
+	g5p_rsched_kick(g->event_cookie);
+	dev_info(dev,
+		 "GPU-PM sleep refused: busy or no quiescent certificate\n");
+	return -EBUSY;
+}
+
+/* The early caller reserves admission; PM complete releases it on abort/wake.
+ * This is deliberately stronger than an observation-only readiness query.
+ */
+bool apple_g5p_system_sleep_ready(struct device *dev)
+{
+	return !g5p_system_sleep_prepare(dev);
+}
+EXPORT_SYMBOL_GPL(apple_g5p_system_sleep_ready);
+
+static int g5p_system_suspend(struct device *dev)
+{
+	struct g5p_diag *g = dev_get_drvdata(dev);
+	struct g5p_drm *d = g->event_cookie;
+	struct g5p_boot *b = g->boot;
+	struct g5p_render **drop, *r;
+	u32 slots[G5P_RU_USER_SLOTS], held, count = 0, n = 0;
+	int ret;
+
+	if (!g->sleep_reserved || g->sleep_failed)
+		return -EBUSY;
+	mutex_lock(&g->lock);
+	if (!READ_ONCE(b->alive) || READ_ONCE(b->failed) ||
+	    READ_ONCE(b->event_failed) || READ_ONCE(b->stopped) ||
+	    READ_ONCE(b->r73b->early_power_abort) || !g5p_sleep_idle(d) ||
+	    !g5p_sleep_rings(g) || !g5p_sleep_certificate(g, false)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	mutex_lock(&d->rdev->lock);
+	list_for_each_entry(r, &d->rdev->contexts, rdev_link)
+		count++;
+	mutex_unlock(&d->rdev->lock);
+	drop = kcalloc(max(count, 1U), sizeof(*drop), GFP_KERNEL);
+	if (!drop) {
+		ret = -EBUSY;
+		goto out;
+	}
+	held = g5p_ru_held_slots(g5p_boot_shared(b, 0x86),
+				 g5p_boot_shared(b, 0x84), slots,
+				 ARRAY_SIZE(slots));
+	ret = held ? g5p_rv3_unbind_slots(d, slots, held, "sleep") : 0;
+	if (ret)
+		goto failed;
+	/* Detach has changed firmware ownership: any later failure is terminal. */
+	if (!g5p_sleep_rings(g) || !g5p_sleep_certificate(g, false)) {
+		ret = -EBUSY;
+		goto failed;
+	}
+	ret = g5p_fender_write(g, 0x10, 0); /* Fender mode 3 */
+	if (!ret)
+		ret = g5p_fender_write(g, 0x20000, 0);
+	if (!ret)
+		ret = g5p_fender_poll(g, 0x1000, 0x10, 0);
+	if (!ret)
+		ret = g5p_fender_write(g, 0x1000, 0x10);
+	WRITE_ONCE(b->alive, false);
+	WRITE_ONCE(b->stopped, true);
+	disable_irq(b->irq);
+	g->sleep_irq_off = true;
+	if (ret || !g5p_sleep_certificate(g, true)) {
+		ret = ret ?: -EIO;
+		goto failed;
+	}
+	n = g5p_rv3_rebuild_host(d, drop, count);
+	d->rdev->sleep_rebuilds++;
+	g5p_mmio_gate(g);
+	g->fender_ready = false;
+	ret = pm_runtime_put_sync_suspend(dev);
+	g->powered = false; /* put consumed our reference, including on error */
+	if (ret < 0)
+		goto failed;
+	g->sleep_off = true;
+	dev_info(dev, "GPU-PM off: stable-off epoch=%u\n",
+		 d->rdev->sleep_rebuilds);
+	ret = 0;
+	goto free;
+failed:
+	g5p_sleep_fail(d, ret);
+free:
+	mutex_unlock(&g->lock);
+	for (u32 i = 0; i < n; i++) {
+		g5p_context_put(drop[i]->ctx);
+		drm_dev_put(&d->drm);
+	}
+	kfree(drop);
+	return ret;
+out:
+	mutex_unlock(&g->lock);
+	return ret;
+}
+
+static int g5p_system_resume(struct device *dev)
+{
+	struct g5p_diag *g = dev_get_drvdata(dev);
+	struct g5p_drm *d = g->event_cookie;
+	struct g5p_boot *b = g->boot;
+	unsigned long deadline;
+	int ret;
+
+	if (!g->sleep_off)
+		return g->sleep_failed ? -EIO : 0;
+	mutex_lock(&g->lock);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		goto failed;
+	g->powered = true;
+	g->sleep_boot = true;
+	/* A witnessed platform off/on invalidates DS108's old ALIVE generation.
+  * Retained maps/image are validated, never allocated or reinitialised.
+  */
+	ret = g5p_ds_hook_recover(g, 0);
+	if (ret)
+		goto failed;
+	g->fender_ready = true;
+	g->mmio_off = false;
+	b->stopped = false;
+	ret = g5p_boot_program_stream(g, true);
+	g5p_ds_hook_wake(g, ret);
+	if (ret)
+		goto failed;
+	g5p_ds_hook_maps(g, 0);
+	g5p_ds_hook_load(g, 0);
+	g5p_ds_hook_release(g, 0);
+	deadline = jiffies + 3 * HZ;
+	do {
+		/* IRQ remains masked. Consume fresh ALIVE in RAM without cmd8 or kicks. */
+		ret = g5p_boot_drain(g);
+		if (ret || READ_ONCE(b->alive))
+			break;
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, deadline));
+	if (!ret && !b->alive)
+		ret = -ETIMEDOUT;
+	if (!ret) {
+		u32 raw = readl(g->window[1] + 0x1000);
+
+		b->r73b->early_state = raw;
+		if (!g5p_gpc_ok(raw)) {
+			WRITE_ONCE(b->r73b->early_power_abort, true);
+			ret = -EHOSTDOWN;
+		}
+	}
+	g5p_ds_hook_alive(g, ret);
+	if (!ret)
+		ret = g5p_ds_hook_claim(g);
+	if (ret)
+		goto failed;
+	g5p_ru_term_reset(&g5p_rv3_term);
+	g->sleep_boot = false;
+	g->sleep_off = false;
+	g5p_td_op_aic_ack(g);
+	g->sleep_irq_off = false;
+	enable_irq(b->irq);
+	dev_info(dev, "GPU-PM on: fresh ALIVE gen=%u epoch=%u\n", g5p_ds_gen(),
+		 d->rdev->sleep_rebuilds);
+	mutex_unlock(&g->lock);
+	return 0;
+failed:
+	g->sleep_boot = false;
+	g->sleep_off = false;
+	g5p_sleep_fail(d, ret);
+	mutex_unlock(&g->lock);
+	return ret;
+}
+
+static int g5p_system_hibernate(struct device *dev)
+{
+	return -EBUSY;
+}
+
+static const struct dev_pm_ops g5p_system_sleep_pm_ops = {
+	.prepare = g5p_system_sleep_prepare,
+	.complete = apple_g5p_system_sleep_complete,
+	.suspend = g5p_system_suspend,
+	.resume = g5p_system_resume,
+	.freeze = g5p_system_hibernate,
+	.poweroff = g5p_system_hibernate,
+	.restore = g5p_system_hibernate,
+};
