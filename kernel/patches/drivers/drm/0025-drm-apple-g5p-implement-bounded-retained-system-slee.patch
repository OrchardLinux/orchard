index 5b152b8fd..7d3316769 100644
--- a/include/linux/apple-g5p-pm.h
+++ b/include/linux/apple-g5p-pm.h
@@ -8,18 +8,23 @@
 struct device;
 
 /*
- * For the platform pre-sync sleep veto. Missing support is never a promise
- * that a bound GPU can sleep. Currently all bound G5P devices must be vetoed.
- * A future positive result requires an admission reservation through abort
- * or resume; a snapshot alone cannot authorize power removal.
+ * The pre-sync veto reserves admission on success, through PM complete.
+ * Call only for the bound G5P platform device, from sleepable context.
+ * If sleep aborts before device PM, the caller MUST release the reservation
+ * with apple_g5p_system_sleep_complete(), including every PM_POST_* path.
+ * A false result has no reservation and leaves the running epoch intact.
  */
 #if IS_REACHABLE(CONFIG_DRM_APPLE_G5P)
 bool apple_g5p_system_sleep_ready(struct device *dev);
+void apple_g5p_system_sleep_complete(struct device *dev);
 #else
 static inline bool apple_g5p_system_sleep_ready(struct device *dev)
 {
 	return false;
 }
+static inline void apple_g5p_system_sleep_complete(struct device *dev)
+{
+}
 #endif
 
