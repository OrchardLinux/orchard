+#define G5P_MAX_VMS 8
+#define G5P_MAX_CONTEXTS 32
+#define G5P_MAX_MAPS 4096
+#define G5P_MAX_PT_PAGES 512
+#define G5P_MAX_SYNCS 17
+
+struct g5p_bo {
+	struct drm_gem_shmem_object shmem;
+	u32 roles;
+	u32 vm_pins; /* VMs that map it, any file; counted once in pinned_bytes (pin_lock) */
+	/* release8 memory accounting (drm-vm.inc g5p_bo_live): the live list, its creator */
+	struct list_head live;
+	pid_t pid;
+	char comm[TASK_COMM_LEN];
+};
+
+struct g5p_pt {
+	struct list_head link;
+	struct g5p_dma_page page;
+	u32 key;
+	u32 level;
+};
+
+struct g5p_mapping {
+	struct list_head link;
+	struct drm_mm_node node;
+	struct drm_gem_object *obj;
+	u64 offset;
+	u64 retire; /* unmapped beside queued jobs: freed once this fence seqno has signalled */
+};
+
+struct g5p_vm {
+	struct g5p_vm_mutation mutation;
+	bool bounded, frozen, serial_context;
+	bool zero_leaf_flags; /* render context latched r25 memory variant 4 */
+	/* Its render context's handle is gone (g5p_render_close()): no VM_BIND, no new
+	 * context; the context's close item and release own the tables.
+	 */
+	bool resident_gone;
+	struct g5p_context *resident;
+	struct kref ref;
+	struct device *dev;
+	struct g5p_drm *gpu;
+	struct drm_mm mm;
+	struct drm_mm_node reserved;
+	struct list_head maps;
+	struct xarray objs; /* object -> its mappings in this VM (xa_mk_value) */
+	struct list_head tables;
+	struct g5p_dma_page root;
+	u64 mapped_bytes, pinned_bytes;
+	u32 table_count, map_count, contexts;
+};
+
+struct g5p_drm;
+struct g5p_render;
+struct g5p_rdev;
+
+struct g5p_context {
+	struct g5p_drm *gpu;
+
+	bool live, bad;
+	bool serial, pending;
+
+	struct g5p_render *render; /* render contexts only, see drm-render.inc */
+	struct kref ref;
+	struct g5p_vm *vm;
+};
+
+struct g5p_file {
+	/* Serializes VM/context handles, mappings and the one-shot submit state. */
+	struct mutex lock;
+	struct xarray vms;
+	struct xarray contexts;
+	struct xarray results;
+	struct xarray targets; /* render targets; each holds its context */
+	u32 render_results;
+	bool submitted;
+	u64 job_id;
+};
+
+struct g5p_drm {
+	struct drm_device drm;
+	struct g5p_diag *core;
+	/* Protects cached IRQ event/status fields; never held for hardware IO. */
+	spinlock_t status_lock;
+	u32 last_event[11], notifications[4], first_fault[11];
+	u64 event_serial, fault_serial;
+	/* render_user_event_wake: the phase waiter sleeps here until event_serial moves */
+	wait_queue_head_t ev_wq;
+	/* TYPED_V3 3D completion-event latch (render-user-retire.h): G5P_RV3_TD_WANT | endpoint
+	 * while a 3D phase waits, else 0; td_hit_ns: decode time of the first matching event.
+	 */
+	u32 td_want;
+	u64 td_hit_ns;
+	/* The TA's latch: armed while a TA phase is published; ta_hit_ns as td_hit_ns. */
+	bool ta_want;
+	u64 ta_hit_ns;
+	/* wake110: type-1 completion events decoded per engine (word 1 bit 0 TA, bit 1 3D) since
+	 * load, and the decode time of the first one since the executor last cleared it.
+	 */
+	u32 t1_count[2];
+	u64 t1_first_ns[2];
+	/* perf60 bell gates (drm-render-v3.inc): the previous TYPED_V3 job's end and context. */
+	u64 bell_prev_end_ns;
+	const void *bell_prev_ctx;
+	u64 last_job;
+	int last_error, job_error;
+	u32 job_state;
+
+	atomic_t accepted;
+	atomic64_t job_sequence;
+	u64 fence_context;
+	/* Attached catalogues survive fd close until proven unbind/reset. */
+	struct g5p_context *quarantined_context;
+	/* The first accepted render job claimed the device for render, for the rest of the boot. */
+	bool render_claimed;
+	struct g5p_rdev *rdev; /* device-wide render state, see drm-render.inc */
+	struct workqueue_struct
+		*render_wq; /* ordered: the render scheduler's worker */
+	/* Orders render acceptance, dma_resv fence attach and queueing. */
+	struct mutex render_submit_lock;
+	/* recovery108 epoch inputs, RAM only: open render-node files, render jobs not yet
+	 * signalled.
+	 */
+	atomic_t open_files, r8_queued;
+	/* Memory mapped into any VM, each object once (render_pinned_mib). */
+	struct mutex pin_lock;
+	u64 pinned_bytes;
+};
+
+static inline struct g5p_drm *to_g5p(struct drm_device *drm)
+{
+	return container_of(drm, struct g5p_drm, drm);
+}
+
+static inline struct g5p_bo *to_g5p_bo(struct drm_gem_object *obj)
+{
+	return container_of(obj, struct g5p_bo, shmem.base);
+}
+
+#include "vm-ranges.h"
+
+static int g5p_resident_idle(struct g5p_context *c, bool live);
+static bool g5p_resident_defer(struct g5p_context *c, struct g5p_mapping *m);
+static int g5p_resident_invalidate(struct g5p_context *c);
+static void g5p_render_release(struct g5p_context *c);
+static int g5p_render_destroy(struct g5p_context *c);
+static void g5p_render_close(struct g5p_context *c);
+static int g5p_render_create_context(struct drm_device *drm,
+				     struct drm_file *file,
+				     struct drm_g5p_create_context *a);
+static struct dma_buf *g5p_gem_prime_export(struct drm_gem_object *obj,
+					    int flags);
+
+#include "drm-vm.inc"
+#include "drm-submit.inc"
+#include "drm-render.inc"
+#include "drm-prime.inc"
+
+static int g5p_get_info(struct drm_device *drm, void *data,
+			struct drm_file *file)
+{
+	struct drm_g5p_get_info *a = data;
+	u64 caps = DRM_G5P_CAP_BO_CPU | DRM_G5P_CAP_VM_PREPARE |
+		   DRM_G5P_CAP_SYNCOBJ | DRM_G5P_CAP_JOB_STATUS |
+		   DRM_G5P_CAP_CONTEXT_STATUS | DRM_G5P_CAP_FAULT_INFO;
+
+	if (a->size != sizeof(*a) || a->flags || a->reserved[0] ||
+	    a->reserved[1])
+		return -EINVAL;
+	;
+	;
+	;
+	;
+	memset(a, 0, sizeof(*a));
+	a->size = sizeof(*a);
+	a->version = DRM_G5P_UAPI_VERSION;
+	a->gpu_page_shift = 14;
+	;
+	;
+	;
+	;
+	;
+	{
+		caps |= DRM_G5P_CAP_RENDER | DRM_G5P_CAP_BOUNDED_RENDER |
+			DRM_G5P_CAP_TYPED_RENDER | DRM_G5P_CAP_VM_LIVE |
+			DRM_G5P_CAP_CONTEXT_LIVE |
+			DRM_G5P_CAP_CODE_BASE_VERIFIED;
+		a->code_base = 0x300000000ULL;
+	};
+	;
+	{
+		caps |= DRM_G5P_CAP_RENDER_KERNEL_GEOMETRY;
+	};
+	if ((1) && g5p_render_msaa_enabled())
+		caps |= DRM_G5P_CAP_RENDER_MSAA;
+	;
+	;
+	{
+		caps |= DRM_G5P_CAP_TYPED_RENDER_V3 |
+			DRM_G5P_CAP_RENDER_MULTI_CONTEXT |
+			DRM_G5P_CAP_RENDER_PIXEL_OUTPUT_WIDTH;
+	};
+	{
+		caps |= DRM_G5P_CAP_RENDER_UNPRIVILEGED;
+	};
+	;
+	;
+	caps |= DRM_G5P_CAP_PRIME;
+	a->capabilities = caps;
+	a->va_start = G5P_USER_VA_START;
+	a->va_end = G5P_USER_VA_END;
+	a->reserved_start = G5P_USER_RESERVED_START;
+	a->reserved_end = G5P_USER_RESERVED_END;
+	a->max_bo_size = G5P_MAX_BO_SIZE;
+	a->bvnc[0] = 9;
+	a->bvnc[1] = 15;
+	a->bvnc[2] = 6;
+	a->bvnc[3] = 2;
+	return 0;
+}
+
+/* The gated dialect uses the common B proven by the r19c numerical store. */
+static int g5p_get_exec_info(struct drm_device *drm, void *data,
+			     struct drm_file *file)
+{
+	struct drm_g5p_get_exec_info *a = data;
+
+	if (a->size != sizeof(*a) || a->flags || a->pad ||
+	    memchr_inv(a->reserved, 0, sizeof(a->reserved)))
+		return -EINVAL;
+	memset(a, 0, sizeof(*a));
+	a->size = sizeof(*a);
+	{
+		a->base_scope = DRM_G5P_BASE_VM;
+		a->usc_base = 0x300000000ULL;
+		a->pds_base = a->usc_base;
+		a->window_size = 0x34000;
+		a->allocation_alignment = G5P_GPU_PAGE;
+		a->usc_offset_bits = 32;
+		a->pds_offset_bits = 32;
+	}
+	return 0;
+}
+
+static int g5p_get_job_status(struct drm_device *drm, void *data,
+			      struct drm_file *file)
+{
+	struct drm_g5p_get_job_status *a = data;
+	struct g5p_file *f = file->driver_priv;
+	struct g5p_drm *d = to_g5p(drm);
+	unsigned long flags;
+	bool owned;
+
+	if (a->flags || a->pad || !a->job_id || a->reset_generation)
+		return -EINVAL;
+	mutex_lock(&f->lock);
+	if (xa_load(&f->results, a->job_id)) {
+		struct g5p_fence *fence = xa_load(&f->results, a->job_id);
+
+		spin_lock_irqsave(&d->status_lock, flags);
+		a->state = fence->state;
+		a->error = fence->error;
+		spin_unlock_irqrestore(&d->status_lock, flags);
+		mutex_unlock(&f->lock);
+		return 0;
+	}
+	owned = f->job_id == a->job_id;
+	mutex_unlock(&f->lock);
+	if (!owned)
+		return -ENOENT;
+	spin_lock_irqsave(&d->status_lock, flags);
+	a->state = d->job_state;
+	a->error = d->job_error;
+	/* Owner acknowledges terminal status before another fixed submission.
+	 * This avoids waking a fence waiter before the device admission reopens.
+	 */
+	;
+	spin_unlock_irqrestore(&d->status_lock, flags);
+	return 0;
+}
+
+/* c99788 classifies event4/7/8. Preserve opaque fields, never invent a VA. */
+static int g5p_get_fault_info(struct drm_device *drm, void *data,
+			      struct drm_file *file)
+{
+	struct drm_g5p_get_fault_info *a = data;
+	struct g5p_drm *d = to_g5p(drm);
+	unsigned long flags;
+
+	if (a->flags || a->reserved)
+		return -EINVAL;
+	memset(a, 0, sizeof(*a));
+	spin_lock_irqsave(&d->status_lock, flags);
+	a->event_serial = d->fault_serial;
+	memcpy(a->raw, d->first_fault, sizeof(a->raw));
+	spin_unlock_irqrestore(&d->status_lock, flags);
+	if (!a->event_serial)
+		return 0;
+	switch (a->raw[0]) {
+	case 4:
+		a->kind = DRM_G5P_FAULT_RECOVERY;
+		break;
+	case 7:
+		a->kind = DRM_G5P_FAULT_PAGE_REQUEST;
+		break;
+	case 8:
+		a->kind = DRM_G5P_FAULT_CHANNEL;
+		a->valid = DRM_G5P_FAULT_VALID_CHANNEL;
+		a->channel_class = a->raw[1];
+		a->channel_token = a->raw[3];
+		a->channel_stamp = a->raw[4];
+		break;
+	default:
+		a->kind = DRM_G5P_FAULT_UNKNOWN;
+		break;
+	}
+	return 0;
+}
+
+static int g5p_get_context_status(struct drm_device *drm, void *data,
+				  struct drm_file *file)
+{
+	struct drm_g5p_get_context_status *a = data;
+	struct g5p_file *f = file->driver_priv;
+	struct g5p_boot *b = READ_ONCE(to_g5p(drm)->core->boot);
+	struct g5p_context *c;
+	bool failed;
+	int ret = 0;
+
+	if (a->flags || a->state || a->map_count || a->mapped_bytes ||
+	    a->reserved)
+		return -EINVAL;
+	mutex_lock(&f->lock);
+	c = xa_load(&f->contexts, a->context);
+	if (!c) {
+		ret = -ENOENT;
+		goto out;
+	}
+	a->state = DRM_G5P_CONTEXT_HOST_ONLY;
+	if (READ_ONCE(c->live))
+		a->state = DRM_G5P_CONTEXT_LIVE;
+	/* a failure noted mid-job is not this context's until the executor rules */
+	failed = b && READ_ONCE(b->failed) &&
+		 !g5p_rdev_ruling(to_g5p(drm)->rdev);
+	if (READ_ONCE(c->bad) || failed || (b && READ_ONCE(b->stopped)))
+		a->state = DRM_G5P_CONTEXT_LOST;
+	a->map_count = c->vm->map_count;
+	a->mapped_bytes = c->vm->mapped_bytes;
+out:
+	mutex_unlock(&f->lock);
+	return ret;
+}
+
+static void g5p_drm_event(void *cookie, const u32 words[11])
+{
+	struct g5p_drm *d = cookie;
+	unsigned long flags;
+
+	spin_lock_irqsave(&d->status_lock, flags);
+	memcpy(d->last_event, words, sizeof(d->last_event));
+	d->event_serial++;
+	if (words[0] == 1)
+		for (u32 i = 0; i < 4; i++)
+			d->notifications[i] |= words[i + 1];
+	if (d->td_want && !d->td_hit_ns &&
+	    g5p_ru_rt_event_match(words, d->td_want & 0xff))
+		WRITE_ONCE(d->td_hit_ns, ktime_get_ns());
+	if (d->ta_want && !d->ta_hit_ns && g5p_ru_ta_event_match(words))
+		WRITE_ONCE(d->ta_hit_ns, ktime_get_ns());
+	for (u32 e = 0; words[0] == 1 && e < 2; e++) {
+		if (!(words[1] & BIT(e)))
+			continue;
+		WRITE_ONCE(d->t1_count[e], d->t1_count[e] + 1);
+		if (!d->t1_first_ns[e])
+			WRITE_ONCE(d->t1_first_ns[e], ktime_get_ns());
+	}
+	if (words[0] != 0 && words[0] != 1) {
+		d->last_error = -EIO;
+		if (!d->fault_serial) {
+			d->fault_serial = d->event_serial;
+			memcpy(d->first_fault, words, sizeof(d->first_fault));
+		}
+	}
+	spin_unlock_irqrestore(&d->status_lock, flags);
+	wake_up(&d->ev_wq);
+}
+
+static int g5p_drm_open(struct drm_device *drm, struct drm_file *file)
+{
+	struct g5p_file *f = kzalloc(sizeof(*f), GFP_KERNEL);
+
+	if (!f)
+		return -ENOMEM;
+	mutex_init(&f->lock);
+	xa_init_flags(&f->vms, XA_FLAGS_ALLOC1);
+	xa_init_flags(&f->contexts, XA_FLAGS_ALLOC1);
+	xa_init(&f->results);
+	xa_init_flags(&f->targets, XA_FLAGS_ALLOC1);
+	file->driver_priv = f;
+	atomic_inc(&to_g5p(drm)->open_files);
+	return 0;
+}
+
+static void g5p_drm_postclose(struct drm_device *drm, struct drm_file *file)
+{
+	struct g5p_file *f = file->driver_priv;
+	struct g5p_context *c;
+	struct g5p_vm *vm;
+	unsigned long id;
+	struct g5p_rt *rt;
+
+	atomic_dec(&to_g5p(drm)->open_files);
+	/* Render-target handles hold their context; drop them first. */
+	xa_for_each(&f->targets, id, rt)
+		g5p_context_put(rt->ctx);
+	xa_destroy(&f->targets);
+	/* Jobs hold contexts, contexts hold VMs, mappings hold GEM objects.
+	 * Closing the fd drops handle ownership, never a queued job's references.
+	 * Host-only tables may retire at job completion: no live GPU attachment.
+	 */
+	xa_for_each(&f->contexts, id, c) {
+		/* A render context's firmware binding outlives the handle until its close
+		 * item, queued behind its jobs, has unbound it.
+		 */
+		if (c->render)
+			g5p_render_close(c);
+		g5p_context_put(c);
+	}
+	xa_destroy(&f->contexts);
+	{
+		struct g5p_fence *fence;
+
+		xa_for_each(&f->results, id, fence)
+			dma_fence_put(&fence->base);
+		xa_destroy(&f->results);
+	}
+	xa_for_each(&f->vms, id, vm)
+		g5p_vm_put(vm);
+	xa_destroy(&f->vms);
+	mutex_destroy(&f->lock);
+	kfree(f);
+	/* The file's handles are gone (drm_gem_release() ran first): what stays live is held
+	 * by another file's handle, a dma-buf, a VM or a job (debugfs g5p_bos names it).
+	 */
+	dev_info(drm->dev,
+		"G5P file close live_bos=%u live_bo_bytes=%lluK device_pinned=%lluK\n",
+		READ_ONCE(g5p_bo_count), READ_ONCE(g5p_bo_bytes) >> 10,
+		READ_ONCE(to_g5p(drm)->pinned_bytes) >> 10);
+}
+
+static const struct drm_ioctl_desc g5p_ioctls[] = {
+	DRM_IOCTL_DEF_DRV(G5P_GET_INFO, g5p_get_info, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_CREATE_BO, g5p_create_bo, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_BO_MMAP_OFFSET, g5p_bo_mmap_offset,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_BO_SYNC, g5p_bo_sync, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_CREATE_VM, g5p_create_vm, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_DESTROY_VM, g5p_destroy_vm, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_VM_BIND, g5p_vm_bind, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_CREATE_CONTEXT, g5p_create_context,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_DESTROY_CONTEXT, g5p_destroy_context,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_GET_EXEC_INFO, g5p_get_exec_info,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_GET_JOB_STATUS, g5p_get_job_status,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_GET_CONTEXT_STATUS, g5p_get_context_status,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_GET_FAULT_INFO, g5p_get_fault_info,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_CREATE_RENDER_TARGET, g5p_create_render_target,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_DESTROY_RENDER_TARGET, g5p_destroy_render_target,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_GET_RENDER_INFO, g5p_get_render_info,
+			  DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(G5P_SUBMIT_RENDER_TYPED, g5p_submit_render_typed,
+			  DRM_RENDER_ALLOW),
+};
+
+DEFINE_DRM_GEM_FOPS(g5p_drm_fops);
+
+static const struct drm_driver g5p_drm_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_RENDER | DRIVER_SYNCOBJ |
+			   DRIVER_SYNCOBJ_TIMELINE,
+	.open = g5p_drm_open,
+	.postclose = g5p_drm_postclose,
+	.fops = &g5p_drm_fops,
+	.ioctls = g5p_ioctls,
+	.num_ioctls = ARRAY_SIZE(g5p_ioctls),
+	.gem_create_object = g5p_gem_create_object,
+	.prime_handle_to_fd = g5p_prime_handle_to_fd,
+	.prime_fd_to_handle = g5p_prime_fd_to_handle,
+	.gem_prime_import = g5p_gem_prime_import,
+	.gem_prime_import_sg_table = g5p_prime_import_sg_table,
+	.name = "apple_g5p",
+	.desc = "Apple A9 G5P experimental render driver",
+	.major = 0,
+	.minor = DRM_G5P_UAPI_VERSION,
+};
+
+/* recovery108: the frontend's epoch inputs for the retire layer.  RAM only and lock free:
+ * the claimed context is compared, never dereferenced (it may be dropped concurrently).
+ */
+static void g5p_drm_r8_epoch(void *cookie, struct g5p_r8_in *in)
+{
+	struct g5p_drm *d = cookie;
+	int queued = atomic_read(&d->r8_queued);
+
+	in->claimed = READ_ONCE(d->render_claimed) ||
+		      READ_ONCE(d->quarantined_context);
+	in->held = in->claimed && atomic_read(&d->open_files) > 0;
+	in->queued = queued > 0 ? queued : 0;
+}
+
+/* The teardown DETACH phase.  No fence is signalled here: with admission closed and the
+ * device frozen, the render scheduler fails each queued job exactly once (-ESHUTDOWN,
+ * without waiting for its inputs), and an in-flight job ends on its own RAM-only
+ * deadline.  The count left to the workers is reported as the explicit abandonment.
+ */
+static void g5p_drm_td_detach(void *cookie)
+{
+	struct g5p_drm *d = cookie;
+	int queued = atomic_read(&d->r8_queued);
+
+	g5p_r8_note_detach(&g5p_r8_state, queued > 0 ? queued : 0);
+	g5p_rsched_kick(d);
+}
+
+static int g5p_drm_probe(struct platform_device *pdev)
+{
+	struct g5p_drm *d;
+	struct g5p_diag *g;
+	int ret;
+
+	;
+	;
+	ret = g5p_probe(pdev);
+	if (ret)
+		return ret;
+	g = platform_get_drvdata(pdev);
+	d = devm_drm_dev_alloc(&pdev->dev, &g5p_drm_driver, struct g5p_drm,
+			       drm);
+	if (IS_ERR(d)) {
+		ret = PTR_ERR(d);
+		goto err_pm;
+	}
+	d->core = g;
+	d->fence_context = dma_fence_context_alloc(1);
+	spin_lock_init(&d->status_lock);
+	init_waitqueue_head(&d->ev_wq);
+	atomic_set(&d->accepted, 0);
+	atomic64_set(&d->job_sequence, 0);
+	d->render_wq = drmm_alloc_ordered_workqueue(&d->drm, "g5p-render", 0);
+	if (IS_ERR_OR_NULL(d->render_wq)) {
+		ret = d->render_wq ? PTR_ERR(d->render_wq) : -ENOMEM;
+		goto err_pm;
+	}
+	ret = drmm_mutex_init(&d->drm, &d->render_submit_lock);
+	if (!ret)
+		ret = drmm_mutex_init(&d->drm, &d->pin_lock);
+	if (ret)
+		goto err_pm;
+	ret = g5p_render_init(d);
+	if (ret)
+		goto err_pm;
+	g->event_cookie = d;
+	g->event_notify = g5p_drm_event;
+	atomic_set(&d->open_files, 0);
+	atomic_set(&d->r8_queued, 0);
+	drm_debugfs_add_file(&d->drm, "g5p_bos", g5p_bos_show, NULL);
+	ret = drm_dev_register(&d->drm, 0);
+	if (ret)
+		goto err_pm;
+	g5p_r8_register_epoch(g5p_drm_r8_epoch, d);
+	g5p_td_register_detach(g5p_drm_td_detach, d);
+	g5p_kq_register(&g5p_kq_drm, d);
+	dev_info(&pdev->dev,
+		"render node registered; no GPU access, COMPUTE/RENDER capabilities absent\n");
+	return 0;
+err_pm:
+	g->event_notify = NULL;
+	pm_runtime_disable(&pdev->dev);
+	return ret;
+}
+
+static void g5p_drm_remove(struct platform_device *pdev)
+{
+	struct g5p_diag *g = platform_get_drvdata(pdev);
+	struct g5p_drm *d = g->event_cookie;
+
+	drm_dev_unplug(&d->drm);
+	g5p_remove(pdev);
+	/* recovery108: the remove-time FINAL above was the callbacks' last use; d is
+	 * devres-freed next.
+	 */
+	g5p_td_register_detach(NULL, NULL);
+	g5p_r8_register_epoch(NULL, NULL);
+	g5p_kq_register(NULL, NULL);
+}
+
+static const struct of_device_id g5p_drm_match[] = {
+	{ .compatible = "gpu,s8003" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, g5p_drm_match);
+
+static struct platform_driver g5p_drm_platform = {
+	.probe = g5p_drm_probe,
+	.remove = g5p_drm_remove,
+	.shutdown = g5p_shutdown,
+	.driver = {
+		.name = "apple-g5p-drm",
+		.of_match_table = g5p_drm_match,
+		.dev_groups = g5p_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+
+static bool enable;
+static bool drm_initialized;
+static bool drm_registered;
+
+static int g5p_drm_enable_set(const char *value, const struct kernel_param *kp)
+{
+	bool requested;
+	int ret = kstrtobool(value, &requested);
+
+	if (ret)
+		return ret;
+	if (!drm_initialized) {
+		enable = requested;
+		return 0;
+	}
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	if (!requested && drm_registered)
+		return -EBUSY;
+	if (requested && !drm_registered) {
+		ret = g5p_frontend_available();
+		if (ret)
+			return ret;
+		ret = platform_driver_register(&g5p_drm_platform);
+		if (ret)
+			return ret;
+		drm_registered = true;
+	}
+	enable = requested;
+	return 0;
+}
+
+static const struct kernel_param_ops g5p_drm_enable_ops = {
+	.set = g5p_drm_enable_set,
+	.get = param_get_bool,
+};
+module_param_cb(enable, &g5p_drm_enable_ops, &enable, 0600);
+MODULE_PARM_DESC(enable,
+	"Explicitly register G5P DRM frontend; conflicts with diagnostic binding, default false");
+
+static int __init g5p_drm_init(void)
+{
+	drm_initialized = true;
+	if (!enable) {
+		pr_info("apple-g5p-drm: inert; explicit a9_gpu_drm.enable=1 required\n");
+		return 0;
+	}
+	return g5p_drm_enable_set("1", NULL);
+}
+module_init(g5p_drm_init);
+
+/* Built-in only until reset can prove all DMA references are quiescent. */
+MODULE_DESCRIPTION("Default-disabled Apple G5P render/GEM/VM experimental driver");
+MODULE_LICENSE("Dual MIT/GPL");
+MODULE_FIRMWARE(G5P_FW_NAME);
diff --git a/drivers/gpu/drm/apple-g5p/drm-latency123.inc b/drivers/gpu/drm/apple-g5p/drm-latency123.inc
new file mode 100644
index 0000000000..085e766504
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-latency123.inc
@@ -0,0 +1,294 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Latency123: runtime A/B knobs for the V3 render path, all default off and all writable
+ * through /sys/module/a9_gpu_drm/parameters on a live boot.  Included from drm-render.inc
+ * before drm-render-v3.inc.  The executor is serial and holds the core lock, so the state
+ * below needs no lock of its own.
+ *
+ *   fw_tick_mask (boot.inc)  ctl+0x04, re-applied before every job (RAM)
+ *   slc_evict_us             while a job is in flight, one pass over slc_evict_mib MiB of
+ *                            cacheable kernel memory at most every N us (the waiter's
+ *                            1-2 ms sample cadence bounds it from below); slc_evict_ops:
+ *                            1 read pass, 2 write pass, 4 Normal-NC read of the firmware's
+ *                            root+shared pages, 8 TLBI VMALLE1IS, 16 DSB SY + SEV
+ *   cpu_sync                 1 dma_sync every job BO (device before, CPU after), 2 clean
+ *                            root+shared to PoC before the publish, 4 clean+invalidate the
+ *                            polled pages before every sample
+ *   lat123_log               one RENDER-L123 line per job (times in ms from the submit ioctl)
+ *   pstate_probe             1 PMGR gfx word at job start/end (always-on block), 2 also one
+ *                            read of Fender +0x1000 at the first sample that shows a fresh
+ *                            engine busy rise (engine running, so the block is powered)
+ *
+ * No other register access.  Temporary: none of this is the fix.
+ */
+
+#include <asm/cacheflush.h>
+#include <asm/tlbflush.h>
+
+#define G5P_L123_OP_READ BIT(0)
+#define G5P_L123_OP_WRITE BIT(1)
+#define G5P_L123_OP_FW_READ BIT(2)
+#define G5P_L123_OP_TLBI BIT(3)
+#define G5P_L123_OP_SEV BIT(4)
+#define G5P_L123_SYNC_BO BIT(0)
+#define G5P_L123_SYNC_REGIONS BIT(1)
+#define G5P_L123_SYNC_POLL BIT(2)
+#define G5P_L123_LINE 64
+
+static struct {
+	void *buf;
+	size_t size;
+	u64 sink;
+	/* per job */
+	u64 exec_ns, next_ns, evict_ns, ps_ns;
+	u32 us, mib, ops, sync, passes, tick, ps;
+	u32 pmgr[2];
+	bool seen[2], idle[2], probed;
+	/* render_user_event_wake: pauses ended by an event, the timeout, a post-event poll, legacy */
+	u32 ew[4];
+	u64 ew_ns;
+} g5p_l123;
+
+/* perf60-fillrate.md §11.3 cut 1 (render-user-evwait.h): the phase wait's pause between RAM samples. */
+static unsigned int render_user_event_wake = 2000; /* release8 default */
+module_param(render_user_event_wake, uint, 0600);
+MODULE_PARM_DESC(
+	render_user_event_wake,
+	"perf60 default0 (release8: sleep 1-2 ms between completion samples); N: sleep "
+	"until the next firmware event (the IRQ thread's decode wakes the waiter), at "
+	"most N us (100..20000) as the safety net, and poll every 100 us once the "
+	"phase's own completion event is latched; read live");
+
+/* A word of a firmware object; objects may straddle the region's 16 KiB pages. */
+static u8 *g5p_l123_word(struct g5p_boot *b, u32 slot, u32 field)
+{
+	u32 off = b->layout.offset[slot] + field;
+	struct g5p_dma_page *page = b->layout.group[slot] ? b->shared : b->root;
+
+	return page[off / G5P_GPU_PAGE].cpu + off % G5P_GPU_PAGE;
+}
+
+static void g5p_l123_pages(struct g5p_dma_page *page, u32 count,
+			   void (*op)(unsigned long start, unsigned long end))
+{
+	for (u32 i = 0; i < count; i++)
+		if (page[i].cpu)
+			op((unsigned long)page[i].cpu,
+			   (unsigned long)page[i].cpu + G5P_GPU_PAGE);
+}
+
+static void g5p_l123_page_of(const void *p,
+			     void (*op)(unsigned long start, unsigned long end))
+{
+	unsigned long start = (unsigned long)p &
+			      ~(unsigned long)(G5P_GPU_PAGE - 1);
+
+	op(start, start + G5P_GPU_PAGE);
+}
+
+/* cpu_sync 4: the pages the waiter samples (rings, TA/3D/PM pages, the idle words). */
+static void g5p_l123_poll_pages(struct g5p_boot *b, u32 e)
+{
+	g5p_l123_page_of(g5p_boot_shared(b, 0x60), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_boot_shared(b, 0x64), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_ru_page(b, 0), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_ru_page(b, 1), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_ru_pm_cpu(b), dcache_clean_inval_poc);
+	g5p_l123_page_of(g5p_ru_global(b, e) + 0x724, dcache_clean_inval_poc);
+	dsb(sy);
+}
+
+static void g5p_l123_bos(struct g5p_drm *d, struct g5p_rjob *job, bool to_cpu)
+{
+	for (u32 i = 0; i < job->obj_count; i++) {
+		struct sg_table *sgt =
+			to_drm_gem_shmem_obj(job->objs[i].obj)->sgt;
+
+		if (!sgt)
+			continue;
+		if (to_cpu)
+			dma_sync_sgtable_for_cpu(d->drm.dev, sgt,
+						 DMA_BIDIRECTIONAL);
+		else
+			dma_sync_sgtable_for_device(d->drm.dev, sgt,
+						    DMA_BIDIRECTIONAL);
+	}
+}
+
+static u32 g5p_l123_pmgr(struct g5p_diag *g)
+{
+	u32 raw = U32_MAX;
+
+	if (!((0) & 1) || !g->pmgr || regmap_read(g->pmgr, 0x80340, &raw))
+		return U32_MAX;
+	return raw;
+}
+
+/* At the executor's entry: this job's knob values and counters. */
+static void g5p_l123_job_reset(struct g5p_diag *g)
+{
+	g5p_l123.exec_ns = ktime_get_ns();
+	g5p_l123.next_ns = 0;
+	g5p_l123.evict_ns = 0;
+	g5p_l123.ps_ns = 0;
+	g5p_l123.passes = 0;
+	g5p_l123.ps = U32_MAX;
+	g5p_l123.probed = false;
+	memset(g5p_l123.ew, 0, sizeof(g5p_l123.ew));
+	g5p_l123.ew_ns = 0;
+	g5p_l123.seen[0] = false;
+	g5p_l123.seen[1] = false;
+	g5p_l123.us = (0);
+	g5p_l123.mib = clamp((16), 1U, 64U);
+	g5p_l123.ops = (1);
+	g5p_l123.sync = (0);
+	g5p_l123.pmgr[0] = g5p_l123_pmgr(g);
+	g5p_l123.pmgr[1] = U32_MAX;
+}
+
+/* After the job's records are written, before they are cleaned and published.  May sleep. */
+static void g5p_l123_job_prepare(struct g5p_drm *d, struct g5p_rjob *job)
+{
+	struct g5p_boot *b = d->core->boot;
+	u8 *tick = g5p_l123_word(b, G5P_L123_CTL, 4);
+	u32 mask = (0);
+	size_t size = (size_t)g5p_l123.mib << 20;
+
+	if (mask <= G5P_L123_TICK_MASK && g5p_le32(tick) != mask) {
+		g5p_put32(tick, mask);
+		dma_wmb();
+	}
+	g5p_l123.tick = g5p_le32(tick);
+
+	if (!g5p_l123.us ||
+	    !(g5p_l123.ops & (G5P_L123_OP_READ | G5P_L123_OP_WRITE))) {
+		vfree(g5p_l123.buf);
+		g5p_l123.buf = NULL;
+		g5p_l123.size = 0;
+	} else if (g5p_l123.size != size) {
+		vfree(g5p_l123.buf);
+		g5p_l123.buf = vmalloc(size);
+		g5p_l123.size = g5p_l123.buf ? size : 0;
+		if (g5p_l123.buf)
+			memset(g5p_l123.buf, 0x5a, size);
+	}
+
+	if (g5p_l123.sync & G5P_L123_SYNC_BO)
+		g5p_l123_bos(d, job, false);
+	if (g5p_l123.sync & G5P_L123_SYNC_REGIONS) {
+		g5p_l123_pages(b->root, ARRAY_SIZE(b->root), dcache_clean_poc);
+		g5p_l123_pages(b->shared, ARRAY_SIZE(b->shared),
+			       dcache_clean_poc);
+		dsb(sy);
+	}
+	if (g5p_l123.sync & G5P_L123_SYNC_POLL)
+		g5p_l123_poll_pages(b, 0);
+}
+
+/* One streaming pass and the other per-pass operations. */
+static void g5p_l123_evict(struct g5p_boot *b)
+{
+	u64 t0 = ktime_get_ns(), sum = 0;
+	u32 ops = g5p_l123.ops;
+
+	if ((ops & G5P_L123_OP_READ) && g5p_l123.buf) {
+		u64 *p = g5p_l123.buf;
+
+		for (size_t i = 0; i < g5p_l123.size / 8;
+		     i += G5P_L123_LINE / 8)
+			sum += READ_ONCE(p[i]);
+	}
+	if ((ops & G5P_L123_OP_WRITE) && g5p_l123.buf) {
+		u64 *p = g5p_l123.buf;
+
+		for (size_t i = 0; i < g5p_l123.size / 8;
+		     i += G5P_L123_LINE / 8)
+			WRITE_ONCE(p[i], i);
+	}
+	if (ops & G5P_L123_OP_FW_READ) {
+		struct g5p_dma_page *regions[] = { b->root, b->shared };
+		u32 counts[] = { ARRAY_SIZE(b->root), ARRAY_SIZE(b->shared) };
+
+		for (u32 r = 0; r < ARRAY_SIZE(regions); r++)
+			for (u32 i = 0; i < counts[r]; i++)
+				for (u32 at = 0;
+				     regions[r][i].cpu && at < G5P_GPU_PAGE;
+				     at += G5P_L123_LINE)
+					sum += READ_ONCE(*(
+						const u32 *)(regions[r][i].cpu +
+							     at));
+	}
+	if (ops & G5P_L123_OP_TLBI)
+		flush_tlb_all();
+	if (ops & G5P_L123_OP_SEV) {
+		dsb(sy);
+		sev();
+	}
+	WRITE_ONCE(g5p_l123.sink, g5p_l123.sink + sum);
+	g5p_l123.passes++;
+	g5p_l123.evict_ns += ktime_get_ns() - t0;
+}
+
+/* Replaces the waiter's sleep between two RAM samples of engine e.  seen: d->event_serial as
+ * read after the drain and before this sample (render-user-evwait.h).
+ */
+static void g5p_l123_pause(struct g5p_drm *d, struct g5p_diag *g, u32 e,
+			   const struct g5p_rv3_ev *s, u64 seen)
+{
+	u64 now = s->ns, t0;
+	enum g5p_ew_act act;
+	u32 wait_us;
+
+	if (((0) & 2) && !g5p_l123.probed && g5p_l123.seen[e] &&
+	    g5p_l123.idle[e] && !s->idle_ok && !s->failed && !s->proto &&
+	    !g5p_ru_term_failed(&g5p_rv3_term) && !READ_ONCE(g->boot->failed)) {
+		struct g5p_mmio_ticket t;
+
+		/* an R1-only ticket of the register licence (mmio.inc), never a bare read */
+		if (!g5p_mmio_hold(g, &t, G5P_MMIO_CENSUS))
+			g5p_mmio_release(g, &t);
+		g5p_l123.ps = t.gpc;
+		g5p_l123.ps_ns = ktime_get_ns();
+		g5p_l123.probed = true;
+	}
+	g5p_l123.seen[e] = true;
+	g5p_l123.idle[e] = s->idle_ok;
+	if (g5p_l123.us && now >= g5p_l123.next_ns) {
+		g5p_l123_evict(g->boot);
+		g5p_l123.next_ns = now + (u64)g5p_l123.us * NSEC_PER_USEC;
+	}
+	act = g5p_ew_plan(READ_ONCE(render_user_event_wake), s->event,
+			  &wait_us);
+	t0 = ktime_get_ns();
+	if (act == G5P_EW_LEGACY) {
+		usleep_range(1000, 2000);
+		g5p_l123.ew[3]++;
+	} else if (act == G5P_EW_SHORT) {
+		usleep_range(wait_us, wait_us + wait_us / 2);
+		g5p_l123.ew[2]++;
+	} else if (wait_event_hrtimeout(
+			   d->ev_wq,
+			   g5p_ew_woken(seen, READ_ONCE(d->event_serial)),
+			   us_to_ktime(wait_us))) {
+		g5p_l123.ew[1]++; /* -ETIME: the safety net */
+	} else {
+		g5p_l123.ew[0]++;
+	}
+	g5p_l123.ew_ns += ktime_get_ns() - t0;
+	if (g5p_l123.sync & G5P_L123_SYNC_POLL)
+		g5p_l123_poll_pages(g->boot, e);
+}
+
+/* After the receipt.  One line per job while lat123_log is set. */
+static void g5p_l123_job_end(struct g5p_drm *d, struct g5p_rjob *job, u32 seq,
+			     int ret)
+{
+	struct g5p_diag *g = d->core;
+
+	if (!ret && (g5p_l123.sync & G5P_L123_SYNC_BO))
+		g5p_l123_bos(d, job, true);
+	g5p_l123.pmgr[1] = g5p_l123_pmgr(g);
+	{
+		return;
+	}
+}
diff --git a/drivers/gpu/drm/apple-g5p/drm-prime.inc b/drivers/gpu/drm/apple-g5p/drm-prime.inc
new file mode 100644
index 0000000000..bd513b9695
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-prime.inc
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* PRIME for shmem GEM BOs.
+ *
+ * Export: Mesa WSI/client buffers and kmsro bookkeeping. The dma-buf adds
+ * begin/end_cpu_access, so an importer that CPU-reads (simpledrm's blit,
+ * llvmpipe) gets cache maintenance on the G5P DMA mapping. vmap/mmap reuse
+ * the shmem helpers (write-combined when the device is not DMA-coherent).
+ *
+ * Import: foreign dma-bufs, e.g. simpledrm dumb buffers that the GPU renders
+ * into for scanout. The attachment stays mapped (pinned) for the life of the
+ * GEM object; VM_BIND maps its sg_table. Render jobs listing an imported BO
+ * get whole-buffer cache maintenance and dma_resv fences (drm-render.inc).
+ */
+
+static int g5p_dmabuf_begin_cpu_access(struct dma_buf *buf,
+				       enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj = buf->priv;
+	struct sg_table *sgt = to_drm_gem_shmem_obj(obj)->sgt;
+
+	/* No device mapping yet means no device-owned cache lines either. */
+	if (sgt)
+		dma_sync_sgtable_for_cpu(obj->dev->dev, sgt, DMA_BIDIRECTIONAL);
+	return 0;
+}
+
+static int g5p_dmabuf_end_cpu_access(struct dma_buf *buf,
+				     enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj = buf->priv;
+	struct sg_table *sgt = to_drm_gem_shmem_obj(obj)->sgt;
+
+	if (sgt)
+		dma_sync_sgtable_for_device(obj->dev->dev, sgt,
+					    DMA_BIDIRECTIONAL);
+	return 0;
+}
+
+static const struct dma_buf_ops g5p_dmabuf_ops = {
+	.attach = drm_gem_map_attach,
+	.detach = drm_gem_map_detach,
+	.map_dma_buf = drm_gem_map_dma_buf,
+	.unmap_dma_buf = drm_gem_unmap_dma_buf,
+	.release = drm_gem_dmabuf_release,
+	.mmap = drm_gem_dmabuf_mmap,
+	.vmap = drm_gem_dmabuf_vmap,
+	.vunmap = drm_gem_dmabuf_vunmap,
+	.begin_cpu_access = g5p_dmabuf_begin_cpu_access,
+	.end_cpu_access = g5p_dmabuf_end_cpu_access,
+};
+
+static struct dma_buf *g5p_gem_prime_export(struct drm_gem_object *obj,
+					    int flags)
+{
+	struct dma_buf_export_info info = {
+		.exp_name = KBUILD_MODNAME,
+		.owner = obj->dev->driver->fops->owner,
+		.ops = &g5p_dmabuf_ops,
+		.size = obj->size,
+		.flags = flags,
+		.priv = obj,
+		.resv = obj->resv,
+	};
+
+	return drm_gem_dmabuf_export(obj->dev, &info);
+}
+
+static int g5p_prime_handle_to_fd(struct drm_device *dev, struct drm_file *file,
+				  u32 handle, u32 flags, int *fd)
+{
+	return drm_gem_prime_handle_to_fd(dev, file, handle, flags, fd);
+}
+
+static int g5p_prime_fd_to_handle(struct drm_device *dev, struct drm_file *file,
+				  int fd, u32 *handle)
+{
+	return drm_gem_prime_fd_to_handle(dev, file, fd, handle);
+}
+
+/* Our own export comes back as the same GEM object (the core's identity check
+ * only knows its default ops); anything else is attached and mapped.
+ */
+static struct drm_gem_object *g5p_gem_prime_import(struct drm_device *dev,
+						   struct dma_buf *buf)
+{
+	struct drm_gem_object *obj = buf->priv;
+
+	if (buf->ops == &g5p_dmabuf_ops && obj->dev == dev) {
+		drm_gem_object_get(obj);
+		return obj;
+	}
+	return drm_gem_prime_import(dev, buf);
+}
+
+/* Foreign buffers are GPU READ|WRITE data, never executable, and must be
+ * whole 16KiB GPU pages within the BO size limit.
+ */
+static struct drm_gem_object *
+g5p_prime_import_sg_table(struct drm_device *dev,
+			  struct dma_buf_attachment *attach,
+			  struct sg_table *sgt)
+{
+	struct drm_gem_object *obj;
+
+	if (attach->dmabuf->size & (G5P_GPU_PAGE - 1) ||
+	    attach->dmabuf->size > G5P_MAX_BO_SIZE)
+		return ERR_PTR(-EINVAL);
+	obj = drm_gem_shmem_prime_import_sg_table(dev, attach, sgt);
+	if (!IS_ERR(obj)) {
+		to_g5p_bo(obj)->roles = DRM_G5P_BO_READ | DRM_G5P_BO_WRITE;
+		g5p_bo_track(obj);
+	}
+	return obj;
+}
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-sched.inc b/drivers/gpu/drm/apple-g5p/drm-render-sched.inc
new file mode 100644
index 0000000000..21dc64d89a
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-render-sched.inc
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * The render scheduler (docs/gpu/multi-client-design.md "Stage 2/3 as built"): one worker on
+ * the ordered render_wq serves the contexts round-robin (core/render-user-sched.h).  Jobs wait
+ * for their inputs on dma-fence callbacks, not in the worker, so one client's unsignalled
+ * fence never holds up another client.  Each picked job runs to completion on the one shared
+ * channel (one credit), exactly as a work item did before; a context's close item runs after
+ * its last job.  Included from drm-render.inc after drm-render-v3.inc.
+ *
+ * The shape is drm_sched's (entity FIFO, run-list RR, dependency callbacks, entity teardown
+ * after the last job), so stage 4 can replace it with drm_sched without a UAPI change.
+ */
+
+static struct dma_fence *g5p_rjob_dep(struct g5p_rjob *job, u32 i)
+{
+	return i < job->input_count ? job->inputs[i] :
+				      job->deps[i - job->input_count];
+}
+
+/* A signalled input: its error, or that of any fence it wraps (array, chain), else 0. */
+static int g5p_render_fence_status(struct dma_fence *fence)
+{
+	struct dma_fence_unwrap cursor;
+	struct dma_fence *part;
+	u32 unwrapped = 0;
+	int ret = dma_fence_get_status(fence);
+
+	if (ret < 0)
+		return ret;
+	dma_fence_unwrap_for_each(part, &cursor, fence) {
+		ret = dma_fence_get_status(part);
+		if (ret <= 0 || ++unwrapped > 4096) {
+			dma_fence_put(cursor.chain);
+			return ret < 0 ? ret : -ETIMEDOUT;
+		}
+	}
+	return 0;
+}
+
+/* Fence callback (any context, the fence lock held): the head job's input signalled. */
+static void g5p_rjob_dep_cb(struct dma_fence *fence, struct dma_fence_cb *cb)
+{
+	struct g5p_rjob *job = container_of(cb, struct g5p_rjob, cb);
+
+	WRITE_ONCE(job->cb_fired, true);
+	mod_delayed_work(job->gpu->render_wq, &job->gpu->rdev->sched_work, 0);
+}
+
+/* Scheduler lock held: no callback of this job stays armed. */
+static void g5p_rjob_disarm(struct g5p_rjob *job)
+{
+	if (job->cb_fence)
+		dma_fence_remove_callback(job->cb_fence, &job->cb);
+	job->cb_fence = NULL;
+}
+
+/*
+ * Scheduler lock held: may the head job of its context run now?  Walks its explicit inputs,
+ * then its implicit dependencies, in order; at the first unsignalled one it arms a callback
+ * and reports the job's input deadline.  A failed input, the deadline (G5P_RU_INPUT_MS after
+ * the submit, as the old in-worker wait) and closed admission make it ready with an error, so
+ * that it fails before the hardware and its fence still signals in order.
+ */
+static bool g5p_rsched_ready(struct g5p_rs_job *node, void *cookie,
+			     unsigned long *deadline)
+{
+	struct g5p_rjob *job = container_of(node, struct g5p_rjob, node);
+
+	if (job->setup_error || job->dep_error)
+		return true;
+	if (g5p_r8_admit_closed(&g5p_r8_state.admit)) {
+		g5p_rjob_disarm(job);
+		job->dep_error = -ESHUTDOWN;
+		return true;
+	}
+	if (job->cb_fence) {
+		if (!READ_ONCE(job->cb_fired))
+			goto pending;
+		job->cb_fence = NULL;
+	}
+	while (job->dep_next < job->input_count + job->dep_count) {
+		struct dma_fence *fence = g5p_rjob_dep(job, job->dep_next);
+
+		if (dma_fence_is_signaled(fence)) {
+			job->dep_error = g5p_render_fence_status(fence);
+			if (job->dep_error)
+				return true;
+			job->dep_next++;
+			continue;
+		}
+		WRITE_ONCE(job->cb_fired, false);
+		if (dma_fence_add_callback(fence, &job->cb, g5p_rjob_dep_cb))
+			continue; /* -ENOENT: signalled meanwhile */
+		job->cb_fence = fence;
+		goto pending;
+	}
+	return true;
+pending:
+	if (time_after_eq(jiffies, job->deadline)) {
+		g5p_rjob_disarm(job);
+		job->dep_error = -ETIMEDOUT;
+		return true;
+	}
+	*deadline = job->deadline;
+	return false;
+}
+
+static void g5p_rsched_kick(struct g5p_drm *d)
+{
+	mod_delayed_work(d->render_wq, &d->rdev->sched_work, 0);
+}
+
+/* Submit, render_submit_lock held: an accepted job joins its context's FIFO. */
+static void g5p_rsched_push(struct g5p_drm *d, struct g5p_render *r,
+			    struct g5p_rjob *job)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&d->rdev->sched_lock, flags);
+	g5p_rs_push(&d->rdev->sched, &r->entity, &job->node);
+	spin_unlock_irqrestore(&d->rdev->sched_lock, flags);
+	g5p_rsched_kick(d);
+}
+
+/* The close item joins the context's entity behind its jobs; false if one is queued. */
+static bool g5p_rsched_close(struct g5p_drm *d, struct g5p_render *r)
+{
+	unsigned long flags;
+	bool queued;
+
+	spin_lock_irqsave(&d->rdev->sched_lock, flags);
+	queued = g5p_rs_close(&d->rdev->sched, &r->entity);
+	spin_unlock_irqrestore(&d->rdev->sched_lock, flags);
+	if (queued)
+		g5p_rsched_kick(d);
+	return queued;
+}
+
+static void g5p_render_run(struct g5p_rjob *job);
+static void g5p_render_close_run(struct g5p_render *r);
+static void g5p_render_close_deferred(struct g5p_drm *d);
+
+/*
+ * The worker: pick, run to completion, repeat; then sleep until a callback, a submit or the
+ * earliest input deadline wakes it.  render_wq is ordered, so this never runs twice at once,
+ * and it is the only writer of the device's job state, as each job's work item was.
+ */
+static void g5p_rsched_work(struct work_struct *work)
+{
+	struct g5p_rdev *rd = container_of(to_delayed_work(work),
+					   struct g5p_rdev, sched_work);
+	struct g5p_drm *d = rd->drm;
+
+	/* Each item drops the references it held; the device must outlive this loop. */
+	drm_dev_get(&d->drm);
+	for (;;) {
+		struct g5p_rs_entity *e;
+		struct g5p_rs_job *node;
+		struct g5p_render *r;
+		struct g5p_context *c;
+		unsigned long flags, wake = 0;
+		bool has_wake;
+		int what;
+
+		/* A lost job blocks the channel: hold every job until the drain is decided, and
+		 * until a recovery the drain or the executor asked for has run.
+		 */
+		if (READ_ONCE(rd->stuck) || READ_ONCE(rd->recovering)) {
+			if (rd->stuck ? g5p_rv3_drain(d) : g5p_rv3_recover(d))
+				continue;
+			queue_delayed_work(d->render_wq, &rd->sched_work,
+					   msecs_to_jiffies(100));
+			break;
+		}
+		spin_lock_irqsave(&rd->sched_lock, flags);
+		what = g5p_rs_pick(&rd->sched, g5p_rsched_ready, d, &e, &node,
+				   &wake, &has_wake);
+		spin_unlock_irqrestore(&rd->sched_lock, flags);
+		if (what == G5P_RS_IDLE) {
+			if (has_wake)
+				queue_delayed_work(
+					d->render_wq, &rd->sched_work,
+					max_t(long, (long)(wake - jiffies), 1));
+			break;
+		}
+		if (what == G5P_RS_JOB) {
+			g5p_render_run(
+				container_of(node, struct g5p_rjob, node));
+			g5p_render_close_deferred(d);
+			continue;
+		}
+		r = container_of(e, struct g5p_render, entity);
+		c = r->ctx;
+		g5p_render_close_run(r);
+		spin_lock_irqsave(&rd->sched_lock, flags);
+		g5p_rs_closed(&rd->sched, e);
+		spin_unlock_irqrestore(&rd->sched_lock, flags);
+		/* The close item's own reference (g5p_render_close()); r may go with it. */
+		g5p_context_put(c);
+		drm_dev_put(&d->drm);
+	}
+	drm_dev_put(&d->drm);
+}
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-unbind.inc b/drivers/gpu/drm/apple-g5p/drm-render-unbind.inc
new file mode 100644
index 0000000000..36550c4432
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-render-unbind.inc
@@ -0,0 +1,488 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Unbinding firmware slots (docs/gpu/multi-client-design.md §4.5): a closed context's pair
+ * (stage 2, core/render-user-close.h) and the render frontend's share of the reboot quiesce
+ * (core/render-user-quiesce.h, docs/gpu/experiments/mcfold2-kexec.md).
+ * Included from drm-render.inc after drm-render-v3.inc.
+ */
+
+/* The RAM words of `slot` and of its unbind record at ring entry `index`. */
+static void g5p_render_slot_mem(struct g5p_boot *b, u32 slot, u32 index,
+				struct g5p_ru_slot_mem *m)
+{
+	for (u32 j = 0; j < 5; j++) {
+		u32 at = b->layout.offset[0x6d] + (index & 255) * 20 + j * 4;
+
+		m->rec[j] =
+			b->shared[at / G5P_GPU_PAGE].cpu + at % G5P_GPU_PAGE;
+	}
+	m->pa = g5p_boot_shared(b, 0x86) + slot * 8;
+	m->host = g5p_boot_shared(b, 0x84) + slot * 4;
+	m->cached = g5p_boot_shared(b, 0x85) + slot * 4;
+}
+
+/*
+ * Unbind `n` firmware slots in one RAM-only DC3 batch: PA and host tag of each to zero, one
+ * record {3, slot} per slot, one producer store, then the RAM-only wait of a bind and a check
+ * that the firmware's DC3 handler copied the zero tag of every slot.  No doorbell and no
+ * register access, so it is safe after a job retired and while the GPU may be idle-gated.
+ *
+ * The caller holds the core lock (the DC ring has one writer) and has retired every use of
+ * these slots: no job of theirs is queued on the firmware or in flight.  On success the
+ * firmware holds, per slot, PA 0, host and cached tag 0 and CBASE 0, with the slot's PC level
+ * invalidated; the slot may be bound again by a later DC3.  Its translations stay allocated:
+ * freeing them is the caller's step, after this returns 0.  A batch that is not consumed in
+ * time keeps later binds and unbinds refused until the firmware catches up (dc_pending).
+ */
+static int g5p_rv3_unbind_slots(struct g5p_drm *d, const u32 *slots, u32 n,
+				const char *why)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	struct g5p_ru_slot_sample s = {};
+	struct g5p_ru_slot_mem m;
+	u64 pub_ns, consumed_ns = 0;
+	u32 start, cons, target, bad = 0, verified = 0;
+	int ret;
+
+	lockdep_assert_held(&g->lock);
+	if (!g5p_ru_unbind_fits(n))
+		return -EINVAL;
+	for (u32 i = 0; i < n; i++)
+		if (slots[i] < G5P_RU_SLOT_MIN || slots[i] > G5P_RU_SLOT_MAX)
+			return -EINVAL;
+	dma_rmb();
+	start = READ_ONCE(ctl[4]);
+	cons = READ_ONCE(ctl[0]);
+	if (start > 255 || cons != start ||
+	    (rd->dc_pending && cons != rd->dc_wait)) {
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 unbind why=%s refused slots=%u dc=%u/%u pending=%u: ring busy; no "
+			"hardware touched end=v3\n",
+			why, n, cons, start, rd->dc_pending);
+		return -EBUSY;
+	}
+	rd->dc_pending = false;
+	for (u32 i = 0; i < n; i++) {
+		g5p_render_slot_mem(b, slots[i], start + i, &m);
+		g5p_ru_unbind_publish(&m, slots[i]);
+	}
+	target = (start + n) & 255;
+	dma_wmb();
+	pub_ns = ktime_get_ns();
+	smp_store_release(&ctl[4], target);
+	dma_wmb();
+	g5p_rv3_dc_kick(g, start, target, why);
+	ret = g5p_rv3_dc_wait(g, target, &consumed_ns);
+	if (ret == -ETIMEDOUT) {
+		rd->dc_pending = true;
+		rd->dc_wait = target;
+	}
+	dma_rmb();
+	for (u32 i = 0; i < n; i++) {
+		u32 one;
+
+		g5p_render_slot_mem(b, slots[i], start + i, &m);
+		g5p_ru_slot_read(&m, READ_ONCE(ctl[0]), READ_ONCE(ctl[4]), &s);
+		one = g5p_ru_unbind_check(&s, slots[i], target);
+		bad |= one;
+		verified += !one;
+	}
+	if (!ret && bad)
+		ret = -EUCLEAN;
+	dev_emerg(
+		g->dev,
+		"RENDER-V3 unbind why=%s slots=%u verified=%u ret=%d consumed_us=%lld "
+		"dc=%u->%u/%u bad=%#x first=%u last=%u mode=ram-dc3 end=v3\n",
+		why, n, verified, ret, g5p_rv3_us(pub_ns, consumed_ns), start,
+		s.cons, s.prod, bad, slots[0], slots[n - 1]);
+	return ret;
+}
+
+/*
+ * render_user_close_park: bind a closed context's just-unbound pair to the park catalogue, one
+ * DC3 pair as a context's bind (g5p_render_vm_prepare()), checked the same way.  The catalogue
+ * holds the firmware window's entry and the borrowed sink entry, both stable within an epoch, so
+ * rewriting them for a later park never clears what an earlier parked pair resolves through.
+ * Core lock held, between jobs (the close item), RAM only and no register: as the unbind.
+ */
+static int g5p_rv3_park(struct g5p_drm *d, struct g5p_render *r)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	struct g5p_ru_bind_sample s = {};
+	struct g5p_ru_bind_mem m;
+	u64 pub_ns, consumed_ns = 0;
+	u32 start, target, entry, sink, bad = 0;
+	int ret;
+
+	lockdep_assert_held(&g->lock);
+	if (!rd->park.cpu) {
+		ret = g5p_vm_alloc_page(d->drm.dev, &rd->park);
+		if (ret)
+			return ret;
+		memset(rd->park.cpu, 0, G5P_GPU_PAGE);
+	}
+	ret = g5p_render_fw_entry(d, r, &entry);
+	if (ret)
+		return ret;
+	dma_rmb();
+	start = READ_ONCE(ctl[4]);
+	g5p_render_bind_mem(b, r->slot, start, &m);
+	g5p_ru_bind_read(&m, READ_ONCE(ctl[0]), start, &s);
+	if (start > 255 || rd->dc_pending || g5p_ru_bind_busy(&s)) {
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 park refused slots=%u/%u dc=%u/%u pending=%u busy=%#x: the pair stays "
+			"unbound end=v3\n",
+			r->slot[0], r->slot[1], s.cons, start, rd->dc_pending,
+			g5p_ru_bind_busy(&s));
+		return -EBUSY;
+	}
+	sink = b->sink_ready ? g5p_le32(b->catalogue.cpu) : 0;
+	if (g5p_le32(rd->park.cpu + G5P_RU_FIRMWARE_CI * 4) != entry)
+		g5p_put32(rd->park.cpu + G5P_RU_FIRMWARE_CI * 4, entry);
+	if (g5p_le32(rd->park.cpu) != sink)
+		g5p_put32(rd->park.cpu, sink);
+	g5p_table_clean_page(g, &rd->park);
+	dsb(sy);
+	g5p_ru_bind_publish(&m, r->slot, rd->park.dma, G5P_RU_PARK_TAG);
+	target = (start + 2) & 255;
+	dma_wmb();
+	pub_ns = ktime_get_ns();
+	smp_store_release(&ctl[4], target);
+	dma_wmb();
+	g5p_rv3_dc_kick(g, start, target, "park");
+	ret = g5p_rv3_dc_wait(g, target, &consumed_ns);
+	if (ret == -ETIMEDOUT) {
+		rd->dc_pending = true;
+		rd->dc_wait = target;
+	}
+	dma_rmb();
+	g5p_render_bind_mem(b, r->slot, start, &m);
+	g5p_ru_bind_read(&m, READ_ONCE(ctl[0]), READ_ONCE(ctl[4]), &s);
+	if (!ret) {
+		bad = g5p_ru_bind_check(&s, r->slot, rd->park.dma,
+					G5P_RU_PARK_TAG, target);
+		ret = bad ? -EUCLEAN : 0;
+	}
+	rd->parks += !ret;
+	dev_emerg(
+		g->dev,
+		"RENDER-V3 park slots=%u/%u ret=%d consumed_us=%lld dc=%u->%u/%u bad=%#x "
+		"parks=%u pc=%pad end=v3\n",
+		r->slot[0], r->slot[1], ret, g5p_rv3_us(pub_ns, consumed_ns),
+		start, s.cons, s.prod, bad, rd->parks, &rd->park.dma);
+	return ret;
+}
+
+/* Drop what the claim of the device took (g5p_render_device_claim()); the device stays
+ * claimed for render.  Returns whether a context reference was dropped.
+ */
+static bool g5p_render_unclaim(struct g5p_drm *d, struct g5p_render *r)
+{
+	if (!r->claimant)
+		return false;
+	r->claimant = false;
+	if (d->quarantined_context == r->ctx)
+		d->quarantined_context = NULL;
+	return true;
+}
+
+/*
+ * The close item of a TYPED_V3 context (multi-client-design.md "Stage 2/3 as built"): the
+ * scheduler runs it after every job of the context, so every use of the pair has retired or
+ * failed.  RAM only: the unbind is g5p_rv3_unbind_slots() for this pair under the core lock.
+ * After a verified unbind the binding's references go, and the last one frees the VM tables,
+ * render targets and mappings (unpinning the BOs) and returns the slots
+ * (g5p_render_release()).  Anything the firmware may still hold is retained until reboot.
+ */
+/* perf60 (docs/gpu/experiments/perf60-clock.md), corrected by the release8 bench (bench-gaps3,
+ * render-user-pmset.h): the PM writes a previous PM context back (its free list F, through that
+ * context's TA slot) not once at the switch but on the later jobs of the next context, until a
+ * third context runs.  A closed context therefore keeps its slots bound and its set and pages alive
+ * while it is the last job's context or the previous distinct one; its unbind and release run once
+ * it is neither.  At most those two wait.  (The first version held only the last job's context and
+ * released it after one other job; 2 held one job longer, by job records: both released it while
+ * the PM still wrote to it.)  RAM only: bookkeeping and the close item's references.
+ */
+/* release8 default */
+
+/*
+ * A close item follows every job of this context on the ordered render worker.
+ * resident_gone, set under the file lock before queueing it, rejects all later
+ * VM_BIND and context creation. Thus the close item owns vm->maps exclusively.
+ *
+ * Idle VM_BIND UNMAP already drops a user mapping's pages after retirement.
+ * Do that here without releasing the PM's write-back route: no unbind, no
+ * table pruning, no PM set/pool/aux/RT release, no pm_last/pm_prev change. The
+ * PM free list is in the firmware window, never in vm->maps. All user mappings
+ * must pass the same range check as VM_BIND before any PTE is touched.
+ *
+ * No new kick of this detached context can occur. Clean the cleared user PTEs
+ * to PoC, but do not publish a tag, invalidate a slot or access R0. The PM can
+ * keep using its unchanged translations and pages, including cached ones.
+ * Failed/queued/terminal/shutdown epochs keep every BO, as before.
+ */
+static void g5p_render_close_trim(struct g5p_render *r)
+{
+	struct g5p_context *c = r->ctx;
+	struct g5p_drm *d = c->gpu;
+	struct g5p_diag *g = d->core;
+	struct g5p_vm *vm = c->vm;
+	struct g5p_boot *b;
+	struct g5p_ru_close_in in;
+	struct g5p_mapping *m, *tmp;
+	struct g5p_pt *pt;
+	u64 pinned;
+	u32 maps, why;
+
+	if (!vm->map_count || !vm->resident_gone || !r->closing ||
+	    !r->detached || !mutex_trylock(&g->lock))
+		return;
+	b = g->boot;
+	in = (struct g5p_ru_close_in){
+		.retained = r->retained,
+		.bound = r->bound,
+		/* Match close_run: a successfully drained lost job has no user-memory use left. */
+		.bad = READ_ONCE(c->bad) && !r->lost_drained,
+		.term_failed = g5p_ru_term_failed(&g5p_rv3_term),
+		.dev_failed = !b || READ_ONCE(b->failed),
+		.stopped = !b || READ_ONCE(b->stopped),
+		.shutdown = g5p_r8_admit_closed(&g5p_r8_state.admit),
+		.dc_pending = d->rdev->dc_pending,
+		.queued = atomic_read(&r->queued),
+	};
+	if (g5p_ru_close_plan(&in, &why) != G5P_RU_CLOSE_UNBIND)
+		goto out;
+	list_for_each_entry(m, &vm->maps, link)
+		if (!g5p_user_range_valid(m->node.start, m->node.size) ||
+		    (m->node.start < G5P_RU_PRIVATE_VA + G5P_RU_PRIVATE_SIZE &&
+		     G5P_RU_PRIVATE_VA < m->node.start + m->node.size))
+			goto out;
+
+	pinned = vm->pinned_bytes;
+	maps = vm->map_count;
+	list_for_each_entry(m, &vm->maps, link)
+		g5p_vm_clear(vm, d->drm.dev, m->node.start, m->node.size);
+	g5p_table_clean_page(g, &vm->root);
+	list_for_each_entry(pt, &vm->tables, link)
+		g5p_table_clean_page(g, &pt->page);
+	dsb(sy);
+	list_for_each_entry_safe(m, tmp, &vm->maps, link) {
+		vm->mapped_bytes -= m->node.size;
+		drm_mm_remove_node(&m->node);
+		list_del(&m->link);
+		vm->map_count--;
+		g5p_vm_obj_put(vm, m->obj);
+		drm_gem_object_put(m->obj);
+		kfree(m);
+	}
+	dev_info(
+		g->dev,
+		"RENDER-V3 close-trim slots=%u/%u maps=%u unpinned=%lluK remaining=%lluK "
+		"device_pinned=%lluK pm=retained end=v3\n",
+		r->slot[0], r->slot[1], maps, (pinned - vm->pinned_bytes) >> 10,
+		vm->pinned_bytes >> 10, READ_ONCE(d->pinned_bytes) >> 10);
+out:
+	mutex_unlock(&g->lock);
+}
+
+/* render_user_close_defer: may the firmware's PM still write this context's state back? */
+static bool g5p_render_pm_holds(struct g5p_rdev *rd, struct g5p_render *r,
+				u32 mode)
+{
+	return mode && g5p_pmset_holds(rd->pm_last, rd->pm_prev, r);
+}
+
+static void g5p_render_close_run(struct g5p_render *r)
+{
+	struct g5p_context *c = r->ctx;
+	struct g5p_drm *d = c->gpu;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	struct g5p_ru_close_in in;
+	unsigned long deadline = jiffies + 2 * HZ;
+	u32 puts = 0, why;
+	bool locked = false;
+	int plan, ret = 0;
+	u32 mode, k;
+
+	mode = (1);
+	k = d->rdev->close_deferred[0] ? 1 : 0;
+	if (mode && !r->close_defer_run && r->bound &&
+	    g5p_render_pm_holds(d->rdev, r, mode) &&
+	    k < ARRAY_SIZE(d->rdev->close_deferred)) {
+		g5p_render_close_trim(r);
+		/* the deferred close's own references, dropped by g5p_render_close_deferred() */
+		kref_get(&c->ref);
+		drm_dev_get(&d->drm);
+		d->rdev->close_deferred[k] = r;
+		dev_info(
+			g->dev,
+			"RENDER-V3 close-defer slots=%u/%u jobs=%u: the PM may still write its state "
+			"back; unbind once it has moved past it end=v3\n",
+			r->slot[0], r->slot[1], r->jobs);
+		dev_info(
+			g->dev,
+			"RENDER-V3 close-defer2 slots=%u/%u pm=%s pending=%u end=v3\n",
+			r->slot[0], r->slot[1],
+			d->rdev->pm_last == r ? "last" : "previous", k + 1);
+		return;
+	}
+
+	for (;;) {
+		in = (struct g5p_ru_close_in){
+			.retained = r->retained,
+			.bound = r->bound,
+			/* a lost job that drained left the firmware nothing of this context */
+			.bad = READ_ONCE(c->bad) && !r->lost_drained,
+			.term_failed = g5p_ru_term_failed(&g5p_rv3_term),
+			.dev_failed = !b || READ_ONCE(b->failed),
+			.stopped = !b || READ_ONCE(b->stopped),
+			.shutdown = g5p_r8_admit_closed(&g5p_r8_state.admit),
+			/* as g5p_rv3_unbind_slots() refuses it */
+			.dc_pending = b && d->rdev->dc_pending &&
+				      READ_ONCE(((u32 *)g5p_boot_shared(
+					      b, 0x6c))[0]) != d->rdev->dc_wait,
+			.queued = atomic_read(&r->queued),
+		};
+		plan = g5p_ru_close_plan(&in, &why);
+		if (plan != G5P_RU_CLOSE_UNBIND || locked)
+			break;
+		/* Bounded, as a job takes it: never wait forever behind a command in MMIO. */
+		while (!(locked = mutex_trylock(&g->lock)) &&
+		       time_before(jiffies, deadline))
+			msleep(5);
+		if (!locked) {
+			plan = G5P_RU_CLOSE_RETAIN;
+			why = G5P_RU_CLOSE_LOCK;
+			break;
+		}
+		/* Plan again under the lock: the reboot quiesce or a failure may have run. */
+	}
+	if (plan == G5P_RU_CLOSE_UNBIND) {
+		ret = g5p_rv3_unbind_slots(d, r->slot, 2, "close");
+		if (!ret) {
+			r->bound = false;
+			r->retained = false;
+			WRITE_ONCE(c->live, false);
+			puts++;
+			/* the PM may still write this context's free list back through its TA slot */
+			{
+				g5p_rv3_park(d, r);
+			};
+		}
+	}
+	if (plan == G5P_RU_CLOSE_RELEASE ||
+	    (plan == G5P_RU_CLOSE_UNBIND && !ret))
+		puts += g5p_render_unclaim(d, r);
+	if (locked)
+		mutex_unlock(&g->lock);
+	dev_info(
+		g->dev,
+		"RENDER-V3 close slots=%u/%u plan=%s why=%#x ret=%d jobs=%u claimant=%u "
+		"retained=%u end=v3\n",
+		r->slot[0], r->slot[1], g5p_ru_close_name(plan), why, ret,
+		r->jobs, r->claimant, r->retained);
+	while (puts--) {
+		g5p_context_put(c);
+		drm_dev_put(&d->drm);
+	}
+}
+
+/* After a job: a deferred close runs once the last job was another context's. */
+static void g5p_render_close_deferred(struct g5p_drm *d)
+{
+	struct g5p_rdev *rd = d->rdev;
+	u32 mode = (1);
+
+	for (u32 k = 0; k < ARRAY_SIZE(rd->close_deferred); k++) {
+		struct g5p_render *r = rd->close_deferred[k];
+		struct g5p_context *c;
+
+		/* mode 0 now: a pending close still waits until the PM has moved past it */
+		if (!r || g5p_render_pm_holds(rd, r, mode ?: 1))
+			continue;
+		rd->close_deferred[k] = NULL;
+		c = r->ctx;
+		r->close_defer_run = true;
+		dev_info(
+			d->core->dev,
+			"RENDER-V3 close-deferred slots=%u/%u: neither the PM's last nor its previous "
+			"context end=v3\n",
+			r->slot[0], r->slot[1]);
+		g5p_render_close_run(r);
+		g5p_context_put(c);
+		drm_dev_put(&d->drm);
+	}
+	/* keep a pending close in [0]: close_run fills [1] only behind it */
+	if (!rd->close_deferred[0] && rd->close_deferred[1]) {
+		rd->close_deferred[0] = rd->close_deferred[1];
+		rd->close_deferred[1] = NULL;
+	}
+}
+
+/*
+ * The handle of a TYPED_V3 context is gone (DESTROY_CONTEXT, or its file closed): stop VM and
+ * render-target edits and queue the close item behind the context's jobs (g5p_rsched_close()).
+ * File lock held, or the file is closing.  A context that never submitted is released by its
+ * last reference.
+ */
+static void g5p_render_close(struct g5p_context *c)
+{
+	struct g5p_render *r = c->render;
+
+	if (!r->v3_accepted || r->closing)
+		return;
+	r->closing = true;
+	r->detached = true;
+	c->vm->resident_gone = true;
+	/* The close item's references, dropped by the scheduler once it ran. */
+	kref_get(&c->ref);
+	drm_dev_get(&c->gpu->drm);
+	if (!g5p_rsched_close(c->gpu, r)) {
+		g5p_context_put(c);
+		drm_dev_put(&c->gpu->drm);
+	}
+}
+
+/* Reboot quiesce, RAM only and lock free: the TYPED_V3 latch and whether its executor runs.
+ * The executor is RAM-only once the latch is quiet, unless the wake110 experiment (doorbells
+ * after retirement, off in every desktop tuple) is configured.  Called after admission closed;
+ * the scheduler is kicked so that jobs waiting on an input fail now, not at their deadline.
+ */
+static void g5p_kq_drm_state(void *cookie, struct g5p_ru_kq_in *in)
+{
+	struct g5p_drm *d = cookie;
+
+	/* Admission is closed by now: queued jobs blocked on an input fail at once. */
+	g5p_rsched_kick(d);
+
+	/* A channel blocked behind a lost job is a wedged epoch for the quiesce. */
+	in->term_failed = g5p_ru_term_failed(&g5p_rv3_term) ||
+			  READ_ONCE(d->rdev->stuck) ||
+			  READ_ONCE(d->rdev->recovering);
+	in->ram_only = READ_ONCE(d->rdev->v3) &&
+		       !g5p_ru_mmio_ok(&g5p_rv3_term) && !(2);
+	in->executing = READ_ONCE(d->rdev->executing);
+}
+
+/* Reboot quiesce, core lock held: every held user slot, the first claimant's pair included.
+ * Nothing is freed and no context changes state: admission is closed and the boot state is
+ * frozen right after, so no job runs again on this boot.
+ */
+static int g5p_kq_drm_detach(void *cookie, const u32 *slots, u32 n)
+{
+	return g5p_rv3_unbind_slots(cookie, slots, n, "kexec");
+}
+
+static const struct g5p_kq_frontend g5p_kq_drm = {
+	.state = g5p_kq_drm_state,
+	.detach = g5p_kq_drm_detach,
+};
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-v3.h b/drivers/gpu/drm/apple-g5p/drm-render-v3.h
new file mode 100644
index 0000000000..ac4dd841e3
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-render-v3.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* TYPED_V3 serial executor: per-job state (receipt data). Types only; code: drm-render-v3.inc. */
+#ifndef G5P_DRM_RENDER_V3_H
+#define G5P_DRM_RENDER_V3_H
+
+enum g5p_rv3_phase {
+	G5P_RV3_IDLE,
+	G5P_RV3_ATTACH,
+	G5P_RV3_BIND,
+	G5P_RV3_TA_PUBLISH,
+	G5P_RV3_TA_WAIT,
+	G5P_RV3_TD_PUBLISH,
+	G5P_RV3_TD_WAIT,
+	G5P_RV3_DONE,
+	G5P_RV3_PHASES,
+};
+
+/* g5p_drm.td_want: the 3D completion-event latch is armed for the endpoint in the low byte. */
+#define G5P_RV3_TD_WANT 0x100U
+
+/* One RAM sample of one engine: ring, stamps, channel watermarks, idle words, PM state, and
+ * (3D) whether the matching completion event has been latched.
+ */
+struct g5p_rv3_ev {
+	u64 ns;
+	u32 prod, cons, stamp[2], ctl[5], idle[6], pm80;
+	bool proto, failed, consumed, retired, idle_ok, pm_ok, event;
+};
+
+struct g5p_rv3 {
+	struct g5p_ru_wait ta, td;
+	struct g5p_ru_touch
+		touch[2]; /* RC4a A/B (render-user-touch.h); zero when off */
+	struct g5p_ru_retire rt; /* the 3D predicate (render-user-retire.h) */
+	struct g5p_ru_ta tr; /* the TA predicate (render-user-retire.h) */
+	struct g5p_rv3_ev last[2];
+	u64 td_event_ns; /* decode time of the matching 3D event; 0 = none */
+	u64 ta_event_ns; /* decode time of the first TA event since the publish */
+	u64 attach_ns, job_deadline_ns, ta_pub_ns, td_pub_ns, ta_consumed_ns,
+		td_consumed_ns;
+	u32 phase, grace_end, bell;
+	u32 seq; /* the device sequence this job got; 0 = none */
+	/* wake110 (render-user-wake.h), per engine: the decision, the power evidence word it saw
+	 * (wake111), the two register words it read (U32_MAX = not read), the consumer it saw, the
+	 * type-1 event counts at the phase's arm and at the job's end, the lock window and the
+	 * first type-1 decode time.  Zero when off.
+	 */
+	u32 wk_did[2], wk_power[2], wk_fence[2], wk_gpc[2], wk_cons[2],
+		wk_t1_pub[2], wk_t1_end[2];
+	u64 wk_start_ns[2], wk_done_ns[2], wk_first_ns[2];
+	bool touched; /* the DC3 pair was published: the firmware may reference the job's memory */
+	/* The bind of this job's context published its DC3 pair and then failed: that context is
+	 * lost, the device and the contexts already bound are not.
+	 */
+	bool bind_failed;
+	/* The job was lost alone (render-user-loss.h): its context is dead, the device is not; the
+	 * channel stays blocked behind its stuck phase until the scheduler's drain clears it.
+	 */
+	bool lost;
+};
+
+#endif
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-v3.inc b/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
new file mode 100644
index 0000000000..f6080f49a3
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
@@ -0,0 +1,3033 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * TYPED_V3 serial executor: the control flow that completed the natural TA and the
+ * natural 3D in r96 (docs/gpu/experiments/production-typed-render-kernel.md), on typed
+ * state.  Included from drm-render.inc after g5p_render_execute().
+ *
+ * What it does, in order, for each job a V3 context runs (strictly serial across every context,
+ * render-user-serial.h; only the epoch's job 1 attaches and has hardware evidence):
+ *   0. bind, the first job of every later context (multi-client-design.md §4.2): its own DC3
+ *      pair, published in RAM only, no doorbell, a RAM-only wait for the firmware to consume
+ *      it.  With the TEMPORARY render_user_spare_pairs instead: a pair job 1 pre-bound, taken
+ *      over through the tag path.
+ *   1. attach (job 1): the typed preparation (PM, channels, catalogue entries), then the
+ *      DC3 pair is published and its doorbell is owned by the r74f machinery (r87b
+ *      self-drain: a closed gate is never repaired by the host).  The firmware installs
+ *      the page-table root and the generation tags itself (r74g); the host does NO MMU pass
+ *      and checks the result in RAM only.
+ *   2. TA: record, WORK_CTL and producer, no doorbell; the r74g grace (four ALIVEs or
+ *      20 ms) lets the firmware drain it, and only if it is still pending afterwards the
+ *      first ALIVE decoded owns one fenced fallback doorbell.
+ *   3. TA wait: RAM only (drain, sample, sleep), 20 s per phase by default, 30 s for the
+ *      whole job (render-user-wait.h decides the deadline and closes the race with a
+ *      completion).  tahang1: complete on a coherent target with the PM saved and either
+ *      the idle words clear, the TA completion event, or a 500 ms coherent hold
+ *      (render-user-retire.h); a phase pending 1 s prints one RAM-only `slow` line.  From
+ *      the TA complete on, and after any timeout or fault, the host touches no register.
+ *   4. 3D: record, WORK_CTL and producer, NO doorbell (r96 stage 1: the firmware consumed
+ *      it 2 ms later), RAM-only wait as above.
+ *   RC4a (render_user_touch_ms, default 0 = off): at publish + T of each phase, odd jobs read
+ *   the receipt pages once and even jobs only record the instant (render-user-touch.h); RAM only.
+ *   repeat109: the 3D phase is also complete when its target state is coherent and its completion
+ *   event arrived, even if the engine idle words never clear (render-user-retire.h; the latched
+ *   render_user_idle_settle_ms, default 0, adds a minimum coherent run); one `RENDER-V3 retire`
+ *   receipt line splits the firmware's retirement from the host's decision.  RAM only.
+ *   wake110 (render_user_wake, default 0 = off): right after the producer store of every phase but
+ *   job 1's TA, the A/B's factor phases run Apple's submit kick (R1+0x14 = 7, GPC active, R0+0xb00 =
+ *   0x10 / 0x11) and its control phases the same guards without a register (render-user-wake.h);
+ *   one `RENDER-V3 wake` line per job.  The only register access after the TA complete, licensed
+ *   while no timeout or fault was noted.
+ * Jobs >= 2 (a compositor's next frame, or another context's): no attach, the PM pool is
+ * rebuilt, and both rings are published with no doorbell at all.
+ * Not in this path on purpose: the r74h / r80 / r85-r96 root-cause instrumentation (stream
+ * markers, PM canary, plateau and end banks, region/target dumps), host MMU passes, cache
+ * maintenance MMIO, selector reads, snapshots (they read R0), and any recovery.  A timeout
+ * or fault retains everything; the context is frozen and kept until reboot.
+ *
+ * Terminal state (render-user-terminal.h): the TA complete, a timeout and a fault go through one
+ * first-writer-wins latch, g5p_rv3_terminal().  From then on g5p_ru_mmio_ok() is false, the admission
+ * refuses every job that would start behind a failure (-EIO), and the legacy typed paths that read or
+ * write registers (snapshot, invalidate, run, destroy) refuse.  g5p_rv3_td_hook() is the optional
+ * recovery bridge (terminal note and the observation-only CAPTURE entry); it is nothing without it.
+ */
+
+static const char *const g5p_rv3_phase_names[G5P_RV3_PHASES] = {
+	"idle",	   "attach",	 "bind",    "ta-publish",
+	"ta-wait", "3d-publish", "3d-wait", "done",
+};
+static const char *const g5p_rv3_results[] = { "pending", "complete", "timeout",
+					       "fault" };
+static const char *const g5p_rv3_how[] = { "none", "idle-clear", "idle-stuck",
+					   "hold" };
+
+#include "drm-latency123.inc"
+
+/* perf60 stage 4 (render-user-pmset.h): per-context PM records, the iOS model (one ParamBuffer
+ * per work queue, 6cb9afc/6cb2378).  Latched at the epoch's first attach, with boot_pm_sets:
+ *   1  every context bound after the epoch's first gets its own PM set (control + S, list, F in
+ *      the firmware GiB), its own pool pages and its own aux pages at G5P_RU_PRIVATE_VA in its
+ *      VM; the epoch's first context keeps the device PM.  PM ID 0 everywhere.
+ *   2  as 1, and set s carries PM ID s + 1 (TA W+0x10, TA start, 3D start, tag6).
+ * RAM only, by the executor between jobs.
+ */
+/* release8 default */
+
+/* The PM a context's jobs use: its set, or the device PM. */
+static u8 *g5p_rv3_pm_cpu(struct g5p_boot *b, const struct g5p_render *r)
+{
+	if (r->pm_set >= 0)
+		return b->pm_set[r->pm_set * G5P_PMSET_PAGES + G5P_PMSET_CONTROL]
+			.cpu;
+	return g5p_ru_pm_cpu(b);
+}
+
+static u32 g5p_rv3_pm_meta(const struct g5p_render *r)
+{
+	return g5p_meta_address(
+		r->pm_set >= 0 ? g5p_pmset_va(r->pm_set, G5P_PMSET_CONTROL) :
+				 G5P_SHARED_VA + G5P_R22_PM);
+}
+
+static u32 g5p_rv3_pm_id(const struct g5p_rdev *rd, const struct g5p_render *r)
+{
+	return rd->pm_ctx >= 2 && r->pm_set >= 0 ? g5p_pmset_id(r->pm_set) : 0;
+}
+
+static struct g5p_dma_page *g5p_rv3_pm_aux(struct g5p_rdev *rd,
+					   struct g5p_render *r)
+{
+	return r->pm_aux_mapped ? r->pm_aux : rd->aux;
+}
+
+/* The boot tuple the V3 path is proven under (r96 params.txt), minus the instrumentation:
+ * r73b/r73c/r73e/r73f, r74 with the raised IRQ cap, r74f, r74g, r87b self-drain; no r74h,
+ * no r80..r96 (their IRQ banks read registers), no r75/r79 firmware control, and no fixed
+ * render engine (it is exclusive with the DRM one).
+ */
+static bool g5p_rv3_tuple(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g ? g->boot : NULL;
+	struct g5p_r73b *x = b ? b->r73b : NULL;
+
+	return x && g5p_r74g_on(b) && g5p_r74b_ram_only(g) &&
+	       x->r87b_attach == G5P_R87B_ATTACH_SELF_DRAIN;
+}
+
+/* The admission state of a context and the device, as plain values for g5p_ru_v3_admit(). */
+static struct g5p_ru_v3_state g5p_rv3_state(struct g5p_diag *g,
+					    struct g5p_render *r)
+{
+	const struct g5p_rdev *rd = r->ctx->gpu->rdev;
+
+	return (struct g5p_ru_v3_state){
+		.tuple = g5p_rv3_tuple(g),
+		.v3_accepted = r->v3_accepted,
+		.bound = r->bound,
+		.jobs = r->jobs,
+		.device_up = READ_ONCE(rd->up),
+		.device_v3 = READ_ONCE(rd->v3),
+		.sequence = READ_ONCE(rd->sequence),
+		.slot_ta = r->slot[0],
+		.slot_3d = r->slot[1],
+		.variant = 0 || r->after_ta || 0 || r->v.pm || r->v.memory ||
+			   r->v.rt || r->v.slots,
+		.wait_ms = r->wait_ms,
+		.quiet = !g5p_ru_mmio_ok(&g5p_rv3_term),
+		.terminal_failed = g5p_ru_term_failed(&g5p_rv3_term),
+	};
+}
+
+/* A terminal epoch is a device state (-EIO), the others are about this request. */
+static int g5p_rv3_refusal_errno(int why)
+{
+	if (why == G5P_RU_V3_TERMINAL)
+		return -EIO;
+	return why == G5P_RU_V3_OVERFLOW ? -EOVERFLOW : -EOPNOTSUPP;
+}
+
+/* Submit-time admission: every V3 job refused here has touched nothing. */
+static int g5p_rv3_admit_submit(struct g5p_drm *d, struct g5p_render *r)
+{
+	struct g5p_diag *g = d->core;
+	struct g5p_ru_v3_state st;
+	int why;
+
+	/* The epoch is being replaced: the executor admits the job again under the lock. */
+	if (READ_ONCE(d->rdev->recovering))
+		return 0;
+	st = g5p_rv3_state(g, r);
+	why = g5p_ru_v3_admit(&st, false);
+
+	if (!why)
+		return 0;
+	/* per submit while admission is closed and a client retries: ratelimited */
+	dev_info_ratelimited(
+		g->dev, "RENDER-V3 refused: %s; no hardware touched end=v3\n",
+		g5p_ru_v3_why[why]);
+	return g5p_rv3_refusal_errno(why);
+}
+
+/* Recovery hooks (patches/gpu-recovery), compiled only when that series is applied: core.inc then includes
+ * teardown.inc before this file, and teardown.h defines G5P_TEARDOWN_H.  The CAPTURE entry is observation only
+ * (RAM reads, no register access) and runs only with the recovery module parameter set, once per epoch, on a
+ * timeout or fault.  Without the series both are nothing, and the prod98 kernel does not depend on it.
+ */
+#ifdef G5P_TEARDOWN_H
+static void g5p_rv3_td_hook(struct g5p_diag *g, int kind, const char *why)
+{
+	g5p_td_note_terminal(&g5p_td_state, g5p_ru_td_kind(kind));
+	if ((0) && g5p_ru_term_capture_due(&g5p_rv3_term, kind))
+		g5p_td_capture(g, why);
+}
+#else
+static inline void g5p_rv3_td_hook(struct g5p_diag *g, int kind,
+				   const char *why)
+{
+}
+#endif
+
+/* The terminal state of the epoch: the TA complete, and any timeout or fault.  First writer wins; from the first
+ * note on g5p_ru_mmio_ok() is false and the host touches no register (R0, R1, AIC, doorbell) and no bank.  The r80
+ * flag is set when an r80 block exists, so that a bank that might be latched cannot run behind this path (the V3
+ * tuple forbids r80, so there is none today); the latch above does not depend on it.
+ */
+static void g5p_rv3_terminal(struct g5p_diag *g, int kind, const char *why)
+{
+	bool failed = g5p_ru_term_failed(&g5p_rv3_term);
+
+	if (g5p_ru_term_note(&g5p_rv3_term, kind))
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 terminal kind=%s why=%s mmio=off r0=off export=ram-only end=v3\n",
+			g5p_ru_term_names[g5p_ru_term_kind(&g5p_rv3_term)],
+			why);
+	else if (!failed && g5p_ru_term_failed(&g5p_rv3_term))
+		/* The epoch's TA complete took the latch long ago (job 1): a later timeout or fault
+		 * only makes it sticky-failed, which closes admission for every client.  Say so once.
+		 */
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 terminal kind=%s why=%s latched=%s failed=1 admission=closed end=v3\n",
+			g5p_ru_term_names
+				[kind > G5P_RU_TERM_NONE &&
+						 kind < G5P_RU_TERM_KINDS ?
+					 kind :
+					 G5P_RU_TERM_FAULT],
+			why,
+			g5p_ru_term_names[g5p_ru_term_kind(&g5p_rv3_term)]);
+	g5p_rv3_td_hook(g, kind, why);
+}
+
+/* "Retained boundary" of the r74f machinery -> the errno a job reports.  -EINPROGRESS is
+ * never a job error (the UAPI uses it for "pending").
+ */
+static int g5p_rv3_errno(struct g5p_diag *g, int ret)
+{
+	if (ret != -EINPROGRESS)
+		return ret;
+	switch (READ_ONCE(g->boot->r73b->r74f_stop)) {
+	case G5P_R74F_STOP_ATTACH_NOT_KICKED:
+	case G5P_R74F_STOP_ATTACH_NOT_CONSUMED:
+	case G5P_R74F_STOP_TA_NOT_KICKED:
+	case G5P_R74G_STOP_TA_NOT_CONSUMED:
+	case G5P_R74G_STOP_TA_WINDOW_MISSED:
+		return -ETIMEDOUT;
+	default:
+		return -EIO;
+	}
+}
+
+/*
+ * Interim: on iOS the firmware writes back its own lines with the cache maintenance it runs on
+ * every tick (meta+0x6d4); that needs init words still being recovered (latency123.md), and
+ * this read stands in for it until then.
+ *
+ * While a phase is in flight the firmware does not see its own progress in the root and
+ * shared pages until a coherent read of those lines reaches the fabric: without one, the TA
+ * and 3D stages wait for the firmware tick, for seconds (latency123: key to frame 7.9 s
+ * median; with a Normal-NC read of both regions every 1-2 ms, 0.27 s).  One 32-bit load per
+ * 64-byte line, before every RAM sample of an in-flight phase.  RAM only, and an idle GPU
+ * has no sampler, so it costs nothing then.
+ */
+static void g5p_rv3_fw_touch(struct g5p_boot *b)
+{
+	struct g5p_dma_page *const regions[] = { b->root, b->shared };
+	u32 counts[] = { ARRAY_SIZE(b->root), ARRAY_SIZE(b->shared) };
+
+	for (u32 r = 0; r < ARRAY_SIZE(regions); r++)
+		for (u32 i = 0; i < counts[r]; i++)
+			for (u32 at = 0; at < G5P_GPU_PAGE; at += 64)
+				(void)READ_ONCE(
+					*(const u32 *)(regions[r][i].cpu + at));
+	/* perf60 stage 4: the per-context PM sets are firmware pages like the shared ones */
+	for (u32 i = 0; i < b->pm_sets * G5P_PMSET_PAGES; i++)
+		for (u32 at = 0; at < G5P_GPU_PAGE; at += 64)
+			(void)READ_ONCE(*(const u32 *)(b->pm_set[i].cpu + at));
+}
+
+/* perf60 bell gates, A/B knobs for the multi-context 3D fault on the bell path (render_user_wake=2 only;
+ * 0600, read at every bell, all 0 = no gate).  They run between a phase's producer store and its bell;
+ * in policy state 0 the firmware does not drain a ring on its own, so a gate holds the phase back.
+ * RAM reads, sleeps and barriers only; no register access.
+ *   bell_gap_us      (a) the TA bell waits until this long after the previous job (any context) ended
+ *   bell_idle_ms     (a) the TA bell first waits, up to this, for the 3D engine idle words to read zero
+ *   bell_3d_delay_us (c) mb() and this delay between the 3D producer store and the 3D bell
+ *   bell_ctx_gap_us  (d) mb() and this delay before the TA bell of a job of another context than the last
+ *   bell_touch       (c) the Normal-NC read of the firmware pages (g5p_rv3_fw_touch) right before each bell
+ */
+
+/* perf60 job-start gate: the same waits before the job's own host writes (the PM pool rebuild and
+ * the shared TA/3D work records, g5p_rv3_pm_rebuild() and g5p_ru_job()), which happen before any
+ * publish.  The bell gates above run after them, so they cannot separate "the host rewrites shared
+ * firmware pages while the firmware still finishes the previous job" from a doorbell race.
+ *   job_gap_us   the job's first host write no sooner than this after the previous job ended
+ *   job_idle_ms  then wait up to this (RAM) for the TA and 3D engine idle words to read zero
+ */
+/* perf60 layout (latched at the epoch's first attach, default 0 = the r22 layout):
+ *   render_user_job_slots 2: job seq writes its command, W record and microsequence into slot
+ *       (seq - 1) % 2 of the channel page, so a job never rewrites the record the firmware used for
+ *       the job before it; the pointer ring carries each job's addresses (render-user-layout.h).
+ *   render_user_pm_once 1: the PM pool, list and F are built by the epoch's first attach only and
+ *       never rewritten by the host between jobs; the TA's tag6 record has the firmware rebuild F,
+ *       as on iOS (PM created per queue once; docs/gpu/experiments/freelist-lifetime-production-fix.md).
+ */
+/* release8 default */
+/* release8 default */
+
+/* The record slot of job seq on this epoch's layout. */
+static u32 g5p_rv3_js(const struct g5p_rdev *rd, u32 seq)
+{
+	return rd->job_slots == 2 ? (seq - 1) & 1 : 0;
+}
+
+
+
+
+
+
+
+
+
+/* RAM only. */
+static void g5p_rv3_sample(struct g5p_diag *g, struct g5p_render *r, u32 e,
+			   u32 seq, struct g5p_rv3_ev *s)
+{
+	struct g5p_boot *b = g->boot;
+	u8 *p = g5p_ru_page(b, e), *global = g5p_ru_global(b, e),
+	   *pm = g5p_rv3_pm_cpu(b, r);
+	u32 *ring = (u32 *)g5p_boot_shared(b, e ? 0x64 : 0x60);
+
+	g5p_rv3_fw_touch(b);
+	memset(s, 0, sizeof(*s));
+	dma_rmb();
+	s->ns = ktime_get_ns();
+	s->prod = READ_ONCE(ring[4]);
+	s->cons = READ_ONCE(ring[0]);
+	for (u32 i = 0; i < ARRAY_SIZE(s->stamp); i++)
+		s->stamp[i] = g5p_le32(p + G5P_R22_STAMP + 4 * i);
+	for (u32 i = 0; i < ARRAY_SIZE(s->ctl); i++)
+		s->ctl[i] = g5p_le32(p + G5P_WORK_CTL + i * 0x10);
+	for (u32 i = 0; i < ARRAY_SIZE(s->idle); i++)
+		s->idle[i] = g5p_le32(global + 0x724 + i * 4);
+	s->pm80 = g5p_le32(pm + 0x80);
+	s->failed = READ_ONCE(b->failed) || READ_ONCE(b->event_failed);
+	s->proto = s->prod != r->target[e] || s->cons > 255 ||
+		   !g5p_ru_stamp_sane(p, seq);
+	s->consumed = s->cons == r->target[e];
+	/* The predicates of the flown r74b (TA) and r96 (3D) waits; the 3D's PM serial is a receipt. */
+	s->idle_ok = !s->idle[0] && !s->idle[1] && !s->idle[2] &&
+		     (!e || (!s->idle[4] && !s->idle[5]));
+	s->retired = g5p_ru_retired_at(p, g5p_ru_meta(e), e, seq,
+				       g5p_rv3_js(r->ctx->gpu->rdev, seq));
+	s->pm_ok = e ? s->pm80 == r->ctx->gpu->rdev->pm_serial + 1 :
+		       g5p_r22_pm_saved(pm + 0x80);
+	s->event = !!(e ? READ_ONCE(r->ctx->gpu->td_hit_ns) :
+			  READ_ONCE(r->ctx->gpu->ta_hit_ns));
+}
+
+/* TA: one step of render-user-retire.h's TA rules when ta is given, else the flown r74b
+ * predicate.  3D: one step of its 3D rules when rt is given, else the r96 predicate.
+ */
+static bool g5p_rv3_done(u32 e, const struct g5p_rv3_ev *s,
+			 struct g5p_ru_retire *rt, struct g5p_ru_ta *ta)
+{
+	if (e && rt)
+		return g5p_ru_rt_step(rt, s->ns, s->consumed, s->retired,
+				      s->idle_ok,
+				      s->event) != G5P_RU_RT_PENDING;
+	if (!e && ta)
+		return g5p_ru_ta_step(ta, s->ns, s->consumed, s->retired,
+				      s->pm_ok, s->idle_ok,
+				      s->event) != G5P_RU_TA_PENDING;
+	return s->consumed && s->idle_ok && s->retired && (e || s->pm_ok);
+}
+
+/* The TA clauses in the bits of render-user-retire.h, for the receipt. */
+static u32 g5p_rv3_ta_unsat(const struct g5p_rv3_ev *s)
+{
+	return (s->consumed ? 0 : G5P_RU_RT_CONSUMED) |
+	       (s->retired ? 0 : G5P_RU_RT_RETIRED) |
+	       (s->idle_ok ? 0 : G5P_RU_RT_IDLE) |
+	       (s->pm_ok ? 0 : G5P_RU_RT_PM);
+}
+
+/* Arm engine e's completion-event latch of g5p_drm_event() (3D: for this job's endpoint), before
+ * the phase's producer store, so an event decoded right after the publish is not missed.  The
+ * latch is set under status_lock by whichever CPU decodes the event, and the wait samples it
+ * level-triggered every 1-2 ms, so there is no wakeup to lose.  RAM only.
+ */
+static void g5p_rv3_event_arm(struct g5p_drm *d, u32 e, u32 endpoint)
+{
+	unsigned long flags;
+
+	BUILD_BUG_ON(G5P_RU_RT_GRID != G5P_WORK_SLOTS);
+	spin_lock_irqsave(&d->status_lock, flags);
+	if (e) {
+		d->td_want = G5P_RV3_TD_WANT | endpoint;
+		WRITE_ONCE(d->td_hit_ns, 0);
+	} else {
+		d->ta_want = true;
+		WRITE_ONCE(d->ta_hit_ns, 0);
+	}
+	spin_unlock_irqrestore(&d->status_lock, flags);
+}
+
+/* Disarm engine e's latch and return the decode time of the matching event (0 = none). */
+static u64 g5p_rv3_event_disarm(struct g5p_drm *d, u32 e)
+{
+	unsigned long flags;
+	u64 hit;
+
+	spin_lock_irqsave(&d->status_lock, flags);
+	if (e) {
+		d->td_want = 0;
+		hit = d->td_hit_ns;
+	} else {
+		d->ta_want = false;
+		hit = d->ta_hit_ns;
+	}
+	spin_unlock_irqrestore(&d->status_lock, flags);
+	return hit;
+}
+
+/* RC4a: the receipt's read set (g5p_rv3_receipt()'s blobs: PM-control, then W, channels and the
+ * stamp window of the TA and of the 3D page), read once with 32-bit loads, the access size of the
+ * receipt's hex dump.  The words are folded, not copied: no allocation, no store to shared memory.
+ * RAM only: no register, no doorbell, no print, no latch.
+ */
+static u32 g5p_rv3_touch_sweep(struct g5p_boot *b, u32 *bytes)
+{
+	u8 *ta = g5p_ru_page(b, 0), *td = g5p_ru_page(b, 1);
+	const u8 *const src[] = {
+		g5p_ru_pm_cpu(b), ta + G5P_R22_W, ta,
+		ta + G5P_R22_TQ,  td + G5P_R22_W, td,
+		td + G5P_R22_TQ,
+	};
+	static const u32 len[] = {
+		0x140, G5P_RU_TA_W_BYTES, 0x340, 0x80, G5P_RU_3D_W_BYTES, 0x340,
+		0x80,
+	};
+	u32 sum = 0, n = 0;
+
+	dma_rmb();
+	for (u32 i = 0; i < ARRAY_SIZE(src); i++) {
+		for (u32 at = 0; at < len[i]; at += 4)
+			sum = (sum << 5 | sum >> 27) ^
+			      READ_ONCE(*(const u32 *)(src[i] + at));
+		n += len[i];
+	}
+	*bytes = n;
+	return sum;
+}
+
+/* RC4a: the instant of one phase, taken at the sample at now_ns.  The touch arm reads, the control
+ * arm only records; both record the same instant.
+ */
+static void g5p_rv3_touch(struct g5p_diag *g, struct g5p_ru_touch *t,
+			  u64 now_ns)
+{
+	u32 bytes = 0, sum = 0;
+
+	if (t->sweep)
+		sum = g5p_rv3_touch_sweep(g->boot, &bytes);
+	g5p_ru_touch_mark(t, now_ns, t->sweep ? ktime_get_ns() : now_ns, bytes,
+			  sum);
+}
+
+/* tahang1: a phase still pending this long after its publish prints its RAM state once. */
+#define G5P_RV3_SLOW_MS 1000U
+
+/* The one `slow` line of a phase: the deciding sample's RAM words and the waiter's own state, so
+ * a stall that later times out is described from the first second on.  RAM only.
+ */
+static void g5p_rv3_slow(struct g5p_diag *g, u32 e, u32 seq,
+			 const struct g5p_ru_wait *w,
+			 const struct g5p_rv3_ev *s, u32 unsat, u64 hit_ns)
+{
+	dev_warn(
+		g->dev,
+		"RENDER-V3 slow seq=%u engine=%u ms=%lld ring=%u/%u stamp=%08x/%08x "
+		"ctl=%08x,%08x,%08x,%08x,%08x idle=%08x,%08x,%08x,%08x,%08x,%08x pm80=%08x "
+		"consumed=%u retired=%u pm=%u event_ms=%lld unsat=%#x busy_ms=%lld events=%u "
+		"end=v3\n",
+		seq, e, g5p_ru_rt_ms(w->start_ns, s->ns), s->prod, s->cons,
+		s->stamp[0], s->stamp[1], s->ctl[0], s->ctl[1], s->ctl[2],
+		s->ctl[3], s->ctl[4], s->idle[0], s->idle[1], s->idle[2],
+		s->idle[3], s->idle[4], s->idle[5], s->pm80, s->consumed,
+		s->retired, s->pm_ok, g5p_ru_rt_ms(w->start_ns, hit_ns), unsat,
+		g5p_ru_rt_ms(w->start_ns, w->busy_ns),
+		READ_ONCE(g->boot->events));
+	g5p_np_policy(g, "slow", seq, e);
+}
+
+/* nopatch: the policy record at a few phase ends (log-spaced) and at every timeout.  RAM only. */
+static void g5p_rv3_np_end(struct g5p_diag *g, u32 e, u32 seq, u32 result)
+{
+	if (seq == 1 || seq == 10 || seq == 100 || seq == 1000 ||
+	    seq == 10000 || result == G5P_RU_WAIT_TIMEOUT)
+		g5p_np_policy(g,
+			      result == G5P_RU_WAIT_TIMEOUT ? "phase-timeout" :
+							      "phase-end",
+			      seq, e);
+}
+
+/* One phase's RAM-only wait.  g5p_ru_wait_step()/close() decide; this loop only samples.  RC4a: the
+ * touch instant is taken after a step that left the phase undecided, before the sleep (off: never).
+ * The predicate is level-triggered: every sample, including the one right after each sleep and the
+ * closing one at the deadline, re-reads the whole RAM state (rt: the 3D, ta: the TA).
+ */
+static u32 g5p_rv3_wait(struct g5p_diag *g, struct g5p_render *r, u32 e,
+			u32 seq, struct g5p_ru_wait *w, struct g5p_ru_touch *t,
+			struct g5p_ru_retire *rt, struct g5p_ru_ta *ta,
+			struct g5p_rv3_ev *s, u64 *consumed_ns, int *err)
+{
+	struct g5p_drm *d = r->ctx->gpu;
+	bool closing = false, slow = false;
+
+	for (;;) {
+		int drain = g5p_boot_drain(g);
+		u64 seen = READ_ONCE(
+			d->event_serial); /* after the drain, before the sample */
+		bool fault, silent, done;
+
+		g5p_rv3_sample(g, r, e, seq, s);
+		/* latency101: a silent event stream during the phase is a dead firmware (never off). */
+		silent =
+			g5p_ru_wait_grace(w, s->ns, READ_ONCE(g->boot->events));
+		g5p_ru_wait_busy(w, s->ns, !s->idle_ok);
+		fault = drain || s->failed || s->proto || silent;
+		if (drain)
+			*err = drain;
+		else if (s->proto)
+			*err = -EPROTO;
+		else if (s->failed)
+			*err = -EIO;
+		else if (silent)
+			*err = -EIO;
+		if (s->consumed && !*consumed_ns)
+			*consumed_ns = s->ns;
+		done = g5p_rv3_done(e, s, rt, ta);
+		if (closing)
+			g5p_ru_wait_close(w, s->ns, done, fault);
+		else
+			g5p_ru_wait_step(w, s->ns, done, fault);
+		if (rt)
+			g5p_ru_rt_note(rt, w->result);
+		if (ta)
+			g5p_ru_ta_note(ta, w->result);
+		if (w->result) {
+			g5p_rv3_np_end(g, e, seq, w->result);
+			return w->result;
+		}
+		if (!slow && s->ns - w->start_ns >=
+				     (u64)G5P_RV3_SLOW_MS * NSEC_PER_MSEC) {
+			slow = true;
+			g5p_rv3_slow(g, e, seq, w, s,
+				     rt ? rt->unsat :
+				     ta ? ta->unsat :
+					  0,
+				     e ? READ_ONCE(d->td_hit_ns) :
+					 READ_ONCE(d->ta_hit_ns));
+		}
+		if (w->expired) {
+			closing = true; /* the closing sample, at once */
+			continue;
+		}
+		if (g5p_ru_touch_due(t, s->ns, w->result, w->expired))
+			g5p_rv3_touch(g, t, s->ns);
+		g5p_l123_pause(d, g, e, s, seen);
+	}
+}
+
+/* One phase's deadline: the legacy single bound, or (latency101) the soft/hard pair. */
+static void g5p_rv3_wait_start(struct g5p_diag *g, struct g5p_render *r,
+			       struct g5p_ru_wait *w, u64 pub_ns,
+			       u64 job_deadline_ns)
+{
+	if (r->hard_ms)
+		g5p_ru_wait_start_lat(w, pub_ns, r->soft_ms, r->hard_ms,
+				      job_deadline_ns,
+				      READ_ONCE(g->boot->events));
+	else
+		g5p_ru_wait_start(w, pub_ns, r->wait_ms, job_deadline_ns);
+}
+
+/* After a timeout (or fault) was decided: the one RAM look of the legacy path, or (latency101,
+ * timeout only) a RAM-only observation window that keeps draining and sampling at the wait cadence
+ * and prints nothing, so a completion that lands milliseconds after the decision is recorded
+ * (late_after/late_ns) before the receipt line and the terminal latch.  It never changes the
+ * result and never touches a register.  The 3D look steps a copy of the predicate's record, so the
+ * receipt keeps the deciding sample's.
+ */
+static void g5p_rv3_observe(struct g5p_diag *g, struct g5p_render *r, u32 e,
+			    u32 seq, struct g5p_ru_wait *w,
+			    const struct g5p_ru_retire *rt,
+			    const struct g5p_ru_ta *ta, struct g5p_rv3_ev *late)
+{
+	struct g5p_ru_retire copy, *c = NULL;
+	struct g5p_ru_ta tcopy, *tc = NULL;
+
+	if (rt) {
+		copy = *rt;
+		c = &copy;
+	}
+	if (ta) {
+		tcopy = *ta;
+		tc = &tcopy;
+	}
+	if (!r->obs_ms || w->result != G5P_RU_WAIT_TIMEOUT) {
+		g5p_rv3_sample(g, r, e, seq, late);
+		g5p_ru_wait_after(w, g5p_rv3_done(e, late, c, tc));
+		return;
+	}
+	do {
+		g5p_boot_drain(
+			g); /* a fault latches b->failed, the result stays */
+		g5p_rv3_sample(g, r, e, seq, late);
+		if (!g5p_ru_wait_observe(w, late->ns,
+					 g5p_rv3_done(e, late, c, tc),
+					 r->obs_ms))
+			break;
+		usleep_range(1000, 2000);
+	} while (1);
+}
+
+/* wake110: render-user-wake.h's register access, on the Fender and RGX windows. */
+static void g5p_rv3_wk_w1(void *ctx, u32 reg, u32 value)
+{
+	writel(value, ((struct g5p_diag *)ctx)->window[1] + reg);
+}
+
+/* The GPC state read of g5p_wk_ring() comes right after its R1+0x14 = 7 wake: in bell mode
+ * (render_user_wake=2) it waits up to G5P_RV3_WK_SETTLE_US, re-reading every 10 us, for a settled
+ * powered pstate (bit 4 clear, nibble nonzero), as Apple's setGPCPerformanceState waits for bit 4.
+ * Reads only; the ring's own check of the final value is unchanged.
+ */
+#define G5P_RV3_WK_SETTLE_US 2000U
+
+static u32 g5p_rv3_wk_r1(void *ctx, u32 reg)
+{
+	void __iomem *r1 = ((struct g5p_diag *)ctx)->window[1];
+	u32 raw = readl(r1 + reg);
+	u64 t0;
+
+	if (reg != G5P_WK_R1_GPC || (2) != G5P_WK_ALWAYS ||
+	    (!(raw & 0x10) && (raw & 0xf)))
+		return raw;
+	t0 = ktime_get_mono_fast_ns();
+	while (((raw & 0x10) || !(raw & 0xf)) &&
+	       ktime_get_mono_fast_ns() - t0 <
+		       (u64)G5P_RV3_WK_SETTLE_US * NSEC_PER_USEC) {
+		udelay(10);
+		raw = readl(r1 + reg);
+	}
+	return raw;
+}
+
+static void g5p_rv3_wk_wmb(void *ctx)
+{
+	dma_wmb();
+}
+
+static void g5p_rv3_wk_w0(void *ctx, u32 reg, u32 value)
+{
+	writel(value, ((struct g5p_diag *)ctx)->rgx + reg);
+}
+
+/* wake110: an r74f bell that still owns its ring (the ALIVE decoder may fire it). */
+static bool g5p_rv3_wk_r74f_busy(struct g5p_r73b *x)
+{
+	u32 k = READ_ONCE(x->r74f_active);
+	int s;
+
+	if (!k || k > G5P_R74F_KINDS)
+		return false;
+	s = atomic_read_acquire(&x->r74f_bell[k - 1].state);
+	return s == G5P_R74F_PUBLISHED || s == G5P_R74F_OPEN ||
+	       s == G5P_R74F_FIRING;
+}
+
+/* wake111: DS108's claim proof re-read at the publish: ALIVE proven in the current reset
+ * generation, the claim admitted in it, nothing latched failed since, no R74E power abort.
+ * Called under event_lock (interrupts off); g5p_ds_lock is a leaf (g5p_ds_event() is pure).
+ */
+static bool g5p_rv3_wk_ds108(struct g5p_boot *b)
+{
+	bool ok;
+
+	spin_lock(&g5p_ds_lock);
+	ok = g5p_ds_proven(&g5p_ds_state) &&
+	     g5p_ds_ok(&g5p_ds_state, G5P_DSE_CLAIM);
+	spin_unlock(&g5p_ds_lock);
+	return ok && !(b->r73b && READ_ONCE(b->r73b->early_power_abort));
+}
+
+/* wake110: before the phase's producer store, the engine's type-1 count and a cleared first-decode
+ * time, so an event decoded right after the publish is counted.  RAM only.
+ */
+static void g5p_rv3_wake_mark(struct g5p_drm *d, const struct g5p_render *r,
+			      struct g5p_rv3 *v, u32 e)
+{
+	unsigned long flags;
+
+	if (!r->wake)
+		return;
+	spin_lock_irqsave(&d->status_lock, flags);
+	v->wk_t1_pub[e] = d->t1_count[e];
+	WRITE_ONCE(d->t1_first_ns[e], 0);
+	spin_unlock_irqrestore(&d->status_lock, flags);
+}
+
+/* wake110: at the job's end, the type-1 counts and the first decode of each published phase. */
+static void g5p_rv3_wake_end(struct g5p_drm *d, const struct g5p_render *r,
+			     struct g5p_rv3 *v)
+{
+	unsigned long flags;
+
+	if (!r->wake)
+		return;
+	spin_lock_irqsave(&d->status_lock, flags);
+	for (u32 e = 0; e < 2; e++) {
+		v->wk_t1_end[e] = d->t1_count[e];
+		v->wk_first_ns[e] = d->t1_first_ns[e];
+	}
+	spin_unlock_irqrestore(&d->status_lock, flags);
+	if (v->phase < G5P_RV3_TA_PUBLISH)
+		v->wk_first_ns[0] = 0;
+	if (v->phase < G5P_RV3_TD_PUBLISH)
+		v->wk_first_ns[1] = 0;
+}
+
+/* wake110: microseconds / milliseconds from a phase's publish to a later instant; -1 = none. */
+static s64 g5p_rv3_wk_us(u64 from_ns, u64 to_ns)
+{
+	return from_ns && to_ns >= from_ns ?
+		       (s64)(to_ns - from_ns) / NSEC_PER_USEC :
+		       -1;
+}
+
+static s64 g5p_rv3_wk_ms(u64 from_ns, u64 to_ns)
+{
+	return from_ns && to_ns >= from_ns ?
+		       (s64)(to_ns - from_ns) / NSEC_PER_MSEC :
+		       -1;
+}
+
+/* wake110: one phase's publish-time decision, right after its producer store and barrier.  Both
+ * arms take the event lock (the r74f owner's serialization against the decoder) and sample the
+ * same RAM; only a factor that passed every guard runs g5p_wk_ring().  Nothing is printed under
+ * the lock.  Off: returns at once.
+ */
+static void g5p_rv3_wake(struct g5p_diag *g, struct g5p_render *r,
+			 struct g5p_rv3 *v, u32 e, u32 start, u32 seq)
+{
+	const struct g5p_wk_io io = { g, g5p_rv3_wk_w1, g5p_rv3_wk_r1,
+				      g5p_rv3_wk_wmb, g5p_rv3_wk_w0 };
+	struct g5p_boot *b = g->boot;
+	struct g5p_drm *d = r->ctx->gpu;
+	u32 *ring = (u32 *)g5p_boot_shared(b, e ? 0x64 : 0x60);
+	u8 *p = g5p_ru_page(b, e);
+	struct g5p_wk_in in;
+	unsigned long flags;
+
+	if (!r->wake)
+		return;
+	spin_lock_irqsave(&b->event_lock, flags);
+	v->wk_start_ns[e] = ktime_get_ns();
+	dma_rmb();
+	in = (struct g5p_wk_in){
+		.mode = r->wake,
+		.seed = 0,
+		.seq = seq,
+		.e = e,
+		.attempted = g5p_wk_attempted(v->wk_did[e]),
+		.term_failed = g5p_ru_term_failed(&g5p_rv3_term),
+		.boot_failed = READ_ONCE(b->failed) ||
+			       READ_ONCE(b->event_failed) ||
+			       READ_ONCE(b->stopped),
+		.power = g5p_wk_power_mask(
+			READ_ONCE(g->powered), READ_ONCE(g->fender_ready),
+			READ_ONCE(b->released), READ_ONCE(b->alive),
+			READ_ONCE(b->control_complete), g5p_rv3_wk_ds108(b),
+			READ_ONCE(g->reset_transition)),
+		.r74f_pending = g5p_rv3_wk_r74f_busy(b->r73b),
+		.start = start,
+		.target = r->target[e],
+		.prod = READ_ONCE(ring[4]),
+		.cons = READ_ONCE(ring[0]),
+		.stamp = { g5p_le32(p + G5P_R22_STAMP),
+			   g5p_le32(p + G5P_R22_STAMP + 4) },
+		.type1 = READ_ONCE(d->t1_count[e]) - v->wk_t1_pub[e],
+	};
+	v->wk_cons[e] = in.cons;
+	v->wk_power[e] = in.power;
+	v->wk_did[e] = g5p_wk_decide(&in, &io, &v->wk_fence[e], &v->wk_gpc[e]);
+	v->wk_done_ns[e] = ktime_get_ns();
+	spin_unlock_irqrestore(&b->event_lock, flags);
+	if (v->wk_did[e] == G5P_WK_DID_RANG)
+		r->wake_rang++;
+}
+
+/* The epoch's first job: the device (PM, channels) and this context's DC3 records, shared with
+ * g5p_render_attach(), then the r74f/r74g protocol of the fixed r74f_attach() on typed state.
+ */
+static int g5p_rv3_attach(struct g5p_drm *d, struct g5p_render *r,
+			  struct g5p_rv3 *v)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	struct g5p_vm *vm = r->ctx->vm;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	unsigned long deadline;
+	u32 start, tag, bad;
+	int ret;
+
+	ret = g5p_r74f_admit(g, G5P_R74F_DC3);
+	if (ret)
+		return ret;
+	ret = g5p_render_attach_prepare(d, r, &start, &tag);
+	if (ret)
+		return ret;
+	r->dc_target = (start + 2) & 255;
+	r->bound = true;
+	rd->up = true;
+	rd->v3 = true;
+	rd->job_slots = (2) == 2 ? 2 : 1;
+	rd->pm_once = (1) == 1;
+	rd->pm_ctx = b->pm_sets ? min((3), 3U) : 0;
+	r->pm_first = r->pm_set < 0;
+	dev_info(
+		g->dev,
+		"RENDER-V3 layout job_slots=%u pm_once=%u slot1=%#x..%#x pm_ctx=%u pm_sets=%u "
+		"end=v3\n",
+		rd->job_slots, rd->pm_once, G5P_RU_SLOT1, G5P_RU_SLOT1_END,
+		rd->pm_ctx, b->pm_sets);
+	g5p_render_retain(r);
+	v->touched = true;
+	WRITE_ONCE(r->ctx->live, true);
+	dma_wmb();
+	smp_store_release(&ctl[4], r->dc_target);
+	dma_wmb();
+	v->attach_ns = ktime_get_ns();
+	g5p_r74_mark(g, G5P_R74_ATTACH_PUBLISHED, r->dc_target);
+	/* The producer is final from here; only the doorbell may be pending. */
+	ret = g5p_r74f_bell(g, G5P_R74F_DC3, start, r->dc_target);
+	if (ret < 0)
+		return g5p_rv3_errno(g, ret);
+	deadline = jiffies + 3 * HZ;
+	do {
+		ret = g5p_boot_drain(g);
+		if (ret || READ_ONCE(b->failed))
+			return ret ?: -EIO;
+		dma_rmb();
+		if (READ_ONCE(ctl[4]) != r->dc_target ||
+		    READ_ONCE(ctl[0]) > 255)
+			return -EPROTO;
+		if (READ_ONCE(ctl[0]) == r->dc_target) {
+			g5p_r74f_consumed(g, G5P_R74F_DC3);
+			bad = g5p_r74g_check(g, 0, r->slot, vm->root.dma, tag,
+					     start);
+			g5p_r74_mark(g, G5P_R74_ATTACH_CONSUMED, r->dc_target);
+			g5p_r74g_dc3_line(g, 0, false);
+			if (bad)
+				return g5p_rv3_errno(g,
+						     g5p_r74g_refuse(g, bad));
+			for (u32 e = 0; e < 2; e++)
+				g5p_mmu_record(
+					g,
+					"RENDER tags slot=%u host=%08x cached=%08x expected=%08x\n",
+					r->slot[e],
+					g5p_le32(g5p_boot_shared(b, 0x84) +
+						 r->slot[e] * 4),
+					g5p_le32(g5p_boot_shared(b, 0x85) +
+						 r->slot[e] * 4),
+					tag);
+			g5p_mmu_record(
+				g,
+				"RENDER-USER attached TA=%u 3D=%u PC=%pad tag=%08x blocks=%u; RAM-only, firmware "
+				"DC3 installed CBASE, host MMU pass skipped\n",
+				r->slot[0], r->slot[1], &vm->root.dma, tag,
+				rd->blocks);
+			return 0;
+		}
+		usleep_range(100, 200);
+	} while (time_before(jiffies, deadline));
+	g5p_r74f_consumed(g, G5P_R74F_DC3);
+	return g5p_rv3_errno(g,
+			     g5p_r74f_stop(g, G5P_R74F_STOP_ATTACH_NOT_CONSUMED,
+					   READ_ONCE(ctl[0])));
+}
+
+/* perf60 bell mode (render_user_wake=2): a DC publication (bind, spare pairs, unbind) gets Apple's
+ * submit kick too.  With the policy held in state 0 the firmware no longer drains the DC ring on
+ * its own (perf60clk-9ec288b868: a second client's RAM-only DC3 bind was never consumed).  The
+ * wake path's guards (event lock, power proof, no fault or terminal, no r74f bell owning a ring,
+ * the ring holding exactly this publication), then Apple's order: R1+0x14 = 7 and its read-back,
+ * R1+0x1000 re-read every 10 us until a settled powered pstate (g5p_gpc_ok(): bit 4 clear,
+ * nibble nonzero; Apple's setGPCPerformanceState waits for bit 4 the same way), at most
+ * G5P_RV3_DC_SETTLE_US, and R0+0xb00 = 0x10 only then.  A GPC that never reads on is not written:
+ * no R0 access, the publication waits as before.  Off (render_user_wake != 2): returns at once.
+ */
+#define G5P_RV3_DC_SETTLE_US 2000U
+
+static void g5p_rv3_dc_kick(struct g5p_diag *g, u32 start, u32 target,
+			    const char *why)
+{
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	u32 fence = U32_MAX, gpc = U32_MAX, power, cons, n = 0;
+	const char *did = "skip-guard";
+	unsigned long flags;
+	u64 t0;
+
+	;
+	;
+	spin_lock_irqsave(&b->event_lock, flags);
+	dma_rmb();
+	cons = READ_ONCE(ctl[0]);
+	power = g5p_wk_power_mask(READ_ONCE(g->powered),
+				  READ_ONCE(g->fender_ready),
+				  READ_ONCE(b->released), READ_ONCE(b->alive),
+				  READ_ONCE(b->control_complete),
+				  g5p_rv3_wk_ds108(b),
+				  READ_ONCE(g->reset_transition));
+	if (READ_ONCE(b->failed) || READ_ONCE(b->event_failed) ||
+	    READ_ONCE(b->stopped) || g5p_ru_term_failed(&g5p_rv3_term) ||
+	    !g5p_wk_power_ready(power) || g5p_rv3_wk_r74f_busy(b->r73b) ||
+	    cons != start || READ_ONCE(ctl[4]) != target)
+		goto out;
+	writel(7, g->window[1] + 0x14);
+	fence = readl(g->window[1] + 0x14);
+	if (fence & ~7U) {
+		did = "skip-fence";
+		goto out;
+	}
+	t0 = ktime_get_mono_fast_ns();
+	gpc = readl(g->window[1] + 0x1000);
+	while (!g5p_gpc_ok(gpc) &&
+	       ktime_get_mono_fast_ns() - t0 <
+		       (u64)G5P_RV3_DC_SETTLE_US * NSEC_PER_USEC) {
+		udelay(10);
+		gpc = readl(g->window[1] + 0x1000);
+		n++;
+	}
+	if (!g5p_gpc_ok(gpc)) {
+		did = "skip-gpc";
+		goto out;
+	}
+	/* the publication's RAM stores before the MTS write (Apple: dmb ish before vt+0x80) */
+	wmb();
+	writel(0x10, g->rgx + 0xb00);
+	did = "rang";
+out:
+	spin_unlock_irqrestore(&b->event_lock, flags);
+	dev_info(
+		g->dev,
+		"RENDER-V3 dc-kick why=%s did=%s dc=%u->%u power=%02x fence=%08x gpc=%08x "
+		"settle=%u end=v3\n",
+		why, did, cons, target, power, fence, gpc, n);
+}
+
+/* RAM only: drain the event stream, read the firmware pages (interim, see g5p_rv3_fw_touch) and
+ * sample the DC ring until its consumer reaches `target`
+ * or G5P_RU_BIND_MS pass.  No doorbell and no register, whether or not a job has retired.
+ */
+static int g5p_rv3_dc_wait(struct g5p_diag *g, u32 target, u64 *consumed_ns)
+{
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	unsigned long deadline = jiffies + msecs_to_jiffies(G5P_RU_BIND_MS);
+
+	for (;;) {
+		bool expired = time_after_eq(jiffies, deadline);
+		int ret = g5p_boot_drain(g);
+
+		if (ret)
+			return ret;
+		if (READ_ONCE(b->failed))
+			return -EIO;
+		g5p_rv3_fw_touch(b);
+		dma_rmb();
+		switch (g5p_ru_bind_step(READ_ONCE(ctl[0]), READ_ONCE(ctl[4]),
+					 target, expired)) {
+		case G5P_RU_BIND_CONSUMED:
+			*consumed_ns = ktime_get_ns();
+			return 0;
+		}
+		usleep_range(100, 200);
+	}
+}
+
+static s64 g5p_rv3_us(u64 from_ns, u64 to_ns)
+{
+	return from_ns && to_ns >= from_ns ?
+		       (s64)(to_ns - from_ns) / NSEC_PER_USEC :
+		       -1;
+}
+
+/*
+ * The first job of a context on a device that is already up binds the context's slot pair
+ * with a DC3 pair published in RAM only (multi-client-design.md §4.2).  No doorbell and no
+ * register access of any kind, so it is safe after a job retired and while the GPU may be
+ * idle-gated: the firmware services the DC ring in its scheduler pass, before TA and 3D, and
+ * the host waits on RAM.  Core lock held, between jobs.
+ *
+ * Refused before the producer store, it touched nothing.  From the store on, the firmware may
+ * hold the pair: the context is retained, and on failure it is lost (v->bind_failed) but the
+ * device and the contexts already bound are not.  A pair not consumed in time keeps every later
+ * bind refused until the firmware catches up.
+ */
+/*
+ * render_user_close_park (release8 quiet2, docs/gpu/experiments/release8-quiet2.md).  The PM writes
+ * a closed context's free list back through that context's TA slot after the context is gone, and
+ * not only while it is the last or the previous distinct context (render-user-pmset.h): two bench
+ * faults wrote the free list of a context two switches back, through its slot, on the 2nd job of a
+ * third context, after the pm-prev rule had unbound it (page-invalid level 2, its PC level empty).
+ * iOS never leaves the PM's target unresolvable: its PM is the device's (shared by the work queues,
+ * AGXWorkQueue_initAndAttachPM), in the kernel's GPU address space, and a GART keeps its slots until
+ * the address space is destroyed (AGXGart_detachSlotsAndDestroyAddressSpace).  Here, a closed
+ * context's pair is bound again, right after its unbind (between jobs, core lock held), to the park
+ * catalogue: a kernel page that maps only the firmware window, where the PM sets live.  A late
+ * write-back then lands in the closed context's own set page (released, reused last) instead of
+ * faulting.  A later bind of the pair unbinds it first.  Both steps are the proven DC3
+ * transitions (PA to zero, zero to PA); a park that fails leaves the pair unbound, as before.
+ */
+/* release8 default */
+
+static int g5p_rv3_unbind_slots(struct g5p_drm *d, const u32 *slots, u32 n,
+				const char *why);
+
+/* Before a bind, core lock held: a pair a close parked (RAM: park PA and tag on both slots) is
+ * unbound first, by its own DC3.  0 when the pair was not parked or the unbind verified.
+ */
+static int g5p_rv3_unpark(struct g5p_drm *d, const u32 *slot)
+{
+	struct g5p_boot *b = d->core->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	struct g5p_ru_bind_sample s = {};
+	struct g5p_ru_bind_mem m;
+
+	if (!d->rdev->park.cpu)
+		return 0;
+	dma_rmb();
+	g5p_render_bind_mem(b, slot, READ_ONCE(ctl[4]), &m);
+	g5p_ru_bind_read(&m, READ_ONCE(ctl[0]), READ_ONCE(ctl[4]), &s);
+	if (!g5p_ru_bind_parked(&s, d->rdev->park.dma))
+		return 0;
+	return g5p_rv3_unbind_slots(d, slot, 2, "unpark");
+}
+
+static int g5p_rv3_bind(struct g5p_drm *d, struct g5p_render *r,
+			struct g5p_rv3 *v)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	struct g5p_vm *vm = r->ctx->vm;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	struct g5p_ru_bind_sample s = {};
+	struct g5p_ru_bind_mem m;
+	u64 pub_ns, consumed_ns = 0;
+	u32 start, tag, bad = 0;
+	int ret;
+
+	dma_rmb();
+	if (rd->dc_pending && READ_ONCE(ctl[0]) != rd->dc_wait) {
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 bind refused slots=%u/%u dc=%u/%u wait=%u: an earlier bind is "
+			"pending; no hardware touched end=v3\n",
+			r->slot[0], r->slot[1], READ_ONCE(ctl[0]),
+			READ_ONCE(ctl[4]), rd->dc_wait);
+		return -EIO;
+	}
+	rd->dc_pending = false;
+	ret = g5p_rv3_unpark(d, r->slot);
+	if (ret)
+		return ret;
+	ret = g5p_render_vm_prepare(d, r, &start, &tag);
+	if (ret) {
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 bind refused slots=%u/%u ret=%d dc=%u/%u: ring busy or slot in use; "
+			"no hardware touched end=v3\n",
+			r->slot[0], r->slot[1], ret, READ_ONCE(ctl[0]),
+			READ_ONCE(ctl[4]));
+		return ret;
+	}
+	r->dc_target = (start + 2) & 255;
+	g5p_render_retain(r);
+	v->bind_failed = true;
+	dma_wmb();
+	pub_ns = ktime_get_ns();
+	smp_store_release(&ctl[4], r->dc_target);
+	dma_wmb();
+	g5p_rv3_dc_kick(g, start, r->dc_target, "bind");
+	ret = g5p_rv3_dc_wait(g, r->dc_target, &consumed_ns);
+	if (ret == -ETIMEDOUT) {
+		rd->dc_pending = true;
+		rd->dc_wait = r->dc_target;
+	}
+	dma_rmb();
+	g5p_render_bind_mem(b, r->slot, start, &m);
+	g5p_ru_bind_read(&m, READ_ONCE(ctl[0]), READ_ONCE(ctl[4]), &s);
+	if (!ret) {
+		bad = g5p_ru_bind_check(&s, r->slot, vm->root.dma, tag,
+					r->dc_target);
+		ret = bad ? -EUCLEAN : 0;
+	}
+	dev_emerg(
+		g->dev,
+		"RENDER-V3 bind slots=%u/%u ret=%d consumed_us=%lld tag=%08x host=%08x/%08x "
+		"cached=%08x/%08x dc=%u->%u/%u bad=%#x pc=%pad mode=ram-dc3 end=v3\n",
+		r->slot[0], r->slot[1], ret, g5p_rv3_us(pub_ns, consumed_ns),
+		tag, s.host[0], s.host[1], s.cached[0], s.cached[1], start,
+		s.cons, s.prod, bad, &vm->root.dma);
+	if (ret)
+		return ret;
+	v->bind_failed = false;
+	r->bound = true;
+	WRITE_ONCE(r->ctx->live, true);
+	return 0;
+}
+
+/*
+ * TEMPORARY fallback (render_user_spare_pairs, read at the epoch's first job), for a firmware
+ * that never drains a DC3 published after a job retired.  Before job 1's attach, bind that
+ * many extra slot pairs, each to a zeroed kernel-owned catalogue, in one RAM-only batch with no
+ * doorbell.  The firmware drains it on its own like the self-drained attach of this boot tuple
+ * (r87b); job 1's own attach, doorbell and r74g checks then run unchanged behind it
+ * (g5p_r74f_ring() refuses a ring that holds more than that attach's pair).  Later contexts
+ * take a pair over with g5p_rv3_adopt().  A pair that does not check out is never used.  Core
+ * lock held, device not up, so register access is still allowed (none is made here).
+ */
+static int g5p_rv3_spares(struct g5p_drm *d, struct g5p_rv3 *v)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	u32 want = min((0), G5P_RU_MAX_SPARES);
+	u32 start = READ_ONCE(ctl[4]), target, n, ok = 0;
+	struct g5p_ru_bind_sample s;
+	struct g5p_ru_bind_mem m;
+	u64 pub_ns, consumed_ns = 0;
+	unsigned long flags;
+	int ret;
+
+	if (!want || rd->spares)
+		return 0;
+	rd->spares = kcalloc(want, sizeof(*rd->spares), GFP_KERNEL);
+	if (!rd->spares)
+		return -ENOMEM;
+	for (n = 0; n < want; n++) {
+		struct g5p_rspare *sp = &rd->spares[n];
+		bool pair;
+
+		spin_lock_irqsave(&g->slot_lock, flags);
+		pair = g5p_ru_slot_pair(g->user_slots, false, sp->slot);
+		if (pair) {
+			__set_bit(sp->slot[0], g->user_slots);
+			__set_bit(sp->slot[1], g->user_slots);
+		}
+		spin_unlock_irqrestore(&g->slot_lock, flags);
+		if (!pair)
+			break;
+		g5p_render_bind_mem(b, sp->slot, start + 2 * n, &m);
+		g5p_ru_bind_read(&m, READ_ONCE(ctl[0]), start, &s);
+		if (!g5p_ru_bind_busy(&s) &&
+		    !g5p_vm_alloc_page(d->drm.dev, &sp->root)) {
+			g5p_table_clean_page(g, &sp->root);
+			continue;
+		}
+		spin_lock_irqsave(&g->slot_lock, flags);
+		__clear_bit(sp->slot[0], g->user_slots);
+		__clear_bit(sp->slot[1], g->user_slots);
+		spin_unlock_irqrestore(&g->slot_lock, flags);
+		break;
+	}
+	if (!n)
+		return 0;
+	dsb(sy);
+	for (u32 i = 0; i < n; i++) {
+		g5p_render_bind_mem(b, rd->spares[i].slot, start + 2 * i, &m);
+		g5p_ru_bind_publish(&m, rd->spares[i].slot,
+				    rd->spares[i].root.dma, G5P_RU_SPARE_TAG);
+	}
+	rd->spare_count = n;
+	target = (start + 2 * n) & 255;
+	v->touched = true;
+	dma_wmb();
+	pub_ns = ktime_get_ns();
+	smp_store_release(&ctl[4], target);
+	dma_wmb();
+	g5p_rv3_dc_kick(g, start, target, "spares");
+	ret = g5p_rv3_dc_wait(g, target, &consumed_ns);
+	for (u32 i = 0; !ret && i < n; i++) {
+		struct g5p_rspare *sp = &rd->spares[i];
+
+		g5p_render_bind_mem(b, sp->slot, start + 2 * i, &m);
+		g5p_ru_bind_read(&m, READ_ONCE(ctl[0]), READ_ONCE(ctl[4]), &s);
+		sp->ok = !g5p_ru_bind_check(&s, sp->slot, sp->root.dma,
+					    G5P_RU_SPARE_TAG, target);
+		ok += sp->ok;
+	}
+	dev_emerg(
+		g->dev,
+		"RENDER-V3 spares pairs=%u ok=%u ret=%d consumed_us=%lld dc=%u->%u first=%u/%u "
+		"last=%u/%u end=v3\n",
+		n, ok, ret, g5p_rv3_us(pub_ns, consumed_ns), start,
+		READ_ONCE(ctl[0]), rd->spares[0].slot[0], rd->spares[0].slot[1],
+		rd->spares[n - 1].slot[0], rd->spares[n - 1].slot[1]);
+	return ret;
+}
+
+/*
+ * TEMPORARY fallback: the first job of a context on a device whose job 1 bound spare pairs.
+ * Takes the next pair that checked out, makes its catalogue page this VM's root (a copy of the
+ * current root) and publishes the VM's tag through the proven RAM-only tag path: CBASE already
+ * names the page, and the changed tag makes the firmware invalidate the slots' PC level at this
+ * context's first job.  No DC3, no register.  Core lock held; the context has a job queued, so
+ * no VM edit of it runs concurrently.
+ */
+static int g5p_rv3_adopt(struct g5p_drm *d, struct g5p_render *r,
+			 struct g5p_rv3 *v)
+{
+	struct g5p_rdev *rd = d->rdev;
+	struct g5p_diag *g = d->core;
+	struct g5p_boot *b = g->boot;
+	struct g5p_vm *vm = r->ctx->vm;
+	struct g5p_rspare *sp = NULL;
+	struct g5p_ru_bind_sample s;
+	struct g5p_ru_bind_mem m;
+	struct g5p_dma_page old;
+	unsigned long flags;
+	struct g5p_rt *rt;
+	u32 entry;
+	int ret;
+
+	for (u32 i = 0; i < rd->spare_count && !sp; i++)
+		if (rd->spares[i].ok && !rd->spares[i].used)
+			sp = &rd->spares[i];
+	if (!sp) {
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 bind refused slots=%u/%u mode=spare: none left of %u; no hardware "
+			"touched end=v3\n",
+			r->slot[0], r->slot[1], rd->spare_count);
+		return -ENOSPC;
+	}
+	/* RAM: the pair still names its page, with the tag job 1 checked. */
+	dma_rmb();
+	g5p_render_bind_mem(b, sp->slot, 0, &m);
+	g5p_ru_bind_read(&m, 0, 0, &s);
+	for (u32 e = 0; e < 2; e++) {
+		if (s.pa[e] == sp->root.dma && s.host[e] == G5P_RU_SPARE_TAG &&
+		    s.cached[e] == G5P_RU_SPARE_TAG)
+			continue;
+		sp->ok = false;
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 bind refused slots=%u/%u mode=spare pair=%u/%u host=%08x cached=%08x: "
+			"pair changed; no hardware touched end=v3\n",
+			r->slot[0], r->slot[1], sp->slot[0], sp->slot[1],
+			s.host[e], s.cached[e]);
+		return -EIO;
+	}
+	ret = g5p_render_fw_entry(d, r, &entry);
+	if (ret)
+		return ret;
+	g5p_vm_entry(&vm->mutation, vm->root.cpu + G5P_RU_FIRMWARE_CI * 4,
+		     entry, 0);
+	if (b->sink_ready)
+		g5p_vm_entry(&vm->mutation, vm->root.cpu,
+			     g5p_le32(b->catalogue.cpu), 0);
+	memcpy(sp->root.cpu, vm->root.cpu, G5P_GPU_PAGE);
+	old = vm->root;
+	vm->root = sp->root;
+	sp->root = old; /* the VM's former root, never published */
+	g5p_ru_free_page(d->drm.dev, &sp->root);
+	list_for_each_entry(rt, &r->targets, link)
+		for (u32 i = 0; i < rt->page_count; i++)
+			g5p_table_clean_page(g, &rt->pages[i]);
+	spin_lock_irqsave(&g->slot_lock, flags);
+	__clear_bit(r->slot[0], g->user_slots);
+	__clear_bit(r->slot[1], g->user_slots);
+	spin_unlock_irqrestore(&g->slot_lock, flags);
+	r->slot[0] = sp->slot[0];
+	r->slot[1] = sp->slot[1];
+	sp->used = true;
+	g5p_render_retain(r);
+	r->bound = true;
+	WRITE_ONCE(r->ctx->live, true);
+	/* Root and tables to PoC, then a tag unlike the cached one in both slots. */
+	ret = g5p_render_invalidate(r->ctx);
+	v->bind_failed = ret != 0;
+	dev_emerg(
+		g->dev,
+		"RENDER-V3 bind slots=%u/%u ret=%d consumed_us=0 tag=%08x cached=%08x/%08x "
+		"pc=%pad mode=spare end=v3\n",
+		r->slot[0], r->slot[1], ret,
+		g5p_le32(g5p_boot_shared(b, 0x84) + r->slot[0] * 4),
+		s.cached[0], s.cached[1], &vm->root.dma);
+	return ret;
+}
+
+/* r74f_publish_ta() on typed state: record, WORK_CTL, producer; then (job 1 only) the r74g grace
+ * and, only if the ring is still pending, the one ALIVE-owned fallback doorbell.  Jobs >= 2
+ * publish and return: no grace, no bell (the r74f/r74g machinery is one-shot).  No canary, no marker.
+ */
+static int g5p_rv3_publish_ta(struct g5p_diag *g, struct g5p_render *r,
+			      struct g5p_rv3 *v, u32 seq)
+{
+	struct g5p_boot *b = g->boot;
+	struct g5p_r73b *x = b->r73b;
+	struct g5p_vm *vm = r->ctx->vm;
+	struct g5p_r74g_dc3 *dc = x->r74g_dc3;
+	u32 *ring = (u32 *)g5p_boot_shared(b, 0x60);
+	u8 *p = g5p_ru_page(b, 0);
+	u32 start = READ_ONCE(ring[4]), previous = g5p_ru_endpoint(seq - 1),
+	    endpoint = g5p_ru_endpoint(seq);
+	bool first = seq == 1;
+	u32 bad;
+	int ret;
+
+	if (!r->bound || r->submitted[0] || start > 255 ||
+	    READ_ONCE(ring[0]) != start ||
+	    g5p_le32(p + G5P_WORK_CTL) != previous ||
+	    g5p_le32(p + G5P_WORK_CTL + 0x40) != previous)
+		return -EBUSY;
+	if (first) {
+		ret = g5p_r74f_admit(g, G5P_R74F_TA);
+		if (ret)
+			return ret;
+		/* g5p_r74g_ta_preflight() on typed state: DC3 still complete with the same records,
+		 * tag and backing, and no page-table mutation since the attach.
+		 */
+		bad = g5p_r74g_check(g, 1, r->slot, dc[0].expected_pa,
+				     dc[0].tag, dc[0].start);
+		if (g5p_vm_generation(&vm->mutation) != dc[0].tag ||
+		    vm->root.dma != dc[0].expected_pa ||
+		    r->dc_target != dc[0].target) {
+			bad |= G5P_R74G_BAD_MUTATION;
+			dc[1].bad = bad;
+		}
+		g5p_r74g_dc3_line(g, 1, false);
+		if (bad)
+			return g5p_rv3_errno(g, g5p_r74g_refuse(g, bad));
+	}
+	for (u32 j = 0; j < 5; j++) {
+		u32 at = b->layout.offset[0x61] + start * 20 + j * 4;
+
+		g5p_put32(b->shared[at / G5P_GPU_PAGE].cpu + at % G5P_GPU_PAGE,
+			  j == 0 ? 0 :
+			  j == 1 ? g5p_ru_meta(0) :
+			  j == 2 ? endpoint :
+				   0);
+	}
+	r->target[0] = (start + 1) & 255;
+	r->submitted[0] = true;
+	dma_wmb();
+	WRITE_ONCE(*(u32 *)(p + G5P_WORK_CTL + 0x40), endpoint);
+	dma_wmb();
+	if (first)
+		g5p_r74_mark(g, G5P_R74_TA_PUBLISH, start);
+	v->ta_pub_ns = ktime_get_ns();
+	v->job_deadline_ns =
+		v->ta_pub_ns +
+		(u64)(r->hard_ms ? 2 * r->hard_ms : G5P_RU_V3_CAP_MS) *
+			NSEC_PER_MSEC;
+	smp_store_release(&ring[4], r->target[0]);
+	dma_wmb();
+	if (first) {
+		ret = g5p_r74g_ta(g, start, r->target[0]);
+		v->grace_end = READ_ONCE(x->r74g_grace_end);
+		v->bell = ret == 0;
+		if (ret < 0)
+			return g5p_rv3_errno(g, ret);
+	}
+	/* wake110: jobs >= 2 reach this at once after the producer store (job 1: excluded). */
+	if (!first)
+		0;
+	g5p_rv3_wake(g, r, v, 0, start, seq);
+	/* The line the userspace lane parses (a9c_parse_publish): same format as the fixed path's. */
+	g5p_mmu_record_job(
+		g,
+		"RENDER publish engine=%u slot=%u endpoint=%u kick=%x W=%08x sequence=%u "
+		"identity=%u\n",
+		0, r->slot[0], endpoint, first ? 0x10 : 0,
+		g5p_ru_meta(0) +
+			g5p_ru_w_at(g5p_rv3_js(r->ctx->gpu->rdev, seq)),
+		seq, 0);
+	return 0;
+}
+
+/* The RAM preconditions of the 3D publish, one bit per clause (0 = admitted).  RAM reads only; the bits are
+ * what the refusal line prints, so a second blocker is visible in the run that meets it:
+ *   0 TA not retired   1 TA not consumed   2 3D already submitted   3 producer > 255   4 consumer != producer
+ *   5 WORK_CTL         6 WORK_CTL+0x40     7 command tag != 4       8 dependency word  9 dependency value
+ *  10 3D stamp words != seq - 1 (job N leaves N; 0 before the first)
+ */
+static u32 g5p_rv3_td_why(const struct g5p_render *r, const u8 *p,
+			  const u32 *ring, u32 start, u32 previous, u32 seq)
+{
+	const u8 *cmd = p + g5p_ru_cmd_at(g5p_rv3_js(r->ctx->gpu->rdev, seq));
+
+	return (u32)!r->retired[0] | (u32)!r->consumed[0] << 1 |
+	       (u32)r->submitted[1] << 2 | (u32)(start > 255) << 3 |
+	       (u32)(READ_ONCE(ring[0]) != start) << 4 |
+	       (u32)(g5p_le32(p + G5P_WORK_CTL) != previous) << 5 |
+	       (u32)(g5p_le32(p + G5P_WORK_CTL + 0x40) != previous) << 6 |
+	       (u32)(g5p_le32(cmd) != 4) << 7 |
+	       (u32)(g5p_le32(cmd + 4) != g5p_ru_meta(0) + G5P_R22_STAMP + 4)
+		       << 8 |
+	       (u32)(g5p_le32(cmd + 8) != seq) << 9 |
+	       (u32)(g5p_le32(p + G5P_R22_STAMP) != seq - 1 ||
+		     g5p_le32(p + G5P_R22_STAMP + 4) != seq - 1)
+		       << 10;
+}
+
+/* The 3D after the TA retired: record, WORK_CTL, producer, and NO doorbell. */
+static int g5p_rv3_publish_3d(struct g5p_diag *g, struct g5p_render *r,
+			      struct g5p_rv3 *v, u32 seq)
+{
+	struct g5p_boot *b = g->boot;
+	u32 *ring = (u32 *)g5p_boot_shared(b, 0x64);
+	u8 *p = g5p_ru_page(b, 1);
+	u32 start = READ_ONCE(ring[4]), previous = g5p_ru_endpoint(seq - 1),
+	    endpoint = g5p_ru_endpoint(seq);
+	u32 why;
+
+	/* RAM preconditions of r96's admit (g5p_rv3_td_why()).  Nothing has been written when one
+	 * fails, and the refusal names the clauses and the raw values it read.
+	 */
+	why = g5p_rv3_td_why(r, p, ring, start, previous, seq);
+	if (why) {
+		dev_emerg(
+			g->dev,
+			"RENDER-V3 3d-refused seq=%u why=%#x ring=%u/%u ctl=%08x/%08x cmd=%08x/%08x/%08x "
+			"stamp=%08x/%08x end=v3\n",
+			seq, why, start, READ_ONCE(ring[0]),
+			g5p_le32(p + G5P_WORK_CTL),
+			g5p_le32(p + G5P_WORK_CTL + 0x40),
+			g5p_le32(p + g5p_ru_cmd_at(g5p_rv3_js(r->ctx->gpu->rdev,
+							      seq))),
+			g5p_le32(p +
+				 g5p_ru_cmd_at(
+					 g5p_rv3_js(r->ctx->gpu->rdev, seq)) +
+				 4),
+			g5p_le32(p +
+				 g5p_ru_cmd_at(
+					 g5p_rv3_js(r->ctx->gpu->rdev, seq)) +
+				 8),
+			g5p_le32(p + G5P_R22_STAMP),
+			g5p_le32(p + G5P_R22_STAMP + 4));
+		return -EPROTO;
+	}
+	for (u32 j = 0; j < 5; j++) {
+		u32 at = b->layout.offset[0x65] + start * 20 + j * 4;
+
+		g5p_put32(b->shared[at / G5P_GPU_PAGE].cpu + at % G5P_GPU_PAGE,
+			  j == 0 ? 1 :
+			  j == 1 ? g5p_ru_meta(1) :
+			  j == 2 ? endpoint :
+				   0);
+	}
+	r->target[1] = (start + 1) & 255;
+	r->submitted[1] = true;
+	dma_wmb();
+	WRITE_ONCE(*(u32 *)(p + G5P_WORK_CTL + 0x40), endpoint);
+	dma_wmb();
+	v->td_pub_ns = ktime_get_ns();
+	smp_store_release(&ring[4], r->target[1]);
+	dma_wmb();
+	0;
+	g5p_rv3_wake(g, r, v, 1, start, seq);
+	/* The 3D twin of the TA's publish line: engine 1, kick 0 (no doorbell). */
+	g5p_mmu_record_job(
+		g,
+		"RENDER publish engine=%u slot=%u endpoint=%u kick=%x W=%08x sequence=%u "
+		"identity=%u\n",
+		1, r->slot[1], endpoint, 0,
+		g5p_ru_meta(1) +
+			g5p_ru_w_at(g5p_rv3_js(r->ctx->gpu->rdev, seq)),
+		seq, 1);
+	return 0;
+}
