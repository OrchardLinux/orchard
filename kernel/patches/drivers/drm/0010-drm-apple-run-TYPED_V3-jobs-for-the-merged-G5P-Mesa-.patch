+static int g5p_bos_show(struct seq_file *m, void *data)
+{
+	struct drm_debugfs_entry *entry = m->private;
+	struct drm_device *drm = entry->dev;
+	u32 exported = 0, imported = 0, nohandle = 0;
+	u64 nohandle_bytes = 0;
+	struct drm_file *file;
+	struct g5p_bo *bo;
+	unsigned long flags;
+
+	spin_lock_irqsave(&g5p_bo_lock, flags);
+	list_for_each_entry(bo, &g5p_bo_live, live) {
+		struct drm_gem_object *obj = &bo->shmem.base;
+		bool imp = drm_gem_is_imported(obj);
+
+		exported += !!READ_ONCE(obj->dma_buf);
+		imported += imp;
+		if (!READ_ONCE(obj->handle_count)) {
+			nohandle++;
+			nohandle_bytes += obj->size;
+		}
+		seq_printf(
+			m,
+			"bo size=%zuK refs=%u handles=%u exported=%c imported=%c vm_pins=%u by=%s[%d]\n",
+			obj->size >> 10, kref_read(&obj->refcount),
+			READ_ONCE(obj->handle_count),
+			READ_ONCE(obj->dma_buf) ? 'y' : 'n', imp ? 'y' : 'n',
+			bo->vm_pins, bo->comm, bo->pid);
+	}
+	seq_printf(
+		m,
+		"live=%u bytes=%lluK exported=%u imported=%u no_handle=%u/%lluK device_pinned=%lluK\n",
+		g5p_bo_count, g5p_bo_bytes >> 10, exported, imported, nohandle,
+		nohandle_bytes >> 10,
+		READ_ONCE(to_g5p(drm)->pinned_bytes) >> 10);
+	spin_unlock_irqrestore(&g5p_bo_lock, flags);
+	mutex_lock(&drm->filelist_mutex);
+	list_for_each_entry(file, &drm->filelist, lhead) {
+		struct drm_gem_object *obj;
+		struct task_struct *task;
+		u64 bytes = 0;
+		u32 handles = 0;
+		struct pid *pid;
+		int id;
+
+		spin_lock(&file->table_lock);
+		idr_for_each_entry(&file->object_idr, obj, id) {
+			handles++;
+			bytes += obj->size;
+		}
+		spin_unlock(&file->table_lock);
+		rcu_read_lock();
+		pid = rcu_dereference(file->pid);
+		task = pid_task(pid, PIDTYPE_TGID);
+		seq_printf(m, "file %s[%d] handles=%u bytes=%lluK\n",
+			   task ? task->comm : "?", pid_vnr(pid), handles,
+			   bytes >> 10);
+		rcu_read_unlock();
+	}
+	mutex_unlock(&drm->filelist_mutex);
+	return 0;
+}
+
+static int g5p_create_bo(struct drm_device *drm, void *data,
+			 struct drm_file *file)
+{
+	struct drm_g5p_create_bo *a = data;
+	struct drm_gem_shmem_object *shmem;
+	int ret;
+
+	if (!a->size || a->size > G5P_MAX_BO_SIZE ||
+	    (a->size & (G5P_GPU_PAGE - 1)) || a->handle || !a->flags ||
+	    (a->flags &
+	     ~(DRM_G5P_BO_READ | DRM_G5P_BO_WRITE | DRM_G5P_BO_EXEC)))
+		return -EINVAL;
+	shmem = drm_gem_shmem_create(drm, a->size);
+	if (IS_ERR(shmem))
+		return PTR_ERR(shmem);
+	/* Match the DMA API's coherent/noncoherent CPU mapping choice. The GPU
+	 * cache contract remains an explicit COMPUTE capability prerequisite.
+	 */
+	shmem->map_wc = !dev_is_dma_coherent(drm->dev);
+	to_g5p_bo(&shmem->base)->roles = a->flags;
+	g5p_bo_track(&shmem->base);
+	ret = drm_gem_handle_create(file, &shmem->base, &a->handle);
+	drm_gem_object_put(&shmem->base);
+	return ret;
+}
+
+static int g5p_bo_mmap_offset(struct drm_device *drm, void *data,
+			      struct drm_file *file)
+{
+	struct drm_g5p_bo_mmap_offset *a = data;
+	struct drm_gem_object *obj;
+	int ret;
+
+	if (a->flags || a->offset)
+		return -EINVAL;
+	obj = drm_gem_object_lookup(file, a->handle);
+	if (!obj)
+		return -ENOENT;
+	ret = drm_gem_create_mmap_offset(obj);
+	if (!ret)
+		a->offset = drm_vma_node_offset_addr(&obj->vma_node);
+	drm_gem_object_put(obj);
+	return ret;
+}
+
+static int g5p_bo_sync(struct drm_device *drm, void *data,
+		       struct drm_file *file)
+{
+	struct drm_g5p_bo_sync *a = data;
+	struct drm_gem_object *obj;
+	struct sg_table *sgt;
+	struct g5p_file *f = file->driver_priv;
+	struct g5p_context *ctx;
+	unsigned long id;
+	int ret = 0;
+
+	if (a->op != DRM_G5P_BO_SYNC_TO_DEVICE &&
+	    a->op != DRM_G5P_BO_SYNC_TO_CPU)
+		return -EINVAL;
+	obj = drm_gem_object_lookup(file, a->handle);
+	if (!obj)
+		return -ENOENT;
+	if (!g5p_bo_range_valid(a->offset, a->size, obj->size)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	mutex_lock(&f->lock);
+	xa_for_each(&f->contexts, id, ctx)
+		if (ctx->serial &&
+		    (ctx->bad || smp_load_acquire(&ctx->pending))) {
+			mutex_unlock(&f->lock);
+			ret = -EBUSY;
+			goto out;
+		}
+	sgt = drm_gem_shmem_get_pages_sgt(to_drm_gem_shmem_obj(obj));
+	if (IS_ERR(sgt)) {
+		ret = PTR_ERR(sgt);
+		mutex_unlock(&f->lock);
+		goto out;
+	}
+	/* render_user_sync_range bit 0: the requested range; else the whole BO (stronger, allowed). */
+	if (READ_ONCE(render_user_sync_range) & 1) {
+		u64 lo, hi;
+
+		if (g5p_sync_window(a->offset, a->size, obj->size, &lo, &hi))
+			g5p_sync_sgt_range(drm->dev, sgt, lo, hi,
+					   a->op == DRM_G5P_BO_SYNC_TO_CPU);
+	} else if (a->op == DRM_G5P_BO_SYNC_TO_DEVICE) {
+		dma_sync_sgtable_for_device(drm->dev, sgt, DMA_BIDIRECTIONAL);
+	} else {
+		dma_sync_sgtable_for_cpu(drm->dev, sgt, DMA_BIDIRECTIONAL);
+	}
+	mutex_unlock(&f->lock);
+out:
+	drm_gem_object_put(obj);
+	return ret;
+}
+
+static int g5p_vm_alloc_page(struct device *dev, struct g5p_dma_page *p)
+{
+	p->cpu = dma_alloc_coherent(dev, G5P_GPU_PAGE, &p->dma, GFP_KERNEL);
+	if (!p->cpu)
+		return -ENOMEM;
+	if (!g5p_user_pa_valid(p->dma) || dma_to_phys(dev, p->dma) != p->dma) {
+		dma_free_coherent(dev, G5P_GPU_PAGE, p->cpu, p->dma);
+		p->cpu = NULL;
+		return -ERANGE;
+	}
+	memset(p->cpu, 0, G5P_GPU_PAGE);
+	return 0;
+}
+
+static struct g5p_pt *g5p_vm_table(struct g5p_vm *vm, struct device *dev,
+				   u32 level, u32 key, bool create)
+{
+	struct g5p_pt *pt;
+	int ret;
+
+	list_for_each_entry(pt, &vm->tables, link)
+		if (pt->level == level && pt->key == key)
+			return pt;
+	if (!create)
+		return NULL;
+	if (vm->table_count >= G5P_MAX_PT_PAGES)
+		return ERR_PTR(-ENOSPC);
+	pt = kzalloc(sizeof(*pt), GFP_KERNEL);
+	if (!pt)
+		return ERR_PTR(-ENOMEM);
+	ret = g5p_vm_alloc_page(dev, &pt->page);
+	if (ret) {
+		kfree(pt);
+		return ERR_PTR(ret);
+	}
+	pt->level = level;
+	pt->key = key;
+	list_add_tail(&pt->link, &vm->tables);
+	vm->table_count++;
+	return pt;
+}
+
+static u8 *g5p_vm_pte(struct g5p_vm *vm, struct device *dev, u64 va,
+		      bool create)
+{
+	u32 ci = (va >> 30) & 1023, di = (va >> 21) & 511;
+	struct g5p_pt *dir, *leaf;
+
+	dir = g5p_vm_table(vm, dev, 1, ci, create);
+	if (IS_ERR_OR_NULL(dir))
+		return (void *)dir;
+	leaf = g5p_vm_table(vm, dev, 2, (ci << 9) | di, create);
+	if (IS_ERR_OR_NULL(leaf))
+		return (void *)leaf;
+	if (create) {
+		g5p_vm_entry(&vm->mutation, vm->root.cpu + ci * 4,
+			     g5p_catalogue_entry(dir->page.dma), 0);
+		g5p_vm_entry(&vm->mutation, dir->page.cpu + di * 8,
+			     g5p_directory_entry(leaf->page.dma), 1);
+	}
+	return leaf->page.cpu + ((va >> 14) & 127) * 8;
+}
+
+static void g5p_vm_clear(struct g5p_vm *vm, struct device *dev, u64 va,
+			 u64 size)
+{
+	for (u64 off = 0; off < size; off += G5P_GPU_PAGE) {
+		u8 *pte = g5p_vm_pte(vm, dev, va + off, false);
+
+		if (!IS_ERR_OR_NULL(pte))
+			g5p_vm_entry(&vm->mutation, pte, 0, 2);
+	}
+	dma_wmb();
+}
+
+static bool g5p_vm_table_empty(struct g5p_pt *pt)
+{
+	u32 count = pt->level == 2 ? 128 : 512;
+
+	for (u32 i = 0; i < count; i++)
+		if (g5p_le32(pt->page.cpu + i * 8) & 1)
+			return false;
+	return true;
+}
+
+static void g5p_vm_prune(struct device *dev, struct g5p_vm *vm)
+{
+	struct g5p_pt *pt, *tmp, *dir;
+
+	/* These tables are mutable only before firmware attachment.
+	 * Remove empty leaves before directories, including failed MAP rollback.
+	 */
+	for (u32 level = 2; level; level--)
+		list_for_each_entry_safe(pt, tmp, &vm->tables, link) {
+			if (pt->level != level || !g5p_vm_table_empty(pt))
+				continue;
+			if (level == 2) {
+				dir = g5p_vm_table(vm, dev, 1, pt->key >> 9,
+						   false);
+				if (dir)
+					g5p_vm_entry(&vm->mutation,
+						     dir->page.cpu + (pt->key &
+								      511) * 8,
+						     0, 1);
+			} else {
+				g5p_vm_entry(&vm->mutation,
+					     vm->root.cpu + pt->key * 4, 0, 0);
+			}
+			dma_wmb();
+			list_del(&pt->link);
+			dma_free_coherent(dev, G5P_GPU_PAGE, pt->page.cpu,
+					  pt->page.dma);
+			vm->table_count--;
+			kfree(pt);
+		}
+}
+
+static void g5p_vm_obj_put(struct g5p_vm *vm, struct drm_gem_object *obj);
+
+static void g5p_vm_release(struct kref *ref)
+{
+	struct g5p_vm *vm = container_of(ref, struct g5p_vm, ref);
+	struct device *dev = vm->dev;
+	struct g5p_mapping *m, *mtmp;
+	struct g5p_pt *pt, *ptmp;
+	u64 pinned = vm->pinned_bytes;
+	u32 maps = vm->map_count, tables = vm->table_count;
+
+	list_for_each_entry_safe(m, mtmp, &vm->maps, link) {
+		drm_mm_remove_node(&m->node);
+		g5p_vm_obj_put(vm, m->obj);
+		drm_gem_object_put(m->obj);
+		list_del(&m->link);
+		kfree(m);
+	}
+	list_for_each_entry_safe(pt, ptmp, &vm->tables, link) {
+		dma_free_coherent(dev, G5P_GPU_PAGE, pt->page.cpu,
+				  pt->page.dma);
+		list_del(&pt->link);
+		kfree(pt);
+	}
+	dma_free_coherent(dev, G5P_GPU_PAGE, vm->root.cpu, vm->root.dma);
+	xa_destroy(&vm->objs);
+	drm_mm_remove_node(&vm->reserved);
+	drm_mm_takedown(&vm->mm);
+	/* One line per freed VM: the device's pinned total must fall back after a client exits. */
+	dev_info(
+		dev,
+		"G5P VM release maps=%u tables=%u pinned=%lluK device_pinned=%lluK\n",
+		maps, tables, pinned >> 10,
+		READ_ONCE(vm->gpu->pinned_bytes) >> 10);
+	kfree(vm);
+}
+
+static void g5p_vm_put(struct g5p_vm *vm)
+{
+	kref_put(&vm->ref, g5p_vm_release);
+}
+
+static void g5p_context_release(struct kref *ref)
+{
+	struct g5p_context *c = container_of(ref, struct g5p_context, ref);
+	g5p_render_release(c);
+	g5p_vm_put(c->vm);
+	kfree(c);
+}
+
+static void g5p_context_put(struct g5p_context *c)
+{
+	kref_put(&c->ref, g5p_context_release);
+}
+
+static int g5p_create_vm(struct drm_device *drm, void *data,
+			 struct drm_file *file)
+{
+	struct drm_g5p_create_vm *a = data;
+	struct g5p_file *f = file->driver_priv;
+	struct g5p_vm *vm;
+	u32 id;
+	int ret;
+
+	if (a->flags || a->handle)
+		return -EINVAL;
+	vm = kzalloc(sizeof(*vm), GFP_KERNEL);
+	if (!vm)
+		return -ENOMEM;
+	kref_init(&vm->ref);
+	vm->dev = drm->dev;
+	vm->gpu = to_g5p(drm);
+	vm->bounded = (0);
+	vm->mutation.generations = true;
+	INIT_LIST_HEAD(&vm->maps);
+	xa_init(&vm->objs);
+	INIT_LIST_HEAD(&vm->tables);
+	drm_mm_init(&vm->mm, G5P_USER_VA_START,
+		    G5P_USER_VA_END - G5P_USER_VA_START);
+	vm->reserved.start = G5P_USER_RESERVED_START;
+	vm->reserved.size = G5P_USER_RESERVED_END - G5P_USER_RESERVED_START;
+	ret = drm_mm_reserve_node(&vm->mm, &vm->reserved);
+	if (ret)
+		goto err_mm;
+	ret = g5p_vm_alloc_page(drm->dev, &vm->root);
+	if (ret)
+		goto err_reserved;
+	vm->table_count = 1;
+	mutex_lock(&f->lock);
+	ret = xa_alloc(&f->vms, &id, vm, XA_LIMIT(1, G5P_MAX_VMS), GFP_KERNEL);
+	mutex_unlock(&f->lock);
+	if (ret) {
+		g5p_vm_put(vm);
+		return ret;
+	}
+	a->handle = id;
+	return 0;
+err_reserved:
+	drm_mm_remove_node(&vm->reserved);
+err_mm:
+	drm_mm_takedown(&vm->mm);
+	kfree(vm);
+	return ret;
+}
+
+static int g5p_destroy_vm(struct drm_device *drm, void *data,
+			  struct drm_file *file)
+{
+	struct drm_g5p_destroy_vm *a = data;
+	struct g5p_file *f = file->driver_priv;
+	struct g5p_vm *vm;
+	int ret = 0;
+
+	if (a->flags)
+		return -EINVAL;
+	mutex_lock(&f->lock);
+	vm = xa_load(&f->vms, a->handle);
+	if (!vm)
+		ret = -ENOENT;
+	else if (vm->contexts || f->submitted || vm->frozen)
+		ret = -EBUSY;
+	else
+		xa_erase(&f->vms, a->handle);
+	mutex_unlock(&f->lock);
+	if (!ret)
+		g5p_vm_put(vm);
+	return ret;
+}
+
+static unsigned long g5p_vm_obj_count(struct g5p_vm *vm,
+				      struct drm_gem_object *obj)
+{
+	void *v = xa_load(&vm->objs, (unsigned long)obj);
+
+	return v ? xa_to_value(v) : 0;
+}
+
+/*
+ * One more mapping of `obj` in `vm`.  Its first one in this VM counts its size against the
+ * VM's pin limit, and its first one in any VM against the device budget (render_pinned_mib).
+ * Our own dma-bufs import back as the same GEM object, in any file, so memory shared between
+ * clients (a client's buffer in the compositor's VM) counts once.
+ */
+static int g5p_vm_obj_get(struct g5p_vm *vm, struct drm_gem_object *obj)
+{
+	struct g5p_drm *d = to_g5p(obj->dev);
+	struct g5p_bo *bo = to_g5p_bo(obj);
+	u64 limit = (u64)READ_ONCE(render_pinned_mib) << 20;
+	unsigned long count;
+	int ret = 0;
+
+	mutex_lock(&d->pin_lock);
+	count = g5p_vm_obj_count(vm, obj);
+	if (!count && obj->size > G5P_MAX_PINNED_BYTES - vm->pinned_bytes)
+		ret = -ENOSPC;
+	else if (!count && !bo->vm_pins &&
+		 obj->size > limit - min(limit, d->pinned_bytes))
+		ret = -ENOSPC;
+	if (!ret)
+		ret = xa_err(xa_store(&vm->objs, (unsigned long)obj,
+				      xa_mk_value(count + 1), GFP_KERNEL));
+	if (!ret && !count) {
+		vm->pinned_bytes += obj->size;
+		if (!bo->vm_pins++)
+			d->pinned_bytes += obj->size;
+	}
+	mutex_unlock(&d->pin_lock);
+	return ret;
+}
+
+/* One mapping of `obj` in `vm` less: g5p_vm_obj_get() undone.  Also called by the render
+ * scheduler for an unmap deferred behind queued jobs, hence the lock around the counts.
+ */
+static void g5p_vm_obj_put(struct g5p_vm *vm, struct drm_gem_object *obj)
+{
+	struct g5p_drm *d = to_g5p(obj->dev);
+	struct g5p_bo *bo = to_g5p_bo(obj);
+	unsigned long count;
+
+	mutex_lock(&d->pin_lock);
+	count = g5p_vm_obj_count(vm, obj);
+	if (count > 1) {
+		/* replaces an existing entry: no allocation */
+		xa_store(&vm->objs, (unsigned long)obj, xa_mk_value(count - 1),
+			 GFP_KERNEL);
+	} else if (!WARN_ON(!count)) {
+		xa_erase(&vm->objs, (unsigned long)obj);
+		vm->pinned_bytes -= obj->size;
+		if (!--bo->vm_pins)
+			d->pinned_bytes -= obj->size;
+	}
+	mutex_unlock(&d->pin_lock);
+}
+
+static int g5p_vm_map_bo(struct drm_device *drm, struct g5p_vm *vm,
+			 struct drm_file *file, struct drm_g5p_vm_bind *a)
+{
+	struct drm_gem_object *obj;
+	struct drm_gem_shmem_object *shmem;
+	struct sg_table *sgt;
+	struct sg_dma_page_iter iter;
+	struct g5p_mapping *m;
+	u64 *addresses, done = 0;
+	u32 count = 0;
+	bool imported;
+	int ret;
+
+	if (vm->map_count >= G5P_MAX_MAPS ||
+	    a->size > G5P_MAX_VM_BYTES - vm->mapped_bytes)
+		return -ENOSPC;
+	obj = drm_gem_object_lookup(file, a->bo);
+	if (!obj)
+		return -ENOENT;
+	if (!g5p_bo_range_valid(a->offset, a->size, obj->size)) {
+		ret = -EINVAL;
+		goto err_obj;
+	}
+	ret = g5p_vm_obj_get(vm, obj);
+	if (ret)
+		goto err_obj;
+	addresses = kvmalloc_array(obj->size / G5P_GPU_PAGE, sizeof(*addresses),
+				   GFP_KERNEL);
+	m = kzalloc(sizeof(*m), GFP_KERNEL);
+	if (!addresses || !m) {
+		ret = -ENOMEM;
+		goto err_alloc;
+	}
+	m->node.start = a->va;
+	m->node.size = a->size;
+	ret = drm_mm_reserve_node(&vm->mm, &m->node);
+	if (ret) {
+		ret = -EINVAL;
+		goto err_alloc;
+	}
+	imported = drm_gem_is_imported(obj);
+	shmem = to_drm_gem_shmem_obj(obj);
+	/* PRIME import mapped this attachment for our device and owns it until
+	 * object release.  Re-locking the exporter's reservation here can return
+	 * -EBUSY after the first V3 submission even though the render VM is idle.
+	 */
+	if (imported) {
+		sgt = READ_ONCE(shmem->sgt);
+		if (!sgt) {
+			dev_warn_ratelimited(
+				drm->dev,
+				"G5P VM_BIND map=prime-no-sgt vm=%u bo=%u bytes=%llu\n",
+				a->vm, a->bo, a->size);
+			ret = -ENXIO;
+			goto err_node;
+		}
+	} else {
+		sgt = drm_gem_shmem_get_pages_sgt(shmem);
+	}
+	if (IS_ERR(sgt)) {
+		ret = PTR_ERR(sgt);
+		dev_warn_ratelimited(
+			drm->dev,
+			"G5P VM_BIND map=sgt-error vm=%u bo=%u imported=%u err=%d\n",
+			a->vm, a->bo, imported, ret);
+		goto err_node;
+	}
+	for_each_sgtable_dma_page(sgt, &iter, 0) {
+		u64 dma = sg_page_iter_dma_address(&iter);
+
+		if (count >= obj->size / G5P_GPU_PAGE ||
+		    !g5p_user_pa_valid(dma) ||
+		    dma_to_phys(drm->dev, dma) != dma ||
+		    (!imported && dma_to_phys(drm->dev, dma) !=
+					  page_to_phys(shmem->pages[count]))) {
+			ret = -ERANGE;
+			goto err_node;
+		}
+		addresses[count++] = dma;
+	}
+	if (count != obj->size / G5P_GPU_PAGE) {
+		ret = -EINVAL;
+		goto err_node;
+	}
+	for (; done < a->size; done += G5P_GPU_PAGE) {
+		u8 *pte = g5p_vm_pte(vm, drm->dev, a->va + done, true);
+
+		if (IS_ERR_OR_NULL(pte)) {
+			ret = pte ? PTR_ERR(pte) : -ENOMEM;
+			goto err_clear;
+		}
+		/* Recovered bypass bits; user permission encodings are not claimed.
+		 * A render VM latched to r25 memory variant 4 uses flags 0.
+		 */
+		g5p_vm_entry(
+			&vm->mutation, pte,
+			g5p_leaf_entry(
+				addresses[(a->offset + done) / G5P_GPU_PAGE],
+				vm->zero_leaf_flags ? 0 : g5p_pte_attrs()),
+			2);
+	}
+	dma_wmb();
+	m->obj = obj;
+	m->offset = a->offset;
+	list_add_tail(&m->link, &vm->maps);
+	vm->mapped_bytes += a->size;
+	vm->map_count++;
+	kvfree(addresses);
+	return 0;
+err_clear:
+	g5p_vm_clear(vm, drm->dev, a->va, done);
+	if (!vm->resident)
+		g5p_vm_prune(drm->dev, vm);
+err_node:
+	drm_mm_remove_node(&m->node);
+err_alloc:
+	kvfree(addresses);
+	kfree(m);
+	g5p_vm_obj_put(vm, obj);
+err_obj:
+	drm_gem_object_put(obj);
+	return ret;
+}
+
+static int g5p_vm_bind(struct drm_device *drm, void *data,
+		       struct drm_file *file)
+{
+	struct drm_g5p_vm_bind *a = data;
+	struct g5p_file *f = file->driver_priv;
+	struct g5p_mapping *m;
+	struct g5p_vm *vm;
+	int ret = -ENOENT;
+	bool resident = false, locked = false;
+	u32 generation[3];
+
+	if (a->flags || !g5p_user_range_valid(a->va, a->size) ||
+	    (a->op != DRM_G5P_VM_MAP && a->op != DRM_G5P_VM_UNMAP) ||
+	    (a->op == DRM_G5P_VM_UNMAP && (a->bo || a->offset)))
+		return -EINVAL;
+	mutex_lock(&f->lock);
+	vm = xa_load(&f->vms, a->vm);
+	if (!vm)
+		goto out;
+	/* Its render context is closing: the close item owns the tables now, and the context
+	 * may be freed at any time, so it is not looked at.
+	 */
+	if (vm->resident_gone) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if ((f->submitted || vm->frozen) && !vm->resident) {
+		dev_warn_ratelimited(
+			drm->dev,
+			"G5P VM_BIND busy=no-resident submitted=%u frozen=%u vm=%u op=%u\n",
+			f->submitted, vm->frozen, a->vm, a->op);
+		ret = -EBUSY;
+		goto out;
+	}
+	if (vm->resident) {
+		ret = g5p_resident_idle(vm->resident, true);
+		if (ret)
+			goto out;
+		/* A render context's edit is RAM only and touches its own tables and
+		 * slots, which the firmware reads only at that context's next kick;
+		 * f->lock plus resident-idle orders it against its submit (a MAP or
+		 * UNMAP may pass queued jobs, see g5p_render_vm_idle()).  Other contexts' jobs
+		 * may hold the core lock meanwhile, so it is not taken.  Serialized
+		 * compute still uses the global mutex.
+		 */
+		if (!vm->resident->render) {
+			mutex_lock(&to_g5p(drm)->core->lock);
+			locked = true;
+		}
+		resident = true;
+		memcpy(generation, vm->mutation.generation, sizeof(generation));
+	}
+	if (a->op == DRM_G5P_VM_MAP) {
+		if (vm->bounded && !(vm->resident && vm->resident->render) &&
+		    g5p_user_private_overlap(a->va, a->size)) {
+			ret = -EINVAL;
+			goto out;
+		}
+		ret = g5p_vm_map_bo(drm, vm, file, a);
+		if (!ret)
+			g5p_vmlog_add(G5P_VMLOG_MAP, vm, a->vm, a->va, a->size,
+				      a->bo, a->offset);
+		if (ret == -EBUSY)
+			dev_warn_ratelimited(
+				drm->dev,
+				"G5P VM_BIND busy=map vm=%u bo=%u submitted=%u frozen=%u resident=%u render=%u\n",
+				a->vm, a->bo, f->submitted, vm->frozen,
+				!!vm->resident,
+				!!(vm->resident && vm->resident->render));
+		goto out;
+	}
+	list_for_each_entry(m, &vm->maps, link) {
+		if (m->node.start != a->va || m->node.size != a->size) {
+			if (m->node.start < a->va + a->size &&
+			    a->va < m->node.start + m->node.size) {
+				ret = -EINVAL;
+				break;
+			}
+			continue;
+		}
+		g5p_vmlog_add(G5P_VMLOG_UNMAP, vm, a->vm, a->va, a->size, 0, 0);
+		g5p_vm_clear(vm, drm->dev, a->va, a->size);
+		if (!vm->resident)
+			g5p_vm_prune(drm->dev, vm);
+		else {
+			ret = g5p_resident_invalidate(vm->resident);
+			if (ret)
+				goto out;
+			memcpy(generation, vm->mutation.generation,
+			       sizeof(generation));
+		}
+		drm_mm_remove_node(&m->node);
+		list_del(&m->link);
+		vm->map_count--;
+		vm->mapped_bytes -= a->size;
+		/* Beside queued jobs the PTEs are gone, but the pages stay pinned until
+		 * those jobs have retired.
+		 */
+		if (!vm->resident || !g5p_resident_defer(vm->resident, m)) {
+			g5p_vm_obj_put(vm, m->obj);
+			drm_gem_object_put(m->obj);
+			kfree(m);
+		}
+		ret = 0;
+		break;
+	}
+out:
+	if (resident) {
+		int invalidate = 0;
+
+		if (memcmp(generation, vm->mutation.generation,
+			   sizeof(generation)))
+			invalidate = g5p_resident_invalidate(vm->resident);
+
+		if (invalidate)
+			ret = invalidate;
+		if (locked)
+			mutex_unlock(&to_g5p(drm)->core->lock);
+	}
+	mutex_unlock(&f->lock);
+	return ret;
+}
+
+static int g5p_create_context(struct drm_device *drm, void *data,
+			      struct drm_file *file)
+{
+	struct drm_g5p_create_context *a = data;
+	if (a->type != DRM_G5P_CONTEXT_RENDER)
+		return -EOPNOTSUPP;
+	return g5p_render_create_context(drm, file, a);
+}
+
+static int g5p_destroy_context(struct drm_device *drm, void *data,
+			       struct drm_file *file)
+{
+	struct drm_g5p_destroy_context *a = data;
+	struct g5p_file *f = file->driver_priv;
+	struct g5p_context *c;
+	int ret = 0;
+
+	if (a->flags)
+		return -EINVAL;
+	mutex_lock(&f->lock);
+	c = xa_load(&f->contexts, a->handle);
+	if (!c)
+		ret = -ENOENT;
+	else
+		ret = g5p_render_destroy(c);
+	if (!ret && c) {
+		c->vm->contexts--;
+		xa_erase(&f->contexts, a->handle);
+	}
+	mutex_unlock(&f->lock);
+	if (!ret)
+		g5p_context_put(c);
+	return ret;
+}
diff --git a/drivers/gpu/drm/apple-g5p/render-user-validate.h b/drivers/gpu/drm/apple-g5p/render-user-validate.h
new file mode 100644
index 0000000000..19325a2c31
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/render-user-validate.h
@@ -0,0 +1,374 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_RENDER_USER_VALIDATE_H
+#define G5P_RENDER_USER_VALIDATE_H
+
+/* Pure TYPED_V1 checks over already-resolved resource ranges. The caller
+ * proves each range is inside a mapping of the listed BO, in the submitting
+ * context's VM, with BO roles covering `access`. Nothing here is a pointer
+ * the kernel dereferences; GPU addresses are only range-checked.
+ */
+#define G5P_RU_ACCESS_READ 1U
+#define G5P_RU_ACCESS_WRITE 2U
+#define G5P_RU_MAX_VDM 0x10000U
+#define G5P_RU_MAX_SCRATCH (64ULL << 20)
+
+/* Hardware facts GET_RENDER_INFO reports and the TYPED_V3 validator enforces;
+ * one definition so the two cannot drift. Code offsets are 32-bit from the
+ * common USC/PDS base. TA/3D reads at or above 2^38 stall silently on A10
+ * (works at 0x3_, 0x10_ and 0x20_, stalls at 0x40_ and 0x80_, no MMU fault);
+ * not flown on A9, so the limit is a statement, not a proof (see
+ * docs/gpu/experiments/typed-v3-kernel-implementation.md).
+ */
+#define G5P_RU_PDS_BASE 0x300000000ULL
+#define G5P_RU_CODE_WINDOW 0x100000000ULL /* 2^32 */
+#define G5P_RU_HW_VA_LIMIT 0x4000000000ULL /* 2^38 */
+
+/* Not a requested access: the resolver sets it, for the typed profiles only,
+ * when the listed BO carries DRM_G5P_BO_EXEC. Only TYPED_V3 reads it; every
+ * other check masks on READ/WRITE. It lives in `access` rather than in a new
+ * field so positional g5p_ru_range initialisers keep compiling.
+ */
+#define G5P_RU_ACCESS_EXEC 16U
+
+struct g5p_ru_range {
+	u64 va, size;
+	u32 access;
+};
+
+/* [va, va + size) inside one listed range that grants every access bit. */
+static inline bool g5p_ru_in(const struct g5p_ru_range *r, u32 n, u64 va,
+			     u64 size, u32 access)
+{
+	if (!size || va > ~0ULL - size)
+		return false;
+	for (u32 i = 0; i < n; i++)
+		if ((r[i].access & access) == access && va >= r[i].va &&
+		    va - r[i].va <= r[i].size &&
+		    size <= r[i].size - (va - r[i].va))
+			return true;
+	return false;
+}
+
+/* Everything TYPED_V1 and TYPED_V2 share: all fields except the pools. */
+static inline int g5p_ru_pass_check_common(const struct g5p_ru_pass *p,
+					   const struct g5p_ru_range *r, u32 n)
+{
+	u32 rw = G5P_RU_ACCESS_READ | G5P_RU_ACCESS_WRITE;
+
+	if (p->vdm_size < 4 || p->vdm_size > G5P_RU_MAX_VDM ||
+	    ((p->vdm_va | p->vdm_size) & 3) ||
+	    !g5p_ru_in(r, n, p->vdm_va, p->vdm_size, G5P_RU_ACCESS_READ))
+		return -EINVAL;
+	/* Copied to TA W88/R0+470; meaning unresolved (r23), so bounded. */
+	if ((p->vdm_control & 0xf) || p->vdm_control > G5P_RU_MAX_VDM)
+		return -EINVAL;
+	if ((p->scratch_va & 0xf) || p->scratch_size < 0x10 ||
+	    p->scratch_size > G5P_RU_MAX_SCRATCH ||
+	    !g5p_ru_in(r, n, p->scratch_va, p->scratch_size, rw))
+		return -EINVAL;
+	for (u32 i = 0; i < 6; i++)
+		if ((p->scratch_ptr[i] & 3) ||
+		    !g5p_ru_in(r, n, p->scratch_ptr[i], 4, rw))
+			return -EINVAL;
+	/* Three-word descriptors keep their fourth slot zero. */
+	if (p->ta_pds[3] || p->eot[3] || p->eot_resume[3])
+		return -EINVAL;
+	return 0;
+}
+
+/* TYPED_V1 and LINEAR64_V1: the two allocator pools are page-aligned RW. */
+static inline int g5p_ru_pass_check(const struct g5p_ru_pass *p,
+				    const struct g5p_ru_range *r, u32 n)
+{
+	u32 rw = G5P_RU_ACCESS_READ | G5P_RU_ACCESS_WRITE;
+	int ret = g5p_ru_pass_check_common(p, r, n);
+
+	if (ret)
+		return ret;
+	if (((p->pool7_va | p->pool7_size | p->pool8_va | p->pool8_size) &
+	     (G5P_GPU_PAGE - 1)) ||
+	    !g5p_ru_in(r, n, p->pool7_va, p->pool7_size, rw) ||
+	    !g5p_ru_in(r, n, p->pool8_va, p->pool8_size, rw))
+		return -EINVAL;
+	return 0;
+}
+
+#define G5P_RU_MAX_TABLE 65536U
+
+/* TYPED_V2: the pools are the ISP scissor (8-byte entries) and depth-bias
+ * (12-byte) tables, READ and word aligned; the V1 pool fields stay zero.
+ * Flagged ZLS words are addresses into listed RW ranges; the rest is opaque.
+ */
+static inline int g5p_ru_pass2_check(const struct g5p_ru_pass *p,
+				     const struct g5p_ru_pass2 *e,
+				     const struct g5p_ru_range *r, u32 n)
+{
+	u32 rw = G5P_RU_ACCESS_READ | G5P_RU_ACCESS_WRITE;
+	int ret;
+
+	if (p->pool7_va || p->pool7_size || p->pool8_va || p->pool8_size)
+		return -EINVAL;
+	ret = g5p_ru_pass_check_common(p, r, n);
+	if (ret)
+		return ret;
+	if (!e->scissor_count || e->scissor_count > G5P_RU_MAX_TABLE ||
+	    (e->scissor_va & 3) ||
+	    !g5p_ru_in(r, n, e->scissor_va, e->scissor_count * 8ULL,
+		       G5P_RU_ACCESS_READ))
+		return -EINVAL;
+	if (!e->dbias_count || e->dbias_count > G5P_RU_MAX_TABLE ||
+	    (e->dbias_va & 3) ||
+	    !g5p_ru_in(r, n, e->dbias_va, e->dbias_count * 12ULL,
+		       G5P_RU_ACCESS_READ))
+		return -EINVAL;
+	if ((e->pixel_width != 2 && e->pixel_width != 4 &&
+	     e->pixel_width != 8) ||
+	    (e->bgobj_vals & ~0x3ffU) || (e->zls_mask & ~0x3fU))
+		return -EINVAL;
+	for (u32 i = 0; i < 6; i++)
+		if ((e->zls_mask & (1U << i)) &&
+		    ((e->zls[i] >> 40) ||
+		     !g5p_ru_in(r, n, e->zls[i] & ~0xfULL, 16, rw)))
+			return -EINVAL;
+	return 0;
+}
+
+/* TYPED_V3: the TA PDS program (W+0x88 -> R0+0x470) is an explicit reference
+ * and the VDM stream length is a separate field that never reaches W.
+ * Contract and evidence: docs/gpu/experiments/typed-v3-kernel-implementation.md.
+ * Everything here is rejected, never masked. Structural rules need only the
+ * resolved ranges; the two content rules take bytes the caller read through
+ * the BOs' own pages (g5p_ru_pass3_content()). The rules are a subset of what
+ * the userspace lane accepts (tools/mesa-a9 a9c_ctx_lint(), a9scene): nothing
+ * here is stricter than a client that passes those lints.
+ *   -EINVAL  stale vdm_control, malformed program/stream/descriptor fields,
+ *            no terminator, or (V1 dialect) the V1 rules fail
+ *   -ERANGE  outside [pds_base, pds_base + code_window) or past hw_va_limit
+ *   -ENOENT  no listed range wholly covers the program, stream or task code
+ *   -EACCES  missing READ, or the program/task code range's BO lacks EXEC
+ *   -ENODATA the first 16 program bytes are all zero
+ */
+#define G5P_RU_PROGRAM_ALIGN 16U
+#define G5P_RU_PROGRAM_MIN 16U
+
+struct g5p_ru_v3_limits {
+	u64 pds_base, code_window;
+	u64 hw_va_limit; /* 0: no statement */
+};
+
+/* Where the content rules read: indexes into the ranges array. */
+struct g5p_ru_v3_loc {
+	u64 program_off; /* the exact W+0x88 value */
+	u32 program_range, vdm_range;
+	u32 pixel_width; /* the pass's output width, 2, 4 or 8, either dialect */
+	bool dialect2; /* ext was non-zero: V2 3D words; else the V1 dialect */
+};
+
+/* TYPED_V3 carries the V2 ext struct. An all-zero ext selects the V1 dialect
+ * (pools in base, no tables, V1 3D words): the pass tools/mesa-a9 records
+ * today, plus the explicit program. Any non-zero ext field selects V2.
+ */
+static inline bool g5p_ru_pass2_zero(const struct g5p_ru_pass2 *e)
+{
+	u64 any = e->scissor_va | e->dbias_va | e->background_texture;
+
+	for (u32 i = 0; i < ARRAY_SIZE(e->zls); i++)
+		any |= e->zls[i];
+	any |= e->scissor_count | e->dbias_count | e->bgobj_depth |
+	       e->bgobj_vals | e->pixel_width | e->zls_mask;
+	return !any;
+}
+
+/* First listed range that wholly contains [va, va + size). */
+static inline bool g5p_ru_cover(const struct g5p_ru_range *r, u32 n, u64 va,
+				u64 size, u32 *idx)
+{
+	if (!size || va > ~0ULL - size)
+		return false;
+	for (u32 i = 0; i < n; i++)
+		if (va >= r[i].va && va - r[i].va <= r[i].size &&
+		    size <= r[i].size - (va - r[i].va)) {
+			*idx = i;
+			return true;
+		}
+	return false;
+}
+
+/* [va, va + size) ends at or below the limit; zero limit makes no statement. */
+static inline bool g5p_ru_below(u64 limit, u64 va, u64 size)
+{
+	return !limit || (size <= limit && va <= limit - size);
+}
+
+/* One PDS task reference of a store/resume descriptor: a 32-bit offset from
+ * pds_base, 16-byte aligned like every captured value and W+0x88's mask,
+ * non-zero, inside the code window and the hardware limit, and starting in a
+ * listed READ range (`code`: whose BO also carries EXEC).
+ */
+static inline int g5p_ru_v3_ref(const struct g5p_ru_v3_limits *lim,
+				const struct g5p_ru_range *r, u32 n, u32 off,
+				bool code)
+{
+	u64 va;
+	u32 i;
+
+	if (!off || (off % G5P_RU_PROGRAM_ALIGN))
+		return -EINVAL;
+	if (lim->code_window < G5P_RU_PROGRAM_MIN ||
+	    off > lim->code_window - G5P_RU_PROGRAM_MIN ||
+	    lim->pds_base > ~0ULL - off)
+		return -ERANGE;
+	va = lim->pds_base + off;
+	if (!g5p_ru_below(lim->hw_va_limit, va, G5P_RU_PROGRAM_MIN))
+		return -ERANGE;
+	if (!g5p_ru_cover(r, n, va, G5P_RU_PROGRAM_MIN, &i))
+		return -ENOENT;
+	if (!(r[i].access & G5P_RU_ACCESS_READ) ||
+	    (code && !(r[i].access & G5P_RU_ACCESS_EXEC)))
+		return -EACCES;
+	return 0;
+}
+
+/* The TYPED_V3 pixel output width. The V1 dialect takes it from the V3 field
+ * (0 = 2, the V1 dialect exactly), the V2 dialect from ext, where the V3 field
+ * must stay zero. A width above 2 is several colour targets, and a partial
+ * render must then resume with the pass's own EOT: a one-target resume EOT
+ * would store only the first target. The EOT itself is not decoded.
+ */
+static inline int g5p_ru_pass3_width(const struct g5p_ru_pass *p,
+				     const struct g5p_ru_pass2 *e,
+				     const struct g5p_ru_pass3 *v,
+				     bool dialect2, u32 *width)
+{
+	u32 w = v->pixel_width;
+
+	if (v->pad || (w && w != 2 && w != 4 && w != 8) || (dialect2 && w))
+		return -EINVAL;
+	if (dialect2)
+		w = e->pixel_width; /* 2, 4 or 8: g5p_ru_pass2_check() */
+	else if (!w)
+		w = 2;
+	if (w > 2 && memcmp(p->eot, p->eot_resume, sizeof(p->eot)))
+		return -EINVAL;
+	*width = w;
+	return 0;
+}
+
+/* The V3 rules, then the TYPED_V1 rules (all-zero ext) or the TYPED_V2 rules
+ * (any ext field set; pools zero), then the output width. base.vdm_control is
+ * checked first. On success loc names the ranges to read, the dialect and the
+ * width.
+ */
+static inline int g5p_ru_pass3_check(const struct g5p_ru_pass *p,
+				     const struct g5p_ru_pass2 *e,
+				     const struct g5p_ru_pass3 *v,
+				     const struct g5p_ru_v3_limits *lim,
+				     const struct g5p_ru_range *r, u32 n,
+				     struct g5p_ru_v3_loc *loc)
+{
+	u32 pi, vi;
+	u64 off;
+	int ret;
+
+	if (p->vdm_control)
+		return -EINVAL; /* a stream length here is the r36/r88 defect */
+	if (v->ta_program_size < G5P_RU_PROGRAM_MIN ||
+	    v->ta_program_size > DRM_G5P_RENDER_MAX_PROGRAM_BYTES ||
+	    (v->ta_program_size % G5P_RU_PROGRAM_ALIGN) ||
+	    (v->ta_program_va % G5P_RU_PROGRAM_ALIGN))
+		return -EINVAL;
+	if (p->vdm_size < 4 || p->vdm_size > G5P_RU_MAX_VDM ||
+	    ((p->vdm_va | p->vdm_size) & 3) || v->vdm_end < 4 ||
+	    v->vdm_end > p->vdm_size || (v->vdm_end & 3))
+		return -EINVAL;
+	if (v->ta_program_va < lim->pds_base)
+		return -ERANGE;
+	off = v->ta_program_va - lim->pds_base;
+	if (lim->code_window < v->ta_program_size ||
+	    off > lim->code_window - v->ta_program_size)
+		return -ERANGE;
+	if (!g5p_ru_below(lim->hw_va_limit, v->ta_program_va,
+			  v->ta_program_size) ||
+	    !g5p_ru_below(lim->hw_va_limit, p->vdm_va, p->vdm_size))
+		return -ERANGE;
+	/* Every listed range, not only the two above: on A10 a buffer moved past
+	 * the limit stalls the TA without a fault, and all buffers moved together.
+	 */
+	for (u32 i = 0; i < n; i++)
+		if (!g5p_ru_below(lim->hw_va_limit, r[i].va, r[i].size))
+			return -ERANGE;
+	if (!g5p_ru_cover(r, n, v->ta_program_va, v->ta_program_size, &pi))
+		return -ENOENT;
+	if (!(r[pi].access & G5P_RU_ACCESS_READ) ||
+	    !(r[pi].access & G5P_RU_ACCESS_EXEC))
+		return -EACCES;
+	if (!g5p_ru_cover(r, n, p->vdm_va, p->vdm_size, &vi))
+		return -ENOENT;
+	if (!(r[vi].access & G5P_RU_ACCESS_READ))
+		return -EACCES;
+	/* Context store [0] / load [1]: code at word 2 (READ and EXEC), STREAM_OUT2
+	 * at word 5 (READ). Resume tasks: word 2 (READ only: R0+0xf060/0xf070,
+	 * named stream-out by the userspace lane and aux program by r92 2.4, so
+	 * its role is unresolved and EXEC is not demanded). Words 0, 1, 3 and 4
+	 * stay opaque. The spacing (store - program = 0x280, resume - store =
+	 * 0x340) and a program that equals a task entry (r63 flew the store
+	 * program; the role is not detectable structurally) are not enforced.
+	 */
+	for (u32 i = 0; i < 2; i++) {
+		ret = g5p_ru_v3_ref(lim, r, n, p->context_pds[i][2], true);
+		if (!ret)
+			ret = g5p_ru_v3_ref(lim, r, n, p->context_pds[i][5],
+					    false);
+		if (!ret)
+			ret = g5p_ru_v3_ref(lim, r, n, p->resume_pds[i][2],
+					    false);
+		if (ret)
+			return ret;
+	}
+	loc->dialect2 = !g5p_ru_pass2_zero(e);
+	ret = loc->dialect2 ? g5p_ru_pass2_check(p, e, r, n) :
+			      g5p_ru_pass_check(p, r, n);
+	if (!ret)
+		ret = g5p_ru_pass3_width(p, e, v, loc->dialect2,
+					 &loc->pixel_width);
+	if (ret)
+		return ret;
+	loc->program_off = off;
+	loc->program_range = pi;
+	loc->vdm_range = vi;
+	return 0;
+}
+
+/* The first 16 program bytes are not all zero (r88 published 0x370, which
+ * pointed at zeros) and the last stream dword is the terminator. `head` is
+ * G5P_RU_PROGRAM_MIN bytes, `tail` the 4 stream bytes at vdm_va + vdm_end - 4.
+ */
+static inline int g5p_ru_pass3_content(const u8 *head, const u8 *tail)
+{
+	u8 any = 0;
+	u32 word = tail[0] | tail[1] << 8 | tail[2] << 16 | (u32)tail[3] << 24;
+
+	for (u32 i = 0; i < G5P_RU_PROGRAM_MIN; i++)
+		any |= head[i];
+	if (!any)
+		return -ENODATA;
+	if (word != DRM_G5P_RENDER_STREAM_TERMINATE)
+		return -EINVAL;
+	return 0;
+}
+
+/* AGXRenderTargetMemoryG5 output sanity for userspace geometry: exact one
+ * sample and the sizes the kernel will allocate. Opaque fields unchecked.
+ */
+static inline int g5p_ru_geometry_check(const struct g5p_ru_rt *rt, u32 width,
+					u32 height,
+					struct g5p_ru_rt_sizes *sizes)
+{
+	if (!width || !height || width > 16384 || height > 16384)
+		return -EINVAL;
+	if (rt->tiles > ((width + 31) / 32) * ((height + 31) / 32))
+		return -EINVAL;
+	return g5p_ru_rt_sizes(rt, sizes);
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple-g5p/vm-ranges.h b/drivers/gpu/drm/apple-g5p/vm-ranges.h
new file mode 100644
index 0000000000..25bd98ee98
--- /dev/null
+++ b/drivers/gpu/drm/apple-g5p/vm-ranges.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_COMPUTE_USER_H
+#define G5P_COMPUTE_USER_H
+
+/* Public geometry is fixed across VMs. The private ranges never alias a BO. */
+
+static const u64 g5p_private_va[] = {
+	0x300040000ULL, 0x300014000ULL, 0x300028000ULL, 0x300044000ULL, 0,
+	0x100080000ULL, 0x100084000ULL, 0x1000a0000ULL, 0x1000a4000ULL,
+};
+
+static inline bool g5p_user_private_overlap(u64 va, u64 size)
+{
+	for (u32 i = 0; i < ARRAY_SIZE(g5p_private_va); i++)
+		if (g5p_private_va[i] && va < g5p_private_va[i] + 0x4000 &&
+		    g5p_private_va[i] < va + size)
+			return true;
+	return false;
+}
+
+#endif
