@@ -22,7 +22,7 @@ struct g5p_jt {
 	bool abs_enabled;
 };
 struct g5p_jt_stats {
-	u64 jobs, failed, joint, ta_ticks, td_ticks;
+	u64 jobs, failed, joint, ahead, ta_ticks, td_ticks;
 	u64 ioctl_ns, queue_ns, prep_ns, ta_wait_ns, gap_ns, td_wait_ns;
 	u64 tail_ns, touch_ns, bell_ns, samples;
 	s64 ovh_ns;
@@ -54,6 +54,7 @@ static inline void g5p_jt_fold(struct g5p_jt_stats *s, const struct g5p_jt *j)
 	s->jobs++;
 	s->failed += j->ret != 0;
 	s->joint += !!(j->flags & 4);
+	s->ahead += !!(j->flags & 8); /* F5: started while the previous job's 3D ran */
 	if (j->ta_ticks != ~0ULL)
 		s->ta_ticks += j->ta_ticks;
 	if (j->td_ticks != ~0ULL)
diff --git a/drivers/gpu/apple-g5p/render-user-layout.h b/drivers/gpu/apple-g5p/render-user-layout.h
index 624a56a11..675e9fbe6 100644
--- a/drivers/gpu/apple-g5p/render-user-layout.h
+++ b/drivers/gpu/apple-g5p/render-user-layout.h
@@ -18,6 +18,11 @@
  */
 #define G5P_RU_PRIVATE_VA G5P_R22_AUX
 #define G5P_RU_PRIVATE_SIZE 0x1000000ULL
+/* F5: the second PM set's aux window, at the top of the private window (render targets are
+ * allocated from its bottom, so their VAs do not move).
+ */
+#define G5P_RU_AUX2_VA \
+	(G5P_RU_PRIVATE_VA + G5P_RU_PRIVATE_SIZE - 0x20000ULL)
 #define G5P_RU_USER_VA_MIN 0x40000000ULL
 /* Catalogue entry of the firmware GiB, borrowed from the boot tables. */
 #define G5P_RU_FIRMWARE_CI ((G5P_IMAGE_VA >> 30) & 1023)
@@ -642,6 +647,39 @@ static inline bool g5p_ru_retired_at(const u8 *p, u32 meta, bool td, u32 seq,
 	return true;
 }
 
+/* F5 (render_user_pipeline_depth 2): retirement of job `seq` while the later job `latest`
+ * (seq + 1) is already published on the same channel.  The firmware's tag4 dependency test is
+ * signed `(required - *stamp) <= 0` (META 0x80001a38 / 0x80000a54; kext 6c8a808 builds the
+ * record against one stamp word per identity), so a stamp only moves forward and job seq is
+ * done once both stamp words are at or past seq.  The W pointers and W sequence of seq's own
+ * slot must still be ours, and every channel watermark must lie between seq's endpoint and
+ * latest's (latest's entries may already be consumed).  latest == seq: g5p_ru_retired_at().
+ */
+static inline bool g5p_ru_retired_pl(const u8 *p, u32 meta, bool td, u32 seq,
+				     u32 js, u32 latest)
+{
+	const u8 *w = p + g5p_ru_w_at(js);
+	u32 endpoint = g5p_ru_endpoint(seq);
+	u32 span = (2 * (latest - seq)) % G5P_WORK_SLOTS;
+
+	if (latest == seq)
+		return g5p_ru_retired_at(p, meta, td, seq, js);
+	if (g5p_le32(w + (td ? 0x888 : 0x52c)) != meta + G5P_R22_STAMP ||
+	    g5p_le32(w + (td ? 0x88c : 0x530)) != meta + G5P_R22_STAMP + 4 ||
+	    g5p_le32(w + (td ? 0x890 : 0x534)) != seq ||
+	    (s32)(g5p_le32(p + G5P_R22_STAMP) - seq) < 0 ||
+	    (s32)(g5p_le32(p + G5P_R22_STAMP + 4) - seq) < 0)
+		return false;
+	for (u32 off = 0; off <= 0x40; off += 0x10) {
+		u32 ctl = g5p_le32(p + G5P_WORK_CTL + off);
+
+		if (ctl >= G5P_WORK_SLOTS ||
+		    (ctl + G5P_WORK_SLOTS - endpoint) % G5P_WORK_SLOTS > span)
+			return false;
+	}
+	return true;
+}
+
 /* A stamp beyond the published target, or a watermark not on the even
  * two-entry grid, is a protocol error rather than "not yet retired".
  */
