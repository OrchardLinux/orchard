+++ b/drivers/gpu/drm/apple-g5p/drm-render-v3.h
@@ -51,6 +51,18 @@ struct g5p_rv3 {
 	bool abs;
 	u64 bell_cyc[2];
 	bool joint; /* latched at execute entry; attach stays serial */
+	/* F5 (render_user_pipeline_depth 2, latched at execute entry): this job may start its
+	 * context's next job once its own TA completed (g5p_rv3_ahead()).
+	 */
+	bool depth2;
+	/* F5: this job was prepared and published by the previous job's executor, while that
+	 * job's 3D ran (core lock held throughout); ahead_ret is that start's result.  Its own
+	 * execute resumes at the TA wait.
+	 */
+	bool ahead;
+	int ahead_ret;
+	bool ta_disarmed; /* F5: the TA latch was disarmed at the TA decision */
+	bool pm2; /* F5: the job's PM is its context's second set */
 	bool touched; /* the DC3 pair was published: the firmware may reference the job's memory */
 	/* The bind of this job's context published its DC3 pair and then failed: that context is
 	 * lost, the device and the contexts already bound are not.
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-v3.inc b/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
index 20c350eb4..18b33b2e5 100644
--- a/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
+++ b/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
@@ -53,6 +53,32 @@
 
 static const bool render_user_abs_stamps;
 
+/*
+ * F5, depth-2 job pipelining (docs/gpu/lane-a2-ta-done-latency-spec.md §4.3; latched per job at
+ * execute entry).  1: today's serial executor.  2: once job N's TA completed, and while its 3D
+ * runs, the executor prepares and publishes (TA and 3D, joint) the next job of the *same* context
+ * if it is queued with every input signalled, then waits and retires N, and the worker resumes
+ * N+1 at its TA wait.  Apple's model: iOS kicks TA and 3D of each submission without waiting for
+ * the previous one's retire (AGXChannelQueue_submitBlockInvoke cbb948) and takes a ParamBuffer
+ * per prepare (6cb9afc).  The 3D's tag4 wait on the shared TA-finish stamp compares signed
+ * (required - *stamp) <= 0 (firmware META 0x80001a38 / 0x80000a54, kext 6c8a808), so TA N+1
+ * writing N+1 into that word never blocks N's 3D.  Never across contexts: the core lock stays
+ * held from N's TA publish to N+1's 3D retire (Henrik's 0004: TA and 3D of one job adjacent,
+ * no other context's phase between them).
+ */
+static const uint render_user_pipeline_depth = 1;
+
+/* F5: consecutive ahead starts before the executor lets one job end with the core lock released,
+ * so a VM bind or an idle step waiting for that lock is never starved by a busy context.
+ */
+#define G5P_RV3_AHEAD_CHAIN 8U
+
+/* drm-render.inc / drm-render-sched.inc, included after this file */
+static void g5p_render_cache(struct g5p_drm *d, struct g5p_rjob *job,
+			     bool to_cpu);
+static bool g5p_rsched_ready(struct g5p_rs_job *node, void *cookie,
+			     unsigned long *deadline);
+
 static const char *const g5p_rv3_phase_names[G5P_RV3_PHASES] = {
 	"idle",	   "attach",	 "bind",    "ta-publish",
 	"ta-wait", "3d-publish", "3d-wait", "done",
@@ -101,6 +127,40 @@ static struct g5p_dma_page *g5p_rv3_pm_aux(struct g5p_rdev *rd,
 	return r->pm_aux_mapped ? r->pm_aux : rd->aux;
 }
 
+/* F5: the PM of one job (pm2: its context's second set), for its records and its waits. */
+static u8 *g5p_rv3_pm_cpu_of(struct g5p_boot *b, const struct g5p_render *r,
+			     bool pm2)
+{
+	if (pm2 && r->pm2_set >= 0)
+		return b->pm_set[r->pm2_set * G5P_PMSET_PAGES + G5P_PMSET_CONTROL]
+			.cpu;
+	return g5p_rv3_pm_cpu(b, r);
+}
+
+static u32 g5p_rv3_pm_meta_of(const struct g5p_render *r, bool pm2)
+{
+	if (pm2 && r->pm2_set >= 0)
+		return g5p_meta_address(
+			g5p_pmset_va(r->pm2_set, G5P_PMSET_CONTROL));
+	return g5p_rv3_pm_meta(r);
+}
+
+static u32 g5p_rv3_pm_id_of(const struct g5p_rdev *rd,
+			    const struct g5p_render *r, bool pm2)
+{
+	if (pm2 && r->pm2_set >= 0)
+		return rd->pm_ctx >= 2 ? g5p_pmset_id(r->pm2_set) : 0;
+	return g5p_rv3_pm_id(rd, r);
+}
+
+/* F5: the 3D event latch of job seq (g5p_drm.td_want[]): its endpoint's parity, so jobs N and
+ * N + 1 never share one.
+ */
+static u32 g5p_rv3_td_latch(u32 endpoint)
+{
+	return (endpoint >> 1) & 1;
+}
+
 /* The boot tuple the V3 path is proven under (r96 params.txt), minus the instrumentation:
  * r73b/r73c/r73e/r73f, r74 with the raised IRQ cap, r74f, r74g, r87b self-drain; no r74h,
  * no r80..r96 (their IRQ banks read registers), no r75/r79 firmware control, and no fixed
@@ -321,10 +381,23 @@ static void g5p_rv3_sample_ram(struct g5p_diag *g, struct g5p_render *r, u32 e,
 			   u32 seq, struct g5p_rv3_ev *s)
 {
 	struct g5p_boot *b = g->boot;
+	struct g5p_rdev *rd = r->ctx->gpu->rdev;
+	u32 js = g5p_rv3_js(rd, seq);
 	u8 *p = g5p_ru_page(b, e), *global = g5p_ru_global(b, e),
-	   *pm = g5p_rv3_pm_cpu(b, r);
+	   *pm = g5p_rv3_pm_cpu_of(b, r, r->js_pm2[js]);
 	u32 *ring = (u32 *)g5p_boot_shared(b, e ? 0x64 : 0x60);
+	/* F5: the device's latest published job; seq + 1 when the next job was started ahead.
+	 * Then this job's ring entry is the one before the producer, its stamps may already be
+	 * past seq, and its watermarks may already be on the next job's entries, once that job's
+	 * phase on this engine is published (r->submitted[e] is the next job's).  Otherwise
+	 * latest == seq: exactly the serial predicates.
+	 */
+	u32 latest = rd->sequence, target = r->target[e];
 
+	if (latest - seq == 1 && r->submitted[e])
+		target = (target - 1) & 255;
+	else
+		latest = seq;
 	memset(s, 0, sizeof(*s));
 	dma_rmb();
 	s->ns = ktime_get_ns();
@@ -339,16 +412,18 @@ static void g5p_rv3_sample_ram(struct g5p_diag *g, struct g5p_render *r, u32 e,
 	s->pm80 = g5p_le32(pm + 0x80);
 	s->failed = READ_ONCE(b->failed) || READ_ONCE(b->event_failed);
 	s->proto = s->prod != r->target[e] || s->cons > 255 ||
-		   !g5p_ru_stamp_sane(p, seq);
-	s->consumed = s->cons == r->target[e];
+		   !g5p_ru_stamp_sane(p, latest);
+	/* consumed: the consumer reached this job's entry (serial: == the producer) */
+	s->consumed = s->cons <= 255 &&
+		      ((s->cons - target) & 255) <= ((s->prod - target) & 255);
 	/* The predicates of the flown r74b (TA) and r96 (3D) waits; the 3D's PM serial is a receipt. */
 	s->idle_ok = !s->idle[0] && !s->idle[1] && !s->idle[2] &&
 		     (!e || (!s->idle[4] && !s->idle[5]));
-	s->retired = g5p_ru_retired_at(p, g5p_ru_meta(e), e, seq,
-				       g5p_rv3_js(r->ctx->gpu->rdev, seq));
-	s->pm_ok = e ? s->pm80 == r->ctx->gpu->rdev->pm_serial + 1 :
+	s->retired = g5p_ru_retired_pl(p, g5p_ru_meta(e), e, seq, js, latest);
+	s->pm_ok = e ? s->pm80 == rd->pm_serial + 1 :
 		       g5p_r22_pm_saved(pm + 0x80);
-	s->event = !!(e ? READ_ONCE(r->ctx->gpu->td_hit_ns) :
+	s->event = !!(e ? READ_ONCE(r->ctx->gpu->td_hit_ns[g5p_rv3_td_latch(
+				  g5p_ru_endpoint(seq))]) :
 			  READ_ONCE(r->ctx->gpu->ta_hit_ns));
 }
 
@@ -453,12 +528,14 @@ static void g5p_rv3_event_arm(struct g5p_drm *d, u32 e, u32 endpoint)
 	unsigned long flags;
 
 	BUILD_BUG_ON(G5P_RU_RT_GRID != G5P_WORK_SLOTS);
+	u32 k = g5p_rv3_td_latch(endpoint);
+
 	spin_lock_irqsave(&d->status_lock, flags);
 	if (e) {
-		d->td_want = G5P_RV3_TD_WANT | endpoint;
-		WRITE_ONCE(d->td_hit_ns, 0);
-		d->td_hit_cyc = d->td_hard_cyc = 0;
-		d->td_src = 0;
+		d->td_want[k] = G5P_RV3_TD_WANT | endpoint;
+		WRITE_ONCE(d->td_hit_ns[k], 0);
+		d->td_hit_cyc[k] = d->td_hard_cyc[k] = 0;
+		d->td_src[k] = 0;
 	} else {
 		d->ta_want = true;
 		WRITE_ONCE(d->ta_hit_ns, 0);
@@ -468,24 +545,28 @@ static void g5p_rv3_event_arm(struct g5p_drm *d, u32 e, u32 endpoint)
 	spin_unlock_irqrestore(&d->status_lock, flags);
 }
 
-/* Disarm engine e's latch and return the decode time of the matching event (0 = none). */
-static u64 g5p_rv3_event_disarm(struct g5p_drm *d, u32 e, struct g5p_jt *jt)
+/* Disarm engine e's latch (3D: job seq's) and return the decode time of the matching event
+ * (0 = none).
+ */
+static u64 g5p_rv3_event_disarm(struct g5p_drm *d, u32 e, u32 seq,
+				struct g5p_jt *jt)
 {
+	u32 k = g5p_rv3_td_latch(g5p_ru_endpoint(seq));
 	unsigned long flags;
 	u64 hit;
 
 	spin_lock_irqsave(&d->status_lock, flags);
 	if (e) {
-		d->td_want = 0;
-		hit = d->td_hit_ns;
+		d->td_want[k] = 0;
+		hit = d->td_hit_ns[k];
 	} else {
 		d->ta_want = false;
 		hit = d->ta_hit_ns;
 	}
 	if (jt) {
-		jt->hit_cyc[e] = e ? d->td_hit_cyc : d->ta_hit_cyc;
-		jt->hard_cyc[e] = e ? d->td_hard_cyc : d->ta_hard_cyc;
-		jt->src[e] = e ? d->td_src : d->ta_src;
+		jt->hit_cyc[e] = e ? d->td_hit_cyc[k] : d->ta_hit_cyc;
+		jt->hard_cyc[e] = e ? d->td_hard_cyc[k] : d->ta_hard_cyc;
+		jt->src[e] = e ? d->td_src[k] : d->ta_src;
 	}
