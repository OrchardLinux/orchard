-	u32 td_want;
-	u64 td_hit_ns, td_hit_cyc, td_hard_cyc;
-	u8 td_src;
+	u32 td_want[2];
+	u64 td_hit_ns[2], td_hit_cyc[2], td_hard_cyc[2];
+	u8 td_src[2];
 	/* The TA's latch: armed while a TA phase is published; ta_hit_ns as td_hit_ns. */
 	bool ta_want;
 	u64 ta_hit_ns, ta_hit_cyc, ta_hard_cyc;
@@ -280,12 +282,12 @@ static int g5p_gpu_stats_show(struct seq_file *m, void *unused)
 	spin_unlock_irqrestore(&d->status_lock, flags);
 	seq_printf(
 		m,
-		"now_ns=%llu since_ns=%llu jobs=%llu failed=%llu ta_ticks=%llu td_ticks=%llu ioctl_ns=%llu queue_ns=%llu prep_ns=%llu ta_wait_ns=%llu gap_ns=%llu td_wait_ns=%llu tail_ns=%llu touch_ns=%llu bell_ns=%llu samples=%llu ta_irq_ns=%llu td_irq_ns=%llu ta_decide_ns=%llu td_decide_ns=%llu joint=%llu ovh_ns=%lld\n",
+		"now_ns=%llu since_ns=%llu jobs=%llu failed=%llu ta_ticks=%llu td_ticks=%llu ioctl_ns=%llu queue_ns=%llu prep_ns=%llu ta_wait_ns=%llu gap_ns=%llu td_wait_ns=%llu tail_ns=%llu touch_ns=%llu bell_ns=%llu samples=%llu ta_irq_ns=%llu td_irq_ns=%llu ta_decide_ns=%llu td_decide_ns=%llu joint=%llu ovh_ns=%lld ahead=%llu\n",
 		now, s.since_ns, s.jobs, s.failed, s.ta_ticks, s.td_ticks,
 		s.ioctl_ns, s.queue_ns, s.prep_ns, s.ta_wait_ns, s.gap_ns,
 		s.td_wait_ns, s.tail_ns, s.touch_ns, s.bell_ns, s.samples,
 		s.ta_irq_ns, s.td_irq_ns, s.ta_decide_ns, s.td_decide_ns,
-		s.joint, s.ovh_ns);
+		s.joint, s.ovh_ns, s.ahead);
 	return 0;
 }
 static int g5p_gpu_stats_open(struct inode *inode, struct file *file)
@@ -599,12 +601,14 @@ static void g5p_drm_event(void *cookie, const u32 words[11])
 	if (words[0] == 1)
 		for (u32 i = 0; i < 4; i++)
 			d->notifications[i] |= words[i + 1];
-	if (d->td_want && !d->td_hit_ns &&
-	    g5p_ru_rt_event_match(words, d->td_want & 0xff)) {
-		WRITE_ONCE(d->td_hit_ns, ktime_get_ns());
-		d->td_hit_cyc = arch_timer_read_counter();
-		d->td_hard_cyc = READ_ONCE(d->core->boot->hard_cyc);
-		d->td_src = current == READ_ONCE(d->core->boot->irq_task) ? 1 : 2;
+	for (u32 k = 0; k < 2; k++) {
+		if (!d->td_want[k] || d->td_hit_ns[k] ||
+		    !g5p_ru_rt_event_match(words, d->td_want[k] & 0xff))
+			continue;
+		WRITE_ONCE(d->td_hit_ns[k], ktime_get_ns());
+		d->td_hit_cyc[k] = arch_timer_read_counter();
+		d->td_hard_cyc[k] = READ_ONCE(d->core->boot->hard_cyc);
+		d->td_src[k] = current == READ_ONCE(d->core->boot->irq_task) ? 1 : 2;
 	}
 	if (d->ta_want && !d->ta_hit_ns && g5p_ru_ta_event_match(words)) {
 		WRITE_ONCE(d->ta_hit_ns, ktime_get_ns());
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-sched.inc b/drivers/gpu/drm/apple-g5p/drm-render-sched.inc
index 21dc64d89..3b3ce4b17 100644
--- a/drivers/gpu/drm/apple-g5p/drm-render-sched.inc
+++ b/drivers/gpu/drm/apple-g5p/drm-render-sched.inc
@@ -162,6 +162,19 @@ static void g5p_rsched_work(struct work_struct *work)
 		bool has_wake;
 		int what;
 
+		/* F5: the job the previous one started ahead runs first, before any drain, recovery
+		 * or pick: it is on the hardware (or fails at once with its lost context).
+		 */
+		if (rd->ahead) {
+			struct g5p_rjob *next = rd->ahead;
+
+			rd->ahead = NULL;
+			g5p_render_run(next);
+			/* not while the core lock is kept for a further ahead job */
+			if (!rd->ahead)
+				g5p_render_close_deferred(d);
+			continue;
+		}
 		/* A lost job blocks the channel: hold every job until the drain is decided, and
 		 * until a recovery the drain or the executor asked for has run.
 		 */
@@ -186,7 +199,8 @@ static void g5p_rsched_work(struct work_struct *work)
 		if (what == G5P_RS_JOB) {
 			g5p_render_run(
 				container_of(node, struct g5p_rjob, node));
-			g5p_render_close_deferred(d);
+			if (!rd->ahead)
+				g5p_render_close_deferred(d);
 			continue;
 		}
 		r = container_of(e, struct g5p_render, entity);
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-v3.h b/drivers/gpu/drm/apple-g5p/drm-render-v3.h
index 67870e050..db2af8af7 100644
