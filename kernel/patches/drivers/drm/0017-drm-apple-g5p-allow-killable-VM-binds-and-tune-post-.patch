From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 10 Nov 2026 15:07:46 +0000
Subject: [PATCH] drm/apple-g5p: allow killable VM binds and tune post-event
 polling

[Orchard: from brkosebay/linux 9f3f6272edeaea964aa638a6c8bac8cee516a72c;
fixed source defaults, no production module controls.] Preserve the
measured opt1 chain in dependency order.

Assisted-by: LLM
---
 drivers/gpu/apple-g5p/render-user-evwait.h   | 12 +++++-------
 drivers/gpu/drm/apple-g5p/drm-compute-v1.inc |  3 ++-
 drivers/gpu/drm/apple-g5p/drm-latency123.inc | 14 +++++++++-----
 drivers/gpu/drm/apple-g5p/drm-vm.inc         |  8 ++++++--
 4 files changed, 22 insertions(+), 15 deletions(-)

diff --git a/drivers/gpu/apple-g5p/render-user-evwait.h b/drivers/gpu/apple-g5p/render-user-evwait.h
index 5a14b32db..dc4a8d5c6 100644
--- a/drivers/gpu/apple-g5p/render-user-evwait.h
+++ b/drivers/gpu/apple-g5p/render-user-evwait.h
@@ -11,22 +11,20 @@
  * without an event; the predicate stays level-triggered on every sample, as before.
  * Once the phase's own completion event is latched (s->event) but the RAM rules still wait
  * (idle words, retire stamp, PM receipt land a little after the event), the pause is a short
- * G5P_EW_POST_US poll: there is no further event to wait for.
+ * post_us poll: there is no further event to wait for.
  */
 #ifndef G5P_RENDER_USER_EVWAIT_H
 #define G5P_RENDER_USER_EVWAIT_H
 
-#define G5P_EW_POST_US \
-	50U /* after the phase's own event: completion is imminent */
 #define G5P_EW_MAX_US 20000U /* safety timeout ceiling */
 
 enum g5p_ew_act {
 	G5P_EW_LEGACY, /* render_user_event_wake 0: usleep_range(1000, 2000), release8 */
-	G5P_EW_SHORT, /* the phase's event seen: sleep G5P_EW_POST_US */
+	G5P_EW_SHORT, /* the phase's event seen: sleep post_us */
 	G5P_EW_EVENT, /* sleep until any event since `seen`, at most *wait_us */
 };
 
-static inline enum g5p_ew_act g5p_ew_plan(u32 knob_us, bool phase_event,
+static inline enum g5p_ew_act g5p_ew_plan(u32 knob_us, u32 post_us, bool phase_event,
 					  u32 *wait_us)
 {
 	if (!knob_us) {
@@ -34,10 +32,10 @@ static inline enum g5p_ew_act g5p_ew_plan(u32 knob_us, bool phase_event,
 		return G5P_EW_LEGACY;
 	}
 	if (phase_event) {
-		*wait_us = G5P_EW_POST_US;
+		*wait_us = post_us;
 		return G5P_EW_SHORT;
 	}
-	*wait_us = knob_us < G5P_EW_POST_US ? G5P_EW_POST_US :
+	*wait_us = knob_us < post_us ? post_us :
 		   knob_us > G5P_EW_MAX_US  ? G5P_EW_MAX_US :
 					      knob_us;
 	return G5P_EW_EVENT;
diff --git a/drivers/gpu/drm/apple-g5p/drm-compute-v1.inc b/drivers/gpu/drm/apple-g5p/drm-compute-v1.inc
index d09e56c37..2873ca73c 100644
--- a/drivers/gpu/drm/apple-g5p/drm-compute-v1.inc
+++ b/drivers/gpu/drm/apple-g5p/drm-compute-v1.inc
@@ -95,7 +95,8 @@ static void g5p_cu_pause(struct g5p_drm *d, u64 seen)
 {
 	u32 wait_us;
 
-	if (g5p_ew_plan(READ_ONCE(render_user_event_wake), false, &wait_us) ==
+	if (g5p_ew_plan(READ_ONCE(render_user_event_wake), 50U, false,
+			&wait_us) ==
 	    G5P_EW_LEGACY) {
 		usleep_range(1000, 2000);
 		return;
diff --git a/drivers/gpu/drm/apple-g5p/drm-latency123.inc b/drivers/gpu/drm/apple-g5p/drm-latency123.inc
index 1d3c42192..a08b0d422 100644
--- a/drivers/gpu/drm/apple-g5p/drm-latency123.inc
+++ b/drivers/gpu/drm/apple-g5p/drm-latency123.inc
@@ -45,7 +45,7 @@ static struct {
 	u32 pmgr[2];
 	bool seen[2], idle[2], probed;
 	/* render_user_event_wake: pauses ended by an event, the timeout, a post-event poll, legacy */
-	u32 ew[4];
+	u32 ew[4], post_us;
 	u64 ew_ns;
 } g5p_l123;
 
@@ -55,8 +55,11 @@ MODULE_PARM_DESC(
 	render_user_event_wake,
 	"perf60 default0 (release8: sleep 1-2 ms between completion samples); N: sleep "
 	"until the next firmware event (the IRQ thread's decode wakes the waiter), at "
-	"most N us (100..20000) as the safety net, and poll every 50 us once the "
-	"phase's own completion event is latched; read live");
+	"most N us (post-event interval..20000) as the safety net, and poll at "
+	"render_user_post_event_us once the phase's own completion event is latched; read live");
+
+/* Sample once per job so a live update cannot change an in-flight wait. */
+static const unsigned int render_user_post_event_us = 50;
 
 /* A word of a firmware object; objects may straddle the region's 16 KiB pages. */
 static u8 *g5p_l123_word(struct g5p_boot *b, u32 slot, u32 field)
@@ -135,6 +138,7 @@ static void g5p_l123_job_reset(struct g5p_diag *g)
 	g5p_l123.probed = false;
 	memset(g5p_l123.ew, 0, sizeof(g5p_l123.ew));
 	g5p_l123.ew_ns = 0;
+	g5p_l123.post_us = clamp(READ_ONCE(render_user_post_event_us), 10U, 100U);
 	g5p_l123.seen[0] = false;
 	g5p_l123.seen[1] = false;
 	g5p_l123.us = (0);
@@ -256,8 +260,8 @@ static void g5p_l123_pause(struct g5p_drm *d, struct g5p_diag *g, u32 e,
 		g5p_l123_evict(g->boot);
 		g5p_l123.next_ns = now + (u64)g5p_l123.us * NSEC_PER_USEC;
 	}
-	act = g5p_ew_plan(READ_ONCE(render_user_event_wake), s->event,
-			  &wait_us);
+	act = g5p_ew_plan(READ_ONCE(render_user_event_wake), g5p_l123.post_us,
+			  s->event, &wait_us);
 	t0 = ktime_get_ns();
 	if (act == G5P_EW_LEGACY) {
 		usleep_range(1000, 2000);
diff --git a/drivers/gpu/drm/apple-g5p/drm-vm.inc b/drivers/gpu/drm/apple-g5p/drm-vm.inc
index 644554156..b244922d5 100644
--- a/drivers/gpu/drm/apple-g5p/drm-vm.inc
+++ b/drivers/gpu/drm/apple-g5p/drm-vm.inc
@@ -768,7 +768,8 @@ static int g5p_vm_bind(struct drm_device *drm, void *data,
 	    (a->op != DRM_G5P_VM_MAP && a->op != DRM_G5P_VM_UNMAP) ||
 	    (a->op == DRM_G5P_VM_UNMAP && (a->bo || a->offset)))
 		return -EINVAL;
-	mutex_lock(&f->lock);
+	if (mutex_lock_killable(&f->lock))
+		return -EINTR;
 	vm = xa_load(&f->vms, a->vm);
 	if (!vm)
 		goto out;
@@ -799,7 +800,10 @@ static int g5p_vm_bind(struct drm_device *drm, void *data,
 		 * compute still uses the global mutex.
 		 */
 		if (!vm->resident->render) {
-			mutex_lock(&to_g5p(drm)->core->lock);
+			if (mutex_lock_killable(&to_g5p(drm)->core->lock)) {
+				ret = -EINTR;
+				goto out;
+			}
 			locked = true;
 		}
 		resident = true;
