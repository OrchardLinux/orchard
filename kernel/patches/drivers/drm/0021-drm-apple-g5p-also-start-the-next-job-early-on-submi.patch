+++ b/drivers/gpu/apple-g5p/render-user-jobtime.h
@@ -20,10 +20,15 @@ struct g5p_jt {
 	u64 prev_signal_cyc;
 	u8 src[2];
 	u8 dep_own, dep_full, why;
+	/* F5c: 1 = this job started its context's next job from its 3D wait (render_user_ahead_on_submit);
+	 * why keeps the TA-decision reason.  The started job has flags bit 4 (and bit 3, as F5).
+	 */
+	u8 late;
 	bool abs_enabled;
 };
 struct g5p_jt_stats {
 	u64 dep_own, dep_full, why[16];
+	u64 ahead_late, late_why[16]; /* F5c: late starts; by the starter's TA-decision why */
 	u64 jobs, failed, joint, ahead, ta_ticks, td_ticks;
 	u64 ioctl_ns, queue_ns, prep_ns, ta_wait_ns, gap_ns, td_wait_ns;
 	u64 tail_ns, touch_ns, bell_ns, samples;
@@ -60,6 +65,8 @@ static inline void g5p_jt_fold(struct g5p_jt_stats *s, const struct g5p_jt *j)
 	s->failed += j->ret != 0;
 	s->joint += !!(j->flags & 4);
 	s->ahead += !!(j->flags & 8); /* F5: started while the previous job's 3D ran */
+	s->ahead_late += !!(j->flags & 16); /* F5c: ... from that job's 3D wait (counted in ahead too) */
+	if (j->late && j->why < 16) s->late_why[j->why]++;
 	if (j->ta_ticks != ~0ULL)
 		s->ta_ticks += j->ta_ticks;
 	if (j->td_ticks != ~0ULL)
