 	/* The bind of this job's context published its DC3 pair and then failed: that context is
diff --git a/drivers/gpu/drm/apple-g5p/drm-render-v3.inc b/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
index 85cb08d38..0e308c96b 100644
--- a/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
+++ b/drivers/gpu/drm/apple-g5p/drm-render-v3.inc
@@ -76,6 +76,54 @@ static const uint render_user_pipeline_depth = 1;
  */
 #define G5P_RV3_AHEAD_CHAIN 8U
 
+/*
+ * F5c: F5 decides once, at job N's TA completion; a job pushed (or whose inputs signal) while N's
+ * 3D still runs then waited for N's retire.  With this set, N's 3D wait re-runs that same decision
+ * (g5p_rv3_ahead(), the worker, core lock held) whenever a push or a queued head's signalled input
+ * bumps d->ahead_poke, until a job is started or N's 3D is seen done.  Apple kicks on submit
+ * (AGXChannelQueue_submitBlockInvoke).  A no-op at render_user_pipeline_depth 1.
+ */
+static const bool render_user_ahead_on_submit = true;
+
+/* F5c: a job joined a FIFO, or a queued head's input signalled.  Any context: the submit path,
+ * or a fence callback under the fence lock (possibly hard IRQ): a counter and a wake only, never
+ * the start itself.  The full barrier orders the FIFO add (or the signal) before the armed look,
+ * against the executor's armed store before its FIFO look (g5p_rv3_late_arm()).
+ */
+static void g5p_rv3_ahead_poke(struct g5p_drm *d)
+{
+	smp_mb();
+	if (!READ_ONCE(d->ahead_late_armed))
+		return;
+	atomic_inc(&d->ahead_poke);
+	wake_up(&d->ev_wq);
+}
+
+/* F5c, worker: job v's 3D wait may re-try the early start (render_user_ahead_on_submit).  Before
+ * the TA-decision try, so that try is the first look after arming: no poke can be missed.
+ */
+static void g5p_rv3_late_arm(struct g5p_drm *d, struct g5p_rv3 *v)
+{
+	if (!v->depth2 || !READ_ONCE(render_user_ahead_on_submit))
+		return;
+	WRITE_ONCE(d->ahead_late_armed, true);
+	smp_mb();
+	v->late_poke = atomic_read(&d->ahead_poke);
+	v->late = true;
+}
+
+static void g5p_rv3_late_disarm(struct g5p_drm *d, struct g5p_rv3 *v)
+{
+	if (!v->late)
+		return;
+	v->late = false;
+	WRITE_ONCE(d->ahead_late_armed, false);
+}
+
+struct g5p_rjob;
+static void g5p_rv3_ahead_late(struct g5p_drm *d, struct g5p_render *r,
+			       struct g5p_rjob *cur, const struct g5p_rv3_ev *s);
+
 /* drm-render.inc / drm-render-sched.inc, included after this file */
 static void g5p_render_cache(struct g5p_drm *d, struct g5p_rjob *job,
 			     bool to_cpu);
@@ -660,11 +708,14 @@ static void g5p_rv3_np_end(struct g5p_diag *g, u32 e, u32 seq, u32 result)
  * touch instant is taken after a step that left the phase undecided, before the sleep (off: never).
  * The predicate is level-triggered: every sample, including the one right after each sleep and the
  * closing one at the deadline, re-reads the whole RAM state (rt: the 3D, ta: the TA).
+ * late (F5c, the executor's own 3D wait of a depth-2 job; else NULL): after a sample that left the
+ * phase undecided, re-try the early start of the context's next job if poked (g5p_rv3_ahead_late()).
  */
 static u32 g5p_rv3_wait(struct g5p_diag *g, struct g5p_render *r, u32 e,
 			u32 seq, struct g5p_ru_wait *w, struct g5p_ru_touch *t,
 			struct g5p_ru_retire *rt, struct g5p_ru_ta *ta,
-			struct g5p_rv3_ev *s, u64 *consumed_ns, int *err)
+			struct g5p_rv3_ev *s, u64 *consumed_ns, int *err,
+			struct g5p_rjob *late)
 {
 	struct g5p_drm *d = r->ctx->gpu;
 	bool closing = false, slow = false, sampled = false;
@@ -722,7 +773,11 @@ static u32 g5p_rv3_wait(struct g5p_diag *g, struct g5p_render *r, u32 e,
 		}
 		if (g5p_ru_touch_due(t, s->ns, w->result, w->expired))
 			g5p_rv3_touch(g, t, s->ns);
-		g5p_l123_pause(d, g, e, s, seen);
+		if (late && !fault)
+			g5p_rv3_ahead_late(d, r, late, s);
+		g5p_l123_pause(d, g, e, s, seen,
+			       late && late->rv3.late ? &late->rv3.late_poke :
+							NULL);
 	}
 }
 
@@ -2999,10 +3054,12 @@ out:
 
 /* F5: after job `cur`'s TA completed, start its context's next job if it may (core lock held).
  * The second PM set is made ready (taken and built at the context's first pipelined job) only
- * when there is a next job to use it.
+ * when there is a next job to use it.  late (F5c): the same decision re-run from cur's 3D wait
+ * (g5p_rv3_ahead_late()); it keeps cur's TA-decision why and F5's skip count, and marks a start
+ * (cur->jt.late, the started job's flags bit 4).
  */
 static void g5p_rv3_ahead(struct g5p_drm *d, struct g5p_render *r,
-			  struct g5p_rjob *cur)
+			  struct g5p_rjob *cur, bool late)
 {
 	struct g5p_rdev *rd = d->rdev;
 	bool pm2 = !r->js_pm2[g5p_rv3_js(rd, cur->rv3.seq)];
@@ -3015,18 +3072,61 @@ static void g5p_rv3_ahead(struct g5p_drm *d, struct g5p_render *r,
 	else if (pm2 && !g5p_rv3_pm2_ready(d, r, cur->rv3.seq + 1)) why = 13;
 	else why = 0;
 	if (why) {
-		cur->jt.why = why;
-		rd->ahead_skipped++;
+		if (!late) {
+			cur->jt.why = why;
+			rd->ahead_skipped++;
+		}
 		return;
 	}
 	next = g5p_rv3_ahead_next(d, r, true, NULL);
 	if (!next) {
-		cur->jt.why = 14;
-		rd->ahead_skipped++;
+		if (!late) {
+			cur->jt.why = 14;
+			rd->ahead_skipped++;
+		}
 		return;
 	}
-	cur->jt.why = 1;
+	if (late)
+		cur->jt.late = 1;
+	else
+		cur->jt.why = 1;
 	g5p_rv3_ahead_start(d, r, cur, next);
+	if (late)
+		next->jt.flags |= BIT(4);
+}
+
+/*
+ * F5c: from job cur's own 3D wait (worker, core lock held, after a sample that left the phase
+ * undecided and saw no fault), when d->ahead_poke moved: re-run g5p_rv3_ahead() as at the TA
+ * decision.  Race-free against the 3D's completion and the pick: all of it runs in the one worker,
+ * inside cur's execute, before the wait can return, so the scheduler cannot pick meanwhile; the
+ * head leaves its FIFO only through g5p_rv3_ahead_next(pop) under sched_lock, and rd->ahead set
+ * makes every further try a no-op (g5p_rv3_ahead_why() 4, and the arm is dropped).  A 3D seen done
+ * (stamps landed in the last sample, or its completion event latched) drops the arm instead: the
+ * wait retires cur and the worker picks the next job normally.
+ */
+static void g5p_rv3_ahead_late(struct g5p_drm *d, struct g5p_render *r,
+			       struct g5p_rjob *cur, const struct g5p_rv3_ev *s)
+{
+	struct g5p_rv3 *v = &cur->rv3;
+	int poke;
+
+	if (!v->late)
+		return;
+	poke = atomic_read(&d->ahead_poke);
+	if (poke == v->late_poke)
+		return;
+	v->late_poke = poke;
+	smp_mb(); /* the poke read before the FIFO look: a later push pokes again */
+	if (s->retired || s->event || d->rdev->ahead ||
+	    d->rdev->sequence != v->seq ||
+	    READ_ONCE(d->td_hit_ns[g5p_rv3_td_latch(g5p_ru_endpoint(v->seq))])) {
+		g5p_rv3_late_disarm(d, v);
+		return;
+	}
+	g5p_rv3_ahead(d, r, cur, true);
+	if (d->rdev->ahead)
+		g5p_rv3_late_disarm(d, v);
 }
 
