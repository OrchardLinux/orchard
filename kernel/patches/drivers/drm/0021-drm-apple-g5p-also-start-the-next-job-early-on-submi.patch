 	bool ahead;
 	int ahead_ret;
 	bool ta_disarmed; /* F5: the TA latch was disarmed at the TA decision */
+	/* F5c (render_user_ahead_on_submit): this job's 3D wait re-tries the early start of its
+	 * context's next job when the device's ahead_poke moves past late_poke (a push, or a queued
+	 * head's input signalled).  Set at the TA decision, cleared once a job is started ahead or
