 drivers/gpu/drm/apple-g5p/a9-gpu-drm.c        |  20 ++-
 drivers/gpu/drm/apple-g5p/drm-latency123.inc  |  11 +-
 .../gpu/drm/apple-g5p/drm-render-sched.inc    |   2 +
 drivers/gpu/drm/apple-g5p/drm-render-v3.h     |   7 +
 drivers/gpu/drm/apple-g5p/drm-render-v3.inc   | 134 ++++++++++++++++--
 6 files changed, 160 insertions(+), 21 deletions(-)

diff --git a/drivers/gpu/apple-g5p/render-user-jobtime.h b/drivers/gpu/apple-g5p/render-user-jobtime.h
index 96ae1d258..501da66fb 100644
