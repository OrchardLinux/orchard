From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Thu, 5 Nov 2026 09:01:41 +0000
Subject: [PATCH] dt-bindings: gpu: describe the S8003 G5P resources

Describe the inherited compatible and the two register windows, five IRQs and graphics power domain. The legacy vendor spelling remains a review concern.

Assisted-by: LLM
---
 .../bindings/gpu/apple,s8003-g5p.yaml         | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/gpu/apple,s8003-g5p.yaml

diff --git a/Documentation/devicetree/bindings/gpu/apple,s8003-g5p.yaml b/Documentation/devicetree/bindings/gpu/apple,s8003-g5p.yaml
new file mode 100644
index 0000000000..699c3492fa
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpu/apple,s8003-g5p.yaml
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpu/apple,s8003-g5p.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Apple S8003 G5P GPU
+maintainers:
+  - Berkay Kösebay <brkosebay@users.noreply.github.com>
+description: |
+  G5P GPU with META firmware on S8003. The compatible is Apple's inherited
+  ADT spelling used by the qualified driver; no new vendor prefix is implied.
+properties:
+  compatible:
+    const: gpu,s8003
+  reg:
+    maxItems: 2
+  reg-names:
+    items:
+      - const: rgx
+      - const: fender
+  interrupts:
+    minItems: 5
+    maxItems: 5
+  power-domains:
+    maxItems: 1
+required: [compatible, reg, reg-names, interrupts, power-domains]
+additionalProperties: false
