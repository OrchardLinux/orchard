From a2f23b5b992ce6852ce946c0813bba842f88286c Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 24 Nov 2026 05:22:52 +0800
Subject: [PATCH] drm/adbe: Run the display DART self-check on a copy of the
 boot picture

On the iPad 6 the screen flashes a noise pattern about four seconds into
boot, where the boot splash was: the self-check before translated scanout
shows its own test image for about a dozen frames, and the user sees it.

Build the test image from the boot framebuffer instead. The bypass and the
translated steps then scan out the same picture the pipe already shows.
For the permuted step, swap two adjacent 16 KiB pages whose bytes are
identical (rows of uniform splash background) and mark the first pixel of
the lower one in the low bits of each channel. The permuted CRC still has
to differ from the reference, and nothing else in RAM carries the mark,
so the check proves the same as before: the reference is live, the
nonidentity mapping fetches the right pages, and the page permutation
takes effect. On screen, one pixel changes by 8/255 per channel for those
frames. Only if no two adjacent pages match does the swap move a visible
strip: the first two pages, a few rows at the top edge.

Affects: Apple A8, A9 and A10 display scanout.

Assisted-by: LLM
---
 drivers/gpu/drm/adbe/adbe_drv.c | 92 ++++++++++++++++++++-------------
 1 file changed, 55 insertions(+), 37 deletions(-)

diff --git a/drivers/gpu/drm/adbe/adbe_drv.c b/drivers/gpu/drm/adbe/adbe_drv.c
index 0c7058f..1db211a 100644
--- a/drivers/gpu/drm/adbe/adbe_drv.c
+++ b/drivers/gpu/drm/adbe/adbe_drv.c
@@ -238,6 +238,8 @@
 /* Smallest IOVA window left below the boot framebuffer for allocations. */
 #define ADBE_DART_MIN_WINDOW	SZ_256M
 #define ADBE_VERIFY_PAGE	SZ_16K
+/* Low bits of each colour channel: invisible on one pixel, kept by dithering. */
+#define ADBE_VERIFY_MARK	0x00080808
 #define ADBE_VERIFY_IOVA_START	SZ_16M
 
 static bool dart_scanout = true;
@@ -1405,20 +1407,49 @@ static int adbe_verify_aliases(u32 boot, u32 scratch, size_t len, u32 alias[2])
 	return -ENOSPC;
 }
 
+/* The test picture is a copy of what the pipe shows, so every step looks
+ * like the boot framebuffer. Two 16 KiB pages with identical bytes are
+ * swapped for the permuted step; the first pixel of the lower one carries a
+ * mark, so the swap moves exactly one changed pixel and the CRC must differ.
+ * A copy of RAM elsewhere cannot match either, as nothing else has the mark.
+ * Without two identical pages, the first two are swapped and that strip of
+ * the picture changes for the few frames of the permuted step.
+ */
+static void adbe_verify_copy(struct adbe *adbe, __le32 *pixels, size_t len,
+			     unsigned int *swap)
+{
+	size_t shown = min(len, adbe->fb_size);
+	unsigned int pages = shown / ADBE_VERIFY_PAGE, i;
+	u8 *bytes = (u8 *)pixels;
+
+	memcpy_fromio(pixels, adbe->boot_va, shown);
+	memset(bytes + shown, 0, len - shown);
+	*swap = 0;
+	for (i = 0; i + 1 < pages; i++) {
+		if (!memcmp(bytes + i * ADBE_VERIFY_PAGE,
+			    bytes + (i + 1) * ADBE_VERIFY_PAGE, ADBE_VERIFY_PAGE)) {
+			*swap = i;
+			break;
+		}
+	}
+	pixels[*swap * ADBE_VERIFY_PAGE / sizeof(*pixels)] ^=
+		cpu_to_le32(ADBE_VERIFY_MARK);
+}
+
 /* Same allocator as adbe_dumb_create(), before drm_dev_set_dma_dev(): the
  * parent is still in direct-DMA mode. Verify physical contiguity from its
  * exported sg table instead of treating an opaque DMA handle as a PA.
  */
 static struct drm_gem_dma_object *adbe_verify_pattern(struct adbe *adbe,
-						    size_t len, phys_addr_t *pa, u32 *bus)
+						    size_t len, phys_addr_t *pa, u32 *bus,
+						    unsigned int *swap)
 {
 	struct drm_gem_dma_object *obj;
 	struct sg_table *sgt;
 	struct scatterlist *sg;
 	phys_addr_t next;
-	size_t bytes = 0, off;
+	size_t bytes = 0;
 	unsigned int i;
-	__le32 *pixels;
 	int ret = -ERANGE;
 
 	obj = drm_gem_dma_create(&adbe->drm, len);
@@ -1442,19 +1473,9 @@ static struct drm_gem_dma_object *adbe_verify_pattern(struct adbe *adbe,
 	if (bytes < len || !IS_ALIGNED(*pa, ADBE_VERIFY_PAGE) ||
 	    !adbe_cpu_to_bus(adbe, *pa, len, bus))
 		goto put;
-	pixels = obj->vaddr;
-	for (off = 0; off < len; off += sizeof(*pixels)) {
-		u32 x = (off % adbe->pitch) / sizeof(*pixels);
-		u32 y = off / adbe->pitch;
-		u32 value = (x * 0x9e3779b1U) ^ (y * 0x85ebca77U);
-
-		/* A distinct opaque marker at every 16 KiB page's first pixel
-		 * guarantees that no two test pages contain the same bytes.
-		 */
-		if (!(off % ADBE_VERIFY_PAGE))
-			value = off / ADBE_VERIFY_PAGE + 1;
-		pixels[off / sizeof(*pixels)] = cpu_to_le32(0xff000000 | (value & 0xffffff));
-	}
+	if (len < 2 * ADBE_VERIFY_PAGE || adbe->fb_size < 2 * ADBE_VERIFY_PAGE)
+		goto put;
+	adbe_verify_copy(adbe, obj->vaddr, len, swap);
 	wmb(); /* publish the allocator's write-combined stores */
 	dma_sync_single_for_device(drm_dev_dma_dev(&adbe->drm), obj->dma_addr,
 				   len, DMA_TO_DEVICE);
@@ -1480,7 +1501,8 @@ static int adbe_dart_verify(struct adbe *adbe, struct device *sdev,
 	u32 previous_base = readl(adbe->regs + ADP_BASE);
 	u32 previous_stride = readl(adbe->regs + ADP_STRIDE);
 	u32 stride = adbe_tag_word(adbe->pitch, previous_stride);
-	size_t mapped_p = 0;
+	size_t mapped_p = 0, page;
+	unsigned int swap = 0, k;
 	phys_addr_t pa;
 	bool mapped_id = false, mapped_a = false, restore_failed = false;
 	int f1, delta = 0, ret;
@@ -1493,7 +1515,7 @@ static int adbe_dart_verify(struct adbe *adbe, struct device *sdev,
 		goto verdict;
 	}
 	reason = "pattern allocation failed";
-	pattern = adbe_verify_pattern(adbe, len, &pa, &bus);
+	pattern = adbe_verify_pattern(adbe, len, &pa, &bus, &swap);
 	if (IS_ERR(pattern)) {
 		pattern = NULL;
 		goto verdict;
@@ -1511,22 +1533,17 @@ static int adbe_dart_verify(struct adbe *adbe, struct device *sdev,
 	if (ret)
 		goto cleanup;
 	mapped_a = true;
-	/* Swap exactly the first two 16 KiB pages, not the image halves. */
-	ret = iommu_map(domain, alias[1], pa + ADBE_VERIFY_PAGE,
-			ADBE_VERIFY_PAGE, IOMMU_READ, GFP_KERNEL);
-	if (ret)
-		goto cleanup;
-	mapped_p = ADBE_VERIFY_PAGE;
-	ret = iommu_map(domain, alias[1] + ADBE_VERIFY_PAGE, pa,
-			ADBE_VERIFY_PAGE, IOMMU_READ, GFP_KERNEL);
-	if (ret)
-		goto cleanup;
-	mapped_p += ADBE_VERIFY_PAGE;
-	ret = iommu_map(domain, alias[1] + mapped_p, pa + mapped_p,
-			len - mapped_p, IOMMU_READ, GFP_KERNEL);
-	if (ret)
-		goto cleanup;
-	mapped_p = len;
+	/* Swap exactly pages swap and swap + 1; the rest maps in place. */
+	for (k = 0; mapped_p < len; k++, mapped_p += page) {
+		page = min_t(size_t, ADBE_VERIFY_PAGE, len - mapped_p);
+		ret = iommu_map(domain, alias[1] + mapped_p,
+				pa + (k == swap ? mapped_p + ADBE_VERIFY_PAGE :
+				      k == swap + 1 ? mapped_p - ADBE_VERIFY_PAGE :
+				      mapped_p),
+				page, IOMMU_READ, GFP_KERNEL);
+		if (ret)
+			goto cleanup;
+	}
 
 	console_lock();
 	/* Discard inherited errors, especially a warm boot's output underrun. */
@@ -1556,7 +1573,8 @@ static int adbe_dart_verify(struct adbe *adbe, struct device *sdev,
 	}
 	if (adbe_check_dart_translates(adbe, bus, pa) ||
 	    adbe_check_dart_translates(adbe, alias[0], pa) ||
-	    adbe_check_dart_translates(adbe, alias[1], pa + ADBE_VERIFY_PAGE)) {
+	    adbe_check_dart_translates(adbe, alias[1] + swap * ADBE_VERIFY_PAGE,
+				       pa + (swap + 1) * ADBE_VERIFY_PAGE)) {
 		result = "FAIL";
 		reason = "translation read-back changed";
 		goto restore;
@@ -1657,9 +1675,9 @@ verdict:
 	adbe_dart_capture(adbe, "after-verdict");
 	if (!reason) {
 		dev_info(adbe->drm.dev,
-			 "display DART self-check passed: pattern crc %08x translated %08x permuted %08x faults +%d step=A errbits=%#x step=B errbits=%#x step=C errbits=%#x step=R errbits=%#x crcctl %08x>%08x>%08x restored %08x blendbypass %08x\n",
+			 "display DART self-check passed: pattern crc %08x translated %08x permuted %08x faults +%d step=A errbits=%#x step=B errbits=%#x step=C errbits=%#x step=R errbits=%#x crcctl %08x>%08x>%08x restored %08x blendbypass %08x swapped pages %u/%u\n",
 			 crc[0], crc[1], crc[2], delta, errors[0], errors[1], errors[2], errors[3],
-			 crcctl[0], crcctl[1], crcctl[2], crcctl[3], blend_bypass);
+			 crcctl[0], crcctl[1], crcctl[2], crcctl[3], blend_bypass, swap, swap + 1);
 	} else {
 		dev_info(adbe->drm.dev,
 			 "display DART self-check %s (%s: pattern crc %08x translated %08x permuted %08x faults +%d step=A errbits=%#x step=B errbits=%#x step=C errbits=%#x step=R errbits=%#x crcctl %08x>%08x>%08x restored %08x blendbypass %08x); %s\n",
-- 
