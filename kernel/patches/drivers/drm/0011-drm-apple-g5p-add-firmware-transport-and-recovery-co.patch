diff --git a/drivers/gpu/apple-g5p/render-user-terminal.h b/drivers/gpu/apple-g5p/render-user-terminal.h
new file mode 100644
index 000000000..4ced26eaf
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-terminal.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * TYPED_V3 terminal state of the epoch.  Pure functions over one small struct; the
+ * kernel supplies READ_ONCE/WRITE_ONCE/cmpxchg and the host suite shims them, so the
+ * host compiles this file as it is.
+ *
+ * One latch, first writer wins.  The first terminal event of the epoch (the natural TA
+ * complete, a timeout, a fault or a protocol error) fixes `kind`; from then on `quiet`
+ * is set and never cleared, and g5p_ru_mmio_ok() is false: the host touches no register
+ * (R0, R1, AIC, doorbell) and no diagnostic bank.  RAM stays accessible.  A later
+ * failure (the 3D after a completed TA, job N+1 after job N) cannot change `kind` but
+ * sets the sticky `failed`, which is what the admission uses: after any timeout or fault
+ * no new job starts, from any queue, even one that passed the pre-lock context checks
+ * before the failing job marked the context bad.
+ *
+ * The recovery series (patches/gpu-recovery) is independent of this file.  Its
+ * g5p_td_note_terminal() takes {1 complete, 2 timeout}; g5p_ru_td_kind() maps ours.
+ */
+#ifndef G5P_RENDER_USER_TERMINAL_H
+#define G5P_RENDER_USER_TERMINAL_H
+
+enum g5p_ru_term_kind {
+	G5P_RU_TERM_NONE,
+	G5P_RU_TERM_COMPLETE, /* the natural TA completed (RAM) */
+	G5P_RU_TERM_TIMEOUT, /* a phase ran out its deadline */
+	G5P_RU_TERM_FAULT, /* protocol error, drain error, attach or publish failure */
+	G5P_RU_TERM_KINDS,
+};
+
+static const char *const g5p_ru_term_names[G5P_RU_TERM_KINDS] = {
+	"none",
+	"complete",
+	"timeout",
+	"fault",
+};
+
+struct g5p_ru_terminal {
+	int kind; /* first writer wins */
+	int quiet; /* set with the first note, never cleared */
+	int failed; /* sticky: any timeout or fault was noted */
+	int captured; /* the CAPTURE entry (recovery hook) was taken, once */
+};
+
+/* A new firmware epoch (the in-boot recovery, recover.inc) starts a new latch; nothing else
+ * clears it.
+ */
+static inline void g5p_ru_term_reset(struct g5p_ru_terminal *t)
+{
+	WRITE_ONCE(t->kind, 0);
+	WRITE_ONCE(t->quiet, 0);
+	WRITE_ONCE(t->failed, 0);
+	WRITE_ONCE(t->captured, 0);
+}
+
+/* The kind a job's return value stands for (only called for ret < 0, ret != -ECANCELED). */
+static inline int g5p_ru_term_from_ret(int ret)
+{
+	return ret == -ETIMEDOUT ? G5P_RU_TERM_TIMEOUT : G5P_RU_TERM_FAULT;
+}
+
+/* Returns true for the first note of the epoch. */
+static inline bool g5p_ru_term_note(struct g5p_ru_terminal *t, int kind)
+{
+	bool first;
+
+	if (kind <= G5P_RU_TERM_NONE || kind >= G5P_RU_TERM_KINDS)
+		kind = G5P_RU_TERM_FAULT;
+	first = cmpxchg(&t->kind, G5P_RU_TERM_NONE, kind) == G5P_RU_TERM_NONE;
+	if (kind >= G5P_RU_TERM_TIMEOUT)
+		WRITE_ONCE(t->failed, 1);
+	WRITE_ONCE(t->quiet, 1);
+	return first;
+}
+
+static inline int g5p_ru_term_kind(const struct g5p_ru_terminal *t)
+{
+	return READ_ONCE(t->kind);
+}
+
+static inline bool g5p_ru_term_failed(const struct g5p_ru_terminal *t)
+{
+	return READ_ONCE(t->failed);
+}
+
+/* The single predicate for register access: false from the first terminal note on. */
+static inline bool g5p_ru_mmio_ok(const struct g5p_ru_terminal *t)
+{
+	return !READ_ONCE(t->quiet);
+}
+
+/* True once per epoch for a timeout or fault: the caller may take the recovery CAPTURE entry. */
+static inline bool g5p_ru_term_capture_due(struct g5p_ru_terminal *t, int kind)
+{
+	return kind >= G5P_RU_TERM_TIMEOUT && cmpxchg(&t->captured, 0, 1) == 0;
+}
+
+/* Recovery's terminal encoding: 1 complete, 2 timeout (a fault is a no-completion exit: 2). */
+static inline int g5p_ru_td_kind(int kind)
+{
+	return kind == G5P_RU_TERM_COMPLETE ? 1 : 2;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-touch.h b/drivers/gpu/apple-g5p/render-user-touch.h
new file mode 100644
index 000000000..145bdbf2d
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-touch.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * TYPED_V3 RAM-touch latency A/B (release).  Pure functions, no kernel services beyond the
+ * integer types, so the host suite compiles this file as it is.  Include render-user-wait.h first.
+ *
+ * Question (docs/gpu/experiments/latency101-device-analysis.md section 9): is the host's bulk read
+ * of the receipt pages what releases a stalled phase (the +6 ms atom after the job-1 receipt)?
+ *
+ * render_user_touch_ms = T, default 0 = off.  On, every phase of every job records the first wait
+ * sample at or after publish + T that left the phase undecided (still pending, deadline not
+ * reached).  Odd sequences are the touch arm: right after that sample the host reads the
+ * receipt's read set once (RAM only, folded into a sum).  Even sequences are the control arm: the
+ * same instant is recorded and nothing is read.  Neither arm changes a sample, the sleep, the
+ * deadline, a latch or the result, and neither prints before the job ends.
+ *
+ * Off: g5p_ru_touch_start() leaves the record zero and g5p_ru_touch_due() is never true, so the
+ * wait loop runs the latency101 instructions unchanged.
+ */
+#ifndef G5P_RENDER_USER_TOUCH_H
+#define G5P_RENDER_USER_TOUCH_H
+
+#define G5P_RU_TOUCH_MAX_MS \
+	20000U /* never at or past the smallest soft bound */
+
+struct g5p_ru_touch {
+	u64 at_ns; /* publish + T; 0 = off for this phase */
+	u64 seen_ns; /* the undecided sample at or after at_ns that took it; 0 = not reached */
+	u64 done_ns; /* end of the read (touch arm), seen_ns (control arm) */
+	u32 bytes; /* bytes read: 0 on the control arm */
+	u32 sum; /* fold of the words read: the loads cannot be elided */
+	bool sweep; /* this phase is in the touch arm */
+};
+
+/* 0 (off), or 1..G5P_RU_TOUCH_MAX_MS with latency101 on (hard_ms != 0) and strictly before the
+ * effective soft bound (g5p_ru_lat_soft()), so the instant always falls in the plain wait.
+ */
+static inline bool g5p_ru_touch_valid(u32 touch_ms, u32 soft_ms, u32 hard_ms)
+{
+	if (!touch_ms)
+		return true;
+	return hard_ms && touch_ms <= G5P_RU_TOUCH_MAX_MS && touch_ms < soft_ms;
+}
+
+/* Odd sequences are the touch arm, even ones the control. */
+static inline bool g5p_ru_touch_arm(u32 seq)
+{
+	return seq & 1;
+}
+
+static inline void g5p_ru_touch_start(struct g5p_ru_touch *t, u64 start_ns,
+				      u32 touch_ms, u32 seq)
+{
+	*t = (struct g5p_ru_touch){ 0 };
+	if (!touch_ms)
+		return;
+	t->at_ns = start_ns + (u64)touch_ms * 1000000ULL;
+	t->sweep = g5p_ru_touch_arm(seq);
+}
+
+/*
+ * Asked after g5p_ru_wait_step() of the sample taken at now_ns: true once, for the first sample
+ * at
+ * or after the instant whose step left the phase undecided and not expired.  A completion, a fault
+ * or the deadline in the same sample wins, and then the instant is never taken.
+ */
+static inline bool g5p_ru_touch_due(const struct g5p_ru_touch *t, u64 now_ns,
+				    u32 result, bool expired)
+{
+	return t->at_ns && !t->seen_ns && !result && !expired &&
+	       now_ns >= t->at_ns;
+}
+
+/* The instant was taken at seen_ns (a sample time, never 0); done_ns is when the read ended. */
+static inline void g5p_ru_touch_mark(struct g5p_ru_touch *t, u64 seen_ns,
+				     u64 done_ns, u32 bytes, u32 sum)
+{
+	t->seen_ns = seen_ns;
+	t->done_ns = done_ns < seen_ns ? seen_ns : done_ns;
+	t->bytes = bytes;
+	t->sum = sum;
+}
+
+/* Receipt helper: to - from in microseconds, -1 when an end is missing or the order is wrong. */
+static inline s64 g5p_ru_touch_us(u64 from_ns, u64 to_ns)
+{
+	if (!from_ns || !to_ns || to_ns < from_ns)
+		return -1;
+	return (s64)((to_ns - from_ns) / 1000);
+}
+
+/* Receipt: how long after the instant (the end of the read) the phase's deciding sample saw it
+ * complete; -1 when the instant was not taken or the phase did not complete.
+ */
+static inline s64 g5p_ru_touch_after_us(const struct g5p_ru_touch *t,
+					u32 result, u64 end_ns)
+{
+	if (!t->seen_ns || result != G5P_RU_WAIT_COMPLETE)
+		return -1;
+	return g5p_ru_touch_us(t->done_ns, end_ns);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-wait.h b/drivers/gpu/apple-g5p/render-user-wait.h
new file mode 100644
index 000000000..b9b5f1c49
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-wait.h
@@ -0,0 +1,266 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * TYPED_V3 serial wait policy.  Pure functions, no kernel services beyond the
+ * integer types, so the host suite compiles this file as it is.
+ *
+ * Evidence behind the numbers (r96 raw timelines, 2026-10-30):
+ *   - the natural TA completion event arrived +12.0060 s and +12.0062 s after the
+ *     publish in the two boots that a 12000 ms cap turned into timeouts; the whole
+ *     delay is inside the firmware's start23, and once it returns the hardware and
+ *     the retirement take less than ~1 ms;
+ *   - nothing the host does shortens the delay, so the wait is RAM-only: after the
+ *     DC3 attach the host touches no register until the job has ended.
+ *
+ * Policy:
+ *   - one phase (TA, then 3D) waits at most `bound` from its own publish: 20 s by
+ *     default, never below 20 s, never above the absolute cap;
+ *   - the whole job (TA publish to the end of the 3D phase) never exceeds the
+ *     absolute cap of 30 s;
+ *   - the deadline is decided on RAM samples.  A completion seen in the sample that
+ *     reaches the deadline wins; a deadline is only final after one closing sample
+ *     taken at or after it, which closes the gap between the last poll and the
+ *     expiry; a completion after that is evidence only (`late_after`), never the
+ *     result;
+ *   - a fault wins over a completion in the same sample and over the deadline.
+ */
+#ifndef G5P_RENDER_USER_WAIT_H
+#define G5P_RENDER_USER_WAIT_H
+
+#define G5P_RU_V3_WAIT_MS 20000U /* default and minimum per-phase bound */
+#define G5P_RU_V3_CAP_MS \
+	30000U /* absolute job bound, and the largest per-phase bound */
+
+/*
+ * latency101 (default off: render_user_soft_ms = render_user_hard_ms = 0 leaves every number above,
+ * and the behaviour of every function below, exactly as it was).  When on, the per-phase deadline
+ * is the HARD bound and the job bound is two hard bounds; the SOFT bound marks a phase "slow"
+ * (RAM-only record, no print, no latch).  A silent event stream means a dead firmware from the
+ * phase's publish on (faultiso; before it, only from the soft bound).  See
+ * docs/gpu/experiments/prod98c-bimodal-latency.md and docs/gpu/experiments/faultiso.md.
+ */
+#define G5P_RU_LAT_MIN_SOFT_MS \
+	20000U /* never below the proven per-phase bound */
+#define G5P_RU_LAT_DEF_SOFT_MS 45000U
+#define G5P_RU_LAT_MAX_HARD_MS \
+	60000U /* largest hard bound; the job bound is twice this */
+#define G5P_RU_LAT_DEF_OBS_MS \
+	2000U /* RAM-only look after a timeout, pre-receipt */
+#define G5P_RU_LAT_MAX_OBS_MS 5000U
+#define G5P_RU_LAT_SILENT_MS \
+	1000U /* no event decoded for this long in a phase = silent */
+/* The silence clock runs from the publish (the host suites key on this). */
+#define G5P_RU_LAT_SILENT_FROM_PUBLISH 1
+
+enum g5p_ru_wait_result {
+	G5P_RU_WAIT_PENDING,
+	G5P_RU_WAIT_COMPLETE,
+	G5P_RU_WAIT_TIMEOUT,
+	G5P_RU_WAIT_FAULT,
+};
+
+struct g5p_ru_wait {
+	u64 start_ns; /* the publish (producer store) of this phase */
+	u64 deadline_ns; /* start + bound, clamped to the job's absolute deadline */
+	u64 end_ns; /* the sample that decided */
+	u32 result;
+	bool expired; /* a sample at or after the deadline has been seen */
+	bool late_gap; /* completion first seen by the closing sample */
+	bool late_after; /* completion seen after a timeout was decided: evidence only */
+	/* latency101; all zero (and never read) unless soft_ns != 0 */
+	u64 soft_ns; /* start + soft bound; 0 = the grace is off */
+	u64 soft_seen_ns; /* the first sample at or after soft_ns */
+	u64 late_ns; /* the first retired sample after the timeout was decided */
+	u64 event_ns; /* sample time of the last change of the decoded-event counter */
+	u64 busy_ns; /* the first sample whose idle words showed the engine busy */
+	u32 events; /* the decoded-event counter at that sample */
+	bool slow; /* the phase passed its soft bound and is still pending */
+	bool silent; /* the event stream stopped during the phase: firmware dead */
+	bool late_soft; /* completed after the soft bound: a success, never a failure */
+};
+
+/* latency101 parameters.  Off is hard = soft = 0.  On: hard in [soft, 60000], soft (0 =
+ * min(45000, hard)) in [20000, hard], obs <= 5000.  The job bound the waiters must outlast is two
+ * hard bounds plus one observation window.
+ */
+static inline u32 g5p_ru_lat_soft(u32 soft_ms, u32 hard_ms)
+{
+	if (soft_ms)
+		return soft_ms;
+	return hard_ms > G5P_RU_LAT_DEF_SOFT_MS ? G5P_RU_LAT_DEF_SOFT_MS :
+						  hard_ms;
+}
+
+static inline bool g5p_ru_lat_valid(u32 soft_ms, u32 hard_ms, u32 obs_ms)
+{
+	if (!hard_ms)
+		return !soft_ms;
+	soft_ms = g5p_ru_lat_soft(soft_ms, hard_ms);
+	return hard_ms <= G5P_RU_LAT_MAX_HARD_MS &&
+	       soft_ms >= G5P_RU_LAT_MIN_SOFT_MS && soft_ms <= hard_ms &&
+	       obs_ms <= G5P_RU_LAT_MAX_OBS_MS;
+}
+
+static inline u32 g5p_ru_lat_job_ms(u32 hard_ms, u32 obs_ms)
+{
+	return 2 * hard_ms + obs_ms;
+}
+
+/* A per-phase bound is valid when it is in [G5P_RU_V3_WAIT_MS, G5P_RU_V3_CAP_MS]. */
+static inline bool g5p_ru_v3_bound_valid(u32 ms)
+{
+	return ms >= G5P_RU_V3_WAIT_MS && ms <= G5P_RU_V3_CAP_MS;
+}
+
+/* The deadline of a phase: its own bound, clamped to the job's absolute deadline.
+ * A job deadline of 0 means "no job deadline yet" (the first phase).
+ */
+static inline u64 g5p_ru_wait_deadline(u64 start_ns, u32 bound_ms,
+				       u64 job_deadline_ns)
+{
+	u64 d = start_ns + (u64)bound_ms * 1000000ULL;
+
+	return job_deadline_ns && job_deadline_ns < d ? job_deadline_ns : d;
+}
+
+static inline void g5p_ru_wait_start(struct g5p_ru_wait *w, u64 start_ns,
+				     u32 bound_ms, u64 job_deadline_ns)
+{
+	*w = (struct g5p_ru_wait){
+		.start_ns = start_ns,
+		.deadline_ns = g5p_ru_wait_deadline(start_ns, bound_ms,
+						    job_deadline_ns),
+	};
+}
+
+/*
+ * latency101: hard_ms is the per-phase deadline (clamped to the job's deadline as above),
+ * soft_ms
+ * (never past the deadline) the point where a still-pending phase is called slow.  `events` seeds
+ * the silence clock.
+ */
+static inline void g5p_ru_wait_start_lat(struct g5p_ru_wait *w, u64 start_ns,
+					 u32 soft_ms, u32 hard_ms,
+					 u64 job_deadline_ns, u32 events)
+{
+	g5p_ru_wait_start(w, start_ns, hard_ms, job_deadline_ns);
+	w->soft_ns = start_ns + (u64)soft_ms * 1000000ULL;
+	if (w->soft_ns > w->deadline_ns)
+		w->soft_ns = w->deadline_ns;
+	w->events = events;
+	w->event_ns = start_ns;
+}
+
+/* The first sample whose idle words (G+0x724..) show the engine busy, i.e. the firmware's
+ * start path has run.  Recorded once; it splits a late start (busy_ns close to the
+ * completion) from slow hardware (busy_ns early).  A busy window shorter than the poll
+ * period can be missed: 0 = not seen.
+ */
+static inline void g5p_ru_wait_busy(struct g5p_ru_wait *w, u64 now_ns,
+				    bool busy)
+{
+	if (busy && !w->busy_ns)
+		w->busy_ns = now_ns;
+}
+
+/* One look at the decoded-event counter, taken with every RAM sample, before g5p_ru_wait_step().
+ * The ALIVE stream runs at about 290 events/s whatever the work does (r96c: 29442 polls, no gap
+ * over 3.4 ms; latency101: 287 events/s through every stall of 0.55-33 s), so a stream that has
+ * been silent for G5P_RU_LAT_SILENT_MS is a dead firmware, not a slow one, at any point of the
+ * phase.  Returns true then; the caller reports it as a fault.  The silence clock starts at the
+ * publish (vpds rung vk, 2026-11-01: the counter froze 1 s after the TA's publish, and a clock
+ * that only ran from the soft bound called it at 45 s, with every other client held behind it).
+ * The caller drains the ring before each sample, so a host that slept longer than the window
+ * sees the events it missed and is not silent.  Never true when latency101 is off.
+ */
+static inline bool g5p_ru_wait_grace(struct g5p_ru_wait *w, u64 now_ns,
+				     u32 events)
+{
+	if (!w->soft_ns)
+		return false;
+	if (events != w->events) {
+		w->events = events;
+		w->event_ns = now_ns;
+	}
+	if (now_ns >= w->soft_ns && !w->soft_seen_ns)
+		w->soft_seen_ns = now_ns;
+	w->silent = now_ns - w->event_ns >=
+		    (u64)G5P_RU_LAT_SILENT_MS * 1000000ULL;
+	return w->silent;
+}
+
+/* One RAM sample taken at `now_ns`.  Returns the result so far (PENDING until
+ * decided).  A sample at or after the deadline only marks the wait expired unless
+ * it shows completion or a fault; the caller must then take one closing sample and
+ * call g5p_ru_wait_close().
+ */
+static inline u32 g5p_ru_wait_step(struct g5p_ru_wait *w, u64 now_ns,
+				   bool complete, bool fault)
+{
+	if (w->result)
+		return w->result;
+	if (w->soft_ns && now_ns >= w->soft_ns)
+		w->slow = true;
+	if (fault) {
+		w->result = G5P_RU_WAIT_FAULT;
+		w->end_ns = now_ns;
+	} else if (complete) {
+		w->result = G5P_RU_WAIT_COMPLETE;
+		w->end_ns = now_ns;
+		w->late_soft = w->slow;
+	} else if (now_ns >= w->deadline_ns) {
+		w->expired = true;
+	}
+	return w->result;
+}
+
+/* The closing sample, taken after the loop left because of the deadline.  This is
+ * the only place a timeout is decided.
+ */
+static inline u32 g5p_ru_wait_close(struct g5p_ru_wait *w, u64 now_ns,
+				    bool complete, bool fault)
+{
+	if (w->result)
+		return w->result;
+	if (fault) {
+		w->result = G5P_RU_WAIT_FAULT;
+	} else if (complete) {
+		w->result = G5P_RU_WAIT_COMPLETE;
+		w->late_gap = true;
+		w->late_soft = w->slow;
+	} else {
+		w->result = G5P_RU_WAIT_TIMEOUT;
+	}
+	w->end_ns = now_ns;
+	return w->result;
+}
+
+/* A sample after the result was decided: a completion after a timeout is recorded
+ * and nothing else happens (no 3D, no recovery, no register access).
+ */
+static inline void g5p_ru_wait_after(struct g5p_ru_wait *w, bool complete)
+{
+	if (w->result == G5P_RU_WAIT_TIMEOUT && complete)
+		w->late_after = true;
+}
+
+/* latency101: the RAM-only observation window after a timeout was decided, before the receipt is
+ * printed and the terminal latch is taken.  g5p_ru_wait_after() looks once, microseconds after the
+ * decision; a completion that arrives milliseconds later (prod98c seq 3: 5.49 ms) was never
+ * recorded, so `late_after=0/0` was a false negative.  Returns true while the window is open.  A
+ * retired sample ends it and is recorded in late_after/late_ns; it never changes the result (a
+ * deadline stays final).  obs_ms = 0 closes it at once (the legacy behaviour).
+ */
+static inline bool g5p_ru_wait_observe(struct g5p_ru_wait *w, u64 now_ns,
+				       bool complete, u32 obs_ms)
+{
+	if (w->result != G5P_RU_WAIT_TIMEOUT || w->late_after)
+		return false;
+	if (complete) {
+		w->late_after = true;
+		w->late_ns = now_ns;
+		return false;
+	}
+	return now_ns < w->end_ns + (u64)obs_ms * 1000000ULL;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-wake.h b/drivers/gpu/apple-g5p/render-user-wake.h
new file mode 100644
index 000000000..64a51eaf4
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-wake.h
@@ -0,0 +1,273 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * TYPED_V3 publish-time MTS wake (wake110).  Pure functions over plain values; the one
+ * register sequence goes through a callback table (the fender.h pattern), so the host
+ * suite compiles this file as it is and records every access in order.
+ *
+ * Question (docs/gpu/experiments/wake110-apple-mts-dispatch.md): is the 0.5-33 s TA/3D
+ * start latency caused by the missing Apple submit kick?  Apple's TA and 3D submit
+ * wrappers (iPad6,11 kernelcache 0xfffffff006ca00a0 / 0xfffffff006ca01f8) do, every time:
+ * ring entry, dmb ish, Fender vt+0x80 (R1+0x14 = 7, read back), Fender vt+0x18
+ * (R1+0x1000 & 0xf), then R0+0xb00 = 0x10 (TA, DM0|COUNTED) or 0x11 (3D, DM1|COUNTED).
+ * The MTS store is reached from every arm; when the GPC nibble is 0 Apple first runs a
+ * power arm (up to forcePowerCycleAndReboot).  Linux V3 publishes job N >= 2's TA and
+ * every 3D with no kick at all.
+ *
+ * render_user_wake (latched per context): 0 off (default: no call has any effect),
+ * 1 the A/B, 2 every eligible phase is a factor (the candidate production fix, for use
+ * only after the A/B proved it).  The TA of job 1 is never a phase of this file (the r74g
+ * grace and its fenced fallback bell own it).  In the A/B each engine's phases are paired
+ * in publish order, (0,1), (2,3), ...; exactly one of each pair is the factor, which one
+ * is fixed by render_user_wake_seed before the context exists, and bit 31 of the seed
+ * inverts the whole schedule (the mirror stage).  The verdict recomputes the arm of every
+ * receipt from the seed.
+ *
+ * At the publish, right after the producer store and its barrier, both arms take the same
+ * lock and read the same RAM state and run the same guards; the control stops there (no
+ * register).  The factor then runs the Apple order: R1+0x14 = 7, read back (any bit
+ * outside 7: stop), R1+0x1000 (state & 0x1f != 1, the GPC is not active: stop, never
+ * repaired, never a power arm), dma_wmb(), R0+0xb00 = 0x10 | engine.  At most one attempt
+ * per phase.  Never after a timeout or fault (the terminal latch's sticky `failed`), never
+ * with the boot failed or stopped, never unpowered, never with an r74f bell in flight,
+ * never once the phase shows any sign of retirement, never on a ring that is not exactly
+ * this publish.  A consumer already at the target does not cancel (Apple never checks
+ * it); it is recorded.  The natural TA completion (terminal kind COMPLETE, the epoch's
+ * first note) is not a failure: the factor's sequence is the one licensed exception to the
+ * r96 "no register after the TA complete" envelope, default off.
+ */
+#ifndef G5P_RENDER_USER_WAKE_H
+#define G5P_RENDER_USER_WAKE_H
+
+#ifndef G5P_GPC_ON
+#define G5P_GPC_ON(raw) (((raw) & 0x1f) == 1) /* core.inc overrides it */
+#endif
+
+#define G5P_WK_OFF 0U
+#define G5P_WK_AB 1U
+#define G5P_WK_ALWAYS 2U
+#define G5P_WK_MIRROR 0x80000000U /* seed bit 31: every arm inverted */
+
+#define G5P_WK_R1_FENDER 0x14U /* Fender vt+0x80: write 7, read back */
+#define G5P_WK_R1_GPC 0x1000U /* GPC state: & 0x1f == 1 is active */
+#define G5P_WK_R0_MTS 0xb00U /* MTS_SCHEDULE, write only */
+#define G5P_WK_MTS_TA 0x10U /* DM0 | COUNTED */
+#define G5P_WK_MTS_3D 0x11U /* DM1 | COUNTED */
+
+/* wake111: the publish-time power evidence, one bit per RAM fact, sampled under the event lock
+ * and printed per phase (power=TT/DD).  Every required bit must be set.  reset_transition is
+ * the permanent post-release slave-port lockout (set right before the release, never
+ * cleared), not a live reset state: Wake110 vetoed on it, so every phase skipped.  It is
+ * recorded (SLAVE_LOCK) and is neither required nor a veto; the slave-port ban is unchanged.
+ */
+#define G5P_WK_PWR_CORE 0x01U /* g->powered */
+#define G5P_WK_PWR_FENDER 0x02U /* g->fender_ready */
+#define G5P_WK_PWR_RELEASED 0x04U /* b->released */
+#define G5P_WK_PWR_ALIVE 0x08U /* b->alive */
+#define G5P_WK_PWR_CONTROL 0x10U /* b->control_complete */
+#define G5P_WK_PWR_DS108 \
+	0x20U /* DS108 claim proof, current generation, no power abort */
+#define G5P_WK_PWR_SLAVE_LOCK 0x40U /* g->reset_transition: evidence only */
+#define G5P_WK_PWR_REQUIRED                                          \
+	(G5P_WK_PWR_CORE | G5P_WK_PWR_FENDER | G5P_WK_PWR_RELEASED | \
+	 G5P_WK_PWR_ALIVE | G5P_WK_PWR_CONTROL | G5P_WK_PWR_DS108)
+
+enum g5p_wk_arm {
+	G5P_WK_ARM_NONE, /* wake off */
+	G5P_WK_ARM_EXCLUDED, /* the TA of job 1 (r74g) */
+	G5P_WK_ARM_CONTROL,
+	G5P_WK_ARM_FACTOR,
+	G5P_WK_ARMS,
+};
+
+enum g5p_wk_did {
+	G5P_WK_DID_NONE, /* off, or never reached */
+	G5P_WK_DID_RANG, /* factor: fence, GPC active, 0xb00 written */
+	G5P_WK_DID_SHAM, /* control: every guard passed, no register */
+	G5P_WK_DID_EXCLUDED,
+	G5P_WK_SKIP_TWICE, /* this phase was already decided */
+	G5P_WK_SKIP_LICENSE, /* a timeout or fault was noted (terminal failed) */
+	G5P_WK_SKIP_FAULT, /* boot failed, event failed or stopped */
+	G5P_WK_SKIP_POWER, /* one of G5P_WK_PWR_REQUIRED is absent */
+	G5P_WK_SKIP_R74F, /* an r74f bell is published, open or firing */
+	G5P_WK_SKIP_RING, /* the ring is not exactly this publish */
+	G5P_WK_SKIP_RETIRED, /* a stamp == seq or a completion event since the publish */
+	G5P_WK_SKIP_FENCE, /* R1+0x14 read back outside 7: no further register */
+	G5P_WK_SKIP_GPC, /* GPC not active: no 0xb00 */
+	G5P_WK_DIDS,
+};
+
+static const char *const g5p_wk_arm_names[G5P_WK_ARMS] = {
+	"none",
+	"excluded",
+	"control",
+	"factor",
+};
+
+static const char *const g5p_wk_did_names[G5P_WK_DIDS] = {
+	"none",		"rang",	      "sham",	    "excluded",	 "skip-twice",
+	"skip-license", "skip-fault", "skip-power", "skip-r74f", "skip-ring",
+	"skip-retired", "skip-fence", "skip-gpc",
+};
+
+/* Everything the decision reads, sampled under the event lock right after the producer store. */
+struct g5p_wk_in {
+	u32 mode, seed, seq, e;
+	bool attempted; /* this phase already went through g5p_wk_decide() */
+	bool term_failed; /* g5p_ru_term_failed() */
+	bool boot_failed; /* b->failed || b->event_failed || b->stopped */
+	u32 power; /* g5p_wk_power_mask(); the slave lock is evidence, not a veto */
+	bool r74f_pending; /* an r74f bell in PUBLISHED, OPEN or FIRING */
+	u32 start, target, prod,
+		cons; /* ring: producer before this publish, our target, now */
+	u32 stamp[2]; /* this engine's stamp words */
+	u32 type1; /* this engine's completion events decoded since the phase armed */
+};
+
+/* The register access of the factor, in order.  The kernel binds them to writel/readl on the
+ * Fender window and the RGX window and to dma_wmb(); the host suite records them.
+ */
+struct g5p_wk_io {
+	void *ctx;
+	void (*w1)(void *ctx, u32 reg, u32 value);
+	u32 (*r1)(void *ctx, u32 reg);
+	void (*wbarrier)(void *ctx);
+	void (*w0)(void *ctx, u32 reg, u32 value);
+};
+
+static inline bool g5p_wk_mode_valid(u32 mode)
+{
+	return mode <= G5P_WK_ALWAYS;
+}
+
+static inline u32 g5p_wk_mix(u32 x)
+{
+	x ^= x >> 16;
+	x *= 0x7feb352dU;
+	x ^= x >> 15;
+	x *= 0x846ca68bU;
+	x ^= x >> 16;
+	return x;
+}
+
+/* The phase's index among its engine's eligible phases: TA of job seq >= 2 -> seq - 2,
+ * 3D of job seq >= 1 -> seq - 1.
+ */
+static inline u32 g5p_wk_index(u32 seq, u32 e)
+{
+	return e ? seq - 1 : seq - 2;
+}
+
+static inline u32 g5p_wk_arm(u32 mode, u32 seed, u32 seq, u32 e)
+{
+	u32 i, flip;
+
+	if (!mode || !g5p_wk_mode_valid(mode) || !seq || e > 1)
+		return G5P_WK_ARM_NONE;
+	if (!e && seq == 1)
+		return G5P_WK_ARM_EXCLUDED;
+	if (mode == G5P_WK_ALWAYS)
+		return G5P_WK_ARM_FACTOR;
+	i = g5p_wk_index(seq, e);
+	flip = g5p_wk_mix(g5p_wk_mix(seed & ~G5P_WK_MIRROR) + (e << 24) +
+			  (i >> 1)) &
+	       1;
+	flip ^= !!(seed & G5P_WK_MIRROR);
+	return ((i & 1) ^ flip) ? G5P_WK_ARM_FACTOR : G5P_WK_ARM_CONTROL;
+}
+
+static inline u32 g5p_wk_mts(u32 e)
+{
+	return G5P_WK_MTS_TA | e;
+}
+
+/* wake111: the evidence word, one bit per fact (the caller samples each fact once). */
+static inline u32 g5p_wk_power_mask(bool powered, bool fender_ready,
+				    bool released, bool alive,
+				    bool control_complete, bool ds108,
+				    bool slave_lock)
+{
+	return (powered ? G5P_WK_PWR_CORE : 0) |
+	       (fender_ready ? G5P_WK_PWR_FENDER : 0) |
+	       (released ? G5P_WK_PWR_RELEASED : 0) |
+	       (alive ? G5P_WK_PWR_ALIVE : 0) |
+	       (control_complete ? G5P_WK_PWR_CONTROL : 0) |
+	       (ds108 ? G5P_WK_PWR_DS108 : 0) |
+	       (slave_lock ? G5P_WK_PWR_SLAVE_LOCK : 0);
+}
+
+static inline bool g5p_wk_power_ready(u32 power)
+{
+	return (power & G5P_WK_PWR_REQUIRED) == G5P_WK_PWR_REQUIRED;
+}
+
+/* The RAM guards, common to both arms, in priority order.  0 = pass. */
+static inline u32 g5p_wk_guard(const struct g5p_wk_in *in)
+{
+	if (in->attempted)
+		return G5P_WK_SKIP_TWICE;
+	if (in->term_failed)
+		return G5P_WK_SKIP_LICENSE;
+	if (in->boot_failed)
+		return G5P_WK_SKIP_FAULT;
+	if (!g5p_wk_power_ready(in->power))
+		return G5P_WK_SKIP_POWER;
+	if (in->r74f_pending)
+		return G5P_WK_SKIP_R74F;
+	if (in->start > 255 || in->target > 255 || in->prod != in->target ||
+	    in->cons > 255 || ((in->target - in->start) & 255) != 1 ||
+	    ((in->cons - in->start) & 255) > 1)
+		return G5P_WK_SKIP_RING;
+	if (in->stamp[0] == in->seq || in->stamp[1] == in->seq || in->type1)
+		return G5P_WK_SKIP_RETIRED;
+	return 0;
+}
+
+/* The factor's register sequence (Apple's order).  The caller set *fence and *gpc to U32_MAX
+ * (not read).
+ */
+static inline u32 g5p_wk_ring(const struct g5p_wk_io *io, u32 e, u32 *fence,
+			      u32 *gpc)
+{
+	io->w1(io->ctx, G5P_WK_R1_FENDER, 7);
+	*fence = io->r1(io->ctx, G5P_WK_R1_FENDER);
+	if (*fence & ~7U)
+		return G5P_WK_SKIP_FENCE;
+	*gpc = io->r1(io->ctx, G5P_WK_R1_GPC);
+	if (!G5P_GPC_ON(*gpc))
+		return G5P_WK_SKIP_GPC;
+	/* the publish's RAM stores before the MTS write (Apple: dmb ish before vt+0x80) */
+	io->wbarrier(io->ctx);
+	io->w0(io->ctx, G5P_WK_R0_MTS, g5p_wk_mts(e));
+	return G5P_WK_DID_RANG;
+}
+
+/* One phase's decision and, for a factor that passed every guard, its register sequence
+ * (the control arm never touches io).
+ */
+static inline u32 g5p_wk_decide(const struct g5p_wk_in *in,
+				const struct g5p_wk_io *io, u32 *fence,
+				u32 *gpc)
+{
+	u32 arm = g5p_wk_arm(in->mode, in->seed, in->seq, in->e), skip;
+
+	*fence = U32_MAX;
+	*gpc = U32_MAX;
+	if (arm == G5P_WK_ARM_NONE)
+		return G5P_WK_DID_NONE;
+	if (arm == G5P_WK_ARM_EXCLUDED)
+		return G5P_WK_DID_EXCLUDED;
+	skip = g5p_wk_guard(in);
+	if (skip)
+		return skip;
+	if (arm == G5P_WK_ARM_CONTROL)
+		return G5P_WK_DID_SHAM;
+	return g5p_wk_ring(io, in->e, fence, gpc);
+}
+
+/* A decided phase never decides again (the caller stores this before it unlocks). */
+static inline bool g5p_wk_attempted(u32 did)
+{
+	return did != G5P_WK_DID_NONE && did != G5P_WK_DID_EXCLUDED;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-window.h b/drivers/gpu/apple-g5p/render-user-window.h
new file mode 100644
index 000000000..bfbae628d
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-window.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The firmware window of a render VM (docs/gpu/multi-client-design.md §6 R4, stage 3).
+ *
+ * The firmware's own GPU memory lives in one GiB, catalogue entry G5P_RU_FIRMWARE_CI: its
+ * image, the root and shared pages (rings, the PA/tag arrays, W), the MMU table alias and the
+ * PIO pages (Fender, AIC).  Stage 1 copied that catalogue entry into every render VM, so any
+ * render job could address all of it.  A render VM now gets, under that entry, a directory
+ * the kernel built that maps only the pages the GPU's own requesters reach through the
+ * context's slot: the PM control page (S) and the PM list and free list (F).  Their leaf
+ * entries are copied from the firmware's tables, so their translation is unchanged.
+ *
+ *   render_user_fw_window = 0 (G5P_RU_FW_FULL)    the stage 1 mapping: the whole firmware GiB;
+ *                                                  render contexts need CAP_SYS_RAWIO
+ *                          1 (G5P_RU_FW_WINDOW)  the window above (default)
+ *                          2 (G5P_RU_FW_NONE)    no firmware page at all (an experiment)
+ *
+ * Pure helpers, host-tested (scripts/gpu/multiclient2-host/test_render_window.c).  The
+ * caller provides g5p_le32() and the boot layout constants.
+ */
+#ifndef G5P_RENDER_USER_WINDOW_H
+#define G5P_RENDER_USER_WINDOW_H
+
+#define G5P_RU_FW_FULL 0U
+#define G5P_RU_FW_WINDOW 1U
+#define G5P_RU_FW_NONE 2U
+#define G5P_RU_FW_MODES 3U
+
+#define G5P_RU_FW_PAGES 3U
+/* The pages of the window, all in the firmware GiB. */
+static const u64 g5p_ru_fw_window_va[G5P_RU_FW_PAGES] = {
+	G5P_SHARED_VA + G5P_R22_PM, /* PM control and S */
+	G5P_SHARED_VA + G5P_SHARED_SIZE, /* PM list */
+	G5P_SHARED_VA + G5P_SHARED_SIZE + G5P_GPU_PAGE, /* PM free list F */
+};
+
+static inline u32 g5p_ru_fw_di(u64 va)
+{
+	return (va >> 21) & 511;
+}
+
+static inline u32 g5p_ru_fw_ti(u64 va)
+{
+	return (va >> 14) & 127;
+}
+
+/* The firmware's 64-bit leaf entry for `va`, from its leaf pages and their directory
+ * indices; 0 when the firmware does not map it.
+ */
+static inline u64 g5p_ru_fw_leaf(u8 *const *leaf, const u32 *leaf_di,
+				 u32 leaves, u64 va)
+{
+	for (u32 i = 0; i < leaves; i++) {
+		const u8 *e = leaf[i] + g5p_ru_fw_ti(va) * 8;
+
+		if (leaf_di[i] == g5p_ru_fw_di(va))
+			return (u64)g5p_le32(e + 4) << 32 | g5p_le32(e);
+	}
+	return 0;
+}
+
+/* The window's leaf page index for `va` among `n` distinct directory indices so far, or n
+ * (a new one) when none has its directory index.
+ */
+static inline u32 g5p_ru_fw_slot(const u32 *di, u32 n, u64 va)
+{
+	u32 i;
+
+	for (i = 0; i < n && di[i] != g5p_ru_fw_di(va); i++)
+		;
+	return i;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-variants-r25.h b/drivers/gpu/apple-g5p/render-variants-r25.h
new file mode 100644
index 000000000..8469a2f4b
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-variants-r25.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_RENDER_VARIANTS_R25_H
+#define G5P_RENDER_VARIANTS_R25_H
+
+/* Finite, owned-input experiments. No raw W, register or firmware-patch API. */
+#define G5P_R25_MAX_BLOCKS 128U
+#define G5P_R25_HEAD 0x3000U
+
+struct g5p_r25_variants {
+	u32 pm, blocks, context, host, sku, memory, rt, slots;
+};
+
+static inline bool g5p_r25_valid(const struct g5p_r25_variants *v)
+{
+	return v->pm <= 3 &&
+	       (v->blocks == 0 || v->blocks == 64 || v->blocks == 128) &&
+	       v->context <= 3 && v->host <= 2 && v->sku <= 3 &&
+	       v->memory <= 4 && v->rt <= 2 && v->slots <= 1;
+}
+
+/* Event synthesis, removed context tasks, candidate clocks and the low-address
+ * dialect test cannot qualify rendering, even if firmware stamps retire.
+ */
+static inline bool g5p_r25_diagnostic(const struct g5p_r25_variants *v)
+{
+	return v->sku || v->context || v->host || v->rt == 2;
+}
+
+/* PM payload frames are physical PPNs and have no user PTE attributes. This
+ * changes only PM auxiliary mappings (and, in mode4, other private mappings).
+ * Firmware/shared META mappings and the borrowed sink are never rewritten.
+ */
+static inline u32 g5p_r25_attributes(const struct g5p_r25_variants *v, u64 va)
+{
+	if (!v->memory)
+		return 0xc;
+	if (v->memory != 4 &&
+	    (va < G5P_R22_AUX || va >= G5P_R22_AUX + 5 * G5P_GPU_PAGE))
+		return 0xc;
+	return v->memory == 2 ? 4 : v->memory == 3 ? 8 : 0;
+}
+
+/* Preserve the original constructor exactly for the default pool. The extra
+ * blocks fit the existing 16KiB list and free allocations, including F's last
+ * dword at128 blocks. Validate every PA before mutating either allocation.
+ */
+
+#endif
diff --git a/drivers/gpu/apple-g5p/retire108.h b/drivers/gpu/apple-g5p/retire108.h
new file mode 100644
index 000000000..e944b92c9
--- /dev/null
+++ b/drivers/gpu/apple-g5p/retire108.h
@@ -0,0 +1,434 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_RETIRE108_H
+#define G5P_RETIRE108_H
+
+#include "bits-compat.h"
+
+/*
+ * G5P outgoing retire layer (series gpu-recovery108, patch 0006).
+ *
+ * Design: docs/gpu/experiments/recovery108-driver.md section 3.
+ *
+ * Wraps the recovery98 teardown ladder (teardown.h, g5p_td_run()) without
+ * changing it: the TD98 lines of a run are byte for byte the ones of the
+ * same run without this layer.  It adds, around a run:
+ *
+ *   ADMIT     atomically close job admission (one cmpxchg word), then a
+ *             bounded RAM-only wait for submitters already inside the
+ *             admission window; still inside at the deadline = explicit
+ *             ADMIT_OPEN flag, never a block.
+ *   CLASSIFY  the epoch class from RAM inputs only (struct g5p_r8_in).
+ *   RECEIPT   one TR108 line with the class and the generation, printed
+ *             before the ladder makes its first AIC or R1 access.
+ *   (ladder)  g5p_td_run(FINAL) through a callback, unchanged.
+ *   SLOTS     three named post-ladder slots.  Each runs only with a glue op
+ *             present AND its own parameter on; every skip is named:
+ *               fw-sleep    validated firmware sleep before stable-off (G2:
+ *                           no recovered command; the glue has no op)
+ *               stable-off  one R1 read of isStableOff after a verified
+ *                           Fender stop leg (G6: default off)
+ *               pmgr-gate   outgoing PMGR power gate (G1: not implemented,
+ *                           there is no op and no parameter)
+ *   RETIRE    the retired latch: from here on g5p_r8_mmio_ok() refuses R0,
+ *             R1 and every write except the always-on AIC ack of a late
+ *             handler entry.  The latch is set whatever the verdict.
+ *
+ * Generations: gen counts real runs (CAPTURE and FINAL) since boot and is
+ * monotonic; a REENTRY (a second FINAL after retire, e.g. notifier then
+ * .shutdown then remove) prints a line but does not advance it.
+ *
+ * Pure policy, like teardown.h: no register access, no kernel API except
+ * cmpxchg(), READ_ONCE()/WRITE_ONCE(), scnprintf() and the errno names.  The
+ * same file is compiled by the kernel glue (teardown.inc) and by the offline
+ * tests (patches/gpu-recovery108/tests).  Needs teardown.h first.
+ */
+
+#define G5P_R8_CLOSED 0x80000000u /* admission word: closed bit */
+#define G5P_R8_INSIDE 0x7fffffffu /* admission word: submitters inside */
+#define G5P_R8_POLL_US 100
+#define G5P_R8_MAX_STEPS 512 /* ADMIT wait cap, independent of the clock */
+#define G5P_R8_ADMIT_US 20000 /* ADMIT wait budget */
+
+/* Admission: one word, closed bit + count of submitters inside the window. */
+struct g5p_r8_admit {
+	u32 word;
+};
+
+/* A submitter enters before its first check of driver state and leaves on
+ * every return path.  False once admission is closed: the submit must fail
+ * with -ESHUTDOWN and touch nothing.
+ */
+static inline bool g5p_r8_admit_enter(struct g5p_r8_admit *a)
+{
+	u32 cur = READ_ONCE(a->word), old;
+
+	for (;;) {
+		if ((cur & G5P_R8_CLOSED) ||
+		    (cur & G5P_R8_INSIDE) == G5P_R8_INSIDE)
+			return false;
+		old = cmpxchg(&a->word, cur, cur + 1);
+		if (old == cur)
+			return true;
+		cur = old;
+	}
+}
+
+static inline void g5p_r8_admit_exit(struct g5p_r8_admit *a)
+{
+	u32 cur = READ_ONCE(a->word), old;
+
+	for (;;) {
+		if (!(cur & G5P_R8_INSIDE))
+			return; /* unbalanced exit: never wrap into the closed bit */
+		old = cmpxchg(&a->word, cur, cur - 1);
+		if (old == cur)
+			return;
+		cur = old;
+	}
+}
+
+/* Close (idempotent).  Returns the submitters inside at the instant of closing. */
+static inline u32 g5p_r8_admit_close(struct g5p_r8_admit *a)
+{
+	u32 cur = READ_ONCE(a->word), old;
+
+	for (;;) {
+		old = cmpxchg(&a->word, cur, cur | G5P_R8_CLOSED);
+		if (old == cur)
+			return cur & G5P_R8_INSIDE;
+		cur = old;
+	}
+}
+
+static inline u32 g5p_r8_admit_inside(const struct g5p_r8_admit *a)
+{
+	return READ_ONCE(a->word) & G5P_R8_INSIDE;
+}
+
+static inline bool g5p_r8_admit_closed(const struct g5p_r8_admit *a)
+{
+	return READ_ONCE(a->word) & G5P_R8_CLOSED;
+}
+
+/* Epoch classes.  The dirty ones are never reported as clean (H10). */
+enum g5p_r8_class {
+	G5P_R8C_NEVER_BOOTED, /* shared pages never mapped */
+	G5P_R8C_UNRELEASED, /* mapped, firmware never released */
+	G5P_R8C_IDLE, /* released and ALIVE, no context ever claimed (not-run) */
+	G5P_R8C_CLEAN, /* claimed, every job signalled, no holder left */
+	G5P_R8C_HELD, /* clean, but a process still holds the claimed context */
+	G5P_R8C_PARKED, /* GPC=0 already verified by a park */
+	G5P_R8C_IN_FLIGHT, /* a job accepted and not signalled, or a worker inside a wait */
+	G5P_R8C_TIMEOUT, /* terminal latch = timeout (a late completion stays a timeout) */
+	G5P_R8C_FAULT, /* failed, event failure or a fault terminal */
+	G5P_R8C_ABORTED, /* bootstrap power abort latched (the r87b/C3 epoch) */
+	G5P_R8C_UNKNOWN, /* released, never ALIVE; or an unverified earlier stop */
+	G5P_R8C_N,
+};
+
+static const char *const g5p_r8_class_name[G5P_R8C_N] = {
+	"never-booted", "unreleased", "idle",  "clean",	  "held",    "parked",
+	"in-flight",	"timeout",    "fault", "aborted", "unknown",
+};
+
+static inline bool g5p_r8_class_dirty(enum g5p_r8_class c)
+{
+	return c >= G5P_R8C_IN_FLIGHT;
+}
+
+/* RAM-only inputs, read by the glue before the run (never from a register). */
+struct g5p_r8_in {
+	bool booted; /* b->maps_ready */
+	bool released; /* b->released */
+	bool alive; /* b->alive before FREEZE, or ALIVE was proven this boot */
+	bool failed; /* b->failed */
+	bool fault_event; /* b->event_failed */
+	int terminal; /* teardown terminal latch: 0 none, 1 complete, 2 timeout/fault */
+	bool claimed; /* a context claimed the device (DRM quarantined_context) */
+	bool held; /* ... and a render node file still references it */
+	u32 queued; /* accepted render jobs not yet signalled */
+	bool worker_busy; /* the command lock was busy: a worker may be inside a wait */
+	bool parked; /* b->parked */
+	bool stopped_unparked; /* b->stopped && !b->parked before this run */
+	bool power_abort; /* r73b early_power_abort */
+};
+
+static inline u32 g5p_r8_in_bits(const struct g5p_r8_in *i)
+{
+	return i->booted | i->released << 1 | i->alive << 2 | i->failed << 3 |
+	       i->fault_event << 4 | i->claimed << 5 | i->held << 6 |
+	       (i->queued != 0) << 7 | i->worker_busy << 8 | i->parked << 9 |
+	       i->stopped_unparked << 10 | i->power_abort << 11;
+}
+
+/* First match wins; the order is the precedence (docs section 3.2). */
+static inline enum g5p_r8_class g5p_r8_classify(const struct g5p_r8_in *i)
+{
+	if (!i->booted)
+		return G5P_R8C_NEVER_BOOTED;
+	if (!i->released)
+		return G5P_R8C_UNRELEASED;
+	if (i->stopped_unparked)
+		return G5P_R8C_UNKNOWN;
+	if (i->power_abort)
+		return G5P_R8C_ABORTED;
+	if (i->failed || i->fault_event)
+		return G5P_R8C_FAULT;
+	if (i->terminal == 2)
+		return G5P_R8C_TIMEOUT;
+	if (i->queued || i->worker_busy)
+		return G5P_R8C_IN_FLIGHT;
+	if (i->parked)
+		return G5P_R8C_PARKED;
+	if (!i->alive)
+		return G5P_R8C_UNKNOWN;
+	if (i->claimed)
+		return i->held ? G5P_R8C_HELD : G5P_R8C_CLEAN;
+	return G5P_R8C_IDLE;
+}
+
+enum g5p_r8_slot {
+	G5P_R8S_FW_SLEEP,
+	G5P_R8S_STABLE_OFF,
+	G5P_R8S_PMGR_GATE,
+	G5P_R8S_N,
+};
+
+enum g5p_r8_skip {
+	G5P_R8K_RAN, /* the slot ran (see its result) */
+	G5P_R8K_NO_MECHANISM, /* the glue has no op for it */
+	G5P_R8K_OFF, /* its parameter is off (default) */
+	G5P_R8K_NOT_FINAL, /* CAPTURE never runs a slot */
+	G5P_R8K_NEEDS_RT1, /* needs a verified Fender stop leg in this run */
+	G5P_R8K_DIRTY, /* the ladder ended dirty: no register access */
+	G5P_R8K_N,
+};
+
+static const char *const g5p_r8_skip_name[G5P_R8K_N] = {
+	"ran", "no-mechanism", "off", "not-final", "needs-rt1", "dirty",
+};
+
+#define G5P_R8F_ADMIT_OPEN \
+	BIT(0) /* submitters still inside at the ADMIT deadline */
+#define G5P_R8F_ADMIT_LATE BIT(1) /* ... or the step cap ended the wait */
+#define G5P_R8F_REENTRY BIT(2) /* answered after retire: nothing ran */
+#define G5P_R8F_BUSY BIT(3) /* a concurrent entrant was inside */
+#define G5P_R8F_SLOT_FAIL BIT(4) /* a slot ran and failed */
+#define G5P_R8F_STABLE_OFF BIT(5) /* stable-off slot read isStableOff == 1 */
+/* jobs still queued at DETACH (abandoned to their worker) */
+#define G5P_R8F_DETACH_OPEN BIT(6)
+
+/*
+ * Ops.  td_run runs the recovery98 ladder and returns its rc; td_flags/td_verdict
+ * read its result.  slot[] may hold NULL (no mechanism).  Only slot ops touch a
+ * register, and only after the ladder, never after RETIRE.
+ */
+struct g5p_r8_ops {
+	void *ctx;
+	u64 (*now_ns)(void *ctx);
+	void (*relax_us)(void *ctx, u32 us);
+	int (*td_run)(void *ctx, enum g5p_td_mode mode);
+	u32 (*td_flags)(void *ctx);
+	enum g5p_td_verdict (*td_verdict)(void *ctx);
+	int (*slot[G5P_R8S_N])(void *ctx, u32 *value);
+	void (*emit)(void *ctx, const char *line);
+};
+
+struct g5p_r8 {
+	struct g5p_r8_admit admit;
+	u32 admit_us; /* ADMIT budget */
+	bool slot_on[G5P_R8S_N]; /* the slots' parameters (default all off) */
+	/* latches */
+	int running;
+	int retired; /* 0, or the generation that retired the device */
+	u32 gen; /* monotonic: real runs since boot */
+	/* last run */
+	enum g5p_td_mode mode;
+	enum g5p_r8_class cls;
+	u32 in_bits, flags, inside0, inside1, steps, detach_queued;
+	enum g5p_r8_skip skip[G5P_R8S_N];
+	int slot_rc[G5P_R8S_N];
+	u32 slot_val[G5P_R8S_N];
+	int rc;
+	enum g5p_td_verdict verdict;
+	u32 lines; /* TR108 lines emitted since boot */
+};
+
+static inline void g5p_r8_init(struct g5p_r8 *s)
+{
+	*s = (struct g5p_r8){ .admit_us = G5P_R8_ADMIT_US };
+}
+
+/*
+ * The predicate for every register access outside the ladder: after RETIRE only
+ * RAM, a PMGR read and the AIC (the always-on swirq ack of a late handler entry)
+ * remain.  R0 and R1 are refused forever, whatever the verdict.
+ */
+static inline bool g5p_r8_mmio_ok(const struct g5p_r8 *s, enum g5p_td_dom d)
+{
+	if (d == G5P_TDD_RAM || d == G5P_TDD_PMGR || d == G5P_TDD_AIC)
+		return true;
+	return !READ_ONCE(s->retired);
+}
+
+static inline bool g5p_r8_retired(const struct g5p_r8 *s)
+{
+	return READ_ONCE(s->retired) != 0;
+}
+
+/* The DRM frontend's DETACH callback reports what it left to the job workers. */
+static inline void g5p_r8_note_detach(struct g5p_r8 *s, u32 queued)
+{
+	WRITE_ONCE(s->detach_queued, queued);
+	if (queued)
+		s->flags |= G5P_R8F_DETACH_OPEN;
+}
+
+static inline void g5p_r8_line(struct g5p_r8 *s, const struct g5p_r8_ops *o,
+			       const char *line)
+{
+	s->lines++;
+	if (o->emit)
+		o->emit(o->ctx, line);
+}
+
+/* Bounded RAM-only wait for submitters inside the admission window. */
+static inline void g5p_r8_admit_wait(struct g5p_r8 *s,
+				     const struct g5p_r8_ops *o)
+{
+	u64 deadline = o->now_ns(o->ctx) + (u64)s->admit_us * 1000;
+
+	s->inside0 = g5p_r8_admit_close(&s->admit);
+	s->inside1 = s->inside0;
+	s->steps = 0;
+	while (s->inside1) {
+		if (s->steps >= G5P_R8_MAX_STEPS) {
+			s->flags |= G5P_R8F_ADMIT_LATE;
+			break;
+		}
+		s->steps++;
+		if (o->now_ns(o->ctx) >= deadline)
+			break;
+		o->relax_us(o->ctx, G5P_R8_POLL_US);
+		s->inside1 = g5p_r8_admit_inside(&s->admit);
+	}
+	if (s->inside1)
+		s->flags |= G5P_R8F_ADMIT_OPEN;
+}
+
+static inline void g5p_r8_slots(struct g5p_r8 *s, const struct g5p_r8_ops *o)
+{
+	u32 tdf = o->td_flags ? o->td_flags(o->ctx) : 0;
+	unsigned int i;
+
+	for (i = 0; i < G5P_R8S_N; i++) {
+		s->slot_rc[i] = 0;
+		s->slot_val[i] = 0;
+		if (s->mode != G5P_TD_FINAL)
+			s->skip[i] = G5P_R8K_NOT_FINAL;
+		else if (!o->slot[i])
+			s->skip[i] = G5P_R8K_NO_MECHANISM;
+		else if (!s->slot_on[i])
+			s->skip[i] = G5P_R8K_OFF;
+		else if (s->verdict == G5P_TDV_DIRTY)
+			s->skip[i] = G5P_R8K_DIRTY;
+		else if (!(tdf & G5P_TDF_RT1_OK))
+			s->skip[i] = G5P_R8K_NEEDS_RT1;
+		else
+			s->skip[i] = G5P_R8K_RAN;
+	}
+	/* One attempt each, in slot order, no retry; a failed slot ends the slots. */
+	for (i = 0; i < G5P_R8S_N; i++) {
+		if (s->skip[i] != G5P_R8K_RAN)
+			continue;
+		if (s->flags & G5P_R8F_SLOT_FAIL) {
+			s->skip[i] = G5P_R8K_DIRTY;
+			continue;
+		}
+		s->slot_rc[i] = o->slot[i](o->ctx, &s->slot_val[i]);
+		if (s->slot_rc[i])
+			s->flags |= G5P_R8F_SLOT_FAIL;
+		else if (i == G5P_R8S_STABLE_OFF && s->slot_val[i] == 1)
+			s->flags |= G5P_R8F_STABLE_OFF;
+	}
+}
+
+/*
+ * One run.  mode is the teardown mode the glue chose (teardown=1 CAPTURE,
+ * teardown=2 FINAL).  Returns the ladder's rc, -EBUSY for a concurrent entrant,
+ * and the cached rc after retire.  Lines:
+ *   TR108 gen= phase=classify why= mode= class= dirty= in= inside= after= flags= admit_us=
+ *   (TD98 lines of the ladder, unchanged)
+ *   TR108 gen= phase=retired|captured verdict= class= flags= fw-sleep= stable-off= pmgr-gate=
+ *         so=<isStableOff> detach_queued= rc=
+ *   TR108 gen= phase=reentry why= retired_gen= rc=      (after retire; no gen step)
+ */
+static inline int g5p_r8_run(struct g5p_r8 *s, const struct g5p_r8_ops *o,
+			     enum g5p_td_mode mode, const struct g5p_r8_in *in,
+			     const char *why)
+{
+	char line[256];
+	u64 t0;
+	int rc;
+
+	if (cmpxchg(&s->running, 0, 1)) {
+		/* A concurrent entrant touches nothing; it does not reach the ladder either. */
+		scnprintf(line, sizeof(line),
+			  "TR108 gen=%u phase=busy why=%s mode=%s rc=%d",
+			  READ_ONCE(s->gen), why, g5p_td_mode_name[mode],
+			  -EBUSY);
+		if (o->emit)
+			o->emit(o->ctx, line);
+		return -EBUSY;
+	}
+	if (READ_ONCE(s->retired)) {
+		/* The ladder answers from its cache too (REENTRY); nothing else runs. */
+		rc = o->td_run(o->ctx, mode);
+		scnprintf(line, sizeof(line),
+			"TR108 gen=%u phase=reentry why=%s mode=%s retired_gen=%d rc=%d",
+			s->gen, why, g5p_td_mode_name[mode],
+			READ_ONCE(s->retired), rc);
+		g5p_r8_line(s, o, line);
+		WRITE_ONCE(s->running, 0);
+		return s->rc;
+	}
+	s->gen++;
+	s->mode = mode;
+	s->flags = 0;
+	s->inside0 = 0;
+	s->inside1 = 0;
+	s->steps = 0;
+	WRITE_ONCE(s->detach_queued, 0);
+	t0 = o->now_ns(o->ctx);
+	if (mode == G5P_TD_FINAL)
+		g5p_r8_admit_wait(s, o);
+	s->cls = g5p_r8_classify(in);
+	s->in_bits = g5p_r8_in_bits(in);
+	scnprintf(line, sizeof(line),
+		"TR108 gen=%u phase=classify why=%s mode=%s class=%s dirty=%u in=%03x term=%d queued=%u inside=%u after=%u flags=%02x admit_us=%u",
+		s->gen, why, g5p_td_mode_name[mode], g5p_r8_class_name[s->cls],
+		g5p_r8_class_dirty(s->cls), s->in_bits, in->terminal,
+		in->queued, s->inside0, s->inside1, s->flags,
+		(u32)((o->now_ns(o->ctx) - t0) / 1000));
+	/* The receipt is out before the ladder's first AIC or R1 access. */
+	g5p_r8_line(s, o, line);
+	s->rc = o->td_run(o->ctx, mode);
+	s->verdict = o->td_verdict ? o->td_verdict(o->ctx) : G5P_TDV_NONE;
+	g5p_r8_slots(s, o);
+	if (mode == G5P_TD_FINAL)
+		WRITE_ONCE(s->retired, (int)s->gen);
+	scnprintf(line, sizeof(line),
+		"TR108 gen=%u phase=%s verdict=%s class=%s flags=%02x fw-sleep=%s stable-off=%s pmgr-gate=%s so=%u detach_queued=%u rc=%d",
+		s->gen, mode == G5P_TD_FINAL ? "retired" : "captured",
+		g5p_td_verdict_name[s->verdict], g5p_r8_class_name[s->cls],
+		s->flags, g5p_r8_skip_name[s->skip[G5P_R8S_FW_SLEEP]],
+		g5p_r8_skip_name[s->skip[G5P_R8S_STABLE_OFF]],
+		g5p_r8_skip_name[s->skip[G5P_R8S_PMGR_GATE]],
+		s->slot_val[G5P_R8S_STABLE_OFF], READ_ONCE(s->detach_queued),
+		s->rc);
+	g5p_r8_line(s, o, line);
+	WRITE_ONCE(s->running, 0);
+	return s->rc;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/teardown.h b/drivers/gpu/apple-g5p/teardown.h
new file mode 100644
index 000000000..b536f428c
--- /dev/null
+++ b/drivers/gpu/apple-g5p/teardown.h
@@ -0,0 +1,740 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_TEARDOWN_H
+#define G5P_TEARDOWN_H
+
+#include "bits-compat.h"
+
+/*
+ * G5P GPU teardown state machine (series gpu-recovery98).
+ *
+ * Design and evidence: docs/gpu/experiments/gpu-warm-kexec-hang-proof.md.
+ *
+ * Pure policy: no register access, no kernel API except cmpxchg(), scnprintf()
+ * and the errno names. Every hardware or firmware-visible access goes through
+ * struct g5p_td_ops, and every call is checked against g5p_td_allow[phase][domain]
+ * before it is made. The same file is compiled by the kernel glue (teardown.inc)
+ * and by the offline fault-injection tests (patches/gpu-recovery/tests).
+ *
+ * Two modes:
+ *   CAPTURE  timeout / fault / attach failure, and (gpu-recovery99) any number of looks at a
+ * live epoch. Observation only: reads RAM rings,
+ *            changes nothing the host could still want to export. Never writes
+ *            driver or firmware-shared state, never masks the IRQ, never touches
+ *            a register. Arms the quiet latch for diagnostics (g5p_td_mmio_ok()).
+ *   FINAL    shutdown / reboot notifier / remove. Runs the whole ladder and leaves
+ *            a known state for the next kernel.
+ *
+ * Domains: RAM (DMA pages + driver structs), AIC (swirq 0x20e104000 ack and the
+ * IRQ-chip mask), R1 (Fender wrapper window), R0 (core register window), PMGR
+ * (0x20e080340 read-only). R0 has no op at all and is forbidden in every phase.
+ * PMGR is read-only in every phase. R1 is reachable only in the RESET phase.
+ *
+ * Nothing here frees or reuses memory the GPU might still access.
+ */
+
+#define G5P_TD_NCMD 4 /* command rings: shared objects 0x60 0x64 0x68 0x6c */
+#define G5P_TD_NRING (G5P_TD_NCMD + 1) /* + event ring (object 0x70) */
+#define G5P_TD_MAX_RCPT 12
+#define G5P_TD_MAX_STEPS 4096 /* hard stop independent of the clock */
+#define G5P_TD_POLL_US 100
+#define G5P_TD_EV_SLACK \
+	16 /* events produced during the phase above this = storm */
+
+enum g5p_td_mode {
+	G5P_TD_CAPTURE = 1,
+	G5P_TD_FINAL = 2,
+};
+
+enum g5p_td_phase {
+	G5P_TDP_FREEZE, /* stopped=1 alive=0, watchdog disarmed (RAM) */
+	G5P_TDP_ACCOUNT, /* RAM-only ring/event accounting */
+	G5P_TDP_DRAIN, /* bounded RAM-only wait for the firmware to self-drain */
+	G5P_TDP_EVENTS, /* bounded RAM-only event-ring quiesce */
+	G5P_TDP_IRQ, /* AIC ack, IRQ mask, settle */
+	G5P_TDP_DETACH, /* host detach, RAM only */
+	G5P_TDP_RESET, /* RT1 Fender stop leg when eligible; PMGR read */
+	G5P_TDP_DONE,
+	G5P_TDP_N,
+};
+
+enum g5p_td_dom {
+	G5P_TDD_RAM,
+	G5P_TDD_AIC,
+	G5P_TDD_R1,
+	G5P_TDD_R0,
+	G5P_TDD_PMGR,
+	G5P_TDD_N,
+};
+
+#define G5P_TDA_R 1
+#define G5P_TDA_W 2
+#define G5P_TDA_RW 3
+
+/* Hard stop boundaries. A phase may only use the domains marked here. */
+static const unsigned char g5p_td_allow[G5P_TDP_N][G5P_TDD_N] = {
+	/*                        RAM          AIC         R1           R0  PMGR */
+	[G5P_TDP_FREEZE] = { G5P_TDA_RW, 0, 0, 0, 0 },
+	[G5P_TDP_ACCOUNT] = { G5P_TDA_R, 0, 0, 0, 0 },
+	[G5P_TDP_DRAIN] = { G5P_TDA_R, 0, 0, 0, 0 },
+	[G5P_TDP_EVENTS] = { G5P_TDA_RW, 0, 0, 0, 0 },
+	[G5P_TDP_IRQ] = { G5P_TDA_R, G5P_TDA_W, 0, 0, 0 },
+	[G5P_TDP_DETACH] = { G5P_TDA_RW, 0, 0, 0, 0 },
+	[G5P_TDP_RESET] = { G5P_TDA_R, 0, G5P_TDA_RW, 0, G5P_TDA_R },
+	[G5P_TDP_DONE] = { G5P_TDA_R, 0, 0, 0, 0 },
+};
+
+#define G5P_TDF_NOT_BOOTED \
+	BIT(0) /* shared pages not mapped: nothing to tear down */
+#define G5P_TDF_UNRELEASED BIT(1) /* firmware never released */
+#define G5P_TDF_PROTOCOL \
+	BIT(2) /* ring index > 255, read error, producer moved */
+#define G5P_TDF_TERMINAL BIT(3) /* TA complete/timeout latched before entry */
+#define G5P_TDF_LATE_TERMINAL BIT(4) /* ... or during the teardown (race) */
+#define G5P_TDF_ABANDON BIT(5) /* >=1 ring pending after the drain */
+#define G5P_TDF_SELF_DRAINED \
+	BIT(6) /* >=1 ring consumed by the firmware, no bell */
+#define G5P_TDF_FAULT_EVENT \
+	BIT(7) /* event type other than 0/1 left unconsumed */
+#define G5P_TDF_EV_UNQUIET \
+	BIT(8) /* event ring still non-empty after the budget */
+#define G5P_TDF_IRQ_UNSETTLED BIT(9) /* IRQ count still moving after the mask */
+#define G5P_TDF_RT1_OK BIT(10) /* Fender stop leg verified GPC=0 */
+#define G5P_TDF_RT1_FAIL BIT(11) /* stop leg attempted, not verified */
+#define G5P_TDF_RT1_SKIPPED BIT(12) /* no register access; see skip reason */
+#define G5P_TDF_OVERRUN BIT(13) /* step or time budget exhausted */
+#define G5P_TDF_VIOLATION BIT(14) /* a gate refused an access (machine bug) */
+#define G5P_TDF_CAPTURE_ONLY BIT(15) /* CAPTURE run: nothing was changed */
+#define G5P_TDF_REENTRY BIT(16) /* second entry answered from the cache */
+
+enum g5p_td_skip {
+	G5P_TDS_NONE,
+	G5P_TDS_NOT_BOOTED,
+	G5P_TDS_NOT_RELEASED,
+	G5P_TDS_NOT_POWERED,
+	G5P_TDS_ALREADY_PARKED, /* clean: GPC=0 already verified by park */
+	G5P_TDS_STOPPED_UNPARKED, /* dirty: an earlier stop leg did not verify */
+	G5P_TDS_POWER_ABORT,
+	G5P_TDS_FW_POLICY, /* meta+0x6c8 != 0: firmware also writes R1+0x1000 */
+	G5P_TDS_LOCK_BUSY,
+	G5P_TDS_CAPTURE_MODE,
+	G5P_TDS_BAD_STATE, /* protocol/overrun/unsettled IRQ: no register access */
+	G5P_TDS_N,
+};
+
+enum g5p_td_verdict {
+	G5P_TDV_NONE,
+	G5P_TDV_OBSERVED, /* CAPTURE: nothing changed */
+	G5P_TDV_UNTOUCHED, /* never booted or never released: nothing to do */
+	G5P_TDV_QUIESCED, /* rings clear, events clear, IRQ masked, GPC=0 verified */
+	G5P_TDV_ABANDONED, /* as QUIESCED, but >=1 command abandoned after the drain */
+	G5P_TDV_RAM_ONLY, /* IRQ masked, no register access: GPU left as found */
+	G5P_TDV_DIRTY, /* a step failed: warm continue forbidden, cold DFU */
+	G5P_TDV_N,
+};
+
+static const char *const g5p_td_phase_name[G5P_TDP_N] = {
+	"freeze", "account", "drain", "events",
+	"irq",	  "detach",  "reset", "done",
+};
+
+static const char *const g5p_td_mode_name[3] = { "none", "capture", "final" };
+
+static const char *const g5p_td_verdict_name[G5P_TDV_N] = {
+	"none",	     "observed", "untouched", "quiesced",
+	"abandoned", "ram-only", "dirty",
+};
+
+struct g5p_td_budget {
+	u32 drain_us; /* self-drain wait; DC3 took 2.34 ms (r87b) */
+	u32 events_us;
+	u32 settle_us; /* IRQ count must stay constant this long after the mask */
+	u32 events_pass_max; /* entries per pass; the ring has 256 slots */
+	u32 events_passes;
+	u32 total_us; /* RESET is skipped when the RAM phases already overran this */
+};
+
+#define G5P_TD_BUDGET_DEFAULT { 20000, 20000, 2000, 256, 4, 100000 }
+
+/* Inputs the glue reads from RAM before the run (never from a register). */
+struct g5p_td_pre {
+	bool booted; /* maps_ready: shared pages exist */
+	bool released; /* firmware was released */
+	bool powered; /* ps_gfx held on by the retained PM reference */
+	bool fender_ready;
+	bool already_parked; /* b->parked: GPC=0 verified by park */
+	bool stopped_unparked; /* b->stopped && !b->parked: an earlier stop did not verify */
+	bool policy_host_owned; /* init meta+0x6c8 == 0 */
+	bool power_abort; /* r73b early_power_abort latched */
+	bool lock_held; /* the glue holds g->lock: no worker is inside a hardware wait */
+};
+
+/*
+ * Every op is bounded by its own contract; the machine additionally bounds how
+ * often and for how long it calls them. Ops marked RAM never touch a register.
+ */
+struct g5p_td_ops {
+	void *ctx;
+	u64 (*now_ns)(void *ctx);
+	void (*relax_us)(void *ctx, u32 us); /* sleep, no register access */
+	void (*freeze)(void *ctx); /* RAM: stopped=1 alive=0, disarm */
+	/* RAM: idx 0..NCMD-1 command rings, NCMD = event ring. -ENODEV: not mapped. */
+	int (*ring_read)(void *ctx, u32 idx, u32 *cons, u32 *prod);
+	/* RAM: consume at most max entries of type 0/1, stop at the first other type. */
+	int (*event_pass)(void *ctx, u32 max, u32 *consumed, u32 *left,
+			  bool *fault);
+	bool (*terminal_seen)(void *ctx); /* RAM: TA complete/timeout latch */
+	void (*detach)(void *ctx); /* RAM: signal/forget host jobs */
+	void (*aic_ack)(void *ctx); /* AIC: swirq+0x94 = 0x4000 */
+	void (*irq_mask)(void *ctx); /* AIC: ack stays, line masked */
+	u32 (*irq_total)(void *ctx); /* RAM: handler entry counter */
+	int (*fender_stop)(void *ctx); /* R1: g5p_fender_idle() */
+	int (*pmgr_actual)(void *ctx, u32 *target,
+			   u32 *actual); /* PMGR read; may be NULL */
+	void (*emit)(void *ctx, const char *line); /* printk; may be NULL */
+};
+
+struct g5p_td_receipt {
+	unsigned char seq, phase, mode, verdict;
+	s32 rc;
+	u32 us, steps, flags;
+	unsigned char cnt[G5P_TDD_N]
+			 [2]; /* [dom][0]=reads [dom][1]=writes, op level */
+	u32 a, b; /* phase specific, see g5p_td_run() */
+};
+
+struct g5p_td {
+	struct g5p_td_budget budget;
+	/* latches shared with the render path; touched by cmpxchg only */
+	int running; /* 0 idle, 1 inside g5p_td_run() */
+	int terminal; /* 0, 1 complete, 2 timeout: first writer wins */
+	int quiet; /* diagnostics MMIO forbidden from here on */
+	/* 0 idle, 1 captured (informational), 2 finalized: only 2 answers from the cache */
+	int state;
+	u32 snaps; /* CAPTURE runs since init: the n= of the TD99 snap line */
+	/* per run */
+	enum g5p_td_mode mode;
+	enum g5p_td_phase phase;
+	enum g5p_td_skip skip;
+	enum g5p_td_verdict verdict;
+	bool eligible;
+	u32 flags, steps, violations, seq, nrcpt;
+	u64 t0_ns;
+	unsigned char cnt[G5P_TDD_N]
+			 [2]; /* [enum g5p_td_dom][0=reads,1=writes], op level */
+	u32 pending_mask, pending_initial, abandoned, drained;
+	u32 ring_cons[G5P_TD_NRING], ring_prod[G5P_TD_NRING];
+	u32 ev_consumed, ev_left, ev_initial, irq_before, irq_after;
+	u32 us_total;
+	u32 pmgr_target, pmgr_actual;
+	int rc;
+	struct g5p_td_receipt rcpt[G5P_TD_MAX_RCPT];
+};
+
+static inline void g5p_td_init(struct g5p_td *t)
+{
+	const struct g5p_td_budget b = G5P_TD_BUDGET_DEFAULT;
+
+	*t = (struct g5p_td){ .budget = b };
+}
+
+/* One latch for "the TA reached a terminal state"; the first writer wins. */
+static inline bool g5p_td_note_terminal(struct g5p_td *t, int kind)
+{
+	if (cmpxchg(&t->terminal, 0, kind) != 0)
+		return false;
+	WRITE_ONCE(t->quiet, 1);
+	return true;
+}
+
+/*
+ * The single predicate for diagnostic register access (R0 snapshots, end banks,
+ * exports): false once the epoch is terminal or a teardown has started. Nothing
+ * in this series calls a diagnostic; this exists so the render path can.
+ */
+
+/* RT1 (Fender stop leg) eligibility. Pure function of RAM-derived inputs. */
+static inline bool g5p_td_eligible(const struct g5p_td_pre *p,
+				   enum g5p_td_mode mode, enum g5p_td_skip *why)
+{
+	enum g5p_td_skip s = G5P_TDS_NONE;
+
+	if (!p->booted)
+		s = G5P_TDS_NOT_BOOTED;
+	else if (!p->released)
+		s = G5P_TDS_NOT_RELEASED;
+	else if (!p->powered || !p->fender_ready)
+		s = G5P_TDS_NOT_POWERED;
+	else if (p->already_parked)
+		s = G5P_TDS_ALREADY_PARKED;
+	else if (p->stopped_unparked)
+		s = G5P_TDS_STOPPED_UNPARKED;
+	else if (p->power_abort)
+		s = G5P_TDS_POWER_ABORT;
+	else if (!p->policy_host_owned)
+		s = G5P_TDS_FW_POLICY;
+	else if (!p->lock_held)
+		s = G5P_TDS_LOCK_BUSY;
+	else if (mode != G5P_TD_FINAL)
+		s = G5P_TDS_CAPTURE_MODE;
+	if (why)
+		*why = s;
+	return s == G5P_TDS_NONE;
+}
+
+static inline int g5p_td_format(const struct g5p_td_receipt *r, char *buf,
+				size_t n)
+{
+	return scnprintf(buf, n,
+		"TD98 seq=%u phase=%s mode=%s rc=%d us=%u steps=%u flags=%08x aic=%u/%u r1=%u/%u r0=%u/%u pmgr=%u/%u a=%u b=%u verdict=%s",
+		r->seq, g5p_td_phase_name[r->phase], g5p_td_mode_name[r->mode],
+		r->rc, r->us, r->steps, r->flags, r->cnt[G5P_TDD_AIC][0],
+		r->cnt[G5P_TDD_AIC][1], r->cnt[G5P_TDD_R1][0],
+		r->cnt[G5P_TDD_R1][1], r->cnt[G5P_TDD_R0][0],
+		r->cnt[G5P_TDD_R0][1], r->cnt[G5P_TDD_PMGR][0],
+		r->cnt[G5P_TDD_PMGR][1], r->a, r->b,
+		g5p_td_verdict_name[r->verdict]);
+}
+
+static inline u32 g5p_td_us_since(const struct g5p_td *t,
+				  const struct g5p_td_ops *o)
+{
+	u64 d = o->now_ns(o->ctx) - t->t0_ns;
+
+	return d > 0xffffffffULL * 1000 ? 0xffffffffu : (u32)(d / 1000);
+}
+
+static inline void g5p_td_receipt(struct g5p_td *t, const struct g5p_td_ops *o,
+				  int rc, u32 a, u32 b)
+{
+	struct g5p_td_receipt *r =
+		&t->rcpt[t->nrcpt < G5P_TD_MAX_RCPT ? t->nrcpt :
+						      G5P_TD_MAX_RCPT - 1];
+	char line[224];
+	unsigned int d;
+
+	r->seq = (unsigned char)t->seq++;
+	r->phase = t->phase;
+	r->mode = t->mode;
+	r->verdict = t->verdict;
+	r->rc = rc;
+	r->us = g5p_td_us_since(t, o);
+	r->steps = t->steps;
+	r->flags = t->flags;
+	for (d = 0; d < G5P_TDD_N; d++) {
+		r->cnt[d][0] = t->cnt[d][0];
+		r->cnt[d][1] = t->cnt[d][1];
+	}
+	r->a = a;
+	r->b = b;
+	if (t->nrcpt < G5P_TD_MAX_RCPT)
+		t->nrcpt++;
+	if (o->emit) {
+		g5p_td_format(r, line, sizeof(line));
+		o->emit(o->ctx, line);
+	}
+}
+
+/* Count and check one access. A refused access is a bug in the machine itself. */
+static inline int g5p_td_gate(struct g5p_td *t, enum g5p_td_dom d,
+			      unsigned int acc)
+{
+	if ((g5p_td_allow[t->phase][d] & acc) != acc) {
+		t->violations++;
+		t->flags |= G5P_TDF_VIOLATION;
+		return -EACCES;
+	}
+	if ((acc & G5P_TDA_R) && t->cnt[d][0] < 255)
+		t->cnt[d][0]++;
+	if ((acc & G5P_TDA_W) && t->cnt[d][1] < 255)
+		t->cnt[d][1]++;
+	return 0;
+}
+
+/* One loop iteration or hardware op. False once the hard step cap is hit. */
+static inline bool g5p_td_step(struct g5p_td *t)
+{
+	if (t->steps >= G5P_TD_MAX_STEPS) {
+		t->flags |= G5P_TDF_OVERRUN;
+		return false;
+	}
+	t->steps++;
+	return true;
+}
+
+static inline bool g5p_td_ring_ok(u32 cons, u32 prod)
+{
+	return cons <= 255 && prod <= 255;
+}
+
+static inline void g5p_td_note_late(struct g5p_td *t,
+				    const struct g5p_td_ops *o)
+{
+	if (o->terminal_seen && o->terminal_seen(o->ctx) &&
+	    !(t->flags & G5P_TDF_TERMINAL))
+		t->flags |= G5P_TDF_LATE_TERMINAL;
+}
+
+static inline int g5p_td_account(struct g5p_td *t, const struct g5p_td_ops *o)
+{
+	u32 i, bad = 0, pending = 0, cons, prod;
+	int rc;
+
+	for (i = 0; i < G5P_TD_NRING; i++) {
+		if (!g5p_td_step(t))
+			return -ETIMEDOUT;
+		if (g5p_td_gate(t, G5P_TDD_RAM, G5P_TDA_R))
+			return -EACCES;
+		rc = o->ring_read(o->ctx, i, &cons, &prod);
+		if (rc == -ENODEV) {
+			t->flags |= G5P_TDF_NOT_BOOTED;
+			break;
+		}
+		if (rc || !g5p_td_ring_ok(cons, prod)) {
+			t->flags |= G5P_TDF_PROTOCOL;
+			bad++;
+			continue;
+		}
+		t->ring_cons[i] = cons;
+		t->ring_prod[i] = prod;
+		if (i < G5P_TD_NCMD && cons != prod) {
+			t->pending_mask |= 1u << i;
+			pending++;
+		}
+	}
+	t->pending_initial = pending;
+	t->ev_left = (t->ring_prod[G5P_TD_NCMD] - t->ring_cons[G5P_TD_NCMD]) &
+		     255;
+	t->ev_initial = t->ev_left;
+	g5p_td_receipt(t, o, bad ? -EPROTO : 0, pending, bad);
+	return 0;
+}
+
+/*
+ * gpu-recovery99 0004: one extra line per CAPTURE run, after the ACCOUNT receipt, so a live
+ * epoch can be looked at
+ * several times (S1a). RAM only: it formats what ACCOUNT stored in struct g5p_td and reads the
+ * handler entry counter
+ * (RAM) and the clock; no register, no state change. The prefix is not TD98 on purpose: receipt
+ * parsers keyed on
+ * "TD98 seq=" / "TD98 begin" ignore it.
+ *   n      CAPTURE runs since init (1 based)
+ *   t_ns   ops->now_ns(), for the IRQ rate between two lines
+ *   irq    handler entry counter (ops->irq_total), 0 if there is no such op
+ *   term   terminal latch (0 none, 1 complete, 2 timeout); quiet = the diagnostics latch
+ *   own    bit0 booted 1 released 2 powered 3 fender_ready 4 already_parked 5 stopped_unparked
+ *          6 policy_host_owned 7 power_abort 8 lock_held
+ *   cN/pN  command ring N consumer / producer; ce/pe the event ring. Zero when the shared pages
+ * are not mapped.
+ */
+static inline void g5p_td_snap(struct g5p_td *t, const struct g5p_td_ops *o,
+			       const struct g5p_td_pre *pre)
+{
+	char line[224];
+	u32 own, irq = 0;
+
+	t->snaps++;
+	if (!o->emit)
+		return;
+	if (!g5p_td_gate(t, G5P_TDD_RAM, G5P_TDA_R) && o->irq_total)
+		irq = o->irq_total(o->ctx);
+	own = pre->booted | pre->released << 1 | pre->powered << 2 |
+	      pre->fender_ready << 3 | pre->already_parked << 4 |
+	      pre->stopped_unparked << 5 | pre->policy_host_owned << 6 |
+	      pre->power_abort << 7 | pre->lock_held << 8;
+	scnprintf(line, sizeof(line),
+		"TD99 snap n=%u t_ns=%llu irq=%u term=%d quiet=%d own=%03x c0=%u p0=%u c1=%u p1=%u c2=%u p2=%u c3=%u p3=%u ce=%u pe=%u",
+		t->snaps, (unsigned long long)o->now_ns(o->ctx), irq,
+		READ_ONCE(t->terminal), READ_ONCE(t->quiet), own,
+		t->ring_cons[0], t->ring_prod[0], t->ring_cons[1],
+		t->ring_prod[1], t->ring_cons[2], t->ring_prod[2],
+		t->ring_cons[3], t->ring_prod[3], t->ring_cons[G5P_TD_NCMD],
+		t->ring_prod[G5P_TD_NCMD]);
+	o->emit(o->ctx, line);
+}
+
+static inline void g5p_td_drain(struct g5p_td *t, const struct g5p_td_ops *o)
+{
+	u64 deadline = o->now_ns(o->ctx) + (u64)t->budget.drain_us * 1000;
+	u32 i, cons, prod;
+
+	while (t->pending_mask) {
+		if (!g5p_td_step(t))
+			break;
+		if (o->now_ns(o->ctx) >= deadline) {
+			t->flags |= G5P_TDF_ABANDON;
+			break;
+		}
+		o->relax_us(o->ctx, G5P_TD_POLL_US);
+		for (i = 0; i < G5P_TD_NCMD; i++) {
+			if (!(t->pending_mask & (1u << i)))
+				continue;
+			if (g5p_td_gate(t, G5P_TDD_RAM, G5P_TDA_R))
+				return;
+			if (o->ring_read(o->ctx, i, &cons, &prod) ||
+			    !g5p_td_ring_ok(cons, prod) ||
+			    prod != t->ring_prod[i]) {
+				/* The producer is host-written and the host is frozen. */
+				t->flags |= G5P_TDF_PROTOCOL;
+				t->pending_mask &= ~(1u << i);
+				continue;
+			}
+			if (cons == prod) {
+				t->pending_mask &= ~(1u << i);
+				t->flags |= G5P_TDF_SELF_DRAINED;
+			}
+		}
+	}
+	for (i = 0; i < G5P_TD_NCMD; i++)
+		if (t->pending_mask & (1u << i))
+			t->abandoned++;
+	if (t->abandoned)
+		t->flags |= G5P_TDF_ABANDON;
+	t->drained = t->pending_initial - t->abandoned;
+}
+
+static inline void g5p_td_events(struct g5p_td *t, const struct g5p_td_ops *o)
+{
+	u64 deadline = o->now_ns(o->ctx) + (u64)t->budget.events_us * 1000;
+	u32 pass, consumed, left = t->ev_left;
+	bool fault = false;
+	int rc;
+
+	for (pass = 0; pass < t->budget.events_passes && left; pass++) {
+		if (!g5p_td_step(t))
+			break;
+		if (g5p_td_gate(t, G5P_TDD_RAM, G5P_TDA_RW))
+			return;
+		consumed = 0;
+		rc = o->event_pass(o->ctx, t->budget.events_pass_max, &consumed,
+				   &left, &fault);
+		t->ev_consumed += consumed;
+		if (rc) {
+			t->flags |= G5P_TDF_PROTOCOL;
+			break;
+		}
+		if (fault) {
+			/* Retained for the host; stop consuming, the IRQ is masked next. */
+			t->flags |= G5P_TDF_FAULT_EVENT;
+			break;
+		}
+		if (!left || o->now_ns(o->ctx) >= deadline)
+			break;
+		o->relax_us(o->ctx, G5P_TD_POLL_US);
+	}
+	t->ev_left = left;
+	/*
+	 * A ring holds at most 255 entries, so consuming more than the backlog plus a
+	 * few ALIVE ticks means the producer outran us: an empty ring at the last
+	 * look is a snapshot, not a quiesce.
+	 */
+	if (!fault && (left || (s32)(t->ev_consumed + left - t->ev_initial) >
+				       G5P_TD_EV_SLACK))
+		t->flags |= G5P_TDF_EV_UNQUIET;
+}
+
+static inline void g5p_td_irq(struct g5p_td *t, const struct g5p_td_ops *o)
+{
+	u32 tries, n0, n1;
+
+	if (g5p_td_gate(t, G5P_TDD_AIC, G5P_TDA_W) ||
+	    g5p_td_gate(t, G5P_TDD_AIC, G5P_TDA_W))
+		return;
+	t->irq_before = o->irq_total(o->ctx);
+	/* Same pair as the IRQ-cap path: ack the software source, then mask the line. */
+	o->aic_ack(o->ctx);
+	o->irq_mask(o->ctx);
+	for (tries = 0; tries < 3; tries++) {
+		if (!g5p_td_step(t))
+			break;
+		n0 = o->irq_total(o->ctx);
+		o->relax_us(o->ctx, t->budget.settle_us);
+		n1 = o->irq_total(o->ctx);
+		t->irq_after = n1;
+		if (n0 == n1)
+			return;
+	}
+	t->flags |= G5P_TDF_IRQ_UNSETTLED;
+}
+
+static inline void g5p_td_reset(struct g5p_td *t, const struct g5p_td_ops *o,
+				const struct g5p_td_pre *pre)
+{
+	enum g5p_td_skip why = G5P_TDS_NONE;
+	bool bad = t->flags & (G5P_TDF_PROTOCOL | G5P_TDF_OVERRUN |
+			       G5P_TDF_IRQ_UNSETTLED | G5P_TDF_VIOLATION);
+	int rc = 0;
+
+	t->eligible = g5p_td_eligible(pre, t->mode, &why);
+	if (t->eligible &&
+	    (bad || g5p_td_us_since(t, o) > t->budget.total_us)) {
+		t->eligible = false;
+		why = G5P_TDS_BAD_STATE;
+	}
+	t->skip = why;
+	if (!t->eligible) {
+		t->flags |= G5P_TDF_RT1_SKIPPED;
+	} else if (!g5p_td_step(t) || g5p_td_gate(t, G5P_TDD_R1, G5P_TDA_RW)) {
+		t->flags |= G5P_TDF_RT1_SKIPPED;
+		t->skip = G5P_TDS_BAD_STATE;
+	} else {
+		/*
+		 * Apple stopFirmwareForPowerDown 6c9fa10, R1 only; flown here after a DC
+		 * timeout (round 10). Never retried, even on failure.
+		 */
+		rc = o->fender_stop(o->ctx);
+		t->flags |= rc ? G5P_TDF_RT1_FAIL : G5P_TDF_RT1_OK;
+	}
+	if (o->pmgr_actual && !g5p_td_gate(t, G5P_TDD_PMGR, G5P_TDA_R))
+		o->pmgr_actual(o->ctx, &t->pmgr_target, &t->pmgr_actual);
+	g5p_td_receipt(t, o, rc, t->eligible ? 0 : (u32)t->skip,
+		       t->pmgr_actual);
+}
+
+static inline void g5p_td_decide(struct g5p_td *t, const struct g5p_td_pre *pre)
+{
+	bool dirty = t->flags & (G5P_TDF_PROTOCOL | G5P_TDF_EV_UNQUIET |
+				 G5P_TDF_IRQ_UNSETTLED | G5P_TDF_RT1_FAIL |
+				 G5P_TDF_OVERRUN | G5P_TDF_VIOLATION) ||
+		     t->skip == G5P_TDS_STOPPED_UNPARKED ||
+		     t->skip == G5P_TDS_BAD_STATE;
+
+	if (t->mode == G5P_TD_CAPTURE)
+		t->verdict = (t->flags & G5P_TDF_VIOLATION) ? G5P_TDV_DIRTY :
+							      G5P_TDV_OBSERVED;
+	else if (dirty)
+		t->verdict = G5P_TDV_DIRTY;
+	else if (t->flags & (G5P_TDF_NOT_BOOTED | G5P_TDF_UNRELEASED))
+		t->verdict = G5P_TDV_UNTOUCHED;
+	else if (t->flags & G5P_TDF_RT1_OK || t->skip == G5P_TDS_ALREADY_PARKED)
+		t->verdict = (t->flags & G5P_TDF_ABANDON) ? G5P_TDV_ABANDONED :
+							    G5P_TDV_QUIESCED;
+	else
+		t->verdict = G5P_TDV_RAM_ONLY;
+	(void)pre;
+}
+
+/*
+ * Run the teardown once per mode. Returns 0 for QUIESCED/ABANDONED/UNTOUCHED/OBSERVED,
+ * -EAGAIN for RAM_ONLY (clean, but the GPU was left as found), -EIO for DIRTY,
+ * -EBUSY if another caller is inside the machine. Every phase ends in a receipt.
+ * Receipt a/b: account pending/bad, drain drained/abandoned, events consumed/left,
+ * irq before/after, reset skip-reason/pmgr-actual, done skip-reason/abandoned.
+ * Counters in the receipts are op-level (one count per gate): the AIC pair is
+ * 2 writes, the whole Fender stop leg is one R1 read+write op.
+ */
+static inline int g5p_td_run(struct g5p_td *t, const struct g5p_td_ops *o,
+			     enum g5p_td_mode mode,
+			     const struct g5p_td_pre *pre)
+{
+	if (cmpxchg(&t->running, 0, 1))
+		return -EBUSY;
+	WRITE_ONCE(t->quiet, 1);
+	if (t->state == 2) {
+		/* Answered from the cache (after FINAL only; CAPTURE re-runs, gpu-
+		 * recovery99 0004): no phase runs, nothing is accessed.
+		 */
+		u32 saved_flags = t->flags;
+
+		t->t0_ns = o->now_ns(o->ctx) - (u64)t->us_total * 1000;
+		t->flags |= G5P_TDF_REENTRY;
+		t->phase = G5P_TDP_DONE;
+		g5p_td_receipt(t, o, t->rc, t->flags, t->steps);
+		t->flags = saved_flags;
+		WRITE_ONCE(t->running, 0);
+		return t->rc;
+	}
+	t->mode = mode;
+	t->phase = G5P_TDP_FREEZE;
+	t->t0_ns = o->now_ns(o->ctx);
+	t->seq = 0;
+	t->nrcpt = 0;
+	t->flags = mode == G5P_TD_CAPTURE ? G5P_TDF_CAPTURE_ONLY : 0;
+	t->steps = 0;
+	t->violations = 0;
+	t->abandoned = 0;
+	t->drained = 0;
+	t->pending_mask = 0;
+	t->pending_initial = 0;
+	t->ev_consumed = 0;
+	t->ev_left = 0;
+	t->ev_initial = 0;
+	t->irq_before = 0;
+	t->irq_after = 0;
+	t->skip = G5P_TDS_NONE;
+	t->verdict = G5P_TDV_NONE;
+	memset(t->cnt, 0, sizeof(t->cnt));
+	/* a CAPTURE may now run many times: nothing of the previous look may leak into this one */
+	memset(t->ring_cons, 0, sizeof(t->ring_cons));
+	memset(t->ring_prod, 0, sizeof(t->ring_prod));
+	if (READ_ONCE(t->terminal))
+		t->flags |= G5P_TDF_TERMINAL;
+	if (!pre->released)
+		t->flags |= G5P_TDF_UNRELEASED;
+
+	if (mode == G5P_TD_FINAL) {
+		if (!g5p_td_gate(t, G5P_TDD_RAM, G5P_TDA_W))
+			o->freeze(o->ctx);
+		g5p_td_receipt(t, o, 0, pre->released, pre->policy_host_owned);
+	}
+	t->phase = G5P_TDP_ACCOUNT;
+	if (g5p_td_account(t, o))
+		t->flags |= G5P_TDF_OVERRUN;
+	g5p_td_note_late(t, o);
+	if (mode == G5P_TD_CAPTURE)
+		g5p_td_snap(t, o, pre);
+
+	if (mode == G5P_TD_FINAL &&
+	    !(t->flags & (G5P_TDF_NOT_BOOTED | G5P_TDF_UNRELEASED |
+			  G5P_TDF_PROTOCOL | G5P_TDF_OVERRUN))) {
+		t->phase = G5P_TDP_DRAIN;
+		g5p_td_drain(t, o);
+		g5p_td_note_late(t, o);
+		g5p_td_receipt(t, o,
+			       (t->flags & G5P_TDF_ABANDON) ? -ETIMEDOUT : 0,
+			       t->drained, t->abandoned);
+
+		t->phase = G5P_TDP_EVENTS;
+		g5p_td_events(t, o);
+		g5p_td_receipt(t, o,
+			       (t->flags & G5P_TDF_EV_UNQUIET) ? -ETIMEDOUT : 0,
+			       t->ev_consumed, t->ev_left);
+	}
+	if (mode == G5P_TD_FINAL) {
+		/* The IRQ is masked even after an overrun: ack + mask is the safe exit. */
+		t->phase = G5P_TDP_IRQ;
+		if (!(t->flags & G5P_TDF_NOT_BOOTED))
+			g5p_td_irq(t, o);
+		g5p_td_receipt(t, o,
+			       (t->flags & G5P_TDF_IRQ_UNSETTLED) ? -ETIMEDOUT :
+								    0,
+			       t->irq_before, t->irq_after);
+
+		t->phase = G5P_TDP_DETACH;
+		if (!g5p_td_gate(t, G5P_TDD_RAM, G5P_TDA_W))
+			o->detach(o->ctx);
+		g5p_td_receipt(t, o, 0, 0, 0);
+
+		t->phase = G5P_TDP_RESET;
+		g5p_td_reset(t, o, pre);
+	}
+	g5p_td_note_late(t, o);
+	t->phase = G5P_TDP_DONE;
+	g5p_td_decide(t, pre);
+	switch (t->verdict) {
+	case G5P_TDV_DIRTY:
+		t->rc = -EIO;
+		break;
+	case G5P_TDV_RAM_ONLY:
+		t->rc = -EAGAIN;
+		break;
+	default:
+		t->rc = 0;
+	}
+	t->us_total = g5p_td_us_since(t, o);
+	g5p_td_receipt(t, o, t->rc, (u32)t->skip, t->abandoned);
+	t->state = mode == G5P_TD_FINAL ? 2 : 1;
+	WRITE_ONCE(t->running, 0);
+	return t->rc;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/teardown.inc b/drivers/gpu/apple-g5p/teardown.inc
new file mode 100644
index 000000000..e3875bc59
--- /dev/null
+++ b/drivers/gpu/apple-g5p/teardown.inc
@@ -0,0 +1,694 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Kernel glue for the GPU teardown state machine (teardown.h).
+ * Design, evidence and device plan: docs/gpu/experiments/gpu-warm-kexec-hang-proof.md
+ *
+ * Included from core.inc after lifecycle.inc, so it may use g5p_dc_root_word(),
+ * g5p_fender_write()/poll() and g5p_r73b_disarm(). No state is added to struct
+ * g5p_boot or struct g5p_diag: one GPU, one file-static teardown instance.
+ *
+ * Compiled with W=1 against a9/tri96 (patches/gpu-recovery/README.md); NOT run on hardware.
+ *
+ * gpu-recovery108 (0006): every run goes through the retire layer (retire108.h):
+ * admission close, RAM-only epoch class and a TR108 receipt before the ladder, the
+ * named post-ladder slots, and the retired latch after a FINAL.  The TD98 lines are
+ * unchanged.  docs/gpu/experiments/recovery108-driver.md.
+ */
+#include <linux/limits.h>
+#include <linux/notifier.h>
+#include <linux/reboot.h>
+#include "teardown.h"
+#include "retire108.h"
+#include "render-user-bind.h"
+#include "render-user-quiesce.h"
+
+/* 0 off (default; the notifier and .shutdown do nothing), 1 observe-only receipts
+ * (CAPTURE: RAM reads, no change), 2 full ladder (FINAL).
+ */
+
+/* gpu-recovery108 G6 slot: one R1 read of isStableOff after a verified Fender stop leg. */
+
+/* Defined in render-r96.inc (same translation unit, included later by render-fixed.inc). */
+
+static struct g5p_td g5p_td_state;
+static struct g5p_diag *g5p_td_dev;
+static void (*g5p_td_detach_cb)(void *cookie);
+static void *g5p_td_detach_cookie;
+
+/* gpu-recovery108: the retire layer around the ladder (retire108.h), one GPU, file static. */
+static struct g5p_r8 g5p_r8_state = { .admit_us = G5P_R8_ADMIT_US };
+static void (*g5p_r8_epoch_cb)(void *cookie, struct g5p_r8_in *in);
+static void *g5p_r8_epoch_cookie;
+
+/* The DRM frontend reports its share of the epoch inputs (claim, holders, queued jobs), RAM only. */
+static void __maybe_unused g5p_r8_register_epoch(void (*cb)(void *,
+							    struct g5p_r8_in *),
+						 void *cookie)
+{
+	g5p_r8_epoch_cookie = cookie;
+	smp_store_release(&g5p_r8_epoch_cb, cb);
+}
+
+/* Job admission: a submitter enters before its first look at driver state and
+ * leaves on every return; false once a FINAL teardown closed admission.
+ */
+static bool __maybe_unused g5p_r8_enter(void)
+{
+	return g5p_r8_admit_enter(&g5p_r8_state.admit);
+}
+
+static void __maybe_unused g5p_r8_exit(void)
+{
+	g5p_r8_admit_exit(&g5p_r8_state.admit);
+}
+
+/* The post-retire register predicate for the R1 helpers outside the ladder. */
+static bool __maybe_unused g5p_r8_r1_allowed(void)
+{
+	return g5p_r8_mmio_ok(&g5p_r8_state, G5P_TDD_R1);
+}
+
+static bool __maybe_unused g5p_r8_is_retired(void)
+{
+	return g5p_r8_retired(&g5p_r8_state);
+}
+
+/* The DRM frontend registers the callback that fails its queued/in-flight job
+ * fences (exactly once each, -ENODEV) without touching hardware.
+ */
+static void __maybe_unused g5p_td_register_detach(void (*cb)(void *),
+						  void *cookie)
+{
+	g5p_td_detach_cookie = cookie;
+	smp_store_release(&g5p_td_detach_cb, cb);
+}
+
+static u64 g5p_td_op_now(void *ctx)
+{
+	return ktime_get_mono_fast_ns();
+}
+
+static void g5p_td_op_relax(void *ctx, u32 us)
+{
+	usleep_range(us, us + us / 4 + 1);
+}
+
+static void g5p_td_op_freeze(void *ctx)
+{
+	struct g5p_diag *g = ctx;
+	struct g5p_boot *b = g->boot;
+
+	if (!b)
+		return;
+	/* The IRQ-side plateau banks (g5p_r80_irq_bank/g5p_r85_irq_bank) read R0 until this
+	 * latch is set; arm it before anything else (RAM only, no-op without an r96 config).
+	 */
+	/* Same freeze as g5p_boot_park(): nothing may publish after this. */
+	if (b->r73b)
+		g5p_r73b_disarm(b->r73b);
+	WRITE_ONCE(b->stopped, true);
+	WRITE_ONCE(b->alive, false);
+}
+
+static int g5p_td_op_ring_read(void *ctx, u32 idx, u32 *cons, u32 *prod)
+{
+	static const u32 slots[G5P_TD_NRING] = { 0x60, 0x64, 0x68, 0x6c, 0x70 };
+	struct g5p_boot *b = ((struct g5p_diag *)ctx)->boot;
+	u32 *ctl;
+
+	if (!b || !READ_ONCE(b->maps_ready))
+		return -ENODEV;
+	ctl = (u32 *)g5p_boot_shared(b, slots[idx]);
+	*cons = READ_ONCE(ctl[0]);
+	*prod = READ_ONCE(ctl[4]);
+	dma_rmb();
+	return 0;
+}
+
+/* RAM only. Consumes ALIVE (0) and stamp (1) entries; the first other type is
+ * left in place for the host, as g5p_boot_drain() does.
+ */
+static int g5p_td_op_event_pass(void *ctx, u32 max, u32 *consumed, u32 *left,
+				bool *fault)
+{
+	struct g5p_boot *b = ((struct g5p_diag *)ctx)->boot;
+	u32 *control = (u32 *)g5p_boot_shared(b, 0x70);
+	u32 consumer, producer, n = 0;
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&b->event_lock, flags);
+	consumer = READ_ONCE(control[0]);
+	producer = READ_ONCE(control[4]);
+	if (consumer > 255 || producer > 255) {
+		ret = -EPROTO;
+		goto out;
+	}
+	dma_rmb();
+	while (n < max && consumer != producer) {
+		u32 off = b->layout.offset[0x74] + consumer * 44;
+
+		if (g5p_le32(b->shared[off / G5P_GPU_PAGE].cpu +
+			     off % G5P_GPU_PAGE) > 1) {
+			*fault = true;
+			break;
+		}
+		consumer = (consumer + 1) & 255;
+		mb();
+		WRITE_ONCE(control[0], consumer);
+		n++;
+	}
+	producer = READ_ONCE(control[4]);
+	*left = producer > 255 ? 255 : (producer - consumer) & 255;
+out:
+	*consumed = n;
+	spin_unlock_irqrestore(&b->event_lock, flags);
+	return ret;
+}
+
+/* The render path latches terminal states through g5p_td_note_terminal(); until
+ * prod98 wires that call this reports "not seen" and the race is only visible as
+ * ring state.
+ */
+static bool g5p_td_op_terminal_seen(void *ctx)
+{
+	return READ_ONCE(g5p_td_state.terminal) != 0;
+}
+
+static void g5p_td_op_detach(void *ctx)
+{
+	void (*cb)(void *) = smp_load_acquire(&g5p_td_detach_cb);
+
+	if (cb)
+		cb(g5p_td_detach_cookie);
+}
+
+static void g5p_td_op_aic_ack(void *ctx)
+{
+	struct g5p_boot *b = ((struct g5p_diag *)ctx)->boot;
+
+	/* The same software-source ACK the IRQ-cap path uses. */
+	if (b && b->irq_ready && b->swirq)
+		writel(0x4000, b->swirq + 0x94);
+}
+
+static void g5p_td_op_irq_mask(void *ctx)
+{
+	struct g5p_boot *b = ((struct g5p_diag *)ctx)->boot;
+
+	/* Line masked at the interrupt controller; the handler stays registered for
+	 * a late entry, which still ACKs. Same call as the IRQ-cap path.
+	 */
+	if (b && b->irq_ready && b->irq > 0)
+		disable_irq_nosync(b->irq);
+}
+
+static u32 g5p_td_op_irq_total(void *ctx)
+{
+	struct g5p_boot *b = ((struct g5p_diag *)ctx)->boot;
+
+	return b ? (u32)atomic_read(&b->irqs) : 0;
+}
+
+static int g5p_td_op_fender_stop(void *ctx)
+{
+	struct g5p_diag *g = ctx;
+	const struct g5p_fender_io io = {
+		.ctx = g,
+		.write = g5p_fender_write,
+		.poll = g5p_fender_poll,
+	};
+
+	/* Apple stopFirmwareForPowerDown 6c9fa10; no retry, no PMGR off. */
+	return g5p_fender_idle(&io);
+}
+
+static int g5p_td_op_pmgr(void *ctx, u32 *target, u32 *actual)
+{
+	struct g5p_diag *g = ctx;
+	u32 raw;
+	int ret;
+
+	if (!g->pmgr)
+		return -ENODEV;
+	ret = regmap_read(g->pmgr, 0x80340, &raw);
+	if (!ret) {
+		*target = raw & 0xf;
+		*actual = (raw >> 4) & 0xf;
+	}
+	return ret;
+}
+
+/* dev_emerg so the receipt reaches netconsole at any console loglevel. */
+static void g5p_td_op_emit(void *ctx, const char *line)
+{
+	dev_emerg(((struct g5p_diag *)ctx)->dev, "%s\n", line);
+}
+
+static void g5p_td_pre_fill(struct g5p_diag *g, struct g5p_td_pre *p,
+			    bool locked)
+{
+	struct g5p_boot *b = READ_ONCE(g->boot);
+
+	memset(p, 0, sizeof(*p));
+	p->lock_held = locked;
+	p->powered = READ_ONCE(g->powered);
+	p->fender_ready = READ_ONCE(g->fender_ready);
+	if (!b)
+		return;
+	p->booted = READ_ONCE(b->maps_ready);
+	p->released = READ_ONCE(b->released);
+	p->already_parked = READ_ONCE(b->parked);
+	p->stopped_unparked = READ_ONCE(b->stopped) && !READ_ONCE(b->parked);
+	p->power_abort = b->r73b && READ_ONCE(b->r73b->early_power_abort);
+	/* RAM-only read of the host-written init word (same as g5p_dc_snapshot()). */
+	p->policy_host_owned =
+		p->booted &&
+		!g5p_dc_root_word(b, b->layout.offset[0x4d] + 0x6c8);
+}
+
+/* gpu-recovery108: the ladder as the retire layer's td_run op.  The TD98 begin line
+ * and the ladder's own lines are exactly the recovery98/99 ones.
+ */
+struct g5p_r8_ctx {
+	struct g5p_diag *g;
+	const struct g5p_td_ops *ops;
+	struct g5p_td_pre *pre;
+	const char *why;
+	bool locked;
+};
+
+static int g5p_r8_op_td_run(void *ctx, enum g5p_td_mode mode)
+{
+	struct g5p_r8_ctx *c = ctx;
+
+	dev_emerg(c->g->dev,
+		  "TD98 begin why=%s mode=%s teardown=%u locked=%u\n", c->why,
+		  g5p_td_mode_name[mode], (0), c->locked);
+	return g5p_td_run(&g5p_td_state, c->ops, mode, c->pre);
+}
+
+static u32 g5p_r8_op_td_flags(void *ctx)
+{
+	return g5p_td_state.flags;
+}
+
+static enum g5p_td_verdict g5p_r8_op_td_verdict(void *ctx)
+{
+	return g5p_td_state.verdict;
+}
+
+static u64 g5p_r8_op_now(void *ctx)
+{
+	return ktime_get_mono_fast_ns();
+}
+
+static void g5p_r8_op_relax(void *ctx, u32 us)
+{
+	usleep_range(us, us + us / 4 + 1);
+}
+
+/* G6: R1+0x0 bit 30 after a verified stop leg (the slot runs only then, before RETIRE). */
+static int g5p_r8_op_stable_off(void *ctx, u32 *value)
+{
+	struct g5p_r8_ctx *c = ctx;
+
+	*value = readl(c->g->window[1]) >> 30;
+	return 0;
+}
+
+static void g5p_r8_op_emit(void *ctx, const char *line)
+{
+	dev_emerg(((struct g5p_r8_ctx *)ctx)->g->dev, "%s\n", line);
+}
+
+static void g5p_r8_in_fill(struct g5p_diag *g, struct g5p_r8_in *in,
+			   bool locked, enum g5p_td_mode mode)
+{
+	void (*cb)(void *, struct g5p_r8_in *) =
+		smp_load_acquire(&g5p_r8_epoch_cb);
+	struct g5p_boot *b = READ_ONCE(g->boot);
+
+	memset(in, 0, sizeof(*in));
+	in->terminal = READ_ONCE(g5p_td_state.terminal);
+	/* FINAL without the lock: a worker (or a sysfs writer) holds it, maybe inside a wait. */
+	in->worker_busy = mode == G5P_TD_FINAL && !locked;
+	if (b) {
+		in->booted = READ_ONCE(b->maps_ready);
+		in->released = READ_ONCE(b->released);
+		in->alive = READ_ONCE(b->alive);
+		in->failed = READ_ONCE(b->failed);
+		in->fault_event = READ_ONCE(b->event_failed);
+		in->parked = READ_ONCE(b->parked);
+		in->stopped_unparked = READ_ONCE(b->stopped) &&
+				       !READ_ONCE(b->parked);
+		in->power_abort = b->r73b &&
+				  READ_ONCE(b->r73b->early_power_abort);
+	}
+	if (cb)
+		cb(g5p_r8_epoch_cookie, in);
+}
+
+static int g5p_td_execute(struct g5p_diag *g, enum g5p_td_mode mode,
+			  const char *why)
+{
+	const struct g5p_td_ops ops = {
+		.ctx = g,
+		.now_ns = g5p_td_op_now,
+		.relax_us = g5p_td_op_relax,
+		.freeze = g5p_td_op_freeze,
+		.ring_read = g5p_td_op_ring_read,
+		.event_pass = g5p_td_op_event_pass,
+		.terminal_seen = g5p_td_op_terminal_seen,
+		.detach = g5p_td_op_detach,
+		.aic_ack = g5p_td_op_aic_ack,
+		.irq_mask = g5p_td_op_irq_mask,
+		.irq_total = g5p_td_op_irq_total,
+		.fender_stop = g5p_td_op_fender_stop,
+		.pmgr_actual = g5p_td_op_pmgr,
+		.emit = g5p_td_op_emit,
+	};
+	struct g5p_td_pre pre;
+	struct g5p_r8_in in;
+	struct g5p_r8_ctx c = { .g = g, .ops = &ops, .pre = &pre, .why = why };
+	/* fw-sleep (G2) and pmgr-gate (G1) have no mechanism: their ops stay NULL. */
+	const struct g5p_r8_ops r8ops = {
+		.ctx = &c,
+		.now_ns = g5p_r8_op_now,
+		.relax_us = g5p_r8_op_relax,
+		.td_run = g5p_r8_op_td_run,
+		.td_flags = g5p_r8_op_td_flags,
+		.td_verdict = g5p_r8_op_td_verdict,
+		.slot = { [G5P_R8S_STABLE_OFF] = g5p_r8_op_stable_off },
+		.emit = g5p_r8_op_emit,
+	};
+	bool locked = false;
+	int ret;
+
+	/* Never queue behind a worker or sysfs writer that may be inside MMIO. CAPTURE
+	 * reads RAM only and needs no lock.
+	 */
+	if (mode == G5P_TD_FINAL)
+		locked = mutex_trylock(&g->lock);
+	c.locked = locked;
+	g5p_td_pre_fill(g, &pre, locked);
+	g5p_r8_in_fill(g, &in, locked, mode);
+	g5p_r8_state.slot_on[G5P_R8S_STABLE_OFF] = (0);
+	ret = g5p_r8_run(&g5p_r8_state, &r8ops, mode, &in, why);
+	if (g5p_td_state.flags & G5P_TDF_RT1_OK && g->boot)
+		WRITE_ONCE(g->boot->parked, true);
+	if (locked)
+		mutex_unlock(&g->lock);
+	return ret;
+}
+
+/* Observation only: arms the quiet predicate, changes nothing else. */
+static int __maybe_unused g5p_td_capture(struct g5p_diag *g, const char *why)
+{
+	return g5p_td_execute(g, G5P_TD_CAPTURE, why);
+}
+
+static int g5p_td_final(struct g5p_diag *g, const char *why)
+{
+	return g5p_td_execute(g, G5P_TD_FINAL, why);
+}
+
+/*
+ * The quiesce before a kexec, reboot or power-off (render-user-quiesce.h).  It runs from the
+ * reboot notifier whatever `teardown` is, once per boot; .shutdown and the `td-kexec` command
+ * reach the same run.  It leaves the GPU powered with its firmware stopped and the boot state
+ * frozen: the next kernel boots it as after any warm kexec.
+ */
+
+#define G5P_KQ_LOCK_MS 2000U
+#define G5P_KQ_ADMIT_US 20000U
+#define G5P_KQ_OFF_MS 10U
+
+/* The render frontend's share: its TYPED_V3 epoch inputs and the RAM-only unbind of slots. */
+struct g5p_kq_frontend {
+	void (*state)(void *cookie, struct g5p_ru_kq_in *in);
+	int (*detach)(void *cookie, const u32 *slots, u32 n);
+};
+
+static const struct g5p_kq_frontend *g5p_kq_fe;
+static void *g5p_kq_fe_cookie;
+static atomic_t g5p_kq_ran = ATOMIC_INIT(0);
+
+struct g5p_kq_ctx {
+	struct g5p_diag *g;
+	u32 slots[G5P_RU_USER_SLOTS];
+	u32 held;
+};
+
+static void __maybe_unused g5p_kq_register(const struct g5p_kq_frontend *fe,
+					   void *cookie)
+{
+	g5p_kq_fe_cookie = cookie;
+	smp_store_release(&g5p_kq_fe, fe);
+}
+
+static u32 g5p_kq_admit_close(void *ctx)
+{
+	struct g5p_r8_admit *a = &g5p_r8_state.admit;
+	u64 deadline = ktime_get_ns() + (u64)G5P_KQ_ADMIT_US * NSEC_PER_USEC;
+	u32 inside = g5p_r8_admit_close(a);
+
+	while (inside && ktime_get_ns() < deadline) {
+		usleep_range(G5P_R8_POLL_US, 2 * G5P_R8_POLL_US);
+		inside = g5p_r8_admit_inside(a);
+	}
+	return inside;
+}
+
+/* Never queue behind a holder that may be inside MMIO: bounded, like g5p_render_run(). */
+static bool g5p_kq_lock(void *ctx)
+{
+	struct g5p_diag *g = ((struct g5p_kq_ctx *)ctx)->g;
+	unsigned long deadline = jiffies + msecs_to_jiffies(G5P_KQ_LOCK_MS);
+
+	while (!mutex_trylock(&g->lock)) {
+		if (time_after(jiffies, deadline))
+			return false;
+		msleep(5);
+	}
+	return true;
+}
+
+static void g5p_kq_unlock(void *ctx)
+{
+	mutex_unlock(&((struct g5p_kq_ctx *)ctx)->g->lock);
+}
+
+/* RAM only: the boot state, the held user slots and the DC ring, then the frontend's inputs. */
+static void g5p_kq_inputs(void *ctx, struct g5p_ru_kq_in *in)
+{
+	struct g5p_kq_ctx *c = ctx;
+	struct g5p_diag *g = c->g;
+	struct g5p_boot *b = READ_ONCE(g->boot);
+	const struct g5p_kq_frontend *fe = smp_load_acquire(&g5p_kq_fe);
+	u32 *ctl;
+
+	if (!READ_ONCE(g->powered))
+		return; /* Already idle: no detach, MMIO or second gate cycle. */
+	in->pmgr = !!g->pmgr;
+	if (!b || !READ_ONCE(b->maps_ready) || !READ_ONCE(b->released) ||
+	    READ_ONCE(b->parked))
+		return;
+	in->booted = true;
+	in->failed = READ_ONCE(b->failed) || READ_ONCE(b->event_failed);
+	ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	dma_rmb();
+	in->cons = READ_ONCE(ctl[0]);
+	in->prod = READ_ONCE(ctl[4]);
+	in->ring_idle = in->prod <= 255 && in->cons == in->prod;
+	c->held = g5p_ru_held_slots(g5p_boot_shared(b, 0x86),
+				    g5p_boot_shared(b, 0x84), c->slots,
+				    ARRAY_SIZE(c->slots));
+	in->held = c->held;
+	if (fe) {
+		in->frontend = true;
+		fe->state(g5p_kq_fe_cookie, in);
+	}
+}
+
+static int g5p_kq_detach(void *ctx)
+{
+	struct g5p_kq_ctx *c = ctx;
+	const struct g5p_kq_frontend *fe = smp_load_acquire(&g5p_kq_fe);
+
+	return fe ? fe->detach(g5p_kq_fe_cookie, c->slots, c->held) : -ENODEV;
+}
+
+static void g5p_kq_freeze(void *ctx)
+{
+	g5p_td_op_freeze(((struct g5p_kq_ctx *)ctx)->g);
+}
+
+/* The IRQ-cap path's AIC ack and mask, then wait out a handler already running (process
+ * context; the threaded handler drains RAM and takes no lock the quiesce holds).
+ */
+static void g5p_kq_irq_off(void *ctx)
+{
+	struct g5p_diag *g = ((struct g5p_kq_ctx *)ctx)->g;
+	struct g5p_boot *b = g->boot;
+
+	g5p_td_op_aic_ack(g);
+	g5p_td_op_irq_mask(g);
+	if (b && b->irq_ready && b->irq > 0)
+		synchronize_irq(b->irq);
+}
+
+/* PMGR only: the bounded gate cycle of the r33/dirty-start path (refuses a gate that is not
+ * plainly on), which ends with the gate requested on.
+ */
+static int g5p_kq_cycle(void *ctx)
+{
+	struct g5p_diag *g = ((struct g5p_kq_ctx *)ctx)->g;
+
+	g5p_mmio_gate(g);
+	return g5p_r33_gfx_off(g->dev, g->pmgr, G5P_KQ_OFF_MS);
+}
+
+static int g5p_kq_run(struct g5p_diag *g, const char *why)
+{
+	struct g5p_ru_kq_ops o = {
+		.admit_close = g5p_kq_admit_close,
+		.lock = g5p_kq_lock,
+		.unlock = g5p_kq_unlock,
+		.inputs = g5p_kq_inputs,
+		.detach = g5p_kq_detach,
+		.freeze = g5p_kq_freeze,
+		.irq_off = g5p_kq_irq_off,
+		.cycle = g5p_kq_cycle,
+	};
+	struct g5p_ru_kq_out out;
+	struct g5p_kq_ctx *c;
+	u64 t0 = ktime_get_ns();
+
+	if (atomic_xchg(&g5p_kq_ran, 1)) {
+		dev_emerg(
+			g->dev,
+			"GPU-KQ why=%s already ran this boot; nothing done end=kq\n",
+			why);
+		return -EALREADY;
+	}
+	c = kzalloc(sizeof(*c), GFP_KERNEL);
+	if (!c) {
+		dev_emerg(g->dev, "GPU-KQ why=%s ret=%d end=kq\n", why,
+			  -ENOMEM);
+		return -ENOMEM;
+	}
+	c->g = g;
+	o.ctx = c;
+	g5p_ru_kq_run(&o, min((G5P_RU_KQ_FULL), G5P_RU_KQ_FULL), &out);
+	dev_emerg(
+		g->dev,
+		"GPU-KQ why=%s mode=%u inside=%u locked=%u booted=%u failed=%u wedged=%u "
+		"ram_only=%u exec=%u dc=%u/%u held=%u plan=%s%s skip=%#x detach=%d froze=%u "
+		"cycle=%d ms=%llu end=kq\n",
+		why, out.in.mode, out.inside, out.in.locked, out.in.booted,
+		out.in.failed, out.in.term_failed, out.in.ram_only,
+		out.in.executing, out.in.cons, out.in.prod, out.in.held,
+		out.plan & G5P_RU_KQ_DETACH ? "detach" : "-",
+		out.plan & G5P_RU_KQ_CYCLE ? "+cycle" : "", out.why,
+		out.detach_ret, out.froze, out.cycle_ret,
+		(ktime_get_ns() - t0) / NSEC_PER_MSEC);
+	kfree(c);
+	return out.detach_ret ?: out.cycle_ret;
+}
+
+/* sysfs `command`: td-capture / td-final / td-kexec. Runs before the command mutex, like
+ * r73b-export, so a wedged stage cannot block it. -EAGAIN (clean, GPU left as
+ * found) is reported as success; the verdict is in the TD98 lines.  td-kexec is the
+ * reboot quiesce run by hand (the GPU is finished for this boot afterwards).
+ */
+static int g5p_td_command(struct g5p_diag *g, const char *command)
+{
+	int ret;
+
+	if (sysfs_streq(command, "td-capture"))
+		ret = g5p_td_capture(g, "sysfs");
+	else if (sysfs_streq(command, "td-final"))
+		ret = g5p_td_final(g, "sysfs");
+	else if (sysfs_streq(command, "td-kexec"))
+		ret = g5p_kq_run(g, "sysfs");
+	else
+		return -EINVAL;
+	return ret == -EAGAIN ? 0 : ret;
+}
+
+/* Runs from kernel_restart_prepare() for reboot, halt, power-off and kexec, i.e.
+ * before device_shutdown() and its unbounded wait_for_device_probe(). Panic kexec
+ * skips both and is not covered.
+ */
+static int g5p_td_reboot_notify(struct notifier_block *nb, unsigned long action,
+				void *data)
+{
+	struct g5p_diag *g = READ_ONCE(g5p_td_dev);
+
+	if (!g)
+		return NOTIFY_DONE;
+	if (action != SYS_RESTART && action != SYS_HALT &&
+	    action != SYS_POWER_OFF)
+		return NOTIFY_DONE;
+	/* The quiesce needs a live firmware for its detach, so it runs before the ladder freezes. */
+	g5p_kq_run(g, "reboot-notifier");
+	{
+		return NOTIFY_DONE;
+	}
+}
+
+static struct notifier_block g5p_td_nb = {
+	.notifier_call = g5p_td_reboot_notify,
+	.priority = INT_MAX, /* before every other reboot notifier */
+};
+
+/* g is devm-allocated and the DRM frontend's probe error path unwinds without
+ * g5p_remove(): the notifier must not outlive g.
+ */
+static void g5p_td_devres_release(void *data)
+{
+	unregister_reboot_notifier(&g5p_td_nb);
+	WRITE_ONCE(g5p_td_dev, NULL);
+}
+
+static void g5p_td_attach(struct g5p_diag *g)
+{
+	g5p_td_init(&g5p_td_state);
+	/* A probe after a retire (not reachable on the built-in driver) never reopens admission. */
+	if (!g5p_r8_retired(&g5p_r8_state)) {
+		u32 gen = g5p_r8_state.gen;
+
+		g5p_r8_init(&g5p_r8_state);
+		g5p_r8_state.gen = gen; /* monotonic across a re-probe */
+	}
+	WRITE_ONCE(g5p_td_dev, g);
+	register_reboot_notifier(&g5p_td_nb);
+	/* On failure the action has already run: no notifier, teardown stays inert. */
+	if (devm_add_action_or_reset(g->dev, g5p_td_devres_release, g))
+		dev_warn(g->dev, "teardown not attached\n");
+}
+
+/* Returns true when the PM reference must be kept: a PMGR power-off was never
+ * validated on the outgoing side and the stop leg is not isStableOff.
+ */
+static bool g5p_td_remove(struct g5p_diag *g)
+{
+	unregister_reboot_notifier(&g5p_td_nb);
+	;
+	;
+	WRITE_ONCE(g5p_td_dev, NULL);
+	return (0) != 0;
+}
+
+/* The .shutdown platform callback: second chance after the notifier. */
+static void __maybe_unused g5p_td_shutdown(struct g5p_diag *g)
+{
+	/* A second chance after the notifier (a no-op once it ran). */
+	if (!atomic_read(&g5p_kq_ran))
+		g5p_kq_run(g, "shutdown");
+	{
+		;
+		;
+	};
+}
