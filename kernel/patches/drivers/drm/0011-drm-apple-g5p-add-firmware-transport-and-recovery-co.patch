+	/* Heartbeat116: in an R74 epoch the window detector replaces both lifetime bounds. */
+	r->hb_on = r74 != 0;
+	r->hb_seed = r74 ? (0) : 0;
+	g5p_hb_cfg_default(&r->hb_cfg);
+	atomic_set(&r->early_once, 0);
+	atomic_set(&r->early_busy, 0);
