+static int g5p_power(struct g5p_diag *g)
+{
+	int ret;
+
+	if (g->powered)
+		return 0;
+	dev_info(g->dev, "request gfx power domain\n");
+	ret = pm_runtime_resume_and_get(g->dev);
+	if (ret < 0)
+		return ret;
+	g->powered = true;
+	dev_info(g->dev, "gfx runtime PM active\n");
+	g5p_ds_hook_power(g);
+	return 0;
+}
