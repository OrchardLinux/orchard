new file mode 100644
index 000000000..184ce954b
--- /dev/null
+++ b/drivers/gpu/apple-g5p/diagnostics.inc
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Cached append-only text. Readers never take the command lock or touch MMIO.
+ * Preserve earliest records on overflow, expose dropped bytes explicitly.
+ */
+#define G5P_BLOB_SIZE SZ_4M
+#define G5P_MMU_HISTORY_SIZE SZ_32K
+
+struct g5p_diagnostics {
+	spinlock_t lock;
+	u32 used, history_used;
+	u64 dropped, history_dropped;
+	char stage[40];
+	u32 next_register;
+	bool reading;
+	char history[G5P_MMU_HISTORY_SIZE];
+	char blob[G5P_BLOB_SIZE];
+};
+
+static void g5p_diagnostics_free(void *data)
+{
+	kvfree(data);
+}
+
+static int g5p_diagnostics_init(struct g5p_diag *g)
+{
+	g->diagnostics = kvzalloc(sizeof(*g->diagnostics), GFP_KERNEL);
+	if (!g->diagnostics)
+		return -ENOMEM;
+	spin_lock_init(&g->diagnostics->lock);
+	return devm_add_action_or_reset(g->dev, g5p_diagnostics_free,
+					g->diagnostics);
+}
+
+static void g5p_diagnostic_append(struct g5p_diag *g, bool history,
+				  const char *text, size_t len)
+{
+	struct g5p_diagnostics *d = g->diagnostics;
+	unsigned long flags;
+	u32 *used = history ? &d->history_used : &d->used;
+	u64 *dropped = history ? &d->history_dropped : &d->dropped;
+	u32 capacity = history ? G5P_MMU_HISTORY_SIZE : G5P_BLOB_SIZE;
+	char *dst = history ? d->history : d->blob;
+
+	spin_lock_irqsave(&d->lock, flags);
+	/* Keep complete lines; once full, never replace earlier evidence. */
+	if (*dropped || len > capacity - *used) {
+		*dropped += len;
+	} else {
+		memcpy(dst + *used, text, len);
+		*used += len;
+	}
+	spin_unlock_irqrestore(&d->lock, flags);
+}
+
+static __printf(2, 3) void g5p_blob_printf(struct g5p_diag *g, const char *fmt,
+					   ...)
+{
+	char line[512];
+	va_list args;
+	size_t len;
+
+	va_start(args, fmt);
+	len = vscnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	g5p_diagnostic_append(g, false, line, len);
+}
+
+static void g5p_blob_hex(struct g5p_diag *g, const char *name, const u8 *data,
+			 u32 len)
+{
+	for (u32 off = 0; off < len; off += 16) {
+		char text[80];
+
+		hex_dump_to_buffer(data + off, min_t(u32, len - off, 16), 16, 4,
+				   text, sizeof(text), false);
+		g5p_blob_printf(g, "%s: %04x: %s\n", name, off, text);
+	}
+}
+
+/* R1+1000 uses synthetic address11000; other offsets denote R0. */
+static void g5p_mmu_progress(struct g5p_diag *g, const char *stage, u32 next)
+{
+	struct g5p_diagnostics *d = g->diagnostics;
+	unsigned long flags;
+
+	spin_lock_irqsave(&d->lock, flags);
+	strscpy(d->stage, stage, sizeof(d->stage));
+	d->next_register = next;
+	d->reading = true;
+	spin_unlock_irqrestore(&d->lock, flags);
+}
+
+static __printf(2, 3) void g5p_mmu_record(struct g5p_diag *g, const char *fmt,
+					  ...)
+{
+	struct g5p_diagnostics *d = g->diagnostics;
+	char line[256];
+	unsigned long flags;
+	va_list args;
+	size_t len;
+
+	va_start(args, fmt);
+	len = vscnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	g5p_diagnostic_append(g, true, line, len);
+	spin_lock_irqsave(&d->lock, flags);
+	d->reading = false;
+	spin_unlock_irqrestore(&d->lock, flags);
+	dev_info(g->dev, "%s", line);
+}
+
+/* The routine per-job and per-event lines (a job's publish, wake and success receipt, the firmware's
+ * alive and stamp events).  At desktop job rates they are hundreds of lines a second, more than netconsole
+ * can send: its queue grew to 700 MB of unreclaimable slab (release8, 55 min).  Faults, losses,
+ * recoveries, terminal latches and every failed job keep their own levels and always print.
+ *   job_log 0  dev_dbg (dynamic debug: off unless enabled in dynamic_debug/control)
+ *           1  KERN_DEBUG: in dmesg for the parsers (RENDER-USER job=, RENDER publish), below the
+ *              default console loglevel, so not on a console or netconsole
+ *           2  KERN_INFO as before (short netconsole traces only: floods at desktop job rates)
+ */
+static unsigned int job_log = 0;
+module_param(job_log, uint, 0600);
+MODULE_PARM_DESC(
+	job_log,
+	"default0 routine per-job/per-event lines are dev_dbg; 1 KERN_DEBUG (dmesg, no "
+	"console); 2 KERN_INFO as before (floods netconsole)");
+
+#define g5p_job_printk(dev, fmt, ...)                                    \
+	do {                                                             \
+		switch (READ_ONCE(job_log)) {                            \
+		case 0:                                                  \
+			dev_dbg(dev, fmt, ##__VA_ARGS__);                \
+			break;                                           \
+		case 1:                                                  \
+			dev_printk(KERN_DEBUG, dev, fmt, ##__VA_ARGS__); \
+			break;                                           \
+		default:                                                 \
+			dev_info(dev, fmt, ##__VA_ARGS__);               \
+			break;                                           \
+		}                                                        \
+	} while (0)
+
+/* g5p_mmu_record for a routine per-job line: the blob keeps it, the console sees it only at job_log 2. */
+static __printf(2, 3) __maybe_unused
+	void g5p_mmu_record_job(struct g5p_diag *g, const char *fmt, ...)
+{
+	struct g5p_diagnostics *d = g->diagnostics;
+	char line[256];
+	unsigned long flags;
+	va_list args;
+	size_t len;
+
+	va_start(args, fmt);
+	len = vscnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	g5p_diagnostic_append(g, true, line, len);
+	spin_lock_irqsave(&d->lock, flags);
+	d->reading = false;
+	spin_unlock_irqrestore(&d->lock, flags);
+	g5p_job_printk(g->dev, "%s", line);
+}
+
+/* A routine event's raw words at the job_log level. */
+static __maybe_unused void g5p_job_hex(const char *prefix, const void *buf,
+				       size_t len)
+{
+	switch (READ_ONCE(job_log)) {
+	case 0:
+		print_hex_dump_debug(prefix, DUMP_PREFIX_NONE, 16, 4, buf, len,
+				     false);
+		break;
+	case 1:
+		print_hex_dump(KERN_DEBUG, prefix, DUMP_PREFIX_NONE, 16, 4, buf,
+			       len, false);
+		break;
+	default:
+		print_hex_dump(KERN_INFO, prefix, DUMP_PREFIX_NONE, 16, 4, buf,
+			       len, false);
+		break;
+	}
+}
diff --git a/drivers/gpu/apple-g5p/dirtystart108.h b/drivers/gpu/apple-g5p/dirtystart108.h
new file mode 100644
index 000000000..fcf7432fa
--- /dev/null
+++ b/drivers/gpu/apple-g5p/dirtystart108.h
@@ -0,0 +1,454 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_DIRTYSTART108_H
+#define G5P_DIRTYSTART108_H
+
+#include "bits-compat.h"
+
+#ifndef G5P_GPC_ON
+#define G5P_GPC_ON(raw) (((raw) & 0x1f) == 1) /* core.inc overrides it */
+#endif
+
+/*
+ * G5P incoming dirty-start state machine (series gpu-recovery108, patch 0007).
+ *
+ * Design: docs/gpu/experiments/recovery108-driver.md section 4.
+ *
+ * The bootstrap is stepped by userspace (map, load, release, events,
+ * control), so this is an event-driven machine, not one run: the glue feeds
+ * one event per driver step with the step's result and RAM-only inputs, and
+ * asks the machine at two gates (before release, at the DRM claim).  It
+ * assumes nothing pristine: the origin of the power state is classified from
+ * the kexec flag, the requested incoming PMGR cycle and the PMGR word, and
+ * every step's own result is evidence.
+ *
+ *   PROBE    origin inputs: booted from kexec, kexec_gpu_cycle requested
+ *   POWER    the PMGR gfx word, read once after the PM reference (PMGR read)
+ *   RESET    the bounded incoming power cycle (g5p_r33_gfx_off(), one attempt
+ *            per boot, only in mode 3, only before the first wrapper wake)
+ *   WAKE     the Fender wake result
+ *   MAPS     fresh shared state: every ring control word in range (after the wake:
+ *            map needs the core id, read through the woken wrapper)
+ *   LOAD     the firmware image memcmp of the RAM copy (b->copied)
+ *   RELEASE  the reset-stream/release result, the R74E power result
+ *   ALIVE    the first ALIVE wait result and, when read, the first-ALIVE
+ *            GPC word (r73e); 0x10/0x11 is the C3 closed gate
+ *   CLAIM    the DRM claim asks; answers from the ALIVE proof
+ *
+ * Modes (parameter dirty_start):
+ *   0  observe: receipts only, both gates open (combined107 behaviour)
+ *   1  gate (default): fail closed on evidence the driver itself produced (a
+ *      failed or out-of-order step, a power abort, a GPC word other than
+ *      0x01 at the first ALIVE, a ring out of range); a claim needs ALIVE
+ *      proven in the current reset generation.  Equal to combined107 on every
+ *      bootstrap that succeeds.
+ *   2  strict: also refuse release and claim for an origin that is not cold
+ *      and not a witnessed cycle (warm-unproven, warm-uncycled, unknown),
+ *      unless a reset succeeded in this generation
+ *   3  strict + reset: as 2, and the glue may spend the one RESET attempt
+ *      on such an origin before the wrapper wake (destructive: PMGR write)
+ *
+ * Generations: gen starts at 1 at PROBE and steps once per RESET attempt.  A
+ * reset voids every proof of the previous generation; ALIVE proven in an
+ * earlier generation never exposes.  gen never decreases.
+ *
+ * Pure policy: no register access, no kernel API except scnprintf().  Each
+ * event emits exactly one DS108 line through the emit callback.
+ */
+
+enum g5p_ds_ev {
+	G5P_DSE_PROBE,
+	G5P_DSE_POWER,
+	G5P_DSE_RESET,
+	G5P_DSE_WAKE,
+	G5P_DSE_MAPS,
+	G5P_DSE_LOAD,
+	G5P_DSE_RELEASE,
+	G5P_DSE_ALIVE,
+	G5P_DSE_CLAIM,
+	G5P_DSE_RECOVER, /* an in-boot recovery cycled the gate after a proven epoch */
+	G5P_DSE_N,
+};
+
+static const char *const g5p_ds_ev_name[G5P_DSE_N] = {
+	"probe", "power",   "reset", "wake",  "maps",
+	"load",	 "release", "alive", "claim", "recover",
+};
+
+enum g5p_ds_origin {
+	G5P_DSO_UNKNOWN, /* not probed, or the PMGR word could not be read */
+	G5P_DSO_COLD, /* not booted from kexec */
+	G5P_DSO_WARM_CYCLED, /* kexec, incoming cycle requested and witnessed (was_pwrgated) */
+	G5P_DSO_WARM_UNPROVEN, /* kexec, cycle requested, no witness in the PMGR word */
+	G5P_DSO_WARM_UNCYCLED, /* kexec, no incoming cycle requested */
+	G5P_DSO_N,
+};
+
+static const char *const g5p_ds_origin_name[G5P_DSO_N] = {
+	"unknown", "cold", "warm-cycled", "warm-unproven", "warm-uncycled",
+};
+
+enum g5p_ds_why {
+	G5P_DSW_NONE,
+	G5P_DSW_PROTOCOL, /* a step out of order (its predecessor not ok in this gen) */
+	G5P_DSW_WAKE, /* the wrapper wake failed */
+	G5P_DSW_MAPS, /* map failed or a ring control word out of range */
+	G5P_DSW_LOAD, /* the RAM image is not the firmware (memcmp) */
+	G5P_DSW_RELEASE, /* release / reset stream failed */
+	G5P_DSW_POWER_ABORT, /* the R74E power poll or the first-ALIVE gate aborted */
+	G5P_DSW_GPC, /* first-ALIVE GPC word not 0x01 (0x10/0x11: C3) */
+	G5P_DSW_ALIVE, /* no ALIVE, or the ALIVE wait failed */
+	G5P_DSW_RESET, /* the incoming power cycle failed: power state unknown */
+	G5P_DSW_N,
+};
+
+static const char *const g5p_ds_why_name[G5P_DSW_N] = {
+	"none",	   "protocol",	  "wake", "maps",  "load",
+	"release", "power-abort", "gpc",  "alive", "reset",
+};
+
+/* Gate answers (not latched): why a gate is closed right now. */
+enum g5p_ds_gate {
+	G5P_DSG_OPEN,
+	G5P_DSG_FAILED, /* the fail-closed latch */
+	G5P_DSG_NOT_PROVEN, /* no ALIVE proof in the current generation */
+	G5P_DSG_ORIGIN, /* strict: origin neither cold nor a witnessed cycle */
+	G5P_DSG_STATE, /* the claim snapshot contradicts the proof */
+	G5P_DSG_N,
+};
+
+static const char *const g5p_ds_gate_name[G5P_DSG_N] = {
+	"open", "failed", "not-proven", "origin", "state",
+};
+
+#define G5P_DS_MODE_MAX 3
+#define G5P_DS_GPC_ON 0x01u
+#define G5P_DS_PMGR_PWRGATED \
+	BIT(8) /* sticky was_pwrgated history bit of 0x80340 */
+
+#define G5P_DSF_RINGS_BUSY \
+	BIT(0) /* a ring not empty at map (data, not a failure) */
+#define G5P_DSF_ALIVE_LATE \
+	BIT(1) /* ALIVE first seen at the claim (no ALIVE event) */
+#define G5P_DSF_RESET_RAN BIT(2) /* a RESET attempt ran this boot */
+#define G5P_DSF_RESET_OK \
+	BIT(3) /* ... and succeeded (gen of the success = gen) */
+/* a second attempt or one after the wake was refused */
+#define G5P_DSF_RESET_REFUSED BIT(4)
+#define G5P_DSF_DUP BIT(5) /* an event repeated (recorded, not a failure) */
+#define G5P_DSF_PMGR_UNREAD BIT(6) /* the PMGR word could not be read */
+
+/* One flat input record; each event reads only its own fields (RAM or step results). */
+struct g5p_ds_in {
+	bool kexec; /* PROBE: chosen linux,booted-from-kexec */
+	bool cycle_requested; /* PROBE: apple_pmgr.kexec_gpu_cycle=1 on the cmdline */
+	bool pmgr_ok; /* POWER: the PMGR read succeeded */
+	u32 pmgr_raw; /* POWER: the gfx word */
+	int ret; /* RESET/WAKE/MAPS/LOAD/RELEASE/ALIVE: the step's return */
+	u32 rings_bad; /* MAPS: control words > 255 */
+	u32 rings_busy; /* MAPS: rings not empty */
+	int power_ret; /* RELEASE: R74E power result */
+	u32 power_raw; /* RELEASE: its last R1+0x1000 sample */
+	bool power_abort; /* RELEASE/ALIVE/CLAIM: r73b early_power_abort */
+	bool gpc_valid; /* ALIVE: the r73e first-ALIVE word was read */
+	u32 gpc; /* ALIVE: that word */
+	bool alive, released, failed,
+		control_complete; /* ALIVE/CLAIM snapshot */
+};
+
+struct g5p_ds {
+	u32 gen; /* reset generation, monotonic, 0 before PROBE */
+	u32 seen, ok; /* event bitmasks, current generation */
+	u32 flags;
+	enum g5p_ds_origin origin;
+	bool kexec, cycle; /* PROBE inputs, kept for POWER */
+	u32 pmgr_raw;
+	u32 resets; /* RESET attempts this boot (at most one runs) */
+	u32 reset_ok_gen; /* gen in which a RESET succeeded, 0 never */
+	u32 alive_gen; /* gen in which ALIVE was proven, 0 never */
+	bool failed; /* fail-closed latch (absorbing) */
+	enum g5p_ds_why why;
+	u32 events, lines, claims, refused;
+	enum g5p_ds_ev last;
+	enum g5p_ds_gate last_gate;
+};
+
+static inline bool g5p_ds_ok(const struct g5p_ds *d, enum g5p_ds_ev e)
+{
+	return d->ok & (1u << e);
+}
+
+static inline void g5p_ds_fail(struct g5p_ds *d, enum g5p_ds_why why)
+{
+	if (!d->failed)
+		d->why = why;
+	d->failed = true;
+}
+
+static inline enum g5p_ds_origin g5p_ds_origin_of(bool kexec, bool cycle,
+						  bool pmgr_ok, u32 raw)
+{
+	if (!pmgr_ok)
+		return G5P_DSO_UNKNOWN;
+	if (!kexec)
+		return G5P_DSO_COLD;
+	if (!cycle)
+		return G5P_DSO_WARM_UNCYCLED;
+	return (raw & G5P_DS_PMGR_PWRGATED) ? G5P_DSO_WARM_CYCLED :
+					      G5P_DSO_WARM_UNPROVEN;
+}
+
+/* The origin is trusted (cold, witnessed cycle) or a reset succeeded in this generation. */
+static inline bool g5p_ds_origin_trusted(const struct g5p_ds *d)
+{
+	return d->origin == G5P_DSO_COLD || d->origin == G5P_DSO_WARM_CYCLED ||
+	       (d->reset_ok_gen && d->reset_ok_gen == d->gen);
+}
+
+/* Should the glue spend the one RESET attempt now (mode 3, before the wake)? */
+static inline bool g5p_ds_reset_wanted(const struct g5p_ds *d, u32 mode)
+{
+	return mode >= 3 && !d->failed && !d->resets &&
+	       !(d->seen & (1u << G5P_DSE_WAKE)) &&
+	       (d->seen & (1u << G5P_DSE_POWER)) && !g5p_ds_origin_trusted(d);
+}
+
+/* The release gate (asked by the glue right before the reset stream runs). */
+static inline enum g5p_ds_gate g5p_ds_release_gate(const struct g5p_ds *d,
+						   u32 mode)
+{
+	if (!mode)
+		return G5P_DSG_OPEN;
+	if (d->failed)
+		return G5P_DSG_FAILED;
+	if (mode >= 2 && !g5p_ds_origin_trusted(d))
+		return G5P_DSG_ORIGIN;
+	return G5P_DSG_OPEN;
+}
+
+/* The ALIVE proof the claim needs: proven in this generation, nothing failed since. */
+static inline bool g5p_ds_proven(const struct g5p_ds *d)
+{
+	return !d->failed && d->alive_gen && d->alive_gen == d->gen &&
+	       g5p_ds_ok(d, G5P_DSE_RELEASE) && g5p_ds_ok(d, G5P_DSE_LOAD);
+}
+
+static inline int g5p_ds_line(struct g5p_ds *d, char *buf, size_t n,
+			      enum g5p_ds_ev e, int ret, u32 a, u32 b)
+{
+	d->lines++;
+	return scnprintf(buf, n,
+		"DS108 gen=%u ev=%s ret=%d origin=%s failed=%u why=%s seen=%03x ok=%03x flags=%02x pmgr=%08x a=%x b=%x gate=%s",
+		d->gen, g5p_ds_ev_name[e], ret, g5p_ds_origin_name[d->origin],
+		d->failed, g5p_ds_why_name[d->why], d->seen, d->ok, d->flags,
+		d->pmgr_raw, a, b, g5p_ds_gate_name[d->last_gate]);
+}
+
+/*
+ * Feed one event.  Returns, for CLAIM, 0 (expose) or -EAGAIN/-EIO (refuse);
+ * for every other event 0.  mode is the current dirty_start parameter; at mode 0
+ * the claim answers 0 whatever the state (the legacy driver decides alone).
+ * line/n receive the event's receipt (always written).
+ */
+static inline int g5p_ds_event(struct g5p_ds *d, enum g5p_ds_ev e,
+			       const struct g5p_ds_in *in, u32 mode, char *line,
+			       size_t n)
+{
+	u32 bit = 1u << e, a = 0, b = 0;
+	int ret = 0;
+
+	if (mode > G5P_DS_MODE_MAX)
+		mode = G5P_DS_MODE_MAX;
+	d->events++;
+	d->last = e;
+	if ((d->seen & bit) && e != G5P_DSE_CLAIM)
+		d->flags |= G5P_DSF_DUP;
+	switch (e) {
+	case G5P_DSE_PROBE:
+		/* The only event that may start a generation: probe runs once per boot. */
+		if (!d->gen)
+			d->gen = 1;
+		d->origin = G5P_DSO_UNKNOWN;
+		a = in->kexec;
+		b = in->cycle_requested;
+		d->kexec = in->kexec;
+		d->cycle = in->cycle_requested;
+		d->seen |= bit;
+		d->ok |= bit;
+		break;
+	case G5P_DSE_POWER:
+		if (!(d->seen & (1u << G5P_DSE_PROBE))) {
+			g5p_ds_fail(d, G5P_DSW_PROTOCOL);
+			break;
+		}
+		d->origin = g5p_ds_origin_of(d->kexec, d->cycle, in->pmgr_ok,
+					     in->pmgr_raw);
+		if (!in->pmgr_ok)
+			d->flags |= G5P_DSF_PMGR_UNREAD;
+		d->pmgr_raw = in->pmgr_ok ? in->pmgr_raw : 0;
+		a = in->pmgr_ok;
+		d->seen |= bit;
+		d->ok |= bit;
+		break;
+	case G5P_DSE_RESET:
+		a = in->ret;
+		if (d->resets || (d->seen & (1u << G5P_DSE_WAKE))) {
+			/* The glue must not have run it; record a refused attempt and fail
+			 * closed.
+			 */
+			d->flags |= G5P_DSF_RESET_REFUSED;
+			g5p_ds_fail(d, G5P_DSW_PROTOCOL);
+			break;
+		}
+		d->resets++;
+		d->flags |= G5P_DSF_RESET_RAN;
+		/* A reset voids the previous generation's proofs (power epoch boundary). */
+		d->gen++;
+		/* Unreachable today (a reset runs before the wake, so before every later
+		 * step); kept so that a reordered glue cannot carry a proof across it.
+		 */
+		d->seen &= (1u << G5P_DSE_PROBE) | (1u << G5P_DSE_POWER);
+		d->ok &= (1u << G5P_DSE_PROBE) | (1u << G5P_DSE_POWER);
+		d->seen |= bit;
+		if (in->ret) {
+			g5p_ds_fail(d, G5P_DSW_RESET);
+			break;
+		}
+		d->ok |= bit;
+		d->flags |= G5P_DSF_RESET_OK;
+		d->reset_ok_gen = d->gen;
+		break;
+	case G5P_DSE_WAKE:
+		d->seen |= bit;
+		if (in->ret)
+			g5p_ds_fail(d, G5P_DSW_WAKE);
+		else
+			d->ok |= bit;
+		break;
+	case G5P_DSE_MAPS:
+		d->seen |= bit;
+		a = in->rings_bad;
+		b = in->rings_busy;
+		if (in->rings_busy)
+			d->flags |= G5P_DSF_RINGS_BUSY;
+		/* map needs the core id, read through the woken wrapper */
+		if (!g5p_ds_ok(d, G5P_DSE_WAKE))
+			g5p_ds_fail(d, G5P_DSW_PROTOCOL);
+		else if (in->ret || in->rings_bad)
+			g5p_ds_fail(d, G5P_DSW_MAPS);
+		else
+			d->ok |= bit;
+		break;
+	case G5P_DSE_LOAD:
+		d->seen |= bit;
+		if (!g5p_ds_ok(d, G5P_DSE_MAPS))
+			g5p_ds_fail(d, G5P_DSW_PROTOCOL);
+		else if (in->ret)
+			g5p_ds_fail(d, G5P_DSW_LOAD);
+		else
+			d->ok |= bit;
+		break;
+	case G5P_DSE_RELEASE:
+		d->seen |= bit;
+		a = (u32)in->power_ret;
+		b = in->power_raw;
+		if (!g5p_ds_ok(d, G5P_DSE_LOAD))
+			g5p_ds_fail(d, G5P_DSW_PROTOCOL);
+		else if (in->power_abort || in->power_ret)
+			g5p_ds_fail(d, G5P_DSW_POWER_ABORT);
+		else if (in->ret)
+			g5p_ds_fail(d, G5P_DSW_RELEASE);
+		else
+			d->ok |= bit;
+		break;
+	case G5P_DSE_ALIVE:
+		d->seen |= bit;
+		a = in->gpc_valid;
+		b = in->gpc;
+		if (!g5p_ds_ok(d, G5P_DSE_RELEASE)) {
+			g5p_ds_fail(d, G5P_DSW_PROTOCOL);
+		} else if (in->power_abort) {
+			g5p_ds_fail(d, G5P_DSW_POWER_ABORT);
+		} else if (in->gpc_valid && !G5P_GPC_ON(in->gpc)) {
+			g5p_ds_fail(d, G5P_DSW_GPC);
+		} else if (in->ret || !in->alive || in->failed) {
+			g5p_ds_fail(d, G5P_DSW_ALIVE);
+		} else {
+			d->ok |= bit;
+			d->alive_gen = d->gen;
+		}
+		break;
+	case G5P_DSE_RECOVER:
+		/* The render frontend's in-boot recovery (recover.inc): the gate was cycled
+		 * after this generation's release, with the firmware frozen.  Like a RESET it
+		 * starts a generation that voids every proof of the last one, and it is a
+		 * witnessed cycle for the origin gate; the bootstrap's steps then run again
+		 * and must each succeed in the new generation.  Not after a failure, and not
+		 * before a release: there is no epoch to recover then.
+		 */
+		a = in->ret;
+		if (d->failed || !g5p_ds_ok(d, G5P_DSE_RELEASE)) {
+			g5p_ds_fail(d, G5P_DSW_PROTOCOL);
+			break;
+		}
+		d->gen++;
+		d->seen &= (1u << G5P_DSE_PROBE) | (1u << G5P_DSE_POWER);
+		d->ok &= (1u << G5P_DSE_PROBE) | (1u << G5P_DSE_POWER);
+		d->seen |= bit;
+		/* The old ALIVE proof is void; the claim's late path may prove the new one. */
+		d->alive_gen = 0;
+		if (in->ret) {
+			g5p_ds_fail(d, G5P_DSW_RESET);
+			break;
+		}
+		d->ok |= bit;
+		d->reset_ok_gen = d->gen;
+		break;
+	case G5P_DSE_CLAIM:
+		d->claims++;
+		d->seen |= bit;
+		a = in->alive | in->released << 1 | in->failed << 2 |
+		    in->control_complete << 3 | in->power_abort << 4;
+		/* ALIVE reached through a path without the ALIVE event: accept the RAM
+		 * latch as the proof only after a successful release of this generation.
+		 */
+		if (!d->failed && !d->alive_gen && in->alive && !in->failed &&
+		    !in->power_abort && g5p_ds_ok(d, G5P_DSE_RELEASE)) {
+			d->alive_gen = d->gen;
+			d->ok |= 1u << G5P_DSE_ALIVE;
+			d->flags |= G5P_DSF_ALIVE_LATE;
+		}
+		if (!mode)
+			d->last_gate = G5P_DSG_OPEN;
+		else if (d->failed)
+			d->last_gate = G5P_DSG_FAILED;
+		else if (!g5p_ds_proven(d))
+			d->last_gate = G5P_DSG_NOT_PROVEN;
+		else if (!in->alive || !in->released || in->failed ||
+			 in->power_abort || !in->control_complete)
+			d->last_gate = G5P_DSG_STATE;
+		else if (mode >= 2 && !g5p_ds_origin_trusted(d))
+			d->last_gate = G5P_DSG_ORIGIN;
+		else
+			d->last_gate = G5P_DSG_OPEN;
+		if (d->last_gate == G5P_DSG_OPEN) {
+			d->ok |= bit;
+		} else {
+			d->refused++;
+			ret = d->last_gate == G5P_DSG_FAILED ? -EIO : -EAGAIN;
+		}
+		break;
+	default:
+		break;
+	}
+	g5p_ds_line(d, line, n, e, e == G5P_DSE_CLAIM ? ret : in->ret, a, b);
+	return ret;
+}
+
+
+
+static inline void g5p_ds_init(struct g5p_ds *d)
+{
+	*d = (struct g5p_ds){ .last = G5P_DSE_N };
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/dirtystart108.inc b/drivers/gpu/apple-g5p/dirtystart108.inc
new file mode 100644
index 000000000..be023e7e7
--- /dev/null
+++ b/drivers/gpu/apple-g5p/dirtystart108.inc
@@ -0,0 +1,280 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Kernel glue for the incoming dirty-start machine (dirtystart108.h), series
+ * gpu-recovery108 (0007).  Design: docs/gpu/experiments/recovery108-driver.md.
+ *
+ * Included from core.inc after teardown.inc, so it may use the teardown ring
+ * read (RAM), g5p_r33_gfx_off() and the retire layer's state.  Patch 0008 calls
+ * the hooks from the driver steps; until then nothing here runs.
+ *
+ * Register access added by this file: one PMGR read of the gfx word after the
+ * PM reference (POWER, the same read g5p_power_snapshot() makes), and in mode 3
+ * only one bounded PMGR cycle through g5p_r33_gfx_off() before the first
+ * wrapper wake.  Every other input is RAM or a step's own return value.
+ */
+#include <linux/of.h>
+#include "dirtystart108.h"
+
+static struct g5p_ds g5p_ds_state = { .last = G5P_DSE_N };
+static DEFINE_SPINLOCK(g5p_ds_lock);
+
+/* Latched from /chosen at probe, before POWER or the first wrapper wake. */
+static u32 g5p_ds_boot_mode = 1;
+
+static u32 g5p_ds_mode(void)
+{
+	return READ_ONCE(g5p_ds_boot_mode);
+}
+
+/* One event, one DS108 line (dev_emerg: netconsole at any loglevel). */
+static int g5p_ds_feed(struct g5p_diag *g, enum g5p_ds_ev e,
+		       const struct g5p_ds_in *in)
+{
+	unsigned long flags;
+	char line[224];
+	int ret;
+
+	spin_lock_irqsave(&g5p_ds_lock, flags);
+	ret = g5p_ds_event(&g5p_ds_state, e, in, g5p_ds_mode(), line,
+			   sizeof(line));
+	spin_unlock_irqrestore(&g5p_ds_lock, flags);
+	dev_emerg(g->dev, "%s\n", line);
+	return ret;
+}
+
+/* wake112: the current reset generation, recorded with a deferred R74E proof (RAM, leaf lock). */
+static u32 g5p_ds_gen(void)
+{
+	unsigned long flags;
+	u32 gen;
+
+	spin_lock_irqsave(&g5p_ds_lock, flags);
+	gen = g5p_ds_state.gen;
+	spin_unlock_irqrestore(&g5p_ds_lock, flags);
+	return gen;
+}
+
+/* The last apple_pmgr.kexec_gpu_cycle= token of the chosen bootargs (the one the kernel obeys). */
+static bool g5p_ds_cycle_requested(struct device_node *chosen)
+{
+	static const char key[] = "apple_pmgr.kexec_gpu_cycle=";
+	const char *args, *p, *last = NULL;
+	char tok[8];
+	bool v = false;
+	size_t n;
+
+	if (!chosen || of_property_read_string(chosen, "bootargs", &args))
+		return false;
+	for (p = strstr(args, key); p; p = strstr(p + 1, key))
+		if (p == args || p[-1] == ' ')
+			last = p;
+	if (!last)
+		return false;
+	last += sizeof(key) - 1;
+	n = strcspn(last, " ");
+	if (!n || n >= sizeof(tok))
+		return false;
+	memcpy(tok, last, n);
+	tok[n] = 0;
+	return !kstrtobool(tok, &v) && v;
+}
+
+static void g5p_ds_hook_probe(struct g5p_diag *g)
+{
+	struct device_node *chosen = of_find_node_by_path("/chosen");
+	struct g5p_ds_in in = {};
+
+	in.kexec = chosen &&
+		   of_property_read_bool(chosen, "linux,booted-from-kexec");
+	in.cycle_requested = g5p_ds_cycle_requested(chosen);
+	of_node_put(chosen);
+	/* Retained warm state needs strict origin checks and the bounded reset. */
+	WRITE_ONCE(g5p_ds_boot_mode, in.kexec ? 3 : 1);
+	dev_info(g->dev, "DS108 boot mode=%u kexec=%u\n",
+		 g5p_ds_mode(), in.kexec);
+	g5p_ds_feed(g, G5P_DSE_PROBE, &in);
+}
+
+/* After the PM reference is taken: one PMGR read (the gfx word), no write. */
+static void g5p_ds_hook_power(struct g5p_diag *g)
+{
+	struct g5p_ds_in in = {};
+	u32 raw = 0;
+
+	in.pmgr_ok = g->pmgr && !regmap_read(g->pmgr, 0x80340, &raw);
+	in.pmgr_raw = raw;
+	g5p_ds_feed(g, G5P_DSE_POWER, &in);
+}
+
+/* Before the first wrapper wake.  Mode 3 only, one attempt per boot, through the
+ * r33 helper (its own refusal rules: min/reset/auto or not on; every exit leaves
+ * the gate requested on).  Returns the cycle's error; the wake then fails closed.
+ */
+static int g5p_ds_hook_reset(struct g5p_diag *g)
+{
+	u32 ms = clamp_t(u32, (10), 1, G5P_R33_GFX_OFF_MAX_MS);
+	struct g5p_ds_in in = {};
+	unsigned long flags;
+	bool want;
+
+	spin_lock_irqsave(&g5p_ds_lock, flags);
+	want = g5p_ds_reset_wanted(&g5p_ds_state, g5p_ds_mode());
+	spin_unlock_irqrestore(&g5p_ds_lock, flags);
+	if (!want)
+		return 0;
+	g5p_mmio_gate(g);
+	in.ret = g5p_r33_gfx_off(g->dev, g->pmgr, ms);
+	g5p_ds_feed(g, G5P_DSE_RESET, &in);
+	boot_gfx_off_done = true; /* one PMGR cycle per boot, whoever runs it */
+	return in.ret;
+}
+
+/* The legacy boot_gfx_off_ms cycle (R33) is the same mechanism: record it as the reset. */
+
+/* An in-boot recovery's gate cycle (recover.inc): a new generation, or a failed machine. */
+static int g5p_ds_hook_recover(struct g5p_diag *g, int ret)
+{
+	struct g5p_ds_in in = { .ret = ret };
+	unsigned long flags;
+	bool failed;
+
+	g5p_ds_feed(g, G5P_DSE_RECOVER, &in);
+	spin_lock_irqsave(&g5p_ds_lock, flags);
+	failed = g5p_ds_state.failed;
+	spin_unlock_irqrestore(&g5p_ds_lock, flags);
+	return failed ? -EIO : 0;
+}
+
+static void g5p_ds_hook_wake(struct g5p_diag *g, int ret)
+{
+	struct g5p_ds_in in = { .ret = ret };
+
+	g5p_ds_feed(g, G5P_DSE_WAKE, &in);
+}
+
+/* Fresh shared state: every ring control word in range (RAM, the teardown ring read). */
+static void g5p_ds_hook_maps(struct g5p_diag *g, int ret)
+{
+	struct g5p_ds_in in = { .ret = ret };
+	u32 i, cons, prod;
+
+	for (i = 0; !ret && i < G5P_TD_NRING; i++) {
+		if (g5p_td_op_ring_read(g, i, &cons, &prod)) {
+			in.rings_bad++;
+			continue;
+		}
+		if (cons > 255 || prod > 255)
+			in.rings_bad++;
+		else if (cons != prod)
+			in.rings_busy++;
+	}
+	g5p_ds_feed(g, G5P_DSE_MAPS, &in);
+}
+
+static void g5p_ds_hook_load(struct g5p_diag *g, int ret)
+{
+	struct g5p_ds_in in = { .ret = ret };
+
+	g5p_ds_feed(g, G5P_DSE_LOAD, &in);
+}
+
+/* Asked before the release touches anything.  -EIO: the fail-closed latch; -EAGAIN: strict origin. */
+static int g5p_ds_hook_release_gate(struct g5p_diag *g)
+{
+	enum g5p_ds_gate gate;
+	unsigned long flags;
+	u32 mode = g5p_ds_mode(), gen;
+
+	spin_lock_irqsave(&g5p_ds_lock, flags);
+	gate = g5p_ds_release_gate(&g5p_ds_state, mode);
+	g5p_ds_state.last_gate = gate;
+	if (gate != G5P_DSG_OPEN)
+		g5p_ds_state.refused++;
+	gen = g5p_ds_state.gen;
+	spin_unlock_irqrestore(&g5p_ds_lock, flags);
+	dev_emerg(g->dev, "DS108 gen=%u gate=release mode=%u answer=%s\n", gen,
+		  mode, g5p_ds_gate_name[gate]);
+	if (gate == G5P_DSG_OPEN)
+		return 0;
+	return gate == G5P_DSG_FAILED ? -EIO : -EAGAIN;
+}
+
+static void g5p_ds_hook_release(struct g5p_diag *g, int ret)
+{
+	struct g5p_r73b *r = g->boot ? g->boot->r73b : NULL;
+	struct g5p_ds_in in = { .ret = ret };
+
+	if (r) {
+		in.power_ret = r->early_power_ret;
+		in.power_raw = r->early_power_raw;
+		in.power_abort = READ_ONCE(r->early_power_abort);
+	}
+	g5p_ds_feed(g, G5P_DSE_RELEASE, &in);
+}
+
+static void g5p_ds_hook_alive(struct g5p_diag *g, int ret)
+{
+	struct g5p_boot *b = g->boot;
+	struct g5p_r73b *r = b ? b->r73b : NULL;
+	struct g5p_ds_in in = { .ret = ret };
+
+	if (b) {
+		in.alive = READ_ONCE(b->alive);
+		in.released = READ_ONCE(b->released);
+		in.failed = READ_ONCE(b->failed);
+	}
+	if (r) {
+		in.power_abort = READ_ONCE(r->early_power_abort);
+		/* r73e reads R1+0x1000 at the first ALIVE; 0 means not read. */
+		in.gpc = READ_ONCE(r->early_state);
+		in.gpc_valid = 1 && in.gpc;
+	}
+	g5p_ds_feed(g, G5P_DSE_ALIVE, &in);
+}
+
+/* The DRM claim: 0 expose, -EAGAIN not proven / strict origin, -EIO the fail-closed latch. */
+static int __maybe_unused g5p_ds_hook_claim(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	struct g5p_ds_in in = {};
+
+	if (b) {
+		in.alive = READ_ONCE(b->alive);
+		in.released = READ_ONCE(b->released);
+		in.failed = READ_ONCE(b->failed) || READ_ONCE(b->event_failed);
+		in.control_complete = READ_ONCE(b->control_complete);
+		in.power_abort = b->r73b &&
+				 READ_ONCE(b->r73b->early_power_abort);
+	}
+	return g5p_ds_feed(g, G5P_DSE_CLAIM, &in);
+}
+
+/* RAM only: the retire layer and the dirty-start machine, for capture without a log. */
+static ssize_t recovery_status_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	const struct g5p_r8 *s = &g5p_r8_state;
+	unsigned long flags;
+	struct g5p_ds d;
+
+	spin_lock_irqsave(&g5p_ds_lock, flags);
+	d = g5p_ds_state;
+	spin_unlock_irqrestore(&g5p_ds_lock, flags);
+	return sysfs_emit(
+		buf,
+		"r8 gen=%u retired=%d mode=%s class=%s verdict=%s flags=%02x admit_closed=%u "
+		"inside=%u detach_queued=%u lines=%u\n"
+		"ds gen=%u mode=%u origin=%s failed=%u why=%s seen=%03x ok=%03x flags=%02x "
+		"pmgr=%08x alive_gen=%u resets=%u reset_ok_gen=%u events=%u claims=%u refused=%u "
+		"gate=%s\n",
+		READ_ONCE(s->gen), READ_ONCE(s->retired),
+		g5p_td_mode_name[s->mode], g5p_r8_class_name[s->cls],
+		g5p_td_verdict_name[s->verdict], s->flags,
+		g5p_r8_admit_closed(&s->admit), g5p_r8_admit_inside(&s->admit),
+		READ_ONCE(s->detach_queued), s->lines, d.gen, g5p_ds_mode(),
+		g5p_ds_origin_name[d.origin], d.failed, g5p_ds_why_name[d.why],
+		d.seen, d.ok, d.flags, d.pmgr_raw, d.alive_gen, d.resets,
+		d.reset_ok_gen, d.events, d.claims, d.refused,
+		g5p_ds_gate_name[d.last_gate]);
+}
+static DEVICE_ATTR_RO(recovery_status);
diff --git a/drivers/gpu/apple-g5p/drm-validate.h b/drivers/gpu/apple-g5p/drm-validate.h
new file mode 100644
index 000000000..671e13ab8
--- /dev/null
+++ b/drivers/gpu/apple-g5p/drm-validate.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_DRM_VALIDATE_H
+#define G5P_DRM_VALIDATE_H
+
+#include "bits-compat.h"
+
+#define G5P_USER_VA_START 0x10000ULL
+#define G5P_USER_VA_END 0x10000000000ULL
+#define G5P_USER_RESERVED_START G5P_IMAGE_VA
+#define G5P_USER_RESERVED_END (G5P_PIO_VA + G5P_PIO_SIZE)
+#define G5P_MAX_BO_SIZE (64ULL << 20)
+/* VA bookkeeping: the sum of mapping sizes in one VM.  A GEM bound twice
+ * (GBM alloc, then the EGL import of its own dma-buf) counts twice here.
+ */
+#define G5P_MAX_VM_BYTES BIT_ULL(30)
+/* Memory behind one VM's mappings, counted once per GEM object. */
+#define G5P_MAX_PINNED_BYTES (768ULL << 20)
+
+static inline bool g5p_user_pa_valid(u64 pa)
+{
+	return pa < 0x10000000000ULL && !(pa & (G5P_GPU_PAGE - 1));
+}
+
+static inline bool g5p_user_range_valid(u64 va, u64 size)
+{
+	if (!size || ((va | size) & (G5P_GPU_PAGE - 1)) ||
+	    va < G5P_USER_VA_START || va >= G5P_USER_VA_END ||
+	    size > G5P_USER_VA_END - va)
+		return false;
+	return va >= G5P_USER_RESERVED_END ||
+	       va + size <= G5P_USER_RESERVED_START;
+}
+
+static inline bool g5p_bo_range_valid(u64 offset, u64 size, u64 bo_size)
+{
+	return size && !((offset | size) & (G5P_GPU_PAGE - 1)) &&
+	       offset < bo_size && size <= bo_size - offset;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/fender.h b/drivers/gpu/apple-g5p/fender.h
new file mode 100644
index 000000000..cbdf203c5
--- /dev/null
+++ b/drivers/gpu/apple-g5p/fender.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_FENDER_H
+#define G5P_FENDER_H
+
+/* Every poll callback must enforce a deadline and retain its final raw word.
+ * Apple 20H350: stop c9fa10, prepare c9fc10, boot c9f954;
+ * Fender helpers ca4ccc (GPC state) and ca6544 (core-power request).
+ * Hardware interpretation of the 0 -> 1 transition remains experimental.
+ */
+struct g5p_fender_io {
+	void *ctx;
+	int (*write)(void *ctx, u32 reg, u32 value);
+	int (*poll)(void *ctx, u32 reg, u32 mask, u32 expected);
+};
+
+static inline int g5p_fender_idle(const struct g5p_fender_io *io)
+{
+	int ret;
+
+	ret = io->write(io->ctx, 0x20000, 0);
+	if (ret)
+		return ret;
+	ret = io->poll(io->ctx, 0x1000, 0x10, 0);
+	if (ret)
+		return ret;
+	ret = io->write(io->ctx, 0x1000, 0x10);
+	if (ret)
+		return ret;
+	return io->poll(io->ctx, 0x1000, 0x1f, 0);
+}
+
+static inline int g5p_fender_hold(const struct g5p_fender_io *io)
+{
+	int ret;
+
+	ret = io->write(io->ctx, 0x20000, 0x20);
+	if (ret)
+		return ret;
+	ret = io->poll(io->ctx, 0x20000, 0x20, 0x20);
+	if (ret)
+		return ret;
+	return io->poll(io->ctx, 0x1000, 0x1f, 0);
+}
+
+/* q: the pstate the GPC is requested at (R1+0x1000 = 0x10 | q, poll for q); 1 as before,
+ * or boot_gpu_perf_poweron's pin (boot.inc).
+ */
+static inline int
+g5p_fender_start_observed_q(const struct g5p_fender_io *io,
+			    void (*observe)(void *, const char *), u32 q)
+{
+	int ret;
+
+	ret = io->write(io->ctx, 0x20000, 0);
+	if (ret)
+		return ret;
+	if (observe)
+		observe(io->ctx, "release-core-clear");
+	ret = io->poll(io->ctx, 0x1000, 0x1f, 0);
+	if (ret)
+		return ret;
+	if (observe)
+		observe(io->ctx, "release-gpc0-verified");
+	ret = io->write(io->ctx, 0x1000, 0x10 | q);
+	if (ret)
+		return ret;
+	if (observe)
+		observe(io->ctx, "release-gpc1-requested");
+	ret = io->poll(io->ctx, 0x1000, 0x1f, q);
+	if (!ret && observe)
+		observe(io->ctx, "release-gpc1-active");
+	return ret;
+}
+
+static inline int g5p_fender_start_observed(const struct g5p_fender_io *io,
+					    void (*observe)(void *,
+							    const char *))
+{
+	return g5p_fender_start_observed_q(io, observe, 1);
+}
+
+static inline int g5p_fender_start(const struct g5p_fender_io *io)
+{
+	return g5p_fender_start_observed(io, NULL);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/gpu-oc.h b/drivers/gpu/apple-g5p/gpu-oc.h
new file mode 100644
index 000000000..733aba9d4
--- /dev/null
+++ b/drivers/gpu/apple-g5p/gpu-oc.h
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * GPU overclock record (boot_gpu_oc_mhz): docs/power/ds-gpu-dvfs.md §3-4, §9 R5;
+ * docs/gpu/experiments/clock-mechanisms.md §2.  Host test: scripts/gpu/perf60-host/test_oc.c.
+ *
+ * The hardware applies PSINFO record n (PMGR+0x70000 + 0x10*n, written by LLB 180395fd8 for
+ * slots 0-4 once per SoC reset, volatile) when Fender is asked for pstate n.  Word 0 = core-rail
+ * DAC code [31:24] | PLL valid [21] | multiplier [20:12] | predivider [8:4] | postdivider-1 [3:0];
+ * word 1 [7:0] = buck8 code; word 2 = timing selectors.
+ *
+ * PLL: VCO = 24 MHz * mult / prediv, f = VCO / postdiv.  Apple's GPU-domain (0x17) descriptors
+ * (LLB 0x1803bc718, all three chip sections) run VCOs from 800 to 2160 MHz (2160 = id 0x20 of
+ * section 0x2f0001ff, 90/1/3); the live states use 948..1650.  The overclock keeps postdiv 2 (every
+ * live state at or above 474 MHz uses 2 or 3) and the VCO inside Apple's range: f <= 1080 MHz.
+ * Apple's own descriptors at 804 (67/1/2), 850 (425/6/2), 900 (75/1/2); elsewhere record 4's
+ * dividers (prediv 4, postdiv 2: f = 3 MHz * mult) on a 3 MHz grid.
+ *
+ * Voltage: record 5 keeps record 4's timing word; its core (rail 1, PMIC 0x11, 450 mV + 3.125 mV *
+ * code, GPU only) and buck8 (rail 8, PMIC 0x18, 600 mV + 3.125 mV * code) codes default to record
+ * 4's (138 = 881.25 mV, 124 = 987.5 mV), never lower, raised only on request in whole 3.125 mV
+ * codes,
+ * and never above the ceilings: the boot parameters (default state 4 + 50 mV, the CPU overclock's
+ * rail-offset cap) bounded by the compiled maxima below (state 4 + 150 mV; raising those needs a
+ * rebuild).  The encoding itself reaches 1296 mV on both rails; that is not an operating point.
+ */
+#ifndef G5P_GPU_OC_H
+#define G5P_GPU_OC_H
+
+#include "bits-compat.h"
+
+#define G5P_PSINFO_BASE 0x70000U /* PMGR syscon offset */
+#define G5P_PSINFO_REC(n) (G5P_PSINFO_BASE + 0x10U * (n))
+#define G5P_OC_STATE 5U
+#define G5P_OC_PIN 500U /* boot_gpu_perf for state 5 */
+#define G5P_OC_STOCK4 \
+	0x8a2f1041U /* record 4 word 0 as LLB writes it on this chip */
+#define G5P_OC_STOCK4_BUCK8 124U /* record 4 word 1 [7:0] */
+#define G5P_OC_MIN_MHZ 726U /* the first grid step above 723 */
+#define G5P_OC_VCO_MAX 2160U /* Apple's highest GPU-domain VCO */
+#define G5P_OC_MAX_MHZ (G5P_OC_VCO_MAX / 2) /* postdiv 2: 1080 */
+#define G5P_OC_VCO_STOCK_MAX \
+	1650U /* the highest VCO of a live state (550 MHz) */
+#define G5P_OC_VALID BIT(21)
+#define G5P_OC_PLL_MASK 0x001ff1ffU /* mult, prediv, postdiv-1 */
+#define G5P_OC_UV_STEP 3125U
+#define G5P_OC_CORE_BASE_UV 450000U
+#define G5P_OC_BUCK8_BASE_UV 600000U
+/* 881250 */
+#define G5P_OC_CORE_STOCK_UV \
+	(G5P_OC_CORE_BASE_UV + G5P_OC_UV_STEP * (G5P_OC_STOCK4 >> 24))
+/* 987500 */
+#define G5P_OC_BUCK8_STOCK_UV \
+	(G5P_OC_BUCK8_BASE_UV + G5P_OC_UV_STEP * G5P_OC_STOCK4_BUCK8)
+/* the boot parameters' default ceiling: P4 + 50 mV */
+#define G5P_OC_DEFAULT_HEADROOM_UV 50000U
+#define G5P_OC_ABS_HEADROOM_UV \
+	150000U /* compiled: P4 + 150 mV, no parameter goes above */
+
+struct g5p_oc_pll {
+	u32 mhz, mult, prediv, postdiv;
+	bool llb; /* Apple's own descriptor */
+};
+
+static const struct g5p_oc_pll g5p_oc_llb[] = {
+	{ 804, 67, 1, 2, true }, /* LLB id 0x22, all three GPU sections */
+	{ 850, 425, 6, 2, true }, /* LLB id 0x23, the live section */
+	{ 900, 75, 1, 2, true }, /* LLB id 0x24, the live section */
+};
+
+/*
+ * The PLL for a requested MHz: Apple's descriptor at 804/850/900 (the request or its 3 MHz
+ * rounding),
+ * else the 3 MHz grid (rounded down) with record 4's dividers; false outside 726..1080.
+ */
+static inline bool g5p_oc_pll(u32 want, struct g5p_oc_pll *p)
+{
+	u32 mhz = want / 3 * 3;
+
+	for (u32 i = 0; i < ARRAY_SIZE(g5p_oc_llb); i++)
+		if (want == g5p_oc_llb[i].mhz || mhz == g5p_oc_llb[i].mhz) {
+			*p = g5p_oc_llb[i];
+			return true;
+		}
+	if (mhz < G5P_OC_MIN_MHZ || mhz > G5P_OC_MAX_MHZ)
+		return false;
+	*p = (struct g5p_oc_pll){ mhz, mhz / 3, 4, 2, false };
+	return true;
+}
+
+/* A rail voltage as a code: exact multiples of 3.125 mV above the base only. */
+static inline bool g5p_oc_code(u32 uv, u32 base, u32 *code)
+{
+	if (uv < base || (uv - base) % G5P_OC_UV_STEP ||
+	    (uv - base) / G5P_OC_UV_STEP > 0xff)
+		return false;
+	*code = (uv - base) / G5P_OC_UV_STEP;
+	return true;
+}
+
+/* The voltage codes for a request (0 = state 4's), bounded below by state 4 and above by the
+ * ceilings (each already clamped to the compiled maximum by g5p_oc_ceiling()).
+ */
+
+/* Record 5's words 0 and 1 from the live record 4 (stock only), a PLL and the voltage codes. */
+static inline bool g5p_oc_words(const u32 r4[4], u32 want, u32 core, u32 buck8,
+				u32 w[4], struct g5p_oc_pll *p)
+{
+	if (r4[0] != G5P_OC_STOCK4 || (r4[1] & 0xff) != G5P_OC_STOCK4_BUCK8 ||
+	    !g5p_oc_pll(want, p) || core < (G5P_OC_STOCK4 >> 24) ||
+	    core > 0xff || buck8 < G5P_OC_STOCK4_BUCK8 || buck8 > 0xff)
+		return false;
+	w[0] = core << 24 | G5P_OC_VALID | p->mult << 12 | p->prediv << 4 |
+	       (p->postdiv - 1);
+	w[1] = (r4[1] & ~0xffU) | buck8;
+	w[2] = r4[2];
+	w[3] = r4[3];
+	return true;
+}
+
+/* Hz of a record word 0, as iBoot 87001c3ac decodes it (0 if the predivider is 0). */
+static inline u64 g5p_oc_hz(u32 w0)
+{
+	u32 mult = (w0 >> 12) & 0x1ff, prediv = (w0 >> 4) & 0x1f,
+	    postdiv = (w0 & 0xf) + 1;
+
+	return prediv ? 24000000ULL * mult / prediv / postdiv : 0;
+}
+
+/* A nonzero record 5 that this driver writes: record 4's timing and word-3 words, valid, a PLL
+ * g5p_oc_pll() produces, voltage codes between state 4's and the compiled maxima.  Anything else in
+ * slot 5 is not ours: never overwritten or cleared.
+ */
+static inline bool g5p_oc_is_ours(const u32 r4[4], const u32 r5[4])
+{
+	u32 core = r5[0] >> 24, buck8 = r5[1] & 0xff, w[4], cmax, bmax;
+	struct g5p_oc_pll p;
+	u64 hz = g5p_oc_hz(r5[0]);
+
+	if (!g5p_oc_code(G5P_OC_CORE_STOCK_UV + G5P_OC_ABS_HEADROOM_UV,
+			 G5P_OC_CORE_BASE_UV, &cmax) ||
+	    !g5p_oc_code(G5P_OC_BUCK8_STOCK_UV + G5P_OC_ABS_HEADROOM_UV,
+			 G5P_OC_BUCK8_BASE_UV, &bmax) ||
+	    core > cmax || buck8 > bmax || !hz || hz % 1000000ULL ||
+	    !g5p_oc_words(r4, (u32)(hz / 1000000ULL), core, buck8, w, &p))
+		return false;
+	return w[0] == r5[0] && w[1] == r5[1] && w[2] == r5[2] && w[3] == r5[3];
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/heartbeat116.h b/drivers/gpu/apple-g5p/heartbeat116.h
new file mode 100644
index 000000000..428146764
--- /dev/null
+++ b/drivers/gpu/apple-g5p/heartbeat116.h
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_HEARTBEAT116_H
+#define G5P_HEARTBEAT116_H
+
+/*
+ * Heartbeat116: the R74 IRQ174 storm bound as a window rate, not a lifetime count.
+ *
+ * A healthy R74 epoch takes IRQ174 at about 575/s and consumes about 290 event-ring
+ * entries/s, idle or not: one type-0 ALIVE per firmware scheduler iteration, and two IRQ
+ * entries per ring entry (irqs = 2 * events - 18 over the Warm113 C4-prep R74 milestones;
+ * r81 measured 577/289 per s).  Wake112 bounded both counts over the epoch's lifetime:
+ * IRQ entries against boot_r74_irq_cap (1048576) and ring entries against the compute event
+ * limit (524544).  Either bound latched failed/event_failed, so an idle, healthy GPU faulted
+ * after about 30 minutes.
+ *
+ * Here both bounds are rates.  A window opens at the first IRQ entry and closes at the first
+ * entry at least window_ns later, then re-bases on the totals of that entry.  Totals are u32
+ * and every in-window count is a u32 difference, so a wrap of a total is harmless.
+ *
+ *   RATE    more than irq_ceiling IRQ entries in the open window (checked on every entry)
+ *   EVENTS  more than event_ceiling ring entries in the open window (checked on every entry)
+ *   STALL   stall_windows consecutive closed windows in which
+ *           irqs > ratio * events + slack.  Healthy traffic is 2:1.  A latch that re-fires
+ *           without ring progress, or a heartbeat after a fault stopped the drain, is not.
+ *
+ * A trip is absorbing.  Nothing here clears a failure; the glue adds the same terminal stop
+ * as the lifetime cap had (cap_seen, failed, event_failed, one disable_irq_nosync).
+ *
+ * Pure policy: no register access, no lock, no kernel API.  The caller serializes (the R73B
+ * IRQ thread is the only caller).
+ */
+
+#define G5P_HB_WINDOW_NS 1000000000ULL
+#define G5P_HB_IRQ_CEILING 16384U
+#define G5P_HB_EVENT_CEILING 8192U
+#define G5P_HB_RATIO 8U
+#define G5P_HB_SLACK 512U
+#define G5P_HB_STALL_WINDOWS 3U
+
+enum g5p_hb_why {
+	G5P_HBW_NONE,
+	G5P_HBW_RATE,
+	G5P_HBW_EVENTS,
+	G5P_HBW_STALL,
+	G5P_HBW_N,
+};
+
+static const char *const g5p_hb_why_name[G5P_HBW_N] = {
+	"none",
+	"rate",
+	"events",
+	"stall",
+};
+
+enum g5p_hb_res {
+	G5P_HBR_OPEN, /* counted in the open window */
+	G5P_HBR_CLOSED, /* this entry closed a window (h->last) */
+	G5P_HBR_TRIP, /* tripped now or earlier */
+};
+
+struct g5p_hb_cfg {
+	u64 window_ns;
+	u32 irq_ceiling, event_ceiling, ratio, slack, stall_windows;
+};
+
+/* The totals the IRQ thread samples after servicing one entry. */
+struct g5p_hb_in {
+	u64 now_ns;
+	u32 irqs; /* IRQ174 entries (b->irqs) */
+	u32 events; /* event-ring entries consumed (b->events) */
+	u32 acks; /* AIC ACKs written by the R73B handler */
+	u32 empty; /* entries whose service consumed no ring entry */
+	u32 aux; /* auxiliary-ring entries consumed */
+};
+
+/* One window: its start and length and its in-window counts. */
+struct g5p_hb_win {
+	u64 start_ns, ns;
+	u32 irqs, events, acks, empty, aux;
+};
+
+struct g5p_hb {
+	u32 open; /* zero until the first entry (kzalloc) */
+	u32 why; /* enum g5p_hb_why, written once */
+	u32 windows; /* windows closed */
+	u32 stalled; /* consecutive unproductive closed windows */
+	u32 peak_irqs, peak_events;
+	u64 start_ns;
+	struct g5p_hb_in base; /* totals at the window's first entry */
+	struct g5p_hb_win last; /* the last closed window */
+	struct g5p_hb_win trip; /* the open window at the trip */
+	u64 trip_ns;
+};
+
+static inline void g5p_hb_cfg_default(struct g5p_hb_cfg *c)
+{
+	c->window_ns = G5P_HB_WINDOW_NS;
+	c->irq_ceiling = G5P_HB_IRQ_CEILING;
+	c->event_ceiling = G5P_HB_EVENT_CEILING;
+	c->ratio = G5P_HB_RATIO;
+	c->slack = G5P_HB_SLACK;
+	c->stall_windows = G5P_HB_STALL_WINDOWS;
+}
+
+static inline void g5p_hb_count(const struct g5p_hb *h,
+				const struct g5p_hb_in *in,
+				struct g5p_hb_win *w)
+{
+	w->start_ns = h->start_ns;
+	w->ns = in->now_ns >= h->start_ns ? in->now_ns - h->start_ns : 0;
+	w->irqs = in->irqs - h->base.irqs;
+	w->events = in->events - h->base.events;
+	w->acks = in->acks - h->base.acks;
+	w->empty = in->empty - h->base.empty;
+	w->aux = in->aux - h->base.aux;
+}
+
+static inline bool g5p_hb_unproductive(const struct g5p_hb_cfg *c,
+				       const struct g5p_hb_win *w)
+{
+	return (u64)w->irqs > (u64)c->ratio * w->events + c->slack;
+}
+
+static inline enum g5p_hb_res
+g5p_hb_trip(struct g5p_hb *h, u32 why, const struct g5p_hb_win *w, u64 now_ns)
+{
+	h->why = why;
+	h->trip = *w;
+	h->trip_ns = now_ns;
+	return G5P_HBR_TRIP;
+}
+
+/* One serviced IRQ entry. */
+static inline enum g5p_hb_res g5p_hb_step(struct g5p_hb *h,
+					  const struct g5p_hb_cfg *c,
+					  const struct g5p_hb_in *in)
+{
+	struct g5p_hb_win w;
+
+	if (h->why)
+		return G5P_HBR_TRIP;
+	if (!h->open) {
+		h->open = 1;
+		h->start_ns = in->now_ns;
+		h->base = *in;
+		return G5P_HBR_OPEN;
+	}
+	g5p_hb_count(h, in, &w);
+	if (w.irqs > c->irq_ceiling)
+		return g5p_hb_trip(h, G5P_HBW_RATE, &w, in->now_ns);
+	if (w.events > c->event_ceiling)
+		return g5p_hb_trip(h, G5P_HBW_EVENTS, &w, in->now_ns);
+	if (w.ns < c->window_ns)
+		return G5P_HBR_OPEN;
+	h->last = w;
+	h->windows++;
+	if (w.irqs > h->peak_irqs)
+		h->peak_irqs = w.irqs;
+	if (w.events > h->peak_events)
+		h->peak_events = w.events;
+	h->stalled = g5p_hb_unproductive(c, &w) ? h->stalled + 1 : 0;
+	h->start_ns = in->now_ns;
+	h->base = *in;
+	if (h->stalled >= c->stall_windows)
+		return g5p_hb_trip(h, G5P_HBW_STALL, &w, in->now_ns);
+	return G5P_HBR_CLOSED;
+}
+
+/* Receipts: the first four closed windows, then every 64th. */
+static inline bool g5p_hb_report(const struct g5p_hb *h)
+{
+	return h->windows <= 4 || !(h->windows % 64);
+}
+
+#endif /* G5P_HEARTBEAT116_H */
diff --git a/drivers/gpu/apple-g5p/idle-power.inc b/drivers/gpu/apple-g5p/idle-power.inc
new file mode 100644
index 000000000..d2ce71879
--- /dev/null
+++ b/drivers/gpu/apple-g5p/idle-power.inc
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Software/shared-RAM observation only. Never wake or probe GPU registers. */
+static ssize_t idle_power_status_show(struct device *dev,
+                                     struct device_attribute *attr, char *buf)
+{
+	struct g5p_diag *g = dev_get_drvdata(dev);
+	struct g5p_boot *b;
+	u32 p, state, target, mirror, period;
+	int ret;
+
+	if (!mutex_trylock(&g->lock))
+		return sysfs_emit(buf, "available=0 why=busy mmio=0\n");
+	b = g->boot;
+	if (!b || !b->maps_ready) {
+		ret = sysfs_emit(buf, "available=0 why=no-maps mmio=0\n");
+		goto out;
+	}
+	p = b->layout.offset[0x4a];
+	dma_rmb();
+	period = g5p_dc_root_word(b, p + 4);
+	state = g5p_dc_root_word(b, p + 8);
+	target = g5p_dc_root_word(b, p + 0x28);
+	mirror = g5p_dc_root_word(b, p + 0x34);
+	/* +34 is both a sampled Fender nibble and the setter's requested index.
+	 * It is not a completed transition or stable-off certificate. Stale RAM
+	 * remains readable across a stopped/failed epoch; label it explicitly.
+	 */
+	ret = sysfs_emit(buf,
+			 "available=1 gen=%u alive=%u failed=%u stopped=%u powered=%u "
+			 "policy_state=%u target=%u policy_pstate=%u sample_ms=%u "
+			 "meta71c=%u source=shared-ram atomic=0 hw_ack=0 mmio=0\n",
+			 g5p_ds_gen(), b->alive, b->failed, b->stopped,
+			 g->powered, state, target, mirror, period, b->meta71c);
+out:
+	mutex_unlock(&g->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(idle_power_status);
diff --git a/drivers/gpu/apple-g5p/kick.inc b/drivers/gpu/apple-g5p/kick.inc
new file mode 100644
index 000000000..6ef7395c6
--- /dev/null
+++ b/drivers/gpu/apple-g5p/kick.inc
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Shared pre-kick step recovered from ca0358/ca05d4 and ca6644. */
+static int g5p_prepare_kick(struct g5p_diag *g, const char *name)
+{
+	u32 raw, state;
+
+	if (gfx_bridge_replay && !strcmp(name, "RENDER-TA"))
+		g5p_r41_bridge_ta(g);
+	/* ca05d4 always invokes Fender +80 before inspecting GPC state.
+	 * ca6644: W R1+14=7, then read fence. Hardware bit names unknown.
+	 * This is distinct from acknowledging the host AIC interrupt.
+	 */
+	dev_info(g->dev, "%s Fender W R1+00014=00000007 before MTS kick\n",
+		 name);
+	writel(7, g->window[1] + 0x14);
+	raw = readl(g->window[1] + 0x14);
+	dev_info(g->dev, "%s Fender raw R1+00014=%08x (write fence)\n", name,
+		 raw);
+	if (raw & ~7U)
+		return -EPROTO;
+	state = readl(g->window[1] + 0x1000);
+	if (!g5p_gpc_ok(state))
+		return -EHOSTDOWN;
+	if (READ_ONCE(g->boot->failed))
+		return -EIO;
+	return 0;
+}
diff --git a/drivers/gpu/apple-g5p/latency123.h b/drivers/gpu/apple-g5p/latency123.h
new file mode 100644
index 000000000..164dc8e68
--- /dev/null
+++ b/drivers/gpu/apple-g5p/latency123.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Latency123: firmware words a powered iOS GPU has and our bootstrap leaves zero
+ * (docs/gpu/firmware-re/wake-latency-re.md sections 3.4 and 4.2).
+ *
+ * Arm A.  The firmware copies meta+0x6c0..0x758 into its private block once, at init
+ * (MINIM 0x100009ac -> 0x10003ca4), so these words only act from the boot image:
+ *   meta+0x6d4 = 1           per-tick cache maintenance 0x1001b638 (688/1720/e230/e138)
+ *   meta+0x710/0x714         pstate table max index / count
+ *   meta+0x718..             pstate MHz; the tick period is table[Fender+0x1000 & 0xf]
+ *   policy+0x4 = 16          governor sample period, ms (the governor reads it live)
+ * 1 = capped: table { 0, 340 }, max index 1.  The firmware's own pstate setter
+ *     (0x1001c88c, Fender+0x1000 = index | 0x10) can then only ask for pstate 1, the state
+ *     the host already requests, so the clock does not move.
+ * 2 = full: table { 0, 340, 474, 550, 723 }, max index 4, plus the limits README rank 2
+ *     pairs with it (control+0x1028/0x102c/0x1030 = 3348/400/400, policy+0x7cc/0x6fc =
+ *     400).  The firmware may then raise the GPU clock itself; nothing on Linux programs
+ *     a GPU voltage table, so this arm runs after the capped one.
+ *
+ * Arm B.  ctl+0x04 is the per-engine tick-service mask (iOS 7).  Every tick re-copies
+ * ctl+0x00..0x20 (0x10001328), so the word is live; the boot image gets the value the
+ * parameter holds at map and the render path re-applies it before each job.
+ *
+ * RAM only.  Temporary A/B code: the winning words become unconditional init writes.
+ */
+#ifndef APPLE_G5P_LATENCY123_H
+#define APPLE_G5P_LATENCY123_H
+
+#include "bits-compat.h"
+#define G5P_L123_POLICY 0x4aU
+#define G5P_L123_META 0x4dU
+#define G5P_L123_CTL 0x5eU
+#define G5P_L123_TICK_MASK 7U
+#define G5P_L123_CAPPED 1U
+#define G5P_L123_FULL 2U
+
+static const u32 g5p_l123_mhz[] = { 0, 340, 474, 550, 723 };
+
+static inline void g5p_l123_arm_a(const struct g5p_boot_layout *p, u8 *root,
+				  u8 *shared, u32 arm)
+{
+	u8 *meta = g5p_object(p, root, shared, G5P_L123_META);
+	u8 *policy = g5p_object(p, root, shared, G5P_L123_POLICY);
+	u8 *ctl = g5p_object(p, root, shared, G5P_L123_CTL);
+	u32 count = arm == G5P_L123_FULL ? ARRAY_SIZE(g5p_l123_mhz) : 2;
+	u32 i;
+
+	g5p_put32(meta + 0x6d4, 1);
+	g5p_put32(meta + 0x710, count - 1);
+	g5p_put32(meta + 0x714, count);
+	for (i = 0; i < count; i++)
+		g5p_put32(meta + 0x718 + 4 * i, g5p_l123_mhz[i]);
+	g5p_put32(policy + 4, 16);
+	if (arm != G5P_L123_FULL)
+		return;
+	g5p_put32(ctl + 0x1028, 3348);
+	g5p_put32(ctl + 0x102c, 400);
+	g5p_put32(ctl + 0x1030, 400);
+	g5p_put32(policy + 0x7cc, 400);
+	g5p_put32(policy + 0x6fc, 400);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/ldr.h b/drivers/gpu/apple-g5p/ldr.h
new file mode 100644
index 000000000..165aacf85
--- /dev/null
+++ b/drivers/gpu/apple-g5p/ldr.h
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Deliberately small Apple G5P META LDR reader. No allocation or MMIO here. */
+#ifndef APPLE_G5P_LDR_H
+#define APPLE_G5P_LDR_H
+
+#ifndef G5P_LDR_USER_TEST
+#include <linux/errno.h>
+#include <linux/types.h>
+#endif
+
+#define G5P_LDR_MAX_RECORDS 128
+#define G5P_LDR_MAX_BYTES (256 * 1024)
+
+enum g5p_ldr_op { G5P_LOAD, G5P_ZERO, G5P_CONFIG, G5P_START };
+
+typedef int (*g5p_ldr_emit)(void *ctx, enum g5p_ldr_op op, u32 address,
+			    u32 size, const u8 *data);
+
+static inline u32 g5p_le32(const u8 *p)
+{
+	return (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+
+static inline u16 g5p_le16(const u8 *p)
+{
+	return (u16)p[0] | (u16)p[1] << 8;
+}
+
+static inline bool g5p_ldr_bounds(size_t len, u32 off, u32 size)
+{
+	return off <= len && size <= len - off;
+}
+
+static inline int g5p_ldr_l2(const u8 *fw, size_t len, u32 off, u16 tag,
+			     const u8 **data, u32 *size)
+{
+	u16 bytes;
+
+	if (!g5p_ldr_bounds(len, off, 4))
+		return -EINVAL;
+	bytes = g5p_le16(fw + off + 2);
+	if (bytes < 6 || !g5p_ldr_bounds(len, off, bytes) ||
+	    g5p_le16(fw + off) != tag)
+		return -EINVAL;
+	*data = fw + off + 4;
+	*size = bytes - 6;
+	return 0;
+}
+
+/* Validate in a first pass (emit=NULL); only then use a hardware callback. */
+static inline int g5p_ldr_walk(const u8 *fw, size_t len, g5p_ldr_emit emit,
+			       void *ctx)
+{
+	u32 pos, seen[G5P_LDR_MAX_RECORDS], total = 0;
+	unsigned int nr = 0, starts = 0;
+
+	if (len != 119112 || g5p_le32(fw) != 0x01aa5500 ||
+	    !g5p_ldr_bounds(len, g5p_le32(fw + 4), 1))
+		return -EINVAL;
+	pos = g5p_le32(fw + 8);
+	while (pos != 0xffffffff) {
+		const u8 *p, *data;
+		u32 command, bytes, addr = 0, size = 0, l2, next;
+		enum g5p_ldr_op op;
+		unsigned int i;
+		int ret;
+
+		if (nr == G5P_LDR_MAX_RECORDS || !g5p_ldr_bounds(len, pos, 12))
+			return -EINVAL;
+		for (i = 0; i < nr; i++)
+			if (seen[i] == pos)
+				return -EINVAL;
+		seen[nr++] = pos;
+		p = fw + pos;
+		command = g5p_le16(p);
+		bytes = g5p_le16(p + 2);
+		next = g5p_le32(p + 4);
+		if (bytes < 12 || (bytes & 3) ||
+		    !g5p_ldr_bounds(len, pos, bytes))
+			return -EINVAL;
+		if (command & 0x10) {
+			if (command != 0x10 || bytes != 16)
+				return -EINVAL;
+			ret = g5p_ldr_l2(fw, len, g5p_le32(p + 8), 0x8010,
+					 &data, &size);
+			if (ret)
+				return ret;
+			goto next_record;
+		}
+		switch (command) {
+		case 0:
+			if (bytes != 20)
+				return -EINVAL;
+			op = G5P_LOAD;
+			addr = g5p_le32(p + 8);
+			l2 = g5p_le32(p + 12);
+			ret = g5p_ldr_l2(fw, len, l2, 0x8000, &data, &size);
+			if (ret)
+				return ret;
+			break;
+		case 4:
+			if (bytes != 24)
+				return -EINVAL;
+			op = G5P_ZERO;
+			addr = g5p_le32(p + 8);
+			size = g5p_le32(p + 12);
+			ret = g5p_ldr_l2(fw, len, g5p_le32(p + 16), 0x8004,
+					 &data, &l2);
+			if (ret || l2)
+				return -EINVAL;
+			break;
+		case 5:
+		case 3:
+			if (bytes != 16)
+				return -EINVAL;
+			op = command == 5 ? G5P_CONFIG : G5P_START;
+			ret = g5p_ldr_l2(fw, len, g5p_le32(p + 8),
+					 0x8000 | command, &data, &size);
+			if (ret || !size || size % (command == 5 ? 12 : 16))
+				return -EINVAL;
+			if (command == 5) {
+				for (i = 0; i < size; i += 12)
+					if (g5p_le32(data + i) != 2 ||
+					    (g5p_le32(data + i + 4) & 3))
+						return -EINVAL;
+			} else {
+				if (++starts != 1 || size != 32 ||
+				    next != 0xffffffff || g5p_le32(data) != 1 ||
+				    g5p_le32(data + 16) != 0)
+					return -EINVAL;
+			}
+			break;
+		default:
+			return -EINVAL;
+		}
+		if (op == G5P_LOAD || op == G5P_ZERO) {
+			if ((addr & 3) || (size & 3) || !size ||
+			    size > G5P_LDR_MAX_BYTES ||
+			    addr > (u32)~0U - size ||
+			    total > G5P_LDR_MAX_BYTES - size)
+				return -EINVAL;
+			total += size;
+		}
+		if (emit) {
+			ret = emit(ctx, op, addr, size, data);
+			if (ret)
+				return ret;
+		}
+next_record:
+		pos = next;
+	}
+	return nr == 94 && starts == 1 ? 0 : -EINVAL;
+}
+#endif
diff --git a/drivers/gpu/apple-g5p/lifecycle.inc b/drivers/gpu/apple-g5p/lifecycle.inc
new file mode 100644
index 000000000..9a896569c
--- /dev/null
+++ b/drivers/gpu/apple-g5p/lifecycle.inc
@@ -0,0 +1,1032 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Post-alive transport and park experiments; never implicit recovery. */
+static const bool control_experiment = 1;
+static const bool irq_experiment = 0;
+static const bool teardown_experiment = 1;
+
+/* A complete sparse image: first sample omits only zero words, later samples
+ * emit every changed word (including transitions to zero). All allocated
+ * root/shared memory is covered, including unknown status/trace buffers.
+ * These are CPU coherent RAM observations, never proof of META cache contents.
+ * IRQs can update memory concurrently; this is deliberately not an atomic dump.
+ */
+static u32 g5p_dc_root_word(struct g5p_boot *b, u32 offset)
+{
+	return READ_ONCE(*(u32 *)(b->root[offset / G5P_GPU_PAGE].cpu +
+				  offset % G5P_GPU_PAGE));
+}
+
+/* nopatch: the policy record (slot 0x4a) words 0x1000d044 decides readiness from: +8 state,
+ * +0xc substate, +0x34 pstate mirror; +0 and +4 (sample period) for context.  iOS keeps +8 at 0.
+ */
+static const u32 g5p_np_words[5] = { 0, 4, 8, 0xc, 0x34 };
+
+static void g5p_np_read(struct g5p_boot *b, u32 *w)
+{
+	dma_rmb();
+	for (u32 i = 0; i < ARRAY_SIZE(g5p_np_words); i++)
+		w[i] = g5p_dc_root_word(b, b->layout.offset[0x4a] +
+						   g5p_np_words[i]);
+}
+
+static void g5p_np_print(struct g5p_diag *g, const char *stage, u32 seq, u32 e,
+			 const u32 *w)
+{
+	dev_info(
+		g->dev,
+		"NOPATCH policy stage=%s seq=%u engine=%u +0=%08x +4=%08x +8=%08x +c=%08x "
+		"+34=%08x events=%u end=nopatch\n",
+		stage, seq, e, w[0], w[1], w[2], w[3], w[4],
+		READ_ONCE(g->boot->events));
+}
+
+/* RAM only; nothing unless the unpatched image is latched. */
+static void g5p_np_policy(struct g5p_diag *g, const char *stage, u32 seq, u32 e)
+{
+	struct g5p_boot *b = g->boot;
+	u32 w[ARRAY_SIZE(g5p_np_words)];
+
+	if (!b || !b->r73b || !b->r73b->nopatch)
+		return;
+	g5p_np_read(b, w);
+	g5p_np_print(g, stage, seq, e, w);
+}
+
+/* Read fixed allocated policy objects, never follow firmware-owned pointers.
+ * 1000d044/1000d504 test these states;1001c900 stores requested pstate.
+ * These are sampled boundary predicates, NOT entry/return breadcrumbs or PC.
+ */
+
+/* Firmware MMU recovery uses event mask200 and reads e150/e158.
+ * Read raw qword halves without ACK/clear; concurrent updates can tear them.
+ * An absent sampled event does not exclude an earlier firmware-handled fault.
+ */
+static void g5p_fault_snapshot(struct g5p_diag *g, const char *stage)
+{
+	u32 event, lo, hi, lo2, hi2;
+
+	g5p_mmu_progress(g, stage, 0x130);
+	event = readl(g->rgx + 0x130);
+	g5p_mmu_progress(g, stage, 0xe150);
+	lo = readl(g->rgx + 0xe150);
+	g5p_mmu_progress(g, stage, 0xe154);
+	hi = readl(g->rgx + 0xe154);
+	g5p_mmu_progress(g, stage, 0xe158);
+	lo2 = readl(g->rgx + 0xe158);
+	g5p_mmu_progress(g, stage, 0xe15c);
+	hi2 = readl(g->rgx + 0xe15c);
+	g5p_mmu_record(
+		g,
+		"MMU %s event130=%08x pending=%u e150=%08x:%08x e158=%08x:%08x raw-split read-only\n",
+		stage, event, !!(event & 0x200), hi, lo, hi2, lo2);
+}
+
+/* Same active-wrapper gate as CDM observations. Never write/ACK a register.
+ * 1001c9b8 samples R0+164/160/164; bound host sampling even on rollover.
+ * A split sample with different high words is explicitly unstable.
+ */
+
+static void g5p_dc_snapshot(struct g5p_diag *g, const char *stage, bool first)
+{
+	{
+		return;
+	}
+}
+
+static int g5p_control_prepare(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	u32 *work = (u32 *)g5p_boot_shared(b, 0x68);
+	u32 consumer = READ_ONCE(ctl[0]), producer = READ_ONCE(ctl[4]);
+	u32 ctl_meta = g5p_meta_address(g5p_object_va(&b->layout, 0x6e));
+	u32 data_meta = g5p_meta_address(g5p_object_va(&b->layout, 0x6f));
+	u8 *init = b->root[0].cpu;
+	u8 *handoff = b->image[0].cpu + 0x3ff8;
+	u32 *events = (u32 *)g5p_boot_shared(b, 0x70);
+
+	/* c9f868/c9f884: validate the loaded boot handoff, not just its builder. */
+	if (g5p_le32(handoff) != g5p_meta_address(G5P_ROOT_VA) ||
+	    g5p_le32(handoff + 4) !=
+		    g5p_meta_address(g5p_object_va(&b->layout, 0x5f)))
+		return -EPROTO;
+	/* Drain under event_lock before checking that ALIVE has been returned. */
+	if (g5p_r73b_service(g, G5P_R73B_OWNER_PREPARE, true))
+		return -EIO;
+	if (READ_ONCE(events[0]) > 255 || READ_ONCE(events[4]) > 255)
+		return -EPROTO;
+	if (READ_ONCE(events[0]) != READ_ONCE(events[4]))
+		return -EBUSY;
+	dev_info(g->dev,
+		 "DC boot handoff verified; event consumer=%u producer=%u\n",
+		 READ_ONCE(events[0]), READ_ONCE(events[4]));
+
+	;
+	;
+	;
+	;
+	/* c96be8: init+18/+1c are META addresses, never CPU/DMA pointers. */
+	if (g5p_le32(init + 0x18) != ctl_meta ||
+	    g5p_le32(init + 0x1c) != data_meta)
+		return -EPROTO;
+	dev_info(
+		g->dev,
+		"DC mapping ctl GPU=%llx META=%08x data GPU=%llx META=%08x; init verified\n",
+		g5p_object_va(&b->layout, 0x6e), ctl_meta,
+		g5p_object_va(&b->layout, 0x6f), data_meta);
+
+	if (b->work_ready)
+		return -EBUSY;
+	if (b->control_ready)
+		return b->r73b && 1 ? 0 : -EALREADY;
+	if (consumer > 255 || producer > 255)
+		return -EPROTO;
+	if (consumer != producer || READ_ONCE(work[0]) != READ_ONCE(work[4]) ||
+	    (b->work_submitted && !b->work_complete))
+		return -EBUSY;
+	/* c993f8, size=0: no payload copy, ctrl+1020=0, command={8,0,0,0,0}.
+	 * No claim that this is an opcode-independent firmware NOP.
+	 */
+	g5p_put32(g5p_boot_shared(b, 0x5e) + 0x1020, 0);
+	b->control_target = (producer + 1) & 255;
+	b->control_ready = true;
+	dev_info(
+		g->dev,
+		"DC prepare cmd=8 payload_words=0 consumer=%u producer=%u target=%u; RAM only\n",
+		consumer, producer, b->control_target);
+	return 0;
+}
+
+static int g5p_r73e_prepare(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	int ret;
+
+	ret = g5p_control_prepare(g);
+	if (!ret)
+		WRITE_ONCE(b->r73b->fast_window, true);
+	dev_info(
+		g->dev,
+		"R73E cmd8 prepared-before-release ret=%d target=%u end=r73e\n",
+		ret, b->control_target);
+	return ret;
+}
+
+/* Apple's GPC precondition (AGXMetaFender_setGPCPerformanceState, ...6ca4ccc): a request in
+ * device test shows R1+0x1000 bit 4; wait for it to clear before judging the state.  R1 reads only,
+ * bounded by boot_alive_settle_us; with 0 the first read stands, as before.
+ */
+static u32 g5p_r74e_settled(struct g5p_diag *g, struct g5p_r73b *r, u32 raw)
+{
+	u64 start;
+
+	if (!r->settle_us || !(raw & 0x10))
+		return raw;
+	if (!r->settle_first)
+		r->settle_first = raw;
+	start = ktime_get_mono_fast_ns();
+	while ((raw & 0x10) && ktime_get_mono_fast_ns() - start <
+				       (u64)r->settle_us * NSEC_PER_USEC) {
+		udelay(10);
+		raw = readl(g->window[1] + 0x1000);
+		r->settle_samples++;
+	}
+	r->settle_ns += ktime_get_mono_fast_ns() - start;
+	return raw;
+}
+
+static int g5p_r73e_irq_submit(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	struct g5p_r73b *r = b->r73b;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	u32 producer = (b->control_target - 1) & 255;
+	u32 off, raw;
+	enum g5p_pxg gate;
+
+	if (!b->control_ready || b->control_submitted)
+		return -EPERM;
+	/* wake112: release_ready, or a deferred R74E proof that the read below settles. */
+	gate = g5p_px_gate(READ_ONCE(r->early_power_abort),
+			   READ_ONCE(r->early_release_ready),
+			   atomic_read_acquire(&r->early_proof));
+	if (gate != G5P_PXG_READY && gate != G5P_PXG_PROVE)
+		return -EHOSTDOWN;
+	if (READ_ONCE(ctl[0]) != producer || READ_ONCE(ctl[4]) != producer)
+		return -EPROTO;
+	if (gate == G5P_PXG_PROVE && !g5p_r74e_take(g))
+		return -EHOSTDOWN;
+	r->early_state = g5p_r74e_settled(g, r, readl(g->window[1] + 0x1000));
+	if (gate == G5P_PXG_PROVE)
+		g5p_r74e_settle(r, r->early_state);
+	if (!g5p_gpc_ok(r->early_state))
+		return -EHOSTDOWN;
+	/* nopatch: five RAM loads, the state the readiness gate will see before this bell. */
+	if (r->nopatch)
+		g5p_np_read(b, r->np_pre);
+	off = b->layout.offset[0x6d] + producer * 20;
+	for (u32 i = 0; i < 5; i++) {
+		u32 at = off + i * 4;
+		u8 *dst = b->shared[at / G5P_GPU_PAGE].cpu + at % G5P_GPU_PAGE;
+
+		g5p_put32(dst, i ? 0 : 8);
+	}
+	WRITE_ONCE(b->control_submitted, true);
+	dma_wmb();
+	WRITE_ONCE(ctl[4], b->control_target);
+	mb();
+	g5p_r73b_crumb(b, G5P_R73B_DC_PUBLISHED, G5P_R73B_OWNER_IRQ, 0);
+	/* Functional pre-kick sequence only; no optional diagnostics here. */
+	writel(7, g->window[1] + 0x14);
+	raw = readl(g->window[1] + 0x14);
+	if (raw & ~7U)
+		return -EPROTO;
+	r->early_after_state =
+		g5p_r74e_settled(g, r, readl(g->window[1] + 0x1000));
+	if (!g5p_gpc_ok(r->early_after_state))
+		return -EHOSTDOWN;
+	dev_emerg(
+		g->dev,
+		"R73E doorbell begin first-ALIVE W0+00b00 value=00000010 end=r73e\n");
+	writel(0x10, g->rgx + 0xb00);
+	dev_emerg(g->dev, "R73E doorbell end first-ALIVE W0+00b00 end=r73e\n");
+	g5p_r73b_crumb(b, G5P_R73B_DC_KICKED, G5P_R73B_OWNER_IRQ, 0);
+	return 0;
+}
+
+static int g5p_r73e_alive_submit(struct g5p_diag *g, u32 owner)
+{
+	struct g5p_boot *b = g->boot;
+	struct g5p_r73b *r = b->r73b;
+	enum g5p_pxg gate;
+	u32 px;
+	int ret;
+
+	/* wake112: a deferred R74E proof admits the once-owner as release_ready does. */
+	gate = g5p_px_gate(READ_ONCE(r->early_power_abort),
+			   READ_ONCE(r->early_release_ready),
+			   atomic_read_acquire(&r->early_proof));
+	if (gate == G5P_PXG_REFUSE)
+		return -EHOSTDOWN;
+	if (gate == G5P_PXG_WAIT)
+		return -EAGAIN;
+	if (atomic_cmpxchg(&r->early_busy, 0, 1))
+		return -EAGAIN;
+	if (atomic_cmpxchg(&r->early_once, 0, 1)) {
+		ret = READ_ONCE(r->early_ret);
+		goto out;
+	}
+	r->early_irq_ns = ktime_get_mono_fast_ns();
+	r->early_ret = g5p_r73e_irq_submit(g);
+	ret = r->early_ret;
+	WRITE_ONCE(r->fast_window, false);
+	if (ret == -EHOSTDOWN)
+		WRITE_ONCE(r->early_power_abort, true);
+	dev_emerg(
+		g->dev,
+		"R74E ALIVE submit case=%u owner=%u state=%08x after=%08x ret=%d "
+		"release_ready=%u power_abort=%u submitted=%u end=r74e\n",
+		r->r73e_case, owner, r->early_state, r->early_after_state, ret,
+		r->early_release_ready, r->early_power_abort,
+		READ_ONCE(b->control_submitted));
+	if (r->settle_first)
+		dev_emerg(
+			g->dev,
+			"R74E settle first=%08x state=%08x after=%08x samples=%u ns=%llu limit_us=%u "
+			"ret=%d end=r74e\n",
+			r->settle_first, r->early_state, r->early_after_state,
+			r->settle_samples, r->settle_ns, r->settle_us, ret);
+	if (r->nopatch && READ_ONCE(b->control_submitted))
+		g5p_np_print(g, "pre-bell", 0, 0, r->np_pre);
+	px = atomic_read(&r->early_proof);
+	/* raw: the proof read, or U32_MAX when it did not happen (a refusal or no take). */
+	if (px != G5P_PX_NONE)
+		dev_emerg(
+			g->dev,
+			"R74E112 proof owner=%u state=%s why=%s gen=%u/%u raw=%08x release_ready=%u "
+			"power_abort=%u end=r74e112\n",
+			owner, g5p_px_name[min_t(u32, px, G5P_PX_N - 1)],
+			g5p_px_why_name[min_t(u32, r->early_proof_why,
+					      G5P_PXW_N - 1)],
+			r->early_proof_gen, r->early_proof_gen_now,
+			px == G5P_PX_PROVEN ||
+					r->early_proof_why == G5P_PXW_STATE ?
+				r->early_state :
+				U32_MAX,
+			r->early_release_ready, r->early_power_abort);
+out:
+	atomic_set(&r->early_busy, 0);
+	return ret;
+}
+
+static int g5p_control_submit(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	u32 producer = (b->control_target - 1) & 255;
+	u32 state, off;
+	int ret;
+
+	if (b->control_submitted)
+		return b->r73b && 1 ? 0 : -EPERM;
+	if (!b->control_ready)
+		return -EPERM;
+	/* R73 synchronous pre-publish pass closes the race where trace records
+	 * do not raise a final IRQ. A negative result is scoreable only when the
+	 * factor reaches cmd8 with every outbound auxiliary consumer caught up.
+	 */
+	ret = g5p_r73b_service(g, G5P_R73B_OWNER_PUBLISH, true);
+	if (ret)
+		return ret;
+	if (READ_ONCE(ctl[0]) != producer || READ_ONCE(ctl[4]) != producer)
+		return -EPROTO;
+	state = readl(g->window[1] + 0x1000);
+	dev_info(g->dev, "DC raw R1+01000=%08x (require active before kick)\n",
+		 state);
+	if (!g5p_gpc_ok(state))
+		return -EHOSTDOWN;
+	g5p_dc_snapshot(g, "before-publish", true);
+	off = b->layout.offset[0x6d] + producer * 20;
+	for (u32 i = 0; i < 5; i++) {
+		u32 at = off + i * 4;
+		u8 *dst = b->shared[at / G5P_GPU_PAGE].cpu + at % G5P_GPU_PAGE;
+
+		g5p_put32(dst, i ? 0 : 8);
+	}
+	WRITE_ONCE(b->control_submitted, true);
+	dma_wmb();
+	WRITE_ONCE(ctl[4], b->control_target);
+	/* ca05d4: full dmb ish after producer, before Fender and MTS. */
+	mb();
+	g5p_r73b_crumb(b, G5P_R73B_DC_PUBLISHED, G5P_R73B_OWNER_PUBLISH, 0);
+	for (u32 i = 0; i < 5; i++) {
+		u32 at = off + i * 4;
+		u8 *src = b->shared[at / G5P_GPU_PAGE].cpu + at % G5P_GPU_PAGE;
+
+		if (g5p_le32(src) != (i ? 0 : 8))
+			return -EBADMSG;
+	}
+	if (READ_ONCE(ctl[4]) != b->control_target)
+		return -EPROTO;
+	dev_info(
+		g->dev,
+		"DC slot verified words=00000008/0/0/0/0 producer=%u; full barrier\n",
+		b->control_target);
+	ret = g5p_prepare_kick(g, "DC");
+	if (ret)
+		return ret;
+	;
+	if (b->r73_aux_drain) {
+		ret = g5p_r73b_service(g, G5P_R73B_OWNER_KICK, true);
+		if (ret)
+			return ret;
+	}
+	g5p_dc_snapshot(g, "before-kick", false);
+	dev_info(
+		g->dev,
+		"DC publish cmd=8 slot=%u target=%u; W R0+00b00=%08x variant=%u\n",
+		producer, b->control_target, b->dc_variant == 4 ? 0x12 : 0x10,
+		b->dc_variant);
+	/* 0x12 is verified for CL, NOT for DC: variant 4 tests dispatch routing. */
+	writel(7 == 4 ? 0x12 : 0x10, g->rgx + 0xb00);
+	g5p_r73b_crumb(b, G5P_R73B_DC_KICKED, G5P_R73B_OWNER_KICK, 0);
+	g5p_dc_snapshot(g, "after-kick", false);
+	return 0;
+}
+
+/* perf60 pin >100 (seed 1-5, poweron): the policy record as the firmware left it, from RAM, plus the
+ * real Fender state through an R1-only ticket of the register licence (any pstate, bit 29 allowed).
+ * The sampler 0x1000aa80 stores its own "now" at policy+0x918 on every call (0x1000ab44) and the
+ * current state at +0x34 (0x1000ab18), so fw_now against the host's arch timer names the
+ * firmware's clock, and +0x34 / +0 / +0x8f8 name the branch it took.
+ */
+static void g5p_perf_readback(struct g5p_diag *g, const char *why)
+{
+	struct g5p_boot *b = g->boot;
+	u32 pol = b->layout.offset[0x4a], meta = b->layout.offset[0x4d];
+	u64 host = arch_timer_read_counter(), rate = arch_timer_get_rate();
+	u64 p8f8, p918, p920, m784;
+	struct g5p_mmio_ticket t;
+
+	if (!b->gpu_perf || (!b->perf_seed && !b->perf_poweron))
+		return;
+	dma_rmb();
+	p8f8 = g5p_dc_root_word(b, pol + 0x8f8) |
+	       (u64)g5p_dc_root_word(b, pol + 0x8fc) << 32;
+	p918 = g5p_dc_root_word(b, pol + 0x918) |
+	       (u64)g5p_dc_root_word(b, pol + 0x91c) << 32;
+	p920 = g5p_dc_root_word(b, pol + 0x920) |
+	       (u64)g5p_dc_root_word(b, pol + 0x924) << 32;
+	m784 = g5p_dc_root_word(b, meta + 0x784) |
+	       (u64)g5p_dc_root_word(b, meta + 0x788) << 32;
+	if (!g5p_mmio_hold(g, &t, G5P_MMIO_CENSUS))
+		g5p_mmio_release(g, &t);
+	dev_emerg(
+		g->dev,
+		"GPUPERF readback why=%s seed=%u/%u poweron=%u pol0=%u pol4=%u pol8=%u polc=%u "
+		"pol28=%u pol2c=%u pol30=%u pol34=%u p8f8=%llx fw_now918=%llx p920=%llx "
+		"meta784=%llx host_now=%llx stamp=%llx fw_counter_minus_stamp_us=%lld "
+		"host_minus_fw_counter_us=%lld r1=%s r1_1000=%08x r1_0=%08x end=gpuperf\n",
+		why, b->perf_seed_mode, b->perf_seed, b->perf_poweron,
+		g5p_dc_root_word(b, pol + 0), g5p_dc_root_word(b, pol + 4),
+		g5p_dc_root_word(b, pol + 8), g5p_dc_root_word(b, pol + 0xc),
+		g5p_dc_root_word(b, pol + 0x28),
+		g5p_dc_root_word(b, pol + 0x2c),
+		g5p_dc_root_word(b, pol + 0x30),
+		g5p_dc_root_word(b, pol + 0x34), p8f8, p918, p920, m784, host,
+		b->seed_stamp,
+		b->seed_stamp ?
+			div_s64((s64)(p918 - m784 - b->seed_stamp) * 1000000LL,
+				rate) :
+			0,
+		div_s64((s64)(host - (p918 - m784)) * 1000000LL, rate),
+		g5p_mmio_did(&t), t.gpc, t.r1_0);
+}
+
+static int g5p_r73c_fast_control(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	struct g5p_r73b *r = b->r73b;
+	int ret;
+
+	r->fast_release_ns = ktime_get_mono_fast_ns();
+	WRITE_ONCE(r->fast_window, true);
+	ret = g5p_boot_events(g);
+	r->fast_alive_ns = ktime_get_mono_fast_ns();
+	if (!ret)
+		ret = g5p_control_prepare(g);
+	if (!ret) {
+		r->fast_state = readl(g->window[1] + 0x1000);
+		ret = g5p_control_submit(g);
+	}
+	r->fast_submit_ns = ktime_get_mono_fast_ns();
+	r->fast_ret = ret;
+	WRITE_ONCE(r->fast_window, false);
+	g5p_r73b_events_exit(g, ret);
+	dev_info(
+		g->dev,
+		"R73C fast release_to_alive_ns=%llu release_to_submit_ns=%llu state=%08x ret=%d "
+		"control_submitted=%u end=r73c\n",
+		r->fast_alive_ns - r->fast_release_ns,
+		r->fast_submit_ns - r->fast_release_ns, r->fast_state, ret,
+		READ_ONCE(b->control_submitted));
+	g5p_perf_readback(g, ret ? "alive-timeout" : "alive");
+	return ret;
+}
+
+/* perf60 pin 200 (docs/gpu/experiments/perf60-clock.md "Pin 200: the guarded drain read" and
+ * "Clock-change drain RE" §4): at a boot control timeout with boot_gpu_perf set (before any job,
+ * the firmware alive), every read goes through the GPU register licence (mmio.inc) and nothing
+ * wakes the GPU (no R1+0x14 write, mmio-access.md G6):
+ *   r1:    R1 +0, +8, +0x14, +0x1000, +0x1004, +0x20000 (one R1-only ticket, any pstate)
+ *   drain: 11f00 688 1720 1728 e230 e238 e138, then the clock words R0+0x0/0x4/0x8/0xc
+ *   timer: R0+0x160/0x164, twice, 1 ms apart
+ *   tx:    T0/T1 TXENABLE/TXSTATUS (0x04800000/10, 0x04801000/10) through the META slave port
+ *   pc:    (bit 1 only) T0 PC: RQ 0x0480fff8 = 0x10005, poll bit 31, read 0x0480fff0; x8, 100 us
+ *          apart.  This is the driver's first slave-port write (CTRL0 = addr, DATAT = value).
+ * One ticket per group or slave-port op (<= G5P_MMIO_MAX_OPS), a refusal retried <= 2 ms.
+ */
+
+#define G5P_GPP_BUDGET_US 2000U
+
+/* One META slave-port read in one ticket: ready, CTRL0 = addr | 1, read back, ready (<= 4
+ * polls), DATAX: 8 ops.  -EBUSY when the port is not ready within the ticket.
+ */
+static int g5p_mmio_sp_read(struct g5p_diag *g, u32 addr, u32 *out, u32 *tries)
+{
+	struct g5p_mmio_ticket t;
+	u32 c1 = 0;
+	int ret;
+
+	if (!g5p_slave_access_allowed(READ_ONCE(g->reset_transition)))
+		return -EPERM;
+	ret = g5p_mmio_hold_wait(g, &t, 0, G5P_GPP_BUDGET_US, tries);
+	if (ret)
+		return ret;
+	ret = -EBUSY;
+	c1 = g5p_mmio_r0_read(g, &t, G5P_MSLVCTRL1);
+	if ((c1 & G5P_SP_READY) == G5P_SP_READY &&
+	    g5p_mmio_r0_write(g, &t, G5P_MSLVCTRL0, addr | 1)) {
+		g5p_mmio_r0_read(g, &t, G5P_MSLVCTRL0);
+		for (u32 i = 0; i < 4; i++) {
+			c1 = g5p_mmio_r0_read(g, &t, G5P_MSLVCTRL1);
+			if ((c1 & G5P_SP_READY) == G5P_SP_READY) {
+				*out = g5p_mmio_r0_read(g, &t, G5P_MSLVDATAX);
+				ret = 0;
+				break;
+			}
+		}
+	}
+	if (!g5p_mmio_release(g, &t) && !ret)
+		ret = -ESTALE;
+	return ret;
+}
+
+/* One META slave-port write in one ticket: ready, CTRL0 = addr, DATAT = value, ready (<= 4). */
+static int g5p_mmio_sp_write(struct g5p_diag *g, u32 addr, u32 value,
+			     u32 *tries)
+{
+	struct g5p_mmio_ticket t;
+	u32 c1;
+	int ret;
+
+	if (!g5p_slave_access_allowed(READ_ONCE(g->reset_transition)))
+		return -EPERM;
+	ret = g5p_mmio_hold_wait(g, &t, 0, G5P_GPP_BUDGET_US, tries);
+	if (ret)
+		return ret;
+	ret = -EBUSY;
+	c1 = g5p_mmio_r0_read(g, &t, G5P_MSLVCTRL1);
+	if ((c1 & G5P_SP_READY) == G5P_SP_READY &&
+	    g5p_mmio_r0_write(g, &t, G5P_MSLVCTRL0, addr) &&
+	    g5p_mmio_r0_write(g, &t, G5P_MSLVDATAT, value)) {
+		for (u32 i = 0; i < 4; i++) {
+			c1 = g5p_mmio_r0_read(g, &t, G5P_MSLVCTRL1);
+			if ((c1 & G5P_SP_READY) == G5P_SP_READY) {
+				ret = 0;
+				break;
+			}
+		}
+	}
+	g5p_mmio_release(g, &t);
+	return ret;
+}
+
+/* A group of plain R0 reads (<= G5P_MMIO_MAX_OPS) under one ticket; returns the ticket's did. */
+static const char *g5p_gpp_r0(struct g5p_diag *g, const u32 *off, u32 *v, u32 n,
+			      u32 *tries, u32 *gpc)
+{
+	struct g5p_mmio_ticket t;
+
+	if (g5p_mmio_hold_wait(g, &t, 0, G5P_GPP_BUDGET_US, tries)) {
+		*gpc = t.gpc;
+		return g5p_mmio_did(&t);
+	}
+	for (u32 i = 0; i < n; i++)
+		v[i] = g5p_mmio_r0_read(g, &t, off[i]);
+	g5p_mmio_release(g, &t);
+	*gpc = t.gpc;
+	g5p_mmio_sample_line(g, G5P_MMS_PROBE, &t, v, n, true);
+	return g5p_mmio_did(&t);
+}
+
+/* What a slave-port op's return means, for the dc-probe lines. */
+static const char *g5p_sp_why(int ret)
+{
+	switch (ret) {
+	case 0:
+		return "ok";
+	case -ENODATA:
+		return "not-run";
+	case -EPERM:
+		return "forbidden-after-release"; /* g->reset_transition: boot.inc's post-release ban */
+	case -ENODEV:
+		return "licence-off";
+	case -EAGAIN:
+		return "licence-refused";
+	case -EBUSY:
+		return "port-not-ready";
+	case -ESTALE:
+		return "stale";
+	case -ETIMEDOUT:
+		return "rq-no-ready";
+	default:
+		return "error";
+	}
+}
+
+static void g5p_gpu_perf_probe(struct g5p_diag *g)
+{
+	static const u32 drain[] = { 0x11f00, 0x688,  0x1720, 0x1728,
+				     0xe230,  0xe238, 0xe138 };
+	static const u32 clk[] = { 0x0, 0x4, 0x8, 0xc };
+	static const u32 timer[] = { 0x160, 0x164 };
+	static const u32 r1off[] = { 0x0, 0x8, 0x14, 0x1000, 0x1004, 0x20000 };
+	static const u32 tx[] = { 0x04800000, 0x04800010, 0x04801000,
+				  0x04801010 };
+	u32 mode = (0);
+	struct g5p_boot *b = g->boot;
+	u32 vd[ARRAY_SIZE(drain)], vc[ARRAY_SIZE(clk)], vt[2][2],
+		r1[ARRAY_SIZE(r1off)];
+	u32 vx[ARRAY_SIZE(tx)], pc[8], pcrq[8], gate = U32_MAX, tries = 0,
+						gpc = U32_MAX, gpc_x;
+	int txr[ARRAY_SIZE(tx)], pcr[8];
+	const char *d_r1 = "skip-guard", *d_drain = "skip-guard",
+		   *d_clk = "skip-guard";
+	const char *d_t0 = "skip-guard", *d_t1 = "skip-guard";
+	struct g5p_mmio_ticket t;
+
+	if (!mode || !b->gpu_perf)
+		return;
+	memset(vd, 0xff, sizeof(vd));
+	memset(vc, 0xff, sizeof(vc));
+	memset(vt, 0xff, sizeof(vt));
+	memset(r1, 0xff, sizeof(r1));
+	memset(vx, 0xff, sizeof(vx));
+	memset(pc, 0xff, sizeof(pc));
+	memset(pcrq, 0xff, sizeof(pcrq));
+	for (u32 i = 0; i < ARRAY_SIZE(txr); i++)
+		txr[i] = -ENODATA;
+	for (u32 i = 0; i < ARRAY_SIZE(pcr); i++)
+		pcr[i] = -ENODATA;
+	if (g->pmgr && regmap_read(g->pmgr, 0x80340, &gate))
+		gate = U32_MAX;
+	if (READ_ONCE(b->failed))
+		goto print;
+	/* r1: before anything else, R1-only (valid at any pstate and with bit 29 set) */
+	if (!g5p_mmio_hold(g, &t, G5P_MMIO_CENSUS)) {
+		for (u32 i = 0; i < ARRAY_SIZE(r1off); i++)
+			r1[i] = g5p_mmio_r1_read(g, &t, r1off[i]);
+		g5p_mmio_release(g, &t);
+	}
+	d_r1 = g5p_mmio_did(&t);
+	/* gpc: the drain group's licence read; every group's ticket also has its own sample line */
+	d_drain = g5p_gpp_r0(g, drain, vd, ARRAY_SIZE(drain), &tries, &gpc);
+	d_clk = g5p_gpp_r0(g, clk, vc, ARRAY_SIZE(clk), &tries, &gpc_x);
+	d_t0 = g5p_gpp_r0(g, timer, vt[0], 2, &tries, &gpc_x);
+	usleep_range(1000, 1100);
+	d_t1 = g5p_gpp_r0(g, timer, vt[1], 2, &tries, &gpc_x);
+	for (u32 i = 0; i < ARRAY_SIZE(tx); i++)
+		txr[i] = g5p_mmio_sp_read(g, tx[i], &vx[i], &tries);
+	if (mode & 2) {
+		for (u32 i = 0; i < ARRAY_SIZE(pc); i++) {
+			pcr[i] = g5p_mmio_sp_write(g, 0x0480fff8, 0x10005,
+						   &tries);
+			for (u32 k = 0; !pcr[i] && k < 4; k++) {
+				pcr[i] = g5p_mmio_sp_read(g, 0x0480fff8,
+							  &pcrq[i], &tries);
+				if (pcr[i] || (pcrq[i] & BIT(31)))
+					break;
+				udelay(10);
+			}
+			if (!pcr[i])
+				pcr[i] = pcrq[i] & BIT(31) ?
+						 g5p_mmio_sp_read(g, 0x0480fff0,
+								  &pc[i],
+								  &tries) :
+						 -ETIMEDOUT;
+			udelay(100);
+		}
+	}
+print:
+	dev_err(g->dev,
+		"GPUPERF dc-probe did=%s gate=%08x r1=%s r1_0=%08x r1_8=%08x r1_14=%08x "
+		"r1_1000=%08x r1_1004=%08x r1_20000=%08x gpc=%08x tries=%u end=gpuperf\n",
+		d_drain, gate, d_r1, r1[0], r1[1], r1[2], r1[3], r1[4], r1[5],
+		gpc, tries);
+	dev_err(g->dev,
+		"GPUPERF dc-probe drain=%s 11f00=%08x 688=%08x 1720=%08x 1728=%08x e230=%08x "
+		"e238=%08x e138=%08x clk=%s clk=%08x:%08x clkstat=%08x:%08x end=gpuperf\n",
+		d_drain, vd[0], vd[1], vd[2], vd[3], vd[4], vd[5], vd[6], d_clk,
+		vc[1], vc[0], vc[3], vc[2]);
+	dev_err(g->dev,
+		"GPUPERF dc-probe timer=%s/%s 160=%08x/%08x 164=%08x/%08x gap_us=1000 "
+		"txen0=%08x/%s txst0=%08x/%s txen1=%08x/%s txst1=%08x/%s end=gpuperf\n",
+		d_t0, d_t1, vt[0][0], vt[1][0], vt[0][1], vt[1][1], vx[0],
+		g5p_sp_why(txr[0]), vx[1], g5p_sp_why(txr[1]), vx[2],
+		g5p_sp_why(txr[2]), vx[3], g5p_sp_why(txr[3]));
+	if (mode & 2)
+		for (u32 i = 0; i < ARRAY_SIZE(pc); i++)
+			dev_err(g->dev,
+				"GPUPERF dc-probe pc i=%u ret=%s rq=%08x t0pc=%08x end=gpuperf\n",
+				i, g5p_sp_why(pcr[i]), pcrq[i], pc[i]);
+}
+
+static int g5p_control_wait(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	u32 *ctl = (u32 *)g5p_boot_shared(b, 0x6c);
+	unsigned long start = jiffies, deadline = start + 3 * HZ;
+	bool sampled = false, rekicked = false;
+	u32 consumer, producer, pass = 0;
+	int ret;
+
+	if (!b->control_submitted || b->control_complete)
+		return -EPERM;
+	do {
+		ret = g5p_r73b_service(g, G5P_R73B_OWNER_WAIT,
+				       g5p_r73b_sampled(++pass));
+		if (ret)
+			return ret;
+		consumer = READ_ONCE(ctl[0]);
+		producer = READ_ONCE(ctl[4]);
+		dma_rmb();
+		if (consumer > 255 || producer != b->control_target ||
+		    (consumer != b->control_target &&
+		     consumer != ((b->control_target - 1) & 255)))
+			return -EPROTO;
+		if (consumer == b->control_target) {
+			if (READ_ONCE(b->failed))
+				return -EIO;
+			if (g5p_r74_case(b) == 1) {
+				WRITE_ONCE(b->control_complete, true);
+				g5p_r74_mark(g, G5P_R74_CMD8_CONSUMED,
+					     consumer);
+				dev_emerg(
+					g->dev,
+					"R74B cmd8-consumed consumer=%u producer=%u IRQ174=%d ram_only=1 end=r74b\n",
+					consumer, producer,
+					atomic_read(&b->irqs));
+				g5p_np_policy(g, "cmd8-consumed", consumer, 0);
+				return 0;
+			}
+			g5p_dc_snapshot(g, "consumed", false);
+			b->control_complete = true;
+			;
+			dev_info(
+				g->dev,
+				"DC consumed cmd=8 consumer=%u producer=%u IRQ174=%d; transport only\n",
+				consumer, producer, atomic_read(&b->irqs));
+			return 0;
+		}
+		if (!sampled && !time_before(jiffies, start + HZ / 10)) {
+			sampled = true;
+			if (!g5p_r74b_ram_only(g))
+				g5p_dc_snapshot(g, "100ms", false);
+			g5p_np_policy(g, "100ms", consumer, 0);
+		}
+		if (7 == 3 && !rekicked && !time_before(jiffies, start + HZ)) {
+			/* Re-notify the SAME slot once; never publish a second command. */
+			if (READ_ONCE(b->failed))
+				return -EIO;
+			ret = g5p_prepare_kick(g, "DC re-kick");
+			if (ret)
+				return ret;
+			mb();
+			writel(0x10, g->rgx + 0xb00);
+			rekicked = true;
+			if (!g5p_r74b_ram_only(g))
+				g5p_dc_snapshot(g, "re-kick", false);
+		}
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, deadline));
+	if (!g5p_r74b_ram_only(g))
+		g5p_dc_snapshot(g, "timeout", false);
+	g5p_np_policy(g, "timeout", consumer, 0);
+	dev_err(g->dev,
+		"DC timeout consumer=%u producer=%u target=%u; retain RAM, no retry\n",
+		consumer, producer, b->control_target);
+	/* perf60 (boot_gpu_perf): the policy-state words at the stall, RAM only.  pol34 = the pstate the
+	 * firmware last requested (its setter stores it before the Fender write): q means it reached the
+	 * setter, 1 that it stopped before (the clock-change drain 0x1001cec8 -> 0x1001b638).
+	 */
+	if (b->gpu_perf) {
+		u32 pol = b->layout.offset[0x4a];
+
+		dma_rmb();
+		dev_err(g->dev,
+			"GPUPERF dc-timeout pin=%u pol8=%u/%u q=%u x=%u pol34=%u req=%u/%u ceil=%u/%u "
+			"seed=%u pol0=%u pol4=%u pol28=%u pol2c=%u pol30=%u end=gpuperf\n",
+			b->gpu_perf, g5p_dc_root_word(b, pol + 8),
+			g5p_dc_root_word(b, pol + 0xc),
+			g5p_dc_root_word(b, pol + 0x28),
+			g5p_dc_root_word(b, pol + 0x38),
+			g5p_dc_root_word(b, pol + 0x34),
+			g5p_dc_root_word(b, pol + 0x6f0),
+			g5p_dc_root_word(b, pol + 0x6f4),
+			g5p_dc_root_word(b, pol + 0x688),
+			g5p_dc_root_word(b, pol + 0x68c), b->perf_seed,
+			g5p_dc_root_word(b, pol + 0),
+			g5p_dc_root_word(b, pol + 4),
+			g5p_dc_root_word(b, pol + 0x28),
+			g5p_dc_root_word(b, pol + 0x2c),
+			g5p_dc_root_word(b, pol + 0x30));
+		g5p_gpu_perf_probe(g);
+		g5p_perf_readback(g, "dc-timeout");
+	}
+	if (READ_ONCE(b->failed))
+		return -EIO;
+	b->control_timed_out = true;
+	return -ETIMEDOUT;
+}
+
+static int g5p_irq_test(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	unsigned long deadline = jiffies + HZ / 10;
+	int before = atomic_read(&b->irqs), ret;
+
+	if (b->irq_tested || !b->irq_ready || g5p_r74_case(b))
+		return -EPERM;
+	/* ADT set/ack addresses, not a GPU slave-port transaction. Firmware may
+	 * also interrupt concurrently: this tests delivery, not event provenance.
+	 */
+	dev_info(g->dev, "IRQ test baseline=%d W AIC+014=00004000\n", before);
+	writel(0x4000, b->swirq + 0x14);
+	do {
+		if (READ_ONCE(b->failed))
+			return -EIO;
+		if (atomic_read(&b->irqs) > before) {
+			ret = g5p_boot_drain(g);
+			if (ret)
+				return ret;
+			b->irq_tested = true;
+			;
+			dev_info(
+				g->dev,
+				"IRQ delivery observed before=%d after=%d; no shader completion implied\n",
+				before, atomic_read(&b->irqs));
+			return 0;
+		}
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, deadline));
+	dev_err(g->dev, "IRQ delivery timeout before=%d after=%d\n", before,
+		atomic_read(&b->irqs));
+	return -ETIMEDOUT;
+}
+
+static int g5p_boot_park(struct g5p_diag *g)
+{
+	struct g5p_boot *b = g->boot;
+	const struct g5p_fender_io io = {
+		.ctx = g,
+		.write = g5p_fender_write,
+		.poll = g5p_fender_poll,
+	};
+	static const u32 slots[] = { 0x60, 0x64, 0x68, 0x6c, 0x70 };
+	bool failed_control = READ_ONCE(b->failed) && b->control_timed_out;
+	bool failed_work = READ_ONCE(b->failed) && b->work_timed_out;
+	bool failed_context = READ_ONCE(b->failed) && b->context_timed_out;
+	bool failed_timeout = failed_control || failed_work || failed_context;
+	int ret;
+
+	if (b->r73b)
+		g5p_r73b_disarm(b->r73b);
+	if (READ_ONCE(b->event_failed) ||
+	    (b->control_submitted && !b->control_complete && !failed_control) ||
+	    (b->work_submitted && !b->work_complete && !failed_work) ||
+	    (b->context_submitted && !b->context_complete && !failed_context))
+		return -EBUSY;
+	/* A failed drain must never be bypassed. On the sole permitted failure
+	 * path require the event ring empty below without consuming anything.
+	 */
+	if (!failed_timeout) {
+		ret = g5p_boot_drain(g);
+		if (ret)
+			return ret;
+	}
+	for (u32 i = 0; i < ARRAY_SIZE(slots); i++) {
+		u32 *ctl = (u32 *)g5p_boot_shared(b, slots[i]);
+		u32 consumer = READ_ONCE(ctl[0]), producer = READ_ONCE(ctl[4]);
+
+		if (consumer > 255 || producer > 255)
+			return -EPROTO;
+		if (((failed_control || failed_context) && slots[i] == 0x6c) ||
+		    (failed_work && slots[i] == 0x68)) {
+			u32 target = failed_context && slots[i] == 0x6c ?
+					     b->context_target :
+				     slots[i] == 0x6c ? b->control_target :
+							b->work_target;
+
+			if (producer != target ||
+			    (consumer != producer &&
+			     consumer != ((producer - 1) & 255)))
+				return -EPROTO;
+		} else if (consumer != producer) {
+			return -EBUSY;
+		}
+	}
+	if (READ_ONCE(b->event_failed))
+		return -EIO;
+	if (failed_timeout)
+		dev_info(
+			g->dev,
+			"PARK failed %s timeout; abandon command, preserve failure and RAM\n",
+			failed_context ? "CONTEXT" :
+			failed_work    ? "CL" :
+					 "DC");
+	/* Freeze commands before the first transition; no retry even if it fails.
+	 * c9fa10 enabled-Fender branch: core=0, GPC=0, no a18 access.
+	 */
+	WRITE_ONCE(b->stopped, true);
+	WRITE_ONCE(b->alive, false);
+	dev_info(
+		g->dev,
+		"PARK begin core=0 GPC=0; wrapper only, DMA memory retained\n");
+	ret = g5p_fender_idle(&io);
+	if (ret)
+		return ret;
+	/* Keep the IRQ/ack handler and every allocation alive until reboot.
+	 * GPC=0 alone is not proof that outstanding bus traffic has drained.
+	 */
+	b->parked = true;
+	dev_info(
+		g->dev,
+		"PARK GPC=0 verified; quarantine until reboot, no PMGR off or DMA free\n");
+	return 0;
+}
+
+static int g5p_lifecycle_command(struct g5p_diag *g, const char *command)
+{
+	struct g5p_boot *b = g->boot;
+	int ret;
+
+	if (!boot_experiment || !b || !b->alive || b->stopped)
+		return -EPERM;
+	if (b->failed &&
+	    !(sysfs_streq(command, "park") && teardown_experiment &&
+	      (b->control_timed_out || b->work_timed_out ||
+	       b->context_timed_out)))
+		return -EPERM;
+	if (!strncmp(command, "control-", 8) && control_experiment) {
+		if (sysfs_streq(command, "control-prepare"))
+			ret = g5p_control_prepare(g);
+		else if (sysfs_streq(command, "control-submit"))
+			ret = g5p_control_submit(g);
+		else if (sysfs_streq(command, "control-wait"))
+			ret = g5p_control_wait(g);
+		else
+			return -EINVAL;
+	} else if (sysfs_streq(command, "irq-test") &&
+		   (g5p_r74_case(b) || (1))) {
+		/* R74 never runs the AIC self-test r73f case 01 stopped in. */
+		if (b->r73b)
+			atomic_inc(&b->r73b->r74_irq_refused);
+		g5p_r74_mark(g, G5P_R74_IRQ_TEST_REFUSED, -EPERM);
+		dev_err(g->dev,
+			"R74 refuse irq-test case=%u irq_tested=%u end=r74\n",
+			g5p_r74_case(b), b->irq_tested);
+		return -EPERM;
+	} else if (sysfs_streq(command, "irq-test") && irq_experiment) {
+		ret = g5p_irq_test(g);
+	} else if (sysfs_streq(command, "park") && teardown_experiment) {
+		ret = g5p_boot_park(g);
+	} else {
+		return -EPERM;
+	}
+	if (sysfs_streq(command, "control-wait"))
+		g5p_r73b_crumb(b, G5P_R73B_WAIT_EXIT, G5P_R73B_OWNER_WAIT, ret);
+	if (ret && ret != -EALREADY && ret != -EPERM)
+		WRITE_ONCE(b->failed, true);
+	return ret;
+}
+
+/* Outgoing-side kexec/reboot quiesce; see docs/gpu/experiments/gpu-reset-recovery-production.md
+ * section 6.10. NOT a reset: Fender core=0/GPC=0 only, no PMGR off, no DMA free and
+ * no R0 access. It acts only when the command lock is free (no job or sysfs command is
+ * inside a hardware wait), the firmware was released and the pstate policy is
+ * host-owned (init meta+0x6c8 == 0); every other state is left alone. Unlike
+ * g5p_boot_park() it does not require drained rings: round 10 flew park after an
+ * unconsumed DC command, and at shutdown there is nothing left to drain for.
+ * GPC=0 is not a proof that bus traffic drained (see g5p_boot_park).
+ */
+
+static void g5p_td_shutdown(struct g5p_diag *g);
+
+static void g5p_shutdown(struct platform_device *pdev)
+{
+	struct g5p_diag *g = platform_get_drvdata(pdev);
+	const struct g5p_fender_io io = {
+		.ctx = g,
+		.write = g5p_fender_write,
+		.poll = g5p_fender_poll,
+	};
+	struct g5p_boot *b;
+	int ret;
+
+	if (!g)
+		return;
+	/* Idempotent second chance after the reboot notifier; a no-op unless teardown != 0. */
+	g5p_td_shutdown(g);
+	{
+		return;
+	};
+	/* A worker or sysfs writer stuck in MMIO holds g->lock: never queue behind it. */
+	if (!mutex_trylock(&g->lock)) {
+		dev_warn(g->dev, "SHUTDOWN park skipped: command lock busy\n");
+		return;
+	}
+	b = g->boot;
+	/* R1 is touched only with ps_gfx held on (the retained runtime-PM reference),
+	 * the wrapper woken and the firmware released.
+	 */
+	if (!b || !g->powered || !g->fender_ready || !b->maps_ready ||
+	    !b->released || b->stopped || b->parked) {
+		dev_info(g->dev, "SHUTDOWN park not needed\n");
+		goto out;
+	}
+	/* With firmware-owned policy (init meta+0x6c8 != 0) the firmware also writes
+	 * R1+0x1000, so a host write would race it (dsx-r74b). RAM-only read of the
+	 * host-written init word, the same one g5p_dc_snapshot() reports.
+	 */
+	if (g5p_dc_root_word(b, b->layout.offset[0x4d] + 0x6c8)) {
+		dev_info(
+			g->dev,
+			"SHUTDOWN park refused: firmware-owned policy (meta+0x6c8 != 0)\n");
+		goto out;
+	}
+	if (b->r73b)
+		g5p_r73b_disarm(b->r73b);
+	/* Freeze commands before the first transition; no retry even if it fails. */
+	WRITE_ONCE(b->stopped, true);
+	WRITE_ONCE(b->alive, false);
+	ret = g5p_fender_idle(&io);
+	if (!ret)
+		WRITE_ONCE(b->parked, true);
+	dev_info(
+		g->dev,
+		"SHUTDOWN park core=0 GPC=0 result=%d; DMA memory retained, no PMGR off\n",
+		ret);
+out:
+	mutex_unlock(&g->lock);
+}
diff --git a/drivers/gpu/apple-g5p/meta71c114.h b/drivers/gpu/apple-g5p/meta71c114.h
new file mode 100644
index 000000000..cc84dbd82
--- /dev/null
+++ b/drivers/gpu/apple-g5p/meta71c114.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Latency114: one RAM dword, meta+0x71c, in the bootstrap image.
+ *
+ * meta (object 0x4d) +0x718 is the firmware's pstate frequency table in MHz.
+ * Its init copies the table to private+0x26c at boot (MINIM 0x1000122c..127c),
+ * and the scheduler loop reloads its timer from entry 1 on both branches
+ * (0x8000a1a4 via private+0x2c4 at pstate 1, 0x8000a338 via private+0x270).
+ * Linux leaves the table zero; Apple has { 0, 340, 474, 550, 723 }.  The A/B
+ * installs entry 1 only: 0 is the control (nothing is stored, variant 7 leaves
+ * the word zero), 340 the factor.  Everything else is refused at map, before
+ * any store.  The store goes into the staging buffer, before g5p_boot_copy()
+ * publishes the image and long before the firmware is released.  There is no
+ * register access here.
+ */
+#ifndef APPLE_G5P_META71C114_H
+#define APPLE_G5P_META71C114_H
+
+#define G5P_M71C_SLOT 0x4dU
+#define G5P_M71C_OFFSET 0x71cU
+#define G5P_M71C_CONTROL 0U
+#define G5P_M71C_FACTOR 340U
+#define G5P_M71C_VARIANT 7U
+
+enum {
+	G5P_M71C_OK,
+	G5P_M71C_BAD_VALUE,
+	G5P_M71C_BAD_VARIANT,
+	G5P_M71C_WHYS,
+};
+
+static const char *const g5p_m71c_whys[G5P_M71C_WHYS] = {
+	"none",
+	"value",
+	"variant",
+};
+
+/* Latched at map: only the two pre-registered arms, the factor on dc7 only. */
+static inline u32 g5p_m71c_check(u32 requested, u32 variant)
+{
+	if (requested != G5P_M71C_CONTROL && requested != G5P_M71C_FACTOR)
+		return G5P_M71C_BAD_VALUE;
+	if (requested == G5P_M71C_FACTOR && variant != G5P_M71C_VARIANT)
+		return G5P_M71C_BAD_VARIANT;
+	return G5P_M71C_OK;
+}
+
+/*
+ * One store into the staging image (the factor only) and its read-back.  The
+ * caller fails the map unless the read-back equals the request.
+ */
+static inline u32 g5p_m71c_install(const struct g5p_boot_layout *p, u8 *root,
+				   u8 *shared, u32 requested, bool *wrote)
+{
+	u8 *word = g5p_object(p, root, shared, G5P_M71C_SLOT) + G5P_M71C_OFFSET;
+
+	*wrote = false;
+	if (requested == G5P_M71C_FACTOR) {
+		g5p_put32(word, requested);
+		*wrote = true;
+	}
+	return g5p_le32(word);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/mmio-licence.h b/drivers/gpu/apple-g5p/mmio-licence.h
new file mode 100644
index 000000000..d9d23ca2a
--- /dev/null
+++ b/drivers/gpu/apple-g5p/mmio-licence.h
@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The GPU register licence (docs/gpu/experiments/mmio-access.md §4), pure so the host test
+ * (scripts/gpu/perf60-host/test_mmio.c) drives the same code.  iOS's
+ * AGXMetaFirmware_isGPURegisterAccessible (fffffff006ca10ec) licenses an R0 access when PMGR gfx
+ * is on and the wrapper is up (fender+0xc), R1+0 bit 29 is clear (the firmware's power-down /
+ * clock-change routine 0x1001cec8 raises it before the GPC goes to 0) and the GPC pstate nibble is
+ * 1..meta+0x710.  We are stricter: R1+0x1000 bit 4 (a transition in flight) must be clear and
+ * R1+0 == 0 (a dead wrapper, Apple's ca05d4 vt+0x70 branch) refuses too.
+ *
+ * Order, and nothing else touches the bus: the RAM terms (no MMIO when any fails), then R1+0, then
+ * R1+0x1000, then at most G5P_MMIO_MAX_OPS R0 accesses, then R1+0x1000 and R1+0 again at release
+ * to account a sample whose licence changed under it (stale: data loss, not exclusion).
+ * A refusal never waits and never wakes (no R1+0x14 write): the caller decides whether to retry.
+ */
+#ifndef G5P_MMIO_LICENCE_H
+#define G5P_MMIO_LICENCE_H
+
+#include "bits-compat.h"
+
+#define G5P_MMIO_MAX_OPS 8U /* R0 accesses per ticket */
+#define G5P_MMIO_R1_CTRL \
+	0x0U /* R1+0: bit 29 = firmware power-down in progress */
+#define G5P_MMIO_R1_GPC \
+	0x1000U /* R1+0x1000: bit 4 transition, nibble = pstate */
+#define G5P_MMIO_BIT29 BIT(29)
+
+enum g5p_mmio_why {
+	G5P_MMIO_OK,
+	G5P_MMIO_OFF, /* RAM: power epoch not readable (no MMIO done) -> -ENODEV */
+	G5P_MMIO_BUSY, /* the lock was held (try mode, IRQ census) -> -EAGAIN, no MMIO */
+	G5P_MMIO_DEAD, /* R1+0 == 0 */
+	G5P_MMIO_FWOFF, /* R1+0 bit 29 */
+	G5P_MMIO_TRANS, /* R1+0x1000 bit 4 */
+	G5P_MMIO_PARKED, /* nibble 0 */
+	G5P_MMIO_OVERMAX, /* nibble > max pstate */
+	G5P_MMIO_PARKEPOCH, /* R0 in a park epoch (g5p_mmio_r0_regime_ok) */
+	G5P_MMIO_NR,
+};
+
+static const char *const g5p_mmio_why_names[G5P_MMIO_NR] = {
+	"read",	       "skip-off",     "skip-busy",
+	"skip-dead",   "skip-bit29",   "skip-transition",
+	"skip-parked", "skip-overmax", "skip-park-epoch",
+};
+
+/* The RAM preconditions (§4.2 step 2).  b->failed is deliberately not one: the fault read runs
+ * after it latches, as Apple's does.
+ */
+struct g5p_mmio_ram {
+	bool powered, fender_ready, mmio_off, have_boot, released, stopped;
+};
+
+static inline bool g5p_mmio_ram_ok(const struct g5p_mmio_ram *r)
+{
+	return r->powered && r->fender_ready && !r->mmio_off && r->have_boot &&
+	       r->released && !r->stopped;
+}
+
+static inline enum g5p_mmio_why g5p_mmio_check_r1_0(u32 r1_0)
+{
+	if (!r1_0)
+		return G5P_MMIO_DEAD;
+	if (r1_0 & G5P_MMIO_BIT29)
+		return G5P_MMIO_FWOFF;
+	return G5P_MMIO_OK;
+}
+
+static inline enum g5p_mmio_why g5p_mmio_check_gpc(u32 gpc, u32 max)
+{
+	if (gpc & 0x10)
+		return G5P_MMIO_TRANS;
+	if (!(gpc & 0xf))
+		return G5P_MMIO_PARKED;
+	if ((gpc & 0xf) > max)
+		return G5P_MMIO_OVERMAX;
+	return G5P_MMIO_OK;
+}
+
+/*
+ * R0 only where the firmware cannot park under it.  The governor's park does not raise R1+0
+ * bit 29 (mmio-access.md §2.3: only the power-down routine 0x1001cec8 does, a few calls before it
+ * drops the GPC), so against a park the licence's R1 checks are a race: a check that passes can be
+ * followed by the GPC going to 0 before the R0 load.  The never-park envelope (boot_gpu_perf >=
+ * 100, latched at map: the policy writer's x >= 100, q >= 1, the governor never selects pstate 0)
+ * has no such window; at pin 400/500 the 3D-completion and clock samples saw bit 29 0 times, while
+ * the park tuple's rung 5 (2026-11-03) saw it on 749 of 983 3D completions and then froze the SoC.
+ * iOS reads R0 only at a fault event, never at idle.  `override` = mmio_r0_park (DFU-class rungs
+ * only).
+ */
+static inline bool g5p_mmio_r0_regime_ok(u32 gpu_perf, bool override)
+{
+	return override || gpu_perf >= 100;
+}
+
+/*
+ * meta+0x710 as written into the boot image; 0 (no table) means the firmware stays at pstate 1.
+ */
+static inline u32 g5p_mmio_max_pstate(u32 meta710)
+{
+	return meta710 < 1 ? 1 : meta710 > 15 ? 15 : meta710;
+}
+
+typedef u32 (*g5p_mmio_rd_t)(void *ctx, u32 off);
+
+/* §4.2 steps 2-4 under the caller's lock: no bus access unless the RAM terms pass, R1+0 before
+ * R1+0x1000, nothing after a refusal.  *r1_0 / *gpc stay U32_MAX when not read.
+ */
+static inline enum g5p_mmio_why g5p_mmio_licence(const struct g5p_mmio_ram *ram,
+						 u32 max, g5p_mmio_rd_t rd,
+						 void *ctx, u32 *r1_0, u32 *gpc)
+{
+	enum g5p_mmio_why why;
+
+	*r1_0 = 0xffffffffU;
+	*gpc = 0xffffffffU;
+	if (!g5p_mmio_ram_ok(ram))
+		return G5P_MMIO_OFF;
+	*r1_0 = rd(ctx, G5P_MMIO_R1_CTRL);
+	why = g5p_mmio_check_r1_0(*r1_0);
+	if (why)
+		return why;
+	*gpc = rd(ctx, G5P_MMIO_R1_GPC);
+	return g5p_mmio_check_gpc(*gpc, max);
+}
+
+/* An R0 op is allowed while ops < G5P_MMIO_MAX_OPS; the counter counts refusals too. */
+static inline bool g5p_mmio_op_take(u32 *ops)
+{
+	return (*ops)++ < G5P_MMIO_MAX_OPS;
+}
+
+/* §4.3 release: the licence fields (nibble, bit 4, bit 29) unchanged and still licensing. */
+static inline bool g5p_mmio_stale(u32 r1_0, u32 gpc, u32 r1_0_end, u32 gpc_end,
+				  u32 max)
+{
+	if ((gpc & 0x1f) != (gpc_end & 0x1f) ||
+	    (r1_0 & G5P_MMIO_BIT29) != (r1_0_end & G5P_MMIO_BIT29))
+		return true;
+	return g5p_mmio_check_r1_0(r1_0_end) ||
+	       g5p_mmio_check_gpc(gpc_end, max);
+}
+
+/* mmio_selftest rung 3/5 expectations: CORE_REVISION and CORE_ID as read at bring-up. */
+#define G5P_MMIO_EXPECT_20 0x00090f00U
+#define G5P_MMIO_EXPECT_18 0x011b0602U
+
+#endif
diff --git a/drivers/gpu/apple-g5p/mmio.inc b/drivers/gpu/apple-g5p/mmio.inc
new file mode 100644
index 000000000..b8c25bd8d
--- /dev/null
+++ b/drivers/gpu/apple-g5p/mmio.inc
@@ -0,0 +1,295 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The one GPU register accessor (docs/gpu/experiments/mmio-access.md §4), Apple's licence from
+ * AGXMetaFirmware_isGPURegisterAccessible (mmio-licence.h) under g->mmio_lock:
+ *
+ *   if (!g5p_mmio_hold(g, &t, 0)) {
+ *           v = g5p_mmio_r0_read(g, &t, off);	// <= G5P_MMIO_MAX_OPS, nothing else in between
+ *           g5p_mmio_release(g, &t);		// false: the licence changed under the sample
+ *   }
+ *
+ * hold takes mmio_lock with IRQs off and returns with it held on success.  It refuses instead of
+ * waiting and never wakes the GPU (no R1+0x14 write): -ENODEV when the power epoch is not
+ * readable (RAM only, no MMIO done), -EAGAIN when parked, bit 29, in transition, above the
+ * pstate table, or (G5P_MMIO_TRY) when the lock is taken; -EPERM for an R0 ticket in an epoch
+ * the firmware may park (boot_gpu_perf < 100, unless mmio_r0_park).  Callable from hard IRQ,
+ * threaded IRQ and process context, inside event_lock and g->lock.  Between hold and release: no
+ * printk, no other MMIO, no sleep, no allocation.
+ *
+ * mmio_selftest (0600, default 0, live) drives the proof rungs of §6:
+ *   bit 0  rung 1/1b: 1 kHz hrtimer census, R1+0 and R1+0x1000 only (no R0)
+ *   bit 1  rung 3/4:  every 100 ms hold -> R0+0x20, R0+0x18 -> release (DFU-risk with parks: rung 4)
+ *   bit 2  rung 5:    the same at every 3D completion decision (drm side; DFU-risk, park tuple)
+ *   bit 3  idle check: after 5, 30 and 120 s with no job, the PMGR gfx word, then (gfx on only)
+ *          R1+0x1000 and R1+0; never R0
+ * Lines: GPU-MMIO sample (per sample, at most one per source per second unless the outcome
+ * changes or the sample is stale/bad), GPU-MMIO idle, GPU-MMIO stats (every 10 s while on and
+ * once when it goes back to 0).
+ */
+#define G5P_MMIO_TRY \
+	BIT(0) /* trylock: refuse busy instead of spinning (the IRQ census) */
+/* An R1-only ticket, counted in the census class: held whenever the RAM terms pass (R1 is
+ * readable while PMGR gfx is on, mmio-access.md §1.3), R1+0 and R1+0x1000 both read even when the
+ * licence refuses; R0 only if the licence passed (t->r0_ok).
+ */
+#define G5P_MMIO_CENSUS BIT(1)
+
+struct g5p_mmio_ticket {
+	u32 r1_0, gpc, r1_0_end, gpc_end, flags, ops;
+	u64 t_ns, t_end_ns;
+	unsigned long irq;
+	enum g5p_mmio_why why;
+	bool held, stale, r0_ok;
+};
+
+enum {
+	G5P_MMS_CENSUS,
+	G5P_MMS_IDLE,
+	G5P_MMS_3D,
+	G5P_MMS_FAULT,
+	G5P_MMS_PROBE,
+	G5P_MMS_NR
+};
+static const char *const g5p_mms_names[G5P_MMS_NR] = {
+	"census", "idle-100ms", "3d-done", "fault-read", "dc-probe",
+};
+
+#define G5P_MMIO_RING 32
+struct g5p_mmio_rec {
+	u64 t_ns;
+	u32 r1_0, gpc, us;
+	u8 why, stale;
+};
+
+struct g5p_mmio_self {
+	struct g5p_diag *g;
+	struct hrtimer timer;
+	struct delayed_work work;
+	bool census_on, was_on;
+	u64 stats_ns;
+	/* counters: [0] R1-only census tickets, [1] R0 tickets */
+	atomic_t n[2][G5P_MMIO_NR];
+	atomic_t stale[2], r0_ops, bad;
+	/* census transitions, written by the hrtimer, drained by the work */
+	spinlock_t ring_lock;
+	struct g5p_mmio_rec ring[G5P_MMIO_RING];
+	u32 ring_head, ring_tail, ring_drop;
+	struct g5p_mmio_rec census_last;
+	u8 census_prev_why, census_prev_stale;
+	/* per-source print limiter */
+	u64 printed_ns[G5P_MMS_NR];
+	u8 printed_why[G5P_MMS_NR];
+	/* idle check */
+	u64 job_ns;
+	u32 idle_done;
+	/* bit 4, the GPU clock: per Fender pstate nibble, the highest rate seen and the sample counts */
+	u32 clk_max_khz[16], clk_cr_khz[16], clk_n[16], clk_busy[16], clk_reset;
+	u64 clk_printed_ns;
+};
+
+/* mmio_selftest bit 4: the gap between the two tickets of one clock sample */
+
+/* R0 tickets in a park epoch (boot_gpu_perf < 100): refused unless 1 (g5p_mmio_r0_regime_ok). */
+
+static u32 g5p_mmio_rd_r1(void *ctx, u32 off)
+{
+	return readl((void __iomem *)ctx + off);
+}
+
+static void g5p_mmio_count(struct g5p_diag *g, const struct g5p_mmio_ticket *t)
+{
+	struct g5p_mmio_self *s = READ_ONCE(g->mmio_self);
+	u32 cls = t->flags & G5P_MMIO_CENSUS ? 0 : 1;
+
+	if (!s)
+		return;
+	atomic_inc(&s->n[cls][t->why]);
+	if (t->stale)
+		atomic_inc(&s->stale[cls]);
+	if (t->ops && cls)
+		atomic_add(min_t(u32, t->ops, G5P_MMIO_MAX_OPS), &s->r0_ops);
+}
+
+static int g5p_mmio_hold(struct g5p_diag *g, struct g5p_mmio_ticket *t,
+			 unsigned int flags)
+{
+	struct g5p_mmio_ram ram = { 0 };
+	struct g5p_boot *b;
+	unsigned long irq;
+
+	memset(t, 0, sizeof(*t));
+	t->flags = flags;
+	t->r1_0 = t->gpc = t->r1_0_end = t->gpc_end = U32_MAX;
+	if (flags & G5P_MMIO_TRY) {
+		if (!spin_trylock_irqsave(&g->mmio_lock, irq)) {
+			t->why = G5P_MMIO_BUSY;
+			goto refused;
+		}
+	} else {
+		spin_lock_irqsave(&g->mmio_lock, irq);
+	}
+	t->t_ns = ktime_get_mono_fast_ns();
+	ram.mmio_off = g->mmio_off;
+	ram.powered = READ_ONCE(g->powered);
+	ram.fender_ready = READ_ONCE(g->fender_ready);
+	/* mmio_off first: a boot struct behind a gate is never dereferenced */
+	b = ram.mmio_off ? NULL : READ_ONCE(g->boot);
+	if (b) {
+		ram.have_boot = true;
+		ram.released = READ_ONCE(b->released);
+		ram.stopped = READ_ONCE(b->stopped);
+	}
+	/* before any bus access: an R0 ticket in a park epoch is refused outright */
+	if (!(flags & G5P_MMIO_CENSUS) && b &&
+	    !g5p_mmio_r0_regime_ok(b->gpu_perf, (0))) {
+		t->why = G5P_MMIO_PARKEPOCH;
+		t->t_end_ns = ktime_get_mono_fast_ns();
+		spin_unlock_irqrestore(&g->mmio_lock, irq);
+		goto refused;
+	}
+	t->why = g5p_mmio_licence(&ram, READ_ONCE(g->mmio_max_pstate),
+				  g5p_mmio_rd_r1, g->window[1], &t->r1_0,
+				  &t->gpc);
+	if (t->why && (!(flags & G5P_MMIO_CENSUS) || t->why == G5P_MMIO_OFF)) {
+		t->t_end_ns = ktime_get_mono_fast_ns();
+		spin_unlock_irqrestore(&g->mmio_lock, irq);
+		goto refused;
+	}
+	if (t->gpc == U32_MAX)
+		t->gpc = readl(
+			g->window[1] +
+			G5P_MMIO_R1_GPC); /* census: after an R1+0 refusal */
+	t->r0_ok = !t->why;
+	t->irq = irq;
+	t->held = true;
+	return 0;
+refused:
+	g5p_mmio_count(g, t);
+	/* a park epoch does not change by waiting: -EPERM, never retried (g5p_mmio_hold_wait) */
+	return t->why == G5P_MMIO_OFF	    ? -ENODEV :
+	       t->why == G5P_MMIO_PARKEPOCH ? -EPERM :
+					      -EAGAIN;
+}
+
+/* Only between a successful hold and its release; past G5P_MMIO_MAX_OPS no bus access. */
+static u32 g5p_mmio_r0_read(struct g5p_diag *g, struct g5p_mmio_ticket *t,
+			    u32 off)
+{
+	if (!t->held || !t->r0_ok || !g5p_mmio_op_take(&t->ops))
+		return U32_MAX;
+	return readl(g->rgx + off);
+}
+
+/* R0 writes count as ops too (the slave-port request words of the pin-200 probe). */
+static bool g5p_mmio_r0_write(struct g5p_diag *g, struct g5p_mmio_ticket *t,
+			      u32 off, u32 v)
+{
+	if (!t->held || !t->r0_ok || !g5p_mmio_op_take(&t->ops))
+		return false;
+	writel(v, g->rgx + off);
+	return true;
+}
+
+/* Any R1 word under a held ticket (census or licensed); counts as an op. */
+static u32 g5p_mmio_r1_read(struct g5p_diag *g, struct g5p_mmio_ticket *t,
+			    u32 off)
+{
+	if (!t->held || !g5p_mmio_op_take(&t->ops))
+		return U32_MAX;
+	return readl(g->window[1] + off);
+}
+
+/* Process context: refusals (-EAGAIN) retried outside the lock every 20-40 us, <= budget_us. */
+static int g5p_mmio_hold_wait(struct g5p_diag *g, struct g5p_mmio_ticket *t,
+			      unsigned int flags, u32 budget_us, u32 *tries)
+{
+	u64 t0 = ktime_get_mono_fast_ns();
+	int ret;
+
+	might_sleep();
+	for (;;) {
+		(*tries)++;
+		ret = g5p_mmio_hold(g, t, flags);
+		if (ret != -EAGAIN || ktime_get_mono_fast_ns() - t0 >=
+					      (u64)budget_us * NSEC_PER_USEC)
+			return ret;
+		usleep_range(20, 40);
+	}
+}
+
+static bool g5p_mmio_release(struct g5p_diag *g, struct g5p_mmio_ticket *t)
+{
+	if (!t->held)
+		return false;
+	t->gpc_end = readl(g->window[1] + G5P_MMIO_R1_GPC);
+	t->r1_0_end = readl(g->window[1] + G5P_MMIO_R1_CTRL);
+	t->stale = t->r0_ok &&
+		   g5p_mmio_stale(t->r1_0, t->gpc, t->r1_0_end, t->gpc_end,
+				  READ_ONCE(g->mmio_max_pstate));
+	t->t_end_ns = ktime_get_mono_fast_ns();
+	t->held = false;
+	spin_unlock_irqrestore(&g->mmio_lock, t->irq);
+	g5p_mmio_count(g, t);
+	return !t->stale;
+}
+
+static const char *g5p_mmio_did(const struct g5p_mmio_ticket *t)
+{
+	return t->stale ? "stale" : g5p_mmio_why_names[t->why];
+}
+
+static u32 g5p_mmio_us(const struct g5p_mmio_ticket *t)
+{
+	return t->t_end_ns > t->t_ns ?
+		       (u32)div_u64(t->t_end_ns - t->t_ns, NSEC_PER_USEC) :
+		       0;
+}
+
+/* The per-sample line, after release.  force: print regardless of the per-source limiter. */
+static void g5p_mmio_sample_line(struct g5p_diag *g, u32 src,
+				 const struct g5p_mmio_ticket *t, u32 *v,
+				 u32 nv, bool force)
+{
+	struct g5p_mmio_self *s = g->mmio_self;
+	u64 now = ktime_get_mono_fast_ns();
+	char vs[9 * G5P_MMIO_MAX_OPS + 1] = "-";
+	u32 len = 0;
+
+	if (s && !force && !t->stale && s->printed_why[src] == t->why &&
+	    now - s->printed_ns[src] < NSEC_PER_SEC)
+		return;
+	if (s) {
+		s->printed_ns[src] = now;
+		s->printed_why[src] = t->why;
+	}
+	for (u32 i = 0; i < nv && i < G5P_MMIO_MAX_OPS; i++)
+		len += scnprintf(vs + len, sizeof(vs) - len, "%s%08x",
+				 i ? "," : "", v[i]);
+	dev_info(
+		g->dev,
+		"GPU-MMIO sample why=%s did=%s r1_0=%08x gpc=%08x r1_0_end=%08x gpc_end=%08x "
+		"max=%u v=%s us=%u end=mmio\n",
+		g5p_mms_names[src], g5p_mmio_did(t), t->r1_0, t->gpc,
+		t->r1_0_end, t->gpc_end, READ_ONCE(g->mmio_max_pstate), vs,
+		g5p_mmio_us(t));
+}
+
+/* Rung 3/5: one licensed ticket, CORE_REVISION and CORE_ID. */
+
+/* drm side: rung 5 at the 3D completion decision, and the idle clock for bit 3. */
+
+/* Bit 4: the GPU core clock.  CR_TIMER (R0+0x160) ticks once per 256 core clocks whether or not a
+ * phase is open (r3clk: 2823 kHz at pstate 4 = 722.7 MHz, 3703 kHz at 948 MHz), so CR_TIMER over
+ * host time x 256 is the clock at any moment.  The Rogue PERF_TA_CYCLE / PERF_3D_CYCLE /
+ * PERF_TA_OR_3D_CYCLE counters (R0+0x6020/0x6028/0x6038, 32 bit) advance at the core clock while a
+ * TA or 3D phase is open (340.0 MHz through open TA phases, docs/gpu/experiments/46-device-tests.md):
+ * over host time, the highest rate per pstate (a window busy all through) is the clock again.  One
+ * sample = two licensed tickets, mmio_clock_gap_us apart, each reading the three counters and
+ * CR_TIMER's low word back to back.  A cycle rate above 2 GHz is a firmware counter clear
+ * (R0+0x6000 = 1, 0x1001ab00) inside the window and is dropped.
+ */
+
+/* Bit 3: does the GPC power down at full idle in state 0?  The PMGR word is always readable;
+ * R1 only while the gate reads on (actual == target == 0xf), through a census ticket so the RAM
+ * terms and the lock still apply.  A refused licence still returns the R1 words it read.
+ */
diff --git a/drivers/gpu/apple-g5p/mmu-attrs.inc b/drivers/gpu/apple-g5p/mmu-attrs.inc
new file mode 100644
index 000000000..694552016
--- /dev/null
+++ b/drivers/gpu/apple-g5p/mmu-attrs.inc
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include <asm/pgtable.h>
+#include <asm/sysreg.h>
+
+/* Read the actual stable kernel mapping of a retained DMA allocation.
+ * DMA memory may be a vmalloc PTE or a cached linear-map block.
+ */
+static u64 g5p_table_cpu_descriptor(unsigned long va)
+{
+	pgd_t *pgd = pgd_offset_k(va);
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+
+	if (pgd_none(READ_ONCE(*pgd)) || pgd_bad(READ_ONCE(*pgd)))
+		return 0;
+	p4d = p4d_offset(pgd, va);
+	if (p4d_none(READ_ONCE(*p4d)) || p4d_bad(READ_ONCE(*p4d)))
+		return 0;
+	pud = pud_offset(p4d, va);
+	if (pud_leaf(READ_ONCE(*pud)))
+		return pud_val(READ_ONCE(*pud));
+	if (pud_none(READ_ONCE(*pud)) || pud_bad(READ_ONCE(*pud)))
+		return 0;
+	pmd = pmd_offset(pud, va);
+	if (pmd_leaf(READ_ONCE(*pmd)))
+		return pmd_val(READ_ONCE(*pmd));
+	if (pmd_none(READ_ONCE(*pmd)) || pmd_bad(READ_ONCE(*pmd)))
+		return 0;
+	return pte_val(READ_ONCE(*pte_offset_kernel(pmd, va)));
+}
+
+static void g5p_table_attrs(struct g5p_diag *g, const char *stage,
+			    struct g5p_dma_page *p)
+{
+	u64 desc, mair = read_sysreg(mair_el1);
+	u32 index, attr;
+
+	if (!p->cpu)
+		return;
+	desc = g5p_table_cpu_descriptor((unsigned long)p->cpu);
+	index = (desc & PTE_ATTRINDX_MASK) >> 2;
+	attr = (mair >> (index * 8)) & 0xff;
+	g5p_mmu_record(
+		g,
+		"MMU allocation %s DMA=%pad coherent=%u cpu_desc=%016llx AttrIndx=%u "
+		"MAIR=%016llx attr=%02x table_memtype=%s\n",
+		stage, &p->dma, dev_is_dma_coherent(g->dev), desc, index, mair,
+		attr,
+		!desc	     ? "unknown" :
+		attr == 0xff ? "Normal-WB" :
+		attr == 0x44 ? "Normal-NC" :
+			       "other");
+}
diff --git a/drivers/gpu/apple-g5p/mmu-tables.inc b/drivers/gpu/apple-g5p/mmu-tables.inc
new file mode 100644
index 000000000..94ae6ed8f
--- /dev/null
+++ b/drivers/gpu/apple-g5p/mmu-tables.inc
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Fixed, pre-release aliases only. No firmware patch or live table surgery. */
+#define G5P_TABLE_ALIAS_VA (G5P_ROOT_VA + 0x100000ULL)
+#define G5P_TABLE_COOKIE 0x3ffcU
+
+static void g5p_table_clean_page(struct g5p_diag *g, struct g5p_dma_page *p)
+{
+	unsigned long start;
+
+	if (!p->cpu)
+		return;
+	start = (unsigned long)p->cpu;
+	/* Explicit architecture PoC operation, even if DT calls this coherent.
+	 * dma_sync_single_for_device is not an API for coherent allocations.
+	 */
+	dcache_clean_poc(start, start + G5P_GPU_PAGE);
+}
+
+static void g5p_tables_clean(struct g5p_diag *g, const char *stage,
+			     struct g5p_dma_page *user, u32 count)
+{
+	struct g5p_boot *b = g->boot;
+
+	g5p_mmu_record(
+		g,
+		"MMU tables %s clean_poc=%u dma_coherent=%u dma_pgprot=%016llx; coherent DMA "
+		"API, extra clean is experimental\n",
+		stage, 1, dev_is_dma_coherent(g->dev),
+		(u64)pgprot_val(dma_pgprot(g->dev, PAGE_KERNEL, 0)));
+	for (u32 i = 0; i < count; i++)
+		g5p_table_attrs(g, stage, &user[i]);
+	g5p_table_attrs(g, stage, &b->catalogue);
+	g5p_table_attrs(g, stage, &b->directory);
+	for (u32 i = 0; i < b->leaves; i++)
+		g5p_table_attrs(g, stage, &b->leaf[i]);
+	;
+	;
+	for (u32 i = 0; i < count; i++)
+		g5p_table_clean_page(g, &user[i]);
+	for (u32 i = 0; i < b->leaves; i++)
+		g5p_table_clean_page(g, &b->leaf[i]);
+	g5p_table_clean_page(g, &b->sink_leaf);
+	g5p_table_clean_page(g, &b->sink_directory);
+	g5p_table_clean_page(g, &b->directory);
+	g5p_table_clean_page(g, &b->catalogue);
+	dsb(sy);
+	dma_wmb();
+	g5p_mmu_record(
+		g,
+		"MMU tables %s PoC complete user_pages=%u boot_leaves=%u; dsb sy before publication\n",
+		stage, count, b->leaves);
+}
+
+/* Deliberately separate from g5p_meta_read(): the generic slave guard stays
+ * latched after reset. This opt-in reader can address only the preinstalled
+ * table aliases and one immutable root control word, never private META RAM.
+ */
diff --git a/drivers/gpu/apple-g5p/pack.h b/drivers/gpu/apple-g5p/pack.h
new file mode 100644
index 000000000..942b44ba3
--- /dev/null
+++ b/drivers/gpu/apple-g5p/pack.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_G5P_PACK_H
+#define APPLE_G5P_PACK_H
+
+#include "bits-compat.h"
+#include "ldr.h"
+#ifndef G5P_LDR_USER_TEST
+#include <linux/string.h>
+#include <linux/kernel.h>
+#endif
+
+#define G5P_IMAGE_SIZE 0x30000
+#define G5P_CONFIG_WRITES 27
+
+struct g5p_ldr_image {
+	u8 *data;
+	u32 config[G5P_CONFIG_WRITES][2];
+	u32 config_count;
+	u32 t1_pc;
+	u32 t1_sp;
+};
+
+/* Exact C0 ranges derived from AGXMetaFirmware_layoutAndLoadLDR ...6c9f1bc.
+ * GPU virtual mappings and the boot config at +0x200 are intentionally separate.
+ */
+static inline int g5p_image_offset(u32 addr, u32 size, u32 *offset)
+{
+	static const struct {
+		u32 base, size, packed;
+	} segments[] = {
+		{ 0x10000000, 0x18000, 0x04000 },
+		{ 0x20000000, 0x04000, 0x1c000 },
+		{ 0xc0000000, 0x04000, 0x00000 },
+		{ 0xe0001000, 0x04000, 0x20000 },
+		{ 0x80000080, 0x055dc, 0x24000 },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(segments); i++) {
+		if (addr >= segments[i].base && size <= segments[i].size &&
+		    addr - segments[i].base <= segments[i].size - size) {
+			*offset = segments[i].packed + addr - segments[i].base;
+			return 0;
+		}
+	}
+	return -EINVAL;
+}
+
+static inline int g5p_pack_record(void *ctx, enum g5p_ldr_op op, u32 addr,
+				  u32 size, const u8 *data)
+{
+	struct g5p_ldr_image *image = ctx;
+	u32 i, offset;
+	int ret;
+
+	switch (op) {
+	case G5P_LOAD:
+		ret = g5p_image_offset(addr, size, &offset);
+		if (ret)
+			return ret;
+		memcpy(image->data + offset, data, size);
+		break;
+	case G5P_ZERO:
+		/* Apple does not apply the local/core-memory ZeroMem records here. */
+		if (addr >= 0x80000000 && addr < 0x88000000)
+			break;
+		ret = g5p_image_offset(addr, size, &offset);
+		if (ret)
+			return ret;
+		memset(image->data + offset, 0, size);
+		break;
+	case G5P_CONFIG:
+		for (i = 0; i < size; i += 12) {
+			if (image->config_count == G5P_CONFIG_WRITES)
+				return -EINVAL;
+			image->config[image->config_count][0] =
+				g5p_le32(data + i + 4);
+			image->config[image->config_count++][1] =
+				g5p_le32(data + i + 8);
+		}
+		break;
+	case G5P_START:
+		image->t1_sp = g5p_le32(data + 4);
+		image->t1_pc = g5p_le32(data + 8);
+		break;
+	}
+	return 0;
+}
+#endif
diff --git a/drivers/gpu/apple-g5p/perf-envelope.h b/drivers/gpu/apple-g5p/perf-envelope.h
new file mode 100644
index 000000000..57387bcba
--- /dev/null
+++ b/drivers/gpu/apple-g5p/perf-envelope.h
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * perf60 clock: the inputs of the firmware's policy-state writer (0x10008218) and of its governor,
+ * so the firmware itself moves the GPC from pstate 1 to q = pin / 100.  Both compute
+ *	x = min(policy+0x6f0, policy+0x688, ctrl+0x102c)
+ * (META CS is unsigned lower; iOS's live policy+0x38 equals this min in every sample), store
+ * policy+8 = 0 when x % 100 == 0 (2 when x < 100), and request pstate q = x / 100 (policy+0x28).
+ * +0x6f0 and +0x688 are recomputed by the firmware from its coefficient block unless their
+ * overrides +0x6f4 / +0x68c are nonzero, and the firmware itself reloads those overrides from
+ * the control object on every pass, whatever the record held: +0x6f4 = ctrl+0x1040 (0x1000a1e4,
+ * 0x1000b388, 0x1000c568) and +0x68c = ctrl+0x1038 (0x1000a74c, 0x1000b10c, 0x1000c2fc).  iOS
+ * leaves both control words 0 and arms the sampler (policy+4 = 16); this boot pins them
+ * (ctrl+0x1040 = pin, ctrl+0x1038 = 400) and leaves the sampler off (policy+4 = 0), so there is
+ * no idle parking at pstate 0.  The pstate table and limits are iOS's (live j71t capture,
+ * 2026-11-01): meta+0x710/0x714 = 4/5, MHz {0, 340, 474, 550, 723}, ctrl+0x1028/0x1030 =
+ * 3348/400; the floor ctrl+0x102c is the pin.  RAM only, before release.
+ */
+#ifndef APPLE_G5P_PERF_ENVELOPE_H
+#define APPLE_G5P_PERF_ENVELOPE_H
+
+#include "bits-compat.h"
+#define G5P_PERF_POLICY 0x4aU
+#define G5P_PERF_META 0x4dU
+#define G5P_PERF_CTL 0x5eU
+#define G5P_PERF_TOP 400U
+
+static const u32 g5p_perf_mhz[] = { 0, 340, 474, 550, 723 };
+
+static inline bool g5p_perf_valid(u32 pin)
+{
+	return pin <= G5P_PERF_TOP && !(pin % 100);
+}
+
+static inline void g5p_perf_install(const struct g5p_boot_layout *p, u8 *root,
+				    u8 *shared, u32 pin)
+{
+	u8 *policy = g5p_object(p, root, shared, G5P_PERF_POLICY);
+	u8 *meta = g5p_object(p, root, shared, G5P_PERF_META);
+	u8 *ctl = g5p_object(p, root, shared, G5P_PERF_CTL);
+	u32 i;
+
+	g5p_put32(meta + 0x710, ARRAY_SIZE(g5p_perf_mhz) - 1);
+	g5p_put32(meta + 0x714, ARRAY_SIZE(g5p_perf_mhz));
+	for (i = 0; i < ARRAY_SIZE(g5p_perf_mhz); i++)
+		g5p_put32(meta + 0x718 + 4 * i, g5p_perf_mhz[i]);
+	g5p_put32(ctl + 0x1028, 3348);
+	g5p_put32(ctl + 0x102c, pin);
+	g5p_put32(ctl + 0x1030, G5P_PERF_TOP);
+	g5p_put32(ctl + 0x1038, G5P_PERF_TOP);
+	g5p_put32(ctl + 0x1040, pin);
+	g5p_put32(policy + 0x688, G5P_PERF_TOP);
+	g5p_put32(policy + 0x68c, G5P_PERF_TOP);
+	g5p_put32(policy + 0x6f0, pin);
+	g5p_put32(policy + 0x6f4, pin);
+}
+
+/* boot_gpu_oc_mhz (gpu-oc.h): state 5 = the overclock record; the firmware's table, ceilings and
+ * policy limits extended to index 5 so the pin 500 and the power-on request of state 5 are in range
+ * (the firmware derives its clock entry priv+0x2c4 = meta+0x718[state] from Fender, 0x1001c838).
+ */
+
+/*
+ * boot_gpu_perf_seed (perf60-clock.md "Clock-change drain RE" §3): in policy state 0 the
+ * firmware
+ * never changes pstate while powered; only its boot sampler (0x1000aa80, before ALIVE) moves the
+ * GPC, when policy+0x28 != Fender & 0xf.  Seeding the policy record with the firmware's own
+ * steady-state output for the pin, +0x28 = +0x2c = q, +0x30 = 0, +8 = 0, makes that sampler
+ * request q through its setter (0x1001c9b8 -> 0x1001c88c: pol34 = q, R1+0x1000 = q | 0x10),
+ * which is
+ * iOS's park -> reboot -> sampler path.  q = pin / 100 for pins 200..400, else 0 (no seed).
+ */
+static inline u32 g5p_perf_seed_q(u32 pin)
+{
+	return pin >= 200 && pin <= G5P_PERF_TOP && !(pin % 100) ? pin / 100 :
+								   0;
+}
+
+/* Seed 2 adds what the sampler needs to get past its first-call init: 0x1000aa80 at 0x1000abb0
+ * takes policy+0 == 0 as "never sampled" and only initialises (0x1000ae88: +0 = 1, its time words)
+ * without reaching the target compare at 0x1000ada4 or the setter; its sampling path divides by
+ * policy+4 (0x10022f88 at 0x1000ac28).  The boot call at 0x10000b54 is its only caller, so a fresh
+ * record never moves Fender.  iOS's record persists across firmware reboots: +0 = 1 and +4 = 16 in
+ * every sample of the 2026-11-01 capture (idle and load).  Seed 2 writes those two as iOS has them.
+ * Seed 2 on hardware (2026-11-03): no ALIVE, Fender 0.  With +0 = 1 the sampler takes its sampling
+ * path when (now - policy+0x8f8) / 24000 / policy+4 >= 1 (0x1000ac10..ac5c): +0x8f8 is the host's
+ * map-time stamp, ~3 s old at release, so it runs the load governor (0x1000afa4 -> 0x1000b050, busy
+ * accumulators policy+0x62c..0x68c, all 0 on a fresh record) and lands on pstate 0.  Seed 3
+ * (boot.inc
+ * g5p_boot_release) restamps +0x8f8 right before the release stream: < 1 period elapsed, the load
+ * update is skipped (0x1000ac64 -> 0x1000acb0 -> 0x1000ada4) and the compare against +0x28 = q
+ * reaches the setter (0x1000ae68 -> 0x1001c9b8).
+ */
+static inline void g5p_perf_seed(const struct g5p_boot_layout *p, u8 *root,
+				 u8 *shared, u32 q, bool ios_record)
+{
+	u8 *policy = g5p_object(p, root, shared, G5P_PERF_POLICY);
+
+	g5p_put64(policy + 0x28, (u64)q << 32 | q);
+	g5p_put32(policy + 0x30, 0);
+	g5p_put32(policy + 8, 0);
+	if (ios_record) {
+		g5p_put32(policy + 0, 1);
+		g5p_put32(policy + 4, 16);
+	}
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/power-r33.inc b/drivers/gpu/apple-g5p/power-r33.inc
new file mode 100644
index 000000000..ce8a18f3c
--- /dev/null
+++ b/drivers/gpu/apple-g5p/power-r33.inc
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* R33 (ds-r33-b knob A): the kexec GFX cycle holds ps_gfx off for ~10 us, and
+ * R0+0x418/0x41c (no reset) keeps the previous boot's value through it. At the
+ * first Fender wake, before any GPU MMIO and before any GPU IRQ is requested,
+ * hold the same PMGR gate (0x80340, gate124) off for boot_gfx_off_ms, then
+ * restore target 0xf. The refusal rules are pmgr-pwrstate's own (min, reset,
+ * auto). Every exit leaves the gate requested on.
+ */
+#define G5P_R33_GFX_PS 0x80340U
+#define G5P_R33_GFX_OFF_MAX_MS 2000U
+#define G5P_R33_GFX_POLL_US 10000U
+
+static inline bool g5p_r33_gfx_on(u32 raw)
+{
+	return (raw & 0xf) == 0xf && ((raw >> 4) & 0xf) == 0xf;
+}
+
+/* Only a plain, fully-on, software-controlled gate may be cycled. */
+static inline bool g5p_r33_gfx_cyclable(u32 raw)
+{
+	return g5p_r33_gfx_on(raw) && !((raw >> 16) & 0xf) && !(raw >> 31) &&
+	       !((raw >> 28) & 1);
+}
+
+static int g5p_r33_gfx_off(struct device *dev, struct regmap *pmgr, u32 ms)
+{
+	u32 before, held, v = 0, after = 0;
+	u64 t0;
+	int ret, on;
+
+	if (!ms)
+		return 0;
+	if (ms > G5P_R33_GFX_OFF_MAX_MS || !pmgr)
+		return -EINVAL;
+	ret = regmap_read(pmgr, G5P_R33_GFX_PS, &before);
+	if (ret)
+		return ret;
+	if (!g5p_r33_gfx_cyclable(before)) {
+		dev_info(
+			dev,
+			"POWER gfx-off refused ms=%u before=%08x; pmgr min/reset/auto or not on\n",
+			ms, before);
+		return -EBUSY;
+	}
+	ret = regmap_update_bits(pmgr, G5P_R33_GFX_PS, 0xf, 0);
+	if (!ret)
+		ret = regmap_read_poll_timeout(pmgr, G5P_R33_GFX_PS, v,
+					       !((v >> 4) & 0xf), 10,
+					       G5P_R33_GFX_POLL_US);
+	t0 = ktime_get_ns();
+	if (!ret)
+		msleep(ms);
+	held = (u32)((ktime_get_ns() - t0) / 1000);
+	if (!ret)
+		ret = regmap_read(pmgr, G5P_R33_GFX_PS, &v);
+	/* Never leave the GPU domain off, whatever happened above. */
+	on = regmap_update_bits(pmgr, G5P_R33_GFX_PS, 0xf, 0xf);
+	if (!on)
+		on = regmap_read_poll_timeout(pmgr, G5P_R33_GFX_PS, after,
+					      g5p_r33_gfx_on(after), 10,
+					      G5P_R33_GFX_POLL_US);
+	dev_info(
+		dev,
+		"POWER gfx-off ms=%u held_us=%u before=%08x end=%08x after=%08x off_ret=%d "
+		"on_ret=%d\n",
+		ms, held, before, v, after, ret, on);
+	if (!ret && (v >> 4) & 0xf)
+		ret = -EIO;
+	return ret ?: on;
+}
diff --git a/drivers/gpu/apple-g5p/power-r41.inc b/drivers/gpu/apple-g5p/power-r41.inc
new file mode 100644
index 000000000..9e5c1e668
--- /dev/null
+++ b/drivers/gpu/apple-g5p/power-r41.inc
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* J71t live ADT + ApplePMGR_restoreDeviceBridgeSettings (5a39918).
+ * Volatile fabric MMIO only. GFX selects bridge 8, then bridge 9; the two
+ * version-0 counter controls follow bridge 8's table, before bridge 9.
+ * Keep devm_ioremap/readl/writel identical to boot.inc's swirq mapping.
+ */
+static const unsigned int gfx_bridge_replay = 0;
+
+struct g5p_r41_write {
+	u32 bridge, offset, value;
+};
+
+static const struct g5p_r41_write g5p_r41_writes[] = {
+	{ 8, 0x0000, 0x00000120 }, { 8, 0x0018, 0x80010005 },
+	{ 8, 0x001c, 0x00010001 }, { 8, 0x410c, 0x00000003 },
+	{ 8, 0x4100, 0x00000003 }, { 9, 0x0000, 0x00697101 },
+	{ 9, 0x0004, 0x00697101 }, { 9, 0x0008, 0x00697101 },
+	{ 9, 0x000c, 0x00697101 }, { 9, 0x0010, 0x00697101 },
+	{ 9, 0x0014, 0x00697101 }, { 9, 0x0018, 0x00697101 },
+	{ 9, 0x001c, 0x00697101 }, { 9, 0x0020, 0x00697101 },
+	{ 9, 0x0024, 0x00697101 }, { 9, 0x0028, 0x00697101 },
+	{ 9, 0x002c, 0x00697101 }, { 9, 0x0030, 0x00697101 },
+	{ 9, 0x0034, 0x00697101 }, { 9, 0x0038, 0x00697101 },
+	{ 9, 0x003c, 0x00697101 }, { 9, 0x0040, 0x00697101 },
+	{ 9, 0x0044, 0x00697101 }, { 9, 0x0048, 0x00697101 },
+	{ 9, 0x004c, 0x00697101 }, { 9, 0x0050, 0x00697101 },
+	{ 9, 0x0054, 0x00697101 }, { 9, 0x0058, 0x00697101 },
+	{ 9, 0x005c, 0x00697101 }, { 9, 0x0060, 0x00697101 },
+	{ 9, 0x0064, 0x00697101 }, { 9, 0x0068, 0x00697101 },
+	{ 9, 0x006c, 0x00697101 }, { 9, 0x0070, 0x00697101 },
+	{ 9, 0x0074, 0x00697101 }, { 9, 0x0078, 0x00697101 },
+	{ 9, 0x007c, 0x00697101 },
+};
+
+static struct {
+	void __iomem *window[2];
+	unsigned int mode;
+	int result;
+	bool attempted, ready, firmware_logged, ta_logged;
+} g5p_r41_bridge;
+
+/* Reject anything outside the exact write allowlist, including unaligned
+ * offsets and other registers inside the two mapped ADT ranges.
+ */
+static bool g5p_r41_valid(const struct g5p_r41_write *w)
+{
+	if (w->offset & 3)
+		return false;
+	if (w->bridge == 8)
+		return w->offset < 0x5000 &&
+		       (w->offset == 0 || w->offset == 0x18 ||
+			w->offset == 0x1c || w->offset == 0x410c ||
+			w->offset == 0x4100);
+	return w->bridge == 9 && w->offset <= 0x7c;
+}
+
+static void g5p_r41_bridge_snapshot(struct g5p_diag *g, const char *stage)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(g5p_r41_writes); i++) {
+		const struct g5p_r41_write *w = &g5p_r41_writes[i];
+		u32 value =
+			readl(g5p_r41_bridge.window[w->bridge - 8] + w->offset);
+
+		dev_info(
+			g->dev,
+			"BRIDGE r41 stage=%s mode=%u index=%u bridge=%u off=%04x value=%08x want=%08x\n",
+			stage, g5p_r41_bridge.mode, i, w->bridge, w->offset,
+			value, w->value);
+	}
+}
+
+/* Called under g->lock after ACTIVE (and any r33 off/on), before Fender.
+ * Latch errors too: never retry a partial experiment in the same boot.
+ */
+static int g5p_r41_bridge_prepare(struct g5p_diag *g)
+{
+	unsigned int i, mode = gfx_bridge_replay;
+
+	if (!mode)
+		return 0;
+	if (g5p_r41_bridge.attempted)
+		return g5p_r41_bridge.result;
+	g5p_r41_bridge.attempted = true;
+	g5p_r41_bridge.mode = mode;
+	g5p_r41_bridge.result = -EINVAL;
+	if (mode > 4)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(g5p_r41_writes); i++)
+		if (!g5p_r41_valid(&g5p_r41_writes[i]))
+			return -EINVAL;
+	g5p_r41_bridge.result = -ENOMEM;
+	g5p_r41_bridge.window[0] = devm_ioremap(g->dev, 0x201f00000ULL, 0x5000);
+	if (!g5p_r41_bridge.window[0])
+		return -ENOMEM;
+	g5p_r41_bridge.window[1] = devm_ioremap(g->dev, 0x201f80000ULL, 0x1000);
+	if (!g5p_r41_bridge.window[1])
+		return -ENOMEM;
+	/* Read all 37 even in split modes; never read unmapped/partial state. */
+	g5p_r41_bridge_snapshot(g, "before");
+	for (i = 0; i < ARRAY_SIZE(g5p_r41_writes); i++) {
+		const struct g5p_r41_write *w = &g5p_r41_writes[i];
+
+		if (mode == 1 || (mode == 3 && w->bridge != 8) ||
+		    (mode == 4 && w->bridge != 9))
+			continue;
+		writel(w->value,
+		       g5p_r41_bridge.window[w->bridge - 8] + w->offset);
+		dev_info(
+			g->dev,
+			"BRIDGE r41 write mode=%u index=%u bridge=%u off=%04x value=%08x\n",
+			mode, i, w->bridge, w->offset, w->value);
+	}
+	g5p_r41_bridge_snapshot(g, "after");
+	g5p_r41_bridge.ready = true;
+	g5p_r41_bridge.result = 0;
+	return 0;
+}
+
+static void g5p_r41_bridge_firmware(struct g5p_diag *g)
+{
+	if (g5p_r41_bridge.ready && !g5p_r41_bridge.firmware_logged) {
+		g5p_r41_bridge.firmware_logged = true;
+		g5p_r41_bridge_snapshot(g, "firmware-alive");
+	}
+}
+
+static void g5p_r41_bridge_ta(struct g5p_diag *g)
+{
+	if (g5p_r41_bridge.ready && !g5p_r41_bridge.ta_logged) {
+		g5p_r41_bridge.ta_logged = true;
+		g5p_r41_bridge_snapshot(g, "first-TA-kick");
+	}
+}
diff --git a/drivers/gpu/apple-g5p/r74e112.h b/drivers/gpu/apple-g5p/r74e112.h
new file mode 100644
index 000000000..cacac73ac
--- /dev/null
+++ b/drivers/gpu/apple-g5p/r74e112.h
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_R74E112_H
+#define G5P_R74E112_H
+
+#ifndef G5P_GPC_ON
+#define G5P_GPC_ON(raw) (((raw) & 0x1f) == 1) /* core.inc overrides it */
+#endif
+
+/*
+ * Wake112: the R74E GPC1 power proof when ALIVE preempts the on-poll.
+ *
+ * R74E (boot.inc) requests GPC=1 and polls R1+0x1000 until the state field reads 1.
+ * The poll stops as soon as ALIVE is decoded: after ALIVE only the first-ALIVE owner
+ * may read R1.  On a warm, kexec-cycled boot the firmware can reach ALIVE before the
+ * poll's first read (Wake111 20261031T201022Z: off_ns=1500 on_ns=375 raw=ffffffff,
+ * the U32_MAX "not read" sentinel).  Wake111 then latched a power abort although the
+ * state was never sampled.
+ *
+ * Wake112 defers that one proof to the owner instead, but only when the on-poll took
+ * no sample: the poll counts its reads, and the U32_MAX raw is never taken as "not read".
+ * The owner's existing first-ALIVE read of R1+0x1000 (g5p_r73e_irq_submit, before any
+ * register write) is the proof.  State 1 sets release_ready and the unchanged cold
+ * sequence continues.  Any other value (0, 0x10, 0x11, ffffffff, ...) is an absorbing
+ * power abort.  An on-poll that reads state 1 never defers.  An on-poll that sampled
+ * before ALIVE (0x11 in rounds 74e..79b, or any other word) and every other R74E failure
+ * (off-poll, timeout, GPC1 write refused) abort exactly as before.
+ *
+ * States (r73b->early_proof):
+ *   NONE      no deferral: the poll decided, or the release has not run
+ *   DEFERRED  ALIVE preempted the on-poll; one owner read is owed (generation recorded)
+ *   TAKEN     the once-owner claimed it; it settles with no exit in between
+ *   PROVEN    that read had state 1: release_ready
+ *   FAILED    any other value, another generation, a lost precondition, or an ALIVE
+ *             wait that ended with the proof still owed: power abort, absorbing
+ *
+ * Pure policy: no register access, no lock, no kernel API.
+ */
+
+#define G5P_PX_STATE_MASK 0x1fU
+#define G5P_PX_STATE_ON 0x01U
+
+enum g5p_px {
+	G5P_PX_NONE,
+	G5P_PX_DEFERRED,
+	G5P_PX_TAKEN,
+	G5P_PX_PROVEN,
+	G5P_PX_FAILED,
+	G5P_PX_N,
+};
+
+static const char *const g5p_px_name[G5P_PX_N] = {
+	"none", "deferred", "taken", "proven", "failed",
+};
+
+/* Why a deferred proof failed (NONE: it did not). */
+enum g5p_px_why {
+	G5P_PXW_NONE,
+	G5P_PXW_STATE, /* the read's state field is not 1 */
+	G5P_PXW_STALE, /* deferred in another reset generation */
+	G5P_PXW_LOST, /* ALIVE or the release lost, stopped or failed since */
+	G5P_PXW_RETIRED, /* a FINAL teardown forbids R1 */
+	G5P_PXW_UNTAKEN, /* the ALIVE wait ended with the proof still owed */
+	G5P_PXW_N,
+};
+
+static const char *const g5p_px_why_name[G5P_PXW_N] = {
+	"none", "state", "stale", "lost", "retired", "untaken",
+};
+
+/* What the R74E release path latches. */
+enum g5p_pxp {
+	G5P_PXP_READY, /* the on-poll read state 1: release_ready (cold) */
+	G5P_PXP_DEFER, /* ALIVE preempted the on-poll before its first read */
+	G5P_PXP_ABORT, /* anything else: power abort (cold) */
+};
+
+/*
+ * on_ran: the core request, the off-poll and the GPC1 write succeeded and the on-poll
+ * ran.  ret: the last step's result.  preempted: the on-poll stopped on ALIVE.
+ * samples: the on-poll's R1+0x1000 reads.  Only a preemption with no read defers (no
+ * abort, no release_ready); a sampled one saw the state and aborts.
+ */
+static inline enum g5p_pxp g5p_px_poll(bool on_ran, int ret, bool preempted,
+				       u32 samples)
+{
+	if (!on_ran)
+		return G5P_PXP_ABORT;
+	if (!ret)
+		return G5P_PXP_READY;
+	return preempted && !samples ? G5P_PXP_DEFER : G5P_PXP_ABORT;
+}
+
+/* The first-ALIVE owner's admission. */
+enum g5p_pxg {
+	G5P_PXG_READY, /* release_ready: the cold owner path */
+	G5P_PXG_PROVE, /* a deferred proof is owed: the once-owner's read decides */
+	G5P_PXG_WAIT, /* nothing proven yet, or another owner holds the proof */
+	G5P_PXG_REFUSE, /* power abort or a failed proof: no register access */
+};
+
+static inline enum g5p_pxg g5p_px_gate(bool power_abort, bool release_ready,
+				       u32 px)
+{
+	if (power_abort || px == G5P_PX_FAILED)
+		return G5P_PXG_REFUSE;
+	if (release_ready)
+		return G5P_PXG_READY;
+	if (px == G5P_PX_DEFERRED)
+		return G5P_PXG_PROVE;
+	return G5P_PXG_WAIT;
+}
+
+/* RAM facts the once-owner samples after taking the proof, before its one read. */
+struct g5p_px_pre {
+	u32 gen, gen_now; /* DS108 generation at the deferral and now */
+	bool alive, released, stopped, failed;
+	bool r1_allowed; /* g5p_r8_r1_allowed() */
+};
+
+static inline enum g5p_px_why g5p_px_check(const struct g5p_px_pre *p)
+{
+	if (!p->gen || p->gen != p->gen_now)
+		return G5P_PXW_STALE;
+	if (!p->alive || !p->released || p->stopped || p->failed)
+		return G5P_PXW_LOST;
+	if (!p->r1_allowed)
+		return G5P_PXW_RETIRED;
+	return G5P_PXW_NONE;
+}
+
+/* The proof: only the state field 1 is power-on. */
+static inline bool g5p_px_on(u32 raw)
+{
+	return G5P_GPC_ON(raw);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/r87b-attach.h b/drivers/gpu/apple-g5p/r87b-attach.h
new file mode 100644
index 000000000..81600ac06
--- /dev/null
+++ b/drivers/gpu/apple-g5p/r87b-attach.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_R87B_ATTACH_H
+#define G5P_R87B_ATTACH_H
+/* R87b DIAGNOSTIC ONLY, never production-safe: the DC3 attach policy selector.
+ * (docs/gpu/experiments/87b-build-report.md)
+ *
+ * Two campaigns (r85 stage 2, r87 stage 1) never reached GPU work: the DC3 attach pair was
+ * published, the immediate gate (R1+0x1000 & 0x1f == 1) read 0x10/0x11, the host GPC off/on
+ * repair timed out (-110) and attach stopped with -115 before the RAM-only consume wait ran,
+ * after which the machine froze.  Every retained instance of that failure shows the firmware
+ * consuming the pair on its own (dc=3/3 at export, no bell rung).  boot_r87b_attach selects:
+ *   0  the original attach policy, exactly r87: a closed gate is repaired by the host (R1+0x20000
+ *      clear, GPC off/on, ALIVE-owned doorbell).  The matched control.
+ *   1  self-drain (the r82b design, docs/gpu/experiments/82-attach-reactivation-triage.md): a
+ *      closed DC3 gate is only a phase sample of the firmware's GPC window.  The host does no
+ *      repair and rings no bell; it keeps the RAM-only 3 s consume wait of render-r74f.inc and
+ *      continues through the firmware-MMU attach path (r74g) when the firmware consumed the pair.
+ *      An active gate still rings the bell at once (the unchanged 80 % path).  The TA kind is
+ *      never affected.
+ * The selector is latched at map and read only through the latched copy.  A non-zero value needs
+ * the r80 epoch (which implies r74h, r74g and r74f case 1): self-drain is only safe because r74g
+ * has the firmware own the first MMU pass, so no host R0 access is licensed by a rung bell.
+ * The TYPED_V3 production path latches policy 1 with boot_r74f_case = boot_r74g_case = 1 and NO
+ * r80 / r74h (boot-r73b.inc, "production path"); g5p_r87b_attach_valid() describes the r80
+ * epoch only.
+ */
+#include <linux/errno.h>
+#include <linux/types.h>
+
+#define G5P_R87B_ATTACH_ORIGINAL 0U
+#define G5P_R87B_ATTACH_SELF_DRAIN 1U
+#define G5P_R87B_ATTACH_MAX 1U
+
+#endif
diff --git a/drivers/gpu/apple-g5p/readback.h b/drivers/gpu/apple-g5p/readback.h
new file mode 100644
index 000000000..fdd71ab30
--- /dev/null
+++ b/drivers/gpu/apple-g5p/readback.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_READBACK_H
+#define G5P_READBACK_H
+
+#include "bits-compat.h"
+#ifndef G5P_GPC_ON
+#define G5P_GPC_ON(raw) (((raw) & 0x1f) == 1) /* core.inc overrides it */
+#endif
+
+enum g5p_readback_state {
+	G5P_READBACK_WRAPPER_ONLY,
+	G5P_READBACK_BASELINE,
+	G5P_READBACK_RESET_HELD,
+};
+
+/* Returning wrapper registers in exp03; never a META slave-port register. */
+static const u32 g5p_fender_regs[] = {
+	0, 8, 0x10, 0x14, 0x1000, 0x1004, 0x2010, 0x2014, 0x20000,
+};
+
+/* Reset halves first: the only post-arm R0 readback needed by the gate. */
+static const u32 g5p_rgx_regs[] = {
+	0x100, 0x104, 0, 4, 8, 0xc, 0x18, 0x20, 0x80, 0x84, 0x88, 0x8c,
+};
+
+static inline u32 g5p_readback_rgx_count(u32 gpc, enum g5p_readback_state state)
+{
+	if (!G5P_GPC_ON(gpc))
+		return 0;
+	if (state == G5P_READBACK_RESET_HELD)
+		return 2;
+	return state == G5P_READBACK_BASELINE ? ARRAY_SIZE(g5p_rgx_regs) : 0;
+}
+
+static inline bool g5p_slave_access_allowed(bool reset_transition)
+{
+	return !reset_transition;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/recover.inc b/drivers/gpu/apple-g5p/recover.inc
new file mode 100644
index 000000000..f550d1010
--- /dev/null
+++ b/drivers/gpu/apple-g5p/recover.inc
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * In-boot GPU recovery (docs/gpu/multi-client-design.md "Stage 2/3 as built", fault isolation).
+ *
+ * A render job that stopped the firmware (its event stream went silent, or a fault) blocks the
+ * one TA/3D channel for every client, and the firmware has no abort.  iOS ends that state with a
+ * firmware stop, a platform power cycle and a new firmware boot (kext 6c9e070, firmware-re README
+ * "Fault recovery").  This is the same, built from two proven pieces:
+ *   - the reboot quiesce's freeze, IRQ mask and PMGR gfx gate cycle (teardown.inc g5p_kq_*), which
+ *     on hardware cycled a wedged, failed device safely (deskfold reboot notifier: plan=-+cycle,
+ *     then the next kernel came up warm-cycled);
+ *   - the bootstrap's own stage functions (wake, map, arm, load, release, events, control), the
+ *     same code the sysfs commands run after the next kernel's cycle on every warm hop.
+ * The old struct g5p_boot is frozen and left allocated (devm; a few hundred KiB per recovery),
+ * so a stale pointer anywhere still reads valid memory; a new one is built by the stages.  id and
+ * sample are not rerun (they refuse once the boot saw a reset transition; map needs only the
+ * cached core id), nor is irq-test (refused in an r74 epoch).  The firmware image is reused.
+ *
+ * Core lock held, no job in flight (the render scheduler's worker).  Returns 0 with a live new
+ * epoch, or an error with the device left frozen and failed.
+ */
+
+/* The bootstrap's stages after the wake, as the sysfs runner orders them. */
+static const char *const g5p_recover_stages[] = {
+	"map",
+	"arm",
+	"load",
+	"release",
+	"events",
+	"control-prepare",
+	"control-submit",
+	"control-wait",
+};
+
+static int __maybe_unused g5p_recover(struct g5p_diag *g, const char *why,
+				      u32 *stage_out)
+{
+	struct g5p_boot *old = g->boot;
+	struct g5p_kq_ctx kq = { .g = g };
+	u64 t0 = ktime_get_ns();
+	u32 stage = 0;
+	int ret;
+
+	lockdep_assert_held(&g->lock);
+	*stage_out = 0;
+	if (!old || !READ_ONCE(old->released) || g5p_r8_is_retired() ||
+	    g5p_r8_admit_closed(&g5p_r8_state.admit) || !g->pmgr ||
+	    !g->id_checked)
+		return -EPERM;
+	/* The quiesce's freeze and IRQ mask, then the line is given back for the new epoch. */
+	g5p_kq_freeze(&kq);
+	g5p_kq_irq_off(&kq);
+	if (old->irq_ready && old->irq > 0)
+		devm_free_irq(g->dev, old->irq, g);
+	/* mmio-access.md G5: the GPU is marked unusable before its power is cut (Apple clears
+	 * fender+0xc inside setPlatformPower(0), before the gate); g5p_kq_cycle() also sets mmio_off.
+	 */
+	WRITE_ONCE(g->fender_ready, false);
+	ret = g5p_kq_cycle(&kq);
+	ret = g5p_ds_hook_recover(g, ret) ?: ret;
+	if (ret)
+		goto out;
+	/* A new epoch: the stages build a new struct g5p_boot from here. */
+	WRITE_ONCE(g->boot, NULL);
+	stage = 1;
+	ret = g5p_fender_wake(g);
+	for (u32 i = 0; !ret && i < ARRAY_SIZE(g5p_recover_stages); i++) {
+		const char *s = g5p_recover_stages[i];
+
+		stage = i + 2;
+		ret = strncmp(s, "control-", 8) ? g5p_boot_command(g, s) :
+						  g5p_lifecycle_command(g, s);
+		if (ret == -EALREADY)
+			ret = 0;
+	}
+	if (!ret && (!g->boot || !READ_ONCE(g->boot->alive) ||
+		     !READ_ONCE(g->boot->control_complete)))
+		ret = -EIO;
+	/* The claim gate again: the held jobs need ALIVE proven in the new generation. */
+	if (!ret)
+		ret = g5p_ds_hook_claim(g);
+	if (!ret) {
+		/* The render claim is kept: no diagnostic command may reset this epoch. */
+		WRITE_ONCE(g->boot->user_compute_owned, true);
+		stage = 0;
+	}
+out:
+	if (ret && g->boot)
+		WRITE_ONCE(g->boot->failed, true);
+	g->last_result = ret;
+	*stage_out = stage;
+	dev_emerg(
+		g->dev,
+		"GPU-RECOVER why=%s ret=%d stage=%s ms=%llu gen=%u end=recover\n",
+		why, ret,
+		!stage	   ? (ret ? "cycle" : "done") :
+		stage == 1 ? "wake" :
+			     g5p_recover_stages[stage - 2],
+		(ktime_get_ns() - t0) / NSEC_PER_MSEC, g5p_ds_gen());
+	return ret;
+}
diff --git a/drivers/gpu/apple-g5p/render-layout-r22.h b/drivers/gpu/apple-g5p/render-layout-r22.h
new file mode 100644
index 000000000..8391a8320
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-layout-r22.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_RENDER_LAYOUT_R22_H
+#define G5P_RENDER_LAYOUT_R22_H
+
+#include "render-layout.h"
+
+#define G5P_R22_TA 0x54000U
+#define G5P_R22_3D 0x58000U
+#define G5P_R22_PM 0x5c000U
+#define G5P_R22_W 0x400U
+#define G5P_R22_TA_SKU 0xa00U
+#define G5P_R22_3D_SKU 0xd00U
+#define G5P_R22_TQ 0x1800U
+#define G5P_R22_STAMP 0x1840U
+#define G5P_R22_DEP 0x1900U
+#define G5P_R22_BLOCKS 32U
+#define G5P_R22_PHYS_PAGES (G5P_R22_BLOCKS * 8)
+#define G5P_R22_AUX 0x101000000ULL
+#define G5P_R22_RT 0x101020000ULL
+#define G5P_R22_RT_AUX 0x101030000ULL
+
+/* 6cb124c/13f4/14dc: PA PPNs, GPU F and META links are distinct.
+ * Caller provides complete 16KiB control/list/F allocations. Check the whole
+ * physical input before writing anything. No synthesized PM catalogue encoder.
+ */
+
+/* 6ca6d5c arithmetic oracle + 6cba480/6c7b64c. Native legacy mapping
+ * dialect has bit36 clear: L=H, Laux=Haux. No PA substitution or float math.
+ */
+
+static const u32 g5p_r22_wait_words[] = {
+	0x201,	    0x138204,  0x10,   0x8388204, 0,	  0x104000a, 0x1f,
+	0x1f,	    0x8388204, 1,      0x104000a, 0x1f,	  0x1f,	     0xf48008,
+	0x10000015, 4,	       0,      0x14,	  0x109f, 0x13000a,  0x4000,
+	0x4000,	    0x138204,  0x4000, 0x8388204, 0,	  0x104000a, 8,
+	8,	    0x8388204, 1,      0x104000a, 8,	  8,
+};
+
+/* Full normal timestamped recipes, independent stamp identities TA0/3D1.
+ * k is dependency+4 (zero on the proven fresh initializer), not MMU tag.
+ */
+
+/* PM bank0 save writes runtime qwords before the a0/a8/b0 backing anchors. */
+static inline bool g5p_r22_pm_saved(const u8 *state)
+{
+	for (u32 off = 8; off < 0xa0; off += 4)
+		if (g5p_le32(state + off))
+			return true;
+	return false;
+}
+
+/* Never trust a firmware pointer until it equals our retained stamp word. */
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-layout.h b/drivers/gpu/apple-g5p/render-layout.h
new file mode 100644
index 000000000..f2a0373da
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-layout.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_RENDER_LAYOUT_H
+#define G5P_RENDER_LAYOUT_H
+
+#include "boot-layout.h"
+
+/* Offline construction primitives only. No TA/3D publication path exists.
+ * 6caf9f8/6cb2378: caller must recover N/S1/S2/S3, not infer them from USC
+ * count or target dimensions. Sizes are bounded to u32 allocation extents.
+ */
+struct g5p_pm_sizes {
+	u32 control, page_lists, backing;
+};
+
+static inline int g5p_pm_sizes(u32 n, u32 blocks, u64 s1, u64 s2, u64 s3,
+			       struct g5p_pm_sizes *out)
+{
+	u64 limit = 0xffffffffULL;
+	u64 a, b;
+
+	if (!n || !blocks || !s1 || !s2 || !s3)
+		return -EINVAL;
+	if (n > (limit - 0x80) / 0xc0 || blocks > (limit - 0x44) / 0x24 ||
+	    s1 > limit / n || s2 > limit / n || s3 > limit)
+		return -EOVERFLOW;
+	a = s1 * n;
+	b = s2 * n;
+	if (a > limit - b || a + b > limit - s3)
+		return -EOVERFLOW;
+	out->control = 0x80 + n * 0xc0;
+	out->page_lists = 0x44 + blocks * 0x24;
+	out->backing = a + b + s3;
+	return 0;
+}
+
+/* Only four recovered backing-pointer writes, not a complete PM record.
+ * Caller owns a fully initialized0xc0 record and validates GPU mappings.
+ */
+static inline int g5p_pm_record_backing(u8 *record, u32 index, u32 n, u64 base,
+					u64 s1, u64 s2, u64 s3, u32 meta)
+{
+	struct g5p_pm_sizes sizes;
+	int ret;
+
+	if (index >= n)
+		return -EINVAL;
+	ret = g5p_pm_sizes(n, 1, s1, s2, s3, &sizes);
+	if (ret)
+		return ret;
+	if (base > ~0ULL - sizes.backing)
+		return -EOVERFLOW;
+	g5p_put64(record + 0xa8, base + index * s1);
+	g5p_put64(record + 0xa0, base + n * s1 + index * s2);
+	g5p_put64(record + 0xb0, base + n * s1 + n * s2);
+	g5p_put32(record + 0xb8, meta);
+	return 0;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-bind.h b/drivers/gpu/apple-g5p/render-user-bind.h
new file mode 100644
index 000000000..3bbbb1e0f
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-bind.h
@@ -0,0 +1,285 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Firmware slot pairs of render contexts (docs/gpu/multi-client-design.md, stage 1).
+ *
+ * Each render context owns a TA and a 3D firmware slot in 7..255, both pointing at its own
+ * page catalogue.  The pair is bound once by two DC3 records {3, slot, 0, 0, 0}, 3D first,
+ * then TA, with the catalogue PA in 0x86[slot] and the host tag in 0x84[slot].  The firmware's
+ * DC3 handler installs CBASE and copies the host tag to 0x85[slot].
+ *
+ * These helpers only read and write those RAM words, so they cannot reach a register and are
+ * safe after a job has retired.  Pure functions, host-tested
+ * (scripts/gpu/multiclient1-host/test_render_bind.c).  The caller provides g5p_le32(),
+ * g5p_put32() and g5p_put64().
+ */
+#ifndef G5P_RENDER_USER_BIND_H
+#define G5P_RENDER_USER_BIND_H
+
+#define G5P_RU_SLOT_MIN 7U
+#define G5P_RU_SLOT_MAX 255U
+/* RAM-only wait for the firmware to consume a published DC3 batch. */
+#define G5P_RU_BIND_MS 3000U
+/* Host tag of a pre-bound spare pair (render_user_spare_pairs): never zero. */
+#define G5P_RU_SPARE_TAG 0x00400000U
+/* Host tag of a parked pair (render_user_close_park): never zero, never a spare's. */
+#define G5P_RU_PARK_TAG 0x00500000U
+#define G5P_RU_MAX_SPARES 32U
+
+/* The words one pair's binding touches.  Pointers, because the DC records may straddle the
+ * shared pages.  Index [e]: 0 TA slot, 1 3D slot.
+ */
+struct g5p_ru_bind_mem {
+	u8 *rec[2][5]; /* the records at start and start + 1 */
+	u8 *pa[2]; /* 0x86[slot], 64 bit */
+	u8 *host[2]; /* 0x84[slot] */
+	u8 *cached[2]; /* 0x85[slot] */
+};
+
+/* One RAM sample of those words and of the DC ring control. */
+struct g5p_ru_bind_sample {
+	u32 cons, prod;
+	u32 rec[2][5];
+	u64 pa[2];
+	u32 host[2], cached[2];
+};
+
+/* g5p_ru_bind_busy() */
+#define G5P_RU_BIND_BUSY_RING 0x1U /* the DC ring is not idle */
+#define G5P_RU_BIND_BUSY_SLOT 0x2U /* a slot has a PA or a host tag */
+
+/* g5p_ru_bind_check(), the r74g criteria */
+#define G5P_RU_BIND_BAD_RING 0x1U
+#define G5P_RU_BIND_BAD_RECORD 0x2U
+#define G5P_RU_BIND_BAD_PA 0x4U
+#define G5P_RU_BIND_BAD_HOST 0x8U
+#define G5P_RU_BIND_BAD_CACHED 0x10U
+
+enum g5p_ru_bind_wait {
+	G5P_RU_BIND_PENDING,
+	G5P_RU_BIND_CONSUMED,
+	G5P_RU_BIND_PROTO,
+	G5P_RU_BIND_TIMEOUT,
+};
+
+static inline bool g5p_ru_slot_used(const unsigned long *map, u32 slot)
+{
+	return (map[slot / BITS_PER_LONG] >> (slot % BITS_PER_LONG)) & 1;
+}
+
+/* The slot pair of a new render context: the two lowest free slots in 7..255.  The lower one
+ * is the 3D slot, or the TA slot with ta_first (render_user_slot_variant 1).  False when fewer
+ * than two are free.  slot[0] is TA, slot[1] is 3D.
+ */
+static inline bool g5p_ru_slot_pair(const unsigned long *map, bool ta_first,
+				    u32 *slot)
+{
+	u32 pick[2], n = 0;
+
+	for (u32 s = G5P_RU_SLOT_MIN; s <= G5P_RU_SLOT_MAX && n < 2; s++)
+		if (!g5p_ru_slot_used(map, s))
+			pick[n++] = s;
+	if (n < 2)
+		return false;
+	slot[0] = pick[ta_first ? 0 : 1];
+	slot[1] = pick[ta_first ? 1 : 0];
+	return true;
+}
+
+/* Word j of record i of a pair: {3, slot, 0, 0, 0}, the 3D slot's record first. */
+static inline u32 g5p_ru_bind_record(const u32 *slot, u32 i, u32 j)
+{
+	return j == 0 ? 3 : j == 1 ? slot[1 - i] : 0;
+}
+
+static inline void g5p_ru_bind_read(const struct g5p_ru_bind_mem *m, u32 cons,
+				    u32 prod, struct g5p_ru_bind_sample *s)
+{
+	s->cons = cons;
+	s->prod = prod;
+	for (u32 i = 0; i < 2; i++)
+		for (u32 j = 0; j < 5; j++)
+			s->rec[i][j] = g5p_le32(m->rec[i][j]);
+	for (u32 e = 0; e < 2; e++) {
+		s->pa[e] = (u64)g5p_le32(m->pa[e] + 4) << 32 |
+			   g5p_le32(m->pa[e]);
+		s->host[e] = g5p_le32(m->host[e]);
+		s->cached[e] = g5p_le32(m->cached[e]);
+	}
+}
+
+/* Before a publish: the ring must be idle and both slots unused (zero PA and host tag). */
+static inline u32 g5p_ru_bind_busy(const struct g5p_ru_bind_sample *s)
+{
+	u32 busy = 0;
+
+	if (s->prod > 255 || s->cons != s->prod)
+		busy |= G5P_RU_BIND_BUSY_RING;
+	for (u32 e = 0; e < 2; e++)
+		if (s->pa[e] || s->host[e])
+			busy |= G5P_RU_BIND_BUSY_SLOT;
+	return busy;
+}
+
+/*
+ * A parked pair (render_user_close_park, release8 quiet2): a closed context's slots, bound to the
+ * kernel's park catalogue (it maps only the firmware window) with the park tag, so that the PM's
+ * late write-back of that context's free list resolves instead of faulting on an empty PC level.
+ * Both slots on `park`, both host tags the park tag.  park 0: nothing is parked.
+ */
+static inline bool g5p_ru_bind_parked(const struct g5p_ru_bind_sample *s,
+				      u64 park)
+{
+	if (!park)
+		return false;
+	for (u32 e = 0; e < 2; e++)
+		if (s->pa[e] != park || s->host[e] != G5P_RU_PARK_TAG)
+			return false;
+	return true;
+}
+
+/* PA and tag of both slots, then the two records.  The caller cleans the catalogue first and
+ * stores the producer afterwards, each behind a barrier.
+ */
+static inline void g5p_ru_bind_publish(const struct g5p_ru_bind_mem *m,
+				       const u32 *slot, u64 root, u32 tag)
+{
+	for (u32 i = 0; i < 2; i++) {
+		u32 e = 1 - i;
+
+		g5p_put64(m->pa[e], root);
+		g5p_put32(m->host[e], tag);
+		for (u32 j = 0; j < 5; j++)
+			g5p_put32(m->rec[i][j], g5p_ru_bind_record(slot, i, j));
+	}
+}
+
+/* After the ring reached `target`: the records intact, both slots on `root`, and the firmware
+ * tag equal to the host tag (the DC3 handler ran for both).
+ */
+static inline u32 g5p_ru_bind_check(const struct g5p_ru_bind_sample *s,
+				    const u32 *slot, u64 root, u32 tag,
+				    u32 target)
+{
+	u32 bad = 0;
+
+	if (s->cons != target || s->prod != target)
+		bad |= G5P_RU_BIND_BAD_RING;
+	for (u32 i = 0; i < 2; i++)
+		for (u32 j = 0; j < 5; j++)
+			if (s->rec[i][j] != g5p_ru_bind_record(slot, i, j))
+				bad |= G5P_RU_BIND_BAD_RECORD;
+	for (u32 e = 0; e < 2; e++) {
+		if (s->pa[e] != root)
+			bad |= G5P_RU_BIND_BAD_PA;
+		if (s->host[e] != tag)
+			bad |= G5P_RU_BIND_BAD_HOST;
+		if (s->cached[e] != tag)
+			bad |= G5P_RU_BIND_BAD_CACHED;
+	}
+	return bad;
+}
+
+/* One sample of a published batch.  The caller takes `expired` before reading the ring, so
+ * the sample taken at the deadline still counts.
+ */
+static inline int g5p_ru_bind_step(u32 cons, u32 prod, u32 target, bool expired)
+{
+	if (prod != target || cons > 255)
+		return G5P_RU_BIND_PROTO;
+	if (cons == target)
+		return G5P_RU_BIND_CONSUMED;
+	return expired ? G5P_RU_BIND_TIMEOUT : G5P_RU_BIND_PENDING;
+}
+
+/*
+ * Unbind (iOS AGXGart_detachSlotsAndDestroyAddressSpace, firmware-re README round 15 §1): PA
+ * and host tag of a slot go to zero and one DC3 record {3, slot, 0, 0, 0} follows.  The DC3
+ * handler then installs CBASE 0, copies the zero tag to 0x85[slot] and invalidates the slot's
+ * PC level.  The slots of one batch take consecutive ring entries, one record each, behind a
+ * single producer store.  The caller must have retired every use of the slots first.
+ */
+#define G5P_RU_USER_SLOTS (G5P_RU_SLOT_MAX - G5P_RU_SLOT_MIN + 1)
+
+struct g5p_ru_slot_mem {
+	u8 *rec[5]; /* the slot's record in the batch */
+	u8 *pa, *host,
+		*cached; /* 0x86[slot] (64 bit), 0x84[slot], 0x85[slot] */
+};
+
+struct g5p_ru_slot_sample {
+	u32 cons, prod;
+	u32 rec[5];
+	u64 pa;
+	u32 host, cached;
+};
+
+/* The user slots the firmware may hold: those with a PA or a host tag.  At most `max`. */
+static inline u32 g5p_ru_held_slots(const u8 *pa, const u8 *host, u32 *slots,
+				    u32 max)
+{
+	u32 n = 0;
+
+	for (u32 s = G5P_RU_SLOT_MIN; s <= G5P_RU_SLOT_MAX && n < max; s++)
+		if (g5p_le32(pa + s * 8) || g5p_le32(pa + s * 8 + 4) ||
+		    g5p_le32(host + s * 4))
+			slots[n++] = s;
+	return n;
+}
+
+/* A batch of n records fits the 256-entry ring behind an idle consumer. */
+static inline bool g5p_ru_unbind_fits(u32 n)
+{
+	return n && n <= G5P_RU_USER_SLOTS;
+}
+
+static inline u32 g5p_ru_unbind_record(u32 slot, u32 j)
+{
+	return j == 0 ? 3 : j == 1 ? slot : 0;
+}
+
+static inline void g5p_ru_slot_read(const struct g5p_ru_slot_mem *m, u32 cons,
+				    u32 prod, struct g5p_ru_slot_sample *s)
+{
+	s->cons = cons;
+	s->prod = prod;
+	for (u32 j = 0; j < 5; j++)
+		s->rec[j] = g5p_le32(m->rec[j]);
+	s->pa = (u64)g5p_le32(m->pa + 4) << 32 | g5p_le32(m->pa);
+	s->host = g5p_le32(m->host);
+	s->cached = g5p_le32(m->cached);
+}
+
+/* PA and host tag to zero, then the record.  The caller stores the producer behind a barrier. */
+static inline void g5p_ru_unbind_publish(const struct g5p_ru_slot_mem *m,
+					 u32 slot)
+{
+	g5p_put64(m->pa, 0);
+	g5p_put32(m->host, 0);
+	for (u32 j = 0; j < 5; j++)
+		g5p_put32(m->rec[j], g5p_ru_unbind_record(slot, j));
+}
+
+/* After the ring reached `target`: the record intact, PA and host tag still zero, and the
+ * firmware's tag zero too, which only its DC3 handler writes (the slot was bound with a
+ * non-zero tag).  The G5P_RU_BIND_BAD_* bits.
+ */
+static inline u32 g5p_ru_unbind_check(const struct g5p_ru_slot_sample *s,
+				      u32 slot, u32 target)
+{
+	u32 bad = 0;
+
+	if (s->cons != target || s->prod != target)
+		bad |= G5P_RU_BIND_BAD_RING;
+	for (u32 j = 0; j < 5; j++)
+		if (s->rec[j] != g5p_ru_unbind_record(slot, j))
+			bad |= G5P_RU_BIND_BAD_RECORD;
+	if (s->pa)
+		bad |= G5P_RU_BIND_BAD_PA;
+	if (s->host)
+		bad |= G5P_RU_BIND_BAD_HOST;
+	if (s->cached)
+		bad |= G5P_RU_BIND_BAD_CACHED;
+	return bad;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-close.h b/drivers/gpu/apple-g5p/render-user-close.h
new file mode 100644
index 000000000..2aa461bce
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-close.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Release of a closed render context (docs/gpu/multi-client-design.md, stage 2).
+ *
+ * A TYPED_V3 context whose handle is gone (DESTROY_CONTEXT or file close) gets one close item.
+ * It runs after the context's last job, in the job order, and decides from plain values what
+ * the firmware may still hold:
+ *
+ *   RELEASE  the firmware never held the pair: drop the references, free everything;
+ *   UNBIND   the pair is bound and every use retired: RAM-only DC3 unbind
+ *            (g5p_rv3_unbind_slots()), then free on success, retain on failure;
+ *   RETAIN   the firmware may still use the pair or its memory: keep the context, its
+ *            slots and its memory until reboot (the kexec quiesce detaches them then).
+ *
+ * The rule follows iOS AGXGart_detachSlotsAndDestroyAddressSpace (firmware-re README round 15
+ * §1, "Linux sequence" step 8): stop new jobs, wait for every engine use, publish PA and tag
+ * zero, consume the DC3, and only then recycle the slots and free the translations.  A slot
+ * returns to the allocator only after its unbind was consumed and verified, so an old unbind
+ * can never clear a new owner's PA, and the lowest free pair may be reused at once (iOS pops
+ * a freed slot off its free stack first).
+ *
+ * Pure function, host-tested (scripts/gpu/multiclient2-host/test_render_close.c).
+ */
+#ifndef G5P_RENDER_USER_CLOSE_H
+#define G5P_RENDER_USER_CLOSE_H
+
+enum g5p_ru_close_plan {
+	G5P_RU_CLOSE_RELEASE,
+	G5P_RU_CLOSE_UNBIND,
+	G5P_RU_CLOSE_RETAIN,
+};
+
+/* Why a bound or published pair is retained (bits). */
+#define G5P_RU_CLOSE_UNVERIFIED \
+	0x01U /* a bind was published but never checked out */
+#define G5P_RU_CLOSE_BAD \
+	0x02U /* a job of this context failed on the hardware */
+#define G5P_RU_CLOSE_TERMINAL 0x04U /* the epoch noted a timeout or fault */
+#define G5P_RU_CLOSE_FAILED 0x08U /* the device failed */
+#define G5P_RU_CLOSE_STOPPED 0x10U /* the device stopped (teardown, quiesce) */
+#define G5P_RU_CLOSE_SHUTDOWN \
+	0x20U /* admission closed for good (reboot quiesce) */
+#define G5P_RU_CLOSE_QUEUED 0x40U /* a job of this context is still queued */
+#define G5P_RU_CLOSE_PENDING 0x80U /* an earlier DC batch was never consumed */
+#define G5P_RU_CLOSE_LOCK 0x100U /* the command lock could not be taken */
+
+struct g5p_ru_close_in {
+	bool retained; /* the firmware may hold the pair: a DC3 bind was published */
+	bool bound; /* that bind was consumed and checked */
+	bool bad, term_failed, dev_failed, stopped, shutdown, dc_pending;
+	u32 queued;
+};
+
+static inline const char *g5p_ru_close_name(int plan)
+{
+	return plan == G5P_RU_CLOSE_RELEASE ? "release" :
+	       plan == G5P_RU_CLOSE_UNBIND  ? "unbind" :
+					      "retain";
+}
+
+/* The plan, and in *why the G5P_RU_CLOSE_* bits that made it RETAIN (0 otherwise). */
+static inline int g5p_ru_close_plan(const struct g5p_ru_close_in *in, u32 *why)
+{
+	u32 w = 0;
+
+	*why = 0;
+	if (!in->retained)
+		return in->queued ? (*why = G5P_RU_CLOSE_QUEUED,
+				     G5P_RU_CLOSE_RETAIN) :
+				    G5P_RU_CLOSE_RELEASE;
+	if (!in->bound)
+		w |= G5P_RU_CLOSE_UNVERIFIED;
+	if (in->bad)
+		w |= G5P_RU_CLOSE_BAD;
+	if (in->term_failed)
+		w |= G5P_RU_CLOSE_TERMINAL;
+	if (in->dev_failed)
+		w |= G5P_RU_CLOSE_FAILED;
+	if (in->stopped)
+		w |= G5P_RU_CLOSE_STOPPED;
+	if (in->shutdown)
+		w |= G5P_RU_CLOSE_SHUTDOWN;
+	if (in->queued)
+		w |= G5P_RU_CLOSE_QUEUED;
+	if (in->dc_pending)
+		w |= G5P_RU_CLOSE_PENDING;
+	*why = w;
+	return w ? G5P_RU_CLOSE_RETAIN : G5P_RU_CLOSE_UNBIND;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-evwait.h b/drivers/gpu/apple-g5p/render-user-evwait.h
new file mode 100644
index 000000000..ccb7d2c8f
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-evwait.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The phase wait's pause between two RAM samples (perf60-fillrate.md §11.3 cut 1): woken by the
+ * firmware event, not a fixed 1-2 ms sleep.  Host test: scripts/gpu/perf60-host/test_evwait.c.
+ *
+ * Protocol (g5p_rv3_wait):  drain -> seen = event_serial -> sample RAM -> decide -> pause.
+ * The IRQ thread's drain decodes each firmware event, bumps event_serial under status_lock and
+ * wakes the queue.  The pause sleeps until event_serial != seen or the safety timeout, so an
+ * event decoded at any point after `seen` was read (before, during or after the sample) ends the
+ * pause at once: no lost wakeup.  The timeout is the safety net for a RAM state that changes
+ * without an event; the predicate stays level-triggered on every sample, as before.
+ * Once the phase's own completion event is latched (s->event) but the RAM rules still wait
+ * (idle words, retire stamp, PM receipt land a little after the event), the pause is a short
+ * G5P_EW_POST_US poll: there is no further event to wait for.
+ */
+#ifndef G5P_RENDER_USER_EVWAIT_H
+#define G5P_RENDER_USER_EVWAIT_H
+
+#define G5P_EW_POST_US \
+	100U /* after the phase's own event: completion is imminent */
+#define G5P_EW_MAX_US 20000U /* safety timeout ceiling */
+
+enum g5p_ew_act {
+	G5P_EW_LEGACY, /* render_user_event_wake 0: usleep_range(1000, 2000), release8 */
+	G5P_EW_SHORT, /* the phase's event seen: sleep G5P_EW_POST_US */
+	G5P_EW_EVENT, /* sleep until any event since `seen`, at most *wait_us */
+};
+
+static inline enum g5p_ew_act g5p_ew_plan(u32 knob_us, bool phase_event,
+					  u32 *wait_us)
+{
+	if (!knob_us) {
+		*wait_us = 0;
+		return G5P_EW_LEGACY;
+	}
+	if (phase_event) {
+		*wait_us = G5P_EW_POST_US;
+		return G5P_EW_SHORT;
+	}
+	*wait_us = knob_us < G5P_EW_POST_US ? G5P_EW_POST_US :
+		   knob_us > G5P_EW_MAX_US  ? G5P_EW_MAX_US :
+					      knob_us;
+	return G5P_EW_EVENT;
+}
+
+/* The wait condition: an event was decoded since `seen` was read. */
+static inline bool g5p_ew_woken(u64 seen, u64 serial)
+{
+	return serial != seen;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-fault.h b/drivers/gpu/apple-g5p/render-user-fault.h
new file mode 100644
index 000000000..2af9f7513
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-fault.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * A client job that faults (docs/gpu/experiments/faultiso.md).  Pure decisions, host-tested
+ * (scripts/gpu/faultiso-host/test_fault_iso.c).
+ *
+ * On this firmware a GPU page fault is not survivable in place.  The firmware acknowledges the
+ * MMU fault itself (R0+0x138), reports it as event 4 and parks (firmware-re README "Fault
+ * ownership"); iOS answers event 4 only with its restart tail (kext 6c81dac -> 6c834a0: firmware
+ * stop, context and dependency reset, shared state rebuilt, firmware boot), and has no
+ * per-context ACK, channel reset or slot unbind for it.  The no-reset path iOS does have, the
+ * firmware's own job kill (event 8, then device-control command 0xa), is not a page fault.  So a
+ * job that stops the firmware, by a fault event or by a silent event stream, loses its context
+ * and the GPU is recovered in the boot (render_user_recover), or the epoch ends.
+ */
+#ifndef G5P_RENDER_USER_FAULT_H
+#define G5P_RENDER_USER_FAULT_H
+
+/* The errno a lost job reports: a timeout's own, else the fault's (-EIO for a fault event or a
+ * silent stream, -EPROTO, or the drain's error).  `result` is the phase's G5P_RU_WAIT_*.
+ */
+static inline int g5p_ru_lost_errno(u32 result, int err)
+{
+	return result == G5P_RU_WAIT_TIMEOUT ? -ETIMEDOUT : err;
+}
+
+/*
+ * Does a job that failed after touching the hardware fail the device too?  The legacy profiles
+ * always do.  A TYPED_V3 job does not when it timed out (nothing is wrong with the protocol and
+ * the firmware may still finish), when its bind failed (the DC ring is not on the path of the
+ * contexts already bound), or when it was lost (the executor ruled: the channel drains, or a
+ * recovery replaces the epoch).  Its context is quarantined in every case.
+ */
+static inline bool g5p_ru_job_fails_device(bool v3, int ret, bool bind_failed,
+					   bool lost)
+{
+	return !v3 || (ret != -ETIMEDOUT && !bind_failed && !lost);
+}
+
+/*
+ * A device failure noted while a job or a drain runs (a fault event decoded mid-phase), or while
+ * a recovery is pending, is not yet ruled on: the executor either loses that job's context and
+ * recovers, or ends the epoch.  Until then the other contexts wait (submit accepted and held,
+ * VM_BIND busy, context status not lost) instead of failing.  The executor sets `recovering`
+ * before it clears `executing`, so a reader that loads `executing` with acquire and then
+ * `recovering` always sees one of them through a recovery.
+ */
+static inline bool g5p_ru_ruling(bool executing, bool recovering)
+{
+	return executing || recovering;
+}
+
+/* render_user_test_fault_job: the context's job about to start (it has run `jobs` before) gets
+ * the unmapped control stream.  Never the epoch's first job: its attach and bell are special.
+ */
+static inline bool g5p_ru_fault_due(u32 fault_job, u32 jobs, bool first)
+{
+	return fault_job && jobs + 1 == fault_job && !first;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-faultreg.h b/drivers/gpu/apple-g5p/render-user-faultreg.h
new file mode 100644
index 000000000..83cac51f7
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-faultreg.h
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * perf60 fault address (render_user_fault_read, drm-render-v3.inc): decode of a GPU MMU fault
+ * status bank, R0+0xe150/e154 (bank 0) or R0+0xe158/e15c (bank 1), as high32:low32.
+ *
+ * The firmware's fault path (source 4 -> 1001a494) reads both banks with a 64-bit load, keeps
+ * only a class in its companion record and posts event 4 without the status, so the address
+ * exists only in these registers.  iOS reads them itself in its fault handler (kext 6ca5c14,
+ * accelerator virtual+740) with exactly these fields (docs/gpu/firmware-re/README.md "Complete
+ * e150 decode"): bit 0 valid, 2:1 type (0 page invalid, 2 read-only, 3 PM/META protected),
+ * 3 read (0 write), 5:4 level (3 = catalogue), 11:6 requester (iOS table 6ff5ed8), 19:12
+ * sideband, 27:20 MMU context (the slot), VA = (status >> 24) & 0xfffffffff0 (16-byte precision).
+ * Pure, host-tested (scripts/gpu/perf60-host/test_fault_decode.c).
+ */
+#ifndef G5P_RENDER_USER_FAULTREG_H
+#define G5P_RENDER_USER_FAULTREG_H
+
+#include "bits-compat.h"
+struct g5p_ru_mmu_fault {
+	bool valid, read;
+	u8 type, level, requester, sideband, context;
+	u64 va;
+};
+
+static inline struct g5p_ru_mmu_fault g5p_ru_mmu_fault_decode(u32 lo, u32 hi)
+{
+	u64 s = (u64)hi << 32 | lo;
+	struct g5p_ru_mmu_fault f = {
+		.valid = s & 1,
+		.type = (s >> 1) & 3,
+		.read = (s >> 3) & 1,
+		.level = (s >> 4) & 3,
+		.requester = (s >> 6) & 0x3f,
+		.sideband = (s >> 12) & 0xff,
+		.context = (s >> 20) & 0xff,
+		.va = (s >> 24) & 0xfffffffff0ULL,
+	};
+
+	return f;
+}
+
+static const char *const g5p_ru_mmu_fault_types[4] = {
+	"page-invalid",
+	"type1",
+	"read-only",
+	"pm-meta-protected",
+};
+
+/* Requester names, iOS kext table 6ff5ed8 (16-byte {name, class} entries; read from the j71t
+ * 16.7.10 kernelcache, 2026-11-03).  56 entries; a larger index prints its number only.
+ */
+static const char *const g5p_ru_mmu_requesters[] = {
+	"META",
+	"TLA",
+	"HOST",
+	"VDMM",
+	"CDM",
+	"IPP",
+	"PM",
+	"TILING",
+	"MCU_TEXAS0",
+	"PDS_TEXAS0",
+	"PBE0_TEXAS0",
+	"PBE1_TEXAS0",
+	"VDMS_BLACKPEARL0",
+	"IPF_BLACKPEARL0",
+	"ISP_BLACKPEARL0",
+	"TPF_BLACKPEARL0",
+	"USCS_BLACKPEARL0",
+	"PPP_BLACKPEARL0",
+	"VCE_BLACKPEARL0",
+	"FBCDC_BLACKPEARL0",
+	"MCU_TEXAS1",
+	"PDS_TEXAS1",
+	"PBE0_TEXAS1",
+	"PBE1_TEXAS1",
+	"MCU_TEXAS2",
+	"PDS_TEXAS2",
+	"PBE0_TEXAS2",
+	"PBE1_TEXAS2",
+	"VDMS_BLACKPEARL1",
+	"IPF_BLACKPEARL1",
+	"ISP_BLACKPEARL1",
+	"TPF_BLACKPEARL1",
+	"USCS_BLACKPEARL1",
+	"PPP_BLACKPEARL1",
+	"VCE_BLACKPEARL1",
+	"FBCDC_BLACKPEARL1",
+	"MCU_TEXAS3",
+	"PDS_TEXAS3",
+	"PBE0_TEXAS3",
+	"PBE1_TEXAS3",
+	"MCU_TEXAS4",
+	"PDS_TEXAS4",
+	"PBE0_TEXAS4",
+	"PBE1_TEXAS4",
+	"VDMS_BLACKPEARL2",
+	"IPF_BLACKPEARL2",
+	"ISP_BLACKPEARL2",
+	"TPF_BLACKPEARL2",
+	"USCS_BLACKPEARL2",
+	"PPP_BLACKPEARL2",
+	"VCE_BLACKPEARL2",
+	"FBCDC_BLACKPEARL2",
+	"MCU_TEXAS5",
+	"PDS_TEXAS5",
+	"PBE0_TEXAS5",
+	"PBE1_TEXAS5",
+};
+
+static inline const char *g5p_ru_mmu_requester(u32 requester)
+{
+	if (requester >= ARRAY_SIZE(g5p_ru_mmu_requesters))
+		return "?";
+	return g5p_ru_mmu_requesters[requester];
+}
+
+/* The range test of the VM edit log: does [va, va + size) hold the fault address? */
+static inline bool g5p_ru_mmu_fault_in(u64 fault_va, u64 va, u64 size)
+{
+	return fault_va >= va && fault_va - va < size;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-geometry.h b/drivers/gpu/apple-g5p/render-user-geometry.h
new file mode 100644
index 000000000..2117d567b
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-geometry.h
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_RENDER_USER_GEOMETRY_H
+#define G5P_RENDER_USER_GEOMETRY_H
+
+/* Kernel-derived render-target geometry: AGXRenderTargetMemoryG5's arithmetic
+ * leaf 6ca6d5c (firmware round16 section 3) for one sample at the pixel
+ * centre (8,8) or four samples (docs/gpu/experiments/msaa.md), in integer
+ * arithmetic only. It is Rogue's non-simple
+ * parameter format: 32x32 tiles, 4x4 macrotiles of
+ * ALIGN(DIV_ROUND_UP(tiles, 4), 4) tiles per axis, five-byte region headers
+ * per padded tile, a tail pointer cache of next_pow2(max(padded tiles))^2
+ * eight-byte entries. The scale pairs are the leaf's IEEE singles
+ * 0x3e89309c / n, 0x3fddb3d9 / n (fdiv, round to nearest even) and n * 16.
+ * tools/gpu/test_rt_oracle.c compares every output with the unmodified leaf
+ * for every width and height in 1..G5P_RU_MAX_DIM.
+ *
+ * G5P_RU_MAX_DIM is rogue_get_render_size_max() for this tiling class; it
+ * is a memory bound (16 MiB private window, 8 MiB main ring), not a field
+ * limit: the 9-bit TE macrotile and 10-bit padded-size fields would hold
+ * twice as much.
+ */
+#define G5P_RU_MAX_DIM 8192U
+#define G5P_RU_SCALE_A 0x3e89309cU
+#define G5P_RU_SCALE_B 0x3fddb3d9U
+
+static inline u32 g5p_ru_fls(u32 v)
+{
+	return v ? 32 - __builtin_clz(v) : 0;
+}
+
+/* ucvtf of 1 <= n < 2^24: exact. */
+static inline u32 g5p_ru_f32(u32 n)
+{
+	u32 bits = g5p_ru_fls(n);
+
+	return ((126 + bits) << 23) | ((n << (24 - bits)) & 0x7fffff);
+}
+
+/* fdiv of a normal positive single by 1 <= n < 2^24, round to nearest even.
+ * The quotient q of the 24-bit significand shifted by fls(n) + 3 has 27 or
+ * 28 bits; s of them are rounding bits, the remainder is the sticky bit.
+ * Results stay normal for the two leaf constants and n <= G5P_RU_MAX_DIM.
+ */
+static inline u32 g5p_ru_fdiv(u32 a, u32 n)
+{
+	u32 shift = g5p_ru_fls(n) + 3;
+	u64 num = (u64)((a & 0x7fffff) | 0x800000) << shift;
+	u32 q = num / n, sticky = num % n != 0;
+	u32 s = g5p_ru_fls(q) - 24, m = q >> s, low = q & ((1U << s) - 1);
+
+	if (low > 1U << (s - 1) ||
+	    (low == 1U << (s - 1) && (sticky || (m & 1))))
+		m++;
+	if (m >> 24) {
+		m >>= 1;
+		s++;
+	}
+	return ((((a >> 23) & 0xff) - shift + s) << 23) | (m & 0x7fffff);
+}
+
+/* Sample positions, one byte per sample: x in [3:0], y in [7:4], 1/16 px.
+ * One sample sits at the pixel centre; four use the standard Vulkan/D3D
+ * pattern, which is also Metal's (record+0x69c..0x6b8 of the iOS
+ * msaa4-resolve/-store captures: (6,2) (14,6) (2,10) (10,14)).
+ */
+#define G5P_RU_POSITIONS_1X 0x88ULL
+#define G5P_RU_POSITIONS_4X 0xeaa26e26ULL
+
+/* The leaf for one or four samples (6ca6d5c's 1, 2, 4, 8 table, of which
+ * Linux uses 1 and 4). Four samples are 2x2 per pixel: the region headers
+ * and the tail pointer cache are sized for twice the tiles in x and y, the
+ * ISP macrotile size (Rbc) doubles in y, Rb8 is log2(samples) (5940f40)
+ * and the TE word Rf0 is 5. Rb0 and Rf8 are the positions word, packed by
+ * the leaf as x0 | y0 << 4 | x1 << 8 | ... | y3 << 28. The scales, the TE
+ * tiling words and the tile count do not depend on the samples.
+ */
+static inline int g5p_ru_rt_derive_samples(u32 width, u32 height, u32 samples,
+					   u64 positions, struct g5p_ru_rt *rt)
+{
+	u32 tx = (width + 31) / 32, ty = (height + 31) / 32;
+	u32 mx = (((tx + 3) >> 2) + 3) & ~3U, my = (((ty + 3) >> 2) + 3) & ~3U;
+	u32 s = samples == 4 ? 2 : 1;
+	u32 px = mx * s * 4, py = my * s * 4, tpc;
+
+	if (!width || !height || width > G5P_RU_MAX_DIM ||
+	    height > G5P_RU_MAX_DIM || (samples != 1 && samples != 4) ||
+	    positions >> (samples * 8))
+		return -EINVAL;
+	tpc = 1U << g5p_ru_fls((px > py ? px : py) - 1);
+	*rt = (struct g5p_ru_rt) {
+		.header = px * py * 5,
+		.region = mx * my * s * s * 5,
+		.packed = positions,
+		.state = s - 1 ? 2 : 0,
+		.padded = (mx & 0x3ff) << 16 | ((my * s) & 0x3ff),
+		.scale = {
+			g5p_ru_fdiv(G5P_RU_SCALE_A, width) |
+				(u64)g5p_ru_fdiv(G5P_RU_SCALE_A, height) << 32,
+			g5p_ru_fdiv(G5P_RU_SCALE_B, width) |
+				(u64)g5p_ru_fdiv(G5P_RU_SCALE_B, height) << 32,
+			(g5p_ru_f32(width) + (4U << 23)) |
+				(u64)(g5p_ru_f32(height) + (4U << 23)) << 32,
+		},
+		.ta_state = { s - 1 ? 5 : 0, positions },
+		.ta_tiling = {
+			(u64)((ty - 1) << 12 | (tx - 1)) << 32 |
+				((height - 1) << 16 | (width - 1)),
+			(u64)(my << 18 | my << 10 | 3 * my) << 32 |
+				(mx << 18 | mx << 10 | 3 * mx),
+		},
+		.ta_tiling_word = mx * my,
+		.tiles = tx * ty,
+		.secondary = (u64)tpc * tpc * 8,
+		.secondary_align = 0x40,
+	};
+	return 0;
+}
+
+/* g5p_ru_rt64 is this function's result for 64x64. */
+
+/* PM pool for a kernel-derived target. Linux policy, not hardware: Rogue's
+ * minimum free list (50 4KiB pages, non-XE cores) plus one 4KiB PM page per
+ * tile, in 128KiB blocks, never below the latched pool and at most one F
+ * page. 64x64 (4 tiles) needs 2, so the latched 32 stays. There is no PM
+ * growth during a job: a frame that exhausts the pool fails like any OOM.
+ */
+static inline u32 g5p_ru_pm_blocks_for(u32 tiles, u32 latched)
+{
+	u64 need = ((50ULL + tiles) * 0x1000 + G5P_RU_BLOCK_BYTES - 1) /
+		   G5P_RU_BLOCK_BYTES;
+
+	if (need < latched)
+		need = latched;
+	return need > G5P_RU_MAX_BLOCKS ? G5P_RU_MAX_BLOCKS : need;
+}
+
+
+
+static inline int g5p_ru_rt_derive(u32 width, u32 height, struct g5p_ru_rt *rt)
+{
+	return g5p_ru_rt_derive_samples(width, height, 1, G5P_RU_POSITIONS_1X, rt);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-layout.h b/drivers/gpu/apple-g5p/render-user-layout.h
new file mode 100644
index 000000000..822709ed8
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-layout.h
@@ -0,0 +1,651 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_RENDER_USER_LAYOUT_H
+#define G5P_RENDER_USER_LAYOUT_H
+
+#include "bits-compat.h"
+/* Parameterized forms of the r22 fixed constructors for userspace render.
+ * Pure byte builders: no allocation, MMIO, locking or firmware publication.
+ * With r22's inputs every builder reproduces render-layout-r22.h exactly;
+ * tools/gpu/test_render_user.c checks that equivalence byte for byte.
+ */
+#include "render-layout-r22.h"
+#include "render-variants-r25.h"
+#include "render-user-template.h"
+
+/* Kernel-private window in every render VM. r22's aux/RT addresses are the
+ * first allocations, so a 64x64 target keeps the fixed path's W anchors.
+ * Root entry 0 carries the boot VA0 sink, so user maps start at 1 GiB.
+ */
+#define G5P_RU_PRIVATE_VA G5P_R22_AUX
+#define G5P_RU_PRIVATE_SIZE 0x1000000ULL
+#define G5P_RU_USER_VA_MIN 0x40000000ULL
+/* Catalogue entry of the firmware GiB, borrowed from the boot tables. */
+#define G5P_RU_FIRMWARE_CI ((G5P_IMAGE_VA >> 30) & 1023)
+#define G5P_RU_AUX_BYTES 0x10680U
+#define G5P_RU_AUX_PAGES 5U
+#define G5P_RU_RT_ALIGN 0x10000ULL
+#define G5P_RU_MAX_BLOCKS 128U
+#define G5P_RU_BLOCK_BYTES 0x20000U
+#define G5P_RU_MAX_HEADER 0x80000U
+#define G5P_RU_MAX_SECONDARY 0x100000ULL
+#define G5P_RU_TA_W_BYTES 0x560U
+#define G5P_RU_3D_W_BYTES 0x8c0U
+#define G5P_RU_CMD_BYTES 0x40U
+
+/* Kernel mirror of drm_g5p_rt_geometry (firmware round16 R-offsets). */
+struct g5p_ru_rt {
+	u32 header, region; /* R10, R20 */
+	u64 packed; /* Rb0 */
+	u32 state, padded; /* Rb8, Rbc */
+	u64 scale[3]; /* Rc0, Rc8, Rd0 */
+	u64 ta_state[2]; /* Rf0, Rf8 */
+	u64 ta_tiling[2]; /* R100, R108 */
+	u32 ta_tiling_word, tiles; /* R110, R118 */
+	u64 secondary, secondary_align; /* R138, R178 */
+};
+
+/* 6ca6d5c executed offline for 64,64,1,8,8 (round16 section 3). */
+static const struct g5p_ru_rt g5p_ru_rt64 = {
+	.header = 0x500,
+	.region = 0x50,
+	.packed = 0x88,
+	.state = 0,
+	.padded = 0x40004,
+	.scale = { 0x3b89309c3b89309cULL, 0x3cddb3d93cddb3d9ULL,
+		   0x4480000044800000ULL },
+	.ta_state = { 0, 0x88 },
+	.ta_tiling = { 0x00001001003f003fULL, 0x0010100c0010100cULL },
+	.ta_tiling_word = 0x10,
+	.tiles = 4,
+	.secondary = 0x800,
+	.secondary_align = 0x40,
+};
+
+#include "render-user-geometry.h"
+
+struct g5p_ru_rt_sizes {
+	u64 slice, main, secondary_map;
+};
+
+/* 6cb3d68: slice=R10 rounded to 4KiB; main ring is the power-of-two capacity
+ * for sixteen slices. 6cb40e0 places the secondary extent at offset 0 of
+ * its own mapping. Bounds are Linux allocation policy, not hardware limits.
+ */
+static inline int g5p_ru_rt_sizes(const struct g5p_ru_rt *rt,
+				  struct g5p_ru_rt_sizes *out)
+{
+	u64 main = 0x1000;
+
+	if (!rt->header || rt->header > G5P_RU_MAX_HEADER || !rt->secondary ||
+	    rt->secondary > G5P_RU_MAX_SECONDARY || !rt->secondary_align ||
+	    (rt->secondary_align & (rt->secondary_align - 1)) ||
+	    rt->secondary_align > G5P_GPU_PAGE || !rt->tiles)
+		return -EINVAL;
+	out->slice = ((u64)rt->header + 0xfff) & ~0xfffULL;
+	while (main < out->slice * 16)
+		main <<= 1;
+	out->main = main < G5P_GPU_PAGE ? G5P_GPU_PAGE : main;
+	out->secondary_map = (rt->secondary + G5P_GPU_PAGE - 1) &
+			     ~(u64)(G5P_GPU_PAGE - 1);
+	return 0;
+}
+
+/* 6cba480/6c7b64c anchors. Native mapping dialect: L=H, Laux=Haux.
+ * Equal to g5p_r22_rt() for g5p_ru_rt64 at the r22 addresses. 3D W58 and
+ * Wa8 are the importer's literal Rb0 and R20>>2 for the verified geometry.
+ */
+static inline void g5p_ru_rt_fill(u8 *ta, u8 *td, const struct g5p_ru_rt *rt,
+				  u64 main_va, u64 secondary_va)
+{
+	g5p_put64(ta + 0x28, main_va);
+	g5p_put64(ta + 0x30, secondary_va);
+	g5p_put64(ta + 0x38, rt->ta_state[0]);
+	g5p_put64(ta + 0x40, rt->ta_state[1]);
+	g5p_put64(ta + 0x444, secondary_va);
+	g5p_put32(ta + 0x44c, rt->secondary);
+	g5p_put64(ta + 0x3ac, rt->ta_tiling[0]);
+	g5p_put64(ta + 0x3b4, rt->ta_tiling[1]);
+	g5p_put32(ta + 0x3bc, rt->ta_tiling_word);
+	g5p_put64(td + 0x20, main_va);
+	g5p_put64(td + 0x28, rt->packed);
+	g5p_put32(td + 0x30, rt->state);
+	g5p_put32(td + 0x34, rt->padded);
+	g5p_put32(td + 0x38, rt->region);
+	g5p_put64(td + 0x3c, rt->scale[0]);
+	g5p_put64(td + 0x44, rt->scale[1]);
+	g5p_put64(td + 0x4c, rt->scale[2]);
+	g5p_put64(td + 0x58, rt->packed);
+	g5p_put32(td + 0xa8, rt->region >> 2);
+	g5p_put32(td + 0x3a0, rt->padded);
+	g5p_put64(td + 0x3d0, rt->scale[0]);
+	g5p_put64(td + 0x3d8, rt->scale[1]);
+	g5p_put32(td + 0x3e0, rt->scale[2]);
+	g5p_put32(td + 0x3e4, rt->scale[0]);
+}
+
+/* Validated typed render inputs, already range-checked by the caller. */
+struct g5p_ru_pass {
+	u64 vdm_va;
+	u32 vdm_size, vdm_control;
+	u64 scratch_va, scratch_size, scratch_ptr[6];
+	u64 pool7_va, pool7_size, pool8_va, pool8_size;
+	u32 context_pds[2][6], resume_pds[2][4], ta_pds[4];
+	u32 background[8], eot[4], eot_resume[4], restore[4];
+};
+
+/* Importer chains 6cba8a0/6c7b100/6c7b34c -> 6ca9710/6ca7ae0 (offline
+ * differential map in make-render-user-template.py). Every user VA field
+ * and code-relative descriptor lands here; the rest of W is the frozen
+ * dialect-1 scalar table or a kernel RT/channel field.
+ */
+static inline void g5p_ru_fill_ta(u8 *w, const struct g5p_ru_pass *p)
+{
+	memset(w, 0, G5P_RU_TA_W_BYTES);
+	for (u32 i = 0; i < ARRAY_SIZE(g5p_ru_ta_fixed); i++)
+		g5p_put32(w + g5p_ru_ta_fixed[i][0], g5p_ru_ta_fixed[i][1]);
+	g5p_put64(w + 0x48, p->scratch_ptr[4]);
+	g5p_put64(w + 0x50, p->scratch_ptr[5]);
+	for (u32 i = 0; i < 6; i++) {
+		g5p_put32(w + 0x58 + i * 4, p->context_pds[0][i]);
+		g5p_put32(w + 0x70 + i * 4, p->context_pds[1][i]);
+	}
+	g5p_put64(w + 0x88, p->vdm_control & ~0xfULL);
+	g5p_put64(w + 0x90, p->scratch_va & ~7ULL);
+	g5p_put64(w + 0x98, p->vdm_va & ~3ULL);
+	for (u32 i = 0; i < 4; i++) {
+		g5p_put32(w + 0xa0 + i * 4, p->resume_pds[0][i]);
+		g5p_put32(w + 0xb0 + i * 4, p->resume_pds[1][i]);
+	}
+	for (u32 i = 0; i < 3; i++)
+		g5p_put32(w + 0xc0 + i * 4, p->ta_pds[i]);
+	for (u32 i = 0; i < 4; i++)
+		g5p_put64(w + 0x468 + i * 8, p->scratch_ptr[i]);
+	g5p_put64(w + 0x488, p->scratch_ptr[4]);
+}
+
+static inline void g5p_ru_fill_3d(u8 *w, const struct g5p_ru_pass *p)
+{
+	memset(w, 0, G5P_RU_3D_W_BYTES);
+	for (u32 i = 0; i < ARRAY_SIZE(g5p_ru_3d_fixed); i++)
+		g5p_put32(w + g5p_ru_3d_fixed[i][0], g5p_ru_3d_fixed[i][1]);
+	g5p_put64(w + 0x60, p->pool8_va & ~3ULL);
+	g5p_put64(w + 0x68, p->pool7_va & ~3ULL);
+	g5p_put64(w + 0x490, p->pool7_va);
+	g5p_put64(w + 0x4a0, p->pool8_va);
+	for (u32 i = 0; i < 8; i++)
+		g5p_put32(w + 0x5b8 + i * 4, p->background[i]);
+	g5p_put32(w + 0xb0, p->background[0]);
+	g5p_put32(w + 0xb4, p->background[1]);
+	for (u32 i = 4; i < 8; i++)
+		g5p_put32(w + 0xc0 + (i - 4) * 4, p->background[i]);
+	/* 6ca7ae0 swaps the first EOT qword's halves in its B upload. */
+	g5p_put32(w + 0x3b4, p->eot[1]);
+	g5p_put32(w + 0x3b8, p->eot[0]);
+	g5p_put32(w + 0x3bc, p->eot[2]);
+	for (u32 i = 0; i < 3; i++) {
+		g5p_put32(w + 0x680 + i * 4, p->eot[i]);
+		g5p_put32(w + 0x694 + i * 4, p->eot_resume[i]);
+	}
+	g5p_put32(w + 0x600, p->restore[0]);
+	g5p_put32(w + 0x604, p->restore[1]);
+	g5p_put32(w + 0x610, p->restore[2]);
+	g5p_put32(w + 0x614, p->restore[3]);
+}
+
+/* TYPED_V2 additions, already validated by g5p_ru_pass2_check(). */
+struct g5p_ru_pass2 {
+	u64 scissor_va, dbias_va, background_texture, zls[6];
+	u64 occlusion_query_va, occlusion_query_size;
+	u32 scissor_count, dbias_count, bgobj_depth, bgobj_vals;
+	u32 pixel_width, zls_mask;
+};
+
+/* Dialect-2 words over g5p_ru_fill_3d() (TYPED_V2 has zero pools). Each
+ * register image goes to its B-upload word and to the normal builder's
+ * copy (6c7a06c); make-render-user-dialect2.py proves every position by
+ * perturbing record 2d8/2e0 (pools), 2f0/310/338/360/388/308 (ZLS), 508
+ * (background texture) and 4d0 (clears) through the r22 importer.
+ * Pixel output: 6ca7ae0 for D2f8 = width, one sample (D6e0 = 0), D630 =
+ * D6b2 = 0, six cores. Widths 2/4/8 keep two or more partitions, so W3c0
+ * and W3c4 keep their dialect-1 values; width 2 is dialect 1 exactly.
+ */
+static inline void g5p_ru_fill_3d_width(u8 *w, u32 width)
+{
+	/* 6ca7ae0's output-width code table 5942678, by D2f8 - 2. */
+	static const u8 width_code[7] = { 0, 0, 0x10, 0, 0, 0, 0x20 };
+	u32 count = 0x4000 / (width << 10);
+	u32 code = width_code[width - 2];
+
+	g5p_put32(w + 0x3c8, count & 0x1f);
+	g5p_put32(w + 0x3cc, code >> 4 | 0xf8);
+	for (u32 i = 0; i < 6; i++)
+		g5p_put64(w + 0x108 + i * 8, code | (count - 1) << 7 | 0x43);
+	g5p_put32(w + 0x6b0, width);
+}
+
+static inline void g5p_ru_fill_3d_v2(u8 *w, const struct g5p_ru_pass2 *e)
+{
+	static const u16 zls_w[6][2] = {
+		{ 0x80, 0x618 }, { 0x88, 0x628 }, { 0x90, 0x630 },
+		{ 0x98, 0x648 }, { 0xa0, 0x650 }, { 0x138, 0x6d0 },
+	};
+
+	g5p_put64(w + 0x60, e->scissor_va & ~3ULL);
+	g5p_put64(w + 0x4a0, e->scissor_va);
+	g5p_put64(w + 0x68, e->dbias_va & ~3ULL);
+	g5p_put64(w + 0x490, e->dbias_va);
+	/*
+	 * D318 is copied to both partition records. The normal 3D upload masks
+	 * the low nibble before programming ISP_OCLQRY_BASE.
+	 */
+	g5p_put64(w + 0x70, e->occlusion_query_va);
+	g5p_put64(w + 0x78, e->occlusion_query_va);
+	g5p_put64(w + 0xb8, e->background_texture);
+	g5p_put64(w + 0x5f0, e->background_texture);
+	g5p_put32(w + 0x3a4, e->bgobj_depth);
+	g5p_put32(w + 0x6a8, e->bgobj_depth);
+	g5p_put32(w + 0x3a8, e->bgobj_vals);
+	g5p_put32(w + 0x6ac, e->bgobj_vals);
+	for (u32 i = 0; i < 6; i++) {
+		g5p_put64(w + zls_w[i][0], e->zls[i]);
+		g5p_put64(w + zls_w[i][1], e->zls[i]);
+	}
+	g5p_ru_fill_3d_width(w, e->pixel_width);
+}
+
+/* TYPED_V3 additions, already validated by g5p_ru_pass3_check(). */
+struct g5p_ru_pass3 {
+	u64 ta_program_va;
+	u32 ta_program_size, vdm_end;
+	u32 pixel_width, pad; /* V1 dialect output width, 0 = 2 */
+};
+
+/* Dialect-3 word over g5p_ru_fill_ta(): W+0x88 (-> R0+0x470) is the exact
+ * byte offset of the TA PDS program from pds_base, a plain 64-bit store with
+ * no mask. g5p_ru_fill_ta() leaves it zero for a V3 pass (vdm_control is
+ * zero), so V1/V2 bytes are untouched; the stream length never reaches W.
+ */
+static inline void g5p_ru_fill_ta_v3(u8 *w, u64 program_off)
+{
+	g5p_put64(w + 0x88, program_off);
+}
+
+/* 6cb2378 selected state S at control+80: explicit zeros plus the four
+ * recovered backing pointers. N=1, PM ID0/record0. aux_va covers 10680.
+ */
+static inline int g5p_ru_pm_state(u8 *control, u64 aux_va, u64 list_va)
+{
+	memset(control + 0x80, 0, 0xc0);
+	return g5p_pm_record_backing(control + 0x80, 0, 1, aux_va, 0x80,
+				     0x10000, 0x600,
+				     g5p_meta_address(list_va + 0x40));
+}
+
+/* 6cb124c/13f4/14dc pool for `blocks` resident = maximum blocks. Rewrites
+ * control+0..7f, the whole list and F; S at control+80 is not touched.
+ * physical[] holds blocks*8 16KiB PAs. Validate everything before writing.
+ */
+static inline int g5p_ru_pm_check(u64 list_va, u64 free_va, const u64 *physical,
+				  u32 blocks)
+{
+	struct g5p_pm_sizes sizes;
+	int ret;
+
+	if (!blocks || blocks > G5P_RU_MAX_BLOCKS)
+		return -EINVAL;
+	ret = g5p_pm_sizes(1, blocks, 0x80, 0x10000, 0x600, &sizes);
+	if (ret)
+		return ret;
+	if ((list_va | free_va) & (G5P_GPU_PAGE - 1) ||
+	    list_va >= (1ULL << 40) || free_va >= (1ULL << 40) ||
+	    0x80 + blocks * 0x24 > G5P_GPU_PAGE ||
+	    blocks * 32 * 4 > G5P_GPU_PAGE)
+		return -EINVAL;
+	for (u32 i = 0; i < blocks * 8; i++)
+		if ((physical[i] & (G5P_GPU_PAGE - 1)) ||
+		    physical[i] >= (1ULL << 40))
+			return -ERANGE;
+	return 0;
+}
+
+static inline int g5p_ru_pm_pool(u8 *control, u8 *list, u8 *free, u64 list_va,
+				 u64 free_va, const u64 *physical, u32 blocks)
+{
+	u32 previous = 0;
+	int ret = g5p_ru_pm_check(list_va, free_va, physical, blocks);
+
+	if (ret)
+		return ret;
+	memset(control, 0, 0x80);
+	memset(list, 0, G5P_GPU_PAGE);
+	memset(free, 0, G5P_GPU_PAGE);
+	for (u32 j = 0; j < blocks; j++) {
+		u32 at = 0x80 + j * 0x24;
+
+		g5p_put32(list + at, previous);
+		for (u32 k = 0; k < 8; k++) {
+			u32 ppn = physical[j * 8 + k] >> 12;
+
+			g5p_put32(list + at + 4 + k * 4, ppn);
+			for (u32 p = 0; p < 4; p++)
+				g5p_put32(free + ((j * 8 + k) * 4 + p) * 4,
+					  ppn + p);
+		}
+		previous = g5p_meta_address(list_va + at);
+	}
+	g5p_put32(list + 0x60, 1);
+	g5p_put32(control + 0x10, previous);
+	g5p_put64(control + 0x14, free_va);
+	g5p_put32(control + 0x1c, blocks * 32 * 4);
+	g5p_put32(control + 0x20, blocks * 32);
+	g5p_put32(control + 0x24, blocks * 32 - 1);
+	g5p_put32(control + 0x34, G5P_GPU_PAGE);
+	g5p_put32(control + 0x40, g5p_meta_address(list_va));
+	g5p_put32(control + 0x54, blocks * 32);
+	g5p_put32(control + 0x58, blocks * 32);
+	return 0;
+}
+
+/* Complete fresh PM object: g5p_r22_pm() when blocks=32, aux=G5P_R22_AUX. */
+static inline int g5p_ru_pm(u8 *control, u8 *list, u8 *free, u64 list_va,
+			    u64 free_va, const u64 *physical, u32 blocks,
+			    u64 aux_va)
+{
+	int ret = g5p_ru_pm_check(list_va, free_va, physical, blocks);
+
+	if (ret)
+		return ret;
+	if ((aux_va & (G5P_GPU_PAGE - 1)) ||
+	    aux_va > (1ULL << 40) - G5P_RU_AUX_PAGES * G5P_GPU_PAGE)
+		return -EINVAL;
+	memset(control, 0, G5P_GPU_PAGE);
+	ret = g5p_ru_pm_pool(control, list, free, list_va, free_va, physical,
+			     blocks);
+	return ret ?: g5p_ru_pm_state(control, aux_va, list_va);
+}
+
+/* The r25 latched selections that can still yield a frame. Context/host/SKU
+ * probes and the heap-relative RT dialect are diagnostic-only in the fixed
+ * path (pair rejected) and are not offered here; blocks is pm_blocks.
+ */
+static inline bool g5p_ru_r25_valid(const struct g5p_r25_variants *v)
+{
+	return g5p_r25_valid(v) && !g5p_r25_diagnostic(v) && !v->blocks;
+}
+
+/* r25 render_pm_variant 2/3 on a pool from g5p_ru_pm()/g5p_ru_pm_pool():
+ * reverse only F's block order, or report F's whole mapped page as its
+ * extent. Equal to g5p_r25_pool() for 32, 64 and 128 blocks.
+ */
+static inline void g5p_ru_pm_variant(u8 *control, u8 *free, const u64 *physical,
+				     u32 blocks, u32 variant)
+{
+	if (variant == 2)
+		for (u32 j = 0; j < blocks; j++)
+			for (u32 k = 0; k < 8; k++) {
+				u32 ppn = physical[(blocks - 1 - j) * 8 + k] >>
+					  12;
+
+				for (u32 p = 0; p < 4; p++)
+					g5p_put32(free + ((j * 8 + k) * 4 + p) *
+								  4,
+						  ppn + p);
+			}
+	if (variant == 3)
+		g5p_put32(control + 0x1c, G5P_GPU_PAGE);
+}
+
+/* r25 render_pm_variant 1, after g5p_ru_job() built the TA page: tag6+10
+ * names an owned holder with the linked head (outside CH/ring/W/SKU/TQ/
+ * dependency); F/count/head start clear and last=ffffffff, so 10005368
+ * rebuilds them. Equal to g5p_r25_inputs() for the same pool.
+ */
+
+/* Persistent per-channel objects (6c89420 layout): written once at attach.
+ * Control indices, TQ and the dependency object stay firmware-owned after.
+ */
+static inline void g5p_ru_channel_init(u8 *p, u32 meta)
+{
+	memset(p, 0, G5P_GPU_PAGE);
+	g5p_put32(p, meta + G5P_WORK_CTL);
+	g5p_put32(p + 4, meta + G5P_WORK_RING);
+	g5p_put32(p + 8, meta + G5P_R22_TQ);
+	g5p_put32(p + 0xc, 4);
+	g5p_put32(p + 0x18, ~0U);
+	g5p_put32(p + G5P_WORK_CTL + 0x50, G5P_WORK_SLOTS);
+	g5p_put32(p + G5P_R22_TQ + 4, meta + G5P_R22_TQ);
+	g5p_put64(p + G5P_R22_DEP + 0x30, 1);
+	g5p_put64(p + G5P_R22_DEP + 0x48, ~0ULL);
+	g5p_put32(p + G5P_R22_DEP + 0x50, ~0U);
+	for (u32 off = 0x70; off < 0x270; off += 0x10)
+		g5p_put32(p + G5P_R22_DEP + off + 8, 0xf);
+}
+
+/* Pointer-ring positions of job `seq` (1-based): two entries per job. */
+static inline u32 g5p_ru_ring_index(u32 seq)
+{
+	return (2 * (seq - 1)) % G5P_WORK_SLOTS;
+}
+
+static inline u32 g5p_ru_endpoint(u32 seq)
+{
+	return (2 * seq) % G5P_WORK_SLOTS;
+}
+
+/* perf60 job slots (render_user_job_slots, drm-render-v3.inc).  A job's command, W record and
+ * microsequence ("SKU") live in slot 0 (the r22 offsets) or slot 1, in the channel page's free
+ * tail; the firmware reaches both through the job's two pointer-ring entries.  The channel header,
+ * control, pointer ring, TQ, stamps and dependency object stay shared.  Slot 1 clears TQ/STAMP/DEP
+ * (0x1800..0x1b70) and the r25 holder (G5P_R25_HEAD, 0x3000).
+ */
+#define G5P_RU_SLOT1 0x1c00U
+#define G5P_RU_SLOT1_END \
+	(G5P_RU_SLOT1 + G5P_RU_CMD_BYTES + G5P_RU_3D_W_BYTES + 0x180U)
+
+static inline u32 g5p_ru_cmd_at(u32 js)
+{
+	return js ? G5P_RU_SLOT1 : G5P_WORK_CMD;
+}
+
+static inline u32 g5p_ru_w_at(u32 js)
+{
+	return js ? G5P_RU_SLOT1 + G5P_RU_CMD_BYTES : G5P_R22_W;
+}
+
+static inline u32 g5p_ru_sku_at(u32 js, bool td)
+{
+	if (js)
+		return G5P_RU_SLOT1 + G5P_RU_CMD_BYTES + G5P_RU_3D_W_BYTES;
+	return td ? G5P_R22_3D_SKU : G5P_R22_TA_SKU;
+}
+
+/* Per-job objects for sequence `seq`: W image (fixed+typed+RT), channel W
+ * fields, the full timestamped microsequence, the tag6 PM bootstrap (TA) or
+ * tag4 TA-finish dependency (3D) and both pointer-ring entries. With seq=1
+ * this equals g5p_r22_channel(). Stamp target and sequence are both seq.
+ * ta_finish is M(TA stamp word addressed by TA.W530), used by 3D only.
+ */
+static inline void g5p_ru_job_at(u8 *p, u32 meta, u32 global, u32 pm, u32 slot,
+				 bool td, u32 seq, const u8 *image,
+				 u32 ta_finish, bool zero_timestamps, u32 js,
+				 u32 pmid)
+{
+	u32 w = meta + g5p_ru_w_at(js), state = pm + 0x80;
+	u32 finish = meta + G5P_R22_STAMP + 4;
+	u32 sku = g5p_ru_sku_at(js, td), cmd = g5p_ru_cmd_at(js);
+	u32 ring = g5p_ru_ring_index(seq);
+	u8 *work = p + g5p_ru_w_at(js);
+	u32 cursor = sku, starts, finishes;
+
+	memcpy(work, image, td ? G5P_RU_3D_W_BYTES : G5P_RU_TA_W_BYTES);
+	memset(p + sku, 0, td ? 0x180 : 0xc0);
+	g5p_put32(work, td ? 1 : 0);
+	g5p_put32(work + 4, slot);
+	g5p_put32(work + (td ? 0x14 : 0xc), meta + G5P_R22_DEP);
+	g5p_put32(work + (td ? 0x18 : 0x14), pm);
+	if (!td && pmid)
+		g5p_put32(work + 0x10,
+			  pmid); /* TA W+10: the PM identity (iOS Dcb0) */
+	g5p_put32(work + (td ? 0x1c : 0x18), state);
+	g5p_put32(work + (td ? 0xc : 0x454), meta + sku);
+	g5p_put32(work + (td ? 0x10 : 0x458), td ? 0x180 : 0xc0);
+	g5p_put32(work + (td ? 0x888 : 0x52c), finish - 4);
+	g5p_put32(work + (td ? 0x88c : 0x530), finish);
+	g5p_put32(work + (td ? 0x890 : 0x534), seq);
+	g5p_put32(work + (td ? 0x894 : 0x538), td ? 1 : 0);
+	g5p_put32(work + (td ? 0x898 : 0x53c), td ? 1 : 0);
+	g5p_put32(work + (td ? 0x8a0 : 0x544), seq);
+	{
+		u32 ta_start[] = {
+			0x23,
+			w + 0x3a4,
+			w + 0x20,
+			state,
+			global + 0x724,
+			meta,
+			slot,
+			0,
+			pmid,
+			0,
+			0,
+			0,
+			w + 0x464,
+			g5p_le32(work + 0x51c),
+			g5p_le32(work + 0x520),
+			0,
+			seq,
+		};
+		u32 td_start[] = {
+			0x25,
+			w + 0x3a0,
+			w + 0x58,
+			state,
+			global + 0x724,
+			w + 0x7f0,
+			w + 0x7f4,
+			w + 0x878,
+			meta,
+			w,
+			slot,
+			0,
+			pmid,
+			g5p_le32(work + 0x800),
+			0,
+			1,
+			w + 0x6d8,
+			g5p_le32(work + 0x87c),
+			g5p_le32(work + 0x884),
+			0,
+			seq,
+		};
+		u32 ta_finish[] = {
+			0x24,
+			state,
+			pm,
+			global + 0x724,
+			meta,
+			slot,
+			0,
+			w + 0x464,
+			g5p_le32(work + 0x51c),
+			g5p_le32(work + 0x520),
+			seq,
+			finish,
+			seq,
+			(u32)-0x70,
+		};
+		u32 td_finish[] = {
+			0x26,
+			seq,
+			finish,
+			seq,
+			state,
+			pm,
+			1,
+			global + 0x724,
+			w + 0x878,
+			w + 0x7f0,
+			meta,
+			w,
+			slot,
+			w + 0x6d8,
+			0,
+			g5p_le32(work + 0x87c),
+			g5p_le32(work + 0x884),
+			(u32)-0x104,
+		};
+		u32 result = w + (td ? 0x8ac : 0x550);
+		u32 timestamp = w + (td ? 0x8b4 : 0x558);
+		u32 ts0[] = { 0x80000018, result, timestamp, timestamp, seq };
+		u32 ts1[] = { 0x18, result, timestamp, timestamp + 4, seq };
+
+		starts = td ? ARRAY_SIZE(td_start) : ARRAY_SIZE(ta_start);
+		finishes = td ? ARRAY_SIZE(td_finish) : ARRAY_SIZE(ta_finish);
+		for (u32 i = 0; i < starts; i++, cursor += 4)
+			g5p_put32(p + cursor, td ? td_start[i] : ta_start[i]);
+		for (u32 i = 0; i < ARRAY_SIZE(ts0); i++, cursor += 4)
+			g5p_put32(p + cursor, zero_timestamps ? 1 : ts0[i]);
+		if (td) {
+			for (u32 i = 0; i < ARRAY_SIZE(g5p_r22_wait_words);
+			     i++, cursor += 4)
+				g5p_put32(p + cursor, g5p_r22_wait_words[i]);
+		} else {
+			g5p_put32(p + cursor, 0x801);
+			cursor += 4;
+		}
+		for (u32 i = 0; i < ARRAY_SIZE(ts1); i++, cursor += 4)
+			g5p_put32(p + cursor, zero_timestamps ? 1 : ts1[i]);
+		for (u32 i = 0; i < finishes; i++, cursor += 4)
+			g5p_put32(p + cursor, td ? td_finish[i] : ta_finish[i]);
+		g5p_put32(p + cursor, 0x40000017);
+	}
+	memset(p + cmd, 0, G5P_RU_CMD_BYTES);
+	g5p_put32(p + cmd, td ? 4 : 6);
+	g5p_put32(p + cmd + 4, td ? ta_finish : slot);
+	g5p_put32(p + cmd + 8,
+		  td ? seq : pmid); /* tag6 {6, STA, PMid, M(control)} */
+	g5p_put32(p + cmd + 12, td ? seq & 0x7fffffff : pm);
+	g5p_put32(p + G5P_WORK_RING + ring * 4, meta + cmd);
+	g5p_put32(p + G5P_WORK_RING + ((ring + 1) % G5P_WORK_SLOTS) * 4, w);
+}
+
+/* Retirement of job `seq`: both W pointers still ours, finish word and
+ * retirement mirror at seq, all five channel watermarks at its endpoint.
+ * g5p_r22_retired() is the seq=1 case.
+ */
+static inline bool g5p_ru_retired_at(const u8 *p, u32 meta, bool td, u32 seq,
+				     u32 js)
+{
+	const u8 *w = p + g5p_ru_w_at(js);
+	u32 endpoint = g5p_ru_endpoint(seq);
+
+	if (g5p_le32(w + (td ? 0x888 : 0x52c)) != meta + G5P_R22_STAMP ||
+	    g5p_le32(w + (td ? 0x88c : 0x530)) != meta + G5P_R22_STAMP + 4 ||
+	    g5p_le32(w + (td ? 0x890 : 0x534)) != seq ||
+	    g5p_le32(p + G5P_R22_STAMP) != seq ||
+	    g5p_le32(p + G5P_R22_STAMP + 4) != seq)
+		return false;
+	for (u32 off = 0; off <= 0x40; off += 0x10)
+		if (g5p_le32(p + G5P_WORK_CTL + off) != endpoint)
+			return false;
+	return true;
+}
+
+/* A stamp beyond the published target, or a watermark not on the even
+ * two-entry grid, is a protocol error rather than "not yet retired".
+ */
+static inline bool g5p_ru_stamp_sane(const u8 *p, u32 seq)
+{
+	for (u32 i = 0; i < 2; i++) {
+		s32 ahead = (s32)(g5p_le32(p + G5P_R22_STAMP + i * 4) - seq);
+
+		if (ahead > 0)
+			return false;
+	}
+	for (u32 off = 0; off <= 0x40; off += 0x10)
+		if (g5p_le32(p + G5P_WORK_CTL + off) >= G5P_WORK_SLOTS)
+			return false;
+	return true;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-loss.h b/drivers/gpu/apple-g5p/render-user-loss.h
new file mode 100644
index 000000000..2aad49d88
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-loss.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Per-context fault isolation (docs/gpu/multi-client-design.md "Stage 2/3 as built", fault
+ * isolation).  Pure decisions, host-tested (scripts/gpu/multiclient2-host/test_render_loss.c).
+ *
+ * The hardware gives no way to abandon a job: the firmware has no abort (iOS ends a
+ * non-progressing engine with a firmware stop, a platform power cycle and a new firmware boot,
+ * kext 6c9e070, firmware-re README "Fault recovery"), the TA and 3D channels are FIFO, and the
+ * one TA and one 3D engine serve every context.  So one context's job can be *lost* (its client
+ * gets an error, its context is dead) without ending the device only while the firmware is
+ * alive, and only if the stuck phase still finishes: until then no other job may be published
+ * behind it (it would wait behind the same engine and be lost in turn).
+ *
+ *   loss     at the end of a phase that did not complete:
+ *              NONE     it completed;
+ *              CONTEXT  a phase timeout on a job other than the epoch's first, with the firmware
+ *                       alive (its event stream never went silent, no fault event, no protocol
+ *                       error) and isolation on: the job and its context are lost, the device is
+ *                       not; the channel is blocked behind the stuck phase;
+ *              DEVICE   anything else: the epoch is terminal, as before.
+ *   drain    while blocked, the scheduler runs no job and waits, RAM only, for the stuck phase:
+ *              a late TA gets its 3D published (the channel and PM state then stay consistent),
+ *              a late 3D ends it; the channel is then clear and every held job runs.  A silent
+ *              event stream, a fault, a refused 3D or the drain bound make the epoch terminal.
+ */
+#ifndef G5P_RENDER_USER_LOSS_H
+#define G5P_RENDER_USER_LOSS_H
+
+enum g5p_ru_loss {
+	G5P_RU_LOSS_NONE,
+	G5P_RU_LOSS_CONTEXT,
+	G5P_RU_LOSS_DEVICE,
+};
+
+struct g5p_ru_loss_in {
+	u32 result; /* G5P_RU_WAIT_* of the phase */
+	bool first; /* the epoch's first job (its attach and bell) */
+	bool isolate; /* render_user_drain_ms != 0 */
+	bool silent; /* the event stream stopped: the firmware is dead */
+	bool fault; /* a fault event, a failed boot, a protocol or drain error */
+};
+
+static inline int g5p_ru_loss(const struct g5p_ru_loss_in *in)
+{
+	if (in->result == G5P_RU_WAIT_COMPLETE)
+		return G5P_RU_LOSS_NONE;
+	if (in->result != G5P_RU_WAIT_TIMEOUT || in->first || !in->isolate ||
+	    in->silent || in->fault)
+		return G5P_RU_LOSS_DEVICE;
+	return G5P_RU_LOSS_CONTEXT;
+}
+
+/* The drain of a blocked channel. */
+enum g5p_ru_drain_state {
+	G5P_RU_DRAIN_TA, /* waiting for the stuck TA */
+	G5P_RU_DRAIN_TD, /* waiting for the stuck job's 3D */
+	G5P_RU_DRAIN_CLEAR, /* done: the channel is clear */
+	G5P_RU_DRAIN_DEAD, /* the epoch is terminal */
+};
+
+/* What the drain does next. */
+enum g5p_ru_drain_action {
+	G5P_RU_DRAIN_WAIT, /* sample again */
+	G5P_RU_DRAIN_PUBLISH_TD, /* publish the stuck job's 3D, wait for it */
+	G5P_RU_DRAIN_UNBLOCK, /* release the held jobs */
+	G5P_RU_DRAIN_TERMINAL, /* note the epoch terminal, release the held jobs (they fail) */
+};
+
+/* One step from the result of the phase wait (G5P_RU_WAIT_*) in state *st.  A refused 3D
+ * publish is reported by the caller as G5P_RU_WAIT_FAULT on the TD state.
+ */
+static inline int g5p_ru_drain_step(u32 *st, u32 result)
+{
+	if (*st >= G5P_RU_DRAIN_CLEAR)
+		return *st == G5P_RU_DRAIN_CLEAR ? G5P_RU_DRAIN_UNBLOCK :
+						   G5P_RU_DRAIN_TERMINAL;
+	if (result == G5P_RU_WAIT_PENDING)
+		return G5P_RU_DRAIN_WAIT;
+	if (result != G5P_RU_WAIT_COMPLETE) {
+		*st = G5P_RU_DRAIN_DEAD;
+		return G5P_RU_DRAIN_TERMINAL;
+	}
+	if (*st == G5P_RU_DRAIN_TA) {
+		*st = G5P_RU_DRAIN_TD;
+		return G5P_RU_DRAIN_PUBLISH_TD;
+	}
+	*st = G5P_RU_DRAIN_CLEAR;
+	return G5P_RU_DRAIN_UNBLOCK;
+}
+
+/*
+ * The drain bound must leave the held clients' own wait intact.  A client waits for its job up to
+ * the job_timeout_ms GET_RENDER_INFO reports plus a margin (the ICD: + 3 s, so 2 * hard + obs + 3 s
+ * = 125 s with latency101 on, 33 s with it off), and a held job has already waited out the stuck
+ * phase (up to the hard bound, or render_user_wait_ms) before the drain starts, then runs after
+ * it.  Valid: 0 (isolation off), or from 1000 up to hard + obs - 10000 with latency101 on (hard
+ * 60000, obs 2000: 52000), and up to 8000 with it off.  An invalid value at the time of a loss
+ * turns isolation off for it.
+ */
+static inline bool g5p_ru_drain_valid(u32 drain_ms, u32 hard_ms, u32 obs_ms)
+{
+	if (!drain_ms)
+		return true;
+	if (drain_ms < 1000)
+		return false;
+	if (!hard_ms)
+		return drain_ms <= 8000;
+	return hard_ms + obs_ms >= 11000 &&
+	       drain_ms <= hard_ms + obs_ms - 10000;
+}
+
+
+
+static inline const char *g5p_ru_loss_name(int loss)
+{
+	return loss == G5P_RU_LOSS_NONE ? "none" :
+	       loss == G5P_RU_LOSS_CONTEXT ? "context" : "device";
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-mmu.h b/drivers/gpu/apple-g5p/render-user-mmu.h
new file mode 100644
index 000000000..5a05dccbf
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-mmu.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * perf60 MMU invalidation arm (render_user_mmu_inval, drm-render-v3.inc), pure helpers.
+ *
+ * The only invalidation of a user MMU context besides DC3 is the firmware's per-kick tag compare
+ * (10017ac4): diff = host_tag[S] ^ cached_tag[S]; bits 31:22 set -> e138 = (S << 3) | 4 (PC),
+ * else bits 21:12 -> | 2 (PD), else bits 11:0 -> | 1 (PT); then cached = host.  One invalidate per
+ * kick, the highest changed field (docs/gpu/firmware-re/README.md "generation producer").  A PC
+ * field change therefore asks for the firmware's PC-level invalidate of that context, the level
+ * Apple's own producer (6cabe70) and DC3 (1000218c) use as the strongest one.
+ *
+ * g5p_ru_mmu_pc_tag(): a host tag whose PC field differs from both slots' cached PC fields, so
+ * the next kick of each slot takes the PC branch.  The PD and PT fields are the given tag's.
+ * Never 0 (0 is the unbound tag) and never equal to either cached tag.  Host-tested
+ * (scripts/gpu/perf60-host/test_mmu_inval.c).
+ */
+#ifndef G5P_RENDER_USER_MMU_H
+#define G5P_RENDER_USER_MMU_H
+
+#define G5P_RU_MMU_PC_MASK 0xffc00000U
+#define G5P_RU_MMU_PC_ONE 0x00400000U
+
+/* render_user_mmu_inval bits */
+#define G5P_RU_MMU_EDIT \
+	0x1U /* every VM edit publication (and spare adoption) asks for PC */
+#define G5P_RU_MMU_SWITCH \
+	0x2U /* a bound context's job after another context's job: PC retag */
+#define G5P_RU_MMU_TOUCH \
+	0x4U /* NC read of every table line before the tag store */
+#define G5P_RU_MMU_EVERY \
+	0x8U /* every job of a bound context: PC retag (superset of SWITCH) */
+
+static inline u32 g5p_ru_mmu_pc_tag(u32 tag, u32 cached0, u32 cached1)
+{
+	u32 pc = (tag & G5P_RU_MMU_PC_MASK) + G5P_RU_MMU_PC_ONE;
+
+	/* At most two values are excluded, so three candidates always contain a free one. */
+	for (u32 i = 0; i < 3; i++, pc += G5P_RU_MMU_PC_ONE) {
+		u32 t = (pc & G5P_RU_MMU_PC_MASK) | (tag & ~G5P_RU_MMU_PC_MASK);
+
+		if (((t ^ cached0) & G5P_RU_MMU_PC_MASK) &&
+		    ((t ^ cached1) & G5P_RU_MMU_PC_MASK) && t)
+			return t;
+	}
+	return 0; /* unreachable: kept for the host test */
+}
+
+/*
+ * Retag on a job: the published host tag, or the cached one if none, moved to a fresh PC field.
+ */
+static inline bool g5p_ru_mmu_retag_due(u32 mode, bool bound_before,
+					bool switched)
+{
+	if (!bound_before)
+		return false; /* this job's DC3 or adoption publishes its own tag */
+	return (mode & G5P_RU_MMU_EVERY) ||
+	       ((mode & G5P_RU_MMU_SWITCH) && switched);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-msaa.h b/drivers/gpu/apple-g5p/render-user-msaa.h
new file mode 100644
index 000000000..f27f197a6
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-msaa.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef G5P_RENDER_USER_MSAA_H
+#define G5P_RENDER_USER_MSAA_H
+
+#include "bits-compat.h"
+/* TYPED_V3 4x multisampling: the per-job words a pass with a 4-sample render
+ * target needs on top of the V1/V2 3D words and the target's geometry
+ * (g5p_ru_rt_derive_samples()). Pure byte builders over the kernel's own
+ * work records: no allocation, MMIO, locking or firmware publication.
+ *
+ * Evidence (docs/gpu/experiments/msaa.md): the iOS gles3/gles3b captures
+ * 20261101T175626Z, msaa4-resolve, msaa4-store, g3b-a2c and g3b-samplemask,
+ * against g3-base, and the importer's 3D/TA fillers 6ca7ae0/6ca9710 executed
+ * with the 4-sample descriptor (build/gpu/msaa/filler-msaa.c):
+ *   record+0x4d8 0xf -> 0x7   D6a8 -> 3D W3c0[3:0] (ISP_CTL; the draws'
+ *                             ISPCTL.upass drops 0xf -> 0x7 with it)
+ *   record+0x640 0 -> 1       D6ad -> 3D W3c0 bit 17 and W86c (resolve only;
+ *                             bit 17 is ISP_CTL.PROCESS_EMPTY_TILES, which
+ *                             Linux's template sets for every pass since
+ *                             0e05f993cf, so only W86c is new)
+ *   RT Rb8 0 -> 2             D6e0 -> 3D Wd0 (AA mode, CR f30), and the
+ *                             pixel-output shift 10 -> 11 in W3c0 [21],
+ *                             W3c4, W3c8 and the six W108 words
+ *   RT Rb0 / Rf8              3D W58 (CR fa8) / TA W40 (PPP_MULTISAMPLECTL)
+ * The rest of the target's geometry reaches W through g5p_ru_rt_fill().
+ */
+#define G5P_RU_MSAA_RESOLVE 1U /* DRM_G5P_RENDER_MSAA_RESOLVE */
+
+struct g5p_ru_msaa {
+	u32 samples, flags; /* 0 = 1 */
+	u64 positions; /* 0 = the target's */
+};
+
+/* samples 0 or 1 is the one-sample pass and must use a one-sample target;
+ * 4 must use a four-sample target. Positions are one byte per sample, so a
+ * word with bits above the sample count is malformed; zero takes the
+ * target's (the standard pattern). Resolve exists only with four samples.
+ * Nothing here is a hardware hazard: positions are a 4-bit grid and the
+ * resolve bit changes what the PBE writes, not where.
+ */
+static inline int g5p_ru_msaa_check(const struct g5p_ru_msaa *m, u32 rt_samples)
+{
+	u32 s = m->samples ? m->samples : 1;
+
+	if ((s != 1 && s != 4) || s != rt_samples ||
+	    m->flags & ~G5P_RU_MSAA_RESOLVE || (m->flags && s == 1) ||
+	    m->positions >> (s * 8))
+		return -EINVAL;
+	return 0;
+}
+
+/* After g5p_ru_fill_3d(), the dialect's width words and g5p_ru_rt_fill().
+ * A one-sample pass is left as it is, unless it names its position.
+ */
+static inline void g5p_ru_fill_msaa(u8 *ta, u8 *td, const struct g5p_ru_msaa *m,
+				    const struct g5p_ru_rt *rt)
+{
+	/* 6ca7ae0's output-width code table 5942678, by width - 2. */
+	static const u8 width_code[7] = { 0, 0, 0x10, 0, 0, 0, 0x20 };
+	u64 positions = m->positions ? m->positions : rt->packed;
+	bool resolve = m->flags & G5P_RU_MSAA_RESOLVE;
+	u32 width, count, mode, w3c0;
+
+	if (m->samples != 4 && !m->positions)
+		return;
+	g5p_put64(ta + 0x40, positions);
+	g5p_put64(td + 0x58, positions);
+	if (m->samples != 4)
+		return;
+	/* The width the dialect wrote (2, 4 or 8); 6ca7ae0 shifts by 11 with an
+	 * AA mode, so each width has half the output partitions.
+	 */
+	width = g5p_le32(td + 0x6b0);
+	count = 0x4000 / (width << 11);
+	mode = count > 1 ? 2 : count;
+	w3c0 = g5p_le32(td + 0x3c0) & ~(0xfU | BIT(21));
+	g5p_put32(td + 0x3c0,
+		  w3c0 | 0x7 | (resolve ? BIT(17) : 0) | (mode - 1) << 21);
+	g5p_put32(td + 0x3c4, mode * 0x204);
+	g5p_put32(td + 0x3c8, count & 0x1f);
+	for (u32 i = 0; i < 6; i++)
+		g5p_put64(td + 0x108 + i * 8,
+			  width_code[width - 2] | (count - 1) << 7 | 0x43);
+	g5p_put64(td + 0xd0, rt->state);
+	g5p_put32(td + 0x86c, resolve);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-pmset.h b/drivers/gpu/apple-g5p/render-user-pmset.h
new file mode 100644
index 000000000..170738f1f
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-pmset.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Per-context PM records (perf60 stage 4, docs/gpu/multi-client-design.md risk R3).
+ *
+ * iOS acquires a ParamBuffer ID per prepare from a 127-entry pool (6cb9afc) and builds a PM
+ * control/state/aux object and its block list per PM (6cb2378); one PM is never shared by two
+ * work queues.  Linux built one device PM (control+S at shared+G5P_R22_PM, list and F in the
+ * two render_meta pages, aux at G5P_RU_PRIVATE_VA) for every render context; with the GPU
+ * never parked, one context's job then started from the PM state another context's job left.
+ *
+ * boot_pm_sets reserves N sets in the firmware GiB at boot, right after render_meta: set s is
+ * three pages {control + S, list, F} at G5P_PMSET_VA + s * 3 pages, mapped like the shared
+ * pages (they are firmware objects the firmware and the PM requesters address by meta VA).
+ * A render context takes one set, its own pool pages and its own aux pages.  PM ID: 0 stays
+ * the device PM's; set s may carry s + 1.
+ *
+ * Pure helpers, host-tested (scripts/gpu/perf60-host/test_pmset.c).
+ */
+#ifndef G5P_RENDER_USER_PMSET_H
+#define G5P_RENDER_USER_PMSET_H
+
+#define G5P_PMSET_MAX 8U
+#define G5P_PMSET_PAGES 3U /* control + S, list, F */
+#define G5P_PMSET_VA (G5P_SHARED_VA + G5P_SHARED_SIZE + 2 * G5P_GPU_PAGE)
+#define G5P_PMSET_END \
+	(G5P_PMSET_VA + G5P_PMSET_MAX * G5P_PMSET_PAGES * G5P_GPU_PAGE)
+
+enum { G5P_PMSET_CONTROL, G5P_PMSET_LIST, G5P_PMSET_FREE };
+
+static inline u64 g5p_pmset_va(u32 set, u32 part)
+{
+	return G5P_PMSET_VA +
+	       ((u64)set * G5P_PMSET_PAGES + part) * G5P_GPU_PAGE;
+}
+
+static inline u32 g5p_pmset_id(u32 set)
+{
+	return set + 1;
+}
+
+/*
+ * The PM's write-back target (release8 bench-gaps3, 2026-11-03).  After the GPU switches from
+ * context A's jobs to context B's, the firmware's PM keeps writing A's free list F back, through
+ * A's TA slot (its MMU context), on B's later jobs, until a job of a third context runs: two
+ * faults, one on the 2nd and one on the 3rd job of B after A's last, both the first job after A
+ * was unbound (page-invalid level 2 in A's MMU context, A's set F page; with A still bound the
+ * same writes landed).  So a context's slots and set stay bound while it is the context of the
+ * last job or the previous *distinct* one: g5p_pmset_track() at every job end, g5p_pmset_holds()
+ * at close.  That bounds when the slots may go, not when the PM stops: two later faults (release8
+ * quiet2, seq 858 and 893) wrote the free list of a context two switches back, after this rule had
+ * released it.  So a released pair is parked rather than left empty (render_user_close_park,
+ * drm-render-v3.inc), and a released set is reused last (g5p_pmset_pick()).
+ */
+static inline bool g5p_pmset_switched(const void *last, const void *job)
+{
+	return last != job;
+}
+
+static inline bool g5p_pmset_holds(const void *last, const void *prev,
+				   const void *ctx)
+{
+	return ctx && (ctx == last || ctx == prev);
+}
+
+/* A free set, round-robin from `next` (a released set is reused last). -1: none free. */
+static inline int g5p_pmset_pick(const bool *used, u32 n, u32 next)
+{
+	for (u32 i = 0; i < n; i++) {
+		u32 s = (next + i) % n;
+
+		if (!used[s])
+			return s;
+	}
+	return -1;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-quiesce.h b/drivers/gpu/apple-g5p/render-user-quiesce.h
new file mode 100644
index 000000000..3671e415e
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-quiesce.h
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The GPU quiesce before a kexec, reboot or power-off (docs/gpu/experiments/mcfold2-kexec.md).
+ *
+ * Without it the firmware keeps running from the outgoing kernel's RAM across the relocation:
+ * it still writes its event rings, and the MMU still holds a CBASE for every bound render slot
+ * pointing at page tables the next kernel reuses, until the next kernel's PMGR GFX cycle about
+ * 0.4 s into its boot.  The quiesce ends that window on the outgoing side, in this order:
+ *
+ *   1 close job admission and wait (bounded) for submitters inside;
+ *   2 take the command lock (bounded trylock), so no job or command is in flight;
+ *   3 DETACH: every user slot the firmware may hold is unbound by a RAM-only DC3 batch
+ *     (render-user-bind.h), only when the lock is ours, the firmware is healthy, no timeout
+ *     or fault was noted and the DC ring is idle;
+ *   4 freeze the boot state and mask the GPU IRQ (no host register access after this);
+ *   5 CYCLE: one bounded PMGR GFX off/on, the same gate cycle the next kernel performs with
+ *     apple_pmgr.kexec_gpu_cycle=1, only when no host thread can be inside a GPU register
+ *     access: the lock is ours, or its holder is the TYPED_V3 executor in its RAM-only regime.
+ *
+ * Pure functions over the ops below, host-tested (scripts/gpu/mcfold2-host/test_kexec_quiesce.c).
+ */
+#ifndef G5P_RENDER_USER_QUIESCE_H
+#define G5P_RENDER_USER_QUIESCE_H
+
+/* kexec_quiesce module parameter */
+#define G5P_RU_KQ_OFF 0U
+#define G5P_RU_KQ_RAM 1U /* detach only, no PMGR access */
+#define G5P_RU_KQ_FULL 2U /* detach and cycle (default) */
+
+/* Plan */
+#define G5P_RU_KQ_DETACH 0x1U
+#define G5P_RU_KQ_CYCLE 0x2U
+
+/* Why a step was skipped */
+#define G5P_RU_KQ_WHY_OFF 0x001U /* kexec_quiesce=0 */
+#define G5P_RU_KQ_WHY_DOWN 0x002U /* the firmware never ran on this boot */
+#define G5P_RU_KQ_WHY_BUSY 0x004U /* the command lock is not ours: no detach */
+#define G5P_RU_KQ_WHY_FAILED \
+	0x008U /* fault or protocol failure: firmware state unknown */
+#define G5P_RU_KQ_WHY_WEDGED \
+	0x010U /* a TYPED_V3 timeout or fault: a job may hold its slots */
+#define G5P_RU_KQ_WHY_RING 0x020U /* the DC ring is not idle */
+#define G5P_RU_KQ_WHY_NONE 0x040U /* no user slot is held */
+#define G5P_RU_KQ_WHY_HOLDER \
+	0x080U /* unknown lock holder, maybe inside MMIO: no cycle */
+#define G5P_RU_KQ_WHY_NO_PMGR 0x100U
+#define G5P_RU_KQ_WHY_RAM 0x200U /* kexec_quiesce=1: no cycle */
+#define G5P_RU_KQ_WHY_NO_DRM 0x400U /* no render frontend: nobody can detach */
+
+struct g5p_ru_kq_in {
+	u32 mode; /* kexec_quiesce */
+	bool booted; /* the firmware was released on this boot */
+	bool locked; /* the command lock is ours */
+	bool failed; /* b->failed or b->event_failed */
+	bool frontend; /* a render frontend that can detach is registered */
+	bool term_failed; /* the TYPED_V3 latch noted a timeout or fault */
+	bool ram_only; /* the TYPED_V3 latch is quiet: its executor touches no register */
+	bool executing; /* the TYPED_V3 executor is inside a job */
+	bool ring_idle; /* DC consumer == producer <= 255 */
+	bool pmgr; /* the PMGR regmap is present */
+	u32 held; /* user slots with a PA or a host tag */
+	u32 cons, prod; /* the DC ring when sampled */
+};
+
+static inline u32 g5p_ru_kq_plan(const struct g5p_ru_kq_in *in, u32 *why)
+{
+	u32 plan = 0, w = 0;
+
+	if (in->mode == G5P_RU_KQ_OFF || !in->booted) {
+		*why = in->mode == G5P_RU_KQ_OFF ? G5P_RU_KQ_WHY_OFF :
+						   G5P_RU_KQ_WHY_DOWN;
+		return 0;
+	}
+	if (!in->locked)
+		w |= G5P_RU_KQ_WHY_BUSY;
+	if (in->failed)
+		w |= G5P_RU_KQ_WHY_FAILED;
+	if (in->term_failed)
+		w |= G5P_RU_KQ_WHY_WEDGED;
+	if (!in->ring_idle)
+		w |= G5P_RU_KQ_WHY_RING;
+	if (!in->held)
+		w |= G5P_RU_KQ_WHY_NONE;
+	if (!in->frontend)
+		w |= G5P_RU_KQ_WHY_NO_DRM;
+	if (!w)
+		plan |= G5P_RU_KQ_DETACH;
+	if (in->mode < G5P_RU_KQ_FULL)
+		w |= G5P_RU_KQ_WHY_RAM;
+	else if (!in->pmgr)
+		w |= G5P_RU_KQ_WHY_NO_PMGR;
+	else if (!in->locked && !(in->executing && in->ram_only))
+		w |= G5P_RU_KQ_WHY_HOLDER;
+	else
+		plan |= G5P_RU_KQ_CYCLE;
+	*why = w;
+	return plan;
+}
+
+struct g5p_ru_kq_ops {
+	void *ctx;
+	u32 (*admit_close)(void *ctx); /* close admission; submitters still inside */
+	bool (*lock)(void *ctx); /* bounded trylock of the command lock */
+	void (*unlock)(void *ctx);
+	void (*inputs)(void *ctx, struct g5p_ru_kq_in *in); /* RAM only */
+	int (*detach)(void *ctx); /* RAM only */
+	void (*freeze)(void *ctx); /* RAM only */
+	void (*irq_off)(void *ctx); /* AIC ack, mask, wait for the handler */
+	int (*cycle)(void *ctx); /* PMGR only */
+};
+
+struct g5p_ru_kq_out {
+	struct g5p_ru_kq_in in;
+	u32 inside, plan, why;
+	int detach_ret, cycle_ret;
+	bool froze;
+};
+
+/* One quiesce.  detach_ret/cycle_ret stay 0 for a step that did not run (see plan). */
+static inline void g5p_ru_kq_run(const struct g5p_ru_kq_ops *o, u32 mode,
+				 struct g5p_ru_kq_out *out)
+{
+	*out = (struct g5p_ru_kq_out){ .in.mode = mode };
+	if (mode == G5P_RU_KQ_OFF) {
+		out->why = G5P_RU_KQ_WHY_OFF;
+		return;
+	}
+	out->inside = o->admit_close(o->ctx);
+	out->in.locked = o->lock(o->ctx);
+	o->inputs(o->ctx, &out->in);
+	out->plan = g5p_ru_kq_plan(&out->in, &out->why);
+	if (out->plan & G5P_RU_KQ_DETACH)
+		out->detach_ret = o->detach(o->ctx);
+	if (out->in.booted) {
+		o->freeze(o->ctx);
+		o->irq_off(o->ctx);
+		out->froze = true;
+	}
+	if (out->plan & G5P_RU_KQ_CYCLE)
+		out->cycle_ret = o->cycle(o->ctx);
+	if (out->in.locked)
+		o->unlock(o->ctx);
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-recover.h b/drivers/gpu/apple-g5p/render-user-recover.h
new file mode 100644
index 000000000..51982c5c5
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-recover.h
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * In-boot GPU recovery: the firmware's recovery packet and the recovery decision.  Pure,
+ * host-tested (scripts/gpu/perf60-host/test_recover.c).
+ *
+ * The recovery packet is firmware event type 4 (44 bytes).  The AGX kext's event drain
+ * (AGXFirmware_drainFirmwareEventRing 6c99788, case 4) reads +0x0c (the faulting slot, 0x80 for
+ * -1), +0x10 (a flag, accel+0x1af8 bit 3), +0x18, +0x20 and +0x24 (accel+0x1a1c/0x1af4/0x1af0),
+ * marks a recovery pending (accel+0x1a24 = 2) and calls IOGPUScheduler_signalHardwareError(sched,
+ * 1) (6c67b4c): "GPURestartSignaled", the scheduler enqueues one GPU restart (a second signal
+ * before it runs is "Redundant hardware error").  The restart is
+ * AGXMetaFirmware_stopForRecoveryOptionalPowerCycle (6ca1e40) and
+ * AGXMetaFirmware_rebootAfterRecovery (6ca1efc), which panics only if the firmware does not boot
+ * again.  There is no per-boot limit: every recovery packet restarts the GPU.  The
+ * kext does not read +0x04.
+ *
+ * On A9/Linux the slot matches the phase the host waited in: 0 on every TA fault, 1 on the 3D fault
+ * of cf7 (2026-11-02); +0x20 = 8 and +0x24 = 0x81818105 (TA) / 0x81810581 (3D) so far.
+ */
+#ifndef G5P_RENDER_USER_RECOVER_H
+#define G5P_RENDER_USER_RECOVER_H
+
+#define G5P_FW_EVENT_RECOVERY 4
+#define G5P_FW_RECOVERY_NOSLOT 0x80
+
+struct g5p_fw_recovery {
+	u32 code; /* +0x04, not read by the kext */
+	u32 slot; /* +0x0c, G5P_FW_RECOVERY_NOSLOT for -1 */
+	u32 flag; /* +0x10 != 0 */
+	u32 w18, w20, w24;
+};
+
+/* `w` is the 11-word event entry, type 4. */
+static inline struct g5p_fw_recovery g5p_fw_recovery_decode(const u32 *w)
+{
+	struct g5p_fw_recovery r = {
+		.code = w[1],
+		.slot = w[3] == 0xffffffffU ? G5P_FW_RECOVERY_NOSLOT : w[3],
+		.flag = w[4] != 0,
+		.w18 = w[6],
+		.w20 = w[8],
+		.w24 = w[9],
+	};
+
+	return r;
+}
+
+/*
+ * May a job that stopped the firmware (a recovery packet, a silent event stream, a hard timeout)
+ * be recovered from in this boot, the job's context lost and every other kept?
+ *
+ *   budget == 0      never (render_user_recover 0: the epoch ends, as before);
+ *   retired/closed   never (the boot is shutting the GPU down);
+ *   streak_max == 0  the old rule: `budget` recoveries per boot, never on the epoch's first job;
+ *   streak_max != 0  Apple's rule, every time, with two guards: at most streak_max recoveries in a
+ *                    row with no job completing between them (a GPU that faults again before it
+ *                    finishes anything is not recovering), and at most G5P_RU_RECOVER_BOOT_MAX per
+ *                    boot (recover.inc leaves each old epoch allocated, ~0.8 MiB: 50 x 16 KiB pages
+ *                    and its struct, so a stale pointer still reads valid memory; this bounds that
+ *                    to ~26 MiB).  The boot's first epoch's first job stays terminal (a failed
+ *                    bring-up, not a client); the first job of a later epoch (the attach after a
+ *                    recovery) is recoverable like any other.
+ */
+#define G5P_RU_RECOVER_BOOT_MAX 32
+
+struct g5p_ru_recover_in {
+	bool first; /* the job runs its epoch's attach */
+	bool retired; /* the GPU was retired (kexec / reboot quiesce) */
+	bool closed; /* admission closed */
+	u32 recoveries; /* recoveries this boot */
+	u32 streak; /* recoveries since the last job completed */
+	u32 budget; /* render_user_recover */
+	u32 streak_max; /* render_user_recover_streak */
+};
+
+static inline bool g5p_ru_recoverable(const struct g5p_ru_recover_in *in)
+{
+	if (!in->budget || in->retired || in->closed)
+		return false;
+	if (!in->streak_max)
+		return !in->first && in->recoveries < in->budget;
+	if (in->first && !in->recoveries)
+		return false;
+	return in->streak < in->streak_max &&
+	       in->recoveries < G5P_RU_RECOVER_BOOT_MAX;
+}
+
+/* Why g5p_ru_recoverable() said no (for the terminal line), or "-" when it said yes. */
+static inline const char *
+g5p_ru_recover_refusal(const struct g5p_ru_recover_in *in)
+{
+	if (!in->budget)
+		return "recover-off";
+	if (in->retired || in->closed)
+		return "shutdown";
+	if (!in->streak_max)
+		return in->first		    ? "first-job" :
+		       in->recoveries >= in->budget ? "per-boot-budget" :
+						      "-";
+	if (in->first && !in->recoveries)
+		return "first-job";
+	if (in->streak >= in->streak_max)
+		return "streak";
+	return in->recoveries >= G5P_RU_RECOVER_BOOT_MAX ? "boot-max" : "-";
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-retire.h b/drivers/gpu/apple-g5p/render-user-retire.h
new file mode 100644
index 000000000..6e5729003
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-retire.h
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * TYPED_V3 3D completion: target coherence and engine idle, decided separately.  Pure
+ * functions, no kernel services beyond the integer types, so the host suite compiles this
+ * file as it is.  Include render-user-wait.h first.
+ *
+ * combined107 P4R seq 4 (build/gpu/combined107/raw/20261031T145710Z): the 3D target state
+ * was coherent (ring consumer = producer = target 4, both stamps 4, W+0x888/0x88c ours,
+ * W+0x890 = 4, all five channel watermarks at endpoint 8, and the firmware's type-1 3D
+ * completion event with the endpoint pair 7/8 decoded at publish + 19999 ms), yet the
+ * wait timed out at 60002 ms.  The wait is a 1-2 ms RAM poll (no waitqueue, no wake), so
+ * this was not a lost edge: the done predicate also required the 3D global's idle words
+ * (G+0x724/0x728/0x72c/0x734/0x738) to be zero, and they never cleared.
+ *
+ * The 3D phase is complete when either
+ *   (a) the target is coherent and the idle words are zero (the flown r96 predicate), or
+ *   (b) the target is coherent and the matching 3D completion event was decoded after this
+ *       job's 3D publish (idle_stuck).  The event is the firmware's completion report, the
+ *       signal a fence follows on Asahi too; the idle words lag it by an arbitrary time.
+ *       settle_ms (default 0) only adds a minimum length of the coherent run, or
+ *   (c) the target has been coherent, unbroken, for G5P_RU_RT_HOLD_MS (at least settle_ms):
+ *       tahang1, as the TA's rule (c), so a lost or late event does not hold a job whose
+ *       stamps landed.  The PM state needs no clause here: the TA phase, which the 3D
+ *       publish waits for, required it saved.
+ * Target coherent = ring consumer == target && g5p_ru_retired(): both stamps == seq, the W
+ * stamp pointers ours, the W sequence word == seq, every channel watermark == endpoint.
+ * The stamps carry the identity (31-bit sequence, one per job); the watermarks and the
+ * event's endpoint pair repeat every eight jobs and only corroborate.  The TA phase has its
+ * own rules (tahang1, below).
+ */
+#ifndef G5P_RENDER_USER_RETIRE_H
+#define G5P_RENDER_USER_RETIRE_H
+
+#define G5P_RU_RT_DEF_SETTLE_MS 0U /* default of render_user_idle_settle_ms */
+#define G5P_RU_RT_MAX_SETTLE_MS \
+	5000U /* far below the smallest per-phase bound (20 s) */
+#define G5P_RU_RT_GRID 16U /* the channel watermark grid, G5P_WORK_SLOTS */
+#define G5P_RU_RT_HOLD_MS \
+	500U /* rule (c), raised to settle_ms when that is longer */
+
+/* Clauses of the 3D predicate, as the receipt's `unsat` bits (set = not satisfied). */
+#define G5P_RU_RT_CONSUMED 0x1U /* ring consumer != target */
+#define G5P_RU_RT_RETIRED 0x2U /* g5p_ru_retired() false */
+#define G5P_RU_RT_IDLE 0x4U /* an idle word is non-zero */
+#define G5P_RU_RT_EVENT 0x8U /* no matching completion event latched */
+#define G5P_RU_RT_SETTLE \
+	0x10U /* coherent, run shorter than the settle or hold window */
+#define G5P_RU_RT_PM 0x20U /* TA receipt only: the PM state is not saved */
+
+enum g5p_ru_rt_how {
+	G5P_RU_RT_PENDING,
+	G5P_RU_RT_IDLE_CLEAR, /* rule (a) */
+	G5P_RU_RT_IDLE_STUCK, /* rule (b) */
+	G5P_RU_RT_HOLD, /* rule (c) */
+};
+
+struct g5p_ru_retire {
+	u64 settle_ns; /* minimum coherent run before rule (b); 0 = none */
+	u64 hold_ns; /* rule (c): max(settle_ns, G5P_RU_RT_HOLD_MS) */
+	u64 run_ns; /* first sample of the current coherent run; 0 = none */
+	u64 coherent_ns; /* first coherent sample of the phase */
+	u64 event_ns; /* first sample that saw the matching event latched */
+	u64 busy_ns; /* first sample with an idle word set */
+	u64 clear_ns; /* first all-clear sample after busy_ns */
+	u32 run; /* samples in the current coherent run */
+	u32 breaks; /* coherent runs that ended without a decision */
+	u32 unsat; /* G5P_RU_RT_* of the last sample */
+	u32 how; /* enum g5p_ru_rt_how of the last sample */
+	u32 decided; /* enum g5p_ru_rt_how of the sample that decided COMPLETE */
+};
+
+static inline bool g5p_ru_rt_settle_valid(u32 settle_ms)
+{
+	return settle_ms <= G5P_RU_RT_MAX_SETTLE_MS;
+}
+
+static inline void g5p_ru_rt_start(struct g5p_ru_retire *t, u32 settle_ms)
+{
+	u32 hold_ms = settle_ms > G5P_RU_RT_HOLD_MS ? settle_ms :
+						      G5P_RU_RT_HOLD_MS;
+
+	*t = (struct g5p_ru_retire){
+		.settle_ns = (u64)settle_ms * 1000000ULL,
+		.hold_ns = (u64)hold_ms * 1000000ULL,
+	};
+}
+
+/* The firmware's 3D completion is a type-1 event with notification bit 1 (engine 1) whose
+ * words 8/9 are the channel endpoint pair (2 seq - 1, 2 seq): 1/2, 3/4, 5/6, 7/8 for
+ * combined107 seq 1..4.  The grid wraps at G5P_RU_RT_GRID, so the pair is compared modulo
+ * the grid whether the firmware reports it wrapped or as a running count: endpoint 0
+ * (seq 8) matches 15/0 and 15/16 alike.
+ */
+static inline bool g5p_ru_rt_event_match(const u32 words[11], u32 endpoint)
+{
+	return words[0] == 1 && (words[1] & 2) &&
+	       words[9] % G5P_RU_RT_GRID == endpoint % G5P_RU_RT_GRID &&
+	       (words[9] - words[8]) % G5P_RU_RT_GRID == 1;
+}
+
+/* One RAM sample of the 3D phase at now_ns.  Returns the rule that completes it (enum
+ * g5p_ru_rt_how); the caller passes `!= G5P_RU_RT_PENDING` to g5p_ru_wait_step()/close().
+ */
+static inline u32 g5p_ru_rt_step(struct g5p_ru_retire *t, u64 now_ns,
+				 bool consumed, bool retired, bool idle,
+				 bool event)
+{
+	t->unsat = (consumed ? 0 : G5P_RU_RT_CONSUMED) |
+		   (retired ? 0 : G5P_RU_RT_RETIRED) |
+		   (idle ? 0 : G5P_RU_RT_IDLE) | (event ? 0 : G5P_RU_RT_EVENT);
+	if (event && !t->event_ns)
+		t->event_ns = now_ns;
+	if (!idle && !t->busy_ns)
+		t->busy_ns = now_ns;
+	if (idle && t->busy_ns && !t->clear_ns)
+		t->clear_ns = now_ns;
+	t->how = G5P_RU_RT_PENDING;
+	if (!consumed || !retired) {
+		if (t->run)
+			t->breaks++;
+		t->run = 0;
+		t->run_ns = 0;
+		return t->how;
+	}
+	if (!t->coherent_ns)
+		t->coherent_ns = now_ns;
+	if (!t->run++)
+		t->run_ns = now_ns;
+	if (idle)
+		t->how = G5P_RU_RT_IDLE_CLEAR;
+	else if (event && now_ns - t->run_ns >= t->settle_ns)
+		t->how = G5P_RU_RT_IDLE_STUCK;
+	else if (now_ns - t->run_ns >= t->hold_ns)
+		t->how = G5P_RU_RT_HOLD;
+	else
+		t->unsat |= G5P_RU_RT_SETTLE;
+	return t->how;
+}
+
+/* After g5p_ru_wait_step()/close() of the same sample: records which rule decided. */
+static inline void g5p_ru_rt_note(struct g5p_ru_retire *t, u32 result)
+{
+	if (result == G5P_RU_WAIT_COMPLETE && !t->decided)
+		t->decided = t->how;
+}
+
+/* ms from `from_ns` to `to_ns` for the receipt; -1 when either is missing or out of order. */
+static inline s64 g5p_ru_rt_ms(u64 from_ns, u64 to_ns)
+{
+	if (!from_ns || !to_ns || to_ns < from_ns)
+		return -1;
+	return (s64)((to_ns - from_ns) / 1000000ULL);
+}
+
+/*
+ * tahang1: the TA phase.  mcfold1 desktop seq 251 (after T1) and seq 339 (one client): ring
+ * consumed at 2 ms, the firmware's type-1 TA completion event decoded at 7.7-8.4 ms, both
+ * stamps, the W words and the watermarks at the job and the PM state saved, yet a TA idle word
+ * (G+0x724/0x728/0x72c) set from 7-8 ms on never cleared, and the r74b predicate (which needs
+ * the idle words zero) timed out at 60 s (`unsat=0x4`).  On 49 of 241 good TAs of the same
+ * boot that word was set at 7-12 ms and cleared 2 ms later.  The 3D engine shows the same lag
+ * (rule (b) above).
+ *
+ * The TA phase is complete when the target is coherent (ring consumer == target and
+ * g5p_ru_retired()) with the PM state saved, and
+ *   (a) the idle words are zero (the flown r74b predicate), or
+ *   (b) a type-1 TA completion event was decoded after this job's TA publish, or
+ *   (c) the target has stayed coherent, unbroken, for G5P_RU_TA_HOLD_MS.
+ * The stamps carry the job's identity; the TA event does not (its words are the same every
+ * job), it only reports that the firmware finished a TA after the publish.  Rule (c) keeps a
+ * lost or late event from holding a job whose stamps already landed.
+ */
+#define G5P_RU_TA_HOLD_MS 500U
+
+enum g5p_ru_ta_how {
+	G5P_RU_TA_PENDING,
+	G5P_RU_TA_IDLE_CLEAR, /* rule (a) */
+	G5P_RU_TA_EVENT, /* rule (b) */
+	G5P_RU_TA_HOLD, /* rule (c) */
+	G5P_RU_TA_HOWS,
+};
+
+struct g5p_ru_ta {
+	u64 hold_ns; /* rule (c) */
+	u64 run_ns; /* first sample of the current coherent run */
+	u64 coherent_ns; /* first coherent sample of the phase; 0 = none */
+	u64 event_ns; /* first sample that saw the event latched; 0 = none */
+	u32 run; /* samples in the current coherent run */
+	u32 breaks; /* coherent runs that ended without a decision */
+	u32 unsat; /* G5P_RU_RT_* of the last sample (SETTLE: run below the hold) */
+	u32 how; /* enum g5p_ru_ta_how of the last sample */
+	u32 decided; /* enum g5p_ru_ta_how of the sample that decided COMPLETE */
+};
+
+static inline void g5p_ru_ta_start(struct g5p_ru_ta *t)
+{
+	*t = (struct g5p_ru_ta){ .hold_ns =
+					 (u64)G5P_RU_TA_HOLD_MS * 1000000ULL };
+}
+
+/* The firmware's TA completion: a type-1 event with notification bit 0 (engine 0). */
+static inline bool g5p_ru_ta_event_match(const u32 words[11])
+{
+	return words[0] == 1 && (words[1] & 1);
+}
+
+/* One RAM sample of the TA phase at now_ns.  Returns the rule that completes it (enum
+ * g5p_ru_ta_how); the caller passes `!= G5P_RU_TA_PENDING` to g5p_ru_wait_step()/close().
+ */
+static inline u32 g5p_ru_ta_step(struct g5p_ru_ta *t, u64 now_ns, bool consumed,
+				 bool retired, bool pm, bool idle, bool event)
+{
+	t->unsat = (consumed ? 0 : G5P_RU_RT_CONSUMED) |
+		   (retired ? 0 : G5P_RU_RT_RETIRED) |
+		   (idle ? 0 : G5P_RU_RT_IDLE) | (event ? 0 : G5P_RU_RT_EVENT) |
+		   (pm ? 0 : G5P_RU_RT_PM);
+	if (event && !t->event_ns)
+		t->event_ns = now_ns;
+	t->how = G5P_RU_TA_PENDING;
+	if (!consumed || !retired || !pm) {
+		if (t->run)
+			t->breaks++;
+		t->run = 0;
+		return t->how;
+	}
+	if (!t->coherent_ns)
+		t->coherent_ns = now_ns;
+	if (!t->run++)
+		t->run_ns = now_ns;
+	if (idle)
+		t->how = G5P_RU_TA_IDLE_CLEAR;
+	else if (event)
+		t->how = G5P_RU_TA_EVENT;
+	else if (now_ns - t->run_ns >= t->hold_ns)
+		t->how = G5P_RU_TA_HOLD;
+	else
+		t->unsat |= G5P_RU_RT_SETTLE;
+	return t->how;
+}
+
+/* After g5p_ru_wait_step()/close() of the same sample: records which rule decided. */
+static inline void g5p_ru_ta_note(struct g5p_ru_ta *t, u32 result)
+{
+	if (result == G5P_RU_WAIT_COMPLETE && !t->decided)
+		t->decided = t->how;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-sched.h b/drivers/gpu/apple-g5p/render-user-sched.h
new file mode 100644
index 000000000..174a29e23
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-sched.h
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Render job scheduling across contexts (docs/gpu/multi-client-design.md, stage 2), shaped
+ * like drm_sched so that stage 4 can swap drm_sched in without a UAPI or structural change:
+ *
+ *   entity  = one render context (drm_sched_entity): a FIFO of its accepted jobs, and at
+ *             most one close item, which runs after its last job (drm_sched_entity_destroy());
+ *   run list = the entities with work, served round-robin: each pick takes the first entity
+ *             whose head job is ready and moves it to the tail (drm_sched's RR policy);
+ *   ready   = every dependency of the head job has signalled, it failed before the hardware,
+ *             its input deadline passed, or admission closed for good (the job then fails
+ *             without the hardware).  Readiness is the caller's predicate; the kernel's adds
+ *             dma-fence callbacks (drm_sched_job_add_dependency()) so that an unsignalled
+ *             input of one client never blocks another client's jobs.
+ *
+ * One credit: the single shared TA/3D channel and PM record run one job at a time, so the
+ * caller runs each picked item to completion before the next pick.  Only the head of an
+ * entity is looked at, so each context's fences signal in submission order.
+ *
+ * The lists are plain list_heads; the caller holds its scheduler lock around every call.
+ * Host-tested (scripts/gpu/multiclient2-host/test_render_sched.c).
+ */
+#ifndef G5P_RENDER_USER_SCHED_H
+#define G5P_RENDER_USER_SCHED_H
+
+struct g5p_rs_job {
+	struct list_head link;
+};
+
+struct g5p_rs_entity {
+	struct list_head link; /* in g5p_rs.run while it has work */
+	struct list_head jobs; /* FIFO of g5p_rs_job */
+	bool in_run, close_pending;
+};
+
+struct g5p_rs {
+	struct list_head run;
+};
+
+/* g5p_rs_pick() result */
+enum g5p_rs_pick {
+	G5P_RS_IDLE, /* nothing ready; *wake holds the earliest deadline if any job waits */
+	G5P_RS_JOB, /* *job was popped from *entity */
+	G5P_RS_CLOSE, /* *entity has no job left and its close item is due */
+};
+
+/* Head-job predicate: true when it may run now.  *deadline is the time at which it becomes
+ * ready on its own (its input deadline); the predicate leaves it alone if there is none.
+ */
+typedef bool (*g5p_rs_ready_fn)(struct g5p_rs_job *job, void *cookie,
+				unsigned long *deadline);
+
+static inline void g5p_rs_init(struct g5p_rs *s)
+{
+	INIT_LIST_HEAD(&s->run);
+}
+
+static inline void g5p_rs_entity_init(struct g5p_rs_entity *e)
+{
+	INIT_LIST_HEAD(&e->link);
+	INIT_LIST_HEAD(&e->jobs);
+	e->in_run = false;
+	e->close_pending = false;
+}
+
+static inline void g5p_rs_enlist(struct g5p_rs *s, struct g5p_rs_entity *e)
+{
+	if (!e->in_run) {
+		list_add_tail(&e->link, &s->run);
+		e->in_run = true;
+	}
+}
+
+/* An accepted job joins the end of its entity's FIFO. */
+static inline void g5p_rs_push(struct g5p_rs *s, struct g5p_rs_entity *e,
+			       struct g5p_rs_job *job)
+{
+	list_add_tail(&job->link, &e->jobs);
+	g5p_rs_enlist(s, e);
+}
+
+/* The entity's close item: due once its FIFO is empty.  False if one is already queued. */
+static inline bool g5p_rs_close(struct g5p_rs *s, struct g5p_rs_entity *e)
+{
+	if (e->close_pending)
+		return false;
+	e->close_pending = true;
+	g5p_rs_enlist(s, e);
+	return true;
+}
+
+/* After the close item ran: the entity leaves the scheduler for good. */
+static inline void g5p_rs_closed(struct g5p_rs *s, struct g5p_rs_entity *e)
+{
+	(void)s;
+	e->close_pending = false;
+	if (e->in_run) {
+		list_del_init(&e->link);
+		e->in_run = false;
+	}
+}
+
+/*
+ * The next item to run, round-robin over the entities with work.  A picked entity moves to
+ * the tail; one left without a job and without a close item leaves the run list.  Entities
+ * whose head is not ready keep their place.  `has_wake` reports whether *wake is set.
+ */
+static inline int g5p_rs_pick(struct g5p_rs *s, g5p_rs_ready_fn ready,
+			      void *cookie, struct g5p_rs_entity **entity,
+			      struct g5p_rs_job **job, unsigned long *wake,
+			      bool *has_wake)
+{
+	struct g5p_rs_entity *e;
+
+	*has_wake = false;
+	list_for_each_entry(e, &s->run, link) {
+		struct g5p_rs_job *head;
+		unsigned long deadline;
+		bool timed = false;
+
+		if (list_empty(&e->jobs)) {
+			/* Without a close item it left the run list at its last pick. */
+			if (!e->close_pending)
+				continue;
+			*entity = e;
+			*job = NULL;
+			list_move_tail(&e->link, &s->run);
+			return G5P_RS_CLOSE;
+		}
+		head = list_first_entry(&e->jobs, struct g5p_rs_job, link);
+		deadline = 0;
+		if (!ready(head, cookie, &deadline)) {
+			timed = deadline != 0;
+			if (timed &&
+			    (!*has_wake || (long)(deadline - *wake) < 0)) {
+				*wake = deadline;
+				*has_wake = true;
+			}
+			continue;
+		}
+		list_del_init(&head->link);
+		*entity = e;
+		*job = head;
+		if (list_empty(&e->jobs) && !e->close_pending) {
+			list_del_init(&e->link);
+			e->in_run = false;
+		} else {
+			list_move_tail(&e->link, &s->run);
+		}
+		return G5P_RS_JOB;
+	}
+	return G5P_RS_IDLE;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-serial.h b/drivers/gpu/apple-g5p/render-user-serial.h
new file mode 100644
index 000000000..e5cffa4e3
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-serial.h
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * TYPED_V3 serial jobs of every render context (a compositor and its clients: one TA+3D job
+ * per frame each), on the device's one TA/3D channel pair.
+ * Pure functions, host-tested (scripts/gpu/multiclient1-host/test_render_admit.c).
+ *
+ * Semantics:
+ *   - jobs of all contexts run strictly one after another: the queue is FIFO, each job is
+ *     TA publish -> TA complete -> 3D publish -> 3D complete before the next job starts, and
+ *     there is never a TA(N+1) in flight with a 3D(N);
+ *   - the epoch's first job brings the device up: PM, channels and its context's DC3 attach
+ *     with the r74f/r74g bells (one-shot).  Every later context binds its own slot pair at its
+ *     first job with a DC3 pair published in RAM only (render-user-bind.h), no doorbell;
+ *   - every job after the first only rebuilds the PM pool, builds its pages for the device's
+ *     sequence number, publishes with NO doorbell and waits RAM-only;
+ *   - the first job of a context that does not complete (timeout, fault, protocol error)
+ *     marks that context bad: every job still queued behind it fails with -EIO without
+ *     touching the hardware, and every later submit is refused (-EIO);
+ *   - TYPED_V3 never mixes with the other profiles, on a context or on the device;
+ *   - after any timeout or fault (render-user-terminal.h `failed`) no job starts at all, and
+ *     once the epoch is quiet the device cannot be brought up (that rings a doorbell); binding
+ *     another context is RAM only and stays allowed;
+ *   - the sequence number is the device's, 31 bit; the channel watermark grid wraps
+ *     (g5p_ru_endpoint).
+ */
+#ifndef G5P_RENDER_USER_SERIAL_H
+#define G5P_RENDER_USER_SERIAL_H
+
+enum g5p_ru_v3_refusal {
+	G5P_RU_V3_OK,
+	G5P_RU_V3_NO_TUPLE, /* boot tuple (r74g + r87b self-drain, no r74h/r80) absent */
+	G5P_RU_V3_MIXED, /* another profile ran on this context or brought the device up */
+	G5P_RU_V3_OVERFLOW, /* sequence space exhausted */
+	G5P_RU_V3_SLOTS, /* not two distinct slots in 7..255 */
+	G5P_RU_V3_VARIANT, /* r22/r25 variant, 3d_after_ta, timestamps or pm_policy */
+	G5P_RU_V3_BOUND, /* per-phase bound outside 20000..30000 ms */
+	G5P_RU_V3_STATE, /* executor only: bind state and job counts disagree */
+	G5P_RU_V3_TERMINAL, /* terminal epoch: timeout/fault, or quiet and the device down */
+	G5P_RU_V3_REFUSALS,
+};
+
+static const char *const g5p_ru_v3_why[G5P_RU_V3_REFUSALS] = {
+	"",
+	"transport is not ready for TYPED_V3 rendering",
+	"another profile ran on this context or brought the device up",
+	"sequence space exhausted",
+	"slots are not two distinct slots in 7..255",
+	"an r22/r25 variant, 3d_after_ta, timestamps or pm_policy is latched",
+	"per-phase bound outside 20000..30000 ms",
+	"bind state and job counts disagree",
+	"terminal epoch (timeout or fault, or quiet and the device not up): no hardware access",
+};
+
+/* Everything the admission needs, as plain values. */
+struct g5p_ru_v3_state {
+	bool tuple; /* boot tuple present */
+	bool v3_accepted; /* a V3 job was accepted on this context */
+	bool bound; /* this context's slot pair was published */
+	u32 jobs; /* jobs that started on this context */
+	bool device_up; /* the epoch's first job built PM and channels */
+	bool device_v3; /* ... through the TYPED_V3 attach */
+	u32 sequence; /* the device's last job that started (0 = none) */
+	u32 slot_ta, slot_3d;
+	bool variant;
+	u32 wait_ms;
+	bool quiet; /* a terminal note was made: mmio_ok is false */
+	bool terminal_failed; /* ... and it was, or a later one is, a timeout or fault */
+};
+
+/* Any two distinct user slots: unbinds leave holes, so a pair need not be adjacent. */
+static inline bool g5p_ru_v3_slots_valid(u32 slot_ta, u32 slot_3d)
+{
+	return slot_ta >= 7 && slot_3d >= 7 && slot_ta <= 255 &&
+	       slot_3d <= 255 && slot_ta != slot_3d;
+}
+
+#define G5P_RU_V3_SEQ_MAX 0x7fffffffU
+
+/* At submit time and again in the executor (`executing`): a refusal here touched nothing. */
+static inline int g5p_ru_v3_admit(const struct g5p_ru_v3_state *s,
+				  bool executing)
+{
+	if (!s->tuple)
+		return G5P_RU_V3_NO_TUPLE;
+	/* After any timeout or fault nothing new starts (closes the window between a failing job's
+	 * unlock and the context being marked bad).  Once quiet, the device cannot be brought up,
+	 * because that rings a doorbell; a job on an up device publishes with no doorbell and
+	 * touches no register, and so does the bind of a new context.
+	 */
+	if (s->terminal_failed || (s->quiet && !s->device_up))
+		return G5P_RU_V3_TERMINAL;
+	/* A job of another profile ran on this context, or another profile brought the device
+	 * up: only V3 may follow V3.
+	 */
+	if ((s->jobs && !s->v3_accepted) || (s->device_up && !s->device_v3))
+		return G5P_RU_V3_MIXED;
+	if (s->sequence >= G5P_RU_V3_SEQ_MAX)
+		return G5P_RU_V3_OVERFLOW;
+	if (!g5p_ru_v3_slots_valid(s->slot_ta, s->slot_3d))
+		return G5P_RU_V3_SLOTS;
+	if (s->variant)
+		return G5P_RU_V3_VARIANT;
+	if (!g5p_ru_v3_bound_valid(s->wait_ms))
+		return G5P_RU_V3_BOUND;
+	/* The executor: the device is up exactly when a job has started on it, and a context is
+	 * bound exactly when it has run a job, always on an up device.
+	 */
+	if (executing && (s->device_up != !!s->sequence ||
+			  s->bound != !!s->jobs || (s->bound && !s->device_up)))
+		return G5P_RU_V3_STATE;
+	return G5P_RU_V3_OK;
+}
+
+/* Verbose receipts for each context's first jobs and every failure; a compositor prints no
+ * line per frame.
+ */
+static inline bool g5p_ru_v3_verbose(u32 jobs, int ret)
+{
+	return jobs <= 8 || ret;
+}
+
+#endif
diff --git a/drivers/gpu/apple-g5p/render-user-sync.h b/drivers/gpu/apple-g5p/render-user-sync.h
new file mode 100644
index 000000000..d212d3199
--- /dev/null
+++ b/drivers/gpu/apple-g5p/render-user-sync.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * CPU cache maintenance by range (perf60-fillrate.md §11.3 cut 5, kernel half).  Host test:
+ * scripts/gpu/perf60-host/test_sync_range.c.
+ *
+ * render_user_sync_range bit 0: BO_SYNC honours offset/size (already validated page aligned by
+ * g5p_bo_range_valid) instead of syncing the whole BO.  Bit 1: a job's ACCESS_CACHE maintenance
+ * (clean before, invalidate after retirement) covers the resource's BO range [offset, offset +
+ * size), the bytes the job can reach through that resource, instead of the whole BO.  The window
+ * is widened to whole GPU pages and clamped to the BO.  Off: the whole BO, as release8.
+ * The window is walked over the sg_table's DMA segments in order (their lengths concatenate to
+ * the BO's bytes); each segment gets the intersection, relative to the segment.
+ */
+#ifndef G5P_RENDER_USER_SYNC_H
+#define G5P_RENDER_USER_SYNC_H
+
+#define G5P_SYNC_ALIGN 0x4000ULL
+
+/*
+ * [lo, hi) = [off, off + size) widened to pages, clamped to the BO; false if empty or outside.
+ */
+static inline bool g5p_sync_window(u64 off, u64 size, u64 bo_size, u64 *lo,
+				   u64 *hi)
+{
+	u64 end;
+
+	if (!size || off >= bo_size)
+		return false;
+	end = size > bo_size - off ? bo_size : off + size;
+	*lo = off & ~(G5P_SYNC_ALIGN - 1);
+	*hi = (end + G5P_SYNC_ALIGN - 1) & ~(G5P_SYNC_ALIGN - 1);
+	if (*hi > bo_size)
+		*hi = bo_size;
+	return *hi > *lo;
+}
+
+/* The part of segment [pos, pos + len) inside [lo, hi): *start relative to the segment. */
+static inline bool g5p_sync_clip(u64 pos, u64 len, u64 lo, u64 hi, u64 *start,
+				 u64 *n)
+{
+	u64 a = pos > lo ? pos : lo, b = pos + len < hi ? pos + len : hi;
+
+	if (b <= a)
+		return false;
+	*start = a - pos;
+	*n = b - a;
+	return true;
+}
+
+#endif
