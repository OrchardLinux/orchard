+			"NOPATCH latched fw=apple-original r73f_case=0 meta6c8=%u r73e_case=%u r74=%u "
+			"r74f=%u r74g=%u force_policy_ready=0 end=nopatch\n",
+			r->meta6c8, early, r74, r74f, r74g);
+	{
