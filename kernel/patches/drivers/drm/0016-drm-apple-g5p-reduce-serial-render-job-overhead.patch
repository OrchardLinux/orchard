From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 10 Nov 2026 15:07:46 +0000
Subject: [PATCH] drm/apple-g5p: reduce serial render job overhead

[Orchard: from brkosebay/linux 9a0a283e51dabf45af303fbae67a43568b2681bc;
fixed source defaults, no production module controls.] Preserve the
measured opt1 chain in dependency order.

Assisted-by: LLM
---
 drivers/gpu/apple-g5p/render-user-evwait.h   |   2 +-
 drivers/gpu/drm/apple-g5p/a9-gpu-drm.c       |   2 +-
 drivers/gpu/drm/apple-g5p/drm-compute-v1.inc |   2 +-
 drivers/gpu/drm/apple-g5p/drm-latency123.inc |   2 +-
 drivers/gpu/drm/apple-g5p/drm-render-v3.h    |   1 +
 drivers/gpu/drm/apple-g5p/drm-render-v3.inc  | 155 ++++++++++++++-----
 6 files changed, 122 insertions(+), 42 deletions(-)

diff --git a/drivers/gpu/apple-g5p/render-user-evwait.h b/drivers/gpu/apple-g5p/render-user-evwait.h
index ccb7d2c8f..5a14b32db 100644
--- a/drivers/gpu/apple-g5p/render-user-evwait.h
+++ b/drivers/gpu/apple-g5p/render-user-evwait.h
@@ -17,7 +17,7 @@
 #define G5P_RENDER_USER_EVWAIT_H
 
 #define G5P_EW_POST_US \
-	100U /* after the phase's own event: completion is imminent */
+	50U /* after the phase's own event: completion is imminent */
 #define G5P_EW_MAX_US 20000U /* safety timeout ceiling */
 
 enum g5p_ew_act {
diff --git a/drivers/gpu/drm/apple-g5p/a9-gpu-drm.c b/drivers/gpu/drm/apple-g5p/a9-gpu-drm.c
index cf4248bc4..46231b477 100644
