From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:28:33 +0100
Subject: [PATCH] drm/apple-g5p: certify system sleep on the firmware's own 
 park

With the firmware's idle park armed (ctrl+0x20, see the self-park block
in perf-envelope.h), Apple's quiescent certificate can hold on an idle
GPU. Make the sleep path match it:

- never-park now means "the park is not armed": ctrl+0x20 is 0 in RAM or
the arm was refused. The idle tail returns at once in that case
(0x10009bec), so such an epoch can never certify. The previous test
(pinned envelope, policy+4 = 0) no longer describes the shipping record.
- prepare samples the certificate for up to 50 ms (was 20 ms), and
suspend re-samples it for the same bound after the DC3 detach instead of
once: the detach wakes a parked firmware, which parks   again only after
its rings drain. - resume clears ctrl+0x20 and the park epoch before the
retained boot,   so the boot's ALIVE and GPC proofs run on a firmware
that cannot   park, and re-arms it after the DS108 claim, as every other
bring-up   does.

prepare's gates, the stop sequence, the platform-off and the failure
handling are unchanged.

Assisted-by: LLM
---
 drivers/gpu/drm/apple-g5p/system-sleep.inc | 60 +++++++++++++++-------
 1 file changed, 42 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/apple-g5p/system-sleep.inc b/drivers/gpu/drm/apple-g5p/system-sleep.inc
index effe371..9da1850 100644
--- a/drivers/gpu/drm/apple-g5p/system-sleep.inc
+++ b/drivers/gpu/drm/apple-g5p/system-sleep.inc
@@ -125,6 +125,23 @@ EXPORT_SYMBOL_GPL(apple_g5p_system_sleep_complete);
 
 /* Client work admitted before the client gate closed drains in this bound. */
 #define G5P_SLEEP_DRAIN_MS 1000
+/*
+ * The firmware's own park (self-park) follows its idle tail; a DC3 detach wakes a parked
+ * firmware, which parks again once its rings drain.  Both certificate waits use this bound.
+ */
+#define G5P_SLEEP_PARK_MS 50
+
+static bool g5p_sleep_certificate_wait(struct g5p_diag *g)
+{
+	u64 deadline = ktime_get_ns() + G5P_SLEEP_PARK_MS * NSEC_PER_MSEC;
+
+	do {
+		if (g5p_sleep_certificate(g, false))
+			return true;
+		usleep_range(100, 200);
+	} while (ktime_get_ns() < deadline);
+	return false;
+}
 
 static int g5p_system_sleep_prepare(struct device *dev)
 {
@@ -171,15 +188,10 @@ static int g5p_system_sleep_prepare(struct device *dev)
 	/* No submitters, queued work or IRQ-side ALIVE action can publish now. */
 	if (g5p_boot_drain(g) || !g5p_sleep_rings(g))
 		goto unlock;
-	deadline = ktime_get_ns() + 20 * NSEC_PER_MSEC;
-	do {
-		if (g5p_sleep_certificate(g, false)) {
-			g->sleep_reserved = true;
-			ret = 0;
-			break;
-		}
-		usleep_range(100, 200);
-	} while (ktime_get_ns() < deadline);
+	if (g5p_sleep_certificate_wait(g)) {
+		g->sleep_reserved = true;
+		ret = 0;
+	}
 unlock:
 	mutex_unlock(&g->lock);
 	if (!ret) {
@@ -200,16 +212,20 @@ refuse_client:
 }
 
 /*
- * The pinned perf envelope (perf-envelope.h: floor = pin, sampler off,
- * policy+4 = 0) keeps the firmware from ever running its idle park
- * (0x1001cec8: GPC 0 and R1+0 bit 29). Apple's isQuiescent (6ca66e4) needs
- * that park, and powerDownIfQuiescent (c81b18) neither acknowledges nor
- * touches hardware without it: it waits for the firmware to park. RAM only.
+ * The firmware runs its idle park (0x1001cec8: GPC 0 and R1+0 bits 30:29) only
+ * with ctrl+0x20 set (self-park: the idle tail 0x10009bec returns at once on
+ * priv+0x188 == 0).  Apple's isQuiescent (6ca66e4) needs that park, and
+ * powerDownIfQuiescent (c81b18) neither acknowledges nor touches hardware
+ * without it: it waits for the firmware to park.  So an epoch whose park is not
+ * armed (ctrl+0x20 = 0 in RAM: bring-up, a refused arm, debugfs "park 0") can
+ * never certify.  RAM only.
  */
 static bool g5p_sleep_never_park(struct g5p_boot *b)
 {
-	return b->maps_ready && b->gpu_perf &&
-	       !g5p_dc_root_word(b, b->layout.offset[0x4a] + 4);
+	return b->maps_ready &&
+	       (!READ_ONCE(b->self_park_armed) ||
+		!READ_ONCE(*(u32 *)(g5p_boot_shared(b, G5P_PERF_CTL) +
+				    G5P_PARK_CTL_FLAG)));
 }
 
 /* The readiness reason: one token, no white space or colon. */
@@ -355,8 +371,10 @@ static int g5p_system_suspend(struct device *dev)
 	ret = held ? g5p_rv3_unbind_slots(d, slots, held, "sleep") : 0;
 	if (ret)
 		goto failed;
-	/* Detach has changed firmware ownership: any later failure is terminal. */
-	if (!g5p_sleep_rings(g) || !g5p_sleep_certificate(g, false)) {
+	/* Detach has changed firmware ownership: any later failure is terminal.
+	 * The detach woke a parked firmware; it parks again once the DC ring drains.
+	 */
+	if (!g5p_sleep_rings(g) || !g5p_sleep_certificate_wait(g)) {
 		ret = -EBUSY;
 		goto failed;
 	}
@@ -427,6 +445,11 @@ static int g5p_system_resume(struct device *dev)
 		goto failed;
 	g->fender_ready = true;
 	g->mmio_off = false;
+	/* self-park: this boot's ALIVE and GPC proofs run before the firmware may
+	 * park (B2: a park before the first-ALIVE read latched a power abort).
+	 */
+	g5p_park_set(g, false, "resume-boot");
+	WRITE_ONCE(b->park_epoch, false);
 	b->stopped = false;
 	ret = g5p_boot_program_stream(g, true);
 	g5p_ds_hook_wake(g, ret);
@@ -465,6 +488,7 @@ static int g5p_system_resume(struct device *dev)
 	g5p_td_op_aic_ack(g);
 	g->sleep_irq_off = false;
 	enable_irq(b->irq);
+	g5p_park_set(g, true, "resume");
 	dev_info(dev, "GPU-PM on: fresh ALIVE gen=%u epoch=%u\n", g5p_ds_gen(),
 		 d->rdev->sleep_rebuilds);
 	mutex_unlock(&g->lock);
