From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:00:00 +0800
Subject: [PATCH] dt-bindings: spi: apple,spi: Add the S5L8960X SPI controller

The A7 SPI controller has the T8010 register layout but no descriptor
DMA and no interrupt status registers it can rely on, like the S8000:
it is driven by polled PIO only. Add its compatible next to the other
pre-M1 controllers and forbid DMA properties for it.

[Orchard: from thisiscamk/ipad-air-j72-linux 2a257d6,
 code/current/kernel/0001-j72-installed-kernel-snapshot.patch
 (Documentation/devicetree/bindings/spi/apple,spi.yaml).]
Assisted-by: LLM
---
 Documentation/devicetree/bindings/spi/apple,spi.yaml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/spi/apple,spi.yaml b/Documentation/devicetree/bindings/spi/apple,spi.yaml
index a34a7bec3..c8ed3039b 100644
--- a/Documentation/devicetree/bindings/spi/apple,spi.yaml
+++ b/Documentation/devicetree/bindings/spi/apple,spi.yaml
@@ -12,7 +12,9 @@ allOf:
       properties:
         compatible:
           contains:
-            const: apple,s8000-spi
+            enum:
+              - apple,s5l8960x-spi
+              - apple,s8000-spi
     then:
       properties:
         dmas: false
@@ -34,6 +36,7 @@ properties:
           - const: apple,t8103-spi
       - items:
           - enum:
+              - apple,s5l8960x-spi
               - apple,s8000-spi
               - apple,t7000-spi
               - apple,t8010-spi
