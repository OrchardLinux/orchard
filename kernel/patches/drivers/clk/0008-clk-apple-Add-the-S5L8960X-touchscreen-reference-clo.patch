From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:00:00 +0800
Subject: [PATCH] clk: apple: Add the S5L8960X touchscreen reference clock

The touchscreen controller of the A7 iPads needs a 32768 Hz reference
clock, which PWM0 channel 2 generates: equal on and off counts of the
24 MHz reference, an update bit that clears once the counts are loaded,
and an output enable. Add a clock provider for that channel, powered
through its PWM0 power domain while prepared.

[Orchard: from thisiscamk/ipad-air-j72-linux 2a257d6,
 code/current/kernel/0001-j72-installed-kernel-snapshot.patch
 (drivers/clk/clk-apple-s5l8960x-touch.c). Reworked for the final
 stack: the refusal to take over a channel that is already running,
 the save/restore of its previous counts and the read-back checks are
 left out (bring-up guards; the touchscreen driver owns the sequence),
 and is_prepared reads the enable bit instead of a software flag. The
 register sequence and timing are his.]
Assisted-by: LLM
Signed-off-by: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
---
 drivers/clk/Kconfig                    |   9 ++
 drivers/clk/Makefile                   |   1 +
 drivers/clk/clk-apple-s5l8960x-touch.c | 173 +++++++++++++++++++++++++
 3 files changed, 183 insertions(+)
 create mode 100644 drivers/clk/clk-apple-s5l8960x-touch.c

diff --git a/drivers/clk/Kconfig b/drivers/clk/Kconfig
index 15f8a9548..dfbaac902 100644
--- a/drivers/clk/Kconfig
+++ b/drivers/clk/Kconfig
@@ -73,6 +73,15 @@ config COMMON_CLK_APPLE_AOP_AUDIO
 	  This driver supports the clock of the PDM microphones on Apple A10
 	  devices, which the Always-On Processor's audio service generates.
 
+config COMMON_CLK_APPLE_S5L8960X_TOUCH
+	bool "Clock driver for Apple S5L8960X touchscreens"
+	depends on ARCH_APPLE || COMPILE_TEST
+	default ARCH_APPLE
+	help
+	  Support the touchscreen reference clock that PWM0 channel 2
+	  generates on Apple A7 (S5L8960X) devices such as the iPad Air.
+	  The other PWM channels are not exposed by this driver.
+
 config COMMON_CLK_APPLE_T8010_TOUCH
 	bool "Clock driver for Apple T7000/T8010 touchscreens"
 	depends on ARCH_APPLE || COMPILE_TEST
diff --git a/drivers/clk/Makefile b/drivers/clk/Makefile
index 2ab6c793c..75fb7d0e2 100644
--- a/drivers/clk/Makefile
+++ b/drivers/clk/Makefile
@@ -57,6 +57,7 @@ endif
 # please keep this section sorted lexicographically by file path name
 obj-$(CONFIG_COMMON_CLK_APPLE_AOP_AUDIO) += clk-apple-aop-audio.o
 obj-$(CONFIG_COMMON_CLK_APPLE_NCO)  	+= clk-apple-nco.o
+obj-$(CONFIG_COMMON_CLK_APPLE_S5L8960X_TOUCH) += clk-apple-s5l8960x-touch.o
 obj-$(CONFIG_COMMON_CLK_APPLE_T8010_TOUCH) += clk-apple-t8010-touch.o
 obj-$(CONFIG_MACH_ASM9260)		+= clk-asm9260.o
