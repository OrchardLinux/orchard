From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:55:36 +0100
Subject: [PATCH] wifi: brcmfmac: expose a board-selected read-only OTP
 snapshot

Publish the already-read OTP bytes only when the device tree selects the Apple module layout. Keep hardware reads inside the existing Wi-Fi ownership path; never let another consumer issue concurrent PCI transactions.

Assisted-by: LLM
---
 .../broadcom/brcm80211/brcmfmac/pcie.c        | 74 ++++++++++++++++++-
 1 file changed, 70 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index af8af4b45..314030754 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -18,6 +18,8 @@
 #include <linux/io.h>
 #include <linux/random.h>
 #include <linux/unaligned.h>
+#include <linux/nvmem-provider.h>
+#include <linux/of.h>
 
 #include <soc.h>
 #include <chipcommon.h>
@@ -2080,6 +2082,64 @@ brcmf_pcie_parse_otp(struct brcmf_pciedev_info *devinfo, u8 *otp, size_t size)
 	return ret;
 }
 
+struct brcmf_pcie_otp_snapshot {
+	size_t size;
+	u8 data[];
+};
+
+static int brcmf_pcie_otp_read(void *priv, unsigned int offset,
+			       void *value, size_t bytes)
+{
+	struct brcmf_pcie_otp_snapshot *snapshot = priv;
+
+	if (offset > snapshot->size || bytes > snapshot->size - offset)
+		return -EINVAL;
+
+	memcpy(value, snapshot->data + offset, bytes);
+	return 0;
+}
+
+static int brcmf_pcie_publish_otp(struct brcmf_pciedev_info *devinfo,
+				  const u16 *otp, size_t words)
+{
+	struct device *dev = &devinfo->pdev->dev;
+	struct device_node *layout __free(device_node) =
+		of_get_child_by_name(dev_of_node(dev), "nvmem-layout");
+	struct brcmf_pcie_otp_snapshot *snapshot;
+	struct nvmem_device *nvmem;
+	struct nvmem_config config = {
+		.dev = dev,
+		.name = "brcmfmac-otp",
+		.id = NVMEM_DEVID_AUTO,
+		.owner = THIS_MODULE,
+		.type = NVMEM_TYPE_OTP,
+		.read_only = true,
+		.root_only = true,
+		.reg_read = brcmf_pcie_otp_read,
+		.word_size = 1,
+		.stride = 1,
+	};
+	size_t i;
+
+	/* Only boards explicitly describing this layout expose the snapshot. */
+	if (!of_device_is_compatible(layout, "brcm,apple-otp-layout"))
+		return 0;
+
+	snapshot = devm_kzalloc(dev, struct_size(snapshot, data, words * 2),
+				GFP_KERNEL);
+	if (!snapshot)
+		return -ENOMEM;
+
+	snapshot->size = words * 2;
+	for (i = 0; i < words; i++)
+		put_unaligned_le16(otp[i], snapshot->data + i * 2);
+
+	config.priv = snapshot;
+	config.size = snapshot->size;
+	nvmem = devm_nvmem_register(dev, &config);
+	return PTR_ERR_OR_ZERO(nvmem);
+}
+
 static int brcmf_pcie_read_otp(struct brcmf_pciedev_info *devinfo)
 {
 	const struct pci_dev *pdev = devinfo->pdev;
@@ -2152,16 +2212,17 @@ static int brcmf_pcie_read_otp(struct brcmf_pciedev_info *devinfo)
 				  "OTP unavailable, using default firmware\n");
 			return 0;
 		}
-
-		/* Map OTP to shadow area */
-		WRITECC32(devinfo, sromcontrol,
-			  sromctl | BCMA_CC_SROM_CONTROL_OTPSEL);
 	}
 
 	otp = kcalloc(words, sizeof(u16), GFP_KERNEL);
 	if (!otp)
 		return -ENOMEM;
 
+	/* Map OTP to shadow area only after the allocation can no longer fail. */
+	if (coreid == BCMA_CORE_CHIPCOMMON)
+		WRITECC32(devinfo, sromcontrol,
+			  sromctl | BCMA_CC_SROM_CONTROL_OTPSEL);
+
 	/* Map bus window to SROM/OTP shadow area in core */
 	base = brcmf_pcie_buscore_prep_addr(devinfo->pdev, base + core->base);
 
@@ -2177,6 +2238,11 @@ static int brcmf_pcie_read_otp(struct brcmf_pciedev_info *devinfo)
 	}
 
 	ret = brcmf_pcie_parse_otp(devinfo, (u8 *)otp, 2 * words);
+	if (!ret) {
+		ret = brcmf_pcie_publish_otp(devinfo, otp, words);
+		kfree(otp);
+		return ret;
+	}
 	kfree(otp);
 
 	if (ret && optional) {
