From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:00:00 +0100
Subject: [PATCH] wifi: brcmfmac: pcie: Add BCM4345 support

Apple A8 handhelds such as the iPod touch 6 (N102) use a PCIe-attached
BCM4345 (14e4:43ab, ChipCommon chip ID 0x4345). brcmfmac already knows
its TCM RAM base (0x198000) in chip.c, but pcie.c does not match its PCI
device ID, map its firmware prefix, or read its OTP.

Add BRCM_PCIE_4345_DEVICE_ID (0x43ab), map BRCM_CC_4345_CHIP_ID to
brcmfmac4345-pcie (with CLM support), and read its ChipCommon OTP from
0x8c0 for 0xb9 words (0x172 bytes, as read by iOS
AppleBCMWLANBusInterfacePCIe for the BCM4345). Mark the Apple OTP record
optional so a missing or non-Apple OTP falls back to the board-type
firmware names rather than failing probe.

Assisted-by: LLM
---
 .../broadcom/brcm80211/brcmfmac/pcie.c          | 17 +++++++++++++++++
 .../broadcom/brcm80211/include/brcm_hw_ids.h    |  1 +
 2 files changed, 18 insertions(+)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index af8af4b45905..7c9f31d21a8e 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -51,6 +51,7 @@ enum brcmf_pcie_state {
 };
 
 BRCMF_FW_DEF(43602, "brcmfmac43602-pcie");
+BRCMF_FW_CLM_DEF(4345, "brcmfmac4345-pcie");
 BRCMF_FW_DEF(4350, "brcmfmac4350-pcie");
 BRCMF_FW_DEF(4350C, "brcmfmac4350c2-pcie");
 BRCMF_FW_CLM_DEF(4355, "brcmfmac4355-pcie");
@@ -85,6 +86,7 @@ MODULE_FIRMWARE(BRCMF_FW_DEFAULT_PATH "brcmfmac*-pcie.*.txcap_blob");
 
 static const struct brcmf_firmware_mapping brcmf_pcie_fwnames[] = {
 	BRCMF_FW_ENTRY(BRCM_CC_43602_CHIP_ID, 0xFFFFFFFF, 43602),
+	BRCMF_FW_ENTRY(BRCM_CC_4345_CHIP_ID, 0xFFFFFFFF, 4345),
 	BRCMF_FW_ENTRY(BRCM_CC_43465_CHIP_ID, 0xFFFFFFF0, 4366C),
 	BRCMF_FW_ENTRY(BRCM_CC_4350_CHIP_ID, 0x000000FF, 4350C),
 	BRCMF_FW_ENTRY(BRCM_CC_4350_CHIP_ID, 0xFFFFFF00, 4350),
@@ -2091,6 +2093,18 @@ static int brcmf_pcie_read_otp(struct brcmf_pciedev_info *devinfo)
 	int ret;
 
 	switch (devinfo->ci->chip) {
+	case BRCM_CC_4345_CHIP_ID:
+		/*
+		 * Apple BCM4345 OTP is shadowed in ChipCommon from 0x800 with
+		 * Apple's records starting at 0x8c0 for 0x172 bytes (0xb9
+		 * 16-bit words). Keep the record optional so a missing Apple
+		 * tuple falls back to the board-type firmware names.
+		 */
+		coreid = BCMA_CORE_CHIPCOMMON;
+		base = 0x8c0;
+		words = 0xb9;
+		optional = true;
+		break;
 	case BRCM_CC_4350_CHIP_ID:
 		/*
 		 * The 40 nm OTP holds (CC_CAP_OTPSIZE + 1) Kbit and is
@@ -2809,6 +2823,7 @@ static const struct pci_device_id brcmf_pcie_devid_table[];
 	}
 
 static const struct pci_device_id brcmf_pcie_devid_table[] = {
+	BRCMF_PCIE_DEVICE(BRCM_PCIE_4345_DEVICE_ID, WCC),
 	BRCMF_PCIE_DEVICE(BRCM_PCIE_4350_DEVICE_ID, WCC),
 	BRCMF_PCIE_DEVICE_SUB(0x4355, BRCM_PCIE_VENDOR_ID_BROADCOM, 0x4355, WCC),
 	BRCMF_PCIE_DEVICE(BRCM_PCIE_4354_RAW_DEVICE_ID, WCC),
diff --git a/drivers/net/wireless/broadcom/brcm80211/include/brcm_hw_ids.h b/drivers/net/wireless/broadcom/brcm80211/include/brcm_hw_ids.h
index 2463a294d..e5186c2f0 100644
--- a/drivers/net/wireless/broadcom/brcm80211/include/brcm_hw_ids.h
+++ b/drivers/net/wireless/broadcom/brcm80211/include/brcm_hw_ids.h
@@ -72,6 +72,7 @@
 #define CY_USB_4373_DEVICE_ID		0xbd29
 
 /* PCIE Device IDs */
+#define BRCM_PCIE_4345_DEVICE_ID	0x43ab
 #define BRCM_PCIE_4350_DEVICE_ID	0x43a3
 #define BRCM_PCIE_4354_DEVICE_ID	0x43df
 #define BRCM_PCIE_4354_RAW_DEVICE_ID	0x4354
