From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:55:34 +0100
Subject: [PATCH] dt-bindings: net: brcmfmac: allow the Apple OTP layout

Allow an optional read-only module identity layout on the Wi-Fi OTP provider for a shared Bluetooth consumer.

Assisted-by: LLM
---
 .../devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml   | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml b/Documentation/devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml
index 000060f30..f451203f1 100644
--- a/Documentation/devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml
+++ b/Documentation/devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml
@@ -150,6 +150,10 @@ properties:
           - const: mac-address
           - const: calibration
 
+  nvmem-layout:
+    $ref: /schemas/nvmem/layouts/brcm,apple-otp-layout.yaml#
+    description: Read-only Apple module identity records from the radio OTP.
+
   brcm,board-type:
     $ref: /schemas/types.yaml#/definitions/string
     description: Overrides the board type, which is normally the compatible of
