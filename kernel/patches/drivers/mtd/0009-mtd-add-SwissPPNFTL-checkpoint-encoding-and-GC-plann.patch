 }
@@ -1251,3 +1265,80 @@ void apple_sftl_get_info(struct apple_sftl *sftl, struct apple_sftl_info *info)
 	info->journal_sequence = sftl->journal_sequence;
 }
 EXPORT_SYMBOL_GPL(apple_sftl_get_info);
