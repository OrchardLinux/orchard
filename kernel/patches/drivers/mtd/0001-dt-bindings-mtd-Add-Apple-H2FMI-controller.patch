From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shayne Legault <8741557+shaynelegault@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:20:01 -0600
Subject: [PATCH] dt-bindings: mtd: Add Apple H2FMI controller

Document the six register windows and two interrupts used by the
S5L8940X controller. Add the P105-specific compatible ahead of the
shared fallback so match data can select its qualified package behavior.

Assisted-by: LLM
---
 .../devicetree/bindings/mtd/apple,h2fmi.yaml  | 51 +++++++++++++++++++
 MAINTAINERS                                   |  9 ++++
 2 files changed, 60 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mtd/apple,h2fmi.yaml

diff --git a/Documentation/devicetree/bindings/mtd/apple,h2fmi.yaml b/Documentation/devicetree/bindings/mtd/apple,h2fmi.yaml
new file mode 100644
index 000000000..aeb0dbbdf
--- /dev/null
+++ b/Documentation/devicetree/bindings/mtd/apple,h2fmi.yaml
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mtd/apple,h2fmi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple S5L H2FMI flash controller
+
+maintainers:
+  - Shayne Legault <8741557+shaynelegault@users.noreply.github.com>
+
+description:
+  The H2FMI controller drives the Hynix PPN packages used as boot storage on
+  Apple S5L8940X-family devices. Each of its two buses has separate FMI, FMC
+  and ECC register windows.
+
+properties:
+  compatible:
+    oneOf:
+      - items:
+          - const: apple,p105ap-fmi
+          - const: apple,s5l8940x-fmi
+      - const: apple,s5l8940x-fmi
+
+  reg:
+    minItems: 6
+    maxItems: 6
+
+  interrupts:
+    minItems: 2
+    maxItems: 2
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    flash-controller@1200000 {
+        compatible = "apple,p105ap-fmi", "apple,s5l8940x-fmi";
+        reg = <0x1200000 0x1000>,
+              <0x1240000 0x1000>,
+              <0x1280000 0x1000>,
+              <0x1300000 0x1000>,
+              <0x1340000 0x1000>,
+              <0x1380000 0x1000>;
+        interrupts = <33>, <34>;
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index b878ddc99..fff40600e 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -1626,6 +1626,15 @@ L:	linux-input@vger.kernel.org
 S:	Odd fixes
 F:	drivers/input/mouse/bcm5974.c
 
+APPLE H2FMI AND SFTL FLASH DRIVERS
+M:	Shayne Legault <8741557+shaynelegault@users.noreply.github.com>
+S:	Maintained
+F:	Documentation/devicetree/bindings/mtd/apple,h2fmi.yaml
+F:	Documentation/driver-api/mtd/apple-sftl-reclamation.rst
+F:	drivers/mtd/devices/mtd-apple-h2fmi*
+F:	drivers/mtd/devices/mtd-apple-sftl*
+F:	include/linux/mtd/apple-ppn*
+
