+static int h2fmi_read_geometry(struct h2fmi *fmi, struct h2fmi_bus *b)
+{
+	u8 status = 0;
+	int ret;
+
+	mutex_lock(&b->lock);
+	ret = h2fmi_read_transaction(fmi, b, 0x92, 0x97, 0, 1,
