From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:55:38 +0100
Subject: [PATCH] Bluetooth: btbcm: support pinned Apple firmware and radio
 setup

Add exact-name firmware loading without generic fallback and the native Taurus calibration and single-command regulatory transports. Preserve existing initialization for callers without a module-specific image.

Assisted-by: LLM
---
 drivers/bluetooth/btbcm.c | 122 +++++++++++++++++++++++++++++++++++---
 drivers/bluetooth/btbcm.h |  24 ++++++++
 2 files changed, 137 insertions(+), 9 deletions(-)

diff --git a/drivers/bluetooth/btbcm.c b/drivers/bluetooth/btbcm.c
index baba42563..9832b0530 100644
--- a/drivers/bluetooth/btbcm.c
+++ b/drivers/bluetooth/btbcm.c
@@ -172,6 +172,75 @@ int btbcm_set_bdaddr(struct hci_dev *hdev, const bdaddr_t *bdaddr)
 }
 EXPORT_SYMBOL_GPL(btbcm_set_bdaddr);
 
+/* Taurus calibration uses fixed-size, zero-padded vendor command packets. */
+int btbcm_send_calibration(struct hci_dev *hdev, const void *data, size_t size)
+{
+	struct {
+		u8 type;
+		__le16 blocks_left;
+		u8 data[230];
+	} __packed cmd;
+	const u8 *cursor = data;
+	size_t blocks, len;
+	struct sk_buff *skb;
+	int err;
+
+	if (!data || !size)
+		return -EINVAL;
+
+	/* The remaining-block count on the wire has only 16 bits. */
+	if (size > sizeof(cmd.data) * ((size_t)U16_MAX + 1))
+		return -E2BIG;
+
+	blocks = DIV_ROUND_UP(size, sizeof(cmd.data));
+	while (blocks) {
+		len = min(size, sizeof(cmd.data));
+		memset(&cmd, 0, sizeof(cmd));
+		cmd.type = 3;
+		cmd.blocks_left = cpu_to_le16(--blocks);
+		memcpy(cmd.data, cursor, len);
+
+		skb = __hci_cmd_sync(hdev, 0xfd97, sizeof(cmd), &cmd,
+				     HCI_INIT_TIMEOUT);
+		if (IS_ERR(skb))
+			return PTR_ERR(skb);
+
+		/* J120 firmware also returns a zero-extended status reply. */
+		if ((skb->len != 1 && skb->len != 2) ||
+		    skb->data[0] || (skb->len == 2 && skb->data[1])) {
+			err = (skb->len == 1 || skb->len == 2) && skb->data[0] ?
+				-bt_to_errno(skb->data[0]) : -EIO;
+			kfree_skb(skb);
+			return err;
+		}
+		kfree_skb(skb);
+		cursor += len;
+		size -= len;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(btbcm_send_calibration);
+
+/* Legacy controllers accept the regulatory table in one vendor command. */
+int btbcm_send_regulatory(struct hci_dev *hdev, const void *data, size_t size)
+{
+	struct sk_buff *skb;
+	int err = 0;
+
+	if (!data || !size || size > U8_MAX)
+		return -EINVAL;
+
+	skb = __hci_cmd_sync(hdev, 0xfd98, size, data, HCI_INIT_TIMEOUT);
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+	if (skb->len != 1 || skb->data[0])
+		err = skb->len == 1 ? -bt_to_errno(skb->data[0]) : -EIO;
+	kfree_skb(skb);
+	return err;
+}
+EXPORT_SYMBOL_GPL(btbcm_send_regulatory);
+
 int btbcm_read_pcm_int_params(struct hci_dev *hdev,
 			      struct bcm_set_pcm_int_params *params)
 {
@@ -575,13 +644,26 @@ static const char *btbcm_get_board_name(struct device *dev)
 #endif
 }
 
-/*
- * @variant names the module a board's controller sits on, when the board
- * comes with modules from several vendors that each need their own Patchram.
- * Its file names are tried before the generic ones.
- */
-int btbcm_initialize_variant(struct hci_dev *hdev, bool *fw_load_done,
-			     bool use_autobaud_mode, const char *variant)
+static int btbcm_load_firmware(struct hci_dev *hdev, const char *name,
+			       bool *fw_load_done)
+{
+	const struct firmware *fw;
+	int err;
+
+	err = firmware_request_nowarn(&fw, name, &hdev->dev);
+	if (err)
+		return err;
+	err = btbcm_patchram(hdev, fw);
+	release_firmware(fw);
+	if (err)
+		return err;
+	*fw_load_done = true;
+	return 0;
+}
+
+static int __btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done,
+			      bool use_autobaud_mode, const char *variant,
+			      const char *firmware_name)
 {
 	u16 subver, rev, pid, vid;
 	struct sk_buff *skb;
@@ -646,6 +728,10 @@ int btbcm_initialize_variant(struct hci_dev *hdev, bool *fw_load_done,
 	if (*fw_load_done)
 		return 0;
 
+	/* An explicitly selected module image must never use generic fallback. */
+	if (firmware_name)
+		return btbcm_load_firmware(hdev, firmware_name, fw_load_done);
+
 	if (hdev->bus == HCI_USB) {
 		/* Read USB Product Info */
 		skb = btbcm_read_usb_product(hdev);
@@ -722,15 +808,33 @@ int btbcm_initialize_variant(struct hci_dev *hdev, bool *fw_load_done,
 	kfree(fw_name);
 	return 0;
 }
+/*
+ * Variant names distinguish board modules that need different Patchram.
+ * Try their firmware names before the generic ones.
+ */
+int btbcm_initialize_variant(struct hci_dev *hdev, bool *fw_load_done,
+			     bool use_autobaud_mode, const char *variant)
+{
+	return __btbcm_initialize(hdev, fw_load_done, use_autobaud_mode, variant, NULL);
+}
 EXPORT_SYMBOL_GPL(btbcm_initialize_variant);
 
 int btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode)
 {
-	return btbcm_initialize_variant(hdev, fw_load_done, use_autobaud_mode,
-					NULL);
+	return __btbcm_initialize(hdev, fw_load_done, use_autobaud_mode, NULL, NULL);
 }
 EXPORT_SYMBOL_GPL(btbcm_initialize);
 
+int btbcm_initialize_with_firmware(struct hci_dev *hdev, bool *fw_load_done,
+				   bool use_autobaud_mode, const char *firmware_name)
+{
+	if (!firmware_name || !*firmware_name)
+		return -EINVAL;
+	return __btbcm_initialize(hdev, fw_load_done, use_autobaud_mode, NULL,
+				  firmware_name);
+}
+EXPORT_SYMBOL_GPL(btbcm_initialize_with_firmware);
+
 int btbcm_finalize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode)
 {
 	int err;
diff --git a/drivers/bluetooth/btbcm.h b/drivers/bluetooth/btbcm.h
index b902c2c32..943b85673 100644
--- a/drivers/bluetooth/btbcm.h
+++ b/drivers/bluetooth/btbcm.h
@@ -55,6 +55,8 @@ int btbcm_check_bdaddr(struct hci_dev *hdev);
 int btbcm_reset(struct hci_dev *hdev);
 int btbcm_set_bdaddr(struct hci_dev *hdev, const bdaddr_t *bdaddr);
 int btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw);
+int btbcm_send_calibration(struct hci_dev *hdev, const void *data, size_t size);
+int btbcm_send_regulatory(struct hci_dev *hdev, const void *data, size_t size);
 int btbcm_read_pcm_int_params(struct hci_dev *hdev,
 			      struct bcm_set_pcm_int_params *params);
 int btbcm_write_pcm_int_params(struct hci_dev *hdev,
@@ -66,6 +68,8 @@ int btbcm_setup_apple(struct hci_dev *hdev);
 int btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode);
 int btbcm_initialize_variant(struct hci_dev *hdev, bool *fw_load_done,
 			     bool use_autobaud_mode, const char *variant);
+int btbcm_initialize_with_firmware(struct hci_dev *hdev, bool *fw_load_done,
+				   bool use_autobaud_mode, const char *firmware_name);
 int btbcm_finalize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode);
 
 #else
@@ -85,6 +89,18 @@ static inline int btbcm_set_bdaddr(struct hci_dev *hdev, const bdaddr_t *bdaddr)
 	return -EOPNOTSUPP;
 }
 
+static inline int btbcm_send_regulatory(struct hci_dev *hdev,
+					const void *data, size_t size)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline int btbcm_send_calibration(struct hci_dev *hdev,
+					 const void *data, size_t size)
+{
+	return -EOPNOTSUPP;
+}
+
 static inline int btbcm_read_pcm_int_params(struct hci_dev *hdev,
 			      struct bcm_set_pcm_int_params *params)
 {
@@ -125,6 +141,14 @@ static inline int btbcm_initialize_variant(struct hci_dev *hdev,
 	return 0;
 }
 
+static inline int btbcm_initialize_with_firmware(struct hci_dev *hdev,
+						 bool *fw_load_done,
+						 bool use_autobaud_mode,
+						 const char *firmware_name)
+{
+	return -EOPNOTSUPP;
+}
+
 static inline int btbcm_finalize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode)
 {
 	return 0;
