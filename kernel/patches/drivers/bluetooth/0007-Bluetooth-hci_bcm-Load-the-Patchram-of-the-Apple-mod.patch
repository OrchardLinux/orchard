From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Duke Eagleman <301139544+jerricky26@users.noreply.github.com>
Date: Tue, 17 Nov 2026 18:08:27 -0500
Subject: [PATCH] Bluetooth: hci_bcm: Load the Patchram of the Apple module
 vendor

Boards such as the iPad 7 come with a Murata or a USI module, and each
needs its own Patchram, installed as BCM.apple,<board>-MUR.hcd and
-USI.hcd. btbcm only tried the generic names, so no Patchram loaded,
and linking a generic name to one vendor's file is wrong for the other
vendor's units without any error.

When the Bluetooth node links its Wi-Fi function with apple,wlan, read
the vendor that brcmfmac recorded there from the Wi-Fi OTP, and let
btbcm try <chip>.<board>-<vendor>.hcd and BCM.<board>-<vendor>.hcd
before the generic names. While the vendor isn't known yet, defer the
probe within the deferred probe timeout; after that, or for an unknown
vendor, the generic names are used as before.

Assisted-by: LLM
---
 drivers/bluetooth/btbcm.c   | 29 ++++++++++++++--
 drivers/bluetooth/btbcm.h   | 10 ++++++
 drivers/bluetooth/hci_bcm.c | 67 +++++++++++++++++++++++++++++++++++--
 3 files changed, 102 insertions(+), 4 deletions(-)

diff --git a/drivers/bluetooth/btbcm.c b/drivers/bluetooth/btbcm.c
index fc4d33cf43c4..baba425630e4 100644
--- a/drivers/bluetooth/btbcm.c
+++ b/drivers/bluetooth/btbcm.c
@@ -35,7 +35,7 @@
 #define BDADDR_BCM43341B (&(bdaddr_t) {{0xac, 0x1f, 0x00, 0x1b, 0x34, 0x43}})
 
 #define BCM_FW_NAME_LEN			64
-#define BCM_FW_NAME_COUNT_MAX		4
+#define BCM_FW_NAME_COUNT_MAX		6
 /* For kmalloc-ing the fw-name array instead of putting it on the stack */
 typedef char bcm_fw_name[BCM_FW_NAME_LEN];
 
@@ -575,7 +575,13 @@ static const char *btbcm_get_board_name(struct device *dev)
 #endif
 }
 
-int btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode)
+/*
+ * @variant names the module a board's controller sits on, when the board
+ * comes with modules from several vendors that each need their own Patchram.
+ * Its file names are tried before the generic ones.
+ */
+int btbcm_initialize_variant(struct hci_dev *hdev, bool *fw_load_done,
+			     bool use_autobaud_mode, const char *variant)
 {
 	u16 subver, rev, pid, vid;
 	struct sk_buff *skb;
@@ -659,6 +665,18 @@ int btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud
 	if (!fw_name)
 		return -ENOMEM;
 
+	if (board_name && variant) {
+		if (hw_name) {
+			snprintf(fw_name[fw_name_count], BCM_FW_NAME_LEN,
+				 "brcm/%s%s.%s-%s.hcd", hw_name, postfix,
+				 board_name, variant);
+			fw_name_count++;
+		}
+		snprintf(fw_name[fw_name_count], BCM_FW_NAME_LEN,
+			 "brcm/BCM%s.%s-%s.hcd", postfix, board_name, variant);
+		fw_name_count++;
+	}
+
 	if (hw_name) {
 		if (board_name) {
 			snprintf(fw_name[fw_name_count], BCM_FW_NAME_LEN,
@@ -704,6 +722,13 @@ int btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud
 	kfree(fw_name);
 	return 0;
 }
+EXPORT_SYMBOL_GPL(btbcm_initialize_variant);
+
+int btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode)
+{
+	return btbcm_initialize_variant(hdev, fw_load_done, use_autobaud_mode,
+					NULL);
+}
 EXPORT_SYMBOL_GPL(btbcm_initialize);
 
 int btbcm_finalize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode)
diff --git a/drivers/bluetooth/btbcm.h b/drivers/bluetooth/btbcm.h
index c46b8096cdad..b902c2c32754 100644
--- a/drivers/bluetooth/btbcm.h
+++ b/drivers/bluetooth/btbcm.h
@@ -64,6 +64,8 @@ int btbcm_setup_patchram(struct hci_dev *hdev);
 int btbcm_setup_apple(struct hci_dev *hdev);
 
 int btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode);
+int btbcm_initialize_variant(struct hci_dev *hdev, bool *fw_load_done,
+			     bool use_autobaud_mode, const char *variant);
 int btbcm_finalize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode);
 
 #else
@@ -115,6 +117,14 @@ static inline int btbcm_initialize(struct hci_dev *hdev, bool *fw_load_done, boo
 	return 0;
 }
 
+static inline int btbcm_initialize_variant(struct hci_dev *hdev,
+					   bool *fw_load_done,
+					   bool use_autobaud_mode,
+					   const char *variant)
+{
+	return 0;
+}
+
 static inline int btbcm_finalize(struct hci_dev *hdev, bool *fw_load_done, bool use_autobaud_mode)
 {
 	return 0;
diff --git a/drivers/bluetooth/hci_bcm.c b/drivers/bluetooth/hci_bcm.c
index ecf32c2c7192..45682e4d4118 100644
--- a/drivers/bluetooth/hci_bcm.c
+++ b/drivers/bluetooth/hci_bcm.c
@@ -120,6 +120,8 @@ struct bcm_device_data {
  * @pcm_int_params: keep the initial PCM configuration
  * @use_autobaud_mode: start Bluetooth device in autobaud mode
  * @max_autobaud_speed: max baudrate supported by device in autobaud mode
+ * @fw_variant: module vendor whose Patchram this controller needs, if the
+ *	board comes with modules from several vendors
  */
 struct bcm_device {
 	/* Must be the first member, hci_serdev.c expects this. */
@@ -165,6 +167,7 @@ struct bcm_device {
 	bool			use_autobaud_mode;
 	u8			pcm_int_params[5];
 	u32			max_autobaud_speed;
+	const char		*fw_variant;
 };
 
 /* generic bcm uart resources */
@@ -655,7 +658,9 @@ static int bcm_setup(struct hci_uart *hu)
 		host_set_baudrate(hu, speed);
 	}
 
-	err = btbcm_initialize(hu->hdev, &fw_load_done, use_autobaud_mode);
+	err = btbcm_initialize_variant(hu->hdev, &fw_load_done,
+				       use_autobaud_mode,
+				       bcm->dev ? bcm->dev->fw_variant : NULL);
 	if (err)
 		return err;
 
@@ -1286,6 +1291,64 @@ static int bcm_acpi_probe(struct bcm_device *dev)
 }
 #endif /* CONFIG_ACPI */
 
+/*
+ * Apple builds these controllers into a combined Wi-Fi and Bluetooth module
+ * from one of several vendors, and each vendor's module needs its own
+ * Patchram. Only the Wi-Fi function can tell which module this is: brcmfmac
+ * reads the vendor from the chip's OTP and records it in its device tree
+ * node. Wait for that while the Wi-Fi driver may still probe; without it,
+ * the generic Patchram names are used as before.
+ */
+static const struct {
+	const char *otp;
+	const char *name;
+} bcm_apple_module_vendors[] = {
+	{ "m", "MUR" },	/* Murata */
+	{ "u", "USI" },
+};
+
+static int bcm_of_get_fw_variant(struct bcm_device *bdev)
+{
+	struct device_node *wlan;
+	const char *vendor;
+	int i, err;
+
+	wlan = of_parse_phandle(bdev->dev->of_node, "apple,wlan", 0);
+	if (!wlan)
+		return 0;
+
+	if (!of_device_is_available(wlan)) {
+		of_node_put(wlan);
+		return 0;
+	}
+
+	err = of_property_read_string(wlan, "apple,module-vendor", &vendor);
+	if (err) {
+		of_node_put(wlan);
+		err = driver_deferred_probe_check_state(bdev->dev);
+		if (err == -EPROBE_DEFER)
+			return err;
+		dev_info(bdev->dev,
+			 "Wi-Fi module vendor unknown, using generic Patchram names\n");
+		return 0;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(bcm_apple_module_vendors); i++) {
+		if (!strcmp(vendor, bcm_apple_module_vendors[i].otp)) {
+			bdev->fw_variant = bcm_apple_module_vendors[i].name;
+			break;
+		}
+	}
+	if (!bdev->fw_variant)
+		dev_warn(bdev->dev, "Unknown Wi-Fi module vendor '%s'\n", vendor);
+	else
+		dev_info(bdev->dev, "Wi-Fi module vendor %s\n",
+			 bdev->fw_variant);
+
+	of_node_put(wlan);
+	return 0;
+}
+
 static int bcm_of_probe(struct bcm_device *bdev)
 {
 	bdev->use_autobaud_mode = device_property_read_bool(bdev->dev,
@@ -1297,7 +1360,7 @@ static int bcm_of_probe(struct bcm_device *bdev)
 	bdev->irq = of_irq_get_byname(bdev->dev->of_node, "host-wakeup");
 	bdev->irq_active_low = irq_get_trigger_type(bdev->irq)
 			     & (IRQ_TYPE_EDGE_FALLING | IRQ_TYPE_LEVEL_LOW);
-	return 0;
+	return bcm_of_get_fw_variant(bdev);
 }
 
 static int bcm_probe(struct platform_device *pdev)
