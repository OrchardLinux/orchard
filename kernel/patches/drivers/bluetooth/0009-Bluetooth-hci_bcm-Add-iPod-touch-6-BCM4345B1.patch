From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:00:00 +0100
Subject: [PATCH] Bluetooth: hci_bcm: Add iPod touch 6 BCM4345B1

Match the iPod touch 6's BCM4345B1 with the plain hci_bcm sequence at
115,200 baud, as used for the iPad Air 2's BCM4350C2. Also map OTP vendor
code "t" to "TDK" in bcm_apple_module_vendors[], since Apple ships
Murata, TDK and USI Bacchus modules with separate Patchram images.

Assisted-by: LLM
---
 drivers/bluetooth/hci_bcm.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/bluetooth/hci_bcm.c b/drivers/bluetooth/hci_bcm.c
index 45682e4d4118..d7f4b2189c04 100644
--- a/drivers/bluetooth/hci_bcm.c
+++ b/drivers/bluetooth/hci_bcm.c
@@ -1304,6 +1304,7 @@ static const struct {
 	const char *name;
 } bcm_apple_module_vendors[] = {
 	{ "m", "MUR" },	/* Murata */
+	{ "t", "TDK" },
 	{ "u", "USI" },
 };
 
@@ -1753,6 +1754,8 @@ static const struct of_device_id bcm_bluetooth_of_match[] = {
 	  .data = &bcm4355_j172_device_data },
 	/* The iPad Air 2 BCM4350C2 runs the plain sequence at 115,200 baud. */
 	{ .compatible = "apple,j81-bcm4350c2-bt" },
+	/* The iPod touch 6 BCM4345B1 uses the plain sequence at 115,200 baud. */
+	{ .compatible = "apple,n102-bcm4345b1-bt" },
 	{ .compatible = "apple,j71b-bcm4355c1-bt",
 	  .data = &bcm4355_j71b_device_data },
 	{ .compatible = "apple,j172-bcm4355c1-bt",
