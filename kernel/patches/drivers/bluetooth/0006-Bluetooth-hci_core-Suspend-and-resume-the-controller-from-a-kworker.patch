From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:36:28 +0100
Subject: [PATCH] Bluetooth: hci_core: Suspend and resume the controller from a
 kworker

hci_suspend_dev() and hci_resume_dev() run from the PM notifier, in the
task that writes /sys/power/state, and every synchronous command they send
waits interruptibly. A signal pending in that task ends each wait with
-EINTR. On an iPad 5 (BCM4355C0 on UART), every suspend entry logged

  Bluetooth: hci0: Opcode 0x0c1a failed: -4
  Bluetooth: hci0: Failed to set event filter

so scanning was never turned off for the sleep, and the resume sequence
is exposed the same way.

Run both sequences in a kworker, which takes no signals, under the same
request lock, and wait for it uninterruptibly.

Assisted-by: LLM
---
 net/bluetooth/hci_core.c | 43 ++++++++++++++++++++++++++++++++++------
 1 file changed, 37 insertions(+), 6 deletions(-)

diff --git a/net/bluetooth/hci_core.c b/net/bluetooth/hci_core.c
index 35a1be5..2f50713 100644
--- a/net/bluetooth/hci_core.c
+++ b/net/bluetooth/hci_core.c
@@ -2792,6 +2792,41 @@ static void hci_cancel_cmd_sync(struct hci_dev *hdev, int err)
 	hci_cmd_sync_cancel_sync(hdev, err);
 }
 
+struct hci_pm_work {
+	struct work_struct work;
+	struct hci_dev *hdev;
+	int (*func)(struct hci_dev *hdev);
+	int ret;
+};
+
+static void hci_pm_work(struct work_struct *work)
+{
+	struct hci_pm_work *pm = container_of(work, struct hci_pm_work, work);
+
+	hci_req_sync_lock(pm->hdev);
+	pm->ret = pm->func(pm->hdev);
+	hci_req_sync_unlock(pm->hdev);
+}
+
+/*
+ * The PM notifier runs in the task that writes /sys/power/state, and the
+ * synchronous commands wait interruptibly: a signal pending in that task
+ * ends each of them with -EINTR ("Opcode 0x0c1a failed: -4", "Failed to
+ * set event filter"), and the controller sleeps with scans as they were or
+ * wakes without them. Run the sequence in a kworker, which takes no
+ * signals, and wait for it.
+ */
+static int hci_pm_sync(struct hci_dev *hdev, int (*func)(struct hci_dev *hdev))
+{
+	struct hci_pm_work pm = { .hdev = hdev, .func = func };
+
+	INIT_WORK_ONSTACK(&pm.work, hci_pm_work);
+	queue_work(system_dfl_wq, &pm.work);
+	flush_work(&pm.work);
+	destroy_work_on_stack(&pm.work);
+	return pm.ret;
+}
+
 /* Suspend HCI device */
 int hci_suspend_dev(struct hci_dev *hdev)
 {
@@ -2811,9 +2846,7 @@ int hci_suspend_dev(struct hci_dev *hdev)
 	/* Cancel potentially blocking sync operation before suspend */
 	hci_cancel_cmd_sync(hdev, EHOSTDOWN);
 
-	hci_req_sync_lock(hdev);
-	ret = hci_suspend_sync(hdev);
-	hci_req_sync_unlock(hdev);
+	ret = hci_pm_sync(hdev, hci_suspend_sync);
 
 	hci_clear_wake_reason(hdev);
 	mgmt_suspending(hdev, hdev->suspend_state);
@@ -2839,9 +2872,7 @@ int hci_resume_dev(struct hci_dev *hdev)
 	if (mgmt_powering_down(hdev))
 		return 0;
 
-	hci_req_sync_lock(hdev);
-	ret = hci_resume_sync(hdev);
-	hci_req_sync_unlock(hdev);
+	ret = hci_pm_sync(hdev, hci_resume_sync);
 
 	mgmt_resuming(hdev, hdev->wake_reason, &hdev->wake_addr,
 		      hdev->wake_addr_type);
