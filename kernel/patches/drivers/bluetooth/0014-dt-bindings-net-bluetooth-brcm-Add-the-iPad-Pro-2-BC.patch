From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Tue, 24 Nov 2026 03:28:23 +0800
Subject: [PATCH] dt-bindings: net: bluetooth: brcm: Add the iPad Pro 2 BCM4355
 C0

The iPad Pro 12.9 (2017) and 10.5 carry a BCM4355 C0 module that needs
the unit's address and its RF calibration, both filled in by the boot
loader from the ADT.

[Orchard: from OrchardLinux/orchard#205 (tompta1, 09038adf),
 kernel/patches/drivers/bluetooth/0008; the J121, J207 and J208
 compatibles added; the "module-vendor" nvmem cell dropped (the vendor
 comes through the existing "apple,wlan" link to the Wi-Fi node), the
 calibration required with the address.]

Assisted-by: LLM
---
 .../net/bluetooth/brcm,bluetooth.yaml         | 34 ++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml b/Documentation/devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml
index 88ba22135..389fd5b3f 100644
--- a/Documentation/devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml
+++ b/Documentation/devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml
@@ -19,7 +19,12 @@ properties:
           - const: brcm,bcm4355c0-bt
           - const: brcm,bcm4345c5
       - items:
-          - const: apple,j71t-bcm4355c0-bt
+          - enum:
+              - apple,j71t-bcm4355c0-bt
+              - apple,j120-bcm4355c0-bt
+              - apple,j121-bcm4355c0-bt
+              - apple,j207-bcm4355c0-bt
+              - apple,j208-bcm4355c0-bt
           - const: brcm,bcm4355c0-bt
       - items:
           - enum:
@@ -105,6 +110,21 @@ properties:
   vddio-supply:
     description: phandle to regulator supply for VDDIO
 
+  local-bd-address:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 6
+    maxItems: 6
+    description: Device Bluetooth address in least significant byte first order
+
+  brcm,taurus-cal-blob:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 1
+    maxItems: 15073280
+    description:
+      Per-device Taurus calibration supplied by the bootloader. Do not put
+      calibration bytes in board source files. The transport supports at most
+      65536 blocks of 230 bytes.
+
   brcm,bt-pcm-int-params:
     $ref: /schemas/types.yaml#/definitions/uint8-array
     minItems: 5
@@ -150,6 +170,18 @@ dependencies:
 
 allOf:
   - $ref: /schemas/serial/serial-peripheral-props.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - apple,j120-bcm4355c0-bt
+              - apple,j121-bcm4355c0-bt
+              - apple,j207-bcm4355c0-bt
+              - apple,j208-bcm4355c0-bt
+    then:
+      required:
+        - local-bd-address
   - if:
       not:
         properties:
