From 1bdee822682a779452b11605fa09e3b7426ebb3c Mon Sep 17 00:00:00 2001
From: Dugs <dugahol@protonmail.com>
Date: Thu, 26 Nov 2026 20:57:15 +1030
Subject: [PATCH 2/6] mfd: macsmc: Add the T8015 power switches

Instantiate the power switch cell on the T8015 SMC so its child node in
the device tree gets a driver.

Assisted-by: LLM
Signed-off-by: Dugs <dugahol@protonmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mfd/macsmc.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index 08f7b6c..d965932 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -54,6 +54,7 @@ static const struct mfd_cell apple_smc_t8015_devs[] = {
 	MFD_CELL_OF("macsmc-gpio", NULL, NULL, 0, 0, "apple,smc-gpio"),
 	MFD_CELL_OF("macsmc-hwmon", NULL, NULL, 0, 0, "apple,smc-hwmon"),
 	MFD_CELL_OF("macsmc-reboot", NULL, NULL, 0, 0, "apple,t8015-smc-reboot"),
+	MFD_CELL_OF("macsmc-regulator", NULL, NULL, 0, 0, "apple,t8015-smc-regulator"),
 };
 
 static const struct mfd_cell apple_smc_t8103_devs[] = {
