From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Fri, 20 Nov 2026 11:20:54 +0100
Subject: [PATCH] dt-bindings: apple: use the standard AOP sensor mount matrix

A mount matrix can contain repeated entries. Use the standard property schema for the accelerometer.

Assisted-by: LLM
---
 Documentation/devicetree/bindings/soc/apple/apple,aop.yaml | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,aop.yaml b/Documentation/devicetree/bindings/soc/apple/apple,aop.yaml
index 61437c676..89ab88843 100644
--- a/Documentation/devicetree/bindings/soc/apple/apple,aop.yaml
+++ b/Documentation/devicetree/bindings/soc/apple/apple,aop.yaml
@@ -64,10 +64,7 @@ properties:
     properties:
       compatible:
         const: apple,t8010-aop-accel
-      mount-matrix:
-        $ref: /schemas/types.yaml#/definitions/string-array
-        minItems: 9
-        maxItems: 9
+      mount-matrix: true
       status: true
     required:
       - compatible
