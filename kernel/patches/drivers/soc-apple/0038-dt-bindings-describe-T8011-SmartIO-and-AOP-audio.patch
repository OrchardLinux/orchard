From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Fri, 20 Nov 2026 11:19:14 +0100
Subject: [PATCH] dt-bindings: describe T8011 SmartIO and AOP audio

Describe the T8011 SmartIO register resource and allow the AOP firmware audio service node used for PDM clock control.

Assisted-by: LLM
---
 .../devicetree/bindings/dma/apple,sio.yaml    | 24 ++++++++++++++++---
 .../bindings/soc/apple/apple,aop.yaml         | 13 ++++++++++
 2 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/dma/apple,sio.yaml b/Documentation/devicetree/bindings/dma/apple,sio.yaml
index b19e66a2a..d0d2af00d 100644
--- a/Documentation/devicetree/bindings/dma/apple,sio.yaml
+++ b/Documentation/devicetree/bindings/dma/apple,sio.yaml
@@ -4,10 +4,10 @@
 $id: http://devicetree.org/schemas/dma/apple,sio.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple T7000/S8000/T8010 SmartIO coprocessor and DMA controller
+title: Apple T7000/S8000/T8010/T8011 SmartIO coprocessor and DMA controller
 
 description: |
-  The T7000 (A8, A8X), S8000 (A9) and T8010 (A10) SmartIO coprocessor
+  The T7000 (A8, A8X), S8000 (A9), T8010 (A10) and T8011 (A10X) SmartIO coprocessor
   provides DMA channels
   for peripheral controllers. The application processor boots the SmartIO
   firmware and submits DMA commands through the SIO message queues. Clients
@@ -18,6 +18,24 @@ maintainers:
 
 allOf:
   - $ref: dma-controller.yaml#
+  - if:
+      properties:
+        compatible:
+          const: apple,t8011-sio
+    then:
+      properties:
+        reg:
+          maxItems: 1
+        reg-names:
+          maxItems: 1
+    else:
+      properties:
+        reg:
+          minItems: 2
+        reg-names:
+          minItems: 2
+      required:
+        - dma-channels
 
 properties:
   compatible:
@@ -25,6 +43,7 @@ properties:
       - apple,t7000-sio
       - apple,s8000-sio
       - apple,t8010-sio
+      - apple,t8011-sio
 
   reg:
     minItems: 1
@@ -95,7 +114,6 @@ required:
   - interrupts
   - power-domains
   - firmware-name
-  - dma-channels
   - '#dma-cells'
 
 additionalProperties: false
diff --git a/Documentation/devicetree/bindings/soc/apple/apple,aop.yaml b/Documentation/devicetree/bindings/soc/apple/apple,aop.yaml
index 128887714..61437c676 100644
--- a/Documentation/devicetree/bindings/soc/apple/apple,aop.yaml
+++ b/Documentation/devicetree/bindings/soc/apple/apple,aop.yaml
@@ -73,6 +73,19 @@ properties:
       - compatible
 
 patternProperties:
+  "^aop[-_]audio$":
+    type: object
+    additionalProperties: false
+    properties:
+      compatible:
+        const: apple,t8010-aop-audio
+      "#clock-cells":
+        const: 0
+      status: true
+    required:
+      - compatible
+      - "#clock-cells"
+
   "^(gyro|compass|pressure)$":
     type: object
     additionalProperties: false
