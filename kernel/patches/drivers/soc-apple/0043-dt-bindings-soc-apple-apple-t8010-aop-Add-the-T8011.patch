From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Tue, 24 Nov 2026 03:32:06 +0800
Subject: [PATCH] dt-bindings: soc: apple: apple,t8010-aop: Add the T8011

The A10X (T8011) AOP has the A10's resources; its firmware takes the AOP
target as a boot argument, and its audio service takes the microphone
clock as a direct command.

[Orchard: from OrchardLinux/orchard#205 (tompta1, 09038adf),
 kernel/patches/drivers/soc-apple/0033, 0040, 0042 and the AOP part of
 0038, reworked into the existing apple,t8010-aop binding instead of a
 second apple,aop.yaml that also matched the T8010; the sensor mounting
 matrix was already allowed.]

Assisted-by: LLM
---
 .../bindings/soc/apple/apple,t8010-aop.yaml     | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml b/Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml
index fcdc31eff..712f5a36c 100644
--- a/Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml
+++ b/Documentation/devicetree/bindings/soc/apple/apple,t8010-aop.yaml
@@ -4,13 +4,13 @@
 $id: http://devicetree.org/schemas/soc/apple/apple,t8010-aop.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple S8000 and T8010 Always-On Processor
+title: Apple S8000, T8010 and T8011 Always-On Processor
 
 maintainers:
   - Dalton Alexandre <alley.nightly_0b@icloud.com>
 
 description:
-  The Always-On Processor (AOP) of the A9 and A10 is an ARMv7 coprocessor
+  The Always-On Processor (AOP) of the A9, A10 and A10X is an ARMv7 coprocessor
   that runs RTKit firmware and serves the motion sensors (accelerometer,
   gyroscope, compass, pressure) and the always-on microphones. It runs from
   local SRAM, with a further firmware segment in system memory, and talks
@@ -22,6 +22,7 @@ properties:
     enum:
       - apple,s8000-aop
       - apple,t8010-aop
+      - apple,t8011-aop
 
   reg:
     items:
@@ -56,7 +57,7 @@ properties:
     $ref: /schemas/types.yaml#/definitions/uint32
     description:
       The AOP target number from the Apple device tree, filled in by the
-      bootloader. The S8000 firmware's boot arguments carry it.
+      bootloader. The S8000 and T8011 firmware's boot arguments carry it.
 
   apple,chip-id:
     $ref: /schemas/types.yaml#/definitions/uint32
@@ -73,12 +74,16 @@ properties:
   aop-audio:
     type: object
     description:
-      The firmware's audio service. On the A10 it generates the clock of
-      the PDM microphones, which the application processor's PDM
+      The firmware's audio service. On the A10 and A10X it generates the
+      clock of the PDM microphones, which the application processor's PDM
       controller records from.
     properties:
       compatible:
-        const: apple,t8010-aop-audio
+        oneOf:
+          - const: apple,t8010-aop-audio
+          - items:
+              - const: apple,t8011-aop-audio
+              - const: apple,t8010-aop-audio
 
       "#clock-cells":
         const: 0
