From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Thu, 19 Nov 2026 22:15:03 +0100
Subject: [PATCH 1/2] dt-bindings: dma: apple,sio: Add the T7000

The A8 and A8X SmartIO is an AppleA7IOP version 1: a single 0x2000
register window, with no shim registers in Apple's device tree. Add
apple,t7000-sio and make the shim region apply to S8000 and T8010 only.

Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../devicetree/bindings/dma/apple,sio.yaml    | 31 +++++++++++++++++--
 1 file changed, 29 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/dma/apple,sio.yaml b/Documentation/devicetree/bindings/dma/apple,sio.yaml
index 8dc7114af..b19e66a2a 100644
--- a/Documentation/devicetree/bindings/dma/apple,sio.yaml
+++ b/Documentation/devicetree/bindings/dma/apple,sio.yaml
@@ -4,10 +4,11 @@
 $id: http://devicetree.org/schemas/dma/apple,sio.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple S8000/T8010 SmartIO coprocessor and DMA controller
+title: Apple T7000/S8000/T8010 SmartIO coprocessor and DMA controller
 
 description: |
-  The S8000 (A9) and T8010 (A10) SmartIO coprocessor provides DMA channels
+  The T7000 (A8, A8X), S8000 (A9) and T8010 (A10) SmartIO coprocessor
+  provides DMA channels
   for peripheral controllers. The application processor boots the SmartIO
   firmware and submits DMA commands through the SIO message queues. Clients
   select the firmware endpoint number used by their peripheral.
@@ -21,15 +22,18 @@ allOf:
 properties:
   compatible:
     enum:
+      - apple,t7000-sio
       - apple,s8000-sio
       - apple,t8010-sio
 
   reg:
+    minItems: 1
     items:
       - description: AppleA7IOP coprocessor and message queue registers
       - description: SmartIO DMA shim registers
 
   reg-names:
+    minItems: 1
     items:
       - const: a7iop
       - const: shim
@@ -61,6 +65,29 @@ properties:
       Clients specify the SmartIO DMA endpoint number, for example 0x1a for
       SPI3 transmit, 0x1b for SPI3 receive or 0x28 for MCA0 transmit.
 
+if:
+  properties:
+    compatible:
+      contains:
+        enum:
+          - apple,s8000-sio
+          - apple,t8010-sio
+then:
+  properties:
+    reg:
+      minItems: 2
+    reg-names:
+      minItems: 2
+else:
+  description:
+    The T7000's AppleA7IOP version 1 block is a single 0x2000 window, and
+    Apple's device tree describes no shim registers for it.
+  properties:
+    reg:
+      maxItems: 1
+    reg-names:
+      maxItems: 1
+
 required:
   - compatible
   - reg
