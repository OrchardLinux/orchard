+static __printf(2, 3) void apple_aop_warm_log(struct apple_aop *aop, const char *fmt, ...)
+{
+	struct a9_sl_header *h = aop->shutdown_log;
+	va_list args;
+	char line[512];
+	size_t n;
+
+	va_start(args, fmt);
+	n = vscnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	dev_info(aop->dev, "%s", line);
+	if (n > h->capacity - h->length) {
+		h->truncated++;
+		return;
+	}
+	memcpy(aop->shutdown_text + h->length, line, n);
+	wmb();
+	h->checksum = a9_sl_hash(h->checksum, line, n);
+	h->length += n;
+	h->lines++;
+	wmb();
+}
