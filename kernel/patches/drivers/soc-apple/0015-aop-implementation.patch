+static int apple_aop_warm_stop(struct apple_aop *aop)
+{
+	unsigned int fifo, i;
+	u32 offset, val;
+	int ret;
+
+	ret = aop_wr(aop, 0x4020, aop_rd(aop, 0x4020) & ~BIT(0));
+	if (!ret)
+		ret = aop_wr(aop, 0x4000, 0x1111);
+	if (!ret)
+		ret = aop_wr(aop, 0xc00, 0x1111);
+	if (!ret)
+		ret = aop_wr(aop, 0x44, aop_rd(aop, 0x44) & ~BIT(4));
+	if (ret)
+		return ret;
+	writel(0, aop->control);
+	msleep(10);
+	if (!a9_aop_force_stopped(aop))
+		return -EIO;
+	aop->force_halted = true;
+	for (fifo = 0; fifo < 2; fifo++) {
+		offset = fifo ? 0x4020 : 0x4008;
+		for (i = 0; i < 64; i++) {
+			val = aop_rd(aop, offset);
+			if (!a9_aop_force_stopped(aop) || (val & AOP_MBOX_FAULTS))
+				return -EIO;
+			if (val & BIT(17))
+				break;
+			readq(aop->warm_wrapper + (fifo ? 0x4038 : 0x4018));
+		}
+		if (!(aop_rd(aop, offset) & BIT(17)))
+			return -ETIMEDOUT;
+	}
+	aop->force_drained = true;
+	return 0;
+}
