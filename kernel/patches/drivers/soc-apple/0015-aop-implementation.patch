+static void apple_aop_warm_shutdown(struct apple_aop *aop)
+{
+	struct a9_sl_header *h = aop->shutdown_log;
+	u8 before[SHA256_DIGEST_SIZE], after[SHA256_DIGEST_SIZE];
+	unsigned long deadline = jiffies + msecs_to_jiffies(10000), start;
+	unsigned int i, acked = 0;
+	int ret = -EIO;
+
+	memset(h, 0, sizeof(*h));
+	h->version = A9_SL_VERSION;
+	h->capacity = A9_SL_CAPACITY;
+	h->checksum = A9_SL_HASH_SEED;
+	h->mode = 1;
+	h->begin_ns = ktime_get_boottime_ns();
+	wmb();
+	h->magic = A9_SL_MAGIC;
+	apple_aop_warm_log(aop, "SHUTDOWN begin mode=quiesce hello=%d phase=stopping iop_crashed=%d\n",
+			   aop->hello, aop->iop_crashed);
+	if (!aop->hello || aop->iop_crashed || aop->shutdown_error)
+		goto done;
+	/* Rates-zero has stopped reports. Stop one AFK at a time, max 2s
+	 * per endpoint and 10s in total, including send time. Never force halt
+	 * after a failed ACK. Keep every grant allocated for the entire hook.
+	 */
+	for (i = 0; i < AFK_ENDPOINT_COUNT; i++) {
+		struct apple_aop_ep *ep = &aop->eps[i];
+		unsigned long limit;
+
+		if (!ep->initialized)
+			continue;
+		if (time_after_eq(jiffies, deadline)) {
+			ret = -ETIMEDOUT;
+			goto done;
+		}
+		reinit_completion(&ep->stopped);
+		start = jiffies;
+		ret = apple_aop_send(ep, AFK_OPC_SHUTDOWN, 0);
+		if (ret)
+			goto done;
+		limit = time_before(jiffies, deadline) ? min_t(unsigned long,
+			deadline - jiffies, msecs_to_jiffies(2000)) : 0;
+		if (!limit || !wait_for_completion_timeout(&ep->stopped, limit)) {
+			ret = -ETIMEDOUT;
+			goto done;
+		}
+		acked++;
+		apple_aop_warm_log(aop, "QUIESCE step=afk-ack ep=0x%x state=stopped ms=%u\n",
+				   ep->index, jiffies_to_msecs(jiffies - start));
+	}
+	/* release6: complete every AFK stop before disabling endpoint routing. */
+	if (acked != 17) {
+		ret = -ENOTCONN;
+		goto done;
+	}
+	for (i = 0; i < AFK_ENDPOINT_COUNT; i++) {
+		struct apple_aop_ep *ep = &aop->eps[i];
+
+		if (!ep->initialized)
+			continue;
+		/* MGMT STARTEP bit 0 disables routing, no separate stop ACK. */
+		ret = apple_rtkit_send_message(aop->rtk, 0,
+			(5ULL << 52) | ((u64)ep->index << 32) | 1, NULL, false);
+		if (ret)
+			goto done;
+	}
+	if (acked != 17) {
+		ret = -ENOTCONN;
+		goto done; /* Never certify an incompletely initialized instance. */
+	}
+	ret = apple_rtkit_shutdown_preserve(aop->rtk);
+	if (ret)
+		goto done;
+	msleep(20);
+	apple_aop_warm_hash(aop, before);
+	msleep(20);
+	apple_aop_warm_hash(aop, after);
+	ret = memcmp(before, after, sizeof(before)) ? -EBUSY : 0;
+	apple_aop_warm_log(aop, "QUIESCE step=ram-stable window_ms=20 status=%d\n", ret);
+	if (ret || aop->iop_crashed)
+		goto done;
+	ret = apple_aop_warm_stop(aop);
+done:
+	apple_aop_warm_log(aop, "QUIESCE step=complete status=%d quiesced=%d halted=%d drained=%d steps=0x%x afk_acks=%u iop_crashed=%d\n",
+			   ret, !ret, aop->force_halted, aop->force_drained,
+			   !ret ? 0x1bff : 0, acked, aop->iop_crashed);
+	if (ret)
+		dev_err(aop->dev, "quiesce failed; next AOP must refuse, recover with DFU\n");
+}
