+		if (!strcmp(con->name, "ramoops") &&
+		    (console_srcu_read_flags(con) & (CON_ENABLED | CON_SUSPENDED)) ==
+		    CON_ENABLED) {
+			ready = true;
+			break;
+		}
+	}
+	console_srcu_read_unlock(cookie);
