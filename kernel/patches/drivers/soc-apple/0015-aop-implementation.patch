diff --git a/drivers/soc/apple/aop-warm-record.h b/drivers/soc/apple/aop-warm-record.h
new file mode 100644
index 000000000..a735809d5
--- /dev/null
+++ b/drivers/soc/apple/aop-warm-record.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/types.h>
+#include <linux/string.h>
+#define A9_HO_PAGE		0x4000U
+#define A9_HO_LOG_OFFSET	0x800U
+#define A9_SL_MAGIC		0x4c533941U	/* "A9SL" */
+#define A9_SL_VERSION		1U
+
+enum a9_ho_step {
+	A9_HO_STEP_BEGIN,
+	A9_HO_STEP_RATES,
+	A9_HO_STEP_AFK_SENT,
+	A9_HO_STEP_AFK_ACKED,
+	A9_HO_STEP_DISABLED,
+	A9_HO_STEP_AP_SENT,
+	A9_HO_STEP_AP_ACKED,
+	A9_HO_STEP_IOP_SENT,
+	A9_HO_STEP_IOP_ACKED,
+	A9_HO_STEP_RAM_STABLE,
+	A9_HO_STEP_MAILBOX_IDLE,
+	A9_HO_STEP_HALTED,
+	A9_HO_STEP_DRAINED,
+	A9_HO_STEPS,
+};
+
+static const char * const a9_ho_step_names[A9_HO_STEPS] = {
+	"begin", "rates-zero", "afk-sent", "afk-acked", "endpoint-disable",
+	"ap-sent", "ap-ack", "iop-sent", "iop-ack", "ram-stable", "mailbox-idle",
+	"halt", "drain",
+};
+
+struct a9_sl_header {
+	u32 magic, version, capacity, length;
+	u32 lines, truncated, checksum, mode;
+	u64 begin_ns;
+	u8 writer[16];
+	char entry[64];
+};
+
+_Static_assert(sizeof(struct a9_sl_header) == 120, "shutdown log ABI");
+
+#define A9_SL_CAPACITY	(A9_HO_PAGE - A9_HO_LOG_OFFSET - sizeof(struct a9_sl_header))
+
+/* FNV-1a; incremental over appended text. */
+static inline u32 a9_sl_hash(u32 hash, const char *text, size_t length)
+{
+	size_t i;
+
+	for (i = 0; i < length; i++)
+		hash = (hash ^ (u8)text[i]) * 16777619U;
+	return hash;
+}
+
+#define A9_SL_HASH_SEED	2166136261U
+
+/* A replayable previous transcript: complete header, bounded, intact. */
+static inline bool a9_sl_valid(const struct a9_sl_header *h, const char *text)
+{
+	return h->magic == A9_SL_MAGIC && h->version == A9_SL_VERSION &&
+	       h->capacity == A9_SL_CAPACITY && h->length <= h->capacity &&
+	       !h->entry[sizeof(h->entry) - 1] &&
+	       a9_sl_hash(A9_SL_HASH_SEED, text, h->length) == h->checksum;
+}
+
diff --git a/drivers/soc/apple/aop-warm-spi0.c.h b/drivers/soc/apple/aop-warm-spi0.c.h
new file mode 100644
index 000000000..bf883ffe8
--- /dev/null
+++ b/drivers/soc/apple/aop-warm-spi0.c.h
@@ -0,0 +1,1340 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Ported from a9/aop-rc1: wake16, release6-d254a9f790. */
+static void a9_aop_spi0_snapshot(void __iomem *base, u32 *values)
+{
+	unsigned int i;
+
+	for (i = 0; i < A9_SPI0_REGS; i++)
+		values[i] = readl(base + a9_spi0_offsets[i]);
+}
+
+/*
+ * AOPSPIMaster_reset (0102f2f4) under the AOP-domain PMGR guard with IRQs
+ * off and the AOP CPU halted. Its provider power transition 3 is an
+ * AOP-local call with no AP register equivalent and is not replayed. A poll
+ * timeout still restores the saved control word.
+ */
+static void a9_aop_spi0_reset_locked(void *data)
+{
+	struct a9_aop_spi0 *s = data;
+	void __iomem *control = s->base + A9_SPI0_CONTROL;
+	u32 value = 0;
+	int ret;
+
+	a9_aop_spi0_snapshot(s->base, s->before);
+	s->saved = s->before[A9_SPI0_I_CONTROL];
+	s->asserted = a9_spi0_base_word(s->saved) | A9_SPI0_RESET;
+	writel(s->asserted, control);
+	ret = readl_poll_timeout_atomic(control, value, value & A9_SPI0_RESET,
+					1, A9_SPI0_POLL_US);
+	if (!ret)
+		ret = readl_poll_timeout_atomic(control, value,
+						!(value & A9_SPI0_ENABLE), 1,
+						A9_SPI0_POLL_US);
+	s->polled = value;
+	if (!ret) {
+		udelay(A9_SPI0_DELAY_US);
+		writel(a9_spi0_base_word(s->saved), control);
+		udelay(A9_SPI0_DELAY_US);
+	}
+	writel(s->saved, control);
+	s->reset_done_ns = ktime_get_ns();
+	a9_aop_spi0_snapshot(s->base, s->after);
+	if (!ret && (s->after[A9_SPI0_I_FAULT] & A9_SPI0_CH3_PENDING))
+		ret = -EIO;
+	s->error = ret;
+}
+
+/*
+ * Wake8 device evidence: SCM was 0 before/after the first controller reset,
+ * then became 3 at the channel-3 stop store. There is no firmware-derived
+ * SCM status write. Replay AOPSPIMaster_reset after the teardown so the
+ * controller reset, rather than an invented SCM write, is the one variable.
+ */
+static void a9_aop_spi0_post_reset_locked(void *data)
+{
+	struct a9_aop_spi0 *s = data;
+	struct a9_aop_spi0_post_reset *r = &s->post_reset;
+	void __iomem *control = s->base + A9_SPI0_CONTROL;
+	u32 value = 0;
+	int ret;
+
+	a9_aop_spi0_snapshot(s->base, r->before);
+	r->saved = r->before[A9_SPI0_I_CONTROL];
+	r->asserted = a9_spi0_base_word(r->saved) | A9_SPI0_RESET;
+	writel(r->asserted, control);
+	ret = readl_poll_timeout_atomic(control, value, value & A9_SPI0_RESET,
+					1, A9_SPI0_POLL_US);
+	if (!ret)
+		ret = readl_poll_timeout_atomic(control, value,
+						!(value & A9_SPI0_ENABLE), 1,
+						A9_SPI0_POLL_US);
+	r->polled = value;
+	if (!ret) {
+		udelay(A9_SPI0_DELAY_US);
+		writel(a9_spi0_base_word(r->saved), control);
+		udelay(A9_SPI0_DELAY_US);
+	}
+	writel(r->saved, control);
+	a9_aop_spi0_snapshot(s->base, r->after);
+	if (!ret && (r->after[A9_SPI0_I_FAULT] & A9_SPI0_CH3_PENDING))
+		ret = -EIO;
+	r->error = ret;
+}
+
+static void a9_aop_spi0_ch3_snapshot(void __iomem *base, u32 *values)
+{
+	unsigned int i;
+
+	for (i = 0; i < A9_SPI0_CH3_REGS; i++)
+		values[i] = readl(base + a9_spi0_ch3_offsets[i]);
+}
+
+static void a9_aop_spi0_trace_read(void *data)
+{
+	struct a9_aop_spi0 *s = data;
+	unsigned int channel, i;
+
+	s->trace.control = readl(s->base + A9_SPI0_CONTROL);
+	s->trace.clock = readl(s->base + A9_SPI0_CLOCK);
+	for (i = 0; i < A9_SPI0_SCM_REGS; i++)
+		s->trace.scm[i] = readl(s->base + a9_spi0_scm_offsets[i]);
+	a9_aop_spi0_ch3_snapshot(s->base, s->trace.ch3);
+	for (channel = 0; channel < A9_SPI0_CHANNELS; channel++)
+		for (i = 0; i < A9_SPI0_CHANNEL_REGS; i++)
+			s->trace.channel[channel][i] =
+				readl(s->base + A9_SPI0_CHANNEL_BASE +
+				      A9_SPI0_CHANNEL_STRIDE * channel +
+				      a9_spi0_channel_offsets[i]);
+}
+
+/* Warm path only, CPU halted. Log outside the PMGR guard; no SCM writes. */
+static int a9_aop_spi0_trace(struct apple_aop *aop, const char *stage)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_spi0 *s = &aop->spi0;
+	const u32 *c = s->trace.ch3, *m = s->trace.scm;
+	const u32 *v;
+	unsigned int channel;
+	int ret;
+
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_spi0_trace_read, s);
+	if (ret) {
+		s->intc.failed = "failed-spi0-trace-guard";
+		dev_info(aop->dev, "SPI0 SCM stage=%s errno=%d: guard refused\n", stage, ret);
+		return ret;
+	}
+	dev_info(aop->dev, "SPI0 SCM stage=%s errno=0 ctl=%08x clk=%08x scm_lo=%08x scm_hi=%08x c3_interval=%08x c3_cursor=%08x c3=%08x route=%08x rate=%08x c3c=%08x desc=%08x 8d0=%08x 8d4=%08x cpu=halted\n",
+		 stage, s->trace.control, s->trace.clock, m[0], m[1], m[2], m[3],
+		 c[0], c[1], c[2], c[3], c[4], c[5], c[6]);
+	for (channel = 0; channel < A9_SPI0_CHANNELS; channel++) {
+		v = s->trace.channel[channel];
+		dev_info(aop->dev, "SPI0 SCM channel stage=%s ch=%02u ctl=%08x route=%08x rate=%08x cfg=%08x interval=%08x cursor=%08x desc=%08x pending0=%u pending1=%u\n",
+			 stage, channel, v[0], v[1], v[2], v[3], v[4], v[5], v[6],
+			 !!(c[A9_CH3_I_8D0] & BIT(2 * channel)),
+			 !!(c[A9_CH3_I_8D4] & BIT(2 * channel)));
+	}
+	return 0;
+}
+
+static const char *a9_aop_spi0_selected_verify(struct a9_aop_spi0 *s);
+
+/*
+ * Wake10 safety gate, strengthened in wake11 to retain every selected-channel
+ * teardown invariant. A fault observed by a copy sample remains terminal even
+ * if it is transient and the final read happens to clear.
+ */
+static int a9_aop_spi0_gate(struct apple_aop *aop, const char *stage,
+			    const char *check, bool include_copy)
+{
+	struct a9_aop_spi0 *s = &aop->spi0;
+	const u32 *m, *c;
+	int ret;
+
+	ret = a9_aop_spi0_trace(aop, stage);
+	if (ret)
+		return ret;
+	m = s->trace.scm;
+	c = s->trace.ch3;
+	if (m[0] || m[1])
+		s->gate_failed = "failed-spi0-scm";
+	else if (c[A9_CH3_I_8D0] || c[A9_CH3_I_8D4])
+		s->gate_failed = "failed-spi0-fault";
+	else if (include_copy && s->copy_faulted)
+		s->gate_failed = "failed-spi0-copy-sample";
+	else {
+		s->gate_failed = a9_spi0_ch3_verify(c, s->teardown_stable & BIT(3));
+		if (!s->gate_failed)
+			s->gate_failed = a9_aop_spi0_selected_verify(s);
+	}
+	ret = s->gate_failed ? -EIO : 0;
+	dev_info(aop->dev, "SPI0 %s check errno=%d scm_lo=%08x scm_hi=%08x 8d0=%08x 8d4=%08x copy_faulted=%u result=%s\n",
+		 check, ret, m[0], m[1], c[A9_CH3_I_8D0], c[A9_CH3_I_8D4],
+		 s->copy_faulted, s->gate_failed ?: "pass");
+	return ret;
+}
+
+#define A9_SPI0_COPY_CHUNK	256U
+#define A9_SPI0_COPY_SAMPLE_US	5000U
+
+struct a9_aop_spi0_copy_probe {
+	void __iomem *base;
+	u32 scm_lo, scm_hi, fault, fault_8d4;
+};
+
+static void a9_aop_spi0_copy_probe_read(void *data)
+{
+	struct a9_aop_spi0_copy_probe *p = data;
+
+	p->scm_lo = readl(p->base + A9_SPI0_SCM_LO);
+	p->scm_hi = readl(p->base + A9_SPI0_SCM_HI);
+	p->fault = readl(p->base + A9_SPI0_FAULT);
+	p->fault_8d4 = readl(p->base + A9_SPI0_FAULT_8D4);
+}
+
+/*
+ * Read-only samples spaced by at least 5 ms across both halves of the SRAM
+ * copy. Once a nonzero state is seen it remains a terminal fact, but the copy
+ * completes so later samples and the full after-copy channel snapshot expose
+ * whether the source is level, transient or moves between channels.
+ */
+static int a9_aop_spi0_copy_sample(struct apple_aop *aop, const char *phase,
+				   size_t offset, size_t size, u64 start_ns,
+				   u64 *last_us, unsigned int *sample,
+				   bool force)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_spi0 *s = &aop->spi0;
+	struct a9_aop_spi0_copy_probe p = { .base = s->base };
+	u64 elapsed_us = div_u64(ktime_get_boottime_ns() - start_ns,
+				 NSEC_PER_USEC);
+	bool first_fault, initial = !*sample;
+	int ret;
+
+	if (!force && *sample && elapsed_us - *last_us < A9_SPI0_COPY_SAMPLE_US)
+		return 0;
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_spi0_copy_probe_read, &p);
+	first_fault = !s->copy_faulted &&
+		(p.scm_lo || p.scm_hi || p.fault || p.fault_8d4);
+	if (!ret && first_fault)
+		s->copy_faulted = true;
+	dev_info(aop->dev, "SPI0 COPY sample=%u phase=%s elapsed_us=%llu offset=0x%zx size=0x%zx scm_lo=%08x scm_hi=%08x 8d0=%08x 8d4=%08x result=%s\n",
+		 *sample, phase, elapsed_us, offset, size, p.scm_lo, p.scm_hi,
+		 p.fault, p.fault_8d4, ret ? "guard" : s->copy_faulted ? "fault" : "pass");
+	*last_us = elapsed_us;
+	(*sample)++;
+	if (ret)
+		return ret;
+	if (first_fault) {
+		ret = a9_aop_spi0_trace(aop, "copy-fault");
+		if (ret)
+			return ret;
+	}
+	/* The offset-zero sample is the last no-write gate before the copy. */
+	return !initial || !s->copy_faulted ? 0 : -EIO;
+}
+
+static int a9_aop_copy_verify_wake10(struct apple_aop *aop, const u8 *src,
+				     size_t size)
+{
+	u32 chunk[A9_SPI0_COPY_CHUNK / 4];
+	u64 start_ns = ktime_get_boottime_ns(), last_us = 0;
+	unsigned int sample = 0;
+	size_t done, n;
+	int ret;
+
+	ret = a9_aop_spi0_copy_sample(aop, "write", 0, size, start_ns, &last_us, &sample, true);
+	if (ret)
+		return ret;
+	for (done = 0; done < size; done += n) {
+		n = min_t(size_t, size - done, sizeof(chunk));
+		__iowrite32_copy(aop->sram + done, src + done, n / 4);
+		ret = a9_aop_spi0_copy_sample(aop, "write", done + n, size, start_ns,
+					      &last_us, &sample, done + n == size);
+		if (ret)
+			return ret;
+	}
+	ret = a9_aop_spi0_copy_sample(aop, "verify", 0, size, start_ns, &last_us, &sample, true);
+	if (ret)
+		return ret;
+	for (done = 0; done < size; done += n) {
+		n = min_t(size_t, size - done, sizeof(chunk));
+		__ioread32_copy(chunk, aop->sram + done, n / 4);
+		if (memcmp(chunk, src + done, n))
+			return -EIO;
+		ret = a9_aop_spi0_copy_sample(aop, "verify", done + n, size, start_ns,
+					      &last_us, &sample, done + n == size);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static void __iomem *a9_aop_spi0_channel_base(struct a9_aop_spi0 *s,
+					       unsigned int channel)
+{
+	return s->base + A9_SPI0_CHANNEL_BASE + A9_SPI0_CHANNEL_STRIDE * channel;
+}
+
+/*
+ * Wake15: which other channels were RUN with a counting interval when this
+ * stop was issued, and which of them advanced across the stop. Read only; it
+ * separates a stop that had a ticking peer from the stop of the last live
+ * channel in the log. It never gates anything in-kernel.
+ */
+static void a9_aop_spi0_peers_begin(struct a9_aop_spi0 *s, unsigned int channel,
+				    u32 *interval, u32 *run)
+{
+	unsigned int i;
+	u32 ctl;
+
+	*run = 0;
+	for (i = 0; i < A9_SPI0_CHANNELS; i++) {
+		void __iomem *base = a9_aop_spi0_channel_base(s, i);
+
+		interval[i] = 0;
+		if (i == channel)
+			continue;
+		ctl = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_CTL]);
+		interval[i] = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_INTERVAL]);
+		if ((ctl & A9_SPI0_CH3_RUN) && interval[i])
+			*run |= BIT(i);
+	}
+}
+
+static void a9_aop_spi0_stop_timing(struct a9_aop_spi0 *s,
+				    struct a9_aop_spi0_ch3 *c,
+				    const u32 *interval)
+{
+	unsigned int i;
+
+	c->peers_ticking = 0;
+	for (i = 0; i < A9_SPI0_CHANNELS; i++) {
+		void __iomem *base = a9_aop_spi0_channel_base(s, i);
+
+		if ((c->peers_run & BIT(i)) &&
+		    readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_INTERVAL]) !=
+		    interval[i])
+			c->peers_ticking |= BIT(i);
+	}
+	c->reset_to_stop_us = c->stop_ns > s->reset_done_ns ?
+		div_u64(c->stop_ns - s->reset_done_ns, NSEC_PER_USEC) : 0;
+}
+
+/*
+ * Wake12/13 captured channel 7, and wake13 channel 3, stopped but never idle:
+ * for 20 complete slices the control/progress word, config, interval, cursor,
+ * SCM and both fault banks were unchanged. This predicate is intentionally
+ * narrower than "RUN clear and no progress": the channel must be one of the
+ * two device-observed periodic clients, must carry that client's route, rate
+ * and config before the stop, and every sample must be byte-identical with SCM
+ * 3/0 (every earlier non-idle stop, which followed a channel-3 stop that had
+ * latched it) or 0/0 (a first stop that latches nothing), no fault, no cursor
+ * movement and a retained nonzero interval.
+ * It only permits the callback masks, descriptor clear, config acknowledge and
+ * the established controller reset; every later SCM, fault and copy gate stays.
+ */
+static const char *a9_aop_spi0_stable_why(struct a9_aop_spi0_ch3 *c,
+					  const struct a9_aop_channel_diag_slice *diag,
+					  unsigned int channel)
+{
+	const struct a9_aop_ch3_slice *first;
+	unsigned int i;
+	u32 route;
+
+	if (channel == A9_SPI0_PHOSPHORUS_CHANNEL)
+		route = A9_SPI0_PHOSPHORUS_ROUTE;
+	else if (channel == A9_SPI0_MPU_ASYNC_CHANNEL)
+		route = A9_SPI0_MPU_ASYNC_ROUTE;
+	else
+		return "channel";
+	if (c->poll != -ETIMEDOUT || c->slices != A9_SPI0_CH3_SLICES)
+		return "no-timeout";
+	if (!(c->before[A9_CH3_I_C3] & A9_SPI0_CH3_RUN) ||
+	    c->before[A9_CH3_I_ROUTE] != route ||
+	    c->before[A9_CH3_I_RATE] != A9_SPI0_PHOSPHORUS_RATE ||
+	    c->before[A9_CH3_I_C3C] != A9_SPI0_PHOSPHORUS_CFG ||
+	    c->before[A9_CH3_I_DESC] || (c->stop & A9_SPI0_CH3_RUN))
+		return "before-identity";
+	if (c->before[A9_CH3_I_8D4] || (c->before[A9_CH3_I_8D0] & ~BIT(2 * channel)))
+		return "before-fault";
+
+	first = &c->slice[0];
+	if ((first->c3 & A9_SPI0_STABLE_CTL_MASK) != A9_SPI0_STABLE_CTL_STOPPED ||
+	    (first->c3 & (A9_SPI0_CH3_RUN | A9_SPI0_CH3_IDLE | A9_SPI0_CH3_IRQ1)))
+		return "stopped-control";
+	if ((first->scm_lo != 0 && first->scm_lo != 3) || first->scm_hi)
+		return "scm";
+	if (first->fault || diag[0].fault_8d4)
+		return "sample-fault";
+	if (diag[0].cfg != A9_SPI0_PHOSPHORUS_CFG || diag[0].cursor || !diag[0].interval)
+		return "cfg-cursor-interval";
+
+	for (i = 1; i < A9_SPI0_CH3_SLICES; i++) {
+		const struct a9_aop_ch3_slice *p = &c->slice[i];
+
+		if (p->c3 != first->c3 || p->scm_lo != first->scm_lo ||
+		    p->scm_hi != first->scm_hi || p->fault != first->fault ||
+		    diag[i].cfg != diag[0].cfg ||
+		    diag[i].interval != diag[0].interval ||
+		    diag[i].cursor != diag[0].cursor ||
+		    diag[i].fault_8d4 != diag[0].fault_8d4)
+			return "progress";
+	}
+	if (c->slice[A9_SPI0_CH3_SLICES - 1].ns <
+	    (u64)A9_SPI0_CH3_SLICES * A9_SPI0_CH3_SLICE_US * NSEC_PER_USEC)
+		return "short";
+	return NULL;
+}
+
+/*
+ * AOPSPIMaster_teardownChannel (0102e4f8) for channel 3, then the fault
+ * handler's acknowledge (0102f20a), under the same guard as the reset with
+ * the CPU halted. Every store is a read-modify-write except the descriptor,
+ * which the firmware zeroes. The idle wait runs in 1 ms slices, up to twice
+ * the firmware's own 10 ms SCMto bound; each slice ends with read-only
+ * samples of C3, the SCM state and +0x8d0 (wake15: and config, interval,
+ * cursor and +0x8d4). An idle timeout stops before the masks unless the
+ * stable-stop predicate holds. The acknowledge bit self-clears; +0x8d0 bit 6
+ * shows whether it took effect.
+ */
+static void a9_aop_spi0_ch3_locked(void *data)
+{
+	struct a9_aop_spi0 *s = data;
+	struct a9_aop_spi0_ch3 *c = &s->ch3;
+	void __iomem *c3 = s->base + A9_SPI0_CH3;
+	void __iomem *c3c = s->base + A9_SPI0_CH3_0C;
+	void __iomem *base = a9_aop_spi0_channel_base(s, 3);
+	struct a9_aop_ch3_slice *p;
+	struct a9_aop_channel_diag_slice *d;
+	u32 interval[A9_SPI0_CHANNELS];
+	u32 value = 0;
+	u64 start;
+
+	a9_aop_spi0_ch3_snapshot(s->base, c->before);
+	c->run_before = c->before[A9_CH3_I_C3] & A9_SPI0_CH3_RUN;
+	c->stop = readl(c3) & ~A9_SPI0_CH3_STOP;
+	c->stop_ns = ktime_get_ns();
+	writel(c->stop, c3);
+	start = ktime_get_ns();
+	a9_aop_spi0_peers_begin(s, 3, interval, &c->peers_run);
+	c->poll = -ETIMEDOUT;
+	for (c->slices = 0; c->poll && c->slices < A9_SPI0_CH3_SLICES; c->slices++) {
+		p = &c->slice[c->slices];
+		c->poll = readl_poll_timeout_atomic(c3, value, value & A9_SPI0_CH3_IDLE,
+						    1, A9_SPI0_CH3_SLICE_US);
+		p->ns = ktime_get_ns() - start;
+		p->c3 = value;
+		p->scm_lo = readl(s->base + A9_SPI0_SCM_LO);
+		p->scm_hi = readl(s->base + A9_SPI0_SCM_HI);
+		p->fault = readl(s->base + A9_SPI0_FAULT);
+		d = &s->ch3_diag[c->slices];
+		d->cfg = readl(c3c);
+		d->interval = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_INTERVAL]);
+		d->cursor = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_CURSOR]);
+		d->fault_8d4 = readl(s->base + A9_SPI0_FAULT_8D4);
+	}
+	c->idle = value;
+	a9_aop_spi0_stop_timing(s, c, interval);
+	c->stable_why = a9_aop_spi0_stable_why(c, s->ch3_diag, 3);
+	c->stable = !c->stable_why;
+	if (c->stable)
+		s->teardown_stable |= BIT(3);
+	if (!c->poll || c->stable) {
+		/* A normal idle or the captured stopped state: mask callbacks. */
+		c->idle_us = div_u64(c->slice[c->slices - 1].ns, NSEC_PER_USEC);
+		c->class0 = readl(c3) & ~A9_SPI0_CH3_CLASS0;
+		writel(c->class0, c3);
+		c->class1 = readl(c3) & ~A9_SPI0_CH3_CLASS1;
+		writel(c->class1, c3);
+		writel(0, s->base + A9_SPI0_CH3_DESC);
+		c->ack = readl(c3c) | A9_SPI0_CH3_ACK;
+		writel(c->ack, c3c);
+	}
+	a9_aop_spi0_ch3_snapshot(s->base, c->after);
+	c->failed = c->poll && !c->stable ? "failed-ch3-teardown-idle" :
+					    a9_spi0_ch3_verify(c->after, c->stable);
+	if (!c->failed)
+		c->error = 0;
+	else if (c->stable)
+		c->error = -EIO;
+	else
+		c->error = c->poll ?: -EIO;
+}
+
+
+static void a9_aop_spi0_channel_snapshot(struct a9_aop_spi0 *s,
+					 unsigned int channel, u32 *values)
+{
+	void __iomem *base = a9_aop_spi0_channel_base(s, channel);
+
+	values[A9_CH3_I_C3] = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_CTL]);
+	values[A9_CH3_I_ROUTE] = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_ROUTE]);
+	values[A9_CH3_I_RATE] = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_RATE]);
+	values[A9_CH3_I_C3C] = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_CFG]);
+	values[A9_CH3_I_DESC] = readl(base + A9_SPI0_CHANNEL_DESC);
+	values[A9_CH3_I_8D0] = readl(s->base + A9_SPI0_FAULT);
+	values[A9_CH3_I_8D4] = readl(s->base + A9_SPI0_FAULT_8D4);
+}
+
+static const char *a9_spi0_channel_state_verify(u32 control, u32 desc,
+						u32 fault, u32 fault_8d4,
+						unsigned int channel,
+						bool stable_stop)
+{
+	u32 pending = BIT(2 * channel);
+
+	if (control & A9_SPI0_CH3_RUN)
+		return "failed-channel-teardown-run";
+	if (control & A9_SPI0_CH3_IRQ0)
+		return "failed-channel-teardown-class0";
+	if (control & A9_SPI0_CH3_IRQ1)
+		return "failed-channel-teardown-class1";
+	if (!(control & A9_SPI0_CH3_IDLE) && !stable_stop)
+		return "failed-channel-teardown-idle";
+	if (desc)
+		return "failed-channel-teardown-desc";
+	if ((fault | fault_8d4) & pending)
+		return "failed-channel-teardown-pending";
+	return NULL;
+}
+
+static const char *a9_spi0_channel_verify(const u32 *after,
+					  unsigned int channel,
+					  bool stable_stop)
+{
+	return a9_spi0_channel_state_verify(after[A9_CH3_I_C3],
+					      after[A9_CH3_I_DESC],
+					      after[A9_CH3_I_8D0],
+					      after[A9_CH3_I_8D4], channel,
+					      stable_stop);
+}
+
+/*
+ * Wake11 applies the channel-3 firmware sequence unchanged to another slot.
+ * Wake12 only appends read-only scheduler samples to that established poll.
+ */
+static void a9_aop_spi0_channel_locked(void *data)
+{
+	struct a9_aop_spi0_channel_op *op = data;
+	struct a9_aop_spi0 *s = op->spi0;
+	struct a9_aop_spi0_ch3 *c = op->state;
+	void __iomem *base = a9_aop_spi0_channel_base(s, op->channel);
+	void __iomem *control = base + a9_spi0_channel_offsets[A9_CHANNEL_I_CTL];
+	void __iomem *config = base + a9_spi0_channel_offsets[A9_CHANNEL_I_CFG];
+	struct a9_aop_ch3_slice *p;
+	struct a9_aop_channel_diag_slice *d;
+	u32 interval[A9_SPI0_CHANNELS];
+	u32 value = 0;
+	u64 start;
+
+	a9_aop_spi0_channel_snapshot(s, op->channel, c->before);
+	c->run_before = c->before[A9_CH3_I_C3] & A9_SPI0_CH3_RUN;
+	c->stop = readl(control) & ~A9_SPI0_CH3_STOP;
+	c->stop_ns = ktime_get_ns();
+	writel(c->stop, control);
+	start = ktime_get_ns();
+	a9_aop_spi0_peers_begin(s, op->channel, interval, &c->peers_run);
+	c->poll = -ETIMEDOUT;
+	for (c->slices = 0; c->poll && c->slices < A9_SPI0_CH3_SLICES; c->slices++) {
+		p = &c->slice[c->slices];
+		c->poll = readl_poll_timeout_atomic(control, value,
+						    value & A9_SPI0_CH3_IDLE, 1,
+						    A9_SPI0_CH3_SLICE_US);
+		p->ns = ktime_get_ns() - start;
+		p->c3 = value;
+		p->scm_lo = readl(s->base + A9_SPI0_SCM_LO);
+		p->scm_hi = readl(s->base + A9_SPI0_SCM_HI);
+		p->fault = readl(s->base + A9_SPI0_FAULT);
+		d = &s->channel_diag[c->slices];
+		d->cfg = readl(config);
+		d->interval = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_INTERVAL]);
+		d->cursor = readl(base + a9_spi0_channel_offsets[A9_CHANNEL_I_CURSOR]);
+		d->fault_8d4 = readl(s->base + A9_SPI0_FAULT_8D4);
+	}
+	c->idle = value;
+	a9_aop_spi0_stop_timing(s, c, interval);
+	c->stable_why = a9_aop_spi0_stable_why(c, s->channel_diag, op->channel);
+	c->stable = !c->stable_why;
+	if (c->stable)
+		s->teardown_stable |= BIT(op->channel);
+	if (!c->poll || c->stable) {
+		/* A normal idle or the captured stopped state: mask callbacks. */
+		c->idle_us = div_u64(c->slice[c->slices - 1].ns, NSEC_PER_USEC);
+		c->class0 = readl(control) & ~A9_SPI0_CH3_CLASS0;
+		writel(c->class0, control);
+		c->class1 = readl(control) & ~A9_SPI0_CH3_CLASS1;
+		writel(c->class1, control);
+		writel(0, base + A9_SPI0_CHANNEL_DESC);
+		c->ack = readl(config) | A9_SPI0_CH3_ACK;
+		writel(c->ack, config);
+	}
+	a9_aop_spi0_channel_snapshot(s, op->channel, c->after);
+	c->failed = c->poll && !c->stable ? "failed-channel-teardown-idle" :
+				      a9_spi0_channel_verify(c->after, op->channel,
+							c->stable);
+	if (!c->failed)
+		c->error = 0;
+	else if (c->stable)
+		c->error = -EIO;
+	else
+		c->error = c->poll ?: -EIO;
+}
+
+/* Called only if ps_spi0 is fully on; reads nothing. */
+static void a9_aop_spi0_pmgr_on(void *data)
+{
+	*(bool *)data = true;
+}
+
+/* AP PMGR ps_spi0, read-only: never requested, resumed or written.
+ * 0 = on, -EHOSTDOWN = off (raw still filled), -ENODEV = no node.
+ */
+static int a9_aop_spi0_pmgr(struct apple_aop *aop, u32 *raw)
+{
+	struct apple_pmgr_observation state = {};
+	bool on = false;
+	int ret;
+
+	if (!aop->spi0_pmgr)
+		return -ENODEV;
+	ret = apple_pmgr_observe(&aop->spi0_pmgr, 1, &state,
+				 a9_aop_spi0_pmgr_on, &on);
+	*raw = state.raw;
+	return ret ?: on ? 0 : -EIO;
+}
+
+/*
+ * After a reset that cleared +0x8d0 bit 6, before the image copy: CPU halted,
+ * AP notifications masked. A refusal sets ch3.failed and nothing is loaded.
+ */
+static int a9_aop_spi0_ch3_teardown(struct apple_aop *aop)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_spi0 *s = &aop->spi0;
+	struct a9_aop_spi0_ch3 *c = &s->ch3;
+	const u32 *b = c->before, *a = c->after;
+	const struct a9_aop_ch3_slice *p;
+	const struct a9_aop_channel_diag_slice *d;
+	unsigned int i;
+	bool source_progress = false;
+	int ret;
+
+	aop->experiment_step = "spi0-ch3-teardown";
+	dev_info(aop->dev, "SPI0 CH3TD begin pa=%llx cpu=halted: first channel-3 store follows\n",
+		 A9_SPI0_PA + A9_SPI0_CH3);
+	if (cold_defer) {
+		ret = a9_aop_cold_checkpoint_noflush(aop, "spi0-ch3-teardown");
+		if (ret) {
+			c->failed = "failed-ch3-teardown-checkpoint";
+			return ret;
+		}
+	}
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_spi0_ch3_locked, s);
+	if (ret) {
+		c->failed = "failed-ch3-teardown-guard";
+		dev_info(aop->dev, "SPI0 CH3TD errno=%d ran=0: guard refused, channel 3 not touched\n",
+			 ret);
+		return ret;
+	}
+	c->ran = true;
+	dev_info(aop->dev, "SPI0 CH3TD before c3=%08x route=%08x rate=%08x c3c=%08x desc=%08x 8d0=%08x 8d4=%08x\n",
+		 b[0], b[1], b[2], b[3], b[4], b[5], b[6]);
+	for (i = 0; i < c->slices; i++) {
+		p = &c->slice[i];
+		dev_info(aop->dev, "SPI0 CH3TD idle-sample slice=%u at_us=%llu c3=%08x scm_lo=%08x scm_hi=%08x 8d0=%08x idle=%u\n",
+			 i, div_u64(p->ns, NSEC_PER_USEC), p->c3, p->scm_lo,
+			 p->scm_hi, p->fault, !!(p->c3 & A9_SPI0_CH3_IDLE));
+		if (c->poll) {
+			d = &s->ch3_diag[i];
+			dev_info(aop->dev, "SPI0 CH3TD diagnostic slice=%u ctl=%08x cfg=%08x interval=%08x cursor=%08x scm_lo=%08x scm_hi=%08x 8d0=%08x 8d4=%08x\n",
+				 i, p->c3, d->cfg, d->interval, d->cursor, p->scm_lo,
+				 p->scm_hi, p->fault, d->fault_8d4);
+			if (i && (p->c3 != c->slice[0].c3 ||
+				  d->interval != s->ch3_diag[0].interval ||
+				  d->cursor != s->ch3_diag[0].cursor))
+				source_progress = true;
+		}
+	}
+	if (c->poll && c->slices)
+		dev_info(aop->dev, "SPI0 CH3TD diagnostic mode=scheduler-read-only samples=%u ctl_hi=%02x->%02x interval=%08x->%08x cursor=%08x->%08x source_progress=%u result=%s\n",
+			 c->slices,
+			 c->slice[0].c3 >> A9_SPI0_CHANNEL_PROGRESS_SHIFT,
+			 c->slice[c->slices - 1].c3 >> A9_SPI0_CHANNEL_PROGRESS_SHIFT,
+			 s->ch3_diag[0].interval,
+			 s->ch3_diag[c->slices - 1].interval,
+			 s->ch3_diag[0].cursor,
+			 s->ch3_diag[c->slices - 1].cursor, source_progress,
+			 c->stable ? "stable-stop-reset-only" : "refused");
+	/* beyond_fw_bound=1: idle, but later than the firmware would wait. */
+	dev_info(aop->dev, "SPI0 CH3TD idle-poll run_before=%u slices=%u/%u idle_us=%llu bound_us=%u fw_bound_us=%u beyond_fw_bound=%u result=%s\n",
+		 c->run_before, c->slices, A9_SPI0_CH3_SLICES, c->idle_us,
+		 A9_SPI0_CH3_SLICES * A9_SPI0_CH3_SLICE_US, A9_SPI0_CH3_IDLE_FW_US,
+		 !c->poll && c->idle_us > A9_SPI0_CH3_IDLE_FW_US,
+		 c->poll ? "timeout" : "idle");
+	if (c->poll && !c->stable)
+		dev_info(aop->dev, "SPI0 CH3TD writes stop=%08x idle_poll=%08x poll_errno=%d masks=skipped: idle bit 1 never set, no further store\n",
+			 c->stop, c->idle, c->poll);
+	else if (c->stable)
+		dev_info(aop->dev, "SPI0 CH3TD writes stop=%08x idle_poll=%08x poll_errno=%d stable_stop=1 class0=%08x class1=%08x desc=00000000 c3c=%08x\n",
+			 c->stop, c->idle, c->poll, c->class0, c->class1, c->ack);
+	else
+		dev_info(aop->dev, "SPI0 CH3TD writes stop=%08x idle_poll=%08x poll_errno=0 class0=%08x class1=%08x desc=00000000 c3c=%08x\n",
+			 c->stop, c->idle, c->class0, c->class1, c->ack);
+	dev_info(aop->dev, "SPI0 CH3TD after c3=%08x route=%08x rate=%08x c3c=%08x desc=%08x 8d0=%08x 8d4=%08x\n",
+		 a[0], a[1], a[2], a[3], a[4], a[5], a[6]);
+	dev_info(aop->dev, "SPI0 CH3TD timing reset_to_stop_us=%llu late=%u peers_run=%04x peers_ticking=%04x stable=%u checkpoint=noflush stable_why=%s\n",
+		 c->reset_to_stop_us, c->reset_to_stop_us > A9_SPI0_LATE_STOP_US,
+		 c->peers_run, c->peers_ticking, c->stable,
+		 c->stable ? "stable" : c->poll ? c->stable_why : "idle");
+	/* c3c_bit5 is the pulse's readback, logged only (0 at 19:50). */
+	dev_info(aop->dev, "SPI0 CH3TD check errno=%d run=%u class0=%u class1=%u idle=%u desc=%08x c3c_bit5=%u ch3_pending=%u result=%s\n",
+		 c->error, !!(a[A9_CH3_I_C3] & A9_SPI0_CH3_RUN),
+		 !!(a[A9_CH3_I_C3] & A9_SPI0_CH3_IRQ0),
+		 !!(a[A9_CH3_I_C3] & A9_SPI0_CH3_IRQ1), !!(a[A9_CH3_I_C3] & A9_SPI0_CH3_IDLE),
+		 a[A9_CH3_I_DESC], !!(a[A9_CH3_I_C3C] & A9_SPI0_CH3_ACK),
+		 !!(a[A9_CH3_I_8D0] & A9_SPI0_CH3_PENDING), c->failed ?:
+		 c->stable ? "pass-stable-reset-only" : "pass");
+	return c->error;
+}
+
+static int a9_aop_spi0_channel_teardown(struct apple_aop *aop,
+					unsigned int channel)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_spi0 *s = &aop->spi0;
+	struct a9_aop_spi0_ch3 *c = &s->channel;
+	struct a9_aop_spi0_channel_op op = {
+		.spi0 = s,
+		.state = c,
+		.channel = channel,
+	};
+	const u32 *b, *a;
+	const struct a9_aop_ch3_slice *p;
+	const struct a9_aop_channel_diag_slice *d;
+	char checkpoint[32];
+	unsigned int i;
+	bool source_progress = false;
+	bool stable_stop;
+	int ret;
+
+	memset(c, 0, sizeof(*c));
+	memset(s->channel_diag, 0, sizeof(s->channel_diag));
+	s->teardown_failed_channel = channel;
+	aop->experiment_step = "spi0-channel-teardown";
+	snprintf(checkpoint, sizeof(checkpoint), "spi0-ch%u-teardown", channel);
+	dev_info(aop->dev, "SPI0 CH%uTD begin pa=%llx cpu=halted: first channel-%u store follows\n",
+		 channel, A9_SPI0_PA + A9_SPI0_CHANNEL_BASE +
+		 A9_SPI0_CHANNEL_STRIDE * channel, channel);
+	if (cold_defer) {
+		ret = a9_aop_cold_checkpoint_noflush(aop, checkpoint);
+		if (ret) {
+			c->failed = "failed-channel-teardown-checkpoint";
+			return ret;
+		}
+	}
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_spi0_channel_locked, &op);
+	if (ret) {
+		c->failed = "failed-channel-teardown-guard";
+		dev_info(aop->dev, "SPI0 CH%uTD errno=%d ran=0: guard refused, channel %u not touched\n",
+			 channel, ret, channel);
+		return ret;
+	}
+	c->ran = true;
+	stable_stop = s->teardown_stable & BIT(channel);
+	b = c->before;
+	a = c->after;
+	dev_info(aop->dev, "SPI0 CH%uTD before ctl=%08x route=%08x rate=%08x cfg=%08x desc=%08x 8d0=%08x 8d4=%08x\n",
+		 channel, b[0], b[1], b[2], b[3], b[4], b[5], b[6]);
+	for (i = 0; i < c->slices; i++) {
+		p = &c->slice[i];
+		dev_info(aop->dev, "SPI0 CH%uTD idle-sample slice=%u at_us=%llu ctl=%08x scm_lo=%08x scm_hi=%08x 8d0=%08x idle=%u\n",
+			 channel, i, div_u64(p->ns, NSEC_PER_USEC), p->c3,
+			 p->scm_lo, p->scm_hi, p->fault,
+			 !!(p->c3 & A9_SPI0_CH3_IDLE));
+		if (c->poll) {
+			d = &s->channel_diag[i];
+			dev_info(aop->dev, "SPI0 CH%uTD diagnostic slice=%u ctl=%08x cfg=%08x interval=%08x cursor=%08x scm_lo=%08x scm_hi=%08x 8d0=%08x 8d4=%08x\n",
+				 channel, i, p->c3, d->cfg, d->interval, d->cursor,
+				 p->scm_lo, p->scm_hi, p->fault, d->fault_8d4);
+			if (i && (p->c3 != c->slice[0].c3 ||
+				  d->interval != s->channel_diag[0].interval ||
+				  d->cursor != s->channel_diag[0].cursor))
+				source_progress = true;
+		}
+	}
+	if (c->poll && c->slices)
+		dev_info(aop->dev, "SPI0 CH%uTD diagnostic mode=scheduler-read-only samples=%u ctl_hi=%02x->%02x interval=%08x->%08x cursor=%08x->%08x source_progress=%u result=%s\n",
+			 channel, c->slices,
+			 c->slice[0].c3 >> A9_SPI0_CHANNEL_PROGRESS_SHIFT,
+			 c->slice[c->slices - 1].c3 >> A9_SPI0_CHANNEL_PROGRESS_SHIFT,
+			 s->channel_diag[0].interval,
+			 s->channel_diag[c->slices - 1].interval,
+			 s->channel_diag[0].cursor,
+			 s->channel_diag[c->slices - 1].cursor,
+			 source_progress,
+			 stable_stop ? "stable-stop-reset-only" : "refused");
+	dev_info(aop->dev, "SPI0 CH%uTD idle-poll run_before=%u slices=%u/%u idle_us=%llu bound_us=%u fw_bound_us=%u beyond_fw_bound=%u result=%s\n",
+		 channel, c->run_before, c->slices, A9_SPI0_CH3_SLICES, c->idle_us,
+		 A9_SPI0_CH3_SLICES * A9_SPI0_CH3_SLICE_US, A9_SPI0_CH3_IDLE_FW_US,
+		 !c->poll && c->idle_us > A9_SPI0_CH3_IDLE_FW_US,
+		 c->poll ? "timeout" : "idle");
+	if (c->poll && !stable_stop)
+		dev_info(aop->dev, "SPI0 CH%uTD writes stop=%08x idle_poll=%08x poll_errno=%d masks=skipped: idle bit 1 never set, no further store\n",
+			 channel, c->stop, c->idle, c->poll);
+	else if (stable_stop)
+		dev_info(aop->dev, "SPI0 CH%uTD writes stop=%08x idle_poll=%08x poll_errno=%d stable_stop=1 class0=%08x class1=%08x desc=00000000 cfg=%08x\n",
+			 channel, c->stop, c->idle, c->poll, c->class0, c->class1,
+			 c->ack);
+	else
+		dev_info(aop->dev, "SPI0 CH%uTD writes stop=%08x idle_poll=%08x poll_errno=0 class0=%08x class1=%08x desc=00000000 cfg=%08x\n",
+			 channel, c->stop, c->idle, c->class0, c->class1, c->ack);
+	dev_info(aop->dev, "SPI0 CH%uTD after ctl=%08x route=%08x rate=%08x cfg=%08x desc=%08x 8d0=%08x 8d4=%08x\n",
+		 channel, a[0], a[1], a[2], a[3], a[4], a[5], a[6]);
+	dev_info(aop->dev, "SPI0 CH%uTD timing reset_to_stop_us=%llu late=%u peers_run=%04x peers_ticking=%04x stable=%u checkpoint=noflush stable_why=%s\n",
+		 channel, c->reset_to_stop_us, c->reset_to_stop_us > A9_SPI0_LATE_STOP_US,
+		 c->peers_run, c->peers_ticking, c->stable,
+		 c->stable ? "stable" : c->poll ? c->stable_why : "idle");
+	dev_info(aop->dev, "SPI0 CH%uTD check errno=%d run=%u class0=%u class1=%u idle=%u desc=%08x cfg_bit5=%u pending0=%u pending1=%u result=%s\n",
+		 channel, c->error, !!(a[A9_CH3_I_C3] & A9_SPI0_CH3_RUN),
+		 !!(a[A9_CH3_I_C3] & A9_SPI0_CH3_IRQ0),
+		 !!(a[A9_CH3_I_C3] & A9_SPI0_CH3_IRQ1),
+		 !!(a[A9_CH3_I_C3] & A9_SPI0_CH3_IDLE), a[A9_CH3_I_DESC],
+		 !!(a[A9_CH3_I_C3C] & A9_SPI0_CH3_ACK),
+		 !!(a[A9_CH3_I_8D0] & BIT(2 * channel)),
+		 !!(a[A9_CH3_I_8D4] & BIT(2 * channel)), c->failed ?:
+		 stable_stop ? "pass-stable-reset-only" : "pass");
+	return c->error;
+}
+
+static const char *a9_aop_spi0_selected_verify(struct a9_aop_spi0 *s)
+{
+	const u32 *v;
+	const char *failed = NULL;
+	unsigned int channel;
+
+	if (s->teardown_selected != s->teardown_done)
+		return "failed-channel-teardown-incomplete";
+	for (channel = 0; channel < A9_SPI0_CHANNELS; channel++) {
+		if (channel == 3 || !(s->teardown_selected & BIT(channel)))
+			continue;
+		v = s->trace.channel[channel];
+		failed = a9_spi0_channel_state_verify(v[A9_CHANNEL_I_CTL],
+						 v[A9_CHANNEL_I_DESC],
+						 s->trace.ch3[A9_CH3_I_8D0],
+						 s->trace.ch3[A9_CH3_I_8D4], channel,
+						 s->teardown_stable & BIT(channel));
+		if (failed) {
+			s->teardown_failed_channel = channel;
+			return failed;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * Channel 3 remains mandatory and executes first. Wake11 additionally selects
+ * every snapshot slot with run bit 0 (RUN) set and a nonzero interval, which
+ * excludes configured-but-idle slots while selecting any periodic client still
+ * owned by the old firmware. Wake16 returns to wake11's order after wake15's
+ * channel-7-first stop failed: all ten device stops fit "channel 3 idles when
+ * stopped within ~2 ms of the reset (5/5; 0/2 at 11 and 33 ms) and channel 7
+ * never idles (0/3, at 0.3 ms, 1.9 ms and 15 ms)". Channel 3 goes first and
+ * early; channel 7 is then the stopped-without-idle channel the stable-stop
+ * fingerprint was captured from (wake11/12).
+ */
+static int a9_aop_spi0_teardown_running(struct apple_aop *aop)
+{
+	struct a9_aop_spi0 *s = &aop->spi0;
+	const u32 *v;
+	unsigned int channel;
+	int ret;
+
+	s->teardown_selected = BIT(3);
+	s->teardown_done = 0;
+	s->teardown_stable = 0;
+	s->teardown_failed_channel = A9_SPI0_CHANNELS;
+	for (channel = 0; channel < A9_SPI0_CHANNELS; channel++) {
+		if (channel == 3)
+			continue;
+		v = s->trace.channel[channel];
+		if ((v[A9_CHANNEL_I_CTL] & A9_SPI0_CH3_RUN) &&
+		    v[A9_CHANNEL_I_INTERVAL])
+			s->teardown_selected |= BIT(channel);
+	}
+	dev_info(aop->dev, "SPI0 teardown select stage=after-controller-reset selected=%04x mandatory=0008 rule=ch3-or-run-and-interval order=ch3-then-others\n",
+		 s->teardown_selected);
+	ret = a9_aop_spi0_ch3_teardown(aop);
+	if (ret) {
+		s->teardown_failed_channel = 3;
+		dev_info(aop->dev, "SPI0 teardown refused selected=%04x done=%04x failed_channel=3 errno=%d result=%s\n",
+			 s->teardown_selected, s->teardown_done, ret,
+			 s->ch3.failed ?: "failed-ch3-teardown");
+		return ret;
+	}
+	s->teardown_done |= BIT(3);
+	for (channel = 0; channel < A9_SPI0_CHANNELS; channel++) {
+		if (channel == 3 || !(s->teardown_selected & BIT(channel)))
+			continue;
+		ret = a9_aop_spi0_channel_teardown(aop, channel);
+		if (ret) {
+			dev_info(aop->dev, "SPI0 teardown refused selected=%04x done=%04x failed_channel=%u errno=%d result=%s\n",
+				 s->teardown_selected, s->teardown_done, channel, ret,
+				 s->channel.failed ?: "failed-channel-teardown");
+			return ret;
+		}
+		s->teardown_done |= BIT(channel);
+	}
+	s->teardown_failed_channel = A9_SPI0_CHANNELS;
+	dev_info(aop->dev, "SPI0 teardown complete selected=%04x done=%04x stable=%04x result=pass\n",
+		 s->teardown_selected, s->teardown_done, s->teardown_stable);
+	return 0;
+}
+
+/*
+ * Second copy of the firmware controller reset, after the stop has completed.
+ * The preceding after-ch3-teardown trace is the read-only before snapshot;
+ * after-post-teardown-reset is the matching read-only after snapshot. Refuse
+ * the image copy unless SCM is zero and every channel quiet-state gate holds.
+ */
+static int a9_aop_spi0_post_reset(struct apple_aop *aop)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_spi0 *s = &aop->spi0;
+	struct a9_aop_spi0_post_reset *r = &s->post_reset;
+	const u32 *b = r->before, *a = r->after;
+	int ret;
+
+	if (!aop->force_halted || !aop->force_drained || !s->ch3.ran ||
+	    s->ch3.error || s->teardown_selected != s->teardown_done || r->ran) {
+		r->failed = "failed-post-reset-state";
+		return -EPERM;
+	}
+	aop->experiment_step = "spi0-post-teardown-reset";
+	dev_info(aop->dev, "SPI0 POSTRST begin pa=%llx reason=ch3-stop-latched-scm cpu=halted\n",
+		 A9_SPI0_PA);
+	if (cold_defer) {
+		ret = a9_aop_cold_checkpoint(aop, "spi0-post-teardown-reset");
+		if (ret) {
+			r->failed = "failed-post-reset-checkpoint";
+			return ret;
+		}
+	}
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_spi0_post_reset_locked, s);
+	r->ran = !ret;
+	r->error = ret ?: r->error;
+	dev_info(aop->dev, "SPI0 POSTRST errno=%d ran=%d before ctl=%08x clk=%08x 8d0=%08x 8d4=%08x ch3=%08x ch3c=%08x\n",
+		 r->error, r->ran, b[0], b[1], b[2], b[3], b[4], b[5]);
+	dev_info(aop->dev, "SPI0 POSTRST after ctl=%08x clk=%08x 8d0=%08x 8d4=%08x ch3=%08x ch3c=%08x saved=%08x asserted=%08x polled=%08x ch3_pending=%u->%u\n",
+		 a[0], a[1], a[2], a[3], a[4], a[5], r->saved, r->asserted,
+		 r->polled, !!(b[A9_SPI0_I_FAULT] & A9_SPI0_CH3_PENDING),
+		 !!(a[A9_SPI0_I_FAULT] & A9_SPI0_CH3_PENDING));
+	if (r->error) {
+		r->failed = "failed-post-reset-controller";
+		return r->error;
+	}
+	ret = a9_aop_spi0_trace(aop, "after-post-teardown-reset");
+	if (ret)
+		return ret;
+	if (s->trace.scm[0] || s->trace.scm[1])
+		r->failed = "failed-post-reset-scm";
+	else {
+		r->failed = a9_spi0_ch3_verify(s->trace.ch3,
+					       s->teardown_stable & BIT(3));
+		if (!r->failed)
+			r->failed = a9_aop_spi0_selected_verify(s);
+	}
+	ret = r->failed ? -EIO : 0;
+	dev_info(aop->dev, "SPI0 POSTRST check errno=%d scm_lo=%08x scm_hi=%08x ch3_pending=%u result=%s\n",
+		 ret, s->trace.scm[0], s->trace.scm[1],
+		 !!(s->trace.ch3[A9_CH3_I_8D0] & A9_SPI0_CH3_PENDING),
+		 r->failed ?: "pass");
+	dev_info(aop->dev, "SPI0 POSTRST channels selected=%04x done=%04x stable=%04x result=%s\n",
+		 s->teardown_selected, s->teardown_done, s->teardown_stable,
+		 r->failed ?: "pass");
+	return ret;
+}
+
+/*
+ * The ten INTC words of a9_intc_offsets into state[@at], read only. The
+ * INTC is the AOP wrapper block (0xc1800000 in the firmware, space 2 as
+ * SPI0's verified 0xc1100000 = 0x210100000), which this driver reads
+ * unguarded for the mailbox and CPU control; no separate PMGR domain.
+ */
+static void a9_aop_intc_snapshot(struct apple_aop *aop, unsigned int at)
+{
+	struct a9_aop_intc *n = &aop->spi0.intc;
+	u32 *v = n->state[at];
+	unsigned int i;
+
+	for (i = 0; i < A9_INTC_REGS; i++)
+		v[i] = aop_rd(aop, a9_intc_offsets[i]);
+	n->states |= BIT(at);
+	dev_info(aop->dev, "AOP INTC state at=%s reset808=%08x current81c=%08x raise900=%08x ack980=%08x mask_a00=%08x mask_a04=%08x mask_a08=%08x mask_a80=%08x g7_c020=%08x g7_c024=%08x src_masked=%u view=%s\n",
+		 a9_intc_at_name(at), v[0], v[1], v[2], v[3], v[4], v[5], v[6],
+		 v[7], v[8], v[9], !!(v[A9_INTC_I_MASK0] & A9_INTC_SPI0_SCM),
+		 a9_intc_view(v));
+}
+
+/*
+ * Round 4 (ds-aop-spi0-ch3-round4.md): the old session's SPI0 global IRQ
+ * 0x10014 stays latched in the AOP interrupt controller, and fresh firmware
+ * takes it as soon as SPI lifecycle event 1 enables it, before its own SPI0
+ * reset (SCMErr:0x3,3). With the CPU halted and before the first SPI0
+ * access, disable that source (group 1 disable bank, 0102c9ce). The bank
+ * reads back the mask, as the firmware's own reads of it show: bit 20 must
+ * read 1 after the store.
+ */
+static int a9_aop_intc_disable(struct apple_aop *aop)
+{
+	struct a9_aop_intc *n = &aop->spi0.intc;
+	const u32 *b = n->state[A9_INTC_AT_PRE_DISABLE];
+	const u32 *a = n->state[A9_INTC_AT_POST_DISABLE];
+	int ret;
+
+	aop->experiment_step = "intc-disable";
+	dev_info(aop->dev, "AOP INTC disable begin irq=0x10014 pa=%llx value=%08x cpu=halted: first INTC store follows\n",
+		 A9_SPI0_WRAPPER_PA + A9_INTC_DISABLE, A9_INTC_SPI0_SCM);
+	if (cold_defer) {
+		ret = a9_aop_cold_checkpoint(aop, "intc-disable");
+		if (ret) {
+			n->failed = "failed-intc-disable-checkpoint";
+			return ret;
+		}
+	}
+	a9_aop_intc_snapshot(aop, A9_INTC_AT_PRE_DISABLE);
+	ret = aop_wr(aop, A9_INTC_DISABLE, A9_INTC_SPI0_SCM);
+	a9_aop_intc_snapshot(aop, A9_INTC_AT_POST_DISABLE);
+	if (ret) {
+		n->failed = "failed-intc-disable";
+	} else if (!(a[A9_INTC_I_MASK0] & A9_INTC_SPI0_SCM)) {
+		n->failed = "failed-intc-disable-readback";
+		ret = -EIO;
+	}
+	n->disabled = !ret;
+	dev_info(aop->dev, "AOP INTC disable errno=%d before=%08x value=%08x after=%08x mask_a80=%08x src_masked=%u view=%s result=%s\n",
+		 ret, b[A9_INTC_I_MASK0], A9_INTC_SPI0_SCM, a[A9_INTC_I_MASK0],
+		 a[A9_INTC_I_ENABLE0], !!(a[A9_INTC_I_MASK0] & A9_INTC_SPI0_SCM),
+		 a9_intc_view(a), n->failed ?: "pass");
+	return ret;
+}
+
+/*
+ * Release policy for aop_spi0_reset=1. The reload is device-proven for exactly
+ * one retained state: the previous kernel quiesced and halted the firmware
+ * (wake16, 2026-10-29; decision prev-quiesce-halted). Auto-boot still set, a
+ * previous kernel that did not halt it, or an older kernel in the chain are
+ * different hardware states that no run has reloaded with the final teardown.
+ * Refuse them before the first halt or SPI0 access so the old firmware is
+ * left exactly as found; aop_spi0_untested=1 attempts them anyway. A skip
+ * (DFU cold, bad record, nothing ran) must also find the wrapper at its reset
+ * state: a record-less AOP that something already stopped is refused rather
+ * than cold-loaded. A stale record skips as before.
+ */
+static int a9_aop_spi0_policy(struct apple_aop *aop, u32 auto_boot, u32 outbox)
+{
+	enum a9_spi0_reason reason = a9_spi0_decide(auto_boot, outbox & AOP_OUTBOX_ENABLE,
+						    &aop->spi0.prev);
+
+	if (a9_spi0_policy_allows(reason, outbox & AOP_OUTBOX_ENABLE, spi0_untested))
+		return 0;
+	dev_info(aop->dev, "SPI0 policy decision=refuse reason=%s auto_boot=%u out4020=%08x prev=%s prev_hello=%d prev_halted=%d: only prev-quiesce-halted reloads and a skip needs the wrapper at its reset state block not touched\n",
+		 a9_spi0_reason_name(reason), auto_boot, outbox,
+		 a9_spi0_prev_name(aop->spi0.prev.state), aop->spi0.prev.hello,
+		 aop->spi0.prev.halted);
+	return -EPERM;
+}
+
+/*
+ * After the proven halt/drain, before any SRAM write. Only firmware that ran
+ * since the last SoC reset leaves SPI0 state behind: auto-boot 1, or the
+ * previous kernel's transcript bound by +0x4020 (a9_spi0_decide). Without
+ * that evidence the block is never touched. @auto_boot and @outbox are the
+ * boot snapshot from before the stop. Nonzero means: do not load or
+ * release the AOP.
+ */
+static int a9_aop_spi0_prereset(struct apple_aop *aop, u32 auto_boot, u32 outbox)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_spi0 *s = &aop->spi0;
+	const u32 *b = s->before, *a = s->after;
+	const char *failed = NULL;
+	bool run;
+	int ret;
+
+	s->auto_boot = auto_boot;
+	s->outbox = outbox;
+	s->reason = a9_spi0_decide(auto_boot, outbox & AOP_OUTBOX_ENABLE, &s->prev);
+	s->decided = true;
+	run = a9_spi0_reason_runs(s->reason);
+	dev_info(aop->dev, "SPI0 reset decision=%s reason=%s auto_boot=%u out4020=%08x prev=%s prev_hello=%d prev_halted=%d prev_steps=0x%x prev_carry=%d%s\n",
+		 run ? "run" : "skip", a9_spi0_reason_name(s->reason), auto_boot,
+		 outbox, a9_spi0_prev_name(s->prev.state), s->prev.hello,
+		 s->prev.halted, s->prev.steps, s->prev.carried,
+		 run ? "" : ": block not touched");
+	if (!run) {
+		s->skipped = a9_spi0_reason_name(s->reason);
+		return 0;
+	}
+	if (!s->base || !aop->force_halted || !aop->force_drained ||
+	    !a9_aop_force_stopped(aop))
+		return -EPERM;
+	ret = a9_aop_intc_disable(aop);
+	if (ret)
+		return ret;
+	aop->experiment_step = "spi0-reset";
+	s->pmgr_before_errno = a9_aop_spi0_pmgr(aop, &s->pmgr_before);
+	/* Reaches ramoops before the first AP access to the block. */
+	dev_info(aop->dev, "SPI0 reset begin pa=%llx cpu=halted ps_spi0=%08x errno=%d: first AP access follows\n",
+		 A9_SPI0_PA, s->pmgr_before, s->pmgr_before_errno);
+	if (cold_defer) {
+		ret = a9_aop_cold_checkpoint(aop, "spi0-reset");
+		if (ret)
+			return ret;
+	}
+	ret = a9_aop_spi0_trace(aop, "before-controller-reset");
+	if (ret)
+		return ret;
+	/*
+	 * Wake15: from the controller reset to the last channel stop nothing may
+	 * drain a console in this task. Holding the console lock makes every
+	 * dev_info() below only append to the log buffer; the flushed spi0-reset
+	 * checkpoint above already put the begin line into ramoops, and the lines
+	 * are emitted by console_unlock() once the stops are stored.
+	 */
+	console_lock();
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_spi0_reset_locked, s);
+	s->ran = !ret;
+	s->error = ret ?: s->error;
+	s->pmgr_after_errno = a9_aop_spi0_pmgr(aop, &s->pmgr_after);
+	dev_info(aop->dev, "SPI0 reset errno=%d ran=%d pa=%llx before ctl=%08x clk=%08x 8d0=%08x 8d4=%08x ch3=%08x ch3c=%08x\n",
+		 s->error, s->ran, A9_SPI0_PA, b[0], b[1], b[2], b[3], b[4], b[5]);
+	dev_info(aop->dev, "SPI0 reset after ctl=%08x clk=%08x 8d0=%08x 8d4=%08x ch3=%08x ch3c=%08x saved=%08x asserted=%08x polled=%08x ch3_pending=%u->%u provider3=not-replayed\n",
+		 a[0], a[1], a[2], a[3], a[4], a[5], s->saved, s->asserted,
+		 s->polled, !!(b[A9_SPI0_I_FAULT] & A9_SPI0_CH3_PENDING),
+		 !!(a[A9_SPI0_I_FAULT] & A9_SPI0_CH3_PENDING));
+	dev_info(aop->dev, "SPI0 pmgr ps_spi0 before=%08x errno=%d after=%08x errno=%d (read-only, never powered)\n",
+		 s->pmgr_before, s->pmgr_before_errno, s->pmgr_after,
+		 s->pmgr_after_errno);
+	if (s->error) {
+		console_unlock();
+		return s->error;
+	}
+	ret = a9_aop_spi0_trace(aop, "after-controller-reset");
+	if (!ret)
+		ret = a9_aop_spi0_teardown_running(aop);
+	console_unlock();
+	if (!ret)
+		ret = a9_aop_spi0_trace(aop, "after-ch3-teardown");
+	if (!ret)
+		failed = a9_aop_spi0_selected_verify(s);
+	if (failed) {
+		s->channel.failed = failed;
+		ret = -EIO;
+	}
+	if (!ret)
+		ret = a9_aop_spi0_post_reset(aop);
+	return ret;
+}
+
+/* Wake10 samples both SCM words and both fault classes, not only channel 3. */
+static void a9_aop_spi0_fault_read(void *data)
+{
+	struct a9_aop_spi0 *s = data;
+
+	s->prerun_scm_lo = readl(s->base + A9_SPI0_SCM_LO);
+	s->prerun_scm_hi = readl(s->base + A9_SPI0_SCM_HI);
+	s->prerun = readl(s->base + A9_SPI0_FAULT);
+	s->prerun_8d4 = readl(s->base + A9_SPI0_FAULT_8D4);
+	if (s->prerun & A9_SPI0_CH3_PENDING)
+		a9_aop_spi0_ch3_snapshot(s->base, s->ch3.reassert);
+}
+
+/*
+ * Last AP look before RUN, CPU still halted, after the image copy: bit 6
+ * must stay clear in every one of 31 guarded samples spaced >= 5 ms apart,
+ * spanning >= 150 ms. A reasserted channel-3 bit would crash the fresh
+ * image as before, so the first set sample refuses the release; nothing is
+ * retried. Any refusal sets ch3.failed.
+ */
+static int a9_aop_spi0_recheck(struct apple_aop *aop)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_spi0 *s = &aop->spi0;
+	struct a9_aop_spi0_ch3 *c = &s->ch3;
+	const u32 *r = c->reassert;
+	u64 start = ktime_get_boottime_ns();
+	unsigned int i;
+	int ret = 0;
+
+	for (i = 0; i < A9_SPI0_WINDOW_SAMPLES; i++) {
+		if (i)
+			usleep_range(A9_SPI0_WINDOW_US, A9_SPI0_WINDOW_US + 1000);
+		ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+					 a9_aop_spi0_fault_read, s);
+		c->samples = i + 1;
+		c->elapsed_ms = div_u64(ktime_get_boottime_ns() - start, NSEC_PER_MSEC);
+		if (ret) {
+			c->failed = "failed-ch3-window-guard";
+			break;
+		}
+		if (s->prerun_scm_lo || s->prerun_scm_hi || s->prerun ||
+		    s->prerun_8d4) {
+			s->reasserted = c->reasserted = true;
+			c->reassert_sample = i;
+			c->reassert_ms = c->elapsed_ms;
+			c->failed = "failed-spi0-window-reasserted";
+			ret = -EIO;
+			dev_info(aop->dev, "SPI0 WINDOW reasserted sample=%u at_ms=%llu scm_lo=%08x scm_hi=%08x 8d0=%08x 8d4=%08x cpu=halted\n",
+				 i, c->reassert_ms, s->prerun_scm_lo, s->prerun_scm_hi,
+				 s->prerun, s->prerun_8d4);
+			if (s->prerun & A9_SPI0_CH3_PENDING)
+				dev_info(aop->dev, "SPI0 WINDOW channel3 c3=%08x route=%08x rate=%08x c3c=%08x desc=%08x 8d0=%08x 8d4=%08x\n",
+					 r[0], r[1], r[2], r[3], r[4], r[5], r[6]);
+			break;
+		}
+	}
+	/* usleep_range() cannot return early; this only trips on a bad clock. */
+	if (!ret && c->elapsed_ms < A9_SPI0_WINDOW_MS) {
+		c->failed = "failed-ch3-window-short";
+		ret = -EIO;
+	}
+	c->window_done = !ret;
+	dev_info(aop->dev, "SPI0 CH3TD window errno=%d samples=%u/%u elapsed_ms=%llu min_ms=%u result=%s\n",
+		 ret, c->samples, A9_SPI0_WINDOW_SAMPLES, c->elapsed_ms,
+		 A9_SPI0_WINDOW_MS, ret ? c->failed : "pass");
+	dev_info(aop->dev, "SPI0 pre-run errno=%d 8d0=%08x ch3_pending=%u cpu=halted\n",
+		 ret, s->prerun, !!(s->prerun & A9_SPI0_CH3_PENDING));
+	dev_info(aop->dev, "SPI0 WINDOW state errno=%d scm_lo=%08x scm_hi=%08x 8d0=%08x 8d4=%08x result=%s\n",
+		 ret, s->prerun_scm_lo, s->prerun_scm_hi, s->prerun,
+		 s->prerun_8d4, ret ? c->failed : "pass");
+	if (ret && c->reasserted)
+		a9_aop_spi0_trace(aop, "window-fault");
+	return ret;
+}
+
+/* SCM state and the channel-3 interval pair, read-only, into scm[scm_at]. */
+static void a9_aop_spi0_scm_read(void *data)
+{
+	struct a9_aop_spi0 *s = data;
+	unsigned int i;
+
+	for (i = 0; i < A9_SPI0_SCM_REGS; i++)
+		s->intc.scm[s->intc.scm_at][i] = readl(s->base + a9_spi0_scm_offsets[i]);
+}
+
+/*
+ * After the clean pre-RUN window, CPU still halted: the firmware's group-1
+ * pre-handler acknowledge for 0x10014 (0102c6de..0102c6f2) discards the
+ * old-session latch now that its SPI0 cause is quiet. Fresh firmware
+ * re-enables the source in event 1. The INTC words, the SCM state and the
+ * C3 interval pair are logged around it and never gated: with 0x10014
+ * masked, no readable word shows whether it is still pending.
+ */
+static int a9_aop_intc_ack(struct apple_aop *aop)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_spi0 *s = &aop->spi0;
+	struct a9_aop_intc *n = &s->intc;
+	const u32 *p = n->scm[0], *q = n->scm[1];
+	const u32 *b = n->state[A9_INTC_AT_PRE_ACK];
+	const u32 *a = n->state[A9_INTC_AT_POST_ACK];
+	int ret;
+
+	aop->experiment_step = "intc-ack";
+	n->scm_at = 0;
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_spi0_scm_read, s);
+	if (ret) {
+		n->failed = "failed-intc-ack-guard";
+		dev_info(aop->dev, "AOP INTC pre-ack errno=%d: guard refused, no acknowledge\n",
+			 ret);
+		return ret;
+	}
+	a9_aop_intc_snapshot(aop, A9_INTC_AT_PRE_ACK);
+	dev_info(aop->dev, "AOP INTC pre-ack scm_lo=%08x scm_hi=%08x c3_interval=%08x c3_cursor=%08x current=%08x cpu=halted\n",
+		 p[0], p[1], p[2], p[3], b[A9_INTC_I_CURRENT]);
+	ret = aop_wr(aop, A9_INTC_ACK, A9_INTC_SPI0_SCM);
+	/* Also the posted-write barrier. */
+	a9_aop_intc_snapshot(aop, A9_INTC_AT_POST_ACK);
+	n->acked = !ret;
+	dev_info(aop->dev, "AOP INTC ack errno=%d before=%08x value=%08x after=%08x\n",
+		 ret, b[A9_INTC_I_ACK], A9_INTC_SPI0_SCM, a[A9_INTC_I_ACK]);
+	if (ret) {
+		n->failed = "failed-intc-ack";
+		return ret;
+	}
+	n->scm_at = 1;
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_spi0_scm_read, s);
+	if (ret)
+		n->failed = "failed-intc-post-guard";
+	dev_info(aop->dev, "AOP INTC post-ack errno=%d scm_lo=%08x scm_hi=%08x c3_interval=%08x c3_cursor=%08x current=%08x result=%s\n",
+		 ret, q[0], q[1], q[2], q[3], a[A9_INTC_I_CURRENT], n->failed ?: "pass");
+	return ret;
+}
+
+/*
+ * Wake7 still took 0x10014 before SPI event 5 despite the targeted ack.
+ * Replay INTC lifecycle event 3 (0102c592/598/59c/5a2): 1/read/0/read at
+ * +0x808. aop_wr includes a posted-write read after each store. This resets
+ * all AOP-private interrupt state; it does not write the SCM status or MPU.
+ * No assumption that SCM must become zero. Only the final reset readback
+ * and the established channel-3 quiet conditions gate RUN.
+ */
+static int a9_aop_intc_reset(struct apple_aop *aop)
+{
+	struct a9_aop_spi0 *s = &aop->spi0;
+	struct a9_aop_intc *n = &s->intc;
+	int ret;
+
+	if (!aop->force_halted || !aop->force_drained || !s->ch3.window_done ||
+	    !n->acked || n->reset_done ||
+	    (aop_rd(aop, AOP_CPU_CONTROL) & AOP_CPU_START) || readl(aop->control)) {
+		n->failed = "failed-intc-reset-state";
+		return -EPERM;
+	}
+	ret = a9_aop_spi0_trace(aop, "pre-intc-reset");
+	if (ret)
+		return ret;
+	aop->experiment_step = "intc-reset";
+	dev_info(aop->dev, "AOP INTC reset begin pa=%llx sequence=1/read/0/read cpu=halted\n",
+		 A9_SPI0_WRAPPER_PA + A9_INTC_RESET);
+	ret = aop_wr(aop, A9_INTC_RESET, 1);
+	n->reset_asserted = aop_rd(aop, A9_INTC_RESET);
+	if (ret) {
+		n->failed = "failed-intc-reset-assert";
+		return ret;
+	}
+	ret = aop_wr(aop, A9_INTC_RESET, 0);
+	n->reset_after = aop_rd(aop, A9_INTC_RESET);
+	if (ret) {
+		n->failed = "failed-intc-reset-deassert";
+		return ret;
+	}
+	if (n->reset_after) {
+		n->failed = "failed-intc-reset-readback";
+		ret = -EIO;
+	} else {
+		ret = a9_aop_spi0_trace(aop, "post-intc-reset");
+		if (!ret && a9_spi0_ch3_verify(s->trace.ch3,
+					       s->teardown_stable & BIT(3))) {
+			n->failed = "failed-intc-reset-ch3";
+			ret = -EIO;
+			} else if (!ret && a9_aop_spi0_selected_verify(s)) {
+				n->failed = "failed-intc-reset-channel";
+				ret = -EIO;
+		}
+	}
+	n->reset_done = !ret;
+	dev_info(aop->dev, "AOP INTC reset errno=%d asserted=%08x after=%08x result=%s\n",
+		 ret, n->reset_asserted, n->reset_after, n->failed ?: "pass");
+	return ret;
+}
+
diff --git a/drivers/soc/apple/aop-warm-spi0.h b/drivers/soc/apple/aop-warm-spi0.h
new file mode 100644
index 000000000..2470165ce
--- /dev/null
+++ b/drivers/soc/apple/aop-warm-spi0.h
@@ -0,0 +1,543 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * J71t AOP reload/wake experiments, both opt-in and default off. Constants
+ * and evidence types only; the MMIO lives in apple-a9-aop-active.c.
+ * Evidence: docs/periph/ds-aop-reload-crash-and-wake.md.
+ *
+ * aop_spi0_reset=1: every halt + SRAM reload of a live AOP crashed in
+ * AOPSPIMaster_channelFaultIRQ (0102f252, DFAR 0x4c): the AOP-private SPI0
+ * controller kept channel 3's +0x8d0 bit 6 while the fresh firmware's
+ * channel table was still empty. With the CPU halted, the AP replays the
+ * firmware's own controller reset AOPSPIMaster_reset (0102f2f4), then the
+ * firmware's own channel-3 teardown, and samples bit 6 for >= 150 ms after
+ * the image copy before it releases RUN once. Round 4: the old session's
+ * SPI0 global IRQ 0x10014 stays latched in the AOP interrupt controller
+ * (SCMErr:0x3,3 at the accel STARTEP), so the AP disables that source before
+ * the reset and acknowledges it after the clean window, just before RUN.
+ * Wake7: the channel-3 idle wait gets the firmware's own 10 ms bound twice
+ * over, sampled per 1 ms slice, and the disable is judged by the INTC mask
+ * readback, which the firmware itself reads.
+ * Wake8: after the targeted ack, replay INTC event 3 (+0x808: 1/read/0/read).
+ * This resets retained interrupt delivery, not the read-only SCM state.
+ * Wake9: wake8 device evidence showed the channel-3 stop itself changes SCM
+ * from 0 to 3. Replay the same SPI controller reset once more after teardown;
+ * require the post-reset SCM state to be zero and the teardown state to hold.
+ * Wake10: the second reset clears SCM, but a halted CPU then saw SCM 3 and
+ * +0x8d0 bit 14 (channel 7) during the firmware copy. Snapshot all 16 channel
+ * slots, sample global SCM/fault state across the copy, and gate the copy and
+ * final RUN on a completely quiet readback.
+ * Wake11: that snapshot proved channels 3 and 7 were both running. Keep the
+ * channel-3 sequence unchanged, then apply the same firmware teardown to every
+ * other run-bit + nonzero-interval channel before the post-teardown reset.
+ * Wake12: channel 7 is the phosphorus/BMP284 async client. Its firmware has no
+ * owner-specific stop path, so do not invent another store when the generic
+ * stop times out. Record the remaining scheduler state read-only and refuse.
+ * Wake13/14: every device stop of channel 3 that idled (wake8..wake12) came
+ * 1.5-2.2 ms after the controller reset; the two that did not (wake13/14) came
+ * 11/33 ms after it (pr_flush in the checkpoint), with class-0 state identical to
+ * wake12's passes. Wake15 closed that window (no pr_flush between the reset and
+ * the stops, console lock held), recorded the reset-to-stop latency and the peers
+ * per stop, and accepted one identity-pinned stopped-without-idle channel (3 or
+ * 7) as wake13 did for channel 7. Wake15's channel-7-first order then showed
+ * channel 7 never idles even at 0.3 ms (it is 0/3 over wake11/12/15), with
+ * nothing ticking. Wake16 therefore returns to channel 3 first (early, the only
+ * stop that ever idled) and then channel 7, which takes the stable-stop path
+ * (SCM 0/0 or 3/0, constant); every stop logs why the fingerprint did or did not
+ * hold (stable_why=). Wake14's class-0 prelude stays removed.
+ *
+ * aop_wake_wrapper=1: before 0x220, the AppleA7IOP status-3 resume wrapper
+ * writes (b4b854..b4b8b4). No CPU RUN, no auto-boot, no NMI.
+ */
+#ifndef _A9_AOP_RELOAD_H
+#define _A9_AOP_RELOAD_H
+
+#include <linux/string.h>
+#include <linux/types.h>
+#include "aop-warm-record.h"
+
+/* Firmware device spi0: IOP 0x10100000 (space 2, 0x1000) via /arm-io ranges. */
+#define A9_SPI0_PA		0x210100000ULL
+#define A9_SPI0_SIZE		0x1000U
+#define A9_SPI0_WRAPPER_PA	0x210800000ULL	/* the only layout this applies to */
+#define A9_SPI0_CONTROL		0x000U
+#define A9_SPI0_CLOCK		0x008U	/* 0102f2aa programs 0x01b71b00 here */
+#define A9_SPI0_FAULT		0x8d0U	/* bit 2n = channel n, read by 0102f20a */
+#define A9_SPI0_FAULT_8D4	0x8d4U
+#define A9_SPI0_CHANNEL_BASE	0x100U
+#define A9_SPI0_CHANNEL_STRIDE	0x080U
+#define A9_SPI0_CHANNELS	16U
+#define A9_SPI0_CHANNEL_REGS	7U
+#define A9_SPI0_CHANNEL_DESC	0x018U
+#define A9_SPI0_CH3		0x280U	/* base + 0x100 + 0x80 * 3 */
+#define A9_SPI0_CH3_0C		0x28cU
+#define A9_SPI0_RESET		0x100U	/* control bit 8 */
+#define A9_SPI0_ENABLE		0x001U	/* control bit 0 */
+#define A9_SPI0_CH3_PENDING	0x040U
+/* The firmware spins without bound; the AP gives each poll 1 ms. */
+#define A9_SPI0_POLL_US		1000U
+#define A9_SPI0_DELAY_US	100U	/* 0102b3f8(100, 0), twice */
+#define A9_SPI0_REGS		6
+
+static const u32 a9_spi0_offsets[A9_SPI0_REGS] = {
+	A9_SPI0_CONTROL, A9_SPI0_CLOCK, A9_SPI0_FAULT, A9_SPI0_FAULT_8D4,
+	A9_SPI0_CH3, A9_SPI0_CH3_0C,
+};
+
+/* Snapshot indices into a9_spi0_offsets. */
+enum { A9_SPI0_I_CONTROL, A9_SPI0_I_CLOCK, A9_SPI0_I_FAULT };
+
+/*
+ * Channel-3 teardown after the reset (ds-aop-spi0-ch3-round3.md section 5).
+ * The reset leaves C3 = 0x00010447: idle but still enabled, async-armed and
+ * with the class-0 fault IRQ on, so a level source re-latched +0x8d0 bit 6
+ * within ~105 ms with the CPU halted. AOPSPIMaster_teardownChannel
+ * (0102e4f8) stops the channel and masks both IRQ classes; the fault
+ * handler (0102f20a) then acknowledges with C3C bit 5.
+ */
+#define A9_SPI0_CH3_ROUTE	0x284U
+#define A9_SPI0_CH3_RATE	0x288U
+#define A9_SPI0_CH3_DESC	0x298U	/* channel +0x18, zeroed on teardown */
+#define A9_SPI0_CH3_RUN		0x001U	/* C3 bit 0, channel run/enable */
+#define A9_SPI0_CH3_IDLE	0x002U	/* C3 bit 1, polled after the stop */
+#define A9_SPI0_CH3_IRQ0	0x040U	/* C3 bit 6, +0x8d0 class-0/fault enable */
+#define A9_SPI0_CH3_IRQ1	0x100U	/* C3 bit 8, +0x8d4 class-1 enable */
+#define A9_SPI0_CHANNEL_PROGRESS_SHIFT 24U /* hardware-updated, not an IRQ class */
+#define A9_SPI0_CH3_STOP	0x411U	/* clear run bit 0 and bits 4, 10 */
+#define A9_SPI0_CH3_CLASS0	0x450U	/* mask class 0: bits 4, 6, 10 */
+#define A9_SPI0_CH3_CLASS1	0x510U	/* mask class 1: bits 4, 8, 10 */
+#define A9_SPI0_CH3_ACK		0x020U	/* C3C bit 5, ORed by 0102f20a; self-clearing */
+#define A9_SPI0_PHOSPHORUS_CHANNEL	7U
+#define A9_SPI0_PHOSPHORUS_CTL_MASK	0x00ffffffU
+#define A9_SPI0_PHOSPHORUS_CTL_RUN	0x00010445U
+#define A9_SPI0_PHOSPHORUS_CTL_STOPPED	0x00010444U
+#define A9_SPI0_PHOSPHORUS_ROUTE		0x00000040U
+#define A9_SPI0_PHOSPHORUS_RATE		0x019000c8U
+#define A9_SPI0_PHOSPHORUS_CFG		0x00200009U
+/* Channel 3 is the MPU6900 async FIFO client (route 0x10, same rate/config). */
+#define A9_SPI0_MPU_ASYNC_CHANNEL	3U
+#define A9_SPI0_MPU_ASYNC_ROUTE		0x00000010U
+/* Stopped control word, any top byte, class-0 enable optional (0x40). */
+#define A9_SPI0_STABLE_CTL_STOPPED	0x00010404U
+#define A9_SPI0_STABLE_CTL_MASK		0x00ffffbfU
+/* Peer sampling and the "late stop" mark are reported, never gated, in-kernel. */
+#define A9_SPI0_LATE_STOP_US		3000U
+/*
+ * AOPSPIMaster_setChannelEnabled(false) (0102ef7c) stores C3 & ~0x411 only
+ * if bit 0 was set, then spins on bit 1 until master +0x30, and panics
+ * "SCMto:%u" (0x010398da) past it. Event 1 sets +0x30 to 0x2710 us when it
+ * is 0 (0102e6fa, as in the live-cold object), through timer +0x18 =
+ * us * Hz / 1000000 (0102ff3c): a 10 ms bound. The AP polls in 1 ms slices,
+ * up to twice that, sampling C3, the SCM state and +0x8d0 after each slice.
+ */
+#define A9_SPI0_CH3_IDLE_FW_US	10000U
+#define A9_SPI0_CH3_SLICE_US	1000U
+#define A9_SPI0_CH3_SLICES	20U	/* 20 ms */
+/* At least 150 ms (the 16:27 re-latch took ~105 ms) of samples before RUN. */
+#define A9_SPI0_WINDOW_SAMPLES	31U
+#define A9_SPI0_WINDOW_US	5000U	/* 30 sleeps >= 5 ms each */
+#define A9_SPI0_WINDOW_MS	150U	/* required first-to-last sample span */
+#define A9_SPI0_CH3_REGS	7
+
+static const u32 a9_spi0_ch3_offsets[A9_SPI0_CH3_REGS] = {
+	A9_SPI0_CH3, A9_SPI0_CH3_ROUTE, A9_SPI0_CH3_RATE, A9_SPI0_CH3_0C,
+	A9_SPI0_CH3_DESC, A9_SPI0_FAULT, A9_SPI0_FAULT_8D4,
+};
+
+/* Every firmware-visible channel slot, read only in wake10 and selected in wake11. */
+static const u32 a9_spi0_channel_offsets[A9_SPI0_CHANNEL_REGS] = {
+	0x00U, 0x04U, 0x08U, 0x0cU, 0x10U, 0x14U, 0x18U,
+};
+
+enum {
+	A9_CHANNEL_I_CTL, A9_CHANNEL_I_ROUTE, A9_CHANNEL_I_RATE, A9_CHANNEL_I_CFG,
+	A9_CHANNEL_I_INTERVAL, A9_CHANNEL_I_CURSOR, A9_CHANNEL_I_DESC,
+};
+
+/* Snapshot indices into a9_spi0_ch3_offsets. */
+enum {
+	A9_CH3_I_C3, A9_CH3_I_ROUTE, A9_CH3_I_RATE, A9_CH3_I_C3C, A9_CH3_I_DESC,
+	A9_CH3_I_8D0, A9_CH3_I_8D4,
+};
+
+/* One idle-poll slice: C3 as the slice ended, then SCM state and +0x8d0. */
+struct a9_aop_ch3_slice {
+	u64 ns;				/* since the stop store */
+	u32 c3, scm_lo, scm_hi, fault;
+};
+
+/* Wake12 read-only scheduler evidence for an additional-channel stop poll. */
+struct a9_aop_channel_diag_slice {
+	u32 cfg, interval, cursor, fault_8d4;
+};
+
+struct a9_aop_spi0_ch3 {
+	u32 before[A9_SPI0_CH3_REGS], after[A9_SPI0_CH3_REGS];
+	u32 stop, idle, class0, class1, ack;	/* words written / polled */
+	int poll;			/* idle-bit poll result */
+	bool run_before;		/* C3 bit 0 before the stop */
+	unsigned int slices;		/* idle-poll slices used */
+	struct a9_aop_ch3_slice slice[A9_SPI0_CH3_SLICES];
+	u64 idle_us;			/* stop store to the idle read */
+	int error;
+	bool ran;			/* the guarded teardown executed */
+	const char *failed;		/* distinct refusal reason, or NULL */
+	/* Wake15: stop latency after the controller reset and the peers' state. */
+	u64 stop_ns, reset_to_stop_us;
+	u32 peers_run, peers_ticking;	/* masks of the other 15 channels */
+	bool stable;			/* accepted stopped-without-idle identity */
+	const char *stable_why;		/* first failed fingerprint condition, NULL if stable */
+	/* Pre-RUN window after the image copy; a refusal also sets failed. */
+	unsigned int samples;
+	u64 elapsed_ms;
+	bool window_done, reasserted;
+	unsigned int reassert_sample;
+	u64 reassert_ms;
+	u32 reassert[A9_SPI0_CH3_REGS];
+};
+
+struct a9_aop_spi0;
+
+struct a9_aop_spi0_channel_op {
+	struct a9_aop_spi0 *spi0;
+	struct a9_aop_spi0_ch3 *state;
+	unsigned int channel;
+};
+
+/*
+ * AOP interrupt controller, wrapper offsets (ds-aop-spi0-ch3-round4.md
+ * section 3). IRQ 0x10014 is group 1, source 0x14: bank 0, bit 20. The
+ * group-1 disable/enable banks are write-one commands whose reads return
+ * the mask, 1 = disabled: the sleep command saves +0xa00..+0xa08 (0102c5ce)
+ * before masking all (0102c5da), the restore writes saved to +0xa00 and
+ * ~saved to +0xa80 (0102c9e6/0102c9f4), and aop_interrupt_write_enabled
+ * reads the target bank for the previous state (0102c9c0). So the disable
+ * is judged by bit 20 of the +0xa00 readback (wake6: ffffffff before the
+ * store, every source already masked by the quiesce). +0x81c only reports
+ * an unmasked pending source: the sleep path masks all, writes group 7
+ * +0xc020/+0xc024 = 2 and spins until +0x81c reads 0 (0102c654), so
+ * all-ones there means the AP is not reading the INTC. +0x808 ends 0 after
+ * the event-3 pulse. +0x900 is the group-1 raise (0102c7c6) and +0x980 its
+ * pre-handler clear (0102c6f2); the firmware never reads them, so their
+ * readbacks are logged only. No register shows a masked source pending.
+ */
+#define A9_INTC_RESET		0x808U	/* event-3 pulse 1 then 0 (0102c592) */
+#define A9_INTC_CURRENT		0x81cU	/* current unmasked source */
+#define A9_INTC_RAISE		0x900U	/* group 1 raise, 0102c7c6 */
+#define A9_INTC_ACK		0x980U	/* group 1 pre-handler ack/clear, 0102c6f2 */
+#define A9_INTC_DISABLE		0xa00U	/* group 1 disable, store at 0102c9ce */
+#define A9_INTC_ENABLE		0xa80U	/* group 1 enable; reads the same mask */
+#define A9_INTC_G7_DISABLE	0xc020U	/* group 7 disable, 2 after sleep */
+#define A9_INTC_SPI0_SCM	0x00100000U	/* IRQ 0x10014 */
+#define A9_INTC_ALL_ONES	0xffffffffU
+#define A9_INTC_REGS		10
+
+static const u32 a9_intc_offsets[A9_INTC_REGS] = {
+	A9_INTC_RESET, A9_INTC_CURRENT, A9_INTC_RAISE, A9_INTC_ACK,
+	A9_INTC_DISABLE, A9_INTC_DISABLE + 4, A9_INTC_DISABLE + 8,
+	A9_INTC_ENABLE, A9_INTC_G7_DISABLE, A9_INTC_G7_DISABLE + 4,
+};
+
+/* Snapshot indices into a9_intc_offsets. */
+enum {
+	A9_INTC_I_RESET, A9_INTC_I_CURRENT, A9_INTC_I_RAISE, A9_INTC_I_ACK,
+	A9_INTC_I_MASK0, A9_INTC_I_MASK1, A9_INTC_I_MASK2, A9_INTC_I_ENABLE0,
+	A9_INTC_I_G7_0, A9_INTC_I_G7_1,
+};
+
+/* When the AP snapshots the INTC words. */
+enum {
+	A9_INTC_AT_PRE_DISABLE, A9_INTC_AT_POST_DISABLE, A9_INTC_AT_PRE_ACK,
+	A9_INTC_AT_POST_ACK, A9_INTC_AT_N,
+};
+
+static inline const char *a9_intc_at_name(unsigned int at)
+{
+	static const char * const names[] = {
+		"pre-disable", "post-disable", "pre-ack", "post-ack",
+	};
+
+	return at < A9_INTC_AT_N ? names[at] : "unknown";
+}
+
+/* "all-ones" if +0x81c reads ffffffff, which a live INTC cannot report. */
+static inline const char *a9_intc_view(const u32 *state)
+{
+	return state[A9_INTC_I_CURRENT] == A9_INTC_ALL_ONES ? "all-ones" : "intc";
+}
+/*
+ * Read only, never written: the SCM state (also per idle-poll slice) and,
+ * around the acknowledge, the C3 interval pair.
+ */
+#define A9_SPI0_SCM_LO		0x00cU
+#define A9_SPI0_SCM_HI		0x010U
+#define A9_SPI0_CH3_IVAL	0x290U
+#define A9_SPI0_CH3_CURSOR	0x294U
+#define A9_SPI0_SCM_REGS	4
+
+static const u32 a9_spi0_scm_offsets[A9_SPI0_SCM_REGS] = {
+	A9_SPI0_SCM_LO, A9_SPI0_SCM_HI, A9_SPI0_CH3_IVAL, A9_SPI0_CH3_CURSOR,
+};
+
+struct a9_aop_intc {
+	u32 state[A9_INTC_AT_N][A9_INTC_REGS];	/* around each store */
+	unsigned int states;			/* bit n: state[n] was read */
+	u32 scm[2][A9_SPI0_SCM_REGS];		/* before / after the ack */
+	unsigned int scm_at;			/* scm[] row the guarded read fills */
+	bool disabled, acked;
+	bool reset_done;
+	u32 reset_asserted, reset_after;
+	const char *failed;			/* distinct refusal reason, or NULL */
+};
+
+/* Read-only milestones. Wake10 gates the global SCM/fault words, not channels. */
+struct a9_aop_spi0_trace {
+	u32 control, clock, scm[A9_SPI0_SCM_REGS], ch3[A9_SPI0_CH3_REGS];
+	u32 channel[A9_SPI0_CHANNELS][A9_SPI0_CHANNEL_REGS];
+};
+
+/* Wake9's second, post-channel-stop replay of AOPSPIMaster_reset. */
+struct a9_aop_spi0_post_reset {
+	u32 before[A9_SPI0_REGS], after[A9_SPI0_REGS];
+	u32 saved, asserted, polled;
+	int error;
+	bool ran;
+	const char *failed;
+};
+
+/*
+ * First failed readback after the teardown, or NULL if all hold. C3C bit 5
+ * is a pulse: at 19:50 the write of 0x00200029 read back 0x00200009 while
+ * +0x8d0 bit 6 went 1 -> 0, so the acknowledge is judged by bit 6 alone and
+ * the C3C readback is only logged.
+ */
+static inline const char *a9_spi0_ch3_verify(const u32 *after, bool stable)
+{
+	if (after[A9_CH3_I_C3] & A9_SPI0_CH3_RUN)
+		return "failed-ch3-teardown-run";
+	if (after[A9_CH3_I_C3] & A9_SPI0_CH3_IRQ0)
+		return "failed-ch3-teardown-class0";
+	if (after[A9_CH3_I_C3] & A9_SPI0_CH3_IRQ1)
+		return "failed-ch3-teardown-class1";
+	if (!(after[A9_CH3_I_C3] & A9_SPI0_CH3_IDLE) && !stable)
+		return "failed-ch3-teardown-idle";
+	if (after[A9_CH3_I_DESC])
+		return "failed-ch3-teardown-desc";
+	if (after[A9_CH3_I_8D0] & A9_SPI0_CH3_PENDING)
+		return "failed-ch3-teardown-pending";
+	return NULL;
+}
+
+/*
+ * Has firmware run since the last SoC reset? auto-boot alone cannot say:
+ * the outgoing aop_quiesce=1 halt clears it, exactly like a DFU cold start.
+ * The previous kernel's reserved-RAM shutdown transcript says whether its
+ * firmware ran. That DRAM can outlive a DFU; wrapper +0x4020 outbox enable
+ * cannot: set after reset (12/12 DFU cold snapshots), cleared by the first
+ * store of every Linux stop. No SPI0 access is needed to decide.
+ */
+enum a9_spi0_prev_state {
+	A9_SPI0_PREV_MISSING,	/* no transcript magic, or none reserved */
+	A9_SPI0_PREV_INVALID,	/* magic present, header/checksum rejected */
+	A9_SPI0_PREV_VALID,
+};
+
+struct a9_spi0_prev {
+	enum a9_spi0_prev_state state;
+	bool hello;	/* "SHUTDOWN begin ... hello=1": its firmware ran */
+	bool halted;	/* "QUIESCE step=complete ... halted=1" + steps bit */
+	bool carried;	/* "SPI0-CARRY retained=1": ran earlier in the chain */
+	u32 steps;	/* "QUIESCE step=complete ... steps=0x..." */
+};
+
+enum a9_spi0_reason {
+	/* Run the reset. */
+	A9_SPI0_LIVE_AUTO_BOOT,	/* auto-boot 1 before the stop */
+	A9_SPI0_PREV_HALTED,	/* previous kernel quiesced and halted it */
+	A9_SPI0_PREV_LIVE,	/* previous kernel's firmware ran, no halt */
+	A9_SPI0_PREV_CARRIED,	/* an earlier kernel in the chain ran it */
+	/* Skip: the block is not touched. */
+	A9_SPI0_FRESH,		/* no transcript, auto-boot 0: DFU cold */
+	A9_SPI0_PREV_BAD,	/* transcript present but corrupt */
+	A9_SPI0_PREV_NO_RUN,	/* transcript: nothing ran in the chain */
+	A9_SPI0_STALE,		/* run evidence, wrapper at reset state */
+};
+
+static inline const char *a9_spi0_reason_name(enum a9_spi0_reason reason)
+{
+	static const char * const names[] = {
+		"live-auto-boot", "prev-quiesce-halted", "prev-live", "prev-carried",
+		"fresh-instance", "prev-transcript-invalid", "prev-no-run",
+		"stale-transcript",
+	};
+
+	return reason <= A9_SPI0_STALE ? names[reason] : "unknown";
+}
+
+static inline const char *a9_spi0_prev_name(enum a9_spi0_prev_state state)
+{
+	return state == A9_SPI0_PREV_VALID ? "valid" :
+	       state == A9_SPI0_PREV_INVALID ? "invalid" : "missing";
+}
+
+static inline bool a9_spi0_reason_runs(enum a9_spi0_reason reason)
+{
+	return reason <= A9_SPI0_PREV_CARRIED;
+}
+
+/*
+ * Release policy: a reason that would run the reload is allowed by default
+ * only for prev-quiesce-halted, the one state device-proven end to end. A
+ * skip (fresh, bad record, nothing ran) is allowed only while the wrapper is
+ * still at its reset state; stale records skip as before. Untested lifts both.
+ */
+static inline bool a9_spi0_policy_allows(enum a9_spi0_reason reason, bool outbox_enabled,
+					 bool untested)
+{
+	if (untested || reason == A9_SPI0_PREV_HALTED || reason == A9_SPI0_STALE)
+		return true;
+	if (a9_spi0_reason_runs(reason))
+		return false;
+	/*
+	 * A skip means "nothing ran since the SoC reset", which only holds if the
+	 * wrapper is still at its reset state (+0x4020 outbox enable set, 12/12 DFU
+	 * cold starts). Without it some earlier kernel stopped the firmware and its
+	 * record is lost: a cold load would land on a halted, never-torn-down AOP.
+	 */
+	return outbox_enabled;
+}
+
+/* Token search inside one transcript line, which holds no NUL. */
+static inline bool a9_spi0_line_has(const char *line, size_t length,
+				    const char *token, size_t n,
+				    const char **at)
+{
+	size_t i;
+
+	for (i = 0; n <= length && i <= length - n; i++) {
+		if (!memcmp(line + i, token, n)) {
+			*at = line + i + n;
+			return true;
+		}
+	}
+	return false;
+}
+
+#define a9_spi0_has(line, length, token, at) \
+	a9_spi0_line_has(line, length, token, sizeof(token) - 1, at)
+
+static inline bool a9_spi0_line_starts(const char *line, size_t length,
+				       const char *prefix, size_t n)
+{
+	return length >= n && !memcmp(line, prefix, n);
+}
+
+#define a9_spi0_starts(line, length, prefix) \
+	a9_spi0_line_starts(line, length, prefix, sizeof(prefix) - 1)
+
+static inline u32 a9_spi0_hex(const char *p, const char *end)
+{
+	u32 value = 0;
+
+	for (; p < end; p++) {
+		if (*p >= '0' && *p <= '9')
+			value = value << 4 | (u32)(*p - '0');
+		else if (*p >= 'a' && *p <= 'f')
+			value = value << 4 | (u32)(*p - 'a' + 10);
+		else
+			break;
+	}
+	return value;
+}
+
+/* Our own checksummed transcript; only whole-line prefixes count. */
+static inline void a9_spi0_prev_parse(struct a9_spi0_prev *p,
+				      const char *text, size_t length)
+{
+	const char *end = text + length, *line, *next, *at;
+	size_t n;
+
+	for (line = text; line < end; line = next < end ? next + 1 : end) {
+		next = memchr(line, '\n', end - line);
+		if (!next)
+			next = end;
+		n = next - line;
+		if (a9_spi0_starts(line, n, "SHUTDOWN begin ") &&
+		    a9_spi0_has(line, n, " hello=1 ", &at))
+			p->hello = true;
+		if (a9_spi0_starts(line, n, "QUIESCE step=complete ")) {
+			if (a9_spi0_has(line, n, " steps=0x", &at))
+				p->steps = a9_spi0_hex(at, next);
+			p->halted = a9_spi0_has(line, n, " halted=1 ", &at) &&
+				    (p->steps & (1U << A9_HO_STEP_HALTED));
+		}
+		if (a9_spi0_starts(line, n, "SPI0-CARRY retained=1 "))
+			p->carried = true;
+	}
+}
+
+/*
+ * Skips unless there is positive evidence: running the reset on a fresh
+ * block would be the first AP access to SPI0 with nothing retained to
+ * clear (and ps_spi0 may gate it), while a skip on retained state only
+ * repeats the known, non-hanging accel STARTEP crash.
+ */
+static inline enum a9_spi0_reason a9_spi0_decide(bool auto_boot, bool outbox_enabled,
+						 const struct a9_spi0_prev *p)
+{
+	if (auto_boot)
+		return A9_SPI0_LIVE_AUTO_BOOT;
+	if (p->state == A9_SPI0_PREV_MISSING)
+		return A9_SPI0_FRESH;
+	if (p->state != A9_SPI0_PREV_VALID)
+		return A9_SPI0_PREV_BAD;
+	if (!p->hello && !p->carried)
+		return A9_SPI0_PREV_NO_RUN;
+	if (outbox_enabled)
+		return A9_SPI0_STALE;
+	if (p->hello)
+		return p->halted ? A9_SPI0_PREV_HALTED : A9_SPI0_PREV_LIVE;
+	return A9_SPI0_PREV_CARRIED;
+}
+
+struct a9_aop_spi0 {
+	void __iomem *base;		/* mapped only with aop_spi0_reset=1 */
+	u32 before[A9_SPI0_REGS], after[A9_SPI0_REGS];
+	u32 saved;			/* control word before the reset */
+	u32 asserted;			/* saved & ~0x101 | 0x100 */
+	u32 polled;			/* control word when the polls ended */
+	u32 prerun;			/* +0x8d0 just before RUN */
+	u32 prerun_8d4, prerun_scm_lo, prerun_scm_hi;
+	u32 pmgr_before, pmgr_after;	/* AP PMGR ps_spi0 raw, read-only */
+	int pmgr_before_errno, pmgr_after_errno;
+	int error;
+	bool ran, reasserted, copy_faulted;
+	const char *gate_failed;
+	const char *skipped;
+	struct a9_spi0_prev prev;	/* parsed at probe from the transcript */
+	u32 auto_boot, outbox;		/* boot snapshot, before the stop */
+	enum a9_spi0_reason reason;
+	bool decided;
+	struct a9_aop_spi0_ch3 ch3;	/* after a clean reset only */
+	/* Wake11 reuses one bounded scratch record for each additional channel. */
+	struct a9_aop_spi0_ch3 channel;
+	u32 teardown_selected, teardown_done;
+	unsigned int teardown_failed_channel;
+	struct a9_aop_spi0_post_reset post_reset; /* after the stop latches SCM */
+	struct a9_aop_intc intc;	/* IRQ 0x10014 around the reset */
+	struct a9_aop_spi0_trace trace;	/* latest read-only milestone */
+	/* Appended so every pre-wake12 field, including ch3, keeps its layout. */
+	struct a9_aop_channel_diag_slice channel_diag[A9_SPI0_CH3_SLICES];
+	/* Wake13: exact phosphorus stopped-without-idle exception, by channel. */
+	u32 teardown_stable;
+	/* Wake15: channel 3 shares the sampled diagnostics; reset completion time. */
+	struct a9_aop_channel_diag_slice ch3_diag[A9_SPI0_CH3_SLICES];
+	u64 reset_done_ns;
+};
+
+/* 0102f2f4: bits 8 and 0 clear; the reset write adds bit 8. */
+static inline u32 a9_spi0_base_word(u32 saved)
+{
+	return saved & ~(A9_SPI0_RESET | A9_SPI0_ENABLE);
+}
+
+#endif
