+static void apple_aop_warm_hash(struct apple_aop *aop, u8 *digest)
+{
+	struct sha256_ctx ctx;
+	unsigned int i;
+
+	sha256_init(&ctx);
+	dma_rmb();
+	if (aop->ext)
+		sha256_update(&ctx, aop->ext, aop->ext_size);
+	for (i = 0; i < AFK_ENDPOINT_COUNT; i++)
+		if (aop->eps[i].buf)
+			sha256_update(&ctx, aop->eps[i].buf, aop->eps[i].buf_size);
+	sha256_final(&ctx, digest);
+}
