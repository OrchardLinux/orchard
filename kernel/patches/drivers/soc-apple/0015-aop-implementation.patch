+/* Unlike shutdown(), retain all grants until the caller halts the CPU.
+ * Reinit frees DMA buffers and is unsafe before that point on S8000.
+ */
+static void apple_rtkit_grants_hash(struct apple_rtkit *rtk, u8 *digest)
+{
+	struct apple_rtkit_shmem *buffers[] = {
+		&rtk->ioreport_buffer, &rtk->crashlog_buffer,
+		&rtk->oslog_buffer, &rtk->syslog_buffer,
+	};
+	struct sha256_ctx ctx;
+	unsigned int i;
+
+	sha256_init(&ctx);
+	dma_rmb();
+	for (i = 0; i < ARRAY_SIZE(buffers); i++)
+		if (buffers[i]->buffer)
+			sha256_update(&ctx, buffers[i]->buffer, buffers[i]->size);
+	sha256_final(&ctx, digest);
+}
+
+int apple_rtkit_shutdown_preserve(struct apple_rtkit *rtk)
+{
+	u8 before[SHA256_DIGEST_SIZE], after[SHA256_DIGEST_SIZE];
+	int ret;
+
+	if (rtk->crashed)
+		return -EIO;
+	ret = apple_rtkit_set_ap_power_state(rtk, APPLE_RTKIT_PWR_STATE_QUIESCED);
+	if (ret)
+		return ret;
+	dev_info(rtk->dev, "QUIESCE step=ap-ack state=0x10\n");
+	ret = apple_rtkit_set_iop_power_state(rtk, APPLE_RTKIT_PWR_STATE_IDLE);
+	if (ret)
+		return ret;
+	dev_info(rtk->dev, "QUIESCE step=iop-ack state=0x201\n");
+	msleep(20);
+	apple_rtkit_grants_hash(rtk, before);
+	msleep(20);
+	apple_rtkit_grants_hash(rtk, after);
+	if (rtk->crashed || memcmp(before, after, sizeof(before)))
+		return -EBUSY;
+	/* No more callback can race the caller's halt/drain. Do not reinit. */
+	apple_mbox_stop(rtk->mbox);
+	flush_workqueue(rtk->wq);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_shutdown_preserve);
+
 int apple_rtkit_shutdown(struct apple_rtkit *rtk)
 {
 	int ret;
