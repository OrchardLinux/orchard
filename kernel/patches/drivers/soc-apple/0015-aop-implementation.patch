+struct aop_warm_write { void __iomem *target; u32 value; };
+static void aop_warm_store(void *data)
+{
+	struct aop_warm_write *w = data;
+
+	writel(w->value, w->target);
+	readl(w->target);
+}
+
+static int aop_wr(struct apple_aop *aop, u32 offset, u32 value)
+{
+	struct apple_pmgr_observation states[AOP_DOMAINS];
+	struct aop_warm_write w = { aop->warm_wrapper + offset, value };
+
+	if ((aop_rd(aop, AOP_INBOX_CONTROL) | aop_rd(aop, AOP_OUTBOX_CONTROL)) &
+	    AOP_MBOX_FAULTS)
+		return -EIO;
+	dev_info(aop->dev, "COLD-W step=%s bank=wrapper offset=%04x before=%08x value=%08x\n",
+		 aop->experiment_step ?: "warm-stop", offset, readl(w.target), value);
+	{
+		int ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states, aop_warm_store, &w);
+
+		dev_info(aop->dev, "COLD-R offset=%04x after=%08x\n", offset, readl(w.target));
+		return ret;
+	}
+}
