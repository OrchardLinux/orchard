+static int apple_aop_warm_prepare(struct apple_aop *aop)
+{
+	struct device *dev = aop->dev;
+	struct device_node *np = dev->of_node, *mem;
+	struct apple_pmgr_observation states[AOP_DOMAINS];
+	struct a9_sl_header header;
+	struct resource res;
+	char *text;
+	u32 auto_boot, outbox;
+	unsigned int i;
+	int ret;
+
+	if (!of_machine_is_compatible("apple,j71t") || !aop->hw->sram_window)
+		return 0;
+	/* Missing the new DT is not permission to run a retained instance. */
+	mem = of_parse_phandle(np, "memory-region", 0);
+	if (!mem)
+		return dev_err_probe(dev, -EINVAL, "warm reload requires the matching J71t DT\n");
+	ret = of_address_to_resource(mem, 0, &res);
+	of_node_put(mem);
+	if (ret || resource_size(&res) != A9_HO_PAGE || res.start != 0x8583fc000ULL ||
+	    aop->akf_base != A9_SPI0_WRAPPER_PA)
+		return -EINVAL;
+	aop->shutdown_log = memremap(res.start, A9_HO_PAGE, MEMREMAP_WB);
+	if (!aop->shutdown_log)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, apple_aop_warm_unmap, aop->shutdown_log);
+	if (ret)
+		return ret;
+	/* Keep release6's transcript location and validation ABI. */
+	aop->shutdown_log = (void *)aop->shutdown_log + A9_HO_LOG_OFFSET;
+	aop->shutdown_text = (char *)(aop->shutdown_log + 1);
+	memcpy(&header, aop->shutdown_log, sizeof(header));
+	text = devm_kmemdup(dev, aop->shutdown_text, A9_SL_CAPACITY, GFP_KERNEL);
+	if (!text)
+		return -ENOMEM;
+	if (header.magic == A9_SL_MAGIC) {
+		aop->spi0.prev.state = A9_SPI0_PREV_INVALID;
+		if (a9_sl_valid(&header, text)) {
+			aop->spi0.prev.state = A9_SPI0_PREV_VALID;
+			a9_spi0_prev_parse(&aop->spi0.prev, text, header.length);
+			for (i = 0; i < header.length;) {
+				char *next = memchr(text + i, '\n', header.length - i);
+				unsigned int n = next ? next - text - i : header.length - i;
+
+				dev_info(dev, "AOP-PREV %.*s\n", n, text + i);
+				i += n + 1;
+			}
+		}
+	}
+	aop->warm_wrapper = devm_ioremap(dev, aop->akf_base, 0x1c000);
+	if (!aop->warm_wrapper)
+		return -ENOMEM;
+	for (i = 0; i < AOP_DOMAINS; i++) {
+		aop->domains[i] = of_parse_phandle(np, "apple,observe-domains", i);
+		if (!aop->domains[i])
+			return -EINVAL;
+		ret = devm_add_action_or_reset(dev, apple_aop_warm_put_node, aop->domains[i]);
+		if (ret)
+			return ret;
+	}
+	aop->spi0_pmgr = of_parse_phandle(np, "apple,spi0-domain", 0);
+	if (!aop->spi0_pmgr)
+		return -EINVAL;
+	ret = devm_add_action_or_reset(dev, apple_aop_warm_put_node, aop->spi0_pmgr);
+	if (ret)
+		return ret;
+	/* Check all domains before reading the wrapper; no power transitions. */
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states, a9_aop_spi0_pmgr_on, &(bool){false});
+	if (ret)
+		return dev_err_probe(dev, ret, "AOP domain guard refused\n");
+	auto_boot = readl(aop->control);
+	outbox = aop_rd(aop, AOP_OUTBOX_CONTROL);
+	ret = a9_aop_spi0_policy(aop, auto_boot, outbox);
+	if (ret)
+		return ret; /* Before first halt, mask, SRAM or SPI0 write. */
+	/* Orchard's old halt leaves +0x4020 enabled. On a known kexec,
+	 * that alone cannot certify the cold wrapper baseline. Release6's
+	 * wrapper discriminator was tied to its own outgoing stop routine.
+	 */
+	if (of_property_read_bool(of_chosen, "linux,booted-from-kexec") &&
+	    a9_spi0_decide(auto_boot, outbox & BIT(0), &aop->spi0.prev) != A9_SPI0_PREV_HALTED) {
+		dev_info(dev, "SPI0 policy decision=refuse reason=uncertified-kexec auto_boot=%u out4020=%08x: block not touched\n",
+			 auto_boot, outbox);
+		return -EPERM;
+	}
+	aop->warm = true;
+	aop->spi0.reason = a9_spi0_decide(auto_boot, outbox & BIT(0), &aop->spi0.prev);
+	if (!a9_spi0_reason_runs(aop->spi0.reason)) {
+		/* Original cold path: no halt, drain, reset, or SPI0 access. */
+		dev_info(dev, "SPI0 reset decision=skip reason=%s: block not touched\n",
+			 a9_spi0_reason_name(aop->spi0.reason));
+		return 0;
+	}
+	if (atomic_xchg(&aop_warm_attempted, 1))
+		return dev_err_probe(dev, -EPERM, "refused-second-experiment-attempt\n");
+	if (!a9_aop_ramoops_ready())
+		return dev_err_probe(dev, -ENODEV, "warm reload requires ramoops console\n");
+	aop->spi0.base = devm_ioremap(dev, A9_SPI0_PA, A9_SPI0_SIZE);
+	if (!aop->spi0.base)
+		return -ENOMEM;
+	/* Consume certification before the first control write. Reloading the
+	 * module after a failure must not reuse it as a second attempt.
+	 */
+	aop->shutdown_log->magic = 0;
+	wmb();
+	ret = apple_aop_warm_stop(aop);
+	if (!ret)
+		ret = a9_aop_spi0_prereset(aop, auto_boot, outbox);
+	if (ret)
+		dev_err(dev, "warm reload refused errno=%d; no copy/RUN, recover with DFU\n", ret);
+	return ret;
+}
