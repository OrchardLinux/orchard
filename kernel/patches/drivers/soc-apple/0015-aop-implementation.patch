+static u32 aop_rd(struct apple_aop *aop, u32 offset)
+{
+	return readl(aop->warm_wrapper + offset);
+}
+
+static bool a9_aop_force_stopped(struct apple_aop *aop)
+{
+	return !(aop_rd(aop, AOP_CPU_CONTROL) & AOP_CPU_START) &&
+	       !readl(aop->control) &&
+	       !(aop_rd(aop, AOP_OUTBOX_CONTROL) & (AOP_OUTBOX_ENABLE | AOP_MBOX_FAULTS)) &&
+	       !(aop_rd(aop, AOP_INBOX_CONTROL) & AOP_MBOX_FAULTS);
+}
