From 840db4a15433b323df91e55d655d58fb0eacce7f Mon Sep 17 00:00:00 2001
From: Dugs <dugahol@protonmail.com>
Date: Thu, 26 Nov 2026 20:57:15 +1030
Subject: [PATCH 4/6] dt-bindings: soc: apple: Add the Mesa Touch ID sensor

The Touch ID sensor of the A11 iPhones sits on its own SPI bus, runs in
SPI mode 2 and has a 1.8 V and a 3 V supply.

Assisted-by: LLM
Signed-off-by: Dugs <dugahol@protonmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/soc/apple/apple,mesa.yaml        | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/apple/apple,mesa.yaml

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,mesa.yaml b/Documentation/devicetree/bindings/soc/apple/apple,mesa.yaml
new file mode 100644
index 0000000..abcaa1d
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/apple/apple,mesa.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/apple/apple,mesa.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Mesa (Touch ID) sensor
+
+maintainers:
+  - Dugs <dugahol@protonmail.com>
+
+description:
+  The Touch ID sensor of the A11 iPhones, on its own SPI bus in SPI mode 2,
+  with a 1.8 V and a 3 V supply.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: apple,mesa
+
+  reg:
+    maxItems: 1
+
+  vdd18-supply:
+    description: 1.8 V supply, switched on first
+
+  vdd30-supply:
+    description: 3 V supply
+
+required:
+  - compatible
+  - reg
+  - vdd18-supply
+  - vdd30-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    spi {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      touch-id@0 {
+        compatible = "apple,mesa";
+        reg = <0>;
+        spi-max-frequency = <4000000>;
+        spi-cpol;
+        vdd18-supply = <&mesa_1v8>;
+        vdd30-supply = <&mesa_3v0>;
+      };
+    };
-- 
