From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thisiscamk <100883750+thisiscamk@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:00:00 +0800
Subject: [PATCH] soc: apple: rtkit: Handle the RTKit 10 minor protocol
 versions

RTKit 10 firmware, such as the iOS 12 storage coprocessor of the A7
iPads, sends its minor version (10.0 to 10.2) in the HELLO's
minimum-version field instead of a lower major version, and expects
the same minor version back in the reply. The minor version also
decides where the app endpoints start: 0x5 up to 10.1, 0x6 from 10.2.
10.0 and 10.1 do not acknowledge the AP power-on and report quiesce as
off.

Track the minor version for protocol 10 and handle those differences.
Firmware that offers 10 as both minimum and maximum, or 11 and later,
negotiates exactly as before; only a HELLO with maximum 10 and a lower
minimum is handled differently.

[Orchard: from thisiscamk/ipad-air-j72-linux 2a257d6,
 code/current/kernel/0001-j72-installed-kernel-snapshot.patch
 (drivers/soc/apple/rtkit.c, rtkit-internal.h); his J72 ANS negotiated
 RTKit 10.2 with endpoint 6 (code/storage/linux-asp-observer35/
 README.md). His epmap_done callback is already in Orchard (from
 Hoolock), and his apple_rtkit_protocol_version() export is not needed
 here; the stricter start_ep() check of a crashed coprocessor is left
 out.]
Assisted-by: LLM
---
 drivers/soc/apple/rtkit-internal.h |  4 +++-
 drivers/soc/apple/rtkit.c          | 33 +++++++++++++++++++++++++++---
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/drivers/soc/apple/rtkit-internal.h b/drivers/soc/apple/rtkit-internal.h
index 5f91dea8b..b94a192e6 100644
--- a/drivers/soc/apple/rtkit-internal.h
+++ b/drivers/soc/apple/rtkit-internal.h
@@ -19,7 +19,8 @@
 #include <linux/workqueue.h>
 #include "mailbox.h"
 
-#define APPLE_RTKIT_APP_ENDPOINT_START_V10 0x6
+#define APPLE_RTKIT_APP_ENDPOINT_START_V10_0 0x5
+#define APPLE_RTKIT_APP_ENDPOINT_START_V10_2 0x6
 #define APPLE_RTKIT_APP_ENDPOINT_START_V11 0x20
 #define APPLE_RTKIT_MAX_ENDPOINTS 0x100
 
@@ -36,6 +37,7 @@ struct apple_rtkit {
 
 	int boot_result;
 	int version;
+	u16 minor_version;
 	u8 app_ep_start;
 
 	unsigned int iop_power_state;
diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index 569206c76..521c7b234 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -122,6 +122,16 @@ static void apple_rtkit_management_rx_hello(struct apple_rtkit *rtk, u64 msg)
 	int max_ver = FIELD_GET(APPLE_RTKIT_MGMT_HELLO_MAXVER, msg);
 	int want_ver = min(APPLE_RTKIT_MAX_SUPPORTED_VERSION, max_ver);
 
+	/*
+	 * Protocol 10 firmware carries its minor version in the HELLO's
+	 * minimum-version field (10.0 to 10.2), not a lower major version.
+	 */
+	rtk->minor_version = 0;
+	if (max_ver == 10) {
+		rtk->minor_version = min_ver;
+		min_ver = max_ver;
+	}
+
 	dev_dbg(rtk->dev, "RTKit: Min ver %d, max ver %d\n", min_ver, max_ver);
 
 	if (min_ver > APPLE_RTKIT_MAX_SUPPORTED_VERSION) {
@@ -140,12 +150,16 @@ static void apple_rtkit_management_rx_hello(struct apple_rtkit *rtk, u64 msg)
 		 want_ver);
 	rtk->version = want_ver;
 
-	if (rtk->version < 11)
-		rtk->app_ep_start = APPLE_RTKIT_APP_ENDPOINT_START_V10;
+	if (rtk->version == 10 && rtk->minor_version < 2)
+		rtk->app_ep_start = APPLE_RTKIT_APP_ENDPOINT_START_V10_0;
+	else if (rtk->version == 10)
+		rtk->app_ep_start = APPLE_RTKIT_APP_ENDPOINT_START_V10_2;
 	else
 		rtk->app_ep_start = APPLE_RTKIT_APP_ENDPOINT_START_V11;
 
-	reply = FIELD_PREP(APPLE_RTKIT_MGMT_HELLO_MINVER, want_ver);
+	/* Protocol 10 echoes the minor version the firmware offered. */
+	reply = FIELD_PREP(APPLE_RTKIT_MGMT_HELLO_MINVER,
+			   rtk->version == 10 ? rtk->minor_version : want_ver);
 	reply |= FIELD_PREP(APPLE_RTKIT_MGMT_HELLO_MAXVER, want_ver);
 	apple_rtkit_management_send(rtk, APPLE_RTKIT_MGMT_HELLO_REPLY, reply);
 
@@ -814,10 +828,23 @@ static int apple_rtkit_set_ap_power_state(struct apple_rtkit *rtk,
 	if (ret)
 		return ret;
 
+	/* Protocol 10.0 and 10.1 do not acknowledge the AP power-on. */
+	if (rtk->version == 10 && rtk->minor_version < 2 &&
+	    state == APPLE_RTKIT_PWR_STATE_ON) {
+		rtk->ap_power_state = state;
+		return 0;
+	}
+
 	ret = apple_rtkit_wait_for_completion(&rtk->ap_pwr_ack_completion);
 	if (ret)
 		return ret;
 
+	/* ... and report quiesce as off. */
+	if (rtk->version == 10 && rtk->minor_version < 2 &&
+	    state == APPLE_RTKIT_PWR_STATE_QUIESCED &&
+	    rtk->ap_power_state == APPLE_RTKIT_PWR_STATE_OFF)
+		rtk->ap_power_state = state;
+
 	if (rtk->ap_power_state != state)
 		return -EINVAL;
 	return 0;
