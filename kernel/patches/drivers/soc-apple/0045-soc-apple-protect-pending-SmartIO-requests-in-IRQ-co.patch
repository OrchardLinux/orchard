From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Fri, 20 Nov 2026 22:37:56 +0100
Subject: [PATCH] soc: apple: protect pending SmartIO requests in IRQ context
 and expose MCA2 RX

Assisted-by: LLM
---
 drivers/soc/apple/apple-sio-core.c | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/drivers/soc/apple/apple-sio-core.c b/drivers/soc/apple/apple-sio-core.c
index f4caefda8..cd9f434f1 100644
--- a/drivers/soc/apple/apple-sio-core.c
+++ b/drivers/soc/apple/apple-sio-core.c
@@ -563,7 +563,14 @@ apple_sio_request_async_common(struct apple_sio *sio, u8 endpoint, u8 opcode,
 	request->status = -EINPROGRESS;
 	request->active = true;
 
-	ret = xa_insert(&sio->pending, request->key, request, gfp);
+	/* Setup replies submit requests from hard IRQ context. */
+	if (atomic) {
+		xa_lock_irqsave(&sio->pending, flags);
+		ret = __xa_insert(&sio->pending, request->key, request, gfp);
+		xa_unlock_irqrestore(&sio->pending, flags);
+	} else {
+		ret = xa_insert_irq(&sio->pending, request->key, request, gfp);
+	}
 	if (ret) {
 		apple_sio_tag_free(sio, endpoint, tag);
 		apple_sio_async_put(request);
@@ -1016,7 +1023,7 @@ static int apple_sio_probe(struct platform_device *pdev)
 	mutex_init(&sio->tx_lock);
 	spin_lock_init(&sio->tx_hw_lock);
 	spin_lock_init(&sio->tag_lock);
-	xa_init(&sio->pending);
+	xa_init_flags(&sio->pending, XA_FLAGS_LOCK_IRQ);
 	spin_lock_init(&sio->desc0_lock);
 	platform_set_drvdata(pdev, sio);
 
@@ -1187,9 +1194,9 @@ static const struct apple_sio_hw apple_sio_t7000_hw = {
 	.num_dma_ranges = ARRAY_SIZE(apple_sio_t7000_dma_ranges),
 };
 
-/* J120 ADT: MCA2 speaker TX, MCA4 headphone TX and PDM microphone RX. */
+/* J120 MCA2 transmit/receive, MCA4 transmit and PDM receive. */
 static const struct apple_sio_dma_range apple_sio_t8011_dma_ranges[] = {
-	{ 0x2c, 0x2c },
+	{ 0x2c, 0x2d },
 	{ 0x30, 0x30 },
 	{ 0x5b, 0x5b },
 };
