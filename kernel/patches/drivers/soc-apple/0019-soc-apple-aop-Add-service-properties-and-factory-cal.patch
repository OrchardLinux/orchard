From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Thu, 12 Nov 2026 09:00:00 +0100
Subject: [PATCH] soc: apple: aop: Add service properties and factory
 calibration

The sensor services of the AOP firmware are configured through EPIC
set-property requests (subtype 0x4): the report intervals, and the
unit's factory calibration, which the bootloader copies from the Apple
device tree into the sensor's node. Once the calibration is sent, the
firmware is told whether it is complete (property 0x3d: 2 complete,
1 partial); the S8000's firmware sends no reports before that.

Add apple_aop_set_property() for a property of up to 64 bytes, and
apple_aop_calibrate(), which sends a sensor driver's table of
calibration properties that are present in its node and then the
calibration state. A table entry belongs to a group; the calibration
is complete once one entry of every group was applied.

[Orchard: from orchard PR #101, commit a54e2049; the property and
 calibration API of soc-apple/0015, unchanged]

Assisted-by: LLM
---
 drivers/soc/apple/aop.c       | 58 +++++++++++++++++++++++++++++++++++
 include/linux/soc/apple/aop.h | 28 +++++++++++++++++
 2 files changed, 86 insertions(+)

diff --git a/drivers/soc/apple/aop.c b/drivers/soc/apple/aop.c
index ffd48d6..6d94720 100644
--- a/drivers/soc/apple/aop.c
+++ b/drivers/soc/apple/aop.c
@@ -117,6 +117,12 @@
 #define APPLE_AOP_MAX_CALLS		8
 #define APPLE_AOP_CALL_TIMEOUT		msecs_to_jiffies(1000)
 
+/* Service properties */
+#define APPLE_AOP_PROPERTY_MAX		64
+#define APPLE_AOP_PROP_CALIBRATION	0x3d
+#define APPLE_AOP_CALIBRATION_PARTIAL	1
+#define APPLE_AOP_CALIBRATION_COMPLETE	2
+
 struct afk_qe_header {
 	__le32 magic;
 	__le32 size;
@@ -887,6 +893,58 @@ int apple_aop_call(const struct apple_aop_service *service, u16 subtype, const v
 }
 EXPORT_SYMBOL_GPL(apple_aop_call);
 
+int apple_aop_set_property(const struct apple_aop_service *service, u32 key,
+			   const void *value, size_t len)
+{
+	u8 buf[8 + APPLE_AOP_PROPERTY_MAX];
+	int ret;
+
+	if (len > APPLE_AOP_PROPERTY_MAX)
+		return -EINVAL;
+	put_unaligned_le32(0, buf);
+	put_unaligned_le32(key, buf + 4);
+	memcpy(buf + 8, value, len);
+
+	ret = apple_aop_call(service, APPLE_AOP_SET_PROPERTY, buf, 8 + len, NULL, 0);
+	return ret > 0 ? -EIO : ret;
+}
+EXPORT_SYMBOL_GPL(apple_aop_set_property);
+
+int apple_aop_calibrate(const struct apple_aop_service *service, struct device *dev,
+			const struct apple_aop_calibration *cal, unsigned int count)
+{
+	unsigned long needed = 0, applied = 0;
+	__le32 state;
+	unsigned int i;
+	int len, ret;
+
+	for (i = 0; i < count; i++) {
+		const void *blob;
+
+		if (cal[i].group)
+			needed |= BIT(cal[i].group);
+		blob = of_get_property(dev->of_node, cal[i].property, &len);
+		if (!blob)
+			continue;
+		ret = apple_aop_set_property(service, cal[i].key, blob, len);
+		if (ret) {
+			dev_warn(dev, "%s not applied: %d\n", cal[i].property, ret);
+			continue;
+		}
+		if (cal[i].group)
+			applied |= BIT(cal[i].group);
+	}
+
+	if (needed && applied == needed) {
+		state = cpu_to_le32(APPLE_AOP_CALIBRATION_COMPLETE);
+	} else {
+		dev_warn(dev, "factory calibration incomplete\n");
+		state = cpu_to_le32(APPLE_AOP_CALIBRATION_PARTIAL);
+	}
+	return apple_aop_set_property(service, APPLE_AOP_PROP_CALIBRATION, &state, sizeof(state));
+}
+EXPORT_SYMBOL_GPL(apple_aop_calibrate);
+
 /* Driver */
 
 static void apple_aop_free_buffers(struct apple_aop *aop)
diff --git a/include/linux/soc/apple/aop.h b/include/linux/soc/apple/aop.h
index 8c8bc71..b5188a0 100644
--- a/include/linux/soc/apple/aop.h
+++ b/include/linux/soc/apple/aop.h
@@ -7,6 +7,8 @@
 
 #include <linux/types.h>
 
+struct device;
+
 struct apple_aop;
 
 /*
@@ -40,4 +42,30 @@ void apple_aop_unlisten(const struct apple_aop_service *service);
 int apple_aop_call(const struct apple_aop_service *service, u16 subtype,
 		   const void *data, size_t len, void *reply, size_t reply_len);
 
+/* The EPIC notification subtype that sets a service property */
+#define APPLE_AOP_SET_PROPERTY		0x4
+
+/* Set property @key of a service to @len (at most 64) bytes at @value. */
+int apple_aop_set_property(const struct apple_aop_service *service, u32 key,
+			   const void *value, size_t len);
+
+/*
+ * A factory calibration blob of a sensor: the bootloader copies it from the
+ * Apple device tree into the sensor's node as @property, and the firmware
+ * takes it as property @key. The calibration is complete once a blob of each
+ * @group (1 to 31) was applied; group 0 blobs are not needed for that.
+ */
+struct apple_aop_calibration {
+	const char *property;
+	u32 key;
+	u8 group;
+};
+
+/*
+ * Send the factory calibration found in @dev's node, then tell the firmware
+ * whether it is complete. Some firmware (S8000) sends no reports before.
+ */
+int apple_aop_calibrate(const struct apple_aop_service *service, struct device *dev,
+			const struct apple_aop_calibration *cal, unsigned int count);
+
 #endif /* _LINUX_SOC_APPLE_AOP_H_ */
-- 
