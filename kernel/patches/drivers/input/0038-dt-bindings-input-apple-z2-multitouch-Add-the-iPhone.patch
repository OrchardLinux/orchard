From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 23 Nov 2026 22:47:16 +0800
Subject: [PATCH] dt-bindings: input: apple,z2-multitouch: Add the iPhone 6s
 and SE

The iPhone 6s (N71, N71m) and iPhone SE (N69, N69u) have the iPhone 6s
Plus's N1 controller, wired the same way: same supplies, attention and
reset lines.

Assisted-by: LLM
---
 .../input/touchscreen/apple,z2-multitouch.yaml         | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
index f01e550..cfb7761 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
@@ -29,6 +29,8 @@ properties:
       - apple,n61-touchscreen
       - apple,n102-touchscreen
       - apple,n66-touchscreen
+      - apple,n69-touchscreen
+      - apple,n71-touchscreen
 
   interrupts:
     maxItems: 1
@@ -189,6 +191,8 @@ allOf:
             - apple,j96-touchscreen
             - apple,n102-touchscreen
             - apple,n66-touchscreen
+            - apple,n69-touchscreen
+            - apple,n71-touchscreen
     then:
       properties:
         pinctrl-names:
@@ -212,6 +216,8 @@ allOf:
             enum:
               - apple,n102-touchscreen
               - apple,n66-touchscreen
+              - apple,n69-touchscreen
+              - apple,n71-touchscreen
       then:
         properties:
           power-ldo-gpios: false
@@ -288,6 +294,8 @@ allOf:
             - apple,n61-touchscreen
             - apple,n102-touchscreen
             - apple,n66-touchscreen
+            - apple,n69-touchscreen
+            - apple,n71-touchscreen
     then:
       properties:
         ana-supply: true
@@ -305,6 +313,8 @@ allOf:
             - apple,j96-touchscreen
             - apple,n102-touchscreen
             - apple,n66-touchscreen
+            - apple,n69-touchscreen
+            - apple,n71-touchscreen
     then:
       properties:
         attn-gpios: true
