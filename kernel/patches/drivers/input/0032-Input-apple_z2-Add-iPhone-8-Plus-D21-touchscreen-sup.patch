+					      "gen2-9d") &&
+	    !(status == 2 && !len)) {
+		error = apple_z2_write_report_locked(z2, 0x9d, rep9d,
+						     sizeof(rep9d), "gen2-9d-1");
+		if (error)
+			return error;
+		usleep_range(50500, 50700);
+		error = apple_z2_write_report_locked(z2, 0x9d, rep9d,
+						     sizeof(rep9d), "gen2-9d-2");
+		if (!error)
+			error = apple_z2_write_report_locked(z2, 0xbf, repbf,
+							     sizeof(repbf),
+							     "gen2-bf");
+		if (error)
+			return error;
+	}
