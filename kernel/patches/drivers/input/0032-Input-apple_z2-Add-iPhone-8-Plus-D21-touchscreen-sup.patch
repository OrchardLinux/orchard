+	return 0;
+}
+
+static int apple_z2_gen2_finish_boot(struct apple_z2 *z2,
+				     const struct firmware *fw)
+{
+	const struct apple_z2_gen2_boot *boot = z2->info->gen2_boot;
+	int error;
+
+	mutex_lock(&z2->io_lock);
+	/* Right after the file the first register write can be refused. */
+	msleep(APPLE_Z2_D21_REG_SETTLE_MS);
+	error = apple_z2_gen2_write_regs(z2, boot->regs, boot->num_regs);
+	if (!error)
+		error = apple_z2_gen2_send_calibration(z2, fw);
+	if (!error)
+		error = apple_z2_gen2_write_regs(z2, boot->post_cal_regs,
+						 boot->num_post_cal_regs);
+	if (!error) {
+		msleep(50);
+		error = apple_z2_gen2_init_locked(z2);
+	}
+	if (!error) {
+		z2->protocol_state = APPLE_Z2_STATE_REPORTS_READY;
+		z2->booted = true;
+		error = apple_z2_read_packet(z2);
+	}
+	mutex_unlock(&z2->io_lock);
+	if (error)
+		return error;
+
+	apple_z2_irq_on(z2);
+	return 0;
+}
