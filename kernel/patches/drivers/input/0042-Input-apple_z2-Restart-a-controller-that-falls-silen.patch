From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 24 Nov 2026 02:07:41 +0800
Subject: [PATCH] Input: apple_z2: Restart a controller that falls silent

An iPad 6 lost touch while in use, some time after a wake: the
interrupt count stopped, the interrupt line stayed released, reads of
the event node returned nothing, and the driver logged nothing. Its
stall recovery runs only when the controller sends something wrong, so
a controller that sends nothing at all stays dead until the driver is
rebound, which brought it back.

On the generation-1 boards (the iPad 6 and the N1 boards: iPad 5, iPad
Air 2, iPad mini 2 and 4, iPod touch 6, iPhone 6s, 6s Plus and SE) check a
controller that has been quiet for 5 s. Read its interrupt data length
as the interrupt thread does, and on the N1 boards wake it first, as
their resynchronisation does. A working controller answers with its
queue state: usually empty, as nobody is touching it; a report it
failed to signal is read and delivered. Only a controller that does not
answer is restarted, through the board's existing stall recovery, at
most once in 30 s, with "touch controller silent, restarting" in the
log. Nothing is read while interrupts arrive, and the check stops with
the controller for suspend and removal and starts again when its boot
completes. The iPad Air polls by itself already; the other controllers'
idle answer is not known, so they keep their behaviour.

Assisted-by: LLM
---
 drivers/input/touchscreen/apple_z2.c | 112 ++++++++++++++++++++++++++-
 1 file changed, 108 insertions(+), 4 deletions(-)

diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
index 07a33e8..fe80b78 100644
--- a/drivers/input/touchscreen/apple_z2.c
+++ b/drivers/input/touchscreen/apple_z2.c
@@ -64,6 +64,8 @@
 #define APPLE_Z2_CONTROL_GAP_MS          250
 #define APPLE_Z2_CONTROL_RESTARTS        3
 #define APPLE_Z2_CONTROL_RETRY_MS        1000
+#define APPLE_Z2_WATCHDOG_MS             5000
+#define APPLE_Z2_WATCHDOG_RESTART_MS     30000
 #define APPLE_Z2_CMD_SIZE                16
 #define APPLE_Z2_RAW_XFER_MAX_SIZE       64
 #define APPLE_Z2_GEN2_MIN_RESULT_SIZE    64
@@ -255,6 +257,10 @@ struct apple_z2 {
 	int j72_layout_error;
 	int j72_spi_error;
 	struct work_struct resume_work;
+	struct delayed_work watchdog_work;
+	unsigned long last_irq;		/* jiffies of the last runtime interrupt */
+	unsigned long watchdog_restart;	/* jiffies of the last silent restart */
+	bool watchdog_restarted;
 	bool boot_due;		/* resumed: boot once every device is back */
 	unsigned int rearm_attempts;
 	unsigned int control_reads;
@@ -2271,13 +2277,13 @@ static void apple_z2_control_rearm_work(struct work_struct *work)
 }
 
 /* io_lock is held; queue at most one restart for this stalled run. */
-static void apple_z2_queue_control_recovery(struct apple_z2 *z2)
+static void apple_z2_queue_control_recovery(struct apple_z2 *z2,
+					    const char *why)
 {
 	if (z2->recovering || z2->stopping)
 		return;
 
-	dev_warn_ratelimited(&z2->spidev->dev,
-			     "control-only touch stall, restarting\n");
+	dev_warn_ratelimited(&z2->spidev->dev, "%s, restarting\n", why);
 	apple_z2_release_contacts(z2);
 	z2->irq_on = false;
 	disable_irq_nosync(z2->spidev->irq);
@@ -2293,6 +2299,7 @@ static irqreturn_t apple_z2_irq(int irq, void *data)
 
 	if (apple_z2_is_j72(z2))
 		return IRQ_HANDLED;
+	WRITE_ONCE(z2->last_irq, jiffies);
 	if (unlikely(!z2->booted)) {
 		complete(&z2->boot_irq);
 	} else if (apple_z2_is_j71t(z2)) {
@@ -2309,7 +2316,8 @@ static irqreturn_t apple_z2_irq(int irq, void *data)
 		error = apple_z2_is_gen1(z2) ? apple_z2_gen1_drain(z2) :
 						 apple_z2_read_packet(z2);
 		if (error == -ETIMEDOUT && z2->info->recover_control_stall)
-			apple_z2_queue_control_recovery(z2);
+			apple_z2_queue_control_recovery(z2,
+							"control-only touch stall");
 		mutex_unlock(&z2->io_lock);
 		if (error)
 			dev_warn_ratelimited(&z2->spidev->dev,
@@ -2320,6 +2328,97 @@ static irqreturn_t apple_z2_irq(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
+/*
+ * Silent-controller watchdog of the generation-1 boards (the iPad 6 and the
+ * N1 boards; the J72 polls by itself). A controller that stops raising its
+ * interrupt leaves no frame and no error behind, so nothing else notices.
+ * After APPLE_Z2_WATCHDOG_MS without an interrupt, read the interrupt data
+ * length as the interrupt thread does: a working controller answers with
+ * its queue state (usually empty; a report it failed to signal is read and
+ * delivered), a silent one does not answer, and only then is it restarted
+ * through the board's stall recovery, at most once per
+ * APPLE_Z2_WATCHDOG_RESTART_MS. While interrupts arrive it reads nothing.
+ */
+static bool apple_z2_has_watchdog(const struct apple_z2 *z2)
+{
+	return apple_z2_is_gen1(z2) && !apple_z2_is_j72(z2);
+}
+
+static void apple_z2_watchdog_arm(struct apple_z2 *z2)
+{
+	if (!apple_z2_has_watchdog(z2))
+		return;
+	WRITE_ONCE(z2->last_irq, jiffies);
+	mod_delayed_work(system_dfl_wq, &z2->watchdog_work,
+			 msecs_to_jiffies(APPLE_Z2_WATCHDOG_MS));
+}
+
+/* io_lock is held: true when the controller answered the probe. */
+static bool apple_z2_watchdog_probe_locked(struct apple_z2 *z2)
+{
+	int error;
+
+	if (apple_z2_is_j71b(z2)) {
+		error = apple_z2_gen1_drain(z2);
+		return !error && (z2->runtime_queue_empty ||
+				  z2->runtime_frame_valid ||
+				  z2->runtime_control_reply);
+	}
+
+	/* N1: the wake and service the resynchronisation also starts with. */
+	z2->wake_valid = false;
+	error = apple_z2_n1_wake_locked(z2);
+	if (!error)
+		error = apple_z2_n1_service_locked(z2);
+	return !error;
+}
+
+static void apple_z2_watchdog_work(struct work_struct *work)
+{
+	struct apple_z2 *z2 = container_of(to_delayed_work(work),
+					   struct apple_z2, watchdog_work);
+	unsigned long due;
+
+	mutex_lock(&z2->io_lock);
+	if (z2->stopping)
+		goto unlock;
+	due = READ_ONCE(z2->last_irq) + msecs_to_jiffies(APPLE_Z2_WATCHDOG_MS);
+	/* Booting, recovering or masked: look again later. */
+	if (!z2->booted || z2->recovering || !z2->irq_on ||
+	    time_before(jiffies, due) ||
+	    (z2->watchdog_restarted &&
+	     time_before(jiffies, z2->watchdog_restart +
+			 msecs_to_jiffies(APPLE_Z2_WATCHDOG_RESTART_MS))))
+		goto again;
+
+	if (apple_z2_watchdog_probe_locked(z2)) {
+		WRITE_ONCE(z2->last_irq, jiffies);
+		goto again;
+	}
+
+	z2->watchdog_restarted = true;
+	z2->watchdog_restart = jiffies;
+	if (z2->info->recover_control_stall) {
+		apple_z2_queue_control_recovery(z2,
+						"touch controller silent");
+	} else {
+		dev_warn(&z2->spidev->dev,
+			 "touch controller silent, restarting\n");
+		apple_z2_release_contacts(z2);
+		z2->irq_on = false;
+		disable_irq_nosync(z2->spidev->irq);
+		z2->rearm_attempts = 0;
+		schedule_delayed_work(&z2->rearm_work, 0);
+	}
+	due = jiffies;
+again:
+	if (time_before(due, jiffies + msecs_to_jiffies(1000)))
+		due = jiffies + msecs_to_jiffies(APPLE_Z2_WATCHDOG_MS);
+	mod_delayed_work(system_dfl_wq, &z2->watchdog_work, due - jiffies);
+unlock:
+	mutex_unlock(&z2->io_lock);
+}
+
 static void apple_z2_set_gpio(struct gpio_desc *gpio, int value)
 {
 	if (gpio)
@@ -3307,6 +3406,7 @@ static int apple_z2_n1_finish_boot(struct apple_z2 *z2)
 	if (!error) {
 		z2->rearm_attempts = 0;
 		apple_z2_irq_on(z2);
+		apple_z2_watchdog_arm(z2);
 	}
 	mutex_unlock(&z2->io_lock);
 
@@ -3921,6 +4021,7 @@ static int apple_z2_upload_firmware(struct apple_z2 *z2)
 	if (!error && apple_z2_is_j71b(z2) && z2->upload_irq_masked) {
 		z2->upload_irq_masked = false;
 		apple_z2_irq_on(z2);
+		apple_z2_watchdog_arm(z2);
 	}
 	mutex_unlock(&z2->io_lock);
 	return error;
@@ -4953,6 +5054,7 @@ static int apple_z2_probe(struct spi_device *spi)
 			  apple_z2_control_rearm_work : apple_z2_n1_rearm_work);
 	INIT_DELAYED_WORK(&z2->j72_work, apple_z2_j72_work);
 	INIT_WORK(&z2->resume_work, apple_z2_resume_work);
+	INIT_DELAYED_WORK(&z2->watchdog_work, apple_z2_watchdog_work);
 	spi_set_drvdata(spi, z2);
 
 	z2->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
@@ -5170,6 +5272,8 @@ static void apple_z2_stop(struct apple_z2 *z2)
 		mutex_lock(&z2->io_lock);
 		z2->stopping = true;
 		mutex_unlock(&z2->io_lock);
+		/* The watchdog may queue a restart: cancel it first. */
+		cancel_delayed_work_sync(&z2->watchdog_work);
 		cancel_delayed_work_sync(&z2->rearm_work);
 		if (apple_z2_is_j72(z2))
 			cancel_delayed_work_sync(&z2->j72_work);
-- 
