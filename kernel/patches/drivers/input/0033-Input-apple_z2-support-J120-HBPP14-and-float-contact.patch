 		"device info: platform=%u interface=%u max-packet=%u\n",
 		 platform_id, interface_version, max_packet_size);
@@ -1445,7 +1596,10 @@ static int apple_z2_read_report_locked(struct apple_z2 *z2, u8 report,
 		xfer.tx_buf = z2->rx_buf;
 		xfer.rx_buf = z2->rx_buf;
 		xfer.len = data_len;
-		error = apple_z2_spi_transfer(z2, &xfer, 1);
+		if (apple_z2_is_j120(z2))
+			error = apple_z2_j120_short_xfer(z2, z2->rx_buf, data_len);
