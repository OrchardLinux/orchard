From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 14:36:23 +0100
Subject: [PATCH] dt-bindings: input: apple,z2-multitouch: Add the iPhone 6s
 Plus

The iPhone 6s Plus (N66) uses the N1 protocol like the iPod touch 6,
with a regulator for the core supply.

Assisted-by: LLM
---
 .../bindings/input/touchscreen/apple,z2-multitouch.yaml   | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
index 09613d444..f01e5508e 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
@@ -28,6 +28,7 @@ properties:
       - apple,d111-touchscreen
       - apple,n61-touchscreen
       - apple,n102-touchscreen
+      - apple,n66-touchscreen
 
   interrupts:
     maxItems: 1
@@ -187,6 +188,7 @@ allOf:
             - apple,j81-touchscreen
             - apple,j96-touchscreen
             - apple,n102-touchscreen
+            - apple,n66-touchscreen
     then:
       properties:
         pinctrl-names:
@@ -207,7 +209,9 @@ allOf:
       if:
         properties:
           compatible:
-            const: apple,n102-touchscreen
+            enum:
+              - apple,n102-touchscreen
+              - apple,n66-touchscreen
       then:
         properties:
           power-ldo-gpios: false
@@ -283,6 +287,7 @@ allOf:
             - apple,j96-touchscreen
             - apple,n61-touchscreen
             - apple,n102-touchscreen
+            - apple,n66-touchscreen
     then:
       properties:
         ana-supply: true
@@ -299,6 +304,7 @@ allOf:
             - apple,j85-touchscreen
             - apple,j96-touchscreen
             - apple,n102-touchscreen
+            - apple,n66-touchscreen
     then:
       properties:
         attn-gpios: true
