 		slot = input_mt_get_slot_by_key(z2->input_dev, contact[0]);
@@ -594,23 +640,20 @@ static void apple_z2_parse_j172_touches(struct apple_z2 *z2,
 		if (!input_mt_report_slot_state(z2->input_dev, MT_TOOL_FINGER, active))
