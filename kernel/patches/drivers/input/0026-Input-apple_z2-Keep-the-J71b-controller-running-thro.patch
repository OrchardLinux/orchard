From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 9 Nov 2026 22:17:54 +0800
Subject: [PATCH] Input: apple_z2: Keep the J71b controller running through
 sleep

Every wake booted the controller again: power on, firmware upload and
setup took 3.3 s, so touch came back seconds after the screen was lit.

Leave a booted J71b controller powered and clocked through sleep, with
its interrupt masked, and on resume send it the wake command that ends a
boot, drain what queued and take interrupts again. Touch then works when
the screen comes on (first touch delivered 0.6 s after resume, as soon
as a finger was down). Without the wake command the controller answered
every interrupt with the same control reply and never sent a frame;
stopping only its clock left it answering garbage. A controller that
does not answer after sleep is booted from scratch as before.

The iOS 10 driver (AppleMultitouchZ2SPI::_handlePowerStateChange)
powers the controller off for system sleep and boots it at wake. Its
cost here is the controller's idle draw while the system sleeps, which
is shallow on this SoC so far (display and GPIO domains stay on).

Assisted-by: LLM
---
 drivers/input/touchscreen/apple_z2.c | 65 ++++++++++++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
index eaec6e3b7994..885bae94d51a 100644
--- a/drivers/input/touchscreen/apple_z2.c
+++ b/drivers/input/touchscreen/apple_z2.c
@@ -236,6 +236,7 @@ struct apple_z2 {
 	struct delayed_work rearm_work;
 	struct work_struct resume_work;
 	bool boot_due;		/* resumed: boot once every device is back */
+	bool kept;		/* J71b: left powered and booted for sleep */
 	unsigned int rearm_attempts;
 	unsigned int control_reads;
 	unsigned long control_since;
@@ -4492,10 +4493,40 @@ static void apple_z2_remove(struct spi_device *spi)
 	apple_z2_stop(z2);
 }
 
+/*
+ * J71b: a booted controller stays powered and clocked through sleep, with its
+ * interrupt masked, so touch works the moment the screen is lit. Booting it
+ * again uploads its firmware and takes 3.3 s. Stopping only its clock left it
+ * answering garbage after the wake.
+ */
+static bool apple_z2_keep_for_sleep(struct apple_z2 *z2)
+{
+	if (!apple_z2_is_j71b(z2) || !z2->booted ||
+	    work_pending(&z2->resume_work))
+		return false;
+
+	mutex_lock(&z2->io_lock);
+	z2->stopping = true;
+	mutex_unlock(&z2->io_lock);
+	cancel_delayed_work_sync(&z2->rearm_work);
+	if (!z2->booted)	/* a stall restart was under way */
+		return false;
+
+	mutex_lock(&z2->io_lock);
+	apple_z2_release_contacts(z2);
+	mutex_unlock(&z2->io_lock);
+	apple_z2_irq_off(z2);
+	z2->kept = true;
+	return true;
+}
+
 static int apple_z2_suspend(struct device *dev)
 {
 	struct apple_z2 *z2 = spi_get_drvdata(to_spi_device(dev));
 
+	if (apple_z2_keep_for_sleep(z2))
+		return 0;
+
 	/* A controller still booting from the last resume stops first */
 	cancel_work_sync(&z2->resume_work);
 	apple_z2_stop(z2);
@@ -4548,6 +4579,38 @@ static int apple_z2_resume(struct device *dev)
 	return 0;
 }
 
+/*
+ * A kept controller needs the wake command, as at the end of a boot; without
+ * it, it answered every interrupt with the same control reply and never
+ * delivered a frame. Then drain what queued and take interrupts again. A
+ * controller that does not answer is booted from scratch.
+ */
+static int apple_z2_resume_kept(struct apple_z2 *z2)
+{
+	int error;
+
+	z2->kept = false;
+	mutex_lock(&z2->io_lock);
+	error = apple_z2_z2_cmd_locked(z2, APPLE_Z2_CMD_WAKE, 0, "resume-wake");
+	if (!error) {
+		usleep_range(2200, 2300);
+		error = apple_z2_gen1_drain(z2);
+	}
+	mutex_unlock(&z2->io_lock);
+	if (error) {
+		dev_warn(&z2->spidev->dev,
+			 "touch did not answer after sleep (%d), restarting it\n",
+			 error);
+		gpiod_direction_output(z2->reset_gpio, 1);
+		z2->booted = false;
+		apple_z2_platform_power_off(z2);
+		apple_z2_reset_protocol(z2);
+		return error;
+	}
+	apple_z2_irq_on(z2);
+	return 0;
+}
+
 /* Also runs when sleep was aborted before suspend(): boot only if stopped. */
 static void __maybe_unused apple_z2_complete(struct device *dev)
 {
@@ -4556,6 +4619,8 @@ static void __maybe_unused apple_z2_complete(struct device *dev)
 	if (!z2->boot_due)
 		return;
 	z2->boot_due = false;
+	if (z2->kept && !apple_z2_resume_kept(z2))
+		return;
 	queue_work(system_unbound_wq, &z2->resume_work);
 }
 
