From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:39:53 +0100
Subject: [PATCH] dt-bindings: input: apple-z2: describe the J120 touchscreen

Describe the J120 touchscreen supply, enable GPIO, display-sync pin states and firmware calibration properties.

Assisted-by: LLM
---
 .../touchscreen/apple,z2-multitouch.yaml      | 29 +++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
index 4a89d6bbe..3d3b9320c 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/apple,z2-multitouch.yaml
@@ -22,6 +22,7 @@ properties:
       - apple,j72-touchscreen
       - apple,j81-touchscreen
       - apple,j96-touchscreen
+      - apple,j120-touchscreen
       - apple,j172-touchscreen
       - apple,d11-touchscreen
       - apple,d111-touchscreen
@@ -155,6 +156,33 @@ required:
   - touchscreen-size-y
 
 allOf:
+  - if:
+      properties:
+        compatible:
+          const: apple,j120-touchscreen
+    then:
+      properties:
+        pinctrl-names:
+          items:
+            - const: display-sync-active
+            - const: display-sync-inactive
+        power-ana-gpios: false
+        display-sync-gpios: false
+        display-sync1-gpios: false
+        hv-supply: false
+        core-supply: false
+        attn-gpios: false
+        apple,z2-bpw16-min-len: false
+        apple,z2-no-init-ack: false
+      required:
+        - clocks
+        - ana-supply
+        - power-ldo-gpios
+        - pinctrl-0
+        - pinctrl-1
+        - pinctrl-names
+        - spi-cpha
+        - spi-cpol
   - $ref: touchscreen.yaml#
   - $ref: /schemas/spi/spi-peripheral-props.yaml#
   - if:
@@ -238,6 +266,7 @@ allOf:
             - apple,j72-touchscreen
             - apple,j81-touchscreen
             - apple,j96-touchscreen
+            - apple,j120-touchscreen
             - apple,n61-touchscreen
     then:
       properties:
