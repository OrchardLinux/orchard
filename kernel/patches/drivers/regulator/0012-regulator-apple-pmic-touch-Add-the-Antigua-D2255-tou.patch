From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 14:36:23 +0100
Subject: [PATCH] regulator: apple-pmic-touch: Add the Antigua (D2255) touch
 core

The ADT names the iPhone 6s Plus's touch core supply pmuL(0x219): LDO
index 25 of the D2255. iOS 19H422's LDO table (0xfffffff0059cc58e, used
by _setLDO at 0xfffffff0069337f4) has no voltage register for it, only
an enable at register 0x319 bit 0. iBoot leaves it on (0x01 read back on
an N66), so enabling it changes nothing at boot.

Assisted-by: LLM
---
 .../regulator/apple-pmic-touch-regulator.c    | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/regulator/apple-pmic-touch-regulator.c b/drivers/regulator/apple-pmic-touch-regulator.c
index 49e241471..1bc7f79c1 100644
--- a/drivers/regulator/apple-pmic-touch-regulator.c
+++ b/drivers/regulator/apple-pmic-touch-regulator.c
@@ -88,6 +88,25 @@ static const struct regulator_desc apple_adelyn_touch_core = {
 	.off_on_delay = 1000,
 };
 
+/*
+ * Antigua (D2255, iPhone 6s/6s Plus) pmuL(0x219): LDO index 25, enable-only,
+ * through register 0x319 bit 0 (iOS 19H422 LDO table 0xfffffff0059cc58e,
+ * _setLDO 0xfffffff0069337f4). iOS turns it off when the PMU driver starts
+ * and the touch driver turns it on.
+ */
+static const struct regulator_desc apple_antigua_touch_core = {
+	.name = "antigua-touch-core",
+	.ops = &apple_pmic_touch_regulator_ops,
+	.type = REGULATOR_VOLTAGE,
+	.owner = THIS_MODULE,
+	.enable_reg = 0x319,
+	.enable_mask = 0x01,
+	.enable_val = 0x01,
+	.disable_val = 0,
+	.enable_time = 1000,
+	.off_on_delay = 1000,
+};
+
 /*
  * Angel (D2365, iPad 5) pmuL(0x21f): LDO index 31, enable-only, through
  * register 0x31c bit 0 (iOS 0xfffffff006bbe488, 0xfffffff006bbe388,
@@ -237,6 +256,10 @@ static const struct of_device_id apple_pmic_touch_regulator_of_match[] = {
 		.compatible = "apple,adelyn-touch-core-regulator",
 		.data = &apple_adelyn_touch_core,
 	},
+	{
+		.compatible = "apple,antigua-touch-core-regulator",
+		.data = &apple_antigua_touch_core,
+	},
 	{
 		.compatible = "apple,angel-touch-analog-regulator",
 		.data = &apple_angel_touch_analog,
