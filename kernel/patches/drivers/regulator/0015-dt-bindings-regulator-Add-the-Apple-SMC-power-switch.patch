From ebce5b02576e31a1f1d4d2bc7afd97d8f05c54a6 Mon Sep 17 00:00:00 2001
From: Dugs <dugahol@protonmail.com>
Date: Thu, 26 Nov 2026 20:57:15 +1030
Subject: [PATCH 1/6] dt-bindings: regulator: Add the Apple SMC power switches

On the A11 iPhones the SMC switches some peripheral supplies on and off.
Describe them as a child of the SMC; the compatible selects which
supplies the SMC firmware has, and each one is a child node named after
it.

Assisted-by: LLM
Signed-off-by: Dugs <dugahol@protonmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../devicetree/bindings/mfd/apple,smc.yaml    |  3 ++
 .../regulator/apple,smc-regulator.yaml        | 45 +++++++++++++++++++
 2 files changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/apple,smc-regulator.yaml

diff --git a/Documentation/devicetree/bindings/mfd/apple,smc.yaml b/Documentation/devicetree/bindings/mfd/apple,smc.yaml
index 1670225..0322c11 100644
--- a/Documentation/devicetree/bindings/mfd/apple,smc.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,smc.yaml
@@ -59,6 +59,9 @@ properties:
   hwmon:
     $ref: /schemas/hwmon/apple,smc-hwmon.yaml
 
+  regulators:
+    $ref: /schemas/regulator/apple,smc-regulator.yaml
+
 additionalProperties: false
 
 required:
diff --git a/Documentation/devicetree/bindings/regulator/apple,smc-regulator.yaml b/Documentation/devicetree/bindings/regulator/apple,smc-regulator.yaml
new file mode 100644
index 0000000..bbe4745
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/apple,smc-regulator.yaml
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/apple,smc-regulator.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SMC power switches
+
+maintainers:
+  - Dugs <dugahol@protonmail.com>
+
+description:
+  On the A11 iPhones the SMC switches some peripheral supplies on and off.
+  Which supplies exist depends on the SMC firmware, so the compatible
+  selects them; each one is described by a child node named after it.
+
+properties:
+  compatible:
+    const: apple,t8015-smc-regulator
+
+patternProperties:
+  "^mesa-(1v8|3v0)$":
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description: Touch ID sensor 1.8 V and 3 V supplies
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    regulators {
+      compatible = "apple,t8015-smc-regulator";
+
+      mesa-1v8 {
+        regulator-name = "mesa-1v8";
+      };
+
+      mesa-3v0 {
+        regulator-name = "mesa-3v0";
+      };
+    };
-- 
