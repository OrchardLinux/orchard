From: brkosebay <brkosebay@users.noreply.github.com>
Date: Sun, 08 Nov 2026 16:00:00 +0100
Subject: [PATCH] pmdomain: apple: Warm Restart evidence, reset guard and pristine DT

Preserve warm power-domain holds and the ADBE boot framebuffer, add bounded shutdown checkpoints and the cold-reset guard, and retain a correctly mapped ramoops reservation across kexec. Embed per-board pristine DTBs in the matching initrd and archive the actual running boot's pristine tree before updates replace its files. Kernel/module/BLS pairing must remain explicit; DFU is known to erase the retained logs. The new Orchard cold-baseline and three-hop ladder is pending.

Integration fixups are folded into the final delta. Device observations apply
to the integration build; the isolated topic requires qualification.

Assisted-by: LLM
---

diff --git a/drivers/pmdomain/apple/pmgr-pwrstate.c b/drivers/pmdomain/apple/pmgr-pwrstate.c
index 0ae0eda2d..38f705973 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate.c
@@ -60,12 +60,23 @@ struct apple_pmgr_ps {
 	u32 min_state;
 	bool has_genpd;
 	bool manual_pm;
+	bool warm;
+	bool keep_on;
 };
 
 #define genpd_to_apple_pmgr_ps(_genpd) container_of(_genpd, struct apple_pmgr_ps, genpd)
 #define rcdev_to_apple_pmgr_ps(_rcdev) container_of(_rcdev, struct apple_pmgr_ps, rcdev)
 #define clk_hw_to_apple_pmgr_gate(_hw) container_of(_hw, struct apple_pmgr_gate, hw)
 
+/* release6/release9: inherited J71t firmware is not a cold reset baseline. */
+static bool kexec_keep_on = true;
+
+static int __init apple_pmgr_keep_on_setup(char *arg)
+{
+	return kstrtobool(arg, &kexec_keep_on);
+}
+early_param("apple_pmgr.kexec_keep_on", apple_pmgr_keep_on_setup);
+
 static int apple_pmgr_ps_set(struct apple_pmgr_ps *ps, u32 pstate, bool auto_enable)
 {
 	int ret;
@@ -85,17 +96,21 @@ static int apple_pmgr_ps_set(struct apple_pmgr_ps *ps, u32 pstate, bool auto_ena
 
 	dev_dbg(ps->dev, "PS %s: pwrstate = 0x%x: 0x%x\n", ps->name, pstate, reg);
 
-	regmap_write(ps->regmap, ps->offset, reg);
+	ret = regmap_write(ps->regmap, ps->offset, reg);
+	if (ret)
+		return ret;
 
 	ret = regmap_read_poll_timeout_atomic(
 		ps->regmap, ps->offset, reg,
 		(FIELD_GET(APPLE_PMGR_PS_ACTUAL, reg) == pstate), 1,
 		APPLE_PMGR_PS_SET_TIMEOUT);
-	if (ret < 0)
+	if (ret < 0) {
 		dev_err(ps->dev, "PS %s: Failed to reach power state 0x%x (now: 0x%x)\n",
 			ps->name, pstate, reg);
+		return ret;
+	}
 
-	if (auto_enable) {
+	if (auto_enable && !ps->keep_on) {
 		/* Not all devices implement this; this is a no-op where not implemented. */
 		reg &= ~APPLE_PMGR_FLAGS;
 		reg |= APPLE_PMGR_AUTO_ENABLE;
@@ -138,6 +153,9 @@ static int apple_pmgr_ps_power_off(struct generic_pm_domain *genpd)
 	unsigned long flags;
 	int ret;
 
+	if (ps->keep_on)
+		return -EBUSY;
+
 	spin_lock_irqsave(&ps->lock, flags);
 	ret = apple_pmgr_ps_set(ps, APPLE_PMGR_PS_PWRGATE, false);
 	spin_unlock_irqrestore(&ps->lock, flags);
@@ -170,6 +188,10 @@ static void apple_pmgr_clk_disable(struct clk_hw *hw)
 	unsigned long flags;
 	int ret;
 
+	/* The lab has no separate clk gate sharing this power-state word. */
+	if (ps->keep_on)
+		return;
+
 	spin_lock_irqsave(&ps->lock, flags);
 	ret = apple_pmgr_ps_set(ps, gate->off_state, false);
 	spin_unlock_irqrestore(&ps->lock, flags);
@@ -308,6 +330,10 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 		return ret;
 	}
 
+	ps->warm = of_device_is_compatible(node, "apple,s8000-pmgr-pwrstate") &&
+		of_property_read_bool(of_chosen, "linux,booted-from-kexec");
+	ps->keep_on = ps->warm && kexec_keep_on;
+	ps->manual_pm = of_property_read_bool(node, "apple,manual-pm");
 	clock_only = of_property_read_bool(node, "apple,clock-gate-only");
 	if (!clock_only) {
 		ps->genpd.flags |= GENPD_FLAG_IRQ_SAFE;
@@ -317,12 +343,17 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 	}
 
 	ret = of_property_read_u32(node, "apple,min-state", &ps->min_state);
-	if (ret == 0 && ps->min_state <= APPLE_PMGR_PS_ACTIVE)
+	if (ret == 0 && ps->min_state <= APPLE_PMGR_PS_ACTIVE &&
+	    !(ps->warm && ps->manual_pm))
 		regmap_update_bits(regmap, ps->offset, APPLE_PMGR_FLAGS | APPLE_PMGR_PS_MIN,
 				   FIELD_PREP(APPLE_PMGR_PS_MIN, ps->min_state));
 
 	active = apple_pmgr_ps_is_active(ps);
-	ps->manual_pm = of_property_read_bool(node, "apple,manual-pm");
+	if (ps->warm && active && !ps->manual_pm) {
+		ret = apple_pmgr_ps_set(ps, APPLE_PMGR_PS_ACTIVE, false);
+		if (ret)
+			return ret;
+	}
 	if (!clock_only && of_property_read_bool(node, "apple,always-on")) {
 		ps->genpd.flags |= GENPD_FLAG_ALWAYS_ON;
 		if (!active) {
@@ -333,7 +364,7 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 	}
 
 	/* Turn on auto-PM if the domain is already on */
-	if (active)
+	if (active && !ps->warm)
 		regmap_update_bits(regmap, ps->offset, APPLE_PMGR_FLAGS | APPLE_PMGR_AUTO_ENABLE,
 				   ps->manual_pm ? 0 : APPLE_PMGR_AUTO_ENABLE);
 
