From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 23 Nov 2026 22:53:39 +0800
Subject: [PATCH] dt-bindings: usb: Add the Apple A7 HSIC Wi-Fi radio

The A7 iPads have their BCM43241 on an HSIC link, and where it sits is
board wiring: Apple's device trees put it on EHCI0 root port 3 behind
the HSIC PHY at usb-complex +0x50 on the iPad Air (J71, J72, J73), and
on EHCI1 root port 1 behind the PHY at +0x60 on the iPad mini 2 and 3
(J85, J86, J87, J85m, J86m, J87m), with HOST_READY on GPIO 163,
DEVICE_READY on GPIO 164 and the reset on the PMIC's GPIO3 on all of
them (/arm-io/usb-complex/usb-ehciN/wlan, iOS 12.5.7 and 12.5.8).

Describe that wiring, so that the transport driver takes it from the
device tree instead of from a table of boards.

Assisted-by: LLM
---
 .../usb/apple,s5l8960x-hsic-wlan.yaml         | 89 +++++++++++++++++++
 1 file changed, 89 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/apple,s5l8960x-hsic-wlan.yaml

diff --git a/Documentation/devicetree/bindings/usb/apple,s5l8960x-hsic-wlan.yaml b/Documentation/devicetree/bindings/usb/apple,s5l8960x-hsic-wlan.yaml
new file mode 100644
index 000000000..ed0ac5230
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/apple,s5l8960x-hsic-wlan.yaml
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/apple,s5l8960x-hsic-wlan.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple A7 HSIC Wi-Fi radio
+
+maintainers:
+  - Henrik Klee <henrik@goat-code.com>
+
+description: |
+  The Apple A7 (S5L8960X) iPads have a Broadcom BCM43241 Wi-Fi radio on
+  an HSIC link: an EHCI root port behind its own HSIC PHY. The node
+  describes that wiring, as Apple's device tree does in
+  /arm-io/usb-complex/usb-ehciN/wlan, for the driver that owns the PHY,
+  the radio's reset and HOST_READY, and the EHCI port. The radio's reset
+  is the PMIC's GPIO3 on every board.
+
+properties:
+  compatible:
+    const: apple,s5l8960x-hsic-wlan
+
+  reg:
+    items:
+      - description: HSIC PHY control (+0) and configuration (+8)
+      - description: EHCI controller the radio is attached to
+
+  reg-names:
+    items:
+      - const: phy
+      - const: ehci
+
+  interrupts:
+    maxItems: 1
+    description: The EHCI controller's interrupt
+
+  power-domains:
+    maxItems: 1
+    description:
+      The HSIC PHY power state; its parent is the EHCI controller's.
+
+  apple,ehci-port:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    description: The EHCI root port of the radio
+
+  host-ready-gpios:
+    maxItems: 1
+    description: HOST_READY, driven by the host
+
+  device-ready-gpios:
+    maxItems: 1
+    description: DEVICE_READY, driven by the radio
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - power-domains
+  - apple,ehci-port
+  - host-ready-gpios
+  - device-ready-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        wifi@20c000050 {
+            compatible = "apple,s5l8960x-hsic-wlan";
+            reg = <0x2 0x0c000050 0x0 0x10>, <0x2 0x0c200000 0x0 0x10000>;
+            reg-names = "phy", "ehci";
+            interrupt-parent = <&aic>;
+            interrupts = <AIC_IRQ 163 IRQ_TYPE_LEVEL_HIGH>;
+            power-domains = <&ps_hsic1_phy>;
+            apple,ehci-port = <3>;
+            host-ready-gpios = <&pinctrl 163 GPIO_ACTIVE_HIGH>;
+            device-ready-gpios = <&pinctrl 164 GPIO_ACTIVE_HIGH>;
+        };
+    };
