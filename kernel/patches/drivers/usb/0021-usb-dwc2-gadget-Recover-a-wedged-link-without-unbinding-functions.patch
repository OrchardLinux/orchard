From 798a92befd7662f3386ef42ae57eff6090daeed3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Mon, 16 Nov 2026 17:06:12 +0100
Subject: [PATCH] usb: dwc2: gadget: Recover a wedged link without unbinding
 functions

Handshake failures or a PHY clock gated outside suspend can leave a
configured gadget mute until userspace rebinds it. Queue a rate-limited
soft disconnect, wait 500 ms, core-reset and reconnect without changing
gadget functions, network interfaces or strings. Cancel stale recovery
across new sessions, and exclude IRQ re-arms during stop, suspend and
removal. A two-second watchdog catches a gated non-L2 link; the
ambiguous gated-L2/bus-active trigger remains opt-in. Back off for ten
minutes after three recoveries in a ten-minute window.

Assisted-by: LLM
---
 drivers/usb/dwc2/core.h   |  12 +++
 drivers/usb/dwc2/gadget.c | 161 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 173 insertions(+)

diff --git a/drivers/usb/dwc2/core.h b/drivers/usb/dwc2/core.h
index c73e8b4..b4bca5e 100644
--- a/drivers/usb/dwc2/core.h
+++ b/drivers/usb/dwc2/core.h
@@ -1242,6 +1242,16 @@ struct dwc2_hsotg {
 	unsigned int connected:1;
 	unsigned int stop_timeouts; /* endpoint stop/flush handshake failures */
 	bool in_teardown;
+	struct delayed_work recover_work;
+	struct delayed_work watch_work;
+	const char *recover_reason;
+	unsigned long recover_last;
+	unsigned long recover_window;
+	unsigned int recover_count;
+	unsigned int recover_burst;
+	unsigned int watch_strikes;
+	bool recovering;
+	bool recovery_stopping; /* exclude IRQ re-arm during synchronous cancellation */
 	unsigned int remote_wakeup_allowed:1;
 	struct dwc2_hsotg_ep *eps_in[MAX_EPS_CHANNELS];
 	struct dwc2_hsotg_ep *eps_out[MAX_EPS_CHANNELS];
@@ -1458,6 +1468,7 @@ int dwc2_gadget_exit_hibernation(struct dwc2_hsotg *hsotg,
 int dwc2_gadget_enter_partial_power_down(struct dwc2_hsotg *hsotg);
 int dwc2_gadget_exit_partial_power_down(struct dwc2_hsotg *hsotg,
 					bool restore);
+void dwc2_gadget_request_recovery(struct dwc2_hsotg *hsotg, const char *why);
 bool dwc2_gadget_ungate_clock(struct dwc2_hsotg *hsotg);
 void dwc2_gadget_leave_gating(struct dwc2_hsotg *hsotg, const char *where);
 void dwc2_gadget_enter_clock_gating(struct dwc2_hsotg *hsotg);
@@ -1507,6 +1518,7 @@ static inline int dwc2_gadget_enter_partial_power_down(struct dwc2_hsotg *hsotg)
 static inline int dwc2_gadget_exit_partial_power_down(struct dwc2_hsotg *hsotg,
 						      bool restore)
 { return 0; }
+static inline void dwc2_gadget_request_recovery(struct dwc2_hsotg *hsotg, const char *why) {}
 static inline bool dwc2_gadget_ungate_clock(struct dwc2_hsotg *hsotg) { return false; }
 static inline void dwc2_gadget_leave_gating(struct dwc2_hsotg *hsotg, const char *where) {}
 static inline void dwc2_gadget_enter_clock_gating(struct dwc2_hsotg *hsotg) {}
diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
index 85367da..1c4265d 100644
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -34,6 +34,144 @@
 #include "core.h"
 #include "hw.h"
 
+#define DWC2_RECOVER_DELAY_MS 1000
+#define DWC2_RECOVER_DETACH_MS 500
+#define DWC2_RECOVER_MIN_INTERVAL (30 * HZ)
+#define DWC2_RECOVER_BACKOFF (600 * HZ)
+#define DWC2_WATCH_MS 2000
+
+static bool recover_gated_active;
+module_param(recover_gated_active, bool, 0644);
+MODULE_PARM_DESC(recover_gated_active,
+		 "Recover a gated L2 gadget with DSTS.SUSPSTS clear for three samples (default false)");
+
+/* All callers below hold hsotg->lock. */
+static bool dwc2_gadget_can_recover(struct dwc2_hsotg *hsotg)
+{
+	return hsotg->driver && hsotg->enabled && !hsotg->role_sw_hold &&
+	       !hsotg->recovering && !hsotg->recovery_stopping &&
+	       hsotg->op_state == OTG_STATE_B_PERIPHERAL;
+}
+
+void dwc2_gadget_request_recovery(struct dwc2_hsotg *hsotg, const char *why)
+{
+	if (!dwc2_gadget_can_recover(hsotg))
+		return;
+	hsotg->recover_reason = why;
+	mod_delayed_work(system_wq, &hsotg->recover_work,
+			 msecs_to_jiffies(DWC2_RECOVER_DELAY_MS));
+}
+
+static void dwc2_gadget_recover_work(struct work_struct *work)
+{
+	struct dwc2_hsotg *hsotg = container_of(to_delayed_work(work),
+						struct dwc2_hsotg, recover_work);
+	unsigned long flags, now, interval;
+	unsigned int gen;
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	if (!dwc2_gadget_can_recover(hsotg) ||
+	    !(dwc2_readl(hsotg, GOTGCTL) & GOTGCTL_BSESVLD)) {
+		hsotg->stop_timeouts = 0;
+		goto out;
+	}
+	now = jiffies;
+	interval = hsotg->recover_burst >= 3 ? DWC2_RECOVER_BACKOFF :
+		   DWC2_RECOVER_MIN_INTERVAL;
+	if (hsotg->recover_count && time_before(now, hsotg->recover_last + interval)) {
+		mod_delayed_work(system_wq, &hsotg->recover_work,
+				 hsotg->recover_last + interval - now);
+		goto out;
+	}
+	if (!hsotg->recover_burst ||
+	    time_after_eq(now, hsotg->recover_window + DWC2_RECOVER_BACKOFF)) {
+		hsotg->recover_window = now;
+		hsotg->recover_burst = 0;
+	}
+	hsotg->recover_burst++;
+	hsotg->recovering = true;
+	hsotg->recover_last = now;
+	dev_warn(hsotg->dev,
+		 "gadget recovery %u (%s): soft disconnect, core reset, reconnect\n",
+		 ++hsotg->recover_count, hsotg->recover_reason);
+	if (dwc2_gadget_ungate_clock(hsotg))
+		hsotg->bus_suspended = false;
+	dwc2_hsotg_disconnect(hsotg);
+	dwc2_hsotg_core_disconnect(hsotg);
+	hsotg->gadget.speed = USB_SPEED_UNKNOWN;
+	gen = ++hsotg->session_gen;
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+	msleep(DWC2_RECOVER_DETACH_MS);
+	spin_lock_irqsave(&hsotg->lock, flags);
+	if (hsotg->driver && hsotg->enabled && !hsotg->role_sw_hold &&
+	    !hsotg->recovery_stopping && hsotg->session_gen == gen &&
+	    hsotg->op_state == OTG_STATE_B_PERIPHERAL &&
+	    (dwc2_readl(hsotg, GOTGCTL) & GOTGCTL_BSESVLD)) {
+		dwc2_hsotg_core_init_disconnected(hsotg, false);
+		dwc2_enable_acg(hsotg);
+		dwc2_hsotg_core_connect(hsotg);
+	}
+	hsotg->stop_timeouts = 0;
+	hsotg->recovering = false;
+out:
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+}
+
+static void dwc2_gadget_watch_work(struct work_struct *work)
+{
+	struct dwc2_hsotg *hsotg = container_of(to_delayed_work(work),
+						struct dwc2_hsotg, watch_work);
+	static const char * const gated_lx[] = {
+		"PHY clock gated while L0", "PHY clock gated while L1",
+		"PHY clock gated while L2", "PHY clock gated while L3",
+	};
+	unsigned long flags;
+	u32 pcgctl;
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	if (!hsotg->connected || hsotg->recovery_stopping ||
+	    !hsotg->driver || !hsotg->enabled || hsotg->role_sw_hold ||
+	    hsotg->op_state != OTG_STATE_B_PERIPHERAL)
+		goto out;
+	if (hsotg->in_ppd || hsotg->hibernated)
+		goto rearm;
+	pcgctl = dwc2_readl(hsotg, PCGCTL);
+	if ((pcgctl & PCGCTL_STOPPCLK) && hsotg->lx_state != DWC2_L2) {
+		const char *why = hsotg->lx_state < ARRAY_SIZE(gated_lx) ?
+			gated_lx[hsotg->lx_state] : "PHY clock gated while not L2";
+
+		if (dwc2_gadget_ungate_clock(hsotg))
+			hsotg->bus_suspended = false;
+		hsotg->watch_strikes = 0;
+		dwc2_gadget_request_recovery(hsotg, why);
+	} else if (READ_ONCE(recover_gated_active) && (pcgctl & PCGCTL_STOPPCLK) &&
+		   hsotg->lx_state == DWC2_L2 && !(dwc2_readl(hsotg, DSTS) & DSTS_SUSPSTS)) {
+		if (++hsotg->watch_strikes >= 3) {
+			hsotg->watch_strikes = 0;
+			dwc2_gadget_request_recovery(hsotg, "gated while the bus is active");
+		}
+	} else {
+		hsotg->watch_strikes = 0;
+	}
+rearm:
+	mod_delayed_work(system_wq, &hsotg->watch_work, msecs_to_jiffies(DWC2_WATCH_MS));
+out:
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+}
+
+/* Block IRQ re-arms before cancelling; never wait while holding the lock. */
+static void dwc2_gadget_cancel_recovery(struct dwc2_hsotg *hsotg)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	hsotg->recovery_stopping = true;
+	hsotg->session_gen++;
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+	cancel_delayed_work_sync(&hsotg->recover_work);
+	cancel_delayed_work_sync(&hsotg->watch_work);
+}
+
 /* conversion functions */
 static inline struct dwc2_hsotg_req *our_req(struct usb_request *req)
 {
@@ -310,6 +448,8 @@ int dwc2_hsotg_tx_fifo_average_depth(struct dwc2_hsotg *hsotg)
 static void dwc2_hsotg_stop_timeout(struct dwc2_hsotg *hsotg)
 {
 	hsotg->stop_timeouts++;
+	if (!hsotg->in_teardown && hsotg->connected)
+		dwc2_gadget_request_recovery(hsotg, "endpoint stop timed out");
 }
 
 static void dwc2_hsotg_init_fifo(struct dwc2_hsotg *hsotg)
@@ -3291,6 +3431,9 @@ static void dwc2_hsotg_irq_enumdone(struct dwc2_hsotg *hsotg)
 	/* ensure after enumeration our EP0 is active */
 
 	dwc2_hsotg_enqueue_setup(hsotg);
+	if (!hsotg->recovery_stopping)
+		mod_delayed_work(system_wq, &hsotg->watch_work,
+				 msecs_to_jiffies(DWC2_WATCH_MS));
 
 	dev_dbg(hsotg->dev, "EP0: DIEPCTL0=0x%08x, DOEPCTL0=0x%08x\n",
 		dwc2_readl(hsotg, DIEPCTL0),
@@ -3340,6 +3483,8 @@ void dwc2_hsotg_disconnect(struct dwc2_hsotg *hsotg)
 	unsigned int ep;
 	bool was_teardown = hsotg->in_teardown;
 
+	cancel_delayed_work(&hsotg->watch_work);
+	hsotg->watch_strikes = 0;
 	if (!hsotg->connected)
 		return;
 	if (dwc2_gadget_ungate_clock(hsotg))
@@ -3778,6 +3923,7 @@ irq_retry:
 	if (gintsts & (GINTSTS_USBRST | GINTSTS_RESETDET)) {
 		u32 usb_status = dwc2_readl(hsotg, GOTGCTL);
 		u32 connected = hsotg->connected;
+		unsigned int stop_timeouts = hsotg->stop_timeouts;
 		enum dwc2_lx_state lx = hsotg->lx_state;
 
 		dev_dbg(hsotg->dev, "%s: USBRst\n", __func__);
@@ -3811,6 +3957,8 @@ irq_retry:
 		 */
 		if (usb_status & GOTGCTL_BSESVLD && (connected || lx != DWC2_L0))
 			dwc2_hsotg_core_init_disconnected(hsotg, true);
+		if (hsotg->stop_timeouts > stop_timeouts)
+			dwc2_gadget_request_recovery(hsotg, "reset teardown timed out");
 		if (lx != DWC2_L0)
 			dev_info_ratelimited(hsotg->dev,
 					     "USB reset in L%d (connected %u, B-session %s): EP0 re-armed\n",
@@ -4623,6 +4771,7 @@ static int dwc2_hsotg_udc_start(struct usb_gadget *gadget,
 		otg_set_peripheral(hsotg->uphy->otg, &hsotg->gadget);
 
 	spin_lock_irqsave(&hsotg->lock, flags);
+	hsotg->recovery_stopping = false;
 	if (dwc2_hw_is_device(hsotg)) {
 		dwc2_hsotg_init(hsotg);
 		dwc2_hsotg_core_init_disconnected(hsotg, false);
@@ -4656,6 +4805,7 @@ static int dwc2_hsotg_udc_stop(struct usb_gadget *gadget)
 	if (!hsotg)
 		return -ENODEV;
 
+	dwc2_gadget_cancel_recovery(hsotg);
 	/* Exit clock gating when driver is stopped. */
 	spin_lock_irqsave(&hsotg->lock, flags);
 	dwc2_gadget_leave_gating(hsotg, "udc stop");
@@ -4751,6 +4901,7 @@ static int dwc2_hsotg_pullup(struct usb_gadget *gadget, int is_on)
 		}
 	}
 	if (is_on) {
+		hsotg->session_gen++;
 		hsotg->enabled = 1;
 		dwc2_hsotg_core_init_disconnected(hsotg, false);
 		/* Enable ACG feature in device mode,if supported */
@@ -4793,6 +4944,7 @@ static int dwc2_hsotg_vbus_session(struct usb_gadget *gadget, int is_active)
 		dwc2_exit_partial_power_down(hsotg, 0, false);
 
 	if (is_active) {
+		hsotg->session_gen++;
 		hsotg->op_state = OTG_STATE_B_PERIPHERAL;
 
 		dwc2_hsotg_core_init_disconnected(hsotg, false);
@@ -5115,6 +5267,8 @@ int dwc2_gadget_init(struct dwc2_hsotg *hsotg)
 	int epnum;
 	int ret;
 
+	INIT_DELAYED_WORK(&hsotg->recover_work, dwc2_gadget_recover_work);
+	INIT_DELAYED_WORK(&hsotg->watch_work, dwc2_gadget_watch_work);
 	/* Dump fifo information */
 	dev_dbg(dev, "NonPeriodic TXFIFO size: %d\n",
 		hsotg->params.g_np_tx_fifo_size);
@@ -5238,6 +5392,7 @@ int dwc2_gadget_init(struct dwc2_hsotg *hsotg)
  */
 int dwc2_hsotg_remove(struct dwc2_hsotg *hsotg)
 {
+	dwc2_gadget_cancel_recovery(hsotg);
 	usb_del_gadget_udc(&hsotg->gadget);
 	if (hsotg->usb_psy_name) {
 		if (IS_ERR_OR_NULL(hsotg->uphy))
@@ -5254,6 +5409,7 @@ int dwc2_hsotg_suspend(struct dwc2_hsotg *hsotg)
 {
 	unsigned long flags;
 
+	dwc2_gadget_cancel_recovery(hsotg);
 	if (hsotg->lx_state != DWC2_L0)
 		return 0;
 
@@ -5285,6 +5441,11 @@ int dwc2_hsotg_resume(struct dwc2_hsotg *hsotg)
 {
 	unsigned long flags;
 
+	spin_lock_irqsave(&hsotg->lock, flags);
+	hsotg->recovery_stopping = false;
+	if (hsotg->connected)
+		mod_delayed_work(system_wq, &hsotg->watch_work, msecs_to_jiffies(DWC2_WATCH_MS));
+	spin_unlock_irqrestore(&hsotg->lock, flags);
 	if (hsotg->lx_state == DWC2_L2)
 		return 0;
 
