From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Martins <eduardo@martins.ws>
Date: Thu, 5 Nov 2026 14:30:14 -0600
Subject: [PATCH] dt-bindings: leds: backlight: Add the Apple OLED DSI
 brightness

The OLED iPhones set their panel's brightness with the MIPI DCS command
0x51 through the SoC's DSI host, not with a DWI backlight controller: the
iPhone X ADT's backlight functions (blkU, bklE) point at the lcd node
under mipi-dsim, with backlight-level-encoding 11, DBVMin 139 and DBVMax
2047.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/leds/backlight/apple,dsi-bl.yaml | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/leds/backlight/apple,dsi-bl.yaml

diff --git a/Documentation/devicetree/bindings/leds/backlight/apple,dsi-bl.yaml b/Documentation/devicetree/bindings/leds/backlight/apple,dsi-bl.yaml
new file mode 100644
index 000000000..e950b858a
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/backlight/apple,dsi-bl.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/backlight/apple,dsi-bl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple OLED panel brightness over the MIPI DSI host
+
+maintainers:
+  - Eduardo Martins <eduardo@martins.ws>
+
+description:
+  The OLED iPhones have no DWI backlight controller. iOS sets their panel's
+  brightness with the MIPI DCS "set display brightness" command (0x51) and an
+  11-bit display brightness value, sent through the SoC's Synopsys
+  DesignWare MIPI DSI host while the display runs in video mode. The node
+  takes the host's command registers; the ADT's backlight node gives the
+  value range (DBVMin, DBVMax) and the boot level.
+
+allOf:
+  - $ref: common.yaml#
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - apple,t8015-dsi-bl
+      - const: apple,dsi-bl
+
+  reg:
+    maxItems: 1
+    description: The DSI host's register window.
+
+  power-domains:
+    maxItems: 1
+
+  max-brightness:
+    maximum: 2047
+
+  apple,min-dbv:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 2047
+    description:
+      The lowest display brightness value the panel takes (the ADT's
+      DBVMin); lower levels are raised to it.
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    soc {
+      #address-cells = <2>;
+      #size-cells = <2>;
+
+      backlight@218400000 {
+        compatible = "apple,t8015-dsi-bl", "apple,dsi-bl";
+        reg = <0x2 0x18400000 0x0 0x100>;
+        power-domains = <&ps_mipi_dsi>;
+        max-brightness = <2047>;
+        apple,min-dbv = <139>;
+        default-brightness-level = <740>;
+      };
+    };
