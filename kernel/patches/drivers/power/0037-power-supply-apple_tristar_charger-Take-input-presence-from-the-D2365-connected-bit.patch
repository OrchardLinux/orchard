From 5a8b3d0fc34852e3bb88ae374904a27ce2ab1b13 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 17 Nov 2026 17:48:39 +0100
Subject: [PATCH] power: supply: apple_tristar_charger: Take input presence
 from the D2365 connected bit

The charger treated D2365 status 0x18a == 0 as a lost input. 0x18a is the
battery charger's status, and it also reads 0 while the charger pauses with
the input still there. Behind the powered Lightning camera adapter it
alternated between 0x40 and 0 every 100-300 ms during the input-current
ramp, while 0x189 bit 0 stayed set. Each 0 withdrew the grant to 100 mA and
restarted the ramp, so the input limit cycled for seconds after host mode
was entered.

iOS 16 decides presence from 0x189 alone (AppleD2365PMUPowerSource): bit 0
is "connected", and a new connection also needs bit 1. Do the same on boards
with this PMIC, selected by match data; other boards keep the nonzero 0x18a
rule. An unreadable 0x189 keeps the last decision. A real unplug clears
0x189 bit 0 and still ends the grant through the existing debounce.

Assisted-by: LLM
---
 drivers/power/supply/apple_tristar_charger.c | 49 +++++++++++++++++---
 1 file changed, 42 insertions(+), 7 deletions(-)

diff --git a/drivers/power/supply/apple_tristar_charger.c b/drivers/power/supply/apple_tristar_charger.c
index e200400..e81ffae 100644
--- a/drivers/power/supply/apple_tristar_charger.c
+++ b/drivers/power/supply/apple_tristar_charger.c
@@ -58,6 +58,9 @@
 #include "apple_tristar_accessory.h"
 
 /* PMIC registers, relative to their banks */
+#define TRISTAR_CHG_CONNECTED		0x09	/* status bank */
+#define TRISTAR_CHG_CONNECTED_NOW	BIT(0)
+#define TRISTAR_CHG_CONNECTED_NEW	BIT(1)
 #define TRISTAR_CHG_STATUS		0x0a	/* status bank */
 #define TRISTAR_CHG_INPUT_LIMIT		0x03	/* control bank */
 #define TRISTAR_CHG_ADC_SELECT		0x00	/* ADC bank */
@@ -121,8 +124,19 @@ enum cbtl_route {
 	CBTL_ROUTE_UART2,
 };
 
+/**
+ * struct tristar_board - what differs between the boards' PMICs
+ * @plug_event: the PMU event that latches on every plug and unplug
+ * @connected_bit: input presence is the PMIC's connected bit (D2365 0x189)
+ */
+struct tristar_board {
+	unsigned int plug_event;
+	bool connected_bit;
+};
+
 struct tristar_charger {
 	struct device *dev;
+	const struct tristar_board *board;	/* NULL: the defaults */
 	struct regmap *regmap;
 	struct i2c_client *tristar;
 	struct power_supply *psy;
@@ -1043,10 +1057,27 @@ static void tristar_follow_accessory(struct tristar_charger *chg, u64 now)
  * backs off only when the PMIC reports input limiting, which the D2365 never
  * does. A charger that finished, timed out or does not charge still runs the
  * system from the source, so any nonzero value keeps the grant.
+ *
+ * iOS takes presence itself from 0x189 alone: bit 0 is "connected", and a new
+ * connection also needs bit 1. 0x18a can read 0 while the input is still
+ * there: behind the powered camera adapter it alternated between 0x40 and 0
+ * every 100-300 ms during the ramp while 0x189 bit 0 stayed set, and each 0
+ * dropped the limit back to 100 mA. Boards with this PMIC say so in their
+ * match data. An unreadable 0x189 says nothing: keep the last decision.
  */
-static bool tristar_input_present(unsigned int status)
+static bool tristar_input_present(struct tristar_charger *chg, unsigned int status)
 {
-	return status != 0;
+	unsigned int connected;
+
+	if (!chg->board || !chg->board->connected_bit)
+		return status != 0;
+	if (regmap_read(chg->regmap, chg->status_base + TRISTAR_CHG_CONNECTED, &connected)) {
+		dev_err_ratelimited(chg->dev, "PMIC connection state unreadable\n");
+		return chg->online;
+	}
+	if (!(connected & TRISTAR_CHG_CONNECTED_NOW))
+		return false;
+	return chg->present || (connected & TRISTAR_CHG_CONNECTED_NEW);
 }
 
 static void tristar_poll(struct work_struct *work)
@@ -1068,7 +1099,7 @@ static void tristar_poll(struct work_struct *work)
 		dev_err_ratelimited(chg->dev, "PMIC status unreadable; holding the fallback\n");
 		goto again;
 	}
-	chg->online = tristar_input_present(status);
+	chg->online = tristar_input_present(chg, status);
 	if (!chg->online) {
 		/* The hold of the next attachment starts when input returns. */
 		chg->hold_ns = now;
@@ -1473,8 +1504,8 @@ static int tristar_probe(struct platform_device *pdev)
 	if (ret <= TRISTAR_IRQ_SOURCE || ret > TRISTAR_IRQS_MAX)
 		return dev_err_probe(dev, -EINVAL,
 				     "expected PMU line, ADC and source event interrupts\n");
-	chg->plug_event = device_get_match_data(dev) ?
-		*(const unsigned int *)device_get_match_data(dev) : TRISTAR_EVENT_PLUG;
+	chg->board = device_get_match_data(dev);
+	chg->plug_event = chg->board ? chg->board->plug_event : TRISTAR_EVENT_PLUG;
 	chg->nirqs = ret;
 	for (i = 0; i < chg->nirqs; i++) {
 		chg->irqs[i] = platform_get_irq(pdev, i);
@@ -1616,10 +1647,14 @@ static int tristar_resume(struct device *dev)
 
 static DEFINE_SIMPLE_DEV_PM_OPS(tristar_pm_ops, tristar_suspend, tristar_resume);
 
-static const unsigned int j71t_plug_event = 0x49;
+/* D2365: iOS reads presence from 0x189 (AppleD2365PMUPowerSource). */
+static const struct tristar_board j71t_board = {
+	.plug_event = 0x49,
+	.connected_bit = true,
+};
 
 static const struct of_device_id tristar_of_match[] = {
-	{ .compatible = "apple,j71t-tristar-charger", .data = &j71t_plug_event },
+	{ .compatible = "apple,j71t-tristar-charger", .data = &j71t_board },
 	{ .compatible = "apple,tristar-charger" },
 	{ }
 };
