From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 15:10:00 +0100
Subject: [PATCH] dt-bindings: power: supply: Add Apple D2186 PMIC battery

Document the read-only battery and USB charger status child node for the
Dialog D2186 PMIC on Apple A8 devices without a standalone fuel-gauge IC
(such as the iPod touch 6, N102), and allow the battery child under the
Apple PMIC MFD binding.

Assisted-by: LLM
Signed-off-by: Berkay Kösebay <brkosebay@users.noreply.github.com>
Link: https://github.com/OrchardLinux/orchard/pull/231#issuecomment-7138590680
---
 .../devicetree/bindings/mfd/apple,pmic.yaml   |  3 +
 .../power/supply/apple,d2186-battery.yaml     | 96 +++++++++++++++++++
 2 files changed, 99 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/apple,d2186-battery.yaml

diff --git a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
index 3a5e7b210..e4910b7cc 100644
--- a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
@@ -72,6 +72,9 @@ patternProperties:
   "^adc(@[0-9a-f]+)?$":
     $ref: /schemas/iio/adc/apple,d2186-adc.yaml
 
+  "^battery(@[0-9a-f]+)?$":
+    $ref: /schemas/power/supply/apple,d2186-battery.yaml
+
   "^rtc(@[0-9a-f]+)?$":
     $ref: /schemas/rtc/apple,pmic-rtc.yaml
 
diff --git a/Documentation/devicetree/bindings/power/supply/apple,d2186-battery.yaml b/Documentation/devicetree/bindings/power/supply/apple,d2186-battery.yaml
new file mode 100644
index 000000000..4b92c6a10
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/apple,d2186-battery.yaml
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,d2186-battery.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple D2186 PMIC battery and charger monitor
+
+maintainers:
+  - Berkay Kösebay <brkosebay@users.noreply.github.com>
+
+description: |
+  Devices such as the Apple iPod touch 6 (N102) have no dedicated fuel-gauge
+  IC. Battery telemetry is sampled through the Dialog D2186 PMIC housekeeping
+  ADC and charging state is read from the PMIC status registers (0x60..0x6d)
+  through the parent Apple I2C PMIC regmap.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: apple,d2186-battery
+
+  io-channels:
+    minItems: 1
+    maxItems: 5
+
+  io-channel-names:
+    minItems: 1
+    maxItems: 5
+    items:
+      enum:
+        - vbat
+        - ich
+        - tbat
+        - vbus
+        - ibus
+
+  monitored-battery: true
+
+required:
+  - compatible
+  - io-channels
+  - io-channel-names
+
+additionalProperties: false
+
+examples:
+  - |
+    bat: battery {
+        compatible = "simple-battery";
+        device-chemistry = "lithium-ion";
+        charge-full-design-microamp-hours = <1080000>;
+        voltage-min-design-microvolt = <3400000>;
+        voltage-max-design-microvolt = <4350000>;
+        ocv-capacity-celsius = <20>;
+        ocv-capacity-table-0 = <4350000 100>, <3840000 50>, <3400000 0>;
+    };
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@74 {
+            compatible = "apple,adi-pmic", "apple,i2c-pmic";
+            reg = <0x74>;
+            #address-cells = <1>;
+            #size-cells = <1>;
+
+            pmu_adc: adc@500 {
+                compatible = "apple,d2186-adc";
+                reg = <0x500 0x24>;
+                #io-channel-cells = <1>;
+            };
+
+            battery {
+                compatible = "apple,d2186-battery";
+                monitored-battery = <&bat>;
+                io-channels = <&pmu_adc 4>,
+                              <&pmu_adc 1>,
+                              <&pmu_adc 2>,
+                              <&pmu_adc 15>,
+                              <&pmu_adc 9>;
+                io-channel-names = "vbat", "ich", "tbat", "vbus", "ibus";
+            };
+        };
+    };
-- 
