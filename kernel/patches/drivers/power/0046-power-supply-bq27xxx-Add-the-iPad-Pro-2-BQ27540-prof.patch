From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Tue, 24 Nov 2026 03:33:48 +0800
Subject: [PATCH] power: supply: bq27xxx: Add the iPad Pro 2 BQ27540 profile

The iPad Pro 12.9 (2017)'s BQ27540 on HDQ uses the BQ27541 register
layout, answers RemainingCapacity but not NominalAvailableCapacity (as
also seen on an iPad Pro 10.5, J208), and reports a cycle count. Read it
through the cached telemetry path with that profile; cache-only becomes a
profile flag besides the BQ27545 default.

A cycle count that fails to read is reported as unavailable instead of
failing the battery's uevent; that also applies to the boards whose
cached profile reads it.

[Orchard: from OrchardLinux/orchard#205 (tompta1, 09038adf),
 kernel/patches/drivers/power/0046 and 0051 squashed. The 5 s refresh read
 budget, the board-named "apple,j120-hdq-uart" w1 binding and the -ENODEV
 for unmatched gauges on parented masters dropped; the gauge compatible
 documented in the existing BQ27545 HDQ binding instead of a new one.]

Assisted-by: LLM
---
 .../bindings/power/supply/ti,bq27545-hdq.yaml |  5 +++
 drivers/power/supply/bq27xxx_battery.c        |  9 ++++--
 drivers/power/supply/bq27xxx_battery_hdq.c    | 31 +++++++++++++++++--
 3 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/supply/ti,bq27545-hdq.yaml b/Documentation/devicetree/bindings/power/supply/ti,bq27545-hdq.yaml
index 9e053cb89..fb5dfde4b 100644
--- a/Documentation/devicetree/bindings/power/supply/ti,bq27545-hdq.yaml
+++ b/Documentation/devicetree/bindings/power/supply/ti,bq27545-hdq.yaml
@@ -15,6 +15,8 @@ description: |
   ROM address, so it is represented as the single child of an HDQ bus.
   D11, D111 and J72 devices use Apple-specific gauge firmware whose
   charge-remaining register set differs from the generic BQ27545 profile.
+  The iPad Pro 2's (J120) BQ27540 answers RemainingCapacity but not
+  NominalAvailableCapacity.
 
 allOf:
   - $ref: power-supply.yaml#
@@ -30,6 +32,9 @@ properties:
               - apple,d111-bq27545
               - apple,j72-bq27545
           - const: ti,bq27545-hdq
+      - items:
+          - const: apple,j120-bq27540
+          - const: ti,bq27540-hdq
 
   power-supplies:
     maxItems: 1
diff --git a/drivers/power/supply/bq27xxx_battery.c b/drivers/power/supply/bq27xxx_battery.c
index 14fb964aa..c85576628 100644
--- a/drivers/power/supply/bq27xxx_battery.c
+++ b/drivers/power/supply/bq27xxx_battery.c
@@ -2169,7 +2169,8 @@ static void bq27xxx_battery_refresh_cache(struct bq27xxx_device_info *di)
 
 	if (bq27xxx_cache_has_prop(di, POWER_SUPPLY_PROP_CYCLE_COUNT)) {
 		ret = bq27xxx_battery_read_cyct(di, &value);
-		bq27xxx_cache_value(&cache.cycle_count, ret, &value);
+		/* Keep optional telemetry errors out of the battery uevent. */
+		bq27xxx_cache_value(&cache.cycle_count, ret ? -ENODATA : 0, &value);
 	}
 
 	if (bq27xxx_cache_has_prop(di, POWER_SUPPLY_PROP_POWER_AVG)) {
@@ -2591,9 +2592,11 @@ int bq27xxx_battery_setup(struct bq27xxx_device_info *di)
 	di->dm_regs    = bq27xxx_chip_data[di->chip].dm_regs;
 	di->opts       = bq27xxx_chip_data[di->chip].opts;
 
-	if (di->cache_only && di->chip != BQ27545)
+	if (di->cache_only && di->chip != BQ27545 &&
+	    (di->chip != BQ27541 || !di->cache_properties ||
+	     !di->num_cache_properties))
 		return dev_err_probe(di->dev, -EINVAL,
-				     "cache-only mode only supports BQ27545\n");
+				     "unsupported or missing battery cache profile\n");
 	if (di->cache_only && !di->cache_properties) {
 		di->cache_properties = bq27545_cache_props;
 		di->num_cache_properties = ARRAY_SIZE(bq27545_cache_props);
diff --git a/drivers/power/supply/bq27xxx_battery_hdq.c b/drivers/power/supply/bq27xxx_battery_hdq.c
index 2bacf7d59..e0b1f0a3d 100644
--- a/drivers/power/supply/bq27xxx_battery_hdq.c
+++ b/drivers/power/supply/bq27xxx_battery_hdq.c
@@ -42,11 +42,26 @@ static const enum power_supply_property bq27545_iphone7_plus_cache_props[] = {
 	POWER_SUPPLY_PROP_MANUFACTURER,
 };
 
+/* RemainingCapacity answers, NominalAvailableCapacity does not. */
+static const enum power_supply_property bq27540_j120_cache_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CYCLE_COUNT,
+};
+
 struct bq27xxx_hdq_data {
 	enum bq27xxx_chip chip;
 	const enum power_supply_property *cache_properties;
 	size_t num_cache_properties;
 	bool use_remaining_capacity;
+	/* Cached telemetry, refreshed periodically (always for the BQ27545) */
+	bool cache_only;
 };
 
 static int w1_bq27000_read(struct w1_slave *sl, unsigned int reg)
@@ -114,8 +129,7 @@ static int bq27xxx_battery_hdq_add_slave(struct w1_slave *sl)
 
 		di->chip = data->chip;
 		di->name = "battery";
-		/* Only the BQ27545 profile needs cached telemetry. */
-		di->cache_only = di->chip == BQ27545;
+		di->cache_only = di->chip == BQ27545 || data->cache_only;
 		di->cache_refresh_ms = di->cache_only ? 30000 : 0;
 		if (data->cache_properties) {
 			di->cache_properties = data->cache_properties;
@@ -176,7 +190,20 @@ static const struct bq27xxx_hdq_data bq27541_data = {
 	.chip = BQ27541,
 };
 
+/*
+ * The iPad Pro 12.9 (2017)'s BQ27540 (ADT gas-gauge): the BQ27541 register
+ * layout, RemainingCapacity instead of NominalAvailableCapacity, cached.
+ */
+static const struct bq27xxx_hdq_data bq27540_j120_data = {
+	.chip = BQ27541,
+	.cache_only = true,
+	.cache_properties = bq27540_j120_cache_props,
+	.num_cache_properties = ARRAY_SIZE(bq27540_j120_cache_props),
+	.use_remaining_capacity = true,
+};
+
 static const struct of_device_id bq27xxx_battery_hdq_of_match[] = {
+	{ .compatible = "apple,j120-bq27540", .data = &bq27540_j120_data },
 	{ .compatible = "apple,d11-bq27545", .data = &bq27545_iphone7_plus_data },
 	{ .compatible = "apple,d111-bq27545", .data = &bq27545_iphone7_plus_data },
 	{ .compatible = "apple,j72-bq27545", .data = &bq27545_ipad_air_data },
