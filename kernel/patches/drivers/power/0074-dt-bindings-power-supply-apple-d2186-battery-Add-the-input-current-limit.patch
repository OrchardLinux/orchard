From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 22 Nov 2026 18:56:55 +0100
Subject: [PATCH] dt-bindings: power: supply: apple,d2186-battery: Add the
 input current limit

The D2186 battery node also provides the USB input supply. Describe
input-current-limit-microamp, the most the board may draw from USB:
with it, the driver sets the PMIC input-current limit to what the USB
host allows, up to this value.

Assisted-by: LLM
---
 .../bindings/power/supply/apple,d2186-battery.yaml     | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/power/supply/apple,d2186-battery.yaml b/Documentation/devicetree/bindings/power/supply/apple,d2186-battery.yaml
index 6f7b777..020407e 100644
--- a/Documentation/devicetree/bindings/power/supply/apple,d2186-battery.yaml
+++ b/Documentation/devicetree/bindings/power/supply/apple,d2186-battery.yaml
@@ -13,7 +13,8 @@ description: |
   Devices such as the Apple iPod touch 6 (N102) have no dedicated fuel-gauge
   IC. Battery telemetry is sampled through the Dialog D2186 PMIC housekeeping
   ADC and charging state is read from the PMIC status registers (0x60..0x6d)
-  through the parent Apple I2C PMIC regmap.
+  through the parent Apple I2C PMIC regmap. The node also provides the USB
+  input supply, whose input-current limit can follow the USB host's grant.
 
 allOf:
   - $ref: power-supply.yaml#
@@ -39,6 +40,12 @@ properties:
 
   monitored-battery: true
 
+  input-current-limit-microamp:
+    description:
+      The highest USB input current the board may draw. With it, the
+      driver sets the PMIC input-current limit to what the USB host
+      allows, up to this value; without it, the limit is left alone.
+
 required:
   - compatible
   - io-channels
@@ -83,6 +90,7 @@ examples:
                               <&pmu_adc 15>,
                               <&pmu_adc 9>;
                 io-channel-names = "vbat", "ich", "tbat", "vbus", "ibus";
+                input-current-limit-microamp = <1500000>;
             };
         };
     };
-- 
2.49.0

