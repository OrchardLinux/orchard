From fc956a6643f014aa00e345efac449a7101a9017e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 17 Nov 2026 13:04:17 +0100
Subject: [PATCH] power: supply: apple_tristar_charger: Read the digital ID
 before sampling the data lines

A Lightning camera adapter with its own power input attached never
leaves device mode. The adapter feeds VBUS at once, so the charger sees
a new attachment and, 300 ms later, starts identifying the source: it
routes the Tristar mux to the ADC on both lane pairs and excites the
oriented pair for BC1.2 detection, round after round until its 1 s hold
ends. The accessory policy's first GetID is due 300-550 ms after the
plug edge, so it lands in the middle of that. In this order the GetIDs
time out (-ETIMEDOUT every 2.2 s for minutes, no power handshake, no
host mode, a 500 mA grant that collapses to 100 mA). Plugging the
adapter in first and its power last passed on 2026-11-13, but that
order races the same way. The passing USB host kernel of 2026-10-29
never sampled the mux before the adapter's ID: its one detection
attempt stopped at a plug-present check.

iOS cannot do it in this order: its only data-line measurement
(AppleCBTL1610, the pin-voltage operation used for BrickID and BC1.2)
starts from the route that the decoded digital ID selected and refuses
any other, and it changes only the USB pair, keeping the other pair's
transport. On attach iOS reads the ID first, programs the ACC and data
routes from it, and measures afterwards.

Let the accessory policy say when the attachment's digital ID is being
read: from a plug edge until the first GetID after it has finished,
with or without an ID. While it is, the charger does not touch the mux.
The wait stays inside the charger's existing hold, so a source whose ID
cannot be read is still identified and USB data still comes on within
1 s, and boards without the accessory policy are unchanged. Once the ID
names the camera adapter the policy holds the port as before.

Assisted-by: LLM
---
 .../power/supply/apple_tristar_accessory.c    | 26 +++++++++++++++++++
 .../power/supply/apple_tristar_accessory.h    |  6 +++++
 drivers/power/supply/apple_tristar_charger.c  |  7 +++++
 3 files changed, 39 insertions(+)

diff --git a/drivers/power/supply/apple_tristar_accessory.c b/drivers/power/supply/apple_tristar_accessory.c
index aeedebd..8d961c3 100644
--- a/drivers/power/supply/apple_tristar_accessory.c
+++ b/drivers/power/supply/apple_tristar_accessory.c
@@ -39,6 +39,13 @@
  * the role switch calls back into the charger (the status sample below, the
  * gadget's vbus_draw) with its own lock held.
  *
+ * The digital ID comes first. iOS measures the USB data lines only through
+ * the route that the decoded ID selects (its pin-voltage operation refuses
+ * any other route), so it never drives or samples them before the ID is
+ * known. The charger likewise leaves the mux alone from a plug edge until
+ * the first GetID after it has finished (see
+ * tristar_accessory_identifying()).
+ *
  * Copyright The Orchard Linux contributors
  */
 
@@ -136,6 +143,7 @@ struct tristar_auto {
 	unsigned int ph_tries;
 	unsigned long ph_deadline;
 	bool ph_ok;
+	bool id_pending;		/* no GetID result since the plug edge */
 };
 
 struct tristar_auto_in {
@@ -329,6 +337,7 @@ tristar_auto_step(struct tristar_auto *ta, const struct tristar_auto_cfg *cfg,
 		if (attached) {
 			ta->phase = TRISTAR_AUTO_DEVICE;
 			ta->next_probe = in->now + cfg->settle_ms;
+			ta->id_pending = true;
 		}
 		return TRISTAR_AUTO_NONE;
 	case TRISTAR_AUTO_DEVICE:
@@ -339,6 +348,7 @@ tristar_auto_step(struct tristar_auto *ta, const struct tristar_auto_cfg *cfg,
 		if (edge) {
 			ta->phase = TRISTAR_AUTO_DEVICE;
 			ta->next_probe = in->now + cfg->settle_ms;
+			ta->id_pending = true;
 		}
 		if (!tristar_auto_due(in->now, ta->next_probe))
 			return TRISTAR_AUTO_NONE;
@@ -387,6 +397,7 @@ tristar_auto_probed(struct tristar_auto *ta, const struct tristar_auto_cfg *cfg,
 {
 	bool adapter;
 
+	ta->id_pending = false;
 	if (ta->phase != TRISTAR_AUTO_DEVICE && ta->phase != TRISTAR_AUTO_OTHER &&
 	    ta->phase != TRISTAR_AUTO_HOST)
 		return TRISTAR_AUTO_NONE;
@@ -741,6 +752,21 @@ const char *tristar_accessory_holds(struct tristar_accessory *acc, unsigned int
 	return NULL;
 }
 
+/**
+ * tristar_accessory_identifying - whether the attachment's digital ID is being read
+ * @acc: accessory policy, or NULL
+ *
+ * True from a plug edge until the first GetID after it has finished, with
+ * or without an ID. Meanwhile the charger must not route or excite the USB
+ * data lines; it still bounds its own wait. Caller holds the charger lock.
+ *
+ * Return: true while that GetID is pending.
+ */
+bool tristar_accessory_identifying(struct tristar_accessory *acc)
+{
+	return acc && acc->autop.phase == TRISTAR_AUTO_DEVICE && acc->autop.id_pending;
+}
+
 /**
  * tristar_accessory_report - what the charger knows, once per charger poll
  * @acc: accessory policy, or NULL
diff --git a/drivers/power/supply/apple_tristar_accessory.h b/drivers/power/supply/apple_tristar_accessory.h
index 8df74ed..3890919 100644
--- a/drivers/power/supply/apple_tristar_accessory.h
+++ b/drivers/power/supply/apple_tristar_accessory.h
@@ -24,6 +24,7 @@ void tristar_accessory_stop(struct tristar_accessory *acc);
 void tristar_accessory_report(struct tristar_accessory *acc, unsigned int usb_ma,
 			      bool mux_fault);
 const char *tristar_accessory_holds(struct tristar_accessory *acc, unsigned int *ma);
+bool tristar_accessory_identifying(struct tristar_accessory *acc);
 #else
 static inline int tristar_accessory_probe(struct device *dev, struct i2c_client *tristar,
 					  struct mutex *lock,
@@ -50,6 +51,11 @@ static inline const char *tristar_accessory_holds(struct tristar_accessory *acc,
 {
 	return NULL;
 }
+
+static inline bool tristar_accessory_identifying(struct tristar_accessory *acc)
+{
+	return false;
+}
 #endif
 
 #endif /* _APPLE_TRISTAR_ACCESSORY_H */
diff --git a/drivers/power/supply/apple_tristar_charger.c b/drivers/power/supply/apple_tristar_charger.c
index 37c805a..dc0cd9b 100644
--- a/drivers/power/supply/apple_tristar_charger.c
+++ b/drivers/power/supply/apple_tristar_charger.c
@@ -835,6 +835,13 @@ static void tristar_run_identification(struct tristar_charger *chg, u64 now)
 		tristar_reconfirm(chg, now, expired);
 		return;
 	}
+	/*
+	 * iOS measures the data lines only on the USB route that the digital
+	 * ID selects. While the accessory policy reads that ID, leave the mux
+	 * alone, but never beyond the hold.
+	 */
+	if (!expired && tristar_accessory_identifying(chg->acc))
+		return;
 	ret = tristar_identify(chg, &id);
 	if (ret == -EUCLEAN) {
 		tristar_mux_fault(chg);
