From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Sun, 22 Nov 2026 02:35:33 +0100
Subject: [PATCH] dt-bindings: mfd: describe the J120 cover switch

Assisted-by: LLM
---
 Documentation/devicetree/bindings/mfd/apple,pmic.yaml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
index 21fece323..5ec317d11 100644
--- a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
@@ -66,6 +66,16 @@ properties:
   events:
     $ref: /schemas/interrupt-controller/apple,pmic-events.yaml
 
+  cover-switch:
+    type: object
+    description: Magnetic cover switch wired to GPIOs 0 and 10 on the J120 August PMIC.
+    properties:
+      compatible:
+        const: apple,j120-cover-switch
+    required:
+      - compatible
+    additionalProperties: false
+
   poweroff:
     $ref: /schemas/power/reset/apple,d2365-poweroff.yaml#
 
