From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Thu, 19 Nov 2026 00:10:11 +0100
Subject: [PATCH] dt-bindings: mfd: add D2355 and PMIC event children

Allow the new D2355 charger child and the PMIC event child while preserving the existing D2365 charger binding.

Assisted-by: LLM
---
 Documentation/devicetree/bindings/mfd/apple,pmic.yaml | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
index 294a323aa..21fece323 100644
--- a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
@@ -40,6 +40,7 @@ properties:
               - apple,aria-pmic
               - apple,august-pmic
               - apple,autumn-pmic
+              - apple,d2355-pmic
           - const: apple,i2c-pmic
       - items:
           - enum:
@@ -62,12 +63,17 @@ properties:
   gpio:
     $ref: /schemas/gpio/apple,d2365-pmic-gpio.yaml
 
+  events:
+    $ref: /schemas/interrupt-controller/apple,pmic-events.yaml
+
   poweroff:
     $ref: /schemas/power/reset/apple,d2365-poweroff.yaml#
 
 patternProperties:
   "^charger@[0-9a-f]+$":
-    $ref: /schemas/power/supply/apple,d2365-charger.yaml
+    oneOf:
+      - $ref: /schemas/power/supply/apple,d2365-charger.yaml
+      - $ref: /schemas/power/supply/apple,d2355-tristar-charger.yaml
 
   "^backlight(@[0-9a-f]+)?$":
     $ref: /schemas/leds/backlight/apple,pmic-bl.yaml
