From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 24 Nov 2026 08:30:59 +0800
Subject: [PATCH] power: supply: apple_tristar_charger: take the D2355
 calibration from the DT

The D2355 input-current calibration is the unit's ADT /charger
usb-input-limit-calibration-hv. The boot loader (m1n1) copies those 84
bytes into the charger node, as it does for the touch and light sensor
calibrations, so the driver reads them there instead of requesting a
per-unit firmware file that the installer had to extract from the ADT
and that a RAM boot never had. The table is parsed and checked as
before; without it the charger does not bind, as without the file.

Assisted-by: LLM
---
 .../supply/apple,d2355-tristar-charger.yaml     | 11 +++++++----
 drivers/power/supply/apple_tristar_charger.c    |  1 -
 drivers/power/supply/apple_tristar_d2355.h      | 17 +++++++----------
 3 files changed, 14 insertions(+), 15 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/supply/apple,d2355-tristar-charger.yaml b/Documentation/devicetree/bindings/power/supply/apple,d2355-tristar-charger.yaml
index 1dba6fb63..028750632 100644
--- a/Documentation/devicetree/bindings/power/supply/apple,d2355-tristar-charger.yaml
+++ b/Documentation/devicetree/bindings/power/supply/apple,d2355-tristar-charger.yaml
@@ -56,9 +56,13 @@ properties:
     $ref: /schemas/types.yaml#/definitions/phandle
     description: The August PMIC providing the ADC registers.
 
-  firmware-name:
-    maxItems: 1
-    description: The D2355 input-limit calibration for this unit.
+  apple,usb-input-limit-calibration-hv:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 84
+    maxItems: 84
+    description:
+      This unit's input-current calibration, the ADT's /charger
+      usb-input-limit-calibration-hv, filled in by the boot loader.
 
   apple,pack-limits:
     $ref: /schemas/types.yaml#/definitions/int32-array
@@ -87,7 +91,6 @@ required:
   - interrupts-extended
   - apple,tristar
   - apple,adc-pmic
-  - firmware-name
   - apple,pack-limits
   - input-current-limit-microamp
   - port
diff --git a/drivers/power/supply/apple_tristar_charger.c b/drivers/power/supply/apple_tristar_charger.c
index 80104567f..79eea8d74 100644
--- a/drivers/power/supply/apple_tristar_charger.c
+++ b/drivers/power/supply/apple_tristar_charger.c
@@ -40,7 +40,6 @@
 #include <linux/devm-helpers.h>
 #include <linux/i2c.h>
 #include <linux/iio/consumer.h>
-#include <linux/firmware.h>
 #include <linux/interrupt.h>
 #include <linux/irq.h>
 #include <linux/jiffies.h>
diff --git a/drivers/power/supply/apple_tristar_d2355.h b/drivers/power/supply/apple_tristar_d2355.h
index dd117a006..9a42d1c82 100644
--- a/drivers/power/supply/apple_tristar_d2355.h
+++ b/drivers/power/supply/apple_tristar_d2355.h
@@ -207,9 +207,9 @@ static int tristar_d2355_prepare(struct tristar_charger *chg)
 	struct tristar_d2355 *hw;
 	struct device_node *np;
 	struct i2c_client *adc;
-	const struct firmware *firmware;
-	const char *name;
+	const void *table;
 	u32 limits[6];
+	int len;
 	unsigned int i;
 	int ret;
 
@@ -231,14 +231,11 @@ static int tristar_d2355_prepare(struct tristar_charger *chg)
 			return -EINVAL;
 	if (hw->pack_limits[2] <= 0)
 		return -EINVAL;
-	ret = device_property_read_string(dev, "firmware-name", &name);
-	if (ret)
-		return ret;
-	ret = request_firmware(&firmware, name, dev);
-	if (ret)
-		return ret;
-	ret = d2355_calibration_parse_hv(firmware->data, firmware->size, &hw->calibration);
-	release_firmware(firmware);
+	/* The unit's ADT /charger table, copied by the boot loader */
+	table = of_get_property(dev->of_node, "apple,usb-input-limit-calibration-hv", &len);
+	if (!table)
+		return -ENOENT;
+	ret = d2355_calibration_parse_hv(table, len, &hw->calibration);
 	if (ret)
 		return ret;
 	np = of_parse_phandle(dev->of_node, "apple,adc-pmic", 0);
