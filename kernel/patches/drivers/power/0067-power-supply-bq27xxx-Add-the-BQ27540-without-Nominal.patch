From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Mon, 23 Nov 2026 21:30:20 +0100
Subject: [PATCH] power: supply: bq27xxx: Add the BQ27540 without
 NominalAvailableCapacity

Apple's BQ27540 gauges answer the BQ27541 command set, which the
"ti,bq27540-hdq" compatible uses, except NominalAvailableCapacity
(0x0c). On the iPhone 6s Plus every read of charge_now fails: the HDQ
cycle for 0x0d returns only the echo of the command byte (fe c0 fe fe
c0 c0 c0 c0), three times, and the gauge never answers, while voltage,
current, temperature and capacity read. The iPad Pro 10.5 (J208) bring-up
saw the same BQ27540 behaviour: RemainingCapacity (0x10) answers, 0x0c
does not.

Give the BQ27540 its own register map, the BQ27541 one with NAC marked
invalid, as upstream does for gauges without that command. charge_now
then reads RemainingCapacity, which also pairs with FullChargeCapacity,
like the iPhone 7 and iPad Air gauges' remaining-capacity quirk. Boards
whose BQ27540 does answer 0x0c only lose the uncompensated value. The
iPad Pro 2 keeps its own cached BQ27541 profile ("apple,j120-bq27540"),
which already reads RemainingCapacity.

Assisted-by: LLM
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 drivers/power/supply/bq27xxx_battery.c     | 31 ++++++++++++++++++++++
 drivers/power/supply/bq27xxx_battery_hdq.c |  6 ++---
 include/linux/power/bq27xxx_battery.h      |  1 +
 3 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/drivers/power/supply/bq27xxx_battery.c b/drivers/power/supply/bq27xxx_battery.c
index 6369b922f..29c9b0415 100644
--- a/drivers/power/supply/bq27xxx_battery.c
+++ b/drivers/power/supply/bq27xxx_battery.c
@@ -25,6 +25,7 @@
  * https://www.ti.com/product/bq27520-g4
  * https://www.ti.com/product/bq27530-g1
  * https://www.ti.com/product/bq27531-g1
+ * https://www.ti.com/product/bq27540-g1
  * https://www.ti.com/product/bq27541-g1
  * https://www.ti.com/product/bq27542-g1
  * https://www.ti.com/product/bq27546-g1
@@ -390,6 +391,33 @@ static u8
 		BQ27XXX_DM_REG_ROWS,
 	},
 #define bq27531_regs bq27530_regs
+	/*
+	 * Apple's BQ27540 gauge firmware answers the BQ27541 commands except
+	 * NominalAvailableCapacity (0x0c): an HDQ read of 0x0d gets no reply
+	 * (iPhone 6s Plus, iPad Pro 10.5). charge_now then comes from
+	 * RemainingCapacity (0x10), which pairs with FullChargeCapacity.
+	 */
+	bq27540_regs[BQ27XXX_REG_MAX] = {
+		[BQ27XXX_REG_CTRL] = 0x00,
+		[BQ27XXX_REG_TEMP] = 0x06,
+		[BQ27XXX_REG_INT_TEMP] = 0x28,
+		[BQ27XXX_REG_VOLT] = 0x08,
+		[BQ27XXX_REG_AI] = 0x14,
+		[BQ27XXX_REG_FLAGS] = 0x0a,
+		[BQ27XXX_REG_TTE] = 0x16,
+		[BQ27XXX_REG_TTF] = INVALID_REG_ADDR,
+		[BQ27XXX_REG_TTES] = INVALID_REG_ADDR,
+		[BQ27XXX_REG_TTECP] = INVALID_REG_ADDR,
+		[BQ27XXX_REG_NAC] = INVALID_REG_ADDR,
+		[BQ27XXX_REG_RC] = 0x10,
+		[BQ27XXX_REG_FCC] = 0x12,
+		[BQ27XXX_REG_CYCT] = 0x2a,
+		[BQ27XXX_REG_AE] = INVALID_REG_ADDR,
+		[BQ27XXX_REG_SOC] = 0x2c,
+		[BQ27XXX_REG_DCAP] = 0x3c,
+		[BQ27XXX_REG_AP] = 0x24,
+		BQ27XXX_DM_REG_ROWS,
+	},
 	bq27541_regs[BQ27XXX_REG_MAX] = {
 		[BQ27XXX_REG_CTRL] = 0x00,
 		[BQ27XXX_REG_TEMP] = 0x06,
@@ -762,6 +790,7 @@ static enum power_supply_property bq27541_props[] = {
 	POWER_SUPPLY_PROP_HEALTH,
 	POWER_SUPPLY_PROP_MANUFACTURER,
 };
+#define bq27540_props bq27541_props
 #define bq27542_props bq27541_props
 #define bq27546_props bq27541_props
 #define bq27742_props bq27541_props
@@ -975,6 +1004,7 @@ static struct bq27xxx_dm_reg bq27500_dm_regs[] = {
 #define bq27521_dm_regs NULL
 #define bq27530_dm_regs NULL
 #define bq27531_dm_regs NULL
+#define bq27540_dm_regs NULL
 #define bq27541_dm_regs NULL
 #define bq27542_dm_regs NULL
 #define bq27546_dm_regs NULL
@@ -1077,6 +1107,7 @@ static struct {
 	[BQ27521]   = BQ27XXX_DATA(bq27521,   0         , 0),
 	[BQ27530]   = BQ27XXX_DATA(bq27530,   0         , BQ27XXX_O_UTOT),
 	[BQ27531]   = BQ27XXX_DATA(bq27531,   0         , BQ27XXX_O_UTOT),
+	[BQ27540]   = BQ27XXX_DATA(bq27540,   0         , BQ27XXX_O_OTDC),
 	[BQ27541]   = BQ27XXX_DATA(bq27541,   0         , BQ27XXX_O_OTDC),
 	[BQ27542]   = BQ27XXX_DATA(bq27542,   0         , BQ27XXX_O_OTDC),
 	[BQ27546]   = BQ27XXX_DATA(bq27546,   0         , BQ27XXX_O_OTDC),
diff --git a/drivers/power/supply/bq27xxx_battery_hdq.c b/drivers/power/supply/bq27xxx_battery_hdq.c
index 22a9b9772..33f20f2fe 100644
--- a/drivers/power/supply/bq27xxx_battery_hdq.c
+++ b/drivers/power/supply/bq27xxx_battery_hdq.c
@@ -193,8 +193,8 @@ static const struct bq27xxx_hdq_data bq27545_data = {
 	.chip = BQ27545,
 };
 
-static const struct bq27xxx_hdq_data bq27541_data = {
-	.chip = BQ27541,
+static const struct bq27xxx_hdq_data bq27540_data = {
+	.chip = BQ27540,
 };
 
 /*
@@ -216,7 +216,7 @@ static const struct of_device_id bq27xxx_battery_hdq_of_match[] = {
 	{ .compatible = "apple,d111-bq27545", .data = &bq27545_iphone7_plus_data },
 	{ .compatible = "apple,j72-bq27545", .data = &bq27545_ipad_air_data },
 	{ .compatible = "ti,bq27545-hdq", .data = &bq27545_data },
-	{ .compatible = "ti,bq27540-hdq", .data = &bq27541_data },
+	{ .compatible = "ti,bq27540-hdq", .data = &bq27540_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, bq27xxx_battery_hdq_of_match);
diff --git a/include/linux/power/bq27xxx_battery.h b/include/linux/power/bq27xxx_battery.h
index f665762a3..18f9ac10f 100644
--- a/include/linux/power/bq27xxx_battery.h
+++ b/include/linux/power/bq27xxx_battery.h
@@ -21,6 +21,7 @@ enum bq27xxx_chip {
 	BQ27521, /* bq27521 */
 	BQ27530, /* bq27530, bq27531 */
 	BQ27531,
+	BQ27540, /* bq27540 with Apple's gauge firmware */
 	BQ27541, /* bq27541, bq27542, bq27546, bq27742 */
 	BQ27542,
 	BQ27546,
