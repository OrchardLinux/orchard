From 6f724b4e7d6760494e728b7f722996bef62e67a9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:01:15 +0100
Subject: [PATCH] power: supply: apple_tristar_charger: Keep the grant on
 status 0x62

An iPad 5 on a Mac reaches its granted 2400 mA, then repeatedly drops
to 500 mA when D2365 reports status 0x62. A two-minute capture attributed
all 23 withdrawals to this check without a source epoch change.

Apple checks the charging, charge-end and timeout fields in this status
byte, but does not use bit 5 to request input-current backoff. Admit the
observed 0x62 alongside 0x42. Keep every other status rejected and retain
the battery, board-cap, source-epoch and physical limit-readback guards.

Affects: Apple iPad 5 (D2365/TriStar); only status 0x62 is newly admitted
Assisted-by: LLM
---
 drivers/power/supply/apple_tristar_charger.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/power/supply/apple_tristar_charger.c b/drivers/power/supply/apple_tristar_charger.c
index 9184b4e..f5b9ae0 100644
--- a/drivers/power/supply/apple_tristar_charger.c
+++ b/drivers/power/supply/apple_tristar_charger.c
@@ -995,6 +995,19 @@ static void tristar_follow_accessory(struct tristar_charger *chg, u64 now)
 	dev_dbg(chg->dev, "%s: %u mA\n", holder, ma);
 }
 
+/*
+ * D2365 status 0x18a may set bit 5 while charging at the granted limit.
+ * iOS tests bits 1:0 for charging, bit 2 for charge end and bit 4 for
+ * timeout; its D2365 input-limited callback is false. Bit 5 alone must
+ * not turn a running grant into a fallback/ramp cycle. Accept only the
+ * two observed online bytes, retaining the other status checks.
+ */
+static bool tristar_status_online(unsigned int status)
+{
+	return status == TRISTAR_CHG_STATUS_ONLINE ||
+	       status == (TRISTAR_CHG_STATUS_ONLINE | BIT(5));
+}
+
 static void tristar_poll(struct work_struct *work)
 {
 	struct tristar_charger *chg = container_of(to_delayed_work(work),
@@ -1032,7 +1045,7 @@ static void tristar_poll(struct work_struct *work)
 		tristar_no_source(chg, status, now);
 		goto again;
 	}
-	if (status != TRISTAR_CHG_STATUS_ONLINE) {
+	if (!tristar_status_online(status)) {
 		/* Transitional input state (e.g. 0x40 while attaching): no grant. */
 		if (chg->code > TRISTAR_CHG_FALLBACK_CODE)
 			tristar_withdraw(chg, TRISTAR_CHG_FALLBACK_CODE);
