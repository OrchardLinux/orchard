From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:56:06 +0100
Subject: [PATCH] power: supply: apple_tristar_charger: Keep the grant over
 system sleep

Every s2idle entry on an iPad 5 connected to a Mac failed in the device
phase: the USB device controller suspends after this driver, disconnects
from its host and reports a budget of 0 mA through vbus_draw. Applying it
changed the supply, power_supply_changed() took the "lightning" wakeup
source, and the PM core aborted with "Wakeup pending" (errno -16, step
suspend). The sleep was ended by the report it caused.

When a sleep did happen, the source was identified again after the wake
and the grant ramped from 100 mA to 2400 mA: a USB host was parked at the
handoff on suspend. iOS 16 keeps a USB host's granted current across
sleep and USB suspend (IOAccessoryUSBCurrentLimit), and AppleARMPMUCharger
leaves the input limit as written over sleep.

Mark the sleep from prepare to complete. While it lasts, a USB budget
report is held, not applied, and no supply change is reported. Keep an
identified USB host's grant like any other source's: a plug or unplug
still wakes the system and ends the attachment. After the wake the host
enumerates the controller again (unconfigured, configured, its grant), so
a lower report is held for 10 s after complete and applied then unless the
host granted again.

Assisted-by: LLM
---
 drivers/power/supply/apple_tristar_charger.c | 97 +++++++++++++++++---
 1 file changed, 86 insertions(+), 11 deletions(-)

diff --git a/drivers/power/supply/apple_tristar_charger.c b/drivers/power/supply/apple_tristar_charger.c
index 2170cb9..a3ee252 100644
--- a/drivers/power/supply/apple_tristar_charger.c
+++ b/drivers/power/supply/apple_tristar_charger.c
@@ -105,6 +105,12 @@
 #define TRISTAR_EVENT_DEBOUNCE_MS	50
 /* More source events than this per second means something is stuck. */
 #define TRISTAR_IRQ_STORM		200
+/*
+ * After a system sleep the USB device controller connects again, and its
+ * host enumerates it from scratch: unconfigured, configured, then its
+ * current grant. A lower report in this window is held until it ends.
+ */
+#define TRISTAR_RESUME_KEEP_MS		10000
 
 enum tristar_phase {
 	TRISTAR_EMPTY,
@@ -179,6 +185,15 @@ struct tristar_charger {
 	bool usb_on;
 	/* What the USB host allows (vbus_draw) */
 	unsigned int usb_ma;
+	/*
+	 * From prepare to complete of a system sleep: the device controller's
+	 * reports are its own suspend, not the host's.
+	 */
+	bool sleeping;
+	/* A lower report held over sleep and the re-enumeration after it */
+	bool usb_report_held;
+	unsigned int usb_report_ma;
+	u64 usb_keep_until_ns;
 	enum power_supply_usb_type usb_type;
 	/* The identified cable, to recognize it after a source event. */
 	bool cable_known;
@@ -710,8 +725,10 @@ static void tristar_set_usb(struct tristar_charger *chg, bool on)
 	if (ret)
 		dev_err(chg->dev, "cannot turn USB data %s (%d)\n", on ? "on" : "off", ret);
 	chg->usb_on = on || ret;
-	if (!chg->usb_on)
+	if (!chg->usb_on) {
 		chg->usb_ma = 0;
+		chg->usb_report_held = false;
+	}
 }
 
 /* The highest grant the source allows, up to the board maximum. */
@@ -1146,6 +1163,14 @@ static void tristar_poll(struct work_struct *work)
 		dev_dbg(chg->dev, "source event debounced, %u mA kept\n",
 			tristar_code_ma(chg->code));
 	}
+	if (chg->usb_report_held && (s64)(chg->usb_keep_until_ns - now) <= 0) {
+		/* The host did not grant again after the wake. */
+		chg->usb_report_held = false;
+		dev_info(chg->dev, "USB budget after the wake: %u mA (%u mA before the sleep)\n",
+			 chg->usb_report_ma, chg->usb_ma);
+		chg->usb_ma = chg->usb_report_ma;
+		tristar_update_target(chg);
+	}
 	tristar_follow_accessory(chg, now);
 	switch (chg->phase) {
 	case TRISTAR_SETTLING:
@@ -1333,13 +1358,23 @@ static int tristar_get_property(struct power_supply *psy,
  * an Apple host's current grant. Not writable from user space. Only a
  * session this driver turned on counts: without VBUS sensing the controller
  * keeps reporting bus suspend and resume after its host is gone.
+ *
+ * A system sleep disconnects the device controller from its host, and the
+ * host enumerates it again after the wake. Neither is the host lowering its
+ * grant, and iOS keeps the granted current across sleep: a lower report is
+ * held from prepare until TRISTAR_RESUME_KEEP_MS after complete, and applied
+ * then unless the host granted again. No supply change is reported while the
+ * system sleeps: it is a wakeup event, and it would abort the suspend that
+ * caused it. A plug or unplug wakes the system and ends the attachment, which
+ * drops a held report.
  */
 static int tristar_set_property(struct power_supply *psy,
 				enum power_supply_property psp,
 				const union power_supply_propval *val)
 {
 	struct tristar_charger *chg = power_supply_get_drvdata(psy);
-	unsigned int old_code, old_ma, report_ma;
+	unsigned int old_code, old_ma, report_ma, accept_ma;
+	u64 now = ktime_get_ns();
 
 	if (psp != POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT)
 		return -EINVAL;
@@ -1348,8 +1383,18 @@ static int tristar_set_property(struct power_supply *psy,
 	old_code = chg->code;
 	old_ma = tristar_usb_ma(chg);
 	report_ma = max(val->intval, 0) / 1000;
-	chg->usb_ma = chg->present && chg->usb_on ?
-		min(report_ma, chg->max_ma) : 0;
+	accept_ma = chg->present && chg->usb_on ? min(report_ma, chg->max_ma) : 0;
+	if (chg->sleeping ||
+	    (accept_ma < old_ma && (s64)(chg->usb_keep_until_ns - now) > 0)) {
+		chg->usb_report_ma = accept_ma;
+		chg->usb_report_held = accept_ma != old_ma;
+		dev_dbg(chg->dev, "USB budget: reported %u mA, %u mA kept over %s\n",
+			report_ma, old_ma, chg->sleeping ? "sleep" : "the wake");
+		mutex_unlock(&chg->lock);
+		return 0;
+	}
+	chg->usb_report_held = false;
+	chg->usb_ma = accept_ma;
 	dev_dbg(chg->dev,
 		"USB budget: reported %u mA, accepted %u mA, present %u, data %u\n",
 		report_ma, chg->usb_ma, chg->present, chg->usb_on);
@@ -1588,12 +1633,39 @@ static void tristar_shutdown(struct platform_device *pdev)
 		tristar_stop(chg, "shutdown");
 }
 
+/*
+ * From here until complete, a USB budget report is the device controller's
+ * own suspend (it disconnects from its host), not the host's: see
+ * tristar_set_property().
+ */
+static int tristar_prepare(struct device *dev)
+{
+	struct tristar_charger *chg = dev_get_drvdata(dev);
+
+	mutex_lock(&chg->lock);
+	chg->sleeping = true;
+	mutex_unlock(&chg->lock);
+	return 0;
+}
+
+static void tristar_complete(struct device *dev)
+{
+	struct tristar_charger *chg = dev_get_drvdata(dev);
+
+	mutex_lock(&chg->lock);
+	chg->sleeping = false;
+	/* The poll (every TRISTAR_POLL_MS) applies a held report after this. */
+	chg->usb_keep_until_ns = ktime_get_ns() + TRISTAR_RESUME_KEEP_MS * NSEC_PER_MSEC;
+	mutex_unlock(&chg->lock);
+}
+
 /*
  * A plug or unplug wakes the system, so sleep hides no source swap and an
- * identified charger keeps its limit: a tablet left on one charges at full
- * rate. A USB host may be asleep too and is owed no more than the handoff, so
- * it parks there and is identified again on resume, as is anything without a
- * plug event to rely on.
+ * identified source keeps its grant, as in iOS 16, which keeps a USB host's
+ * granted current across sleep too (IOAccessoryUSBCurrentLimit): a tablet
+ * left on a charger or a computer charges at the same rate after the wake,
+ * without identifying the source again. Anything without a plug event to
+ * rely on parks at the handoff and is identified again on resume.
  *
  * Sleep never waits for the charger. iOS 16 (AppleARMPMUCharger) cancels the
  * ramp on sleep and leaves the limit as written; after wake the ramp goes on
@@ -1612,8 +1684,7 @@ static int tristar_suspend(struct device *dev)
 
 	mutex_lock(&chg->lock);
 	keep = chg->plug_irq && device_may_wakeup(dev) && chg->present &&
-	       (chg->phase == TRISTAR_RAMPING || chg->phase == TRISTAR_CHARGING) &&
-	       !tristar_usb_ma(chg);
+	       (chg->phase == TRISTAR_RAMPING || chg->phase == TRISTAR_CHARGING);
 	chg->stopping = true;
 	if (!keep) {
 		chg->present = false;
@@ -1650,7 +1721,11 @@ static int tristar_resume(struct device *dev)
 	return 0;
 }
 
-static DEFINE_SIMPLE_DEV_PM_OPS(tristar_pm_ops, tristar_suspend, tristar_resume);
+static const struct dev_pm_ops tristar_pm_ops = {
+	.prepare = pm_sleep_ptr(tristar_prepare),
+	.complete = pm_sleep_ptr(tristar_complete),
+	SYSTEM_SLEEP_PM_OPS(tristar_suspend, tristar_resume)
+};
 
 /*
  * D2365: iOS reads presence from 0x189 (AppleD2365PMUPowerSource). The plug
