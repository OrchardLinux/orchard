From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Fri, 20 Nov 2026 11:40:22 +0100
Subject: [PATCH] power: supply: limit D2355 input when the J120 gauge reports
 full

Expose the J120 gauge full flag through cached capacity level. A full pack retains only the 80 mA fallback even if it starts to discharge. Resume ramping under the existing telemetry checks after the flag clears.

Assisted-by: LLM
---
 drivers/power/supply/apple_tristar_charger.c | 13 ++++++++++---
 drivers/power/supply/apple_tristar_d2355.h   |  4 +++-
 drivers/power/supply/bq27xxx_battery_hdq.c   |  1 +
 3 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/drivers/power/supply/apple_tristar_charger.c b/drivers/power/supply/apple_tristar_charger.c
index cfe8a36fb..a878cbae6 100644
--- a/drivers/power/supply/apple_tristar_charger.c
+++ b/drivers/power/supply/apple_tristar_charger.c
@@ -359,9 +359,10 @@ struct tristar_pack {
 	int temp;
 	int voltage_uv;
 	int current_ua;
+	bool full;
 };
 
-static int tristar_read_pack(struct tristar_pack *pack)
+static int tristar_read_pack(struct tristar_charger *chg, struct tristar_pack *pack)
 {
 	struct power_supply *battery = power_supply_get_by_name("battery");
 	union power_supply_propval val;
@@ -390,6 +391,12 @@ static int tristar_read_pack(struct tristar_pack *pack)
 	}
 	if (!ret)
 		pack->current_ua = val.intval;
+	pack->full = false;
+	if (!ret && chg->chip->require_pack_telemetry) {
+		ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_CAPACITY_LEVEL, &val);
+		if (!ret)
+			pack->full = val.intval == POWER_SUPPLY_CAPACITY_LEVEL_FULL;
+	}
 	power_supply_put(battery);
 	return ret;
 }
@@ -1037,7 +1044,7 @@ static void tristar_ramp_step(struct tristar_charger *chg, u64 now)
 	if (tristar_debouncing(chg, now) ||
 	    (chg->step_ns && now - chg->step_ns < chg->step_wait_ns))
 		return;
-	if (tristar_read_pack(&pack)) {
+	if (tristar_read_pack(chg, &pack)) {
 		if (chg->chip->require_pack_telemetry)
 			tristar_withdraw(chg, chg->chip->fallback_code);
 		return;
@@ -1140,7 +1147,7 @@ static void tristar_guard(struct tristar_charger *chg, u64 now)
 	tristar_check_limit(chg);
 	if (chg->phase != TRISTAR_CHARGING)
 		return;
-	if (tristar_read_pack(&pack)) {
+	if (tristar_read_pack(chg, &pack)) {
 		if (chg->chip->require_pack_telemetry)
 			tristar_withdraw(chg, chg->chip->fallback_code);
 		return;
diff --git a/drivers/power/supply/apple_tristar_d2355.h b/drivers/power/supply/apple_tristar_d2355.h
index 4d632873b..dd117a006 100644
--- a/drivers/power/supply/apple_tristar_d2355.h
+++ b/drivers/power/supply/apple_tristar_d2355.h
@@ -194,7 +194,9 @@ static bool tristar_d2355_pack_allows(struct tristar_charger *chg,
 {
 	struct tristar_d2355 *hw = chg->chip_data;
 
-	return pack->temp >= hw->pack_limits[0] && pack->temp <= hw->pack_limits[1] &&
+	/* The gauge's full flag remains valid when the pack supplies power. */
+	return !pack->full &&
+	       pack->temp >= hw->pack_limits[0] && pack->temp <= hw->pack_limits[1] &&
 	       pack->voltage_uv >= hw->pack_limits[2] && pack->voltage_uv <= hw->pack_limits[3] &&
 	       pack->current_ua >= hw->pack_limits[4] && pack->current_ua <= hw->pack_limits[5];
 }
diff --git a/drivers/power/supply/bq27xxx_battery_hdq.c b/drivers/power/supply/bq27xxx_battery_hdq.c
index 8d939390e..453f6b622 100644
--- a/drivers/power/supply/bq27xxx_battery_hdq.c
+++ b/drivers/power/supply/bq27xxx_battery_hdq.c
@@ -44,6 +44,7 @@ static const enum power_supply_property bq27545_iphone7_plus_cache_props[] = {
 
 /* J120 exposes RemainingCapacity; do not query NominalAvailableCapacity. */
 static const enum power_supply_property bq27540_j120_cache_props[] = {
+	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
 	POWER_SUPPLY_PROP_STATUS,
 	POWER_SUPPLY_PROP_PRESENT,
 	POWER_SUPPLY_PROP_VOLTAGE_NOW,
