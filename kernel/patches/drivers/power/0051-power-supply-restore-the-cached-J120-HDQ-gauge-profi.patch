From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Thu, 19 Nov 2026 00:26:06 +0100
Subject: [PATCH] power: supply: restore the cached J120 HDQ gauge profile

[Henrik Klee: applied onto main's J120 profile, keeping its cycle count and cache_only; the read budget added to it]

Assisted-by: LLM
---
 .../power/supply/apple,j120-bq27540.yaml      | 38 +++++++++++++++++++
 .../bindings/w1/apple,j120-hdq-uart.yaml      | 29 ++++++++++++++
 drivers/power/supply/bq27xxx_battery.c        | 13 +++++++
 drivers/power/supply/bq27xxx_battery_hdq.c    |  5 +++
 include/linux/power/bq27xxx_battery.h         |  4 ++
 5 files changed, 89 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/apple,j120-bq27540.yaml
 create mode 100644 Documentation/devicetree/bindings/w1/apple,j120-hdq-uart.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/apple,j120-bq27540.yaml b/Documentation/devicetree/bindings/power/supply/apple,j120-bq27540.yaml
new file mode 100644
index 000000000..c311167ea
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/apple,j120-bq27540.yaml
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,j120-bq27540.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple J120 BQ27540 HDQ fuel gauge
+
+maintainers:
+  - tompta1 <546706+tompta1@users.noreply.github.com>
+
+description: |
+  The J120 battery gauge uses HDQ and the BQ27541 register layout. Its
+  telemetry profile uses RemainingCapacity rather than NominalAvailableCapacity.
+  It is a child of an HDQ bus, not an I2C device.
+
+properties:
+  compatible:
+    items:
+      - const: apple,j120-bq27540
+      - const: ti,bq27540-hdq
+
+  monitored-battery:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Battery characteristics, if independently known.
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    hdq {
+        fuel-gauge {
+            compatible = "apple,j120-bq27540", "ti,bq27540-hdq";
+        };
+    };
diff --git a/Documentation/devicetree/bindings/w1/apple,j120-hdq-uart.yaml b/Documentation/devicetree/bindings/w1/apple,j120-hdq-uart.yaml
new file mode 100644
index 000000000..1fcd15052
--- /dev/null
+++ b/Documentation/devicetree/bindings/w1/apple,j120-hdq-uart.yaml
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/w1/apple,j120-hdq-uart.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple J120 UART HDQ battery bus
+
+maintainers:
+  - tompta1 <546706+tompta1@users.noreply.github.com>
+
+description: |
+  The J120 battery gauge uses an HDQ bus driven by UART symbols. The
+  board-specific compatible selects bounded, read-only telemetry transactions.
+
+properties:
+  compatible:
+    items:
+      - const: apple,j120-hdq-uart
+      - const: ti,hdq-uart
+
+  fuel-gauge:
+    $ref: /schemas/power/supply/apple,j120-bq27540.yaml#
+
+required:
+  - compatible
+  - fuel-gauge
+
+additionalProperties: false
diff --git a/drivers/power/supply/bq27xxx_battery.c b/drivers/power/supply/bq27xxx_battery.c
index c85576628..a88402a03 100644
--- a/drivers/power/supply/bq27xxx_battery.c
+++ b/drivers/power/supply/bq27xxx_battery.c
@@ -1192,7 +1192,14 @@ static inline int bq27xxx_read(struct bq27xxx_device_info *di, int reg_index,
 	if (!di || di->regs[reg_index] == INVALID_REG_ADDR)
 		return -EINVAL;
 
+	if (di->cache_read_active &&
+	    time_after_eq(jiffies, di->cache_read_deadline))
+		return -ETIMEDOUT;
+
 	ret = di->bus.read(di, di->regs[reg_index], single);
+	if (ret >= 0 && di->cache_read_active &&
+	    time_after_eq(jiffies, di->cache_read_deadline))
+		ret = -ETIMEDOUT;
 	if (ret < 0)
 		dev_dbg(di->dev, "failed to read register 0x%02x (index %d)\n",
 			di->regs[reg_index], reg_index);
@@ -2118,6 +2125,11 @@ static void bq27xxx_battery_refresh_cache(struct bq27xxx_device_info *di)
 	mutex_lock(&di->lock);
 	if (di->removed)
 		goto out_unlock;
+	if (di->cache_read_budget_ms) {
+		di->cache_read_deadline = jiffies +
+			msecs_to_jiffies(di->cache_read_budget_ms);
+		di->cache_read_active = true;
+	}
 
 	cache = di->cache;
 
@@ -2203,6 +2215,7 @@ out_error:
 		power_supply_changed(di->bat);
 
 out_unlock:
+	di->cache_read_active = false;
 	if (!di->removed && di->cache_refresh_ms)
 		queue_delayed_work(system_freezable_wq, &di->work,
 				   msecs_to_jiffies(di->cache_refresh_ms));
diff --git a/drivers/power/supply/bq27xxx_battery_hdq.c b/drivers/power/supply/bq27xxx_battery_hdq.c
index e0b1f0a3d..112647982 100644
--- a/drivers/power/supply/bq27xxx_battery_hdq.c
+++ b/drivers/power/supply/bq27xxx_battery_hdq.c
@@ -62,6 +62,7 @@ struct bq27xxx_hdq_data {
 	bool use_remaining_capacity;
 	/* Cached telemetry, refreshed periodically (always for the BQ27545) */
 	bool cache_only;
+	unsigned int read_budget_ms;
 };
 
 static int w1_bq27000_read(struct w1_slave *sl, unsigned int reg)
@@ -124,6 +125,8 @@ static int bq27xxx_battery_hdq_add_slave(struct w1_slave *sl)
 
 	di->dev = &sl->dev;
 	match = of_match_node(sl->family->of_match_table, sl->dev.of_node);
+	if (sl->master->dev.parent && !match)
+		return -ENODEV;
 	if (match) {
 		const struct bq27xxx_hdq_data *data = match->data;
 
@@ -136,6 +139,7 @@ static int bq27xxx_battery_hdq_add_slave(struct w1_slave *sl)
 			di->num_cache_properties = data->num_cache_properties;
 		}
 		di->cache_use_remaining_capacity = data->use_remaining_capacity;
+		di->cache_read_budget_ms = data->read_budget_ms;
 	} else {
 		di->chip = BQ27000;
 		di->name = "bq27000-battery";
@@ -197,6 +201,7 @@ static const struct bq27xxx_hdq_data bq27541_data = {
 static const struct bq27xxx_hdq_data bq27540_j120_data = {
 	.chip = BQ27541,
 	.cache_only = true,
+	.read_budget_ms = 5000,
 	.cache_properties = bq27540_j120_cache_props,
 	.num_cache_properties = ARRAY_SIZE(bq27540_j120_cache_props),
 	.use_remaining_capacity = true,
diff --git a/include/linux/power/bq27xxx_battery.h b/include/linux/power/bq27xxx_battery.h
index 25c142419..5a930ed1c 100644
--- a/include/linux/power/bq27xxx_battery.h
+++ b/include/linux/power/bq27xxx_battery.h
@@ -83,6 +83,10 @@ struct bq27xxx_device_info {
 	bool cache_use_remaining_capacity;
 	/* Optional periodic refresh interval for cache-only transports. */
 	unsigned int cache_refresh_ms;
+	/* Bound admission of new register reads during a cached refresh. */
+	unsigned int cache_read_budget_ms;
+	unsigned long cache_read_deadline;
+	bool cache_read_active;
 	int charge_design_full;
 	int voltage_min_design;
 	int voltage_max_design;
