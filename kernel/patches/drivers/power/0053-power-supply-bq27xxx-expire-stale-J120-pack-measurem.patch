From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Thu, 19 Nov 2026 19:49:04 +0100
Subject: [PATCH] power: supply: bq27xxx: expire stale J120 pack measurements

Start the validity window with the first register read and count elapsed suspend time. Return ENODATA for an expired cache so the D2355 charger withdraws its higher input-current grant until the gauge reports a fresh sample.

Assisted-by: LLM
---
 drivers/power/supply/bq27xxx_battery.c     | 18 +++++++++++++++++-
 drivers/power/supply/bq27xxx_battery_hdq.c |  2 ++
 include/linux/power/bq27xxx_battery.h      |  3 +++
 3 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/drivers/power/supply/bq27xxx_battery.c b/drivers/power/supply/bq27xxx_battery.c
index a88402a03..6369b922f 100644
--- a/drivers/power/supply/bq27xxx_battery.c
+++ b/drivers/power/supply/bq27xxx_battery.c
@@ -53,6 +53,7 @@
 #include <linux/power_supply.h>
 #include <linux/slab.h>
 #include <linux/of.h>
+#include <linux/timekeeping.h>
 
 #include <linux/power/bq27xxx_battery.h>
 
@@ -2108,6 +2109,12 @@ void bq27xxx_battery_update(struct bq27xxx_device_info *di)
 }
 EXPORT_SYMBOL_GPL(bq27xxx_battery_update);
 
+static bool bq27xxx_cache_expired(const struct bq27xxx_device_info *di)
+{
+	return di->cache_max_age_ms && di->cache.flags >= 0 &&
+	       !ktime_before(ktime_get_boottime(), di->cache_valid_until);
+}
+
 static void bq27xxx_battery_refresh_cache(struct bq27xxx_device_info *di)
 {
 	union power_supply_propval current_now;
@@ -2116,6 +2123,7 @@ static void bq27xxx_battery_refresh_cache(struct bq27xxx_device_info *di)
 	union power_supply_propval value;
 	union power_supply_propval voltage;
 	struct bq27xxx_reg_cache cache;
+	ktime_t valid_until = 0;
 	bool single_flags;
 	bool changed;
 	int capacity;
@@ -2125,6 +2133,8 @@ static void bq27xxx_battery_refresh_cache(struct bq27xxx_device_info *di)
 	mutex_lock(&di->lock);
 	if (di->removed)
 		goto out_unlock;
+	if (di->cache_max_age_ms)
+		valid_until = ktime_add_ms(ktime_get_boottime(), di->cache_max_age_ms);
 	if (di->cache_read_budget_ms) {
 		di->cache_read_deadline = jiffies +
 			msecs_to_jiffies(di->cache_read_budget_ms);
@@ -2190,8 +2200,10 @@ static void bq27xxx_battery_refresh_cache(struct bq27xxx_device_info *di)
 		bq27xxx_cache_value(&cache.power_avg, ret, &value);
 	}
 
-	changed = memcmp(&di->cache, &cache, sizeof(cache)) != 0;
+	changed = memcmp(&di->cache, &cache, sizeof(cache)) != 0 ||
+		  bq27xxx_cache_expired(di);
 	di->cache = cache;
+	di->cache_valid_until = valid_until;
 	di->last_status = status;
 	di->last_update = jiffies;
 
@@ -2405,6 +2417,10 @@ static int bq27xxx_battery_get_cached_property(struct power_supply *psy,
 	int ret;
 
 	mutex_lock(&di->lock);
+	if (bq27xxx_cache_expired(di)) {
+		ret = -ENODATA;
+		goto out_unlock;
+	}
 	if (psp != POWER_SUPPLY_PROP_PRESENT && di->cache.flags < 0) {
 		ret = di->cache.flags;
 		goto out_unlock;
diff --git a/drivers/power/supply/bq27xxx_battery_hdq.c b/drivers/power/supply/bq27xxx_battery_hdq.c
index 112647982..0c2c0bff8 100644
--- a/drivers/power/supply/bq27xxx_battery_hdq.c
+++ b/drivers/power/supply/bq27xxx_battery_hdq.c
@@ -140,6 +140,8 @@ static int bq27xxx_battery_hdq_add_slave(struct w1_slave *sl)
 		}
 		di->cache_use_remaining_capacity = data->use_remaining_capacity;
 		di->cache_read_budget_ms = data->read_budget_ms;
+		if (data->read_budget_ms)
+			di->cache_max_age_ms = di->cache_refresh_ms + data->read_budget_ms;
 	} else {
 		di->chip = BQ27000;
 		di->name = "bq27000-battery";
diff --git a/include/linux/power/bq27xxx_battery.h b/include/linux/power/bq27xxx_battery.h
index 5a930ed1c..f665762a3 100644
--- a/include/linux/power/bq27xxx_battery.h
+++ b/include/linux/power/bq27xxx_battery.h
@@ -83,6 +83,9 @@ struct bq27xxx_device_info {
 	bool cache_use_remaining_capacity;
 	/* Optional periodic refresh interval for cache-only transports. */
 	unsigned int cache_refresh_ms;
+	/* Optional maximum age of a sample, measured from the first register read. */
+	unsigned int cache_max_age_ms;
+	ktime_t cache_valid_until;
 	/* Bound admission of new register reads during a cached refresh. */
 	unsigned int cache_read_budget_ms;
 	unsigned long cache_read_deadline;
