From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 8 Nov 2026 17:15:00 +0100
Subject: [PATCH] dt-bindings: pstore: retain the tethered warm boot state

A tethered kernel inherits initialized hardware rather than power-on
state. Retain the board-selected warm handoff state so probe and
shutdown do not discard resources needed by the incoming kernel.

Assisted-by: LLM
---
 .../devicetree/bindings/arm/apple,pstore.yaml | 31 +++++++++++++++++++
 .../bindings/reserved-memory/ramoops.yaml     |  4 +++
 2 files changed, 35 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/arm/apple,pstore.yaml

diff --git a/Documentation/devicetree/bindings/arm/apple,pstore.yaml b/Documentation/devicetree/bindings/arm/apple,pstore.yaml
new file mode 100644
index 000000000..241dee447
--- /dev/null
+++ b/Documentation/devicetree/bindings/arm/apple,pstore.yaml
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/apple,pstore.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple retained pstore allocation
+
+maintainers:
+  - brkosebay <brkosebay@users.noreply.github.com>
+
+description: |
+  Select early allocation on the root node. The generated ramoops node
+  carries apple,preserve-in-capture so a capture kernel leaves evidence intact.
+  Its address is carried in the kexec FDT, never reallocated on capture boots.
+
+select:
+  properties:
+    compatible:
+      contains:
+        enum:
+          - apple,s8000
+          - apple,s8003
+  required:
+    - compatible
+properties:
+  apple,reserve-pstore:
+    type: boolean
+    description: Reserve an aligned 2 MiB no-map ramoops area before paging.
+
+additionalProperties: true
diff --git a/Documentation/devicetree/bindings/reserved-memory/ramoops.yaml b/Documentation/devicetree/bindings/reserved-memory/ramoops.yaml
index 45cc39ecc..0b349c0ba 100644
--- a/Documentation/devicetree/bindings/reserved-memory/ramoops.yaml
+++ b/Documentation/devicetree/bindings/reserved-memory/ramoops.yaml
@@ -30,6 +30,10 @@ allOf:
   - $ref: reserved-memory.yaml
 
 properties:
+  apple,preserve-in-capture:
+    type: boolean
+    description: Preserve the previous kernel records by refusing capture-kernel probe.
+
   compatible:
     const: ramoops
 
