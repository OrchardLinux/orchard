From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Thu, 19 Nov 2026 00:10:11 +0100
Subject: [PATCH] gpio: apple-d2365: support D2355 and August event interrupts

Restore the J120 experiment's PMIC event-bank match data in the existing interrupt owner. Register saved-mask restoration before writing the initial mask to cover partial transfer failures.

Assisted-by: LLM
---
 drivers/gpio/gpio-apple-d2365.c | 49 +++++++++++++++++++++++++++++----
 1 file changed, 43 insertions(+), 6 deletions(-)

diff --git a/drivers/gpio/gpio-apple-d2365.c b/drivers/gpio/gpio-apple-d2365.c
index baf4b242b..577ce7f0a 100644
--- a/drivers/gpio/gpio-apple-d2365.c
+++ b/drivers/gpio/gpio-apple-d2365.c
@@ -94,7 +94,7 @@
 #define D2365_EVENT_BYTES	30
 #define D2365_GPIO_EVENT	0x30
 
-#define APPLE_PMIC_EVENT_BYTES_MAX	30
+#define APPLE_PMIC_EVENT_BYTES_MAX	32
 #define APPLE_PMIC_EVENTS_MAX		(APPLE_PMIC_EVENT_BYTES_MAX * 8)
 /* The events plus the line interrupt, hwirq nevents. */
 #define APPLE_PMIC_IRQS_MAX		(APPLE_PMIC_EVENTS_MAX + 1)
@@ -520,9 +520,12 @@ static int apple_pmic_gpio_to_irq(struct gpio_chip *chip, unsigned int offset)
 static void apple_pmic_event_restore_mask(void *data)
 {
 	struct apple_pmic_gpio *gpio = data;
+	int ret;
 
-	regmap_bulk_write(gpio->regmap, gpio->info->events->mask_base,
-			  gpio->boot_mask, gpio->info->events->bytes);
+	ret = regmap_bulk_write(gpio->regmap, gpio->info->events->mask_base,
+				gpio->boot_mask, gpio->info->events->bytes);
+	if (ret)
+		dev_err(gpio->chip.parent, "failed to restore the event mask: %d\n", ret);
 }
 
 static void apple_pmic_event_remove_domain(void *data)
@@ -604,15 +607,17 @@ static int apple_pmic_event_probe(struct platform_device *pdev,
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to read the event mask\n");
 
+	/* A failed bulk write can still change part of the mask. */
+	ret = devm_add_action(dev, apple_pmic_event_restore_mask, gpio);
+	if (ret)
+		return ret;
+
 	/* As iOS does at probe: mask all, unmask only what has a consumer. */
 	memset(gpio->mask, 0xff, sizeof(gpio->mask));
 	ret = regmap_bulk_write(gpio->regmap, ev->mask_base, gpio->mask,
 				ev->bytes);
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to mask the events\n");
-	ret = devm_add_action_or_reset(dev, apple_pmic_event_restore_mask, gpio);
-	if (ret)
-		return ret;
 
 	/* The events, then the line interrupt (hwirq nevents). */
 	gpio->domain = irq_domain_create_linear(dev_fwnode(dev),
@@ -995,10 +1000,14 @@ static int apple_pmic_gpio_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, -ENODEV, "parent regmap unavailable\n");
 	gpio->chip.parent = dev;
 
+	gpio->chip.parent = dev;
 	ret = apple_pmic_event_probe(pdev, gpio);
 	if (ret)
 		return ret;
 
+	if (!gpio->info->ngpio)
+		return gpio->domain ? 0 : -EINVAL;
+
 	gpio->chip.label = gpio->info->label;
 	gpio->chip.owner = THIS_MODULE;
 	gpio->chip.base = -1;
@@ -1052,6 +1061,26 @@ static const struct apple_pmic_event_info d2365_event_info = {
 	.gpio_event = D2365_GPIO_EVENT,
 };
 
+static const struct apple_pmic_event_info d2355_event_info = {
+	.status_base = 0x060,
+	.mask_base = 0x0a0,
+	.bytes = 10,
+};
+
+static const struct apple_pmic_gpio_info d2355_events_only = {
+	.events = &d2355_event_info,
+};
+
+static const struct apple_pmic_event_info d2400_event_info = {
+	.status_base = 0x140,
+	.mask_base = 0x1c0,
+	.bytes = 32,
+};
+
+static const struct apple_pmic_gpio_info d2400_events_only = {
+	.events = &d2400_event_info,
+};
+
 static const struct apple_pmic_gpio_info d2365_gpio_info = {
 	.label = "d2365-pmic-gpio",
 	.ngpio = 24,
@@ -1087,6 +1116,14 @@ static const struct apple_pmic_gpio_info d2401_gpio_info = {
 };
 
 static const struct of_device_id d2365_gpio_of_match[] = {
+	{
+		.compatible = "apple,august-pmic-events",
+		.data = &d2400_events_only,
+	},
+	{
+		.compatible = "apple,d2355-pmic-events",
+		.data = &d2355_events_only,
+	},
 	{
 		.compatible = "apple,d2401-pmic-gpio",
 		.data = &d2401_gpio_info,
