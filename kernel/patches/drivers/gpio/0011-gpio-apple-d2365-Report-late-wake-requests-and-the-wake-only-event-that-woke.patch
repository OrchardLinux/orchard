From 04f9215634f8ae5337a30a3d7ffdd11542258deb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 17 Nov 2026 18:19:39 +0100
Subject: [PATCH] gpio: apple-d2365: Report late wake requests and the
 wake-only event that woke

Two things about sleep were silent.

A wake request that arrives after the sleep mask was written (a dedicated
wake IRQ, which the PM core arms at the start of the noirq phase) leaves
its event masked, and the system then does not wake on it. The RTC alarm
did this on the iPad 5. Warn once, naming the event, so that a consumer
doing so is found from its first sleep.

Wake-only events (the Smart Cover halls) have no consumer, so nothing
said which of them ended a sleep. The resume callback already reads the
event block while they are armed: name the wake-only events it found.

Assisted-by: LLM
---
 drivers/gpio/gpio-apple-d2365.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/gpio/gpio-apple-d2365.c b/drivers/gpio/gpio-apple-d2365.c
index 8d40292..c6886f4 100644
--- a/drivers/gpio/gpio-apple-d2365.c
+++ b/drivers/gpio/gpio-apple-d2365.c
@@ -282,6 +282,16 @@ static int apple_pmic_irq_set_wake(struct irq_data *data, unsigned int on)
 	/* The line interrupt only runs while the system is awake. */
 	if (hwirq >= gpio->nevents)
 		return -EINVAL;
+	/*
+	 * The sleep mask was written in our suspend callback and the bus is
+	 * not used again before resume: a wake request arriving now (a
+	 * dedicated wake IRQ, armed at the start of the noirq phase) leaves
+	 * its event masked. Its consumer must arm it in its own suspend.
+	 */
+	if (on && gpio->suspended && !test_bit(hwirq, gpio->wake))
+		dev_warn_once(gpio->chip.parent,
+			      "event 0x%lx armed for wake after the sleep mask was written: it cannot wake this sleep\n",
+			      hwirq);
 	if (on && !test_bit(hwirq, gpio->wake)) {
 		__set_bit(hwirq, gpio->wake);
 		gpio->wake_delta++;
@@ -803,6 +813,13 @@ static int apple_pmic_gpio_resume(struct device *dev)
 		if (!read) {
 			/* Unknown: every consumer may have an event. */
 			bitmap_copy(pending, gpio->enabled, gpio->nevents);
+		} else if (bitmap_intersects(latched, gpio->wake_only, gpio->nevents)) {
+			DECLARE_BITMAP(woke, APPLE_PMIC_EVENTS_MAX);
+
+			/* Nothing else reports these: say which ones ended the sleep. */
+			bitmap_and(woke, latched, gpio->wake_only, gpio->nevents);
+			dev_info(dev, "wake-only event(s) %*pbl latched in sleep\n",
+				 gpio->nevents, woke);
 		}
 		if (gpio->parent_wake_armed) {
 			irq_set_irq_wake(gpio->parent_irq, 0);
