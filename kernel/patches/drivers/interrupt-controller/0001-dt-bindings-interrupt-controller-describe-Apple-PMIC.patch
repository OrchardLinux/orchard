From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Thu, 19 Nov 2026 00:10:11 +0100
Subject: [PATCH] dt-bindings: interrupt-controller: describe Apple PMIC event
 banks

Describe the event-only interrupt domains for D2355 and August D2400 and their parent-line notification.

Assisted-by: LLM
---
 .../apple,pmic-events.yaml                    | 42 +++++++++++++++++++
 1 file changed, 42 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/interrupt-controller/apple,pmic-events.yaml

diff --git a/Documentation/devicetree/bindings/interrupt-controller/apple,pmic-events.yaml b/Documentation/devicetree/bindings/interrupt-controller/apple,pmic-events.yaml
new file mode 100644
index 000000000..8552eaedf
--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/apple,pmic-events.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/apple,pmic-events.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Dialog PMIC event interrupt controller
+
+maintainers:
+  - Paul Praschl <praschlpaul@g-p.at>
+
+description: |
+  These PMICs expose latched events through the parent PMIC register map and
+  signal them on one active-low interrupt. D2355 has 80 event bits and the
+  August D2400 has 256. The first interrupt cell is the event number, or the
+  event count for the parent-line notification delivered before reading events.
+  The second cell specifies edge trigger flags for the nested interrupt.
+
+properties:
+  compatible:
+    enum:
+      - apple,august-pmic-events
+      - apple,d2355-pmic-events
+
+  interrupt-controller: true
+
+  "#interrupt-cells":
+    const: 2
+
+  "#address-cells":
+    const: 0
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - interrupt-controller
+  - "#interrupt-cells"
+  - interrupts
+
+additionalProperties: false
