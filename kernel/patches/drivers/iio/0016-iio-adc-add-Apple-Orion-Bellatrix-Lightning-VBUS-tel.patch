+	  the Orion Bellatrix ADC wired to VBUS.
+
+	  To compile this driver as a module, choose M here. The module
+	  will be called apple-orion-vbus.
+
 config ASPEED_ADC
 	tristate "Aspeed ADC"
 	depends on ARCH_ASPEED || COMPILE_TEST
