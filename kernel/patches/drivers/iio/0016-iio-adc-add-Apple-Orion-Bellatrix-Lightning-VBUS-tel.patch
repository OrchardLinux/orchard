index 000000000..265eb4086
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/adc/apple,orion-bellatrix-vbus.yaml
@@ -0,0 +1,26 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/adc/apple,orion-bellatrix-vbus.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Orion Bellatrix Lightning VBUS ADC
+
+maintainers:
+  - tom <tompt@seznam.cz>
+
+description:
+  Orion Bellatrix provides an ADC input wired to Lightning VBUS on J120.
+
+properties:
+  compatible:
+    const: apple,orion-bellatrix-vbus
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
