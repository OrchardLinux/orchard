From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Sat, 21 Nov 2026 00:50:51 +0100
Subject: [PATCH] iio: light: ct709: expose factory-calibrated illuminance on
 J120

Read the per-unit two-sensor record from the aliased light sensor. Select the orientation for each address and compute illuminance from one fixed-exposure RGBC frame using integer arithmetic. Retain the raw channels when calibration is unavailable.

Assisted-by: LLM
Signed-off-by: tom <tompt@seznam.cz>
---
 drivers/iio/light/ams-ct709-lux.h | 100 ++++++++++++++++++++++++++++++
 drivers/iio/light/ams-ct709.c     |  72 +++++++++++++++++++--
 2 files changed, 166 insertions(+), 6 deletions(-)
 create mode 100644 drivers/iio/light/ams-ct709-lux.h

diff --git a/drivers/iio/light/ams-ct709-lux.h b/drivers/iio/light/ams-ct709-lux.h
new file mode 100644
index 000000000..f27ba94f8
--- /dev/null
+++ b/drivers/iio/light/ams-ct709-lux.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef AMS_CT709_LUX_H
+#define AMS_CT709_LUX_H
+
+#include <linux/errno.h>
+#include <linux/math64.h>
+#include <linux/overflow.h>
+#include <linux/unaligned.h>
+
+/* Fixed exposure: 16x sensor gain and ten integration cycles. */
+struct ct709_lux_cal {
+	u32 gain_q20[4];
+	u16 offset_milli[4];
+	s32 coefficient[4];
+	u32 exposure;
+};
+
+static u32 ct709_gain_step(u16 word)
+{
+	/* Factory gain transitions are Q8. Normalize the ratio to [1.75, 2.4]. */
+	static const u8 num[] = { 1, 1, 5, 2 };
+	static const u8 den[] = { 1, 2, 14, 1 };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(num); i++) {
+		u32 n = word * num[i], d = 256 * den[i];
+
+		if (4 * n >= 7 * d && 5 * n <= 12 * d)
+			return DIV_ROUND_CLOSEST_ULL((u64)n << 20, d);
+	}
+	return DIV_ROUND_CLOSEST_ULL((u64)word * 14 << 12, 5);
+}
+
+/* The caller selects an orientation record validated as native type 3. */
+static int ct709_lux_parse(const u8 *p, size_t size, struct ct709_lux_cal *cal)
+{
+	u32 usec, cycles;
+	unsigned int i, j;
+
+	if (size != 3344 || p[0x68] != 3 || p[16] < 4 || p[16] > 8)
+		return -EINVAL;
+	usec = get_unaligned_le16(p + 10) * 1000;
+	cycles = (usec >> 10) > 694 ? 255 : ((u64)(usec >> 2) * 0x05e4be11) >> 36;
+	cal->exposure = cycles * get_unaligned_le16(p + 8);
+	if (!cal->exposure)
+		return -EINVAL;
+	for (i = 0; i < 4; i++) {
+		const u8 *gains = p + 0x1c + 20 * i;
+		u32 gain = 1U << 20;
+
+		for (j = 4; j < p[16]; j++) {
+			u32 step = ct709_gain_step(get_unaligned_le16(gains + 2 * j));
+			u64 next = ((u64)gain * step + BIT(19)) >> 20;
+
+			if (!next || next > U32_MAX)
+				return -ERANGE;
+			gain = next;
+		}
+		cal->gain_q20[i] = gain;
+		cal->offset_milli[i] = get_unaligned_le16(gains - 3);
+		cal->coefficient[i] = (s32)get_unaligned_le32(p + 0x6c + 4 * i);
+	}
+	return 0;
+}
+
+static int ct709_millilux(const struct ct709_lux_cal *cal,
+			  const u16 channels[4], int *value)
+{
+	const u64 divisor = 2550ULL * 1000000;
+	const u64 ceiling = 150000000ULL * divisor;
+	s64 count[4], sum = 0;
+	unsigned int i;
+
+	/* The frame is CRGB, while the calibration record is RGBC. */
+	for (i = 0; i < 4; i++) {
+		count[i] = ((u64)channels[(i + 1) % 4] * cal->gain_q20[i] *
+			    1000 + BIT(19)) >> 20;
+		if (channels[1])
+			count[i] += cal->offset_milli[i];
+	}
+	if (!channels[1])
+		count[0] = div_s64(max_t(s64, 0, 108 * count[3] -
+					97 * count[1] - 112 * count[2]), 100);
+	for (i = 0; i < 4; i++) {
+		s64 term;
+
+		if (check_mul_overflow(count[i], (s64)cal->coefficient[i], &term) ||
+		    check_add_overflow(sum, term, &sum))
+			return -ERANGE;
+	}
+	if (sum <= 0)
+		*value = 0;
+	else if ((u64)sum > div_u64(ceiling, cal->exposure))
+		*value = 150000000;
+	else
+		*value = DIV_ROUND_CLOSEST_ULL((u64)sum * cal->exposure, divisor);
+	return 0;
+}
+
+#endif
diff --git a/drivers/iio/light/ams-ct709.c b/drivers/iio/light/ams-ct709.c
index d3172c467..691e80fed 100644
--- a/drivers/iio/light/ams-ct709.c
+++ b/drivers/iio/light/ams-ct709.c
@@ -1,6 +1,5 @@
 // SPDX-License-Identifier: GPL-2.0-only
-/* CT709-family bounded raw IIO candidate; IRQ, IR and lux remain unqualified.
- */
+/* CT709 four-channel ambient light sensor. */
 #include <linux/delay.h>
 #include <linux/i2c.h>
 #include <linux/iio/iio.h>
@@ -9,10 +8,12 @@
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include "ams-ct709.h"
+#include "ams-ct709-lux.h"
 
 struct ct709_data {
 	struct i2c_client *client;
 	struct mutex lock;
+	struct ct709_lux_cal calibration;
 	u64 deadline;
 	bool stopping;
 	bool faulted;
@@ -90,7 +91,8 @@ static int ct709_read_raw(struct iio_dev *indio,
 		*value2 = 27800;
 		return IIO_VAL_INT_PLUS_MICRO;
 	}
-	if (mask != IIO_CHAN_INFO_RAW || channel->address >= 4)
+	if (mask != IIO_CHAN_INFO_PROCESSED &&
+	    (mask != IIO_CHAN_INFO_RAW || channel->address >= 4))
 		return -EINVAL;
 	mutex_lock(&d->lock);
 	if (d->stopping || d->faulted) {
@@ -110,6 +112,17 @@ static int ct709_read_raw(struct iio_dev *indio,
 			result.restore_error, result.restored);
 		goto out;
 	}
+	if (mask == IIO_CHAN_INFO_PROCESSED) {
+		int millilux;
+
+		ret = ct709_millilux(&d->calibration, result.channels, &millilux);
+		if (ret)
+			goto out;
+		*value = millilux / 1000;
+		*value2 = (millilux % 1000) * 1000;
+		ret = IIO_VAL_INT_PLUS_MICRO;
+		goto out;
+	}
 	*value = result.channels[channel->address];
 	ret = IIO_VAL_INT;
 out:
@@ -131,8 +144,54 @@ static const struct iio_chan_spec ct709_channels[] = {
 	CT709_CHANNEL(RED, 1),
 	CT709_CHANNEL(GREEN, 2),
 	CT709_CHANNEL(BLUE, 3),
+	{ .type = IIO_LIGHT, .info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED) },
 };
 static const struct iio_info ct709_info = {.read_raw = ct709_read_raw};
+/* J120 stores both orientations in the factory record on the als0 node. */
+static bool ct709_read_calibration(struct i2c_client *client,
+				   struct ct709_lux_cal *cal)
+{
+	struct device_node *owner;
+	const u8 *blob, *record;
+	unsigned int orientation, other, i;
+	int len;
+
+	if (!client->dev.of_node || !of_machine_is_compatible("apple,j120"))
+		return false;
+	owner = of_find_node_by_path("als0");
+	if (!owner)
+		return false;
+	if (!of_device_is_compatible(owner, "apple,ct709") ||
+	    owner->parent != client->dev.of_node->parent)
+		goto out;
+	blob = of_get_property(owner, "apple,als-calibration", &len);
+	if (!blob || len < 6696 || memcmp(blob, "\x02\x01\x02\x08", 4) ||
+	    get_unaligned_le16(blob + 4) != 6696)
+		goto out;
+	if (client->addr != 0x29 && client->addr != 0x39)
+		goto out;
+	orientation = client->addr == 0x29 ? 6 : 5;
+	other = orientation == 6 ? 5 : 6;
+	record = NULL;
+	for (i = 0; i < 2; i++) {
+		const u8 *p = blob + 8 + 3344 * i;
+
+		if (p[0] != 2 || p[1] != 1 || p[3] != 1 ||
+		    get_unaligned_le32(p + 4) != 3344 || p[0x68] != 3)
+			goto out;
+		if (p[2] == orientation && !record)
+			record = p;
+		else if (p[2] != other)
+			goto out;
+	}
+	if (record && !ct709_lux_parse(record, 3344, cal)) {
+		of_node_put(owner);
+		return true;
+	}
+out:
+	of_node_put(owner);
+	return false;
+}
 static int ct709_probe(struct i2c_client *client)
 {
 	struct iio_dev *indio;
@@ -163,7 +222,9 @@ static int ct709_probe(struct i2c_client *client)
 	indio->info = &ct709_info;
 	indio->modes = INDIO_DIRECT_MODE;
 	indio->channels = ct709_channels;
-	indio->num_channels = ARRAY_SIZE(ct709_channels);
+	indio->num_channels = ARRAY_SIZE(ct709_channels) - 1;
+	if (ct709_read_calibration(client, &d->calibration))
+		indio->num_channels++;
 	return devm_iio_device_register(&client->dev, indio);
 }
 static void ct709_remove(struct i2c_client *client)
@@ -187,5 +248,4 @@ static struct i2c_driver ct709_driver = {
 };
 module_i2c_driver(ct709_driver);
 MODULE_LICENSE("GPL");
-MODULE_DESCRIPTION(
-	"Bounded raw CT709 IIO candidate with verified per-frame restore");
+MODULE_DESCRIPTION("Apple CT709 ambient light sensor");
