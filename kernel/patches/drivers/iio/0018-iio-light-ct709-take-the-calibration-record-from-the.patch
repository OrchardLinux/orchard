From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 24 Nov 2026 08:30:40 +0800
Subject: [PATCH] iio: light: ct709: take the calibration record from the
 device tree

Find a sensor's record in the factory calibration by its
apple,als-orientation instead of by the J120's machine compatible and
I2C addresses, so that every board with CT709 sensors can describe its
own. For the J120's two sensors (0x29: record 6, 0x39: record 5) and
its calibration with one record each, the same record is used as
before.

Assisted-by: LLM
---
 .../bindings/iio/light/apple,ct709.yaml       |  9 ++++++++-
 drivers/iio/light/ams-ct709.c                 | 20 +++++++++++--------
 2 files changed, 20 insertions(+), 9 deletions(-)

diff --git a/Documentation/devicetree/bindings/iio/light/apple,ct709.yaml b/Documentation/devicetree/bindings/iio/light/apple,ct709.yaml
index 59a918861..7a77412d6 100644
--- a/Documentation/devicetree/bindings/iio/light/apple,ct709.yaml
+++ b/Documentation/devicetree/bindings/iio/light/apple,ct709.yaml
@@ -11,7 +11,7 @@ maintainers:
 
 description:
   The CT709 measures clear, red, green and blue light intensity over I2C.
-  The J120 board uses two independently addressed sensors.
+  The iPad Pro 2 boards have two independently addressed sensors.
 
 properties:
   compatible:
@@ -30,6 +30,13 @@ properties:
       two 3344-byte orientation records can be followed by padding. The
       property on the als0 node contains records for both sensors.
 
+  apple,als-orientation:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      The orientation index of this sensor's record in the factory
+      calibration (byte 2 of each record). Without it the sensor reports
+      raw channels only.
+
 required:
   - compatible
   - reg
diff --git a/drivers/iio/light/ams-ct709.c b/drivers/iio/light/ams-ct709.c
index 691e80fed..1f4ae39f4 100644
--- a/drivers/iio/light/ams-ct709.c
+++ b/drivers/iio/light/ams-ct709.c
@@ -147,16 +147,23 @@ static const struct iio_chan_spec ct709_channels[] = {
 	{ .type = IIO_LIGHT, .info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED) },
 };
 static const struct iio_info ct709_info = {.read_raw = ct709_read_raw};
-/* J120 stores both orientations in the factory record on the als0 node. */
+/*
+ * Apple stores the records of every CT709 on a bus in one factory
+ * calibration, copied by the boot loader to the als0 node; each sensor's
+ * apple,als-orientation names its record.
+ */
 static bool ct709_read_calibration(struct i2c_client *client,
 				   struct ct709_lux_cal *cal)
 {
 	struct device_node *owner;
 	const u8 *blob, *record;
-	unsigned int orientation, other, i;
+	u32 orientation;
+	unsigned int i;
 	int len;
 
-	if (!client->dev.of_node || !of_machine_is_compatible("apple,j120"))
+	if (!client->dev.of_node ||
+	    of_property_read_u32(client->dev.of_node, "apple,als-orientation",
+				 &orientation))
 		return false;
 	owner = of_find_node_by_path("als0");
 	if (!owner)
@@ -168,10 +175,6 @@ static bool ct709_read_calibration(struct i2c_client *client,
 	if (!blob || len < 6696 || memcmp(blob, "\x02\x01\x02\x08", 4) ||
 	    get_unaligned_le16(blob + 4) != 6696)
 		goto out;
-	if (client->addr != 0x29 && client->addr != 0x39)
-		goto out;
-	orientation = client->addr == 0x29 ? 6 : 5;
-	other = orientation == 6 ? 5 : 6;
 	record = NULL;
 	for (i = 0; i < 2; i++) {
 		const u8 *p = blob + 8 + 3344 * i;
@@ -179,9 +182,10 @@ static bool ct709_read_calibration(struct i2c_client *client,
 		if (p[0] != 2 || p[1] != 1 || p[3] != 1 ||
 		    get_unaligned_le32(p + 4) != 3344 || p[0x68] != 3)
 			goto out;
+		/* Exactly one record per orientation */
 		if (p[2] == orientation && !record)
 			record = p;
-		else if (p[2] != other)
+		else if (p[2] == orientation)
 			goto out;
 	}
 	if (record && !ct709_lux_parse(record, 3344, cal)) {
