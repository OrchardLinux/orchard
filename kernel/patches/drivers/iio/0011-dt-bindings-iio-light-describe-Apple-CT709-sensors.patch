From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tompt@seznam.cz>
Date: Fri, 20 Nov 2026 23:15:43 +0100
Subject: [PATCH] dt-bindings: iio: light: describe Apple CT709 sensors

Document the I2C compatible used for the paired J120 color sensors.

Assisted-by: LLM
---
 .../bindings/iio/light/apple,ct709.yaml       | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/iio/light/apple,ct709.yaml

diff --git a/Documentation/devicetree/bindings/iio/light/apple,ct709.yaml b/Documentation/devicetree/bindings/iio/light/apple,ct709.yaml
new file mode 100644
index 000000000..5a91701fd
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/light/apple,ct709.yaml
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/light/apple,ct709.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple CT709 four-channel ambient light sensor
+
+maintainers:
+  - Linux IIO <linux-iio@vger.kernel.org>
+
+description:
+  The CT709 measures clear, red, green and blue light intensity over I2C.
+  The J120 board uses two independently addressed sensors.
+
+properties:
+  compatible:
+    const: apple,ct709
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
