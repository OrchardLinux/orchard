diff --git a/drivers/iio/light/ams-ct709.c b/drivers/iio/light/ams-ct709.c
new file mode 100644
index 000000000..1bbb372ee
--- /dev/null
+++ b/drivers/iio/light/ams-ct709.c
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* CT709-family bounded raw IIO candidate; IRQ, IR and lux remain unqualified.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/iio/iio.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include "ams-ct709.h"
+
+struct ct709_data {
+	struct i2c_client *client;
+	struct mutex lock;
+	u64 deadline;
+	bool stopping;
+	bool faulted;
+};
+static int ct709_read(void *ctx, u8 reg, u8 *value)
+{
+	struct ct709_data *d = ctx;
+	int ret = i2c_smbus_read_byte_data(d->client, reg);
+
+	if (ret < 0)
+		return ret;
+	*value = ret;
+	return 0;
+}
+static int ct709_write(void *ctx, u8 reg, u8 value)
+{
+	struct ct709_data *d = ctx;
+
+	if (!((reg == 0x80 && (value == 0 || value == 1 || value == 3)) ||
+	      (reg == 0x81 && (value == 0xff || value == 0xf6)) ||
+	      (reg == 0x8f && (value == 0 || value == 2))))
+		return -EPERM;
+	return i2c_smbus_write_byte_data(d->client, reg, value);
+}
+static int ct709_block(void *ctx, u8 reg, u8 *bytes, unsigned int count)
+{
+	struct ct709_data *d = ctx;
+	struct i2c_msg messages[] = {
+	    {.addr = d->client->addr, .len = 1, .buf = &reg},
+	    {.addr = d->client->addr,
+	     .flags = I2C_M_RD,
+	     .len = 8,
+	     .buf = bytes},
+	};
+	int ret;
+
+	if (reg != 0x94 || count != 8)
+		return -EINVAL;
+	ret = i2c_transfer(d->client->adapter, messages, ARRAY_SIZE(messages));
+	return ret < 0 ? ret : ret == ARRAY_SIZE(messages) ? 0 : -EIO;
+}
+static int ct709_delay(void *ctx, unsigned int us)
+{
+	(void)ctx;
+	usleep_range(us, us + 500);
+	return 0;
+}
+static bool ct709_expired(void *ctx)
+{
+	struct ct709_data *d = ctx;
+
+	return ktime_get_ns() >= d->deadline;
+}
+static const struct als_ops ct709_ops = {
+	.read = ct709_read,
+	.write = ct709_write,
+	.block = ct709_block,
+	.delay = ct709_delay,
+	.expired = ct709_expired,
+};
+static int ct709_read_raw(struct iio_dev *indio,
+			  const struct iio_chan_spec *channel, int *value,
+			  int *value2, long mask)
+{
+	struct ct709_data *d = iio_priv(indio);
+	struct als_result result;
+	int ret;
+
+	if (mask == IIO_CHAN_INFO_HARDWAREGAIN) {
+		*value = 16;
+		return IIO_VAL_INT;
+	}
+	if (mask == IIO_CHAN_INFO_INT_TIME) {
+		*value = 0;
+		*value2 = 27800;
+		return IIO_VAL_INT_PLUS_MICRO;
+	}
+	if (mask != IIO_CHAN_INFO_RAW || channel->address >= 4)
+		return -EINVAL;
+	mutex_lock(&d->lock);
+	if (d->stopping || d->faulted) {
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	d->deadline = ktime_get_ns() + 5ULL * NSEC_PER_SEC;
+	ret = als_once(&ct709_ops, d, &result);
+	if (ret || !result.valid || !result.restored) {
+		d->faulted = true;
+		if (!ret)
+			ret = -EIO;
+		dev_err(&d->client->dev,
+			"capture failed %d, restore %d, verified %u\n", ret,
+			result.restore_error, result.restored);
+		goto out;
+	}
+	*value = result.channels[channel->address];
+	ret = IIO_VAL_INT;
+out:
+	mutex_unlock(&d->lock);
+	return ret;
+}
+#define CT709_CHANNEL(color, index)                                            \
+	{                                                                      \
+	    .type = IIO_INTENSITY,                                             \
+	    .modified = 1,                                                     \
+	    .channel2 = IIO_MOD_LIGHT_##color,                                 \
+	    .address = index,                                                  \
+	    .info_mask_separate = BIT(IIO_CHAN_INFO_RAW),                      \
+	    .info_mask_shared_by_type =                                        \
+		BIT(IIO_CHAN_INFO_HARDWAREGAIN) | BIT(IIO_CHAN_INFO_INT_TIME), \
+	}
+static const struct iio_chan_spec ct709_channels[] = {
+	CT709_CHANNEL(CLEAR, 0),
+	CT709_CHANNEL(RED, 1),
+	CT709_CHANNEL(GREEN, 2),
+	CT709_CHANNEL(BLUE, 3),
+};
+static const struct iio_info ct709_info = {.read_raw = ct709_read_raw};
+static int ct709_probe(struct i2c_client *client)
+{
+	struct iio_dev *indio;
+	struct ct709_data *d;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter,
+				     I2C_FUNC_I2C | I2C_FUNC_SMBUS_BYTE_DATA))
+		return -EOPNOTSUPP;
+	ret = i2c_smbus_read_byte_data(client, 0x92);
+	if (ret < 0)
+		return ret;
+	if (ret != 0x8f)
+		return -ENODEV;
+	ret = i2c_smbus_read_byte_data(client, 0x91);
+	if (ret < 0)
+		return ret;
+	if (ret != 0x31)
+		return -ENODEV;
+	indio = devm_iio_device_alloc(&client->dev, sizeof(*d));
+	if (!indio)
+		return -ENOMEM;
+	d = iio_priv(indio);
+	d->client = client;
+	mutex_init(&d->lock);
+	i2c_set_clientdata(client, indio);
+	indio->name = "ct709";
+	indio->info = &ct709_info;
+	indio->modes = INDIO_DIRECT_MODE;
+	indio->channels = ct709_channels;
+	indio->num_channels = ARRAY_SIZE(ct709_channels);
+	return devm_iio_device_register(&client->dev, indio);
+}
+static void ct709_remove(struct i2c_client *client)
+{
+	struct ct709_data *d = iio_priv(i2c_get_clientdata(client));
+
+	mutex_lock(&d->lock);
+	d->stopping = true;
+	mutex_unlock(&d->lock);
+}
+static const struct of_device_id ct709_of_match[] = {
+	{.compatible = "apple,ct709"}, {}};
+MODULE_DEVICE_TABLE(of, ct709_of_match);
+static const struct i2c_device_id ct709_ids[] = {{"ct709"}, {}};
+MODULE_DEVICE_TABLE(i2c, ct709_ids);
+static struct i2c_driver ct709_driver = {
+	.driver = {.name = "ct709", .of_match_table = ct709_of_match},
+	.probe = ct709_probe,
+	.remove = ct709_remove,
+	.id_table = ct709_ids,
+};
+module_i2c_driver(ct709_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION(
+	"Bounded raw CT709 IIO candidate with verified per-frame restore");
diff --git a/drivers/iio/light/ams-ct709.h b/drivers/iio/light/ams-ct709.h
new file mode 100644
index 000000000..7f26a62ab
--- /dev/null
+++ b/drivers/iio/light/ams-ct709.h
@@ -0,0 +1,212 @@
+/* SPDX-License-Identifier: MIT */
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+#endif
+struct als_ops {
+	int (*read)(void *ctx, u8 reg, u8 *value);
+	int (*write)(void *ctx, u8 reg, u8 value);
+	int (*block)(void *ctx, u8 reg, u8 *bytes, unsigned int count);
+	int (*delay)(void *ctx, unsigned int us);
+	bool (*expired)(void *ctx);
+};
+struct als_result {
+	bool changed, restored, valid;
+	u8 original, status;
+	u16 channels[4];
+	int error, restore_error;
+};
+
+static int als_read(const struct als_ops *o, void *ctx, u8 reg, u8 *value)
+{
+	return o->expired(ctx) ? -ETIMEDOUT : o->read(ctx, reg, value);
+}
+
+static int als_write(const struct als_ops *o, void *ctx, u8 reg, u8 value)
+{
+	return o->expired(ctx) ? -ETIMEDOUT : o->write(ctx, reg, value);
+}
+
+static int als_block(const struct als_ops *o, void *ctx, u8 reg, u8 *bytes,
+		     unsigned int count)
+{
+	return o->expired(ctx) ? -ETIMEDOUT : o->block(ctx, reg, bytes, count);
+}
+
+static int als_delay(const struct als_ops *o, void *ctx, unsigned int us)
+{
+	return o->expired(ctx) ? -ETIMEDOUT : o->delay(ctx, us);
+}
+
+static int als_once(const struct als_ops *o, void *ctx, struct als_result *r)
+{
+	u8 v, bytes[8];
+	int ret = 0, wr, rd, err;
+	bool configured = false, disabled, settings;
+
+	*r = (struct als_result){0};
+
+	ret = als_read(o, ctx, 0x92, &v);
+
+	if (ret)
+
+		goto finish;
+	if (v != 0x8f) {
+		ret = -ENODEV;
+		goto finish;
+	}
+	ret = als_read(o, ctx, 0x91, &v);
+	if (ret)
+		goto finish;
+	if (v != 0x31) {
+		ret = -ENODEV;
+		goto finish;
+	}
+	ret = als_read(o, ctx, 0x80, &r->original);
+	if (ret)
+		goto finish;
+	if (r->original != 0) {
+		ret = -EBUSY;
+		goto finish;
+	}
+	ret = als_read(o, ctx, 0x81, &v);
+	if (ret)
+		goto finish;
+	if (v != 0xff) {
+		ret = -EPERM;
+		goto finish;
+	}
+	ret = als_read(o, ctx, 0x8f, &v);
+	if (ret)
+		goto finish;
+	if (v != 0) {
+		ret = -EPERM;
+		goto finish;
+	}
+	/*
+	 * Configure only after exact original admission; any write can be
+	 * ambiguous.
+	 */
+	if (o->expired(ctx)) {
+		ret = -ETIMEDOUT;
+		goto finish;
+	}
+	r->changed = true;
+	configured = true;
+	ret = o->write(ctx, 0x81, 0xf6);
+	if (ret)
+		goto finish;
+	ret = als_read(o, ctx, 0x81, &v);
+	if (ret)
+		goto finish;
+	if (v != 0xf6) {
+		ret = -EIO;
+		goto finish;
+	}
+	ret = als_write(o, ctx, 0x8f, 2);
+	if (ret)
+		goto finish;
+	ret = als_read(o, ctx, 0x8f, &v);
+	if (ret)
+		goto finish;
+	if (v != 2) {
+		ret = -EIO;
+		goto finish;
+	}
+	/*
+	 * A failed write can still have taken effect. Restore on every later
+	 * exit.
+	 */
+	if (o->expired(ctx)) {
+		ret = -ETIMEDOUT;
+		goto finish;
+	}
+	r->changed = true;
+	ret = o->write(ctx, 0x80, 1);
+	if (ret)
+		goto finish;
+	ret = als_read(o, ctx, 0x80, &v);
+	if (ret)
+		goto finish;
+	if (v != 1) {
+		ret = -EIO;
+		goto finish;
+	}
+	ret = als_delay(o, ctx, 5000);
+	if (ret)
+		goto finish;
+	ret = als_write(o, ctx, 0x80, 3);
+	if (ret)
+		goto finish;
+	ret = als_read(o, ctx, 0x80, &v);
+	if (ret)
+		goto finish;
+	if (v != 3) {
+		ret = -EIO;
+		goto finish;
+	}
+	for (unsigned int i = 0; i < 20; i++) {
+		ret = als_delay(o, ctx, 5000);
+		if (ret)
+			goto finish;
+		ret = als_read(o, ctx, 0x93, &r->status);
+		if (ret)
+			goto finish;
+		if (r->status & 0x80) {
+			ret = -ERANGE;
+			goto finish;
+		}
+		if (r->status & 1)
+			break;
+	}
+	if (!(r->status & 1)) {
+		ret = -ETIMEDOUT;
+		goto finish;
+	}
+	ret = als_block(o, ctx, 0x94, bytes, 8);
+	if (ret)
+		goto finish;
+	for (unsigned int i = 0; i < 4; i++)
+		r->channels[i] = (u16)bytes[2 * i] | (u16)bytes[2 * i + 1] << 8;
+	r->valid = true;
+finish:
+	r->error = ret;
+	if (r->changed) {
+		/*
+		 * Restoration is attempted even after deadline/signal; never
+		 * retry enable.
+		 */
+		wr = o->write(ctx, 0x80, r->original);
+		rd = o->read(ctx, 0x80, &v);
+		disabled = !rd && v == r->original;
+		err = wr ? wr : rd ? rd : disabled ? 0 : -EIO;
+		settings = disabled;
+		if (disabled && configured) {
+			wr = o->write(ctx, 0x81, 0xff);
+			rd = o->read(ctx, 0x81, &v);
+			settings = settings && !rd && v == 0xff;
+			if (!err)
+				err = wr ? wr : rd ? rd : v == 0xff ? 0 : -EIO;
+			wr = o->write(ctx, 0x8f, 0);
+			rd = o->read(ctx, 0x8f, &v);
+			settings = settings && !rd && v == 0;
+			if (!err)
+				err = wr ? wr : rd ? rd : v == 0 ? 0 : -EIO;
+			rd = o->read(ctx, 0x80, &v);
+			settings = settings && !rd && v == 0;
+			if (!err)
+				err = rd ? rd : v == 0 ? 0 : -EIO;
+		}
+		r->restored = disabled && settings;
+		r->restore_error = err;
+		if (!ret)
+			ret = r->restore_error;
+	}
+	return ret;
+}
