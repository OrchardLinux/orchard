From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Thu, 12 Nov 2026 09:00:00 +0100
Subject: [PATCH] iio: accel: apple_aop_accel: Support the S8000

The A9's AOP firmware serves the accelerometer like the A10's, with two
differences. It sends no motion reports until it has the unit's factory
calibration and has been told that the calibration is complete, and it
has no separate raw sample stream, so its raw interval has to be 0.

Send the calibration blobs that the bootloader copies from the Apple
device tree into the sensor's node: the offset at low temperature, the
sensitivity (either of two forms) and the interrupt calibration. Select
the calibration table and the raw interval through match data, so that
the T8010 keeps its current behaviour. The S8000's firmware reports in
the sensor's frame, which the board's mount-matrix maps.

Set the report properties through the AOP driver's
apple_aop_set_property() instead of a private copy of the request.

[Orchard: from orchard PR #101, commit a54e2049; the accelerometer part
 of drivers/iio/0005 without the warm-reload code, and the private
 set-property request replaced by apple_aop_set_property()]

Assisted-by: LLM
---
 drivers/iio/accel/Kconfig           |  2 +-
 drivers/iio/accel/apple_aop_accel.c | 59 +++++++++++++++++++++++------
 2 files changed, 49 insertions(+), 12 deletions(-)

diff --git a/drivers/iio/accel/Kconfig b/drivers/iio/accel/Kconfig
index b015981..ed328a5 100644
--- a/drivers/iio/accel/Kconfig
+++ b/drivers/iio/accel/Kconfig
@@ -213,7 +213,7 @@ config APPLE_AOP_ACCEL
 	select IIO_KFIFO_BUF
 	help
 	  Say yes here to get support for the accelerometer that the Always-On
-	  Processor (AOP) of Apple A10 iPads and iPhones serves.
+	  Processor (AOP) of Apple A9 and A10 iPads and iPhones serves.
 
 	  To compile this driver as a module, choose M here: the module will be
 	  called apple_aop_accel.
diff --git a/drivers/iio/accel/apple_aop_accel.c b/drivers/iio/accel/apple_aop_accel.c
index 96c9013..f310af6 100644
--- a/drivers/iio/accel/apple_aop_accel.c
+++ b/drivers/iio/accel/apple_aop_accel.c
@@ -9,9 +9,13 @@
  *
  *   0  u32 sequence
  *   4  u16 reserved
- *   6  s32 x, y, z in 1/65536 g, in the device frame (x right, y up,
- *      z out of the screen; +1 g opposite to gravity)
+ *   6  s32 x, y, z in 1/65536 g
  *  18  u32 timestamp
+ *
+ * The T8010's firmware reports in the device frame (x right, y up, z out of
+ * the screen; +1 g opposite to gravity). The S8000's firmware first needs the
+ * unit's factory calibration and reports in the sensor's frame; the board's
+ * mount-matrix maps it.
  */
 
 #include <linux/iio/buffer.h>
@@ -21,11 +25,11 @@
 #include <linux/mod_devicetable.h>
 #include <linux/mutex.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/soc/apple/aop.h>
 #include <linux/spinlock.h>
 #include <linux/unaligned.h>
 
-#define AOP_SET_PROPERTY		0x4
 #define AOP_PROP_REPORT_INTERVAL	0x00
 #define AOP_PROP_BATCH_INTERVAL		0x16
 #define AOP_PROP_RAW_INTERVAL		0x5c
@@ -41,8 +45,16 @@
 /* 9.80665 m/s^2 / 65536 */
 #define AOP_ACCEL_SCALE_NANO		149637
 
+struct apple_aop_accel_hw {
+	const struct apple_aop_calibration *calibration;
+	unsigned int num_calibration;
+	/* No separate raw sample stream (raw interval 0) */
+	bool no_raw_stream;
+};
+
 struct apple_aop_accel {
 	struct device *dev;
+	const struct apple_aop_accel_hw *hw;
 	const struct apple_aop_service *service;
 	struct iio_mount_matrix orientation;
 
@@ -58,13 +70,9 @@ struct apple_aop_accel {
 
 static int apple_aop_accel_set_property(struct apple_aop_accel *accel, u32 tag, u32 value)
 {
-	__le32 buf[3] = { 0, cpu_to_le32(tag), cpu_to_le32(value) };
-	int ret;
+	__le32 le = cpu_to_le32(value);
 
-	ret = apple_aop_call(accel->service, AOP_SET_PROPERTY, buf, sizeof(buf), NULL, 0);
-	if (ret > 0)
-		ret = -EIO;
-	return ret;
+	return apple_aop_set_property(accel->service, tag, &le, sizeof(le));
 }
 
 static int apple_aop_accel_set_interval(struct apple_aop_accel *accel, u32 interval_us)
@@ -75,7 +83,9 @@ static int apple_aop_accel_set_interval(struct apple_aop_accel *accel, u32 inter
 	int i, ret;
 
 	for (i = 0; i < ARRAY_SIZE(tags); i++) {
-		ret = apple_aop_accel_set_property(accel, tags[i], interval_us);
+		ret = apple_aop_accel_set_property(accel, tags[i],
+						   tags[i] == AOP_PROP_RAW_INTERVAL &&
+						   accel->hw->no_raw_stream ? 0 : interval_us);
 		if (ret)
 			return ret;
 	}
@@ -230,6 +240,7 @@ static int apple_aop_accel_probe(struct platform_device *pdev)
 		return -ENOMEM;
 	accel = iio_priv(indio_dev);
 	accel->dev = dev;
+	accel->hw = device_get_match_data(dev);
 	accel->service = service;
 	mutex_init(&accel->lock);
 	spin_lock_init(&accel->sample_lock);
@@ -252,6 +263,15 @@ static int apple_aop_accel_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	if (accel->hw->num_calibration) {
+		ret = apple_aop_calibrate(service, dev, accel->hw->calibration,
+					  accel->hw->num_calibration);
+		if (ret) {
+			apple_aop_unlisten(service);
+			return dev_err_probe(dev, ret, "failed to calibrate\n");
+		}
+	}
+
 	ret = apple_aop_accel_set_interval(accel, AOP_ACCEL_DEFAULT_US);
 	if (ret) {
 		apple_aop_unlisten(service);
@@ -265,8 +285,25 @@ static int apple_aop_accel_probe(struct platform_device *pdev)
 	return devm_iio_device_register(dev, indio_dev);
 }
 
+/* Offset at low temperature, sensitivity (either), interrupt calibration */
+static const struct apple_aop_calibration apple_aop_accel_s8000_calibration[] = {
+	{ "apple,low-temp-accel-offset", 0x1a, 1 },
+	{ "apple,accel-sensitivity-calibration", 0x0b, 2 },
+	{ "apple,accel-range-sensitivity-cal", 0x27, 2 },
+	{ "apple,accel-interrupt-calibration", 0x19, 3 },
+};
+
+static const struct apple_aop_accel_hw apple_aop_accel_s8000 = {
+	.calibration = apple_aop_accel_s8000_calibration,
+	.num_calibration = ARRAY_SIZE(apple_aop_accel_s8000_calibration),
+	.no_raw_stream = true,
+};
+
+static const struct apple_aop_accel_hw apple_aop_accel_t8010 = { };
+
 static const struct of_device_id apple_aop_accel_of_match[] = {
-	{ .compatible = "apple,t8010-aop-accel" },
+	{ .compatible = "apple,s8000-aop-accel", .data = &apple_aop_accel_s8000 },
+	{ .compatible = "apple,t8010-aop-accel", .data = &apple_aop_accel_t8010 },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, apple_aop_accel_of_match);
-- 
