+++ b/drivers/iio/accel/Kconfig
@@ -213,7 +213,7 @@ config APPLE_AOP_ACCEL
 	select IIO_KFIFO_BUF
 	help
 	  Say yes here to get support for the accelerometer that the Always-On
-	  Processor (AOP) of Apple A10 iPads and iPhones serves.
+	  Processor (AOP) of Apple A9 and A10 iPads and iPhones serves.
 
