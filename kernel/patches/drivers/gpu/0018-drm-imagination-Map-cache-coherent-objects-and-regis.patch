From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Sat, 14 Nov 2026 23:28:12 +0800
Subject: [PATCH] drm/imagination: Map cache-coherent objects and registers for
 a firmware

Two things Apple's A9 firmware needs in its page tables, which are the
kernel VM context's:

Its shared memory is mapped cache coherent (the CC bit of the page table
entries), as Apple's driver maps it. A kernel-only object flag,
PVR_BO_DEVICE_CACHE_COHERENT, asks for it; userspace cannot set it, and
no existing object has it.

It reaches registers outside the GPU (the chip's power block, the
interrupt controller) through its own address space. pvr_vm_map_io()
maps such a range into the kernel VM context, for the firmware only and
past the device cache; pvr_vm_unmap_io() removes it. No memory object
stands behind it, so the VM does not track it and the caller removes it
before the context goes.

Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_gem.h | 11 +++-
 drivers/gpu/drm/imagination/pvr_mmu.c |  2 +-
 drivers/gpu/drm/imagination/pvr_vm.c  | 80 +++++++++++++++++++++++++++
 drivers/gpu/drm/imagination/pvr_vm.h  |  2 +
 4 files changed, 92 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_gem.h b/drivers/gpu/drm/imagination/pvr_gem.h
index 4286e04..efcd270 100644
--- a/drivers/gpu/drm/imagination/pvr_gem.h
+++ b/drivers/gpu/drm/imagination/pvr_gem.h
@@ -52,14 +52,21 @@ struct pvr_file;
  * Firmware options
  *    :PVR_BO_FW_NO_CLEAR_ON_RESET: By default, all FW objects are cleared and reinitialised on hard
  *       reset. Set this flag to override this behaviour and preserve buffer contents on reset.
+ *
+ * Device mapping options
+ *    :PVR_BO_DEVICE_CACHE_COHERENT: Map the object's pages as cache coherent on the device (the
+ *       CC bit of their page table entries). By default it is clear.
  */
 #define PVR_BO_CPU_CACHED BIT_ULL(63)
 
 #define PVR_BO_FW_NO_CLEAR_ON_RESET BIT_ULL(62)
 
-#define PVR_BO_KERNEL_FLAGS_MASK (PVR_BO_CPU_CACHED | PVR_BO_FW_NO_CLEAR_ON_RESET)
+#define PVR_BO_DEVICE_CACHE_COHERENT BIT_ULL(61)
+
+#define PVR_BO_KERNEL_FLAGS_MASK (PVR_BO_CPU_CACHED | PVR_BO_FW_NO_CLEAR_ON_RESET | \
+				  PVR_BO_DEVICE_CACHE_COHERENT)
 
-/* Bits 61..3 are undefined. */
+/* Bits 60..3 are undefined. */
 /* Bits 2..0 are defined in the UAPI. */
 
 /* Other utilities. */
diff --git a/drivers/gpu/drm/imagination/pvr_mmu.c b/drivers/gpu/drm/imagination/pvr_mmu.c
index 72fe583..a4996b9 100644
--- a/drivers/gpu/drm/imagination/pvr_mmu.c
+++ b/drivers/gpu/drm/imagination/pvr_mmu.c
@@ -2607,7 +2607,7 @@ int pvr_mmu_map(struct pvr_mmu_op_context *op_ctx, u64 size, u64 flags,
 
 	memcpy(&ptr_copy, &op_ctx->curr_page, sizeof(ptr_copy));
 
-	flags_raw = pvr_page_flags_raw_create(false, false,
+	flags_raw = pvr_page_flags_raw_create(false, flags & PVR_BO_DEVICE_CACHE_COHERENT,
 					      flags & DRM_PVR_BO_BYPASS_DEVICE_CACHE,
 					      flags & DRM_PVR_BO_PM_FW_PROTECT);
 
diff --git a/drivers/gpu/drm/imagination/pvr_vm.c b/drivers/gpu/drm/imagination/pvr_vm.c
index 7353dbd..bad2742 100644
--- a/drivers/gpu/drm/imagination/pvr_vm.c
+++ b/drivers/gpu/drm/imagination/pvr_vm.c
@@ -26,6 +26,7 @@
 #include <linux/lockdep.h>
 #include <linux/mutex.h>
 #include <linux/overflow.h>
+#include <linux/scatterlist.h>
 #include <linux/stddef.h>
 
 /**
@@ -940,6 +941,85 @@ pvr_vm_unmap_obj(struct pvr_vm_context *vm_ctx, struct pvr_gem_object *pvr_obj,
 	return err;
 }
 
+/**
+ * pvr_vm_map_io() - Map device registers into the kernel VM context
+ * @vm_ctx: The kernel VM context.
+ * @io_addr: Bus address of the registers.
+ * @device_addr: Virtual device address at the start of the mapping.
+ * @size: Size of the mapping.
+ *
+ * For a firmware that reaches registers outside the GPU through its own page
+ * tables. The pages are mapped for the firmware only and bypass the device
+ * cache. No memory object stands behind the mapping, so it is not tracked:
+ * the caller keeps the range free of other mappings and removes it with
+ * pvr_vm_unmap_io() before the context goes.
+ *
+ * Return:
+ *  * 0 on success,
+ *  * -%EINVAL for a userspace context or an address or size that is not
+ *    device page-aligned, or
+ *  * Any error encountered while building the page tables.
+ */
+int
+pvr_vm_map_io(struct pvr_vm_context *vm_ctx, phys_addr_t io_addr, u64 device_addr, u64 size)
+{
+	struct pvr_mmu_op_context *op_ctx;
+	struct sg_table sgt;
+	int err;
+
+	if (vm_ctx->is_userspace_context || !size ||
+	    ((io_addr | device_addr | size) & ~PVR_DEVICE_PAGE_MASK))
+		return -EINVAL;
+
+	err = sg_alloc_table(&sgt, 1, GFP_KERNEL);
+	if (err)
+		return err;
+
+	sg_dma_address(sgt.sgl) = io_addr;
+	sg_dma_len(sgt.sgl) = size;
+
+	op_ctx = pvr_mmu_op_context_create(vm_ctx->mmu_ctx, &sgt, 0, size);
+	if (IS_ERR(op_ctx)) {
+		err = PTR_ERR(op_ctx);
+		goto err_free_table;
+	}
+
+	mutex_lock(&vm_ctx->lock);
+	err = pvr_mmu_map(op_ctx, size,
+			  DRM_PVR_BO_BYPASS_DEVICE_CACHE | DRM_PVR_BO_PM_FW_PROTECT,
+			  device_addr);
+	mutex_unlock(&vm_ctx->lock);
+
+	pvr_mmu_op_context_destroy(op_ctx);
+
+err_free_table:
+	sg_free_table(&sgt);
+
+	return err;
+}
+
+/**
+ * pvr_vm_unmap_io() - Remove a mapping made with pvr_vm_map_io()
+ * @vm_ctx: The kernel VM context.
+ * @device_addr: Virtual device address at the start of the mapping.
+ * @size: Size of the mapping.
+ */
+void
+pvr_vm_unmap_io(struct pvr_vm_context *vm_ctx, u64 device_addr, u64 size)
+{
+	struct pvr_mmu_op_context *op_ctx;
+
+	op_ctx = pvr_mmu_op_context_create(vm_ctx->mmu_ctx, NULL, 0, 0);
+	if (WARN_ON(IS_ERR(op_ctx)))
+		return;
+
+	mutex_lock(&vm_ctx->lock);
+	WARN_ON(pvr_mmu_unmap(op_ctx, device_addr, size));
+	mutex_unlock(&vm_ctx->lock);
+
+	pvr_mmu_op_context_destroy(op_ctx);
+}
+
 /**
  * pvr_vm_unmap() - Unmap an already mapped section of device-virtual memory.
  * @vm_ctx: Target VM context.
diff --git a/drivers/gpu/drm/imagination/pvr_vm.h b/drivers/gpu/drm/imagination/pvr_vm.h
index d3b3f3f..f7a4f1c 100644
--- a/drivers/gpu/drm/imagination/pvr_vm.h
+++ b/drivers/gpu/drm/imagination/pvr_vm.h
@@ -59,6 +59,8 @@ int pvr_vm_unmap_obj(struct pvr_vm_context *vm_ctx,
 		     struct pvr_gem_object *pvr_obj,
 		     u64 device_addr, u64 size);
 int pvr_vm_unmap(struct pvr_vm_context *vm_ctx, u64 device_addr, u64 size);
+int pvr_vm_map_io(struct pvr_vm_context *vm_ctx, phys_addr_t io_addr, u64 device_addr, u64 size);
+void pvr_vm_unmap_io(struct pvr_vm_context *vm_ctx, u64 device_addr, u64 size);
 void pvr_vm_unmap_all(struct pvr_vm_context *vm_ctx);
 
 dma_addr_t pvr_vm_get_page_table_root_addr(struct pvr_vm_context *vm_ctx);
