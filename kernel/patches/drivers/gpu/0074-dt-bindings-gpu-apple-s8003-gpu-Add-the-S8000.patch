From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 23 Nov 2026 23:44:44 +0800
Subject: [PATCH] dt-bindings: gpu: apple,s8003-gpu: Add the S8000

The Samsung A9 (S8000) has the TSMC A9's GPU: the Apple device trees
give it the same registers, interrupts and power gate, with compatible
gpu,s8000 instead of gpu,s8003. Allow "apple,s8000-gpu" with the
S8003's compatible as fallback.

Assisted-by: LLM
---
 .../devicetree/bindings/gpu/apple,s8003-gpu.yaml     | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/gpu/apple,s8003-gpu.yaml b/Documentation/devicetree/bindings/gpu/apple,s8003-gpu.yaml
index 677ac589..6521f082 100644
--- a/Documentation/devicetree/bindings/gpu/apple,s8003-gpu.yaml
+++ b/Documentation/devicetree/bindings/gpu/apple,s8003-gpu.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/gpu/apple,s8003-gpu.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple S8003 (A9) and T7000 (A8) GPU
+title: Apple S8000/S8003 (A9) and T7000 (A8) GPU
 
 maintainers:
   - Berkay Kösebay <brkosebay@users.noreply.github.com>
@@ -23,9 +23,13 @@ description: |
 
 properties:
   compatible:
-    enum:
-      - apple,s8003-gpu
-      - apple,t7000-gpu
+    oneOf:
+      - enum:
+          - apple,s8003-gpu
+          - apple,t7000-gpu
+      - items:
+          - const: apple,s8000-gpu
+          - const: apple,s8003-gpu
 
   reg:
     minItems: 2
