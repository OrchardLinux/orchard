From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 17 Nov 2026 17:47:46 +0800
Subject: [PATCH] drm/imagination: Order submissions per device

The submission order lock became one static mutex for every PowerVR
device in the system, so every submission of every process and device
waited for every other. Its job is to make one device's submission whole
and nest its VM locks: make it a member of the device.

Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_device.c | 4 ++++
 drivers/gpu/drm/imagination/pvr_device.h | 6 ++++++
 drivers/gpu/drm/imagination/pvr_job.c    | 9 +++------
 3 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_device.c b/drivers/gpu/drm/imagination/pvr_device.c
index c160763a3a..81c0b4f095 100644
--- a/drivers/gpu/drm/imagination/pvr_device.c
+++ b/drivers/gpu/drm/imagination/pvr_device.c
@@ -13,6 +13,7 @@
 #include "pvr_stream.h"
 #include "pvr_vm.h"
 
+#include <drm/drm_managed.h>
 #include <drm/drm_print.h>
 
 #include <linux/bitfield.h>
@@ -805,6 +806,9 @@ pvr_device_init(struct pvr_device *pvr_dev)
 	struct device *dev = drm_dev->dev;
 	int err;
 
+	err = drmm_mutex_init(drm_dev, &pvr_dev->submit_order);
+	if (err)
+		return err;
 	spin_lock_init(&pvr_dev->gem_pin_lock);
 	INIT_LIST_HEAD(&pvr_dev->gem_pin_accounts);
 
diff --git a/drivers/gpu/drm/imagination/pvr_device.h b/drivers/gpu/drm/imagination/pvr_device.h
index 24b4dd03d5..e5414e8ca4 100644
--- a/drivers/gpu/drm/imagination/pvr_device.h
+++ b/drivers/gpu/drm/imagination/pvr_device.h
@@ -94,6 +94,12 @@ struct pvr_device {
 	 */
 	struct drm_device base;
 
+	/**
+	 * @submit_order: Makes a submission whole and nests its VM locks
+	 * outside reservation locking and job arming (pvr_submit_jobs()).
+	 */
+	struct mutex submit_order;
+
 	/** @gem_pin_lock: Protects the GEM pin budget and per-process accounts. */
 	spinlock_t gem_pin_lock;
 	/** @gem_pin_accounts: Live BO owners, keyed by their TGID's struct pid. */
diff --git a/drivers/gpu/drm/imagination/pvr_job.c b/drivers/gpu/drm/imagination/pvr_job.c
index 0d9b9aaf29..d4e7e8869c 100644
--- a/drivers/gpu/drm/imagination/pvr_job.c
+++ b/drivers/gpu/drm/imagination/pvr_job.c
@@ -740,9 +740,6 @@ pvr_jobs_link_geom_frag(struct pvr_job_data *job_data, u32 *job_count)
  *  * -%EINVAL on invalid arguments, or
  *  * Any other error.
  */
-/* Nest all submission VM locks outside reservation locking and job arming. */
-static DEFINE_MUTEX(pvr_submit_order);
-
 int
 pvr_submit_jobs(struct pvr_device *pvr_dev, struct pvr_file *pvr_file,
 		struct drm_pvr_ioctl_submit_jobs_args *args)
@@ -801,7 +798,7 @@ pvr_submit_jobs(struct pvr_device *pvr_dev, struct pvr_file *pvr_file,
 		err = -ENOMEM;
 		goto out_exec_fini_unlocked;
 	}
-	err = mutex_lock_interruptible(&pvr_submit_order);
+	err = mutex_lock_interruptible(&pvr_dev->submit_order);
 	if (err)
 		goto out_exec_fini_unlocked;
 	for (u32 i = 0; i < jobs_alloced; i++) {
@@ -812,7 +809,7 @@ pvr_submit_jobs(struct pvr_device *pvr_dev, struct pvr_file *pvr_file,
 			;
 		if (j != vm_count)
 			continue;
-		pvr_vm_submit_lock(vm, &pvr_submit_order);
+		pvr_vm_submit_lock(vm, &pvr_dev->submit_order);
 		vms[vm_count++] = vm;
 	}
 
@@ -868,7 +865,7 @@ pvr_submit_jobs(struct pvr_device *pvr_dev, struct pvr_file *pvr_file,
 	drm_exec_fini(&exec);
 	while (vm_count)
 		pvr_vm_submit_unlock(vms[--vm_count]);
-	mutex_unlock(&pvr_submit_order);
+	mutex_unlock(&pvr_dev->submit_order);
 	goto out_sync_cleanup;
 out_exec_fini_unlocked:
 	drm_exec_fini(&exec);
