From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:09:00 +0100
Subject: [PATCH] drm/imagination: apple: Check the A8's completions in the
 interrupt's thread

On the A8 a job's completion waited on the host: the firmware
interrupt's hard handler queued the poll work item, and a job not yet
seen done was found by the backup check up to 1 ms later. A compute job
took 6.9 ms wall clock, and most firmware interrupts came before their
job's finish stamp was in memory, so their check found nothing and the
job waited for the next period. And a publish could leave a job in the
firmware's ring whose fence had already failed:

- On a chip with &pvr_apple_chip.irq_thread (the T7000) the firmware
  interrupt is threaded. The hard handler acknowledges it and wakes its
  thread, which runs the completion check itself, as Apple's kext drains
  its rings in its interrupt event source's work loop. The work item
  stays the backup, every a8_poll_us (default 250, 20..1000) while jobs
  are pending. Both may run at once: fences are retired under fence_lock
  and the rings drained under the chip's lock. Teardown waits for the
  thread before the firmware's pages go.
- An interrupt whose check finds its job not yet done in memory checks
  again after a8_recheck_us (default 20, 5..250), then in the fast
  period as before.
- A soak faulted after about 92k jobs with "doorbell not rung: Fender
  state 0x1, PLL5 0x0", a failed fragment job and then a 3D read at VA
  0x40 in the job's context. The publish had written the work-ring
  entry, the host watermark and the producer index and only then
  refused the doorbell, so the firmware ran a job whose fence had
  already failed. Every refusal (stuck firmware, the work ring's slot)
  is now checked in t7000_publish_check() before the job's numbers,
  record or VM state move, and the publish itself cannot fail.
- The doorbell is Apple's kick: Fender's wake, the state read, the
  scheduler register written. In state 1 Apple reads no PLL (the
  firmware's idle gating and DVFS relock PLL5 while the state reads 1),
  so a doorbell with PLL5 relocking is rung and logged. State 0 with
  Fender's control 0 or the snoop not armed is still not rung; the job
  then waits for the reset.

The A9 and A10 keep the plain handler, the work item, their doorbell and
a 1 ms backup period: the new hooks are set only in the T7000 table.

Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_apple.c       |  57 ++++++-
 drivers/gpu/drm/imagination/pvr_apple_chip.h  |  11 ++
 drivers/gpu/drm/imagination/pvr_apple_s8003.c | 161 +++++++++++++-----
 3 files changed, 187 insertions(+), 42 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_apple.c b/drivers/gpu/drm/imagination/pvr_apple.c
index 02cfd5698b..0bc190df8f 100644
--- a/drivers/gpu/drm/imagination/pvr_apple.c
+++ b/drivers/gpu/drm/imagination/pvr_apple.c
@@ -148,6 +148,7 @@ int pvr_apple_fender_power_on(struct pvr_apple *apple)
 }
 
 static void pvr_apple_poll_work(struct work_struct *work);
+static void pvr_apple_check(struct pvr_apple *apple, bool from_irq);
 static enum hrtimer_restart pvr_apple_poll_timer(struct hrtimer *timer);
 static u32 pvr_apple_frag_retired(struct pvr_apple *apple);
 
@@ -1209,10 +1210,23 @@ static irqreturn_t pvr_apple_firmware_irq(int irq, void *data)
 
 	/* At its source first, as Apple's kext does before it reads the rings */
 	apple->chip->irq_ack(apple);
+	if (apple->chip->irq_thread)
+		return READ_ONCE(apple->stopping) ? IRQ_HANDLED : IRQ_WAKE_THREAD;
 	pvr_apple_firmware_event(apple);
 	return IRQ_HANDLED;
 }
 
+/*
+ * &pvr_apple_chip.irq_thread: the completion check runs in the interrupt's
+ * thread, as Apple's kext drains its rings in its interrupt event source's
+ * work loop, not in a work item behind it.
+ */
+static irqreturn_t pvr_apple_firmware_irq_thread(int irq, void *data)
+{
+	pvr_apple_check(data, true);
+	return IRQ_HANDLED;
+}
+
 /**
  * pvr_apple_firmware_irq_init() - Take the firmware's interrupt
  * @apple: Apple firmware state.
@@ -1230,8 +1244,13 @@ int pvr_apple_firmware_irq_init(struct pvr_apple *apple, int irq)
 
 	if (!apple->chip->irq_ack || !apple->chip->irq_poll_us)
 		return -EINVAL;
-	err = devm_request_irq(dev, irq, pvr_apple_firmware_irq, IRQF_NO_AUTOEN,
-			       "apple-gfx-fw", apple);
+	if (apple->chip->irq_thread)
+		err = devm_request_threaded_irq(dev, irq, pvr_apple_firmware_irq,
+						pvr_apple_firmware_irq_thread,
+						IRQF_NO_AUTOEN | IRQF_ONESHOT, "apple-gfx-fw", apple);
+	else
+		err = devm_request_irq(dev, irq, pvr_apple_firmware_irq, IRQF_NO_AUTOEN,
+				       "apple-gfx-fw", apple);
 	if (err)
 		return err;
 	apple->fw_irq = irq;
@@ -1254,7 +1273,17 @@ static void pvr_apple_fw_irq_set_locked(struct pvr_apple *apple, bool on)
 /* Signal the fences of retired jobs; check again while any are pending. */
 static void pvr_apple_poll_work(struct work_struct *work)
 {
-	struct pvr_apple *apple = container_of(work, struct pvr_apple, poll_work.work);
+	pvr_apple_check(container_of(work, struct pvr_apple, poll_work.work), false);
+}
+
+/*
+ * The completion check: from the poll work, or on a chip with
+ * &pvr_apple_chip.irq_thread from the firmware interrupt's thread
+ * (@from_irq). Both may run at once: the fences are retired under
+ * fence_lock, the rings drained under the chip's own lock.
+ */
+static void pvr_apple_check(struct pvr_apple *apple, bool from_irq)
+{
 	struct pvr_apple_fence *fence, *tmp;
 	unsigned int retired = 0, us;
 	bool pending = false, irq_on;
@@ -1308,6 +1337,20 @@ static void pvr_apple_poll_work(struct work_struct *work)
 
 	if (!pending || READ_ONCE(apple->stopping))
 		return;
+	/*
+	 * An interrupt that found its job not yet done in memory: the
+	 * firmware is ahead of its stamp. Check again soon, not only at the
+	 * backup period.
+	 */
+	if (from_irq && !retired) {
+		pvr_apple_firmware_progress(apple);
+		/* a chip's own, shorter first re-check */
+		if (apple->chip->recheck_us) {
+			us = apple->chip->recheck_us(apple);
+			hrtimer_start(&apple->poll_timer, us_to_ktime(max(us, 5U)), HRTIMER_MODE_REL);
+			return;
+		}
+	}
 	/*
 	 * Without the firmware's interrupt (the A10's firmware sends no
 	 * completion message in this setup) poll. With it, check again
@@ -1316,7 +1359,7 @@ static void pvr_apple_poll_work(struct work_struct *work)
 	 */
 	us = READ_ONCE(pvr_apple_poll_us);
 	if (irq_on && !ktime_before(ktime_get(), READ_ONCE(apple->fast_until)))
-		us = apple->chip->irq_poll_us;
+		us = apple->chip->poll_us ? apple->chip->poll_us(apple) : apple->chip->irq_poll_us;
 	hrtimer_start(&apple->poll_timer, us_to_ktime(max(us, 10U)), HRTIMER_MODE_REL);
 }
 
@@ -2154,6 +2197,12 @@ void pvr_apple_fw_fini(struct pvr_device *pvr_dev)
 	cancel_delayed_work_sync(&apple->poll_work);
 	pvr_apple_forget_scenes(apple);
 	pvr_apple_cancel_fences(apple, -ENODEV);
+	/* the interrupt is off now; a check its thread runs reads the rings */
+	if (apple->chip->irq_thread && apple->fw_irq) {
+		synchronize_irq(apple->fw_irq);
+		hrtimer_cancel(&apple->poll_timer);
+		cancel_delayed_work_sync(&apple->poll_work);
+	}
 	pvr_apple_gpu_pages_fini(apple);
 	if (apple->pm_pages) {
 		/* free lists still holding the pages keep their own references */
diff --git a/drivers/gpu/drm/imagination/pvr_apple_chip.h b/drivers/gpu/drm/imagination/pvr_apple_chip.h
index 4e2d9a4870..53850fd129 100644
--- a/drivers/gpu/drm/imagination/pvr_apple_chip.h
+++ b/drivers/gpu/drm/imagination/pvr_apple_chip.h
@@ -247,6 +247,10 @@ struct pvr_apple {
  *	gives up says so, from memory only. A client that closes, or a VM
  *	that goes, then waits at most that one timeout under submit_lock. A
  *	job refused before the chip's own submit path says why.
+ * @irq_thread: The completion check runs in the firmware interrupt's thread
+ *	(and the poll work as the backup), not only in a work item the
+ *	interrupt queues; an interrupt that finds its job not yet in memory
+ *	checks again within the fast period.
  * @fault_skips_done: A firmware fault resets through the oldest job its
  *	engine has not finished, not one finished but not yet retired.
  * @submit: Hand @job to the firmware. Takes &pvr_apple.submit_lock itself.
@@ -257,6 +261,10 @@ struct pvr_apple {
  * @max_power_state: Highest state licensed for fault capture; optional.
  * @report_fault: Capture the MMU fault state after a firmware fault, in place
  *	of the licence-checked bank read (pvr_apple_report_mmu_fault()); optional.
+ * @poll_us: The backup check period with the interrupt taken, in place of
+ *	@irq_poll_us (a tunable); optional.
+ * @recheck_us: After an interrupt whose check found nothing, the delay of
+ *	the first re-check, in place of the fast period; optional.
  * @events: Read what the firmware posted. Before @engine_done wherever a job
  *	is waited for; may sleep.
  * @vm_init: A userspace VM was created: map what the firmware needs in it.
@@ -291,6 +299,7 @@ struct pvr_apple_chip {
 	unsigned int gate_off_ms;
 	bool wait_deadline;
 	bool fault_skips_done;
+	bool irq_thread;
 	/* With the firmware's interrupt taken: microseconds between checks while jobs are pending */
 	unsigned int irq_poll_us;
 	const struct drm_pvr_heap *heaps;
@@ -311,6 +320,8 @@ struct pvr_apple_chip {
 	void (*write_frag)(struct pvr_apple *apple, u32 seq, const void *hw);
 	void (*report_hang)(struct pvr_apple *apple);
 	void (*report_fault)(struct pvr_apple *apple);
+	unsigned int (*poll_us)(struct pvr_apple *apple);
+	unsigned int (*recheck_us)(struct pvr_apple *apple);
 
 	int (*prepare_job)(struct pvr_apple *apple, struct pvr_job *job);
 	int (*submit)(struct pvr_apple *apple, struct pvr_job *job);
diff --git a/drivers/gpu/drm/imagination/pvr_apple_s8003.c b/drivers/gpu/drm/imagination/pvr_apple_s8003.c
index f6a74fad8f..6babaec38a 100644
--- a/drivers/gpu/drm/imagination/pvr_apple_s8003.c
+++ b/drivers/gpu/drm/imagination/pvr_apple_s8003.c
@@ -4115,39 +4115,63 @@ static void t7000_idle(struct pvr_apple *apple)
 /*
  * Apple's kick, the same in all five of its MTS_SCHEDULE writers (TA
  * 0x846f220, 3D 0x846f408, CL 0x846f5f0, device control 0x846f9a0; COUNTED
- * and the data master): Fender's wake, the power state read, then the META's
- * scheduler register. In state 0 (the firmware idled the core) Apple rings
- * as long as Fender is set up and the snoop is armed; with that write Fender
- * wakes the core (on the iPod: state 1 and the PLL locked within 1 ms).
- * Apple restarts the firmware when Fender's control is 0 and warns when the
- * snoop is not armed; this driver refuses both. In state 1 the PLL must be
- * locked, as for every access to the Rogue registers.
+ * and the data master): Fender's wake (+0x14 = 7, 0x847a640), the power
+ * state read (+0x1000 & 0xf, 0x8477020), then the META's scheduler
+ * register, written in every case. Only in state 0 (the firmware idled the
+ * core) does Apple look further: with Fender's control 0 it restarts the
+ * firmware (0x846dc1c), with the snoop not armed it warns; with the wake
+ * write Fender wakes the core (on the iPod: state 1 and the PLL locked
+ * within 1 ms). In state 1 Apple reads no PLL: the firmware's own power
+ * and clock changes (its idle gating, DVFS) can leave PLL5 relocking while
+ * the state reads 1 (iOS shows that in 30 of 200 draw rounds), and Apple
+ * rings then too, and so does this driver. It
+ * still does not write the register with Fender's control 0 or the snoop
+ * not armed in state 0 (never seen here; Apple's restart is not
+ * implemented): the job is then in the ring and its wait ends in the reset.
+ *
+ * Nothing here fails: a job's publish checks first (t7000_publish_check()).
  */
-static int t7000_doorbell(struct pvr_apple *apple, u32 dm)
+static void t7000_ring(struct pvr_apple *apple, u32 dm)
 {
 	struct pvr_apple_s8003 *s = apple->chip_data;
 	u32 state, pll, ctrl, snoop;
 
-		return -EIO;
+	if (s->stuck) {
+		dev_err_ratelimited(apple_dev(apple),
+				    "doorbell not rung: the GPU is stuck; the job waits for the reset\n");
+		return;
+	}
 	mb();	/* what the firmware is rung for is in memory */
 	writel(FENDER_WAKE_ALL, apple->fender + FENDER_WAKE);
 	state = readl(apple->fender + FENDER_POWER_STATE);
-	pll = pmgr_read(s, T7000_PMGR_PLL5);
 	if (!(state & 0xf)) {
 		ctrl = readl(apple->fender + FENDER_CTRL);
 		snoop = readl(apple->fender + T7000_FENDER_SNOOP);
 		if (!ctrl || (!(ctrl & T7000_FENDER_CTRL_SNOOP) && !(snoop & BIT(1)))) {
 			dev_err_ratelimited(apple_dev(apple),
-					    "doorbell not rung: Fender state %#x, control %#x, snoop %#x\n",
+					    "doorbell not rung: Fender state %#x, control %#x, snoop %#x; the job waits for the reset\n",
 					    state, ctrl, snoop);
-			return -EIO;
+			return;
 		}
-	} else if (!(pll & T7000_PLL_LOCKED)) {
-		dev_err_ratelimited(apple_dev(apple),
-				    "doorbell not rung: Fender state %#x, PLL5 %#x\n", state, pll);
-		return -EIO;
+	} else {
+		/* logged only: Apple reads no PLL here */
+		pll = pmgr_read(s, T7000_PMGR_PLL5);
+		if (!(pll & T7000_PLL_LOCKED))
+			dev_info_ratelimited(apple_dev(apple),
+					     "doorbell rung with PLL5 relocking, as Apple's kext rings: Fender state %#x, PLL5 %#x\n",
+					     state, pll);
 	}
 	pvr_cr_write32(apple->pvr_dev, ROGUE_CR_MTS_SCHEDULE, ROGUE_CR_MTS_SCHEDULE_TASK_COUNTED | dm);
+}
+
+/* The variant's doorbell, for device-control commands */
+static int t7000_doorbell(struct pvr_apple *apple, u32 dm)
+{
+	struct pvr_apple_s8003 *s = apple->chip_data;
+
+	if (s->stuck)
+		return -EIO;
+	t7000_ring(apple, dm);
 	return 0;
 }
 
@@ -4197,14 +4221,42 @@ static u32 t7000_engine_done(struct pvr_apple *apple, enum pvr_apple_engine engi
 	return latest + min(behind, 0);
 }
 
+/*
+ * Everything that can refuse a job's publish, checked before the job's
+ * record, numbers or VM state move: a refused job leaves nothing the
+ * firmware could run. Once, a publish refused after the producer index was
+ * written (the doorbell's PLL check) left the 3D job in the work ring; the
+ * firmware took it un-rung while its fence had already failed, and the 3D
+ * engine faulted in the job's context. The work ring's slot is free once
+ * the firmware took the previous entry (it takes one at once); submit_lock
+ * keeps it so until t7000_publish().
+ */
+static int t7000_publish_check(struct pvr_apple *apple, enum pvr_apple_engine engine)
+{
+	struct pvr_apple_s8003 *s = apple->chip_data;
+	u8 *ctl = s8003_object(s, S8003_WORK_CTL + 4 * s8003_engine(engine));
+	u32 start = ring_read(ctl, S8003_RING_PRODUCER), consumer;
+
+	lockdep_assert_held(&apple->submit_lock);
+	if (s->stuck)
+		return -EIO;
+	if (start >= APPLE_RING_ENTRIES)
+		return -EPROTO;
+	return read_poll_timeout(s8003_ring_consumer, consumer, consumer == start, 20,
+				 S8003_RING_TIMEOUT_US, false, apple, ctl);
+}
+
 /*
  * Tell the firmware that @engine's pointer ring is filled up to @end: an
  * entry of the engine's work ring {engine, channel, end}, with Apple's 1 in
  * its fourth word on a render channel (P5b), the host's watermark, the work
  * ring's producer index, and Apple's kick with the engine's data master (TA
- * DM0, 3D DM1, CL DM2: 0x846f220, 0x846f408, 0x846f5f0).
+ * DM0, 3D DM1, CL DM2: 0x846f220, 0x846f408, 0x846f5f0). After
+ * t7000_publish_check() under the same hold of submit_lock; it does not
+ * fail: once the producer index is written the job is the firmware's, and
+ * its fence follows the firmware's progress, a fault or the reset.
  */
-static int t7000_publish(struct pvr_apple *apple, enum pvr_apple_engine engine, u32 end)
+static void t7000_publish(struct pvr_apple *apple, enum pvr_apple_engine engine, u32 end)
 {
 	static const u32 dm[] = {
 		ROGUE_CR_MTS_SCHEDULE_DM_DM0, ROGUE_CR_MTS_SCHEDULE_DM_DM1, ROGUE_CR_MTS_SCHEDULE_DM_DM2,
@@ -4214,17 +4266,9 @@ static int t7000_publish(struct pvr_apple *apple, enum pvr_apple_engine engine,
 	u8 *ctl = s8003_object(s, S8003_WORK_CTL + 4 * fw_engine);
 	u8 *ring = s8003_object(s, S8003_WORK_RING + 4 * fw_engine);
 	u32 host = engine == APPLE_ENGINE_COMPUTE ? S8003_CH_CTL : T7000_RCH_CTL;
-	u32 start = ring_read(ctl, S8003_RING_PRODUCER), consumer;
+	u32 start = ring_read(ctl, S8003_RING_PRODUCER);
 	u8 *p = s8003_channel(s, engine), *entry;
-	int err;
 
-	if (start >= APPLE_RING_ENTRIES)
-		return -EPROTO;
-	/* The firmware takes a work-ring entry at once; the ring never holds two */
-	err = read_poll_timeout(s8003_ring_consumer, consumer, consumer == start, 20,
-				S8003_RING_TIMEOUT_US, false, apple, ctl);
-	if (err)
-		return err;
 	entry = ring + start * S8003_DC_SIZE;
 	memset(entry, 0, S8003_DC_SIZE);
 	put32(entry, fw_engine);
@@ -4237,7 +4281,7 @@ static int t7000_publish(struct pvr_apple *apple, enum pvr_apple_engine engine,
 	wmb();
 	WRITE_ONCE(*(__le32 *)(ctl + S8003_RING_PRODUCER),
 		   cpu_to_le32((start + 1) % APPLE_RING_ENTRIES));
-	return t7000_doorbell(apple, dm[fw_engine]);
+	t7000_ring(apple, dm[fw_engine]);
 }
 
 /* The A8's compute record: the A9's with every offset from 0x10 on 8 further */
@@ -4269,6 +4313,9 @@ static int t7000_submit_compute(struct pvr_apple *apple, struct s8003_vm *vm, st
 	err = s8003_wait_done(apple, APPLE_ENGINE_COMPUTE, apple->last_seq);
 	if (err)
 		return s8003_submit_error(apple, vm, "compute", err, "record slot wait");
+	err = t7000_publish_check(apple, APPLE_ENGINE_COMPUTE);
+	if (err)
+		return s8003_submit_error(apple, vm, "compute", err, "publish");
 	seq = apple->last_seq + 1;
 	k = seq - 1;
 	{
@@ -4315,9 +4362,7 @@ static int t7000_submit_compute(struct pvr_apple *apple, struct s8003_vm *vm, st
 	put32(work + 0x27c, k);
 	put32(p + S8003_CH_RING + ((seq - 1) % S8003_CH_ENTRIES) * 4, w);
 	apple->last_seq = seq;
-	err = t7000_publish(apple, APPLE_ENGINE_COMPUTE, seq % S8003_CH_ENTRIES);
-	if (err)
-		return s8003_submit_error(apple, vm, "compute", err, "publish");
+	t7000_publish(apple, APPLE_ENGINE_COMPUTE, seq % S8003_CH_ENTRIES);
 	return seq;
 }
 
@@ -4993,6 +5038,9 @@ static int t7000_submit_geom(struct pvr_apple *apple, struct s8003_vm *vm, struc
 	err = s8003_wait_done(apple, APPLE_ENGINE_GEOM, apple->ta_seq);
 	if (err)
 		return s8003_submit_error(apple, vm, "geometry", err, "record slot wait");
+	err = t7000_publish_check(apple, APPLE_ENGINE_GEOM);
+	if (err)
+		return s8003_submit_error(apple, vm, "geometry", err, "publish");
 
 	seq = apple->ta_seq + 1;
 	slice_addr = job->hwrt->data.rgn_header_dev_addr +
@@ -5015,9 +5063,7 @@ static int t7000_submit_geom(struct pvr_apple *apple, struct s8003_vm *vm, struc
 	vm->t7000.ta_seq = seq;
 	vm->t7000.rgn_addr = slice_addr;
 	apple->ta_seq = seq;
-	err = t7000_publish(apple, APPLE_ENGINE_GEOM, seq % T7000_RCH_ENTRIES);
-	if (err)
-		return s8003_submit_error(apple, vm, "geometry", err, "publish");
+	t7000_publish(apple, APPLE_ENGINE_GEOM, seq % T7000_RCH_ENTRIES);
 	return seq;
 }
 
@@ -5047,6 +5093,9 @@ static int t7000_submit_frag(struct pvr_apple *apple, struct s8003_vm *vm, struc
 	err = s8003_wait_done(apple, APPLE_ENGINE_FRAG, apple->frag_seq);
 	if (err)
 		return s8003_submit_error(apple, vm, "fragment", err, "record slot wait");
+	err = t7000_publish_check(apple, APPLE_ENGINE_FRAG);
+	if (err)
+		return s8003_submit_error(apple, vm, "fragment", err, "publish");
 
 	seq = apple->frag_seq + 1;
 	err = t7000_fill_3d(p + T7000_RCH_W, job->cmd, &rt, vm->t7000.rgn_addr);
@@ -5072,9 +5121,7 @@ static int t7000_submit_frag(struct pvr_apple *apple, struct s8003_vm *vm, struc
 
 	vm->t7000.open = false;
 	apple->frag_seq = seq;
-	err = t7000_publish(apple, APPLE_ENGINE_FRAG, (2 * seq) % T7000_RCH_ENTRIES);
-	if (err)
-		return s8003_submit_error(apple, vm, "fragment", err, "publish");
+	t7000_publish(apple, APPLE_ENGINE_FRAG, (2 * seq) % T7000_RCH_ENTRIES);
 	return seq;
 }
 
@@ -5308,6 +5355,36 @@ static void t7000_report_hang(struct pvr_apple *apple)
 	t7000_report_bif(apple, "hang");
 }
 
+/*
+ * The backup completion check's period while jobs are pending (with the
+ * interrupt taken): the firmware raises its interrupt some time after it
+ * writes a job's stamp, and in one measurement the 250 us check found 71% of
+ * the jobs first. A tunable, to measure the trade against CPU wake-ups.
+ */
+static unsigned int a8_poll_us = 250;
+module_param(a8_poll_us, uint, 0644);
+MODULE_PARM_DESC(a8_poll_us, "A8: backup completion check period in us while jobs are pending (20..1000, default 250)");
+
+static unsigned int t7000_poll_us(struct pvr_apple *apple)
+{
+	return clamp(READ_ONCE(a8_poll_us), 20u, 1000u);
+}
+
+/*
+ * An interrupt whose check finds its job not done in memory yet: measurements show
+ * that is most of them (interrupts that found nothing ~5200 against ~1950
+ * that found their job), and the 100 us fast period then found the job.
+ * The first re-check comes sooner; the fast period follows.
+ */
