From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 15 Nov 2026 18:28:34 +0100
Subject: [PATCH] drm/imagination: apple: Require each chip's own register
 extension

Every geometry and fragment job on the iPad 5 is refused with -EINVAL,
without a log line. The stream parser requires the A10's type-1 register
extension on every Apple chip, while the A9 supplies its registers in
extension type 2.

Put each chip's required extension type and mask beside its stream
definitions and obtain them through an Apple accessor. Keep the A10's
values and leave compute without an Apple must-have entry.

Affects the Apple A9 (S8003). The A10's validation values are unchanged.

Assisted-by: LLM
Signed-off-by: Berkay Kösebay <brkosebay@users.noreply.github.com>
Link: https://github.com/OrchardLinux/orchard/pull/231#issuecomment-7138590680
---
 drivers/gpu/drm/imagination/pvr_apple.c       | 26 +++++++++++++++++++
 drivers/gpu/drm/imagination/pvr_apple.h       |  9 +++++++
 drivers/gpu/drm/imagination/pvr_apple_chip.h  |  8 ++++++
 drivers/gpu/drm/imagination/pvr_apple_s8003.c |  4 +++
 drivers/gpu/drm/imagination/pvr_apple_t8010.c |  4 +++
 drivers/gpu/drm/imagination/pvr_stream.c      | 11 +++++---
 6 files changed, 58 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_apple.c b/drivers/gpu/drm/imagination/pvr_apple.c
index e147626..b0505a2 100644
--- a/drivers/gpu/drm/imagination/pvr_apple.c
+++ b/drivers/gpu/drm/imagination/pvr_apple.c
@@ -1636,3 +1636,29 @@ const struct pvr_stream_cmd_defs *pvr_apple_cmd_stream(struct pvr_device *pvr_de
 		return chip->compute_stream ?: &pvr_cmd_compute_stream;
 	return type == DRM_PVR_JOB_TYPE_GEOMETRY ? chip->geom_stream : chip->frag_stream;
 }
+
+/**
+ * pvr_apple_stream_musthave() - Required register extension for a chip's stream
+ * @pvr_dev: Target device.
+ * @type: Geometry or fragment stream type.
+ * @ext_type: Extension header type to which the returned mask applies.
+ *
+ * Return: the chip's required register bits, or zero for other stream types.
+ */
+u32 pvr_apple_stream_musthave(struct pvr_device *pvr_dev, enum pvr_stream_type type,
+			      u32 *ext_type)
+{
+	const struct pvr_apple_chip *chip = pvr_dev->device_data->apple_chip;
+
+	if (type == PVR_STREAM_TYPE_GEOM) {
+		*ext_type = chip->geom_ext_type;
+		return chip->geom_ext_mask;
+	}
+	if (type == PVR_STREAM_TYPE_FRAG) {
+		*ext_type = chip->frag_ext_type;
+		return chip->frag_ext_mask;
+	}
+
+	*ext_type = 0;
+	return 0;
+}
diff --git a/drivers/gpu/drm/imagination/pvr_apple.h b/drivers/gpu/drm/imagination/pvr_apple.h
index cdc8e96..d1de0ad 100644
--- a/drivers/gpu/drm/imagination/pvr_apple.h
+++ b/drivers/gpu/drm/imagination/pvr_apple.h
@@ -10,6 +10,7 @@
 #include <uapi/drm/pvr_drm.h>
 
 #include "pvr_rogue_fwif_client.h"
+#include "pvr_stream.h"
 
 struct dma_fence;
 struct pvr_apple_chip;
@@ -167,6 +168,8 @@ int pvr_apple_resume(struct pvr_device *pvr_dev);
 void pvr_apple_device_info_init(struct pvr_device *pvr_dev);
 bool pvr_apple_takes_jobs(struct pvr_device *pvr_dev);
 bool pvr_apple_free_list_has_pages(struct pvr_device *pvr_dev);
+u32 pvr_apple_stream_musthave(struct pvr_device *pvr_dev, enum pvr_stream_type type,
+			      u32 *ext_type);
 struct dma_fence *pvr_apple_submit_job(struct pvr_job *job);
 struct dma_fence *pvr_apple_submit_compute_job(struct pvr_device *pvr_dev,
 					       struct pvr_vm_context *vm_ctx, u64 stream,
@@ -200,6 +203,12 @@ static inline int pvr_apple_resume(struct pvr_device *pvr_dev) { return 0; }
 static inline void pvr_apple_device_info_init(struct pvr_device *pvr_dev) {}
 static inline bool pvr_apple_takes_jobs(struct pvr_device *pvr_dev) { return false; }
 static inline bool pvr_apple_free_list_has_pages(struct pvr_device *pvr_dev) { return true; }
+static inline u32 pvr_apple_stream_musthave(struct pvr_device *pvr_dev,
+					 enum pvr_stream_type type, u32 *ext_type)
+{
+	*ext_type = 0;
+	return 0;
+}
 static inline int pvr_apple_vm_init(struct pvr_device *pvr_dev, struct pvr_vm_context *vm_ctx)
 {
 	return -ENODEV;
diff --git a/drivers/gpu/drm/imagination/pvr_apple_chip.h b/drivers/gpu/drm/imagination/pvr_apple_chip.h
index 201d72a..d524415 100644
