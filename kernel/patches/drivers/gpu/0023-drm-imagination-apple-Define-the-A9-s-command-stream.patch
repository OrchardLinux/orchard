From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Sun, 15 Nov 2026 00:01:35 +0800
Subject: [PATCH] drm/imagination: apple: Define the A9's command stream
 extensions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The A9's firmware takes a job as a work record the kernel builds. Most of
a record's words are userspace's: addresses of its buffers and the
firmware's program descriptors. They do not fit the Rogue commands, so
the A9 gets a stream extension per job type next to the A10's:

  PVR_STREAM_EXTHDR_TYPE_GEOM_G5P     struct pvr_apple_g5p_geom_regs
  PVR_STREAM_EXTHDR_TYPE_FRAG_G5P     struct pvr_apple_g5p_frag_regs
  PVR_STREAM_EXTHDR_TYPE_COMPUTE_G5P  struct pvr_apple_g5p_compute_regs

They carry what struct drm_g5p_render_pass_v3 and struct
drm_g5p_compute_pass of Berkay Kösebay's apple-g5p driver carry (orchard
#74, include/uapi/drm/apple_g5p_drm.h), less what the Rogue command and
the HWRT dataset already say: the control stream's address, the scissor,
depth-bias and occlusion-query tables, the background object's depth and
stencil values come from the command, the target's size and sample count
from the dataset.

The A10's extension types are not valid in the A9's stream definitions.

Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_apple.h       |  71 +++++++++
 .../drm/imagination/pvr_rogue_fwif_stream.h   |  31 ++++
 drivers/gpu/drm/imagination/pvr_stream_defs.c | 137 ++++++++++++++++++
 drivers/gpu/drm/imagination/pvr_stream_defs.h |   3 +
 4 files changed, 242 insertions(+)

diff --git a/drivers/gpu/drm/imagination/pvr_apple.h b/drivers/gpu/drm/imagination/pvr_apple.h
index f8a2a20..cdc8e96 100644
--- a/drivers/gpu/drm/imagination/pvr_apple.h
+++ b/drivers/gpu/drm/imagination/pvr_apple.h
@@ -86,6 +86,77 @@ struct pvr_apple_cmd_frag {
 	struct pvr_apple_frag_regs apple;
 };
 
+/*
+ * Apple A9 (G5P). Its firmware takes a job as a work record: the kernel
+ * builds the record from the Rogue command, the HWRT dataset and these
+ * stream extensions, which carry the record's words that userspace owns.
+ * Addresses are GPU addresses in the job's VM; "PDS words" are the firmware's
+ * program descriptors as the A9 Vulkan driver builds them, code addresses in
+ * them relative to the PDS heap's base.
+ *
+ * Geometry (PVR_STREAM_EXTHDR_TYPE_GEOM_G5P). Of the Rogue command only
+ * regs.vdm_ctrl_stream_base is read.
+ */
+struct pvr_apple_g5p_geom_regs {
+	u64 scratch_base;		/* TA scratch block, 8-byte aligned */
+	u64 scratch_ptr[6];		/* TA scratch and marker pointers */
+	u64 ta_program;			/* TA state PDS program: byte offset from the PDS heap's base */
+	u64 sample_positions;		/* x | y << 4 per sample, 1/16 pixel; 0: the standard pattern */
+	u32 context_pds[2][6];		/* context store and load PDS words */
+	u32 resume_pds[2][4];		/* resume PDS words */
+	u32 ta_pds[4];			/* TA state PDS words; word 3 is zero */
+};
+
+struct pvr_apple_g5p_cmd_geom {
+	struct rogue_fwif_cmd_geom cmd;
+	struct pvr_apple_g5p_geom_regs g5p;
+};
+
+/*
+ * Fragment (PVR_STREAM_EXTHDR_TYPE_FRAG_G5P). Of the Rogue command
+ * regs.isp_scissor_base, isp_dbias_base, isp_oclqry_base, isp_bgobjdepth and
+ * isp_bgobjvals are read.
+ */
+#define PVR_APPLE_G5P_FRAG_MSAA_RESOLVE	BIT(0)	/* four samples only */
+
+struct pvr_apple_g5p_frag_regs {
+	u64 background_texture;		/* PDS_BGRND1_BASE: the background object's texture state */
+	u64 zls[6];			/* register images 0xf48, 0xf50, 0xf58, 0xf60, 0xf68, 0xfd0 */
+	u64 sample_positions;		/* as the geometry job's */
+	u32 background[8];		/* background (load or clear) object */
+	u32 eot[4];			/* end-of-tile object; word 3 is zero */
+	u32 eot_resume[4];		/* partial-render end of tile; word 3 is zero */
+	u32 restore[4];			/* partial-render restore words */
+	u32 pixel_output_width;		/* 2, 4 or 8 */
+	u32 flags;			/* PVR_APPLE_G5P_FRAG_* */
+};
+
+struct pvr_apple_g5p_cmd_frag {
+	struct rogue_fwif_cmd_frag cmd;
+	struct pvr_apple_g5p_frag_regs g5p;
+};
+
+/*
+ * Compute (PVR_STREAM_EXTHDR_TYPE_COMPUTE_G5P). Of the Rogue command only
+ * regs.cdm_ctrl_stream_base is read.
+ */
+struct pvr_apple_g5p_compute_regs {
+	u64 state[4];			/* context state buffers */
+	u64 tail;			/* 16-byte aligned */
+	u64 terminate;			/* address of the control stream's terminate word */
+	u64 pds_store;			/* PDS code | data << 32 */
+	u64 pds_resume;
+	u64 pds_terminate;
+	u32 config[2];
+	u32 pds_store1;
+	u32 pds_resume1;
+};
+
+struct pvr_apple_g5p_cmd_compute {
+	struct rogue_fwif_cmd_compute cmd;
+	struct pvr_apple_g5p_compute_regs g5p;
+};
+
 #if IS_ENABLED(CONFIG_DRM_POWERVR_APPLE)
 int pvr_apple_fw_init(struct pvr_device *pvr_dev);
 void pvr_apple_fw_fini(struct pvr_device *pvr_dev);
diff --git a/drivers/gpu/drm/imagination/pvr_rogue_fwif_stream.h b/drivers/gpu/drm/imagination/pvr_rogue_fwif_stream.h
index 9e808c7..0ff08fc 100644
--- a/drivers/gpu/drm/imagination/pvr_rogue_fwif_stream.h
+++ b/drivers/gpu/drm/imagination/pvr_rogue_fwif_stream.h
@@ -67,6 +67,17 @@
 
 #define PVR_STREAM_EXTHDR_GEOM_APPLE_VALID PVR_STREAM_EXTHDR_GEOM_APPLE_REGS
 
+/*
+ * Stream extension header - Geometry, Apple A9 (G5P): what its firmware's
+ * geometry work record takes beyond the Rogue command
+ * (struct pvr_apple_g5p_geom_regs). Required on the A9; the A10's is refused.
+ */
+#define PVR_STREAM_EXTHDR_TYPE_GEOM_G5P 2U
+
+#define PVR_STREAM_EXTHDR_GEOM_G5P_REGS BIT(0U)
+
+#define PVR_STREAM_EXTHDR_GEOM_G5P_VALID PVR_STREAM_EXTHDR_GEOM_G5P_REGS
+
 /*
  * Stream extension header - Fragment 0
  */
@@ -87,6 +98,16 @@
 
 #define PVR_STREAM_EXTHDR_FRAG_APPLE_VALID PVR_STREAM_EXTHDR_FRAG_APPLE_REGS
 
+/*
+ * Stream extension header - Fragment, Apple A9 (G5P)
+ * (struct pvr_apple_g5p_frag_regs). Required on the A9.
+ */
+#define PVR_STREAM_EXTHDR_TYPE_FRAG_G5P 2U
+
+#define PVR_STREAM_EXTHDR_FRAG_G5P_REGS BIT(0U)
+
+#define PVR_STREAM_EXTHDR_FRAG_G5P_VALID PVR_STREAM_EXTHDR_FRAG_G5P_REGS
+
 /*
  * Stream extension header - Compute 0
  */
@@ -96,4 +117,14 @@
 
 #define PVR_STREAM_EXTHDR_COMPUTE0_VALID PVR_STREAM_EXTHDR_COMPUTE0_BRN49927
 
+/*
+ * Stream extension header - Compute, Apple A9 (G5P)
+ * (struct pvr_apple_g5p_compute_regs). Required on the A9.
+ */
+#define PVR_STREAM_EXTHDR_TYPE_COMPUTE_G5P 1U
+
+#define PVR_STREAM_EXTHDR_COMPUTE_G5P_REGS BIT(0U)
+
+#define PVR_STREAM_EXTHDR_COMPUTE_G5P_VALID PVR_STREAM_EXTHDR_COMPUTE_G5P_REGS
+
 #endif /* PVR_ROGUE_FWIF_STREAM_H */
diff --git a/drivers/gpu/drm/imagination/pvr_stream_defs.c b/drivers/gpu/drm/imagination/pvr_stream_defs.c
index 9d90141..9271741 100644
--- a/drivers/gpu/drm/imagination/pvr_stream_defs.c
+++ b/drivers/gpu/drm/imagination/pvr_stream_defs.c
@@ -447,3 +447,140 @@ const struct pvr_stream_cmd_defs pvr_apple_cmd_frag_stream = {
 
 	.dest_size = sizeof(struct pvr_apple_cmd_frag),
 };
+
+/*
+ * Apple A9 (G5P): the Rogue commands, each followed by an extension carrying
+ * what the GFX firmware's work record takes beyond it.
+ */
+static const struct pvr_stream_def pvr_apple_g5p_geom_regs_stream[] = {
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_geom, g5p.scratch_base, 64),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_geom, g5p.scratch_ptr),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_geom, g5p.ta_program, 64),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_geom, g5p.sample_positions, 64),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_geom, g5p.context_pds),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_geom, g5p.resume_pds),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_geom, g5p.ta_pds),
+};
+
+static const struct pvr_stream_ext_def pvr_apple_g5p_geom_ext_streams[] = {
+	{
+		.stream = pvr_apple_g5p_geom_regs_stream,
+		.stream_len = ARRAY_SIZE(pvr_apple_g5p_geom_regs_stream),
+		.header_mask = PVR_STREAM_EXTHDR_GEOM_G5P_REGS,
+	},
+};
+
+static const struct pvr_stream_ext_header pvr_apple_g5p_geom_ext_headers[] = {
+	[PVR_STREAM_EXTHDR_TYPE_GEOM0] = {
+		.ext_streams = cmd_geom_ext_streams_0,
+		.ext_streams_num = ARRAY_SIZE(cmd_geom_ext_streams_0),
+		.valid_mask = PVR_STREAM_EXTHDR_GEOM0_VALID,
+	},
+	[PVR_STREAM_EXTHDR_TYPE_GEOM_G5P] = {
+		.ext_streams = pvr_apple_g5p_geom_ext_streams,
+		.ext_streams_num = ARRAY_SIZE(pvr_apple_g5p_geom_ext_streams),
+		.valid_mask = PVR_STREAM_EXTHDR_GEOM_G5P_VALID,
+	},
+};
+
+const struct pvr_stream_cmd_defs pvr_apple_g5p_cmd_geom_stream = {
+	.type = PVR_STREAM_TYPE_GEOM,
+
+	.main_stream = rogue_fwif_cmd_geom_stream,
+	.main_stream_len = ARRAY_SIZE(rogue_fwif_cmd_geom_stream),
+
+	.ext_nr_headers = ARRAY_SIZE(pvr_apple_g5p_geom_ext_headers),
+	.ext_headers = pvr_apple_g5p_geom_ext_headers,
+
+	.dest_size = sizeof(struct pvr_apple_g5p_cmd_geom),
+};
+
+static const struct pvr_stream_def pvr_apple_g5p_frag_regs_stream[] = {
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_frag, g5p.background_texture, 64),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_frag, g5p.zls),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_frag, g5p.sample_positions, 64),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_frag, g5p.background),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_frag, g5p.eot),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_frag, g5p.eot_resume),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_frag, g5p.restore),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_frag, g5p.pixel_output_width, 32),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_frag, g5p.flags, 32),
+};
+
+static const struct pvr_stream_ext_def pvr_apple_g5p_frag_ext_streams[] = {
+	{
+		.stream = pvr_apple_g5p_frag_regs_stream,
+		.stream_len = ARRAY_SIZE(pvr_apple_g5p_frag_regs_stream),
+		.header_mask = PVR_STREAM_EXTHDR_FRAG_G5P_REGS,
+	},
+};
+
+static const struct pvr_stream_ext_header pvr_apple_g5p_frag_ext_headers[] = {
+	[PVR_STREAM_EXTHDR_TYPE_FRAG0] = {
+		.ext_streams = cmd_frag_ext_streams_0,
+		.ext_streams_num = ARRAY_SIZE(cmd_frag_ext_streams_0),
+		.valid_mask = PVR_STREAM_EXTHDR_FRAG0_VALID,
+	},
+	[PVR_STREAM_EXTHDR_TYPE_FRAG_G5P] = {
+		.ext_streams = pvr_apple_g5p_frag_ext_streams,
+		.ext_streams_num = ARRAY_SIZE(pvr_apple_g5p_frag_ext_streams),
+		.valid_mask = PVR_STREAM_EXTHDR_FRAG_G5P_VALID,
+	},
+};
+
+const struct pvr_stream_cmd_defs pvr_apple_g5p_cmd_frag_stream = {
+	.type = PVR_STREAM_TYPE_FRAG,
+
+	.main_stream = rogue_fwif_cmd_frag_stream,
+	.main_stream_len = ARRAY_SIZE(rogue_fwif_cmd_frag_stream),
+
+	.ext_nr_headers = ARRAY_SIZE(pvr_apple_g5p_frag_ext_headers),
+	.ext_headers = pvr_apple_g5p_frag_ext_headers,
+
+	.dest_size = sizeof(struct pvr_apple_g5p_cmd_frag),
+};
+
+static const struct pvr_stream_def pvr_apple_g5p_compute_regs_stream[] = {
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_compute, g5p.state),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_compute, g5p.tail, 64),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_compute, g5p.terminate, 64),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_compute, g5p.pds_store, 64),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_compute, g5p.pds_resume, 64),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_compute, g5p.pds_terminate, 64),
+	PVR_STREAM_DEF_ARRAY(pvr_apple_g5p_cmd_compute, g5p.config),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_compute, g5p.pds_store1, 32),
+	PVR_STREAM_DEF(pvr_apple_g5p_cmd_compute, g5p.pds_resume1, 32),
+};
+
+static const struct pvr_stream_ext_def pvr_apple_g5p_compute_ext_streams[] = {
+	{
+		.stream = pvr_apple_g5p_compute_regs_stream,
+		.stream_len = ARRAY_SIZE(pvr_apple_g5p_compute_regs_stream),
+		.header_mask = PVR_STREAM_EXTHDR_COMPUTE_G5P_REGS,
+	},
+};
+
+static const struct pvr_stream_ext_header pvr_apple_g5p_compute_ext_headers[] = {
+	[PVR_STREAM_EXTHDR_TYPE_COMPUTE0] = {
+		.ext_streams = cmd_compute_ext_streams_0,
+		.ext_streams_num = ARRAY_SIZE(cmd_compute_ext_streams_0),
+		.valid_mask = PVR_STREAM_EXTHDR_COMPUTE0_VALID,
+	},
+	[PVR_STREAM_EXTHDR_TYPE_COMPUTE_G5P] = {
+		.ext_streams = pvr_apple_g5p_compute_ext_streams,
+		.ext_streams_num = ARRAY_SIZE(pvr_apple_g5p_compute_ext_streams),
+		.valid_mask = PVR_STREAM_EXTHDR_COMPUTE_G5P_VALID,
+	},
+};
+
+const struct pvr_stream_cmd_defs pvr_apple_g5p_cmd_compute_stream = {
+	.type = PVR_STREAM_TYPE_COMPUTE,
+
+	.main_stream = rogue_fwif_cmd_compute_stream,
+	.main_stream_len = ARRAY_SIZE(rogue_fwif_cmd_compute_stream),
+
+	.ext_nr_headers = ARRAY_SIZE(pvr_apple_g5p_compute_ext_headers),
+	.ext_headers = pvr_apple_g5p_compute_ext_headers,
+
+	.dest_size = sizeof(struct pvr_apple_g5p_cmd_compute),
+};
diff --git a/drivers/gpu/drm/imagination/pvr_stream_defs.h b/drivers/gpu/drm/imagination/pvr_stream_defs.h
index 6cf88a3..892b44b 100644
--- a/drivers/gpu/drm/imagination/pvr_stream_defs.h
+++ b/drivers/gpu/drm/imagination/pvr_stream_defs.h
@@ -14,5 +14,8 @@ extern const struct pvr_stream_cmd_defs pvr_static_render_context_state_stream;
 extern const struct pvr_stream_cmd_defs pvr_static_compute_context_state_stream;
 extern const struct pvr_stream_cmd_defs pvr_apple_cmd_geom_stream;
 extern const struct pvr_stream_cmd_defs pvr_apple_cmd_frag_stream;
+extern const struct pvr_stream_cmd_defs pvr_apple_g5p_cmd_geom_stream;
+extern const struct pvr_stream_cmd_defs pvr_apple_g5p_cmd_frag_stream;
