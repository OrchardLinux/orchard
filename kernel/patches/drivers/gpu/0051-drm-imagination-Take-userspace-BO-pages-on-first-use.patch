From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 15 Nov 2026 23:35:12 +0100
Subject: [PATCH] drm/imagination: Take userspace BO pages on first use

A large storage buffer consumes unswappable memory at CREATE_BO even if
it is never used. Leave userspace shmem unbacked until VM_MAP, vmap or a
CPU fault. Shmem supplies zero-filled pages. Keep the internal create
entry point eager and explicitly mark all its objects kernel-pinned.

Audit of sgt readers: VM map acquires residency; GEM vmap now does too;
vmap/vunmap cache sync already tolerates NULL; get_dma_addr now returns
-EINVAL when unbacked. Its Apple boot, PM pool and VM reserved-page
callers use eager kernel BOs. The free-list page writer obtains an sgt
for its eager internal BO. Firmware, HWRT sync objects and both Apple
backends retain the internal create entry point.

The shmem locked page-in helper is private. Transfer a temporary explicit
pin's page reference to our DMA-mapped sgt under the reservation instead.

Affects: every PowerVR device

Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_drv.c |  2 +-
 drivers/gpu/drm/imagination/pvr_gem.c | 84 +++++++++++++++++++++++++--
 drivers/gpu/drm/imagination/pvr_gem.h | 16 ++---
 3 files changed, 89 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_drv.c b/drivers/gpu/drm/imagination/pvr_drv.c
index 7ad0b71f81..f27d9b3151 100644
--- a/drivers/gpu/drm/imagination/pvr_drv.c
+++ b/drivers/gpu/drm/imagination/pvr_drv.c
@@ -115,7 +115,7 @@ pvr_ioctl_create_bo(struct drm_device *drm_dev, void *raw_args,
 	 * Create a buffer object and transfer ownership to a userspace-
 	 * accessible handle.
 	 */
-	pvr_obj = pvr_gem_object_create(pvr_dev, sanitized_size, args->flags);
+	pvr_obj = pvr_gem_object_create_user(pvr_dev, sanitized_size, args->flags);
 	if (IS_ERR(pvr_obj)) {
 		err = PTR_ERR(pvr_obj);
 		goto err_drm_dev_exit;
diff --git a/drivers/gpu/drm/imagination/pvr_gem.c b/drivers/gpu/drm/imagination/pvr_gem.c
index 44626d14f9..cca2f00ba0 100644
--- a/drivers/gpu/drm/imagination/pvr_gem.c
+++ b/drivers/gpu/drm/imagination/pvr_gem.c
@@ -357,6 +357,10 @@ pvr_gem_object_vmap(struct pvr_gem_object *pvr_obj)
 
 	dma_resv_lock(obj->resv, NULL);
 
+	err = PTR_ERR_OR_ZERO(pvr_gem_get_pages_sgt_locked(pvr_obj));
+	if (err)
+		goto err_unlock;
+
 	err = drm_gem_shmem_vmap_locked(shmem_obj, &map);
 	if (err)
 		goto err_unlock;
@@ -487,8 +491,8 @@ struct drm_gem_object *pvr_gem_create_object(struct drm_device *drm_dev, size_t
  *  * -%ENOMEM if sufficient physical memory cannot be allocated, or
  *  * Any other error returned by drm_gem_create_mmap_offset().
  */
-struct pvr_gem_object *
-pvr_gem_object_create(struct pvr_device *pvr_dev, size_t size, u64 flags)
+static struct pvr_gem_object *
+pvr_gem_object_create_common(struct pvr_device *pvr_dev, size_t size, u64 flags)
 {
 	struct drm_device *drm_dev = from_pvr_device(pvr_dev);
 	struct drm_gem_shmem_object *shmem_obj;
@@ -511,12 +515,18 @@ pvr_gem_object_create(struct pvr_device *pvr_dev, size_t size, u64 flags)
 	pvr_obj = shmem_gem_to_pvr_gem(shmem_obj);
 	pvr_obj->flags = flags;
 
-	/* Imports also use gem_create_object; only native BOs reserve pages here. */
+	/*
+	 * Imports also use gem_create_object; only native BOs are charged, by
+	 * size, here. A userspace BO is charged before it has any backing.
+	 */
 	err = pvr_gem_pin_charge(pvr_obj);
 	if (err)
 		goto err_shmem_object_free;
 
-	sgt = drm_gem_shmem_get_pages_sgt(shmem_obj);
+	if (!(flags & PVR_BO_KERNEL_PINNED))
+		return pvr_obj;
+
+	sgt = pvr_gem_object_get_pages_sgt(pvr_obj);
 	if (IS_ERR(sgt)) {
 		err = PTR_ERR(sgt);
 		goto err_shmem_object_free;
@@ -558,7 +568,8 @@ pvr_gem_get_dma_addr(struct pvr_gem_object *pvr_obj, u32 offset,
 	struct scatterlist *sgl;
 	unsigned int sgt_idx;
 
-	WARN_ON(!shmem_obj->sgt);
+	if (!shmem_obj->sgt || offset >= pvr_gem_object_size(pvr_obj))
+		return -EINVAL;
 	for_each_sgtable_dma_sg(shmem_obj->sgt, sgl, sgt_idx) {
 		u32 new_offset = accumulated_offset + sg_dma_len(sgl);
 
@@ -573,3 +584,66 @@ pvr_gem_get_dma_addr(struct pvr_gem_object *pvr_obj, u32 offset,
 
 	return -EINVAL;
 }
+
+struct pvr_gem_object *pvr_gem_object_create(struct pvr_device *pvr_dev,
+					  size_t size, u64 flags)
+{
+	return pvr_gem_object_create_common(pvr_dev, size, flags | PVR_BO_KERNEL_PINNED);
+}
+
+struct pvr_gem_object *pvr_gem_object_create_user(struct pvr_device *pvr_dev,
+					       size_t size, u64 flags)
+{
+	return pvr_gem_object_create_common(pvr_dev, size, flags);
+}
+
+/* The shmem helper's locked page-in entry points are private to that helper. */
+struct sg_table *pvr_gem_get_pages_sgt_locked(struct pvr_gem_object *pvr_obj)
+{
+	struct drm_gem_shmem_object *shmem = &pvr_obj->base;
+	struct drm_gem_object *obj = &shmem->base;
+	struct sg_table *sgt;
+	int err;
+
+	dma_resv_assert_held(obj->resv);
+	if (shmem->sgt)
+		return shmem->sgt;
+	if (drm_gem_is_imported(obj))
+		return ERR_PTR(-EINVAL);
+
+	/* pin_locked gets pages without recursively acquiring the reservation. */
+	err = drm_gem_shmem_pin_locked(shmem);
+	if (err)
+		return ERR_PTR(err);
+	sgt = drm_gem_shmem_get_sg_table(shmem);
+	if (IS_ERR(sgt)) {
+		err = PTR_ERR(sgt);
+		goto unpin;
+	}
+	err = dma_map_sgtable(obj->dev->dev, sgt, DMA_BIDIRECTIONAL, 0);
+	if (err) {
+		sg_free_table(sgt);
+		kfree(sgt);
+		goto unpin;
+	}
+	/* Transfer the temporary pin's page reference to the sgt. */
+	refcount_inc(&shmem->pages_use_count);
+	shmem->sgt = sgt;
+unpin:
+	drm_gem_shmem_unpin_locked(shmem);
+	return err ? ERR_PTR(err) : sgt;
+}
+
+struct sg_table *pvr_gem_object_get_pages_sgt(struct pvr_gem_object *pvr_obj)
+{
+	struct drm_gem_object *obj = gem_from_pvr_gem(pvr_obj);
+	struct sg_table *sgt;
+	int err;
+
+	err = dma_resv_lock_interruptible(obj->resv, NULL);
+	if (err)
+		return ERR_PTR(err);
+	sgt = pvr_gem_get_pages_sgt_locked(pvr_obj);
+	dma_resv_unlock(obj->resv);
+	return sgt;
+}
diff --git a/drivers/gpu/drm/imagination/pvr_gem.h b/drivers/gpu/drm/imagination/pvr_gem.h
index 2e7cf2c9a6..ac9a38301a 100644
--- a/drivers/gpu/drm/imagination/pvr_gem.h
+++ b/drivers/gpu/drm/imagination/pvr_gem.h
@@ -64,10 +64,12 @@ struct pvr_gem_account;
 
 #define PVR_BO_DEVICE_CACHE_COHERENT BIT_ULL(61)
 
+#define PVR_BO_KERNEL_PINNED BIT_ULL(60)
+
 #define PVR_BO_KERNEL_FLAGS_MASK (PVR_BO_CPU_CACHED | PVR_BO_FW_NO_CLEAR_ON_RESET | \
-				  PVR_BO_DEVICE_CACHE_COHERENT)
+				  PVR_BO_DEVICE_CACHE_COHERENT | PVR_BO_KERNEL_PINNED)
 
-/* Bits 60..3 are undefined. */
+/* Bits 59..3 are undefined. */
 /* Bits 2..0 are defined in the UAPI. */
 
 /* Other utilities. */
@@ -133,16 +135,16 @@ struct drm_gem_object *pvr_gem_create_object(struct drm_device *drm_dev, size_t
 struct pvr_gem_object *pvr_gem_object_create(struct pvr_device *pvr_dev,
 					     size_t size, u64 flags);
 
+struct pvr_gem_object *pvr_gem_object_create_user(struct pvr_device *pvr_dev,
+						 size_t size, u64 flags);
+struct sg_table *pvr_gem_get_pages_sgt_locked(struct pvr_gem_object *pvr_obj);
+
 int pvr_gem_object_into_handle(struct pvr_gem_object *pvr_obj,
 			       struct pvr_file *pvr_file, u32 *handle);
 struct pvr_gem_object *pvr_gem_object_from_handle(struct pvr_file *pvr_file,
 						  u32 handle);
 
-static __always_inline struct sg_table *
-pvr_gem_object_get_pages_sgt(struct pvr_gem_object *pvr_obj)
-{
-	return drm_gem_shmem_get_pages_sgt(shmem_gem_from_pvr_gem(pvr_obj));
-}
+struct sg_table *pvr_gem_object_get_pages_sgt(struct pvr_gem_object *pvr_obj);
 
 void *pvr_gem_object_vmap(struct pvr_gem_object *pvr_obj);
 void pvr_gem_object_vunmap(struct pvr_gem_object *pvr_obj);
