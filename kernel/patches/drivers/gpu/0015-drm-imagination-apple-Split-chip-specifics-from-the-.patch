@@ -431,21 +248,50 @@ static void pvr_apple_stop_firmware(void *data)
 
 	if (!apple->booted)
 		return;
-	pvr_apple_request_power_state(apple, 0);
-	apple_rtkit_shutdown(apple->rtk);
+	apple->chip->stop(apple, false);
 	cancel_delayed_work_sync(&apple->poll_work);
