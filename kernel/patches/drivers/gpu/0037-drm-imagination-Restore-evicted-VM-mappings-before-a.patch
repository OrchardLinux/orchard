+			err = PTR_ERR_OR_ZERO(bind_op.mmu_op_ctx);
+			if (err)
+				bind_op.mmu_op_ctx = NULL;
+		}
+		if (!err)
+			err = pvr_vm_bind_op_exec(&bind_op);
+	}
+
+	/* Publish table edits while both VM and BO reservations still exclude reclaim. */
+	if (bind_op.mmu_op_ctx) {
