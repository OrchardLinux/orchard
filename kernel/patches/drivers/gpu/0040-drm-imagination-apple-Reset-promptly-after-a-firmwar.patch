@@ -17,6 +17,7 @@
 #include "pvr_apple.h"
 #include "pvr_device.h"
 
+#include <linux/atomic.h>
 #include <linux/dma-fence.h>
 #include <linux/hrtimer.h>
 #include <linux/io.h>
@@ -28,6 +29,7 @@
 #include <linux/workqueue.h>
 
 struct devfreq;
+struct drm_gpu_scheduler;
 struct pvr_gem_object;
 struct pvr_stream_cmd_defs;
 
@@ -110,6 +112,7 @@ struct pvr_apple {
 	u64 fence_context;		/* first of APPLE_ENGINES */
 	spinlock_t fence_lock;
 	struct list_head pending[3];	/* struct pvr_apple_fence, by seq */
+	atomic_t fault_pending;		/* a chip latched a new firmware fault */
 	struct delayed_work poll_work;
 	struct hrtimer poll_timer;	/* rearms poll_work while jobs are pending */
 	/*
@@ -301,6 +304,10 @@ static inline struct device *apple_dev(struct pvr_apple *apple)
 }
 
 void pvr_apple_report_mmu_fault(struct pvr_apple *apple);
+void pvr_apple_firmware_fault(struct pvr_apple *apple);
+bool pvr_apple_fence_faulted(struct dma_fence *fence);
+void pvr_apple_fence_bind(struct pvr_device *pvr_dev, struct dma_fence *fence,
+			  struct drm_gpu_scheduler *sched);
 int pvr_apple_fw_load(struct pvr_apple *apple, size_t max_size);
 int pvr_apple_wait_idle(struct pvr_apple *apple, unsigned int timeout_us);
 int pvr_apple_request_power_state(struct pvr_apple *apple, u32 state);
diff --git a/drivers/gpu/drm/imagination/pvr_apple_queue.c b/drivers/gpu/drm/imagination/pvr_apple_queue.c
index d176fe6..065dad1 100644
--- a/drivers/gpu/drm/imagination/pvr_apple_queue.c
+++ b/drivers/gpu/drm/imagination/pvr_apple_queue.c
@@ -57,6 +57,8 @@ static struct dma_fence *pvr_apple_run_job(struct drm_sched_job *sched_job)
 	fence = pvr_apple_submit(job);
 	if (IS_ERR(fence))
 		pvr_power_put(job->pvr_dev);
+	else
+		pvr_apple_fence_bind(job->pvr_dev, fence, sched_job->sched);
 	return fence;
 }
 
@@ -75,7 +77,10 @@ static enum drm_gpu_sched_stat pvr_apple_timedout_job(struct drm_sched_job *sche
 	 * puts it back, and drm_sched_start() completes it and the others
 	 * from their cancelled fences, so that free_job() runs for each.
 	 */
-	drm_err(from_pvr_device(job->pvr_dev), "Apple GPU job timed out\n");
+	if (pvr_apple_fence_faulted(sched_job->s_fence->parent))
+		drm_err(from_pvr_device(job->pvr_dev), "Apple GPU job lost to firmware fault\n");
+	else
+		drm_err(from_pvr_device(job->pvr_dev), "Apple GPU job timed out\n");
 	pvr_apple_report_hang(job->pvr_dev, sched_job->s_fence->parent);
 	atomic_set(&job->ctx->faulty, 1);
 	drm_sched_stop(sched, sched_job);
diff --git a/drivers/gpu/drm/imagination/pvr_apple_s8003.c b/drivers/gpu/drm/imagination/pvr_apple_s8003.c
index 829487f..2be9500 100644
--- a/drivers/gpu/drm/imagination/pvr_apple_s8003.c
+++ b/drivers/gpu/drm/imagination/pvr_apple_s8003.c
@@ -977,7 +977,11 @@ static int s8003_drain(struct pvr_apple *apple, bool *alive)
 			dev_warn_ratelimited(apple_dev(apple), "firmware fault event type=%u slot=%u: %*ph\n",
 					     type, get_unaligned_le32(e + 0x0c),
 					     S8003_EVENT_SIZE - 4, e + 4);
-			WRITE_ONCE(s->fault, true);
+			if (!READ_ONCE(s->fault)) {
+				WRITE_ONCE(s->fault, true);
+				pvr_apple_report_mmu_fault(apple);
+				pvr_apple_firmware_fault(apple);
+			}
 		}
 		consumer = (consumer + 1) % APPLE_RING_ENTRIES;
 		ring_consume(ctl, consumer);
