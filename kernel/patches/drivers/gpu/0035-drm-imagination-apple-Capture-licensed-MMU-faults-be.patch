From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Mon, 16 Nov 2026 02:57:19 +0100
Subject: [PATCH 34/40] drm/imagination: apple: Capture licensed MMU faults
 before reset

A texture read at VA 0xffffffc0 stopped rendering on the iPad 5. Share
the decoder and once-per-boot report so the VA, access, requester and
context are captured before reset. Read only e150/e158 after checking
Fender state, transition bits and an optional chip-supplied highest
state. Refuse capture without a licence. Both fault edges and internal
wait failures use this path.

Affects: Apple A9 (S8003); chips without a licence callback do not read RGX
Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_apple.c       | 144 ++++++++++++++++++
 drivers/gpu/drm/imagination/pvr_apple_chip.h  |   5 +
 drivers/gpu/drm/imagination/pvr_apple_s8003.c |  13 +-
 3 files changed, 160 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_apple.c b/drivers/gpu/drm/imagination/pvr_apple.c
index 5a43e3f..96097fc 100644
--- a/drivers/gpu/drm/imagination/pvr_apple.c
+++ b/drivers/gpu/drm/imagination/pvr_apple.c
@@ -680,6 +680,149 @@ static const struct dma_fence_ops pvr_apple_fence_ops = {
 	.get_timeline_name = pvr_apple_fence_timeline_name,
 };
 
+/* MMU status fields and requestor names from the G5P fault decoder. */
+struct pvr_apple_mmu_fault {
+	bool valid, read;
+	u8 type, level, requester, sideband, context;
+	u64 va;
+};
+
+static struct pvr_apple_mmu_fault pvr_apple_mmu_fault_decode(u64 s)
+{
+	struct pvr_apple_mmu_fault f = {
+		.valid = s & 1,
+		.type = (s >> 1) & 3,
+		.read = (s >> 3) & 1,
+		.level = (s >> 4) & 3,
+		.requester = (s >> 6) & 0x3f,
+		.sideband = (s >> 12) & 0xff,
+		.context = (s >> 20) & 0xff,
+		.va = (s >> 24) & 0xfffffffff0ULL,
+	};
+
+	return f;
+}
+
+static const char *const pvr_apple_mmu_fault_types[4] = {
+	"page-invalid",
+	"type1",
+	"read-only",
+	"pm-meta-protected",
+};
+
+/* Requester names, iOS kext table 6ff5ed8 (16-byte {name, class} entries; read from the j71t
+ * 16.7.10 kernelcache). A larger index prints its number only.
+ */
+static const char *const pvr_apple_mmu_requesters[] = {
+	"META",
+	"TLA",
+	"HOST",
+	"VDMM",
+	"CDM",
+	"IPP",
+	"PM",
+	"TILING",
+	"MCU_TEXAS0",
+	"PDS_TEXAS0",
+	"PBE0_TEXAS0",
+	"PBE1_TEXAS0",
+	"VDMS_BLACKPEARL0",
+	"IPF_BLACKPEARL0",
+	"ISP_BLACKPEARL0",
+	"TPF_BLACKPEARL0",
+	"USCS_BLACKPEARL0",
+	"PPP_BLACKPEARL0",
+	"VCE_BLACKPEARL0",
+	"FBCDC_BLACKPEARL0",
+	"MCU_TEXAS1",
+	"PDS_TEXAS1",
+	"PBE0_TEXAS1",
+	"PBE1_TEXAS1",
+	"MCU_TEXAS2",
+	"PDS_TEXAS2",
+	"PBE0_TEXAS2",
+	"PBE1_TEXAS2",
+	"VDMS_BLACKPEARL1",
+	"IPF_BLACKPEARL1",
+	"ISP_BLACKPEARL1",
+	"TPF_BLACKPEARL1",
+	"USCS_BLACKPEARL1",
+	"PPP_BLACKPEARL1",
+	"VCE_BLACKPEARL1",
+	"FBCDC_BLACKPEARL1",
+	"MCU_TEXAS3",
+	"PDS_TEXAS3",
+	"PBE0_TEXAS3",
+	"PBE1_TEXAS3",
+	"MCU_TEXAS4",
+	"PDS_TEXAS4",
+	"PBE0_TEXAS4",
+	"PBE1_TEXAS4",
+	"VDMS_BLACKPEARL2",
+	"IPF_BLACKPEARL2",
+	"ISP_BLACKPEARL2",
+	"TPF_BLACKPEARL2",
+	"USCS_BLACKPEARL2",
+	"PPP_BLACKPEARL2",
+	"VCE_BLACKPEARL2",
+	"FBCDC_BLACKPEARL2",
+	"MCU_TEXAS5",
+	"PDS_TEXAS5",
+	"PBE0_TEXAS5",
+	"PBE1_TEXAS5",
+};
+
+static const char *pvr_apple_mmu_requester(u32 requester)
+{
+	if (requester >= ARRAY_SIZE(pvr_apple_mmu_requesters))
+		return "?";
+	return pvr_apple_mmu_requesters[requester];
+}
+
+/* The firmware stopped on a fault: iOS reads these banks before resetting it. */
+void pvr_apple_report_mmu_fault(struct pvr_apple *apple)
+{
+	u32 ctrl, power, state, highest;
+	const char *reason;
+	unsigned int bank;
+
+	if (xchg(&apple->fault_reported, true))
+		return;
+	if (!apple->chip->max_power_state) {
+		dev_warn(apple_dev(apple), "GPU MMU fault licence refused: no licence for this chip\n");
+		return;
+	}
+	ctrl = readl(apple->fender + FENDER_CTRL);
+	power = readl(apple->fender + FENDER_POWER_STATE);
+	state = power & 0xf;
+	highest = apple->chip->max_power_state(apple);
+	if (ctrl & BIT(29))
+		reason = "power-down in progress";
+	else if (power & FENDER_POWER_REQUEST)
+		reason = "power request in flight";
+	else if (!state || state > highest)
+		reason = "state outside epoch range";
+	else
+		reason = NULL;
+	if (reason) {
+		dev_warn(apple_dev(apple),
+			 "GPU MMU fault licence refused: %s (ctrl=%#x power=%#x max=%u)\n",
+			 reason, ctrl, power, highest);
+		return;
+	}
+
+	for (bank = 0; bank < 2; bank++) {
+		u64 status = pvr_cr_read64(apple->pvr_dev, 0xe150 + bank * 8);
+		struct pvr_apple_mmu_fault f = pvr_apple_mmu_fault_decode(status);
+
+		dev_warn(apple_dev(apple),
+			 "GPU MMU fault bank=%u va=0x%llx %s type=%s level=%u requestor=%u/%s context=%u valid=%u sideband=%u\n",
+			 bank, f.va, f.read ? "read" : "write", pvr_apple_mmu_fault_types[f.type],
+			 f.level, f.requester, pvr_apple_mmu_requester(f.requester), f.context,
+			 f.valid, f.sideband);
+	}
+}
+
 /*
  * Consume the firmware's events. Completion is taken from the stamps, so the
  * events are only acknowledged: a full event ring stalls the firmware.
@@ -1319,6 +1462,7 @@ static int pvr_apple_fw_start(struct pvr_apple *apple)
 	apple->frag_seq = 0;
 	apple->frag_events = 0;
 	apple->geom_pending = false;
+	apple->fault_reported = false;
 	return apple->chip->start(apple);
 }
 
diff --git a/drivers/gpu/drm/imagination/pvr_apple_chip.h b/drivers/gpu/drm/imagination/pvr_apple_chip.h
index d524415..663e409 100644
--- a/drivers/gpu/drm/imagination/pvr_apple_chip.h
+++ b/drivers/gpu/drm/imagination/pvr_apple_chip.h
@@ -39,6 +39,7 @@ struct pvr_stream_cmd_defs;
  * the GPU's OPP table, the state number as opp-level; without one the GPU
  * runs in the chip's perf_state_max.
  */
+#define FENDER_CTRL			0x0000
 #define FENDER_POWER_STATE		0x1000
 #define FENDER_POWER_STATE_MASK		0x1f
 #define FENDER_POWER_REQUEST		0x10	/* | target state */
@@ -85,6 +86,7 @@ struct pvr_apple {
 	void *heap;		/* memory shared with the firmware: rings, stamps, commands */
 	struct pvr_apple_layout layout;
 	bool booted;
+	bool fault_reported;		/* once per firmware boot */
 	bool fw_ready;		/* init data handed over once: runtime PM restarts it */
 
 	struct mutex submit_lock;	/* job slots, rings, producer index, GPU VM */
@@ -218,6 +220,7 @@ struct pvr_apple {
  *	reaches when it is finished, or a negative error.
  * @engine_done: The sequence number of the last finished job of @engine. No
  *	lock held; may be called with interrupts off.
+ * @max_power_state: Highest state licensed for fault capture; optional.
  * @events: Read what the firmware posted. Before @engine_done wherever a job
  *	is waited for; may sleep.
  * @vm_init: A userspace VM was created: map what the firmware needs in it.
@@ -268,6 +271,7 @@ struct pvr_apple_chip {
 
 	int (*submit)(struct pvr_apple *apple, struct pvr_job *job);
 	u32 (*engine_done)(struct pvr_apple *apple, enum pvr_apple_engine engine);
+	u32 (*max_power_state)(struct pvr_apple *apple);
 	void (*events)(struct pvr_apple *apple);
 	int (*vm_init)(struct pvr_apple *apple, struct pvr_vm_context *vm_ctx);
 	void (*vm_fini)(struct pvr_apple *apple, struct pvr_vm_context *vm_ctx);
@@ -286,6 +290,7 @@ static inline struct device *apple_dev(struct pvr_apple *apple)
 	return from_pvr_device(apple->pvr_dev)->dev;
 }
 
+void pvr_apple_report_mmu_fault(struct pvr_apple *apple);
 int pvr_apple_fw_load(struct pvr_apple *apple, size_t max_size);
 int pvr_apple_wait_idle(struct pvr_apple *apple, unsigned int timeout_us);
 int pvr_apple_request_power_state(struct pvr_apple *apple, u32 state);
diff --git a/drivers/gpu/drm/imagination/pvr_apple_s8003.c b/drivers/gpu/drm/imagination/pvr_apple_s8003.c
index e5be557..23483f8 100644
--- a/drivers/gpu/drm/imagination/pvr_apple_s8003.c
+++ b/drivers/gpu/drm/imagination/pvr_apple_s8003.c
@@ -71,7 +71,6 @@
  * Fender beyond the power state. The boot stream is a list of Rogue register
  * writes, two words each; Fender runs it when the core's power state leaves 0.
  */
-#define FENDER_CTRL			0x0000
 #define FENDER_CTRL_BOOT		0x40000000	/* as iOS sets it before a boot */
 #define FENDER_STREAM_STATE		0x0010		/* cleared before the stream is stored */
 #define FENDER_WAKE			0x0014
@@ -1257,8 +1256,10 @@ static int s8003_wait_done(struct pvr_apple *apple, enum pvr_apple_engine engine
 	err = read_poll_timeout(s8003_done_poll, done,
 				(s32)(done - seq) >= 0 || READ_ONCE(s->fault), 20,
 				S8003_JOB_TIMEOUT_US, false, apple, engine);
-	if (!err && (s32)(done - seq) < 0)
+	if (!err && (s32)(done - seq) < 0) {
+		pvr_apple_report_mmu_fault(apple);
 		return -EIO;
+	}
 	return err;
 }
 
@@ -2569,6 +2570,13 @@ static void pvr_apple_s8003_restore_image(struct pvr_apple *apple)
 	/* start() copies the image and builds the init data anew each time */
 }
 
+static u32 pvr_apple_s8003_max_power_state(struct pvr_apple *apple)
+{
+	struct pvr_apple_s8003 *s = apple->chip_data;
+
+	return get32(s8003_object(s, S8003_PLATFORM) + 0x710);
+}
+
 const struct pvr_apple_chip pvr_apple_chip_s8003 = {
 	.fw_name = "apple/gfx-s8003.bin",
 	.perf_state_max = S8003_PERF_STATE_MAX,
@@ -2592,6 +2600,7 @@ const struct pvr_apple_chip pvr_apple_chip_s8003 = {
 	.report_hang = pvr_apple_s8003_report_hang,
 	.submit = pvr_apple_s8003_submit,
 	.engine_done = pvr_apple_s8003_engine_done,
+	.max_power_state = pvr_apple_s8003_max_power_state,
 	.events = pvr_apple_s8003_events,
 	.vm_init = pvr_apple_s8003_vm_init,
 	.vm_fini = pvr_apple_s8003_vm_fini,
