From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:04:00 +0100
Subject: [PATCH] drm/imagination: Allow a GPU node without power-domains, and
 say which probe step failed

pvr_power_domains_init() returned of_count_phandle_with_args()'s -ENOENT
when the node has no power-domains property, with no message. The A8
(T7000) node has none: its chip powers the GPU up itself, in Apple's
order. A node without the property has no domains to attach.

Name the step in pvr_probe() when one fails: the A8's first probe failed
with only "probe with driver powervr failed with error -2".

Nodes with power domains take the same path as before.

Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_drv.c   | 14 ++++++++++----
 drivers/gpu/drm/imagination/pvr_power.c |  4 ++++
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_drv.c b/drivers/gpu/drm/imagination/pvr_drv.c
index f27d9b3151..d97e9d59f7 100644
--- a/drivers/gpu/drm/imagination/pvr_drv.c
+++ b/drivers/gpu/drm/imagination/pvr_drv.c
@@ -1431,15 +1431,17 @@ pvr_probe(struct platform_device *plat_dev)
 
 	err = pvr_power_domains_init(pvr_dev);
 	if (err)
-		return err;
+		return dev_err_probe(&plat_dev->dev, err, "power domains\n");
 
 	init_rwsem(&pvr_dev->reset_sem);
 
 	pvr_context_device_init(pvr_dev);
 
 	err = pvr_queue_device_init(pvr_dev);
-	if (err)
+	if (err) {
+		dev_err_probe(&plat_dev->dev, err, "queue init\n");
 		goto err_context_fini;
+	}
 
 	devm_pm_runtime_enable(&plat_dev->dev);
 	pm_runtime_mark_last_busy(&plat_dev->dev);
@@ -1449,12 +1451,16 @@ pvr_probe(struct platform_device *plat_dev)
 	pvr_watchdog_init(pvr_dev);
 
 	err = pvr_device_init(pvr_dev);
-	if (err)
+	if (err) {
+		dev_err_probe(&plat_dev->dev, err, "device init\n");
 		goto err_watchdog_fini;
+	}
 
 	err = drm_dev_register(drm_dev, 0);
-	if (err)
+	if (err) {
+		dev_err_probe(&plat_dev->dev, err, "DRM device registration\n");
 		goto err_device_fini;
+	}
 
 	xa_init_flags(&pvr_dev->free_list_ids, XA_FLAGS_ALLOC1);
 	xa_init_flags(&pvr_dev->job_ids, XA_FLAGS_ALLOC1);
diff --git a/drivers/gpu/drm/imagination/pvr_power.c b/drivers/gpu/drm/imagination/pvr_power.c
index 54dba0ae18..b2b94de98a 100644
--- a/drivers/gpu/drm/imagination/pvr_power.c
+++ b/drivers/gpu/drm/imagination/pvr_power.c
@@ -643,8 +643,12 @@ int pvr_power_domains_init(struct pvr_device *pvr_dev)
 
 	domain_count = of_count_phandle_with_args(dev->of_node, "power-domains",
 						  "#power-domain-cells");
+	/* No power-domains property: no domains (the A8 powers itself up) */
+	if (domain_count == -ENOENT)
+		domain_count = 0;
 	if (domain_count < 0) {
 		err = domain_count;
+		drm_err(drm_dev, "cannot count the power domains (%d)\n", err);
 		goto out;
 	}
 
