From bbd8003115717b35d347c9f40a8807ba71e9e8ba Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Mon, 16 Nov 2026 17:45:47 +0100
Subject: [PATCH] drm/imagination: apple: Allow opt-in per-VM S8003 scene
 overlap

Composited S8003 workloads serialize one client's geometry behind another
client's fragment, even though their PM sets are private to their VMs.

Keep each VM's last two fragment fences and add apple_vm_overlap, default
off. When enabled on a chip with per-VM scenes, geometry waits on its own
VM's previous fragment (or last fragment for one scene). Keep the global
scene dependencies with the option off and for chips without per-VM sets.
Reference and release the per-VM history with the existing VM lifetime.

Affects: Apple A9 (S8003). T8010 has no per-VM scene hook and keeps its
global dependencies regardless of the parameter.

Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_apple.c      | 61 +++++++++++++++++++-
 drivers/gpu/drm/imagination/pvr_apple_chip.h | 10 +++-
 2 files changed, 67 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_apple.c b/drivers/gpu/drm/imagination/pvr_apple.c
index 6c72c88..bcfc2e4 100644
--- a/drivers/gpu/drm/imagination/pvr_apple.c
+++ b/drivers/gpu/drm/imagination/pvr_apple.c
@@ -64,6 +64,10 @@ MODULE_PARM_DESC(apple_poll_us, "Apple A10: microseconds between job completion
 /* Idle time before runtime PM powers the GPU off; tunable in sysfs. */
 #define PVR_APPLE_AUTOSUSPEND_MS	1000
 
+static bool pvr_apple_vm_overlap;
+module_param_named(apple_vm_overlap, pvr_apple_vm_overlap, bool, 0644);
+MODULE_PARM_DESC(apple_vm_overlap, "Apple per-VM scene overlap (default 0)");
+
 static unsigned int pvr_apple_perf_state;
 module_param_named(apple_perf_state, pvr_apple_perf_state, uint, 0444);
 MODULE_PARM_DESC(apple_perf_state,
@@ -325,6 +329,7 @@ static int pvr_apple_power_init(struct pvr_device *pvr_dev)
 	spin_lock_init(&apple->event_lock);
 	for (i = 0; i < APPLE_ENGINES; i++)
 		INIT_LIST_HEAD(&apple->pending[i]);
+	xa_init(&apple->vm_frags);
 	INIT_DELAYED_WORK(&apple->poll_work, pvr_apple_poll_work);
 	hrtimer_setup(&apple->poll_timer, pvr_apple_poll_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
 	apple->fence_context = dma_fence_context_alloc(APPLE_ENGINES);
@@ -850,12 +855,23 @@ void pvr_apple_report_hang(struct pvr_device *pvr_dev, struct dma_fence *fence)
 /* No job is ordered after the scenes submitted so far any more */
 static void pvr_apple_forget_scenes(struct pvr_apple *apple)
 {
+	struct pvr_apple_vm_frags *frags;
+	unsigned long index;
+
+	spin_lock_irq(&apple->fence_lock);
+	xa_for_each(&apple->vm_frags, index, frags) {
+		dma_fence_put(frags->last);
+		dma_fence_put(frags->prev);
+		frags->last = NULL;
+		frags->prev = NULL;
+	}
 	dma_fence_put(apple->last_frag);
 	apple->last_frag = NULL;
 	dma_fence_put(apple->prev_frag);
 	apple->prev_frag = NULL;
 	dma_fence_put(apple->last_geom);
 	apple->last_geom = NULL;
+	spin_unlock_irq(&apple->fence_lock);
 }
 
 static unsigned int pvr_apple_cancel_fences(struct pvr_apple *apple, int error)
@@ -1038,6 +1054,18 @@ void pvr_apple_vm_fini(struct pvr_device *pvr_dev, struct pvr_vm_context *vm_ctx
 
 	if (vm_ctx == pvr_dev->kernel_vm_ctx)
 		return;
+	{
+		struct pvr_apple_vm_frags *frags;
+
+		spin_lock_irq(&apple->fence_lock);
+		frags = xa_erase(&apple->vm_frags, (unsigned long)vm_ctx);
+		spin_unlock_irq(&apple->fence_lock);
+		if (frags) {
+			dma_fence_put(frags->last);
+			dma_fence_put(frags->prev);
+			kfree(frags);
+		}
+	}
 	if (apple->chip->vm_fini)
 		apple->chip->vm_fini(apple, vm_ctx);
 	if (!apple->booted)
@@ -1224,7 +1252,9 @@ struct dma_fence *pvr_apple_submit_job(struct pvr_job *job)
  * &pvr_apple_chip.vm_scenes): a geometry job then waits for the fragment job
  * before the last one if the last one is its own VM's, and a fragment job
  * for its geometry job to be submitted rather than finished
- * (pvr_apple_job_armed()).
+ * (pvr_apple_job_armed()). With apple_vm_overlap on, a chip with per-VM
+ * scenes takes only this VM's previous fragment (or last for one scene),
+ * as each VM owns its PM sets; the global timelines remain for A10/knob 0.
  *
  * Return: 0 or a negative error.
  */
@@ -1240,9 +1270,14 @@ int pvr_apple_job_add_deps(struct pvr_job *job)
 	/* Take this VM's first scene even when another VM rendered last. */
 	if (job->type == DRM_PVR_JOB_TYPE_GEOMETRY && apple->chip->vm_scenes)
 		scenes = apple->chip->vm_scenes(apple, job->ctx->vm_ctx);
-	if (job->type == DRM_PVR_JOB_TYPE_FRAGMENT)
+	if (job->type == DRM_PVR_JOB_TYPE_FRAGMENT) {
 		last = apple->last_geom;
-	else if (apple->chip->scenes > 1 && apple->last_frag_vm == job->ctx->vm_ctx &&
+	} else if (apple->chip->vm_scenes && READ_ONCE(pvr_apple_vm_overlap)) {
+		struct pvr_apple_vm_frags *frags = xa_load(&apple->vm_frags,
+						       (unsigned long)job->ctx->vm_ctx);
+
+		last = frags ? (scenes > 1 ? frags->prev : frags->last) : NULL;
+	} else if (apple->chip->scenes > 1 && apple->last_frag_vm == job->ctx->vm_ctx &&
 		 scenes > 1)
 		last = apple->prev_frag;
 	else
@@ -1276,6 +1311,14 @@ void pvr_apple_job_armed(struct pvr_job *job, struct dma_fence *finished)
 	old = *last;
 	*last = dma_fence_get(finished);
 	if (job->type == DRM_PVR_JOB_TYPE_FRAGMENT) {
+		struct pvr_apple_vm_frags *frags = xa_load(&apple->vm_frags,
+						       (unsigned long)job->ctx->vm_ctx);
+
+		if (frags) {
+			dma_fence_put(frags->prev);
+			frags->prev = frags->last;
+			frags->last = dma_fence_get(finished);
+		}
 		apple->last_frag_vm = job->ctx->vm_ctx;
 		if (joint)
 			swap(old, apple->prev_frag);
@@ -1300,6 +1343,18 @@ int pvr_apple_vm_init(struct pvr_device *pvr_dev, struct pvr_vm_context *vm_ctx)
 	struct pvr_apple *apple = to_apple(pvr_dev);
 	int err;
 
+	if (apple->chip->vm_scenes) {
+		struct pvr_apple_vm_frags *frags = kzalloc(sizeof(*frags), GFP_KERNEL);
+
+		if (!frags)
+			return -ENOMEM;
+		err = xa_err(xa_store(&apple->vm_frags, (unsigned long)vm_ctx,
+				      frags, GFP_KERNEL));
+		if (err) {
+			kfree(frags);
+			return err;
+		}
+	}
 	err = pvr_vm_map_reserved(vm_ctx, apple->data.obj, PVR_APPLE_GPU_DATA,
 				  PVR_DEVICE_PAGE_SIZE);
 	if (!err)
diff --git a/drivers/gpu/drm/imagination/pvr_apple_chip.h b/drivers/gpu/drm/imagination/pvr_apple_chip.h
index d524415..2ef5208 100644
--- a/drivers/gpu/drm/imagination/pvr_apple_chip.h
+++ b/drivers/gpu/drm/imagination/pvr_apple_chip.h
@@ -26,6 +26,7 @@
 #include <linux/spinlock.h>
 #include <linux/types.h>
 #include <linux/workqueue.h>
+#include <linux/xarray.h>
 
 struct devfreq;
 struct pvr_gem_object;
@@ -74,6 +75,10 @@ struct pvr_apple_layout {
 	u32 event_size;
 };
 
+struct pvr_apple_vm_frags {
+	struct dma_fence *last, *prev;
+};
+
 struct pvr_apple {
 	struct pvr_device *pvr_dev;
 	const struct pvr_apple_chip *chip;
@@ -120,6 +125,7 @@ struct pvr_apple {
 	 * Chips with &pvr_apple_chip.scenes of 2: the fragment job before
 	 * @last_frag, and the VM @last_frag runs in.
 	 */
+	struct xarray vm_frags; /* per-VM last/previous fragment fences, fence_lock */
 	struct dma_fence *prev_frag;
 	const struct pvr_vm_context *last_frag_vm;
 
@@ -208,7 +214,9 @@ struct pvr_apple {
  * @scenes: Scenes (a geometry job and its fragment job) one VM may have in the
  *	firmware at a time; 0 is 1. Above 1 a fragment job is submitted as soon
  *	as its geometry job was, not when that finished: the firmware orders
- *	the two. Scenes of different VMs never overlap.
+ *	the two. With @vm_scenes, scenes of different VMs may overlap: each
+ *	VM owns its PM sets. AGXWorkQueue_initAndAttachPM has one PM per queue;
+ *	AGXTACommandDescriptor_preparePMAndWork waits only on that PM's stamps.
  * @own_pm_pages: The chip allocates the parameter manager's pages itself; a
  *	free list has none (pvr_apple_free_list_has_pages()).
  * @gate_off_ms: How long the GPU's power domain stays off before the firmware
