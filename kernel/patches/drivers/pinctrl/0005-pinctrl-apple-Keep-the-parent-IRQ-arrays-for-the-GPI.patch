From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tompta1 <546706+tompta1@users.noreply.github.com>
Date: Tue, 24 Nov 2026 03:02:06 +0800
Subject: [PATCH] pinctrl: apple: Keep the parent IRQ arrays for the GPIO
 chip's lifetime

gpiolib keeps the parent interrupt array and the handler data array it is
given and uses them again when the chip goes away (and, for nested chips,
when mapping interrupts). Allocate both device-managed instead of freeing
them right after registration. This affects every Apple SoC with GPIO
interrupts.

[Orchard: from OrchardLinux/orchard#205 (tompta1, 09038adf),
 kernel/patches/drivers/pinctrl/0005; the "apple,t8011-pinctrl" match entry
 dropped: its "apple,s8000-pinctrl" fallback already selects the S8000
 mux.]

Assisted-by: LLM
---
 drivers/pinctrl/pinctrl-apple-gpio.c | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/drivers/pinctrl/pinctrl-apple-gpio.c b/drivers/pinctrl/pinctrl-apple-gpio.c
index b97023c97..cc515c16a 100644
--- a/drivers/pinctrl/pinctrl-apple-gpio.c
+++ b/drivers/pinctrl/pinctrl-apple-gpio.c
@@ -427,19 +427,20 @@ static int apple_gpio_register(struct apple_gpio_pinctrl *pctl)
 		gpio_irq_chip_set_chip(girq, &apple_gpio_irqchip);
 		girq->parent_handler = apple_gpio_irq_handler;
 
-		girq->parents = kmalloc_array(girq->num_parents,
+		girq->parents = devm_kcalloc(pctl->dev, girq->num_parents,
 					      sizeof(*girq->parents),
 					      GFP_KERNEL);
-		irq_data = kmalloc_objs(*irq_data, girq->num_parents);
+		irq_data = devm_kcalloc(pctl->dev, girq->num_parents,
+					 sizeof(*irq_data), GFP_KERNEL);
 		if (!girq->parents || !irq_data) {
 			ret = -ENOMEM;
-			goto out_free_irq_data;
+			goto out_return;
 		}
 
 		for (i = 0; i < girq->num_parents; i++) {
 			ret = platform_get_irq(to_platform_device(pctl->dev), i);
 			if (ret < 0)
-				goto out_free_irq_data;
+				goto out_return;
 
 			girq->parents[i] = ret;
 			pctl->irqgrps[i] = i;
@@ -454,9 +455,7 @@ static int apple_gpio_register(struct apple_gpio_pinctrl *pctl)
 
 	ret = devm_gpiochip_add_data(pctl->dev, &pctl->gpio_chip, pctl);
 
-out_free_irq_data:
-	kfree(girq->parents);
-	kfree(irq_data);
+out_return:
 
 	return ret;
 }
