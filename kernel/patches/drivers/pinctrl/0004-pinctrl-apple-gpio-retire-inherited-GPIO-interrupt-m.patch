From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 8 Nov 2026 16:00:00 +0100
Subject: [PATCH] pinctrl: apple-gpio: retire inherited GPIO interrupt modes
 after kexec

After a kexec, or after a panic that ran no shutdown callbacks, GPIO
pins can still be in an interrupt mode set up by the previous kernel.
Once the chained parent interrupts are enabled, such a pin raises an
interrupt that nobody maps or acknowledges, and it keeps firing.

On apple,s8000-pinctrl, switch every GPIO interrupt mode off at probe,
before the parent interrupts are enabled, and keep outputs, mux, pulls,
data and grouping. Consumers arm their own pins again later. In the
handler, a pending pin without a mapping is masked and its group latch
cleared, with a rate-limited warning.

Assisted-by: LLM
---
 drivers/pinctrl/pinctrl-apple-gpio.c | 62 +++++++++++++++++++++++++++-
 1 file changed, 60 insertions(+), 2 deletions(-)

diff --git a/drivers/pinctrl/pinctrl-apple-gpio.c b/drivers/pinctrl/pinctrl-apple-gpio.c
index b97023c97..766fcf5bc 100644
--- a/drivers/pinctrl/pinctrl-apple-gpio.c
+++ b/drivers/pinctrl/pinctrl-apple-gpio.c
@@ -19,6 +19,7 @@
 #include <linux/irq.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/of_fdt.h>
 #include <linux/of_irq.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
@@ -46,6 +47,7 @@ struct apple_gpio_pinctrl {
 
 	void __iomem *base;
 	struct regmap *map;
+	bool retire_irqs;
 
 	struct pinctrl_desc pinctrl_desc;
 	struct gpio_chip gpio_chip;
@@ -379,8 +381,33 @@ static void apple_gpio_irq_handler(struct irq_desc *desc)
 	chained_irq_enter(chip, desc);
 	for (pinh = 0; pinh < gc->ngpio; pinh += 32) {
 		pending = readl_relaxed(pctl->base + REG_IRQ(*grpp, pinh));
-		for_each_set_bit(pinl, &pending, 32)
-			generic_handle_domain_irq(gc->irq.domain, pinh + pinl);
+		for_each_set_bit(pinl, &pending, 32) {
+			unsigned int pin = pinh + pinl;
+			int ret;
+
+			ret = pin < gc->ngpio ?
+				generic_handle_domain_irq(gc->irq.domain, pin) : -EINVAL;
+			if (ret && pctl->retire_irqs) {
+				/* An inherited, unmapped source has nobody to ack it.
+				 * Mask only this GPIO, then clear this group's latch.
+				 */
+				if (pin < gc->ngpio) {
+					u32 reg = apple_gpio_get_reg(pctl, pin);
+					u32 mode = FIELD_GET(REG_GPIOx_MODE, reg);
+					u32 off = FIELD_PREP(REG_GPIOx_MODE,
+							     REG_GPIOx_IN_IRQ_OFF);
+
+					if (!(reg & REG_GPIOx_PERIPH) &&
+					    mode >= REG_GPIOx_IN_IRQ_HI &&
+					    mode <= REG_GPIOx_IN_IRQ_ANY)
+						apple_gpio_set_reg(pctl, pin, REG_GPIOx_MODE, off);
+				}
+				writel(BIT(pinl), pctl->base + REG_IRQ(*grpp, pinh));
+				dev_warn_ratelimited(pctl->dev,
+						     "masked orphan inherited GPIO IRQ group=%u pin=%u\n",
+						     *grpp, pin);
+			}
+		}
 	}
 	chained_irq_exit(chip, desc);
 }
@@ -403,6 +430,35 @@ static const struct irq_chip apple_gpio_irqchip = {
 
 /* Probe & register */
 
+static void apple_gpio_quiesce_irqs(struct apple_gpio_pinctrl *pctl)
+{
+	struct gpio_chip *gc = &pctl->gpio_chip;
+	unsigned int pin, group, mode, masked = 0;
+	u32 reg;
+
+	if (!pctl->retire_irqs)
+		return;
+	/* Before chained parent IRQs are enabled, retire old GPIO IRQ modes.
+	 * Preserve outputs, mux, pulls, data and grouping. Consumers rearm their
+	 * own pins later; panic entry need not have run any shutdown callbacks.
+	 */
+	for (pin = 0; pin < gc->ngpio; pin++) {
+		reg = apple_gpio_get_reg(pctl, pin);
+		mode = FIELD_GET(REG_GPIOx_MODE, reg);
+		if (!(reg & REG_GPIOx_PERIPH) && mode >= REG_GPIOx_IN_IRQ_HI &&
+		    mode <= REG_GPIOx_IN_IRQ_ANY) {
+			apple_gpio_set_reg(pctl, pin, REG_GPIOx_MODE,
+					   FIELD_PREP(REG_GPIOx_MODE, REG_GPIOx_IN_IRQ_OFF));
+			masked++;
+		}
+	}
+	for (group = 0; group < gc->irq.num_parents; group++)
+		for (pin = 0; pin < gc->ngpio; pin += 32)
+			writel(GENMASK(min(32U, gc->ngpio - pin) - 1, 0),
+			       pctl->base + REG_IRQ(group, pin));
+	dev_info(pctl->dev, "inherited GPIO IRQ baseline: masked %u inherited inputs\n", masked);
+}
+
 static int apple_gpio_register(struct apple_gpio_pinctrl *pctl)
 {
 	struct gpio_irq_chip *girq = &pctl->gpio_chip.irq;
@@ -452,6 +508,7 @@ static int apple_gpio_register(struct apple_gpio_pinctrl *pctl)
 		girq->handler = handle_level_irq;
 	}
 
+	apple_gpio_quiesce_irqs(pctl);
 	ret = devm_gpiochip_add_data(pctl->dev, &pctl->gpio_chip, pctl);
 
 out_free_irq_data:
@@ -485,6 +542,7 @@ static int apple_gpio_pinctrl_probe(struct platform_device *pdev)
 	if (!pctl)
 		return -ENOMEM;
 	pctl->dev = &pdev->dev;
+	pctl->retire_irqs = of_device_is_compatible(pdev->dev.of_node, "apple,s8000-pinctrl");
 	pctl->soc = of_device_get_match_data(&pdev->dev);
 	pctl->gpio_chip.irq.num_parents = nirqs;
 	dev_set_drvdata(&pdev->dev, pctl);
