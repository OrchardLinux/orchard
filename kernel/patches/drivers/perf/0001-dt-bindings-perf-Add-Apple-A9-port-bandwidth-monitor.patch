---
 .../bindings/perf/apple,s8000-amc-pmu.yaml    | 29 +++++++++++++++++++
 1 file changed, 29 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/perf/apple,s8000-amc-pmu.yaml

diff --git a/Documentation/devicetree/bindings/perf/apple,s8000-amc-pmu.yaml b/Documentation/devicetree/bindings/perf/apple,s8000-amc-pmu.yaml
new file mode 100644
index 000000000..f8c3591c1
--- /dev/null
+++ b/Documentation/devicetree/bindings/perf/apple,s8000-amc-pmu.yaml
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/perf/apple,s8000-amc-pmu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple A9 memory controller bandwidth counters
+
+maintainers:
+  - Berkay Kösebay <brkosebay@users.noreply.github.com>
+
+description: |
+  The memory cache controller has fixed counters for CPU and GPU traffic.
+  The register range covers only the port bandwidth monitor, not the full
+  memory controller. Events count bytes across the whole SoC. The counters
+  are polled and do not require an interrupt.
+
+properties:
+  compatible:
+    const: apple,s8000-amc-pmu
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
