From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Sun, 8 Nov 2026 17:15:00 +0100
Subject: [PATCH] iommu/apple-dart: keep the certified ANS kexec handoff

Resetting the ANS host or its translations destroys the state required
by the next kernel. Retain the stopped-DMA handoff only where the device
tree requests it.

Assisted-by: LLM
---
 drivers/iommu/apple-dart.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 1ee6add55..5aff4bc3e 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -35,6 +35,7 @@
 #include <linux/types.h>
 
 #include <linux/apple-dart.h>
+#include <linux/apple-ans.h>
 
 #include "dma-iommu.h"
 
@@ -1009,6 +1010,29 @@ apple_dart_setup_translation(struct apple_dart_domain *domain,
 	return dart->hw->invalidate_tlb(stream_map);
 }
 
+int apple_ans_dart_stop(struct device *dev)
+{
+	struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
+	struct apple_dart_master_cfg *cfg = dev_iommu_priv_get(dev);
+	struct apple_dart_stream_map *map;
+	int i;
+
+	if (!domain || !cfg ||
+	    !cfg->stream_maps[0].dart ||
+	    !of_property_read_bool(cfg->stream_maps[0].dart->dev->of_node,
+				   "apple,ans-dart-handoff") ||
+	    (domain->type != IOMMU_DOMAIN_DMA && domain->type != IOMMU_DOMAIN_DMA_FQ))
+		return -ENODEV;
+	for_each_stream_map(i, cfg, map) {
+		if (map->dart->hw->type != DART_S5L8960X)
+			return -EOPNOTSUPP;
+		apple_dart_hw_disable_dma(map);
+	}
+	dev_info(dev, "Apple ANS: DART stopped for handoff\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_ans_dart_stop);
+
 static int apple_dart_finalize_domain(struct apple_dart_domain *dart_domain,
 				      struct apple_dart_master_cfg *cfg)
 {
