From d7f21f46aa3e225f902a1a8b18211976327ba14e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:46:21 +0100
Subject: [PATCH] dt-bindings: display: Describe the Apple scanout DART and
 SMMU

The display fetch path has a DART and a second SMMU front end. Describe
both named register windows and fault interrupts for the S5L8960X layout,
and the display pipe's optional deferred-attach scanout DMA master.
Existing single-window IOMMUs and display pipes remain valid.

Affects: Apple S5L8960X display DART and scanout device trees.

Assisted-by: LLM
---
 .../display/apple,s8000-display-pipe.yaml     | 31 +++++++++--
 .../devicetree/bindings/iommu/apple,dart.yaml | 52 ++++++++++++++++++-
 2 files changed, 78 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/apple,s8000-display-pipe.yaml b/Documentation/devicetree/bindings/display/apple,s8000-display-pipe.yaml
index 4df755c..103344b 100644
--- a/Documentation/devicetree/bindings/display/apple,s8000-display-pipe.yaml
+++ b/Documentation/devicetree/bindings/display/apple,s8000-display-pipe.yaml
@@ -18,9 +18,11 @@ description: |
   bootloader leaves the pipe, the eDP link and the panel running; the pipe
   reads memory through the display DART (dart-disp0), which the bootloader
   leaves in bypass (on the A10, the scanout's streams have no page tables).
-  The DART has no node of its own: it must not be reset under the running
-  scanout, so its two register windows are listed here and only read, to
-  check that the scanout bypasses translation.
+  The pipe's two dart-disp0 register windows, the DART and the SMMU in
+  front of it, are listed here and only read, to check that the scanout
+  bypasses translation. For translated scanout the DART may also be
+  described as a disabled iommu node that the display driver enables on
+  request, referenced from a "scanout" child node.
 
 properties:
   compatible:
@@ -46,6 +48,29 @@ properties:
     minItems: 2
     maxItems: 3
 
+  scanout:
+    type: object
+    additionalProperties: false
+    description:
+      The pipe's memory reads as a DMA master behind the display DART, for
+      translated scanout. Every stream of the DART is listed. The
+      bootloader leaves the DART in bypass under a live scanout, so the
+      attach is deferred until the driver has mapped that scanout.
+
+    properties:
+      iommus:
+        minItems: 1
+        maxItems: 4
+
+      apple,dart-deferred-attach:
+        type: boolean
+        description:
+          Keep the DART in bypass for this master until its driver attaches
+          the default domain itself.
+
+    required:
+      - iommus
+
 allOf:
   - if:
       properties:
diff --git a/Documentation/devicetree/bindings/iommu/apple,dart.yaml b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
index df72722..9bbc29f 100644
--- a/Documentation/devicetree/bindings/iommu/apple,dart.yaml
+++ b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
@@ -41,10 +41,27 @@ properties:
           - const: apple,s5l8960x-dart
 
   reg:
-    maxItems: 1
+    minItems: 1
+    maxItems: 2
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: dart
+      - const: smmu
+    description:
+      The SMMU window of display DARTs; translation must be enabled per
+      stream in both units. Only S5L8960X display DARTs have this window.
 
   interrupts:
-    maxItems: 1
+    minItems: 1
+    maxItems: 2
+
+  interrupt-names:
+    minItems: 1
+    items:
+      - const: dart
+      - const: smmu
 
   clocks:
     description:
@@ -99,6 +116,37 @@ allOf:
         apple,error-reflector: false
         apple,fetch-config: false
         apple,diag-config: false
+        reg:
+          maxItems: 1
+        reg-names: false
+        interrupts:
+          maxItems: 1
+        interrupt-names: false
+
+  - if:
+      properties:
+        reg:
+          minItems: 2
+    then:
+      required:
+        - reg-names
+        - interrupt-names
+      properties:
+        reg-names:
+          minItems: 2
+        interrupts:
+          minItems: 2
+        interrupt-names:
+          minItems: 2
+
+  - if:
+      properties:
+        interrupts:
+          minItems: 2
+    then:
+      properties:
+        reg:
+          minItems: 2
 
 additionalProperties: false
 
