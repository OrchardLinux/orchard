From 938004227cbf513cfc3802c52d3561bec0fa6b22 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:46:21 +0100
Subject: [PATCH] iommu/apple-dart: Defer attachment of masters left running by
 firmware

The boot loader leaves display scanout fetching its framebuffer through a
bypassed DART. Attaching an empty DMA domain under those reads can blank
or corrupt the display before its driver has mapped the live addresses.

Let a DMA master request apple,dart-deferred-attach and export the existing
iommu_deferred_attach() helper. The display driver can populate its default
domain before enabling translation. Other masters keep their attach policy.

Affects: Apple display DMA masters left running by the boot loader.

Assisted-by: LLM
---
 drivers/iommu/apple-dart.c | 14 ++++++++++++++
 drivers/iommu/iommu.c      |  1 +
 2 files changed, 15 insertions(+)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 1ee6add..4b3ec7c 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -1457,6 +1457,19 @@ out:
 	return res;
 }
 
+/*
+ * A master that the boot loader left reading memory through this DART in
+ * bypass, such as a display pipe scanning out its boot framebuffer, keeps
+ * bypass until its driver has mapped those live addresses into the default
+ * domain and calls iommu_deferred_attach(). Translation then never starts
+ * under a fetch of an unmapped address.
+ */
+static bool apple_dart_is_attach_deferred(struct device *dev)
+{
+	return of_property_read_bool(dev->of_node,
+				     "apple,dart-deferred-attach");
+}
+
 static int apple_dart_def_domain_type(struct device *dev)
 {
 	struct apple_dart_master_cfg *cfg = dev_iommu_priv_get(dev);
@@ -1503,6 +1516,7 @@ static const struct iommu_ops apple_dart_iommu_ops = {
 	.device_group = apple_dart_device_group,
 	.of_xlate = apple_dart_of_xlate,
 	.def_domain_type = apple_dart_def_domain_type,
+	.is_attach_deferred = apple_dart_is_attach_deferred,
 	.get_resv_regions = apple_dart_get_resv_regions,
 	.owner = THIS_MODULE,
 	.default_domain_ops = &(const struct iommu_domain_ops) {
diff --git a/drivers/iommu/iommu.c b/drivers/iommu/iommu.c
index cd1bca7..8ba534a 100644
--- a/drivers/iommu/iommu.c
+++ b/drivers/iommu/iommu.c
@@ -2243,6 +2243,7 @@ int iommu_deferred_attach(struct device *dev, struct iommu_domain *domain)
 		return -EBUSY;
 	return __iommu_attach_device(domain, dev, NULL);
 }
+EXPORT_SYMBOL_GPL(iommu_deferred_attach);
 
 void iommu_detach_device(struct iommu_domain *domain, struct device *dev)
 {
