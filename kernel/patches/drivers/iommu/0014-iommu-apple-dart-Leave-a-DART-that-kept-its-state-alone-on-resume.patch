From 58ea3c7561dab964552dcc0e807b64deb9b32020 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Berkay=20K=C3=B6sebay?= <brkosebay@users.noreply.github.com>
Date: Tue, 17 Nov 2026 18:28:16 +0100
Subject: [PATCH] iommu: apple-dart: Leave a DART that kept its state alone on
 resume

Resume resets every DART and writes the saved TCR and TTBR values back,
because a DART inside a PCIe port or another power domain that goes off
in sleep loses them. The S8003 display DART is not one of those: its
domain (ps_disp0) stays on, and the display pipe keeps scanning out
through it for the whole sleep. The reset turns translation off and
clears the TTBRs under that live scanout before the saved values are
written back.

Compare the live registers with the saved ones first. A DART that reads
back exactly what was saved, with translation set up on at least one
stream, kept its state and is left as it is. One that lost power reads
its reset values and is reset and restored as before, so the PCIe DARTs
are unchanged.

Assisted-by: LLM
---
 drivers/iommu/apple-dart.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 368ac4c..d559de2 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -2196,12 +2196,43 @@ static __maybe_unused int apple_dart_suspend(struct device *dev)
 	return 0;
 }
 
+/*
+ * Did the DART keep its translation state over the sleep? A DART whose power
+ * domain stayed on (the display pipe's, always on while it scans out) reads
+ * back what was saved, with translation set up on some stream; one that lost
+ * power reads its reset values.
+ */
+static bool apple_dart_kept_state(struct apple_dart *dart)
+{
+	unsigned int sid, idx;
+	bool active = false;
+
+	for (sid = 0; sid < dart->num_streams; sid++) {
+		if (dart->hw->read_tcr(dart, sid) != dart->save_tcr[sid])
+			return false;
+		for (idx = 0; idx < dart->hw->ttbr_count; idx++)
+			if (readl(dart->regs + DART_TTBR(dart, sid, idx)) !=
+			    dart->save_ttbr[sid][idx])
+				return false;
+		active |= dart->save_tcr[sid] != 0;
+	}
+	return active;
+}
+
 static __maybe_unused int apple_dart_resume(struct device *dev)
 {
 	struct apple_dart *dart = dev_get_drvdata(dev);
 	unsigned int sid, idx;
 	int ret;
 
+	/*
+	 * A DART that kept its state may still be translating for a master
+	 * that never stopped, such as a display pipe scanning out: a reset
+	 * would turn its translation off under it. Leave it as it is.
+	 */
+	if (apple_dart_kept_state(dart))
+		return 0;
+
 	ret = apple_dart_hw_reset(dart);
 	if (ret) {
 		dev_err(dev, "Failed to reset DART on resume\n");
