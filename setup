#!/bin/sh
# One command after cloning: installs the orchard command, then shows what
# this computer has and lacks for building and booting. Safe to rerun.
set -eu
bin=${ORCHARD_BIN:-$HOME/.local/bin}
command -v curl >/dev/null 2>&1 || { echo 'curl is needed to download the orchard command.' >&2; exit 1; }
curl -fsSL https://raw.githubusercontent.com/OrchardLinux/tools/main/install.sh | sh
echo
exec "$bin/orchard" doctor
