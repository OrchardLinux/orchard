#!/bin/sh
# This checkout's orchard: the orchard command with this checkout's recipes
# and board data, wherever it is called from.
#
#   bin/orchard ARGS          orchard ARGS, on this checkout
#   bin/orchard python ARGS   Python in this checkout's environment (uv)
#
# The `orchard` on PATH alone uses the newest nightly's recipes and data.
set -eu

script=$0
while [ -L "$script" ]; do
    target=$(readlink "$script")
    case $target in
        /*) script=$target ;;
        *) script=$(dirname "$script")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd -P)

case ${1:-} in
    python)
        command -v uv >/dev/null 2>&1 || {
            echo 'orchard: install uv: https://docs.astral.sh/uv/getting-started/installation/' >&2
            exit 1
        }
        shift
        UV_PROJECT_ENVIRONMENT="$root/.venv" exec uv run --quiet --project "$root" python "$@" ;;
esac
# The program on PATH, never this file again.
old=$IFS
IFS=:
for directory in $PATH; do
    IFS=$old
    if [ -x "$directory/orchard" ] && [ ! "$directory/orchard" -ef "$script" ] &&
       ! grep -qs 'the orchard command is a program of its own now' "$directory/orchard"; then
        ORCHARD_DATA=${ORCHARD_DATA:-$root} exec "$directory/orchard" "$@"
    fi
done
echo 'orchard: the orchard command is not installed. Install it:' >&2
echo '  curl -fsSL https://raw.githubusercontent.com/OrchardLinux/tools/main/install.sh | sh' >&2
exit 1
