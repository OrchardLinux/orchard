[Unit]
Description=Start the Wi-Fi radio of Apple A7 boards
Documentation=https://github.com/OrchardLinux/orchard
DefaultDependencies=no
After=systemd-udevd.service systemd-modules-load.service
Before=network-pre.target NetworkManager.service
Wants=network-pre.target
# The device tree describes the radio (apple,s5l8960x-hsic-wlan).
ConditionPathExistsGlob=/proc/device-tree/wifi@20c0000*

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/orchard/a7-wifi-start
TimeoutStartSec=90
