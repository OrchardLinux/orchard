#!/usr/bin/python3 -I
"""Exit successfully only when the running board declares FEATURE STATE."""
import json
from pathlib import Path
import sys

def main():
    if len(sys.argv) != 3:
        return 1
    try:
        live = Path('/sys/firmware/devicetree/base/compatible').read_bytes().decode().split('\0')
        records = json.loads(Path('/usr/lib/orchard/device-features.json').read_text())
        matched = [r for r in records if set(r['compatible']) & set(live)]
        return 0 if len(matched) == 1 and matched[0]['features'].get(sys.argv[1]) == sys.argv[2] else 1
    except (OSError, ValueError, KeyError, TypeError):
        return 1

if __name__ == '__main__':
    sys.exit(main())
