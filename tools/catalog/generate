#!/usr/bin/env python3
"""The device catalog: what public sources say about every board, and the matrix.

  tools/catalog/generate write --linux TREE    add missing boards, refresh every boot.json
  tools/catalog/generate check --linux TREE    report where the catalog and public sources differ
  tools/catalog/generate kernel --kernel PLATFORM=DIR ...
                                               record which drivers each board's device tree binds
  tools/catalog/generate matrix [--check]      write docs/compatibility.md from the catalog
  tools/catalog/generate publish --output DIR  write the archive and pointer CLIs download

`write` and `check` read api.ipsw.me, each IPSW's BuildManifest and boot files
(by byte range, never a whole IPSW) and OrchardLinux/linux. They need Python
3.11 and nothing else. `write` never edits an existing device.toml, because its
comments and feature states come from people; it only adds boards that have none.
A boot.json's "methods" also come from people, and are kept as they are.

Default build of a board, in order: the chip's reference_version when the board
has it (or the newest build of that major version), the board's firmware recipe
build, the newest public build. A method that sets "build" adds that build too.

`kernel` reads a built kernel (DIR holds dtbs/, lib/modules/ and sdk/, as an
orchard kernel component does) and writes tools/catalog/drivers.json. It says a
driver could bind on the board, never that the feature works.
"""
import argparse
import concurrent.futures
import gzip
import hashlib
import io
import json
from pathlib import Path
import plistlib
import re
import struct
import subprocess
import sys
import tarfile
import time
import tomllib
import urllib.request
import zipfile

ROOT = Path(__file__).resolve().parents[2]
DEVICES = ROOT / 'devices'
API = 'https://api.ipsw.me/v4'
HEADERS = {'User-Agent': 'orchard-catalog-generator'}
FAMILIES = ('iPad', 'iPhone')
INPUTS = ('iBSS', 'iBEC', 'DeviceTree')
MATRIX = ROOT / 'docs/compatibility.md'
FEATURE_DRIVERS = ROOT / 'tools/catalog/feature-drivers.toml'
DRIVERS = ROOT / 'tools/catalog/drivers.json'
# api.ipsw.me lists some old IPSWs over HTTP; this host serves the same files over HTTPS.
HTTP_HOST, HTTPS_HOST = 'http://appldnld.apple.com/', 'https://secure-appldnld.apple.com/'
CATALOG_SCHEMA = 1  # catalog.SCHEMA: a breaking data change publishes to a new catalog-vN
# What the matrix shows as installable; a test keeps this equal to hardware.IMPLEMENTED_METHODS.
IMPLEMENTED_METHODS = {'checkm8-pongo', 'recovery-autogo'}
# Boards an open pull request adds; generating them here would conflict with it.
IN_REVIEW = {'j72': 'PR #59'}


def secure(url):
    return HTTPS_HOST + url.removeprefix(HTTP_HOST) if url.startswith(HTTP_HOST) else url


def request(url, headers=None, method='GET'):
    for attempt in range(4):
        try:
            return urllib.request.urlopen(urllib.request.Request(
                url, method=method, headers={**HEADERS, **(headers or {})}), timeout=120)
        except OSError:
            if attempt == 3:
                raise
            time.sleep(attempt + 1)


class RemoteFile(io.IOBase):
    """A seekable file over HTTP byte ranges, for zipfile."""

    def __init__(self, url):
        self.url, self.position = url, 0
        self.size = int(request(url, method='HEAD').headers['Content-Length'])

    def seekable(self):
        return True

    def readable(self):
        return True

    def tell(self):
        return self.position

    def seek(self, offset, whence=0):
        self.position = {0: offset, 1: self.position + offset, 2: self.size + offset}[whence]
        return self.position

    def read(self, count=-1):
        count = self.size - self.position if count < 0 else count
        if count == 0 or self.position >= self.size:
            return b''
        last = min(self.position + count, self.size) - 1
        data = request(self.url, {'Range': f'bytes={self.position}-{last}'}).read()
        self.position += len(data)
        return data


def chips():
    """{cpid: chip} from chips/*.toml; the catalog covers exactly these."""
    return {chip['cpid']: chip for chip in
            (tomllib.loads(path.read_text()) for path in sorted((ROOT / 'chips').glob('*.toml')))}


def public_boards(known):
    """[(product, public name, board, number of boards of that product)] on a known chip."""
    result = []
    for product in json.load(request(f'{API}/devices')):
        if not product['identifier'].startswith(FAMILIES):
            continue
        boards = [board for board in product['boards']
                  if board['cpid'] in known and 'DEV' not in board['boardconfig']]
        result += [(product['identifier'], product['name'], board, len(boards)) for board in boards]
    return result


def choose_build(firmwares, chip, recipe_build):
    """(public firmware, the rule that chose it) of a board's default build."""
    reference = chip.get('reference_version')
    if reference:
        exact = [firmware for firmware in firmwares if firmware['version'] == reference]
        if exact:
            return exact[0], 'chip-reference'
        major = reference.split('.')[0] + '.'
        same = [firmware for firmware in firmwares if firmware['version'].startswith(major)]
        if same:
            return same[0], 'chip-reference-major'
    if recipe_build:
        return next(firmware for firmware in firmwares if firmware['buildid'] == recipe_build), 'firmware-recipe'
    return firmwares[0], 'newest'


def read_firmware(firmware, model, selected_by):
    """One boot.json firmware entry, and the board's identity from the BuildManifest."""
    url = secure(firmware['url'])
    archive = zipfile.ZipFile(RemoteFile(url))
    document = archive.read('BuildManifest.plist')
    manifest = plistlib.loads(document)
    identities = [identity for identity in manifest['BuildIdentities']
                  if identity['Info']['DeviceClass'].lower() == model]
    if not identities:
        raise ValueError(f'{firmware["buildid"]} has no identity for {model}')
    identity = next((i for i in identities if 'Erase' in i['Info']['Variant']), identities[0])
    inputs = {'BuildManifest.plist': {'ipsw': {'zip': 'BuildManifest.plist'},
                                      'sha256': hashlib.sha256(document).hexdigest()}}
    names = set(archive.namelist())
    for role in INPUTS:
        path = identity['Manifest'].get(role, {}).get('Info', {}).get('Path')
        if path in names:
            inputs[role] = {'ipsw': {'zip': path}, 'sha256': hashlib.sha256(archive.read(path)).hexdigest()}
    entry = {'ipsw': {'version': firmware['version'], 'build': firmware['buildid'], 'url': url,
                      'bytes': firmware['filesize'], 'sha256': firmware['sha256sum']},
             'selected_by': selected_by, 'inputs': inputs}
    return entry, int(identity['ApChipID'], 16), int(identity['ApBoardID'], 16)


def device_trees(tree):
    """{dtb name: its source} in OrchardLinux/linux."""
    result = {}
    for ref, directory in (('main', 'arch/arm64/boot/dts/apple/'), ('armv7', 'arch/arm/boot/dts/apple/')):
        listing = subprocess.run(['git', '-C', str(tree), 'ls-tree', '--name-only', ref, directory],
                                 capture_output=True, text=True, check=True).stdout.split()
        result.update({path.rsplit('/', 1)[1][:-4]: f'{ref}:{path}' for path in listing if path.endswith('.dts')})
    return result


def board_compatible(tree, source):
    """The board's own compatible string, from its device tree."""
    text = subprocess.run(['git', '-C', str(tree), 'show', source], capture_output=True, text=True, check=True).stdout
    found = re.search(r'compatible\s*=\s*"([^"]+)"', text)
    return found[1] if found else None


def display_name(name, chip, boards):
    name = name.replace('WiFi', 'Wi-Fi')
    return f'{name} ({chip["soc"].upper()})' if boards > 1 else name


def generate(item, known, trees, tree):
    """What public sources say about one board: its facts and its boot.json."""
    product, name, board, boards = item
    model = board['boardconfig'].lower()
    profile = model.removesuffix('ap')
    chip = known[board['cpid']]
    firmwares = json.load(request(f'{API}/device/{product}?type=ipsw'))['firmwares']
    path = DEVICES / profile
    recipe = path / 'firmware.json'
    recipe_build = json.loads(recipe.read_text())['ipsw']['build'] if recipe.is_file() else None
    public, rule = choose_build(firmwares, chip, recipe_build)
    entry, chip_id, board_id = read_firmware(public, model, rule)
    if (chip_id, board_id) != (board['cpid'], board['bdid']):
        raise ValueError(f'{profile}: BuildManifest says {chip_id:#x}/{board_id:#x}, '
                         f'api.ipsw.me {board["cpid"]:#x}/{board["bdid"]:#x}')
    existing = json.loads((path / 'boot.json').read_text()) if (path / 'boot.json').is_file() else {}
    methods = existing.get('methods', {})
    entries = [entry]
    pins = {method['build'] for method in methods.values() if 'build' in method} - {public['buildid']}
    for build in sorted(pins):
        pinned = next(firmware for firmware in firmwares if firmware['buildid'] == build)
        entries.append(read_firmware(pinned, model, 'method')[0])
    dtb = f'{chip["soc"]}-{profile}'
    return {'profile': profile, 'product': product, 'name': display_name(name, chip, boards),
            'chip': chip_id, 'board': board_id, 'platform': chip.get('platform'),
            'dtb': dtb if dtb in trees else None,
            'compatible': board_compatible(tree, trees[dtb]) if dtb in trees else None,
            'boot': {'schema': 1, 'device': product, 'firmware': entries, 'methods': methods}}


def collect(tree):
    known = chips()
    trees = device_trees(tree)
    results, failures = [], []
    items = public_boards(known)
    with concurrent.futures.ThreadPoolExecutor(8) as pool:
        futures = {pool.submit(generate, item, known, trees, tree): item for item in items}
        for future in concurrent.futures.as_completed(futures):
            try:
                results.append(future.result())
            except Exception as error:  # Report every board, not only the first failure.
                failures.append(f'{futures[future][2]["boardconfig"]}: {error}')
    return sorted(results, key=lambda result: result['profile']), failures


def boot_text(board):
    return json.dumps(board['boot'], indent=2) + '\n'


def device_text(board):
    lines = [f'# {board["name"]} ({board["profile"].upper()}): identity from public sources',
             '# (tools/catalog/generate). No Orchard bring-up yet; see docs/device-bring-up.md.',
             'schema = 1', 'kind = "hardware.device"', '', '[device]',
             f'profile = "{board["profile"]}"', f'name = "{board["name"]}"',
             f'apple_products = ["{board["product"]}"]']
    if board['compatible']:
        lines.append(f'dt_compatible = ["{board["compatible"]}"]')
    lines += ['', '[match.dfu]', f'chip = {board["chip"]:#06x}', f'board = {board["board"]:#04x}']
    if board['dtb']:
        lines += ['', '[catalog]', f'dtb = "{board["dtb"]}" # Exists in OrchardLinux/linux; not enabled here yet.']
    return '\n'.join(lines) + '\n'


def write(tree):
    boards, failures = collect(tree)
    added = 0
    for board in boards:
        if board['profile'] in IN_REVIEW:
            continue
        path = DEVICES / board['profile']
        path.mkdir(exist_ok=True)
        if not (path / 'device.toml').exists():
            (path / 'device.toml').write_text(device_text(board))
            added += 1
        (path / 'boot.json').write_text(boot_text(board))
    print(f'{len(boards)} boards, {added} added')
    return failures


def differences(board):
    """[(field, in the catalog, in public sources)] of one board that has a device.toml."""
    path = DEVICES / board['profile']
    described = tomllib.loads((path / 'device.toml').read_text())
    public = {'chip': board['chip'], 'board': board['board'], 'product': [board['product']],
              'platform': board['platform']}
    catalog = {'chip': described['match']['dfu']['chip'], 'board': described['match']['dfu']['board'],
               'product': described['device']['apple_products'],
               'platform': described.get('kernel', {}).get('platform', board['platform'])}
    if 'kernel' in described:
        public['dtb'], catalog['dtb'] = board['dtb'], described['kernel']['dtb']
    else:
        public['dtb'], catalog['dtb'] = board['dtb'], described.get('catalog', {}).get('dtb')
    found = [(field, catalog[field], public[field]) for field in public if catalog[field] != public[field]]
    recipe = path / 'firmware.json'
    if recipe.is_file():
        pin = json.loads(recipe.read_text())['ipsw']
        firmware = json.load(request(f'{API}/device/{board["product"]}?type=ipsw'))['firmwares']
        listed = next((item for item in firmware if item['buildid'] == pin['build']), None)
        if listed is None:
            found.append(('firmware.json build', pin['build'], 'not public'))
        else:
            for field, key in (('url', 'url'), ('bytes', 'filesize'), ('sha256', 'sha256sum')):
                if pin[field] != listed[key]:
                    found.append((f'firmware.json {field}', pin[field], listed[key]))
    stored = path / 'boot.json'
    if not stored.is_file():
        found.append(('boot.json', None, 'public'))
    elif stored.read_text() != boot_text(board):
        found.append(('boot.json', 'differs', 'run write to refresh'))
    return found


def check(tree):
    boards, failures = collect(tree)
    public = {board['profile'] for board in boards}
    clean = True
    for board in boards:
        if board['profile'] in IN_REVIEW:
            print(f'{board["profile"]}: in review ({IN_REVIEW[board["profile"]]})')
        elif not (DEVICES / board['profile'] / 'device.toml').is_file():
            print(f'{board["profile"]}: no device.toml')
            clean = False
        else:
            for field, ours, theirs in differences(board):
                print(f'{board["profile"]}: {field}: catalog {ours!r}, public {theirs!r}')
                clean = False
    for path in sorted(DEVICES.glob('*/device.toml')):
        if path.parent.name not in public:
            print(f'{path.parent.name}: not in the public list')
            clean = False
    if clean and not failures:
        print(f'{len(boards)} boards match public sources')
    return failures + ([] if clean else ['the catalog differs from public sources'])


def device_tree_nodes(data):
    """[{property: bytes}] of every node in a flattened device tree."""
    magic, _, structure, strings = struct.unpack('>4I', data[:16])
    if magic != 0xd00dfeed:
        raise ValueError('Not a flattened device tree')
    names, offset, stack, nodes = data[strings:], structure, [], []
    while True:
        token = struct.unpack('>I', data[offset:offset + 4])[0]
        offset += 4
        if token == 1:  # begin node: its name, padded to four bytes
            offset = (data.index(b'\0', offset) + 4) & ~3
            stack.append({})
        elif token == 2:  # end node
            nodes.append(stack.pop())
        elif token == 3:  # property: length, name offset, value
            length, name = struct.unpack('>II', data[offset:offset + 8])
            offset += 8
            key = names[name:names.index(b'\0', name)].decode()
            stack[-1][key] = data[offset:offset + length]
            offset = (offset + length + 3) & ~3
        elif token == 9:  # end of the tree
            return nodes


def kernel_drivers(directory):
    """{device tree compatible: driver} of a built kernel: modules and built-in drivers."""
    result = {}
    for path in Path(directory, 'lib/modules').glob('*/modules.alias'):
        for found in re.finditer(r'^alias of:N\*T\*C(\S+?) (\S+)$', path.read_text(), re.M):
            result[found[1].removesuffix('C*')] = found[2]
    builtin = Path(directory, 'sdk/modules.builtin.modinfo').read_bytes()
    for record in builtin.split(b'\0'):
        found = re.fullmatch(rb'(\w+)\.alias=of:N\*T\*C(.+)', record)
        if found:
            result[found[2].decode().removesuffix('C*')] = found[1].decode()
    return result


def bound_features(tree, drivers, wanted):
    """The features whose driver would bind an enabled node of this device tree."""
    bound = set()
    for node in device_tree_nodes(tree):
        if node.get('status', b'okay').rstrip(b'\0') not in (b'okay', b'ok'):
            continue
        names = [name.decode() for name in node.get('compatible', b'').split(b'\0') if name]
        driver = next((drivers[name] for name in names if name in drivers), None)
        if driver:
            bound.update({driver} | {f'{driver}:{key}' for key in node})
    return sorted(feature for feature, options in wanted.items() if bound & set(options))


def kernel_report(directories):
    """Write drivers.json from {platform: built kernel directory}."""
    wanted = tomllib.loads(FEATURE_DRIVERS.read_text())
    known = chips()
    drivers = {platform: kernel_drivers(path) for platform, path in directories.items()}
    boards = {}
    for path in sorted(DEVICES.glob('*/device.toml')):
        described = tomllib.loads(path.read_text())
        platform = known[described['match']['dfu']['chip']].get('platform')
        dtb = described.get('kernel', described.get('catalog', {})).get('dtb')
        if platform in directories and dtb:
            tree = next(Path(directories[platform], 'dtbs').rglob(f'{dtb}.dtb'))
            boards[path.parent.name] = bound_features(tree.read_bytes(), drivers[platform], wanted)
    releases = {platform: Path(path, 'kernel.release').read_text().strip() for platform, path in directories.items()}
    DRIVERS.write_text(json.dumps({'kernels': releases, 'boards': boards}, indent=2, sort_keys=True) + '\n')
    print(f'{len(boards)} boards, kernels {", ".join(sorted(releases.values()))}')
    return []


def disagreements(described, found, wanted):
    """[(feature, what's odd)] between a board's feature states and its drivers."""
    result = []
    for feature in wanted:
        state = described.get('features', {}).get(feature)
        if state in ('working', 'untested') and feature not in found:
            result.append((feature, f'{state}, but no driver binds'))
        elif state == 'missing' and feature in found:
            result.append((feature, 'missing, but a driver binds'))
    return result


def status_of(described):
    if 'kernel' not in described:
        return 'known'
    return described.get('support', {}).get('status', 'experimental')


def gpu_milestone(chip):
    """The highest GLES version whose dEQP suite the chip's driver has reached."""
    reached = chip.get('gpu', {})
    return next((label for key, label in (('gles31', 'GLES 3.1'), ('gles3', 'GLES 3'), ('gles2', 'GLES 2'))
                 if key in reached), '–')


def can_install(profile, described):
    """hardware.install_blockers, for a tool that imports none of orchard."""
    methods = tomllib.loads((ROOT / 'methods.toml').read_text())
    usable = any(name in IMPLEMENTED_METHODS and not methods[name]['boot_json']
                 or name in IMPLEMENTED_METHODS
                 and name in json.loads((DEVICES / profile / 'boot.json').read_text())['methods']
                 for name in described.get('boot', {}).get('methods', []))
    return ('kernel' in described and usable and 'firmware' in described
            and described.get('features', {}).get('storage_write', 'missing') != 'missing')


def cell(value):
    return value if value else '–'


def render():
    """The compatibility matrix, from the catalog alone."""
    known = chips()
    described = {path.parent.name: tomllib.loads(path.read_text()) for path in DEVICES.glob('*/device.toml')}
    order = {chip['soc']: index for index, chip in enumerate(sorted(known.values(), key=_chip_order))}
    rows = {}
    for profile, device in described.items():
        chip = known[device['match']['dfu']['chip']]
        rows.setdefault(chip['soc'], []).append((profile, device))
    lines = ['# Device compatibility', '',
             'Generated by `tools/catalog/generate matrix` from `devices/`, `chips/` and `methods.toml`; '
             'do not edit by hand.', '',
             '- **known:** identity and boot data only, from public sources. Orchard does not build for it yet.',
             '- **experimental / supported:** Orchard builds for it. Feature states are below.',
             '- **Install:** every requirement is met (`hardware.install_blockers`). Other features may not work yet.',
             '- **Device tree:** the board has one in OrchardLinux/linux. It does not mean the board has booted.',
             '- **boot.json:** the Apple boot files are known. It does not mean a method runs on the board.',
             '- **GPU (dEQP):** the highest GLES suite that completes with no GPU hangs and only listed failures, through Zink.',
             '', '## Chips', '',
             '| Chip | SoC | CPID | Core | Page size | Platform | Stages | GPU (dEQP) | Boards | In build | Device tree |',
             '| --- | --- | --- | --- | ---: | --- | --- | --- | ---: | ---: | ---: |']
    for soc in sorted(rows, key=order.get):
        chip = next(chip for chip in known.values() if chip['soc'] == soc)
        boards = rows[soc]
        building = sum('kernel' in device for _, device in boards)
        trees = sum(bool(device.get('kernel', device.get('catalog', {})).get('dtb')) for _, device in boards)
        stages = ' + '.join(chip.get('stages', [])) or '–'
        lines.append(f'| {chip["name"]} | {soc.upper()} | `{chip["cpid"]:#06x}` | {cell(chip.get("core"))} | '
                     f'{chip.get("page_size", "–")} | {cell(chip.get("platform"))} | {stages} | {gpu_milestone(chip)} | {len(boards)} | '
                     f'{building} | {trees} |')
    lines += ['', '## Boards', '',
              '| Chip | Board | Device | Product | Status | Install | Methods | Firmware | Device tree | boot.json build |',
              '| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |']
    for soc in sorted(rows, key=order.get):
        chip = next(chip for chip in known.values() if chip['soc'] == soc)
        for profile, device in sorted(rows[soc]):
            path = DEVICES / profile
            boot = json.loads((path / 'boot.json').read_text()) if (path / 'boot.json').is_file() else None
            build = boot['firmware'][0]['ipsw']['build'] if boot else '–'
            dtb = device.get('kernel', device.get('catalog', {})).get('dtb')
            methods = ', '.join(device.get('boot', {}).get('methods', [])) or '–'
            lines.append(f'| {chip["name"]} | `{profile}` | {device["device"]["name"]} | '
                         f'{", ".join(device["device"]["apple_products"])} | {status_of(device)} | '
                         f'{"yes" if can_install(profile, device) else "–"} | {methods} | '
                         f'{"yes" if (path / "firmware.json").is_file() else "–"} | {"yes" if dtb else "–"} | {build} |')
    lines += ['', 'Not generated while in review: ' + ', '.join(f'`{board}` ({reason})'
                                                                for board, reason in IN_REVIEW.items()) + '.']
    labels = tomllib.loads((ROOT / 'features.toml').read_text())
    lines += ['', '## Features', '', 'Boards Orchard builds for. '
              'States: working, untested, missing, none (no such hardware).', '',
              '| Board | ' + ' | '.join(labels.values()) + ' |',
              '| --- |' + ' --- |' * len(labels)]
    for soc in sorted(rows, key=order.get):
        for profile, device in sorted(rows[soc]):
            if 'kernel' in device:
                lines.append(f'| `{profile}` | ' + ' | '.join(device['features'][name] for name in labels) + ' |')
    if DRIVERS.is_file():
        lines += render_drivers(rows, order, labels)
    return '\n'.join(lines) + '\n'


def render_drivers(rows, order, labels):
    """What the kernel could do on each board, and where the feature states disagree."""
    report = json.loads(DRIVERS.read_text())
    wanted = tomllib.loads(FEATURE_DRIVERS.read_text())
    columns = [name for name in labels if name in wanted]
    lines = ['', '## Drivers', '',
             'A yes means an enabled device tree node binds a driver in '
             f'{", ".join(f"`{release}`" for release in sorted(report["kernels"].values()))}. '
             'It does not mean the feature works. Read by `tools/catalog/generate kernel`.', '',
             '| Board | Status | ' + ' | '.join(labels[name] for name in columns) + ' |',
             '| --- | --- |' + ' --- |' * len(columns)]
    odd = []
    for soc in sorted(rows, key=order.get):
        for profile, device in sorted(rows[soc]):
            if profile not in report['boards']:
                continue
            found = report['boards'][profile]
            cells = ' | '.join('yes' if name in found else '–' for name in columns)
            lines.append(f'| `{profile}` | {status_of(device)} | {cells} |')
            odd += [(profile, labels[feature], text) for feature, text in disagreements(device, found, wanted)]
    if odd:
        lines += ['', '### Where feature states and drivers disagree', '', '| Board | Feature | |', '| --- | --- | --- |']
        lines += [f'| `{profile}` | {feature} | {text} |' for profile, feature, text in odd]
    return lines


def _chip_order(chip):
    number = re.match(r'A(\d+)(.*)', chip['name'])
    return int(number[1]), number[2], chip['cpid']


def matrix(verify):
    text = render()
    if verify:
        current = MATRIX.read_text() if MATRIX.is_file() else ''
        return [] if current == text else [f'{MATRIX.name} is stale: run tools/catalog/generate matrix']
    MATRIX.write_text(text)
    return []


def catalog_members():
    """{name in the archive: file}: what a CLI reads, without docs or tools."""
    members = {name: ROOT / name for name in ('features.toml', 'methods.toml')}
    members['drivers.json'] = DRIVERS
    members.update({f'chips/{path.name}': path for path in (ROOT / 'chips').glob('*.toml')})
    for path in DEVICES.glob('*/*'):
        if path.name in ('device.toml', 'firmware.json', 'boot.json'):
            if path.is_symlink():
                raise ValueError(f'Device data must not contain links: {path}')
            members[f'devices/{path.parent.name}/{path.name}'] = path
    return members


def publish(output, commit):
    """catalog-SHA.tar.gz and catalog.json in OUTPUT: same data, same bytes."""
    buffer = io.BytesIO()
    with gzip.GzipFile(fileobj=buffer, mode='wb', mtime=0) as compressed:
        with tarfile.open(fileobj=compressed, mode='w', format=tarfile.USTAR_FORMAT) as archive:
            for name, path in sorted(catalog_members().items()):
                data = path.read_bytes()
                info = tarfile.TarInfo(name)
                info.size, info.mode = len(data), 0o644
                archive.addfile(info, io.BytesIO(data))
    data = buffer.getvalue()
    digest = hashlib.sha256(data).hexdigest()
    output.mkdir(parents=True, exist_ok=True)
    name = f'catalog-{digest[:12]}.tar.gz'
    (output / name).write_bytes(data)
    (output / 'catalog.json').write_text(json.dumps(
        {'schema': CATALOG_SCHEMA, 'file': name, 'bytes': len(data), 'sha256': digest, 'commit': commit},
        indent=2, sort_keys=True) + '\n')
    print(name)
    return []


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest='command', required=True)
    for name in ('write', 'check'):
        commands.add_parser(name).add_argument('--linux', type=Path, required=True,
                                               help='a clone of OrchardLinux/linux with main and armv7')
    commands.add_parser('kernel').add_argument('--kernel', action='append', required=True, metavar='PLATFORM=DIR',
                                               help='a built kernel of that platform; repeat per platform')
    commands.add_parser('matrix').add_argument('--check', action='store_true', help='fail if it is out of date')
    published = commands.add_parser('publish')
    published.add_argument('--output', type=Path, required=True)
    published.add_argument('--commit', required=True)
    arguments = parser.parse_args()
    if arguments.command == 'write':
        failures = write(arguments.linux)
    elif arguments.command == 'check':
        failures = check(arguments.linux)
    elif arguments.command == 'publish':
        failures = publish(arguments.output, arguments.commit)
    elif arguments.command == 'kernel':
        failures = kernel_report(dict(value.split('=', 1) for value in arguments.kernel))
    else:
        failures = matrix(arguments.check)
    for failure in failures:
        print('error:', failure, file=sys.stderr)
    return 1 if failures else 0


if __name__ == '__main__':
    raise SystemExit(main())
