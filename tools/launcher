#!/bin/sh
# orchard on PATH: runs the newest nightly of orchard.
#
# Every command looks up the newest nightly once (nightly/latest.json) and
# runs a shallow clone of its tag in the Orchard cache (tooling/NAME), so it
# runs one version from start to end and the next command picks up a newer
# one. Offline: the newest nightly already in the cache. ORCHARD_VERSION=
# nightly-YYYYMMDD-COMMIT or vX.Y.Z runs that version instead, e.g. to
# reproduce a bug. To work on orchard itself, run a checkout's bin/orchard.
#
#   orchard update           install the newest nightly's launcher as this one
#   orchard python ARGS      Python in the running version's environment
#
# orchard2, the Rust tool, builds instead when it is switched on for this
# computer: ORCHARD2=1 (0: off), else a line orchard2 = true in
# ~/.config/orchard/config.toml. build, inputs, install, launch, devices, doctor,
# cache and the build step of run then go to the orchard2 on PATH, with the same
# version's data; everything else stays here. A checkout's bin/orchard follows the same switch.
set -eu

cache=${ORCHARD_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/orchard}
url=${ORCHARD_MAINLINE_URL:-https://github.com/OrchardLinux/orchard.git}
releases=${ORCHARD_RELEASES_URL:-https://github.com/OrchardLinux/orchard/releases/download}

# A published version, cloned once at its tag.
version() {
    dir=$cache/tooling/$1
    if [ ! -d "$dir/.git" ]; then
        mkdir -p "$cache/tooling"
        partial=$(mktemp -d "$cache/tooling/.$1.XXXXXX")
        echo "orchard: fetching $1" >&2
        if ! git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$1" "$url" "$partial/orchard" >&2; then
            rm -rf "$partial"
            echo "orchard: no orchard version $1" >&2
            exit 1
        fi
        mv "$partial/orchard" "$dir" 2>/dev/null || [ -d "$dir/.git" ]  # another command was first
        rm -rf "$partial"
    fi
    printf '%s\n' "$dir"
}

pick() {
    if [ -n "${ORCHARD_VERSION:-}" ]; then
        printf '%s' "$ORCHARD_VERSION" | grep -Eqx 'nightly-[0-9]{8}-[0-9a-f]{12}|v[0-9]+\.[0-9]+\.[0-9]+' || {
            echo "orchard: ORCHARD_VERSION must be nightly-YYYYMMDD-COMMIT or vX.Y.Z" >&2
            exit 1
        }
        version "$ORCHARD_VERSION"
        return
    fi
    name=$(curl -fsSL --max-time 20 "$releases/nightly/latest.json" 2>/dev/null |
        sed -n 's/.*"name": *"\(nightly-[0-9]\{8\}-[0-9a-f]\{12\}\)".*/\1/p')
    if [ -n "$name" ]; then
        version "$name"
        return
    fi
    cached=$(ls -d "$cache"/tooling/nightly-* 2>/dev/null | sort | tail -n 1)
    if [ -n "$cached" ]; then
        echo "orchard: no network; the newest cached nightly, $(basename "$cached")" >&2
        printf '%s\n' "$cached"
        return
    fi
    echo "orchard: no nightly reachable ($releases/nightly/latest.json) and none cached;" >&2
    echo "  connect once, or run an orchard checkout's bin/orchard" >&2
    exit 1
}

orchard2_on() {
    case ${ORCHARD2:-} in
        1) return 0 ;;
        0) return 1 ;;
        '') grep -Eqs '^[[:space:]]*orchard2[[:space:]]*=[[:space:]]*true[[:space:]]*(#.*)?$' \
                "${XDG_CONFIG_HOME:-${HOME:-}/.config}/orchard/config.toml" ;;
        *) echo 'orchard: ORCHARD2 is 1 (orchard2 builds) or 0' >&2; exit 1 ;;
    esac
}

needs_orchard2() {
    command -v orchard2 >/dev/null 2>&1 || {
        echo 'orchard: orchard2 is switched on (ORCHARD2 or ~/.config/orchard/config.toml) but not on PATH' >&2
        exit 1
    }
}

# orchard2 COMMAND ARGS, with the recipes in $root and its Python environment.
orchard2_command() {
    needs_orchard2
    uv sync --quiet --project "$root" >&2
    ORCHARD_DATA=${ORCHARD_DATA:-$root} ORCHARD_PYTHON=${ORCHARD_PYTHON:-$root/.venv/bin/python} \
        orchard2 "$@"
}

# orchard2 ARGS while the Python commands' operation lock is held, so that no
# run, boot or install of theirs works on the device at the same time.
under_operation_lock() {
    "$root/.venv/bin/python" -c '
import os, sys
from orchard.state import operation_lock
try:
    with operation_lock() as lock:
        if lock is None:
            raise ValueError("this orchard is older than the switch for install and launch; unset ORCHARD_VERSION or set ORCHARD2=0")
        os.set_inheritable(lock, True)
        os.execvp(sys.argv[1], sys.argv[1:])
except ValueError as error:
    sys.exit(f"orchard: {error}")
' orchard2 "$@"
}

# orchard2 install or launch ARGS. The operation lock is the Python commands':
# it is held for as long as orchard2 runs, so that no run, boot or install of
# theirs works on the device at the same time.
orchard2_on_device() {
    needs_orchard2
    route=${ORCHARD_BOOT:-${ORCHARD_VIA:-}}
    count=$#
    while [ "$count" -gt 0 ]; do
        argument=$1
        shift
        count=$((count - 1))
        case $argument in
            --via)
                [ "$count" -gt 0 ] || { echo 'orchard: --via takes a boot route, such as palera1n, checkra1n or ibss' >&2; exit 2; }
                route=$1; shift; count=$((count - 1)) ;;
            --via=*) route=${argument#*=} ;;
            --manifest|--release) set -- "$@" --index ;;
            --manifest=*|--release=*) set -- "$@" "--index=${argument#*=}" ;;
            *) set -- "$@" "$argument" ;;
        esac
    done
    uv sync --quiet --project "$root" >&2
    # orchard2 knows the routes (routes.toml) and refuses one it has not.
    [ -z "$route" ] || export ORCHARD_BOOT="$route"
    export ORCHARD_DATA="${ORCHARD_DATA:-$root}"
    under_operation_lock "$@"
    exit
}

# A checkout's bin/orchard names itself, for its own code.
checkout=${ORCHARD_LAUNCH_CHECKOUT:-}
unset ORCHARD_LAUNCH_CHECKOUT

# The launcher this is, through links.
self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname "$self")/$target ;;
    esac
done

# orchard = "PATH" in orchard.local.toml used to choose the checkout; it no longer does.
top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
if [ -z "$checkout" ] && [ -f "$top/orchard.local.toml" ] && grep -Eq '^orchard[[:space:]]*=' "$top/orchard.local.toml"; then
    echo "orchard: $top/orchard.local.toml names an orchard (orchard = ...); that is no longer read." >&2
    echo "  Run a checkout's bin/orchard to use it, or set ORCHARD_VERSION to pin a version; then remove the line." >&2
    exit 1
fi

# orchard2 has a cache of its own, listed and pruned by its own commands.
# Python's stays, for what still runs here.
if [ "${1:-}" = cache ] && orchard2_on; then
    shift
    needs_orchard2
    case ${1:-ls} in
        ls|rm|prune|clear|help|-h|--help|--json|--cache|--cache=*) ;;
        --prune|--keep|--keep=*) echo 'orchard: orchard2 prunes with: orchard cache prune [--keep N]' >&2; exit 2 ;;
        *) echo "orchard: orchard2 removes with: orchard cache rm $1" >&2; exit 2 ;;
    esac
    status=0
    orchard2 cache "$@" || status=$?
    python=${ORCHARD_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/orchard}
    if [ -d "$python" ]; then
        size=$(du -sh "$python" 2>/dev/null | cut -f1)
        echo "orchard: Python's own cache uses $size in $python (ORCHARD2=0 orchard cache --prune)" >&2
    fi
    exit "$status"
fi

command -v uv >/dev/null 2>&1 || {
    echo 'orchard: install uv: https://docs.astral.sh/uv/getting-started/installation/' >&2
    exit 1
}
root=${checkout:-$(pick)}
export UV_PROJECT_ENVIRONMENT="$root/.venv"
case ${1:-} in
    update)
        # The orchard on PATH: a file, replacing the link an older setup made.
        installed=${ORCHARD_LAUNCHER:-$HOME/.local/bin/orchard}
        if [ -f "$root/tools/launcher" ] && { [ -L "$installed" ] || ! cmp -s "$installed" "$root/tools/launcher"; }; then
            mkdir -p "$(dirname "$installed")"
            partial=$(dirname "$installed")/.orchard-$$
            cp "$root/tools/launcher" "$partial" && chmod 755 "$partial" && mv -f "$partial" "$installed"
            echo "orchard: $installed is $(basename "$root")'s launcher now" >&2
        else
            echo "orchard runs $(basename "$root"); the launcher is up to date" >&2
        fi
        exit 0 ;;
esac
if [ -z "$checkout" ] && [ -f "$root/tools/launcher" ] && ! cmp -s "$self" "$root/tools/launcher"; then
    echo "orchard: a newer launcher is in $(basename "$root"); run orchard update" >&2
fi
case ${1:-} in
    build|inputs|devices|doctor)
        if orchard2_on; then
            orchard2_command "$@"
            exit
        fi ;;
    install|launch)
        if orchard2_on; then
            orchard2_on_device "$@"
        fi ;;
    distros)
        if orchard2_on; then
            echo 'orchard: orchard2 installs from a name (OrchardLinux/NAME), a URL or a file; it has no registered distros' >&2
            exit 2
        fi ;;
    run)
        # orchard2 builds and boots a payload project. A distribution
        # checkout's release, and a device orchard2 has no boot route for,
        # are booted here after orchard2 built them.
        if orchard2_on; then
            shift
            build=1 help='' directory=. value=''
            route=${ORCHARD_BOOT:-${ORCHARD_VIA:-}}
            for argument; do
                case $value in
                    via) route=$argument; value=; continue ;;
                    other) value=; continue ;;
                esac
                case $argument in
                    --no-build) build= ;;
                    -h|--help) help=1 ;;
                    --via) value=via ;;
                    --via=*) route=${argument#*=} ;;
                    --version|--device|--platform|--cache|--kernel-dir|--kernel-tree|--packages|--pongo|--busybox|--loader) value=other ;;
                    -*) ;;
                    *) directory=$argument ;;
                esac
            done
            # orchard2's own arguments: without -y (it does not ask) and
            # --via (the boot route goes by ORCHARD_BOOT).
            mine() {
                command=$1
                shift
                count=$#
                while [ "$count" -gt 0 ]; do
                    argument=$1
                    shift
                    count=$((count - 1))
                    case $argument in
                        -y|--yes|--via=*) ;;
                        --via) shift; count=$((count - 1)) ;;
                        *) set -- "$@" "$argument" ;;
                    esac
                done
                "$command" "$@"
            }
            if [ -n "$help" ]; then
                :
            elif grep -Eqs '^\[release\]' "$directory/orchard.toml"; then
                if [ -n "$build" ]; then
                    mine orchard2_command build "$@" >&2
                    set -- --no-build "$@"
                fi
            else
                needs_orchard2
                uv sync --quiet --project "$root" >&2
                [ -z "$route" ] || export ORCHARD_BOOT="$route"
                export ORCHARD_DATA="${ORCHARD_DATA:-$root}" ORCHARD_PYTHON="${ORCHARD_PYTHON:-$root/.venv/bin/python}"
                status=0
                mine under_operation_lock run "$@" || status=$?
                # 10: orchard2 cannot do it (no boot route for this device yet).
                [ "$status" -eq 10 ] || exit "$status"
                echo 'orchard: orchard2 does not boot this yet; booting what it built here' >&2
                [ -z "$build" ] || set -- --no-build "$@"
            fi
            set -- run "$@"
        fi ;;
esac
case ${1:-} in
    python) shift; exec uv run --quiet --project "$root" python "$@" ;;
    *) exec uv run --quiet --project "$root" orchard "$@" ;;
esac
