#!/bin/sh
# The last version of the launcher that ran orchard's Python tool from the
# newest nightly. `orchard` is one program now, from OrchardLinux/tools; an
# installed copy of this launcher replaces itself with this text and says so.
echo 'orchard: the orchard command is a program of its own now. Install it:' >&2
echo '  curl -fsSL https://raw.githubusercontent.com/OrchardLinux/tools/main/install.sh | sh' >&2
echo 'It takes the place of this launcher. To build from a checkout, call its bin/orchard.' >&2
exit 1
