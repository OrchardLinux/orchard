#!/usr/bin/env python3
"""Put a kernel branch's series on a new base without rewriting the branch.

  tools/kernel-tree/replay --linux DIR --branch NAME --from OLD --onto NEW
  tools/kernel-tree/replay --linux DIR --branch NAME --continue

The branches of OrchardLinux/linux are never force-pushed. A move to a newer
upstream, a re-import of a layer (Cascadia, Hoolock) or a re-ordering is
added on top instead:

  1. a marker commit with NEW's content, whose first parent is NEW and whose
     second parent is the branch as it is, so everything before stays in the
     history;
  2. the commits of OLD..NAME replayed after the marker, in order, with their
     authors, dates and messages. Merges are left out, and a commit that
     changes nothing on the new base (NEW already has it) is dropped.

The result is the branch NAME-replayed in DIR. It descends from NAME, so
pushing it to NAME is a fast-forward. Everything after the newest marker is
the current series on its base.

No checkout is made: commits are merged in git's object store, so DIR can be
a bare clone on any filesystem. When a commit does not apply cleanly the tool
stops and names it. Then check NAME-replayed out on a case-sensitive volume,
`git cherry-pick` that commit there, resolve and commit it, and run
--continue for the rest. Nothing is pushed by this tool.
"""
import argparse
import os
import subprocess
import sys
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
parser.add_argument('--linux', required=True, type=Path, help='clone of OrchardLinux/linux with NAME, OLD and NEW')
parser.add_argument('--branch', required=True, metavar='NAME')
parser.add_argument('--from', dest='old', metavar='OLD', help='the last commit of the base the series is on now')
parser.add_argument('--onto', dest='new', metavar='NEW', help='the base to put the series on')
parser.add_argument('--continue', dest='resume', action='store_true', help='go on after a commit resolved by hand')
args = parser.parse_args()
if args.resume == bool(args.old or args.new) or (not args.resume and not (args.old and args.new)):
    parser.error('give --from OLD and --onto NEW, or --continue')


def git(*command, input=None, env=None, check=True):
    done = subprocess.run(['git', '-C', str(args.linux), *command], input=input, capture_output=True, text=True,
                          env={**os.environ, **(env or {})})
    if check and done.returncode:
        sys.exit(f'git {" ".join(command[:4])} failed:\n{done.stderr}')
    return done.stdout.strip() if check else done


result = f'refs/heads/{args.branch}-replayed'
state = Path(git('rev-parse', '--absolute-git-dir')) / f'orchard-replay-{args.branch.replace("/", "-")}'
if args.resume:
    if not state.is_file():
        sys.exit(f'No replay of {args.branch} is waiting in {args.linux}')
    waiting = state.read_text().split()
    tip, stopped, remaining = waiting[0], waiting[1], waiting[2:]
    head = git('rev-parse', result)
    if head == tip:
        sys.exit(f'{args.branch}-replayed has not moved: cherry-pick {stopped[:12]} onto it and commit the '
                 'resolution first')
else:
    if state.exists() or git('rev-parse', '-q', '--verify', result, check=False).returncode == 0:
        sys.exit(f'{args.branch}-replayed exists in {args.linux}: finish that replay (--continue) or delete the '
                 f'branch and {state.name}')
    tip = git('rev-parse', '--verify', args.branch + '^{commit}')
    old = git('rev-parse', '--verify', args.old + '^{commit}')
    new = git('rev-parse', '--verify', args.new + '^{commit}')
    if git('merge-base', '--is-ancestor', old, tip, check=False).returncode:
        sys.exit(f'{old[:12]} is not in {args.branch}')
    one = lambda commit: git('log', '-1', '--format=%h ("%s")', commit)
    message = (f'Start the {args.branch} series again on {new[:12]}\n\n'
               f'The series that followed {one(old)}\nis replayed after this commit, on\n{one(new)}.\n'
               f'This commit has that base\'s content. Its second parent is the branch as\nit was, {tip[:12]}, '
               'so nothing before is lost and the branch is not\nrewritten; everything after this commit is the '
               'current series.\n')
    head = git('commit-tree', new + '^{tree}', '-p', new, '-p', tip, input=message)
    git('update-ref', result, head)
    remaining = git('rev-list', '--reverse', '--topo-order', '--no-merges', f'{old}..{tip}').split()
    print(f'Marker {head[:12]}; replaying {len(remaining)} commits of {args.branch} ...', flush=True)

kept = dropped = 0
while remaining:
    commit = remaining.pop(0)
    parent = git('rev-parse', commit + '^')
    merged = git('merge-tree', '--write-tree', '--merge-base', parent, head, commit, check=False)
    if merged.returncode:
        state.write_text('\n'.join([head, commit, *remaining]) + '\n')
        files = '\n'.join('  ' + line for line in merged.stdout.splitlines()[1:] if line.strip())
        sys.exit(f'{git("log", "-1", "--format=%h %s", commit)}\ndoes not apply on the new base:\n{files}\n'
                 f'Check {args.branch}-replayed out on a case-sensitive volume, git cherry-pick {commit[:12]} '
                 f'there, resolve and commit, then run --continue ({len(remaining)} commits follow).')
    tree = merged.stdout.split()[0]
    if tree == git('rev-parse', head + '^{tree}'):
        dropped += 1  # the new base already has this change
        continue
    name, email, date = git('log', '-1', '--format=%an%n%ae%n%aD', commit).split('\n')
    head = git('commit-tree', tree, '-p', head, input=git('log', '-1', '--format=%B', commit) + '\n',
               env={'GIT_AUTHOR_NAME': name, 'GIT_AUTHOR_EMAIL': email, 'GIT_AUTHOR_DATE': date})
    git('update-ref', result, head)
    kept += 1
state.unlink(missing_ok=True)
if git('merge-base', '--is-ancestor', tip, head, check=False).returncode:
    sys.exit('The result does not descend from the branch')
print(f'{args.branch}-replayed is {head[:12]}, tree {git("rev-parse", head + "^{tree}")[:12]}: {kept} commits '
      f'replayed, {dropped} dropped as already in the new base.\n'
      f'Check it, then: git -C {args.linux} push origin {args.branch}-replayed:{args.branch}   (a fast-forward)')
