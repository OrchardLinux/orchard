From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Fri, 6 Nov 2026 20:53:31 +0800
Subject: [PATCH 21/22] ringbuffer: Copy whole chunks, not bytes

The ring buffer carries every byte of a USB bulk stream, in both directions, and
paid a division per byte. Copy contiguous runs as whole words where they line up.

Assisted-by: LLM
---
 src/ringbuffer.c | 55 ++++++++++++++++++++++++++++++++----------------
 1 file changed, 37 insertions(+), 18 deletions(-)

diff --git a/src/ringbuffer.c b/src/ringbuffer.c
index f7ecb16..88bf24b 100644
--- a/src/ringbuffer.c
+++ b/src/ringbuffer.c
@@ -1,6 +1,7 @@
 #include "ringbuffer.h"
 #include "malloc.h"
 #include "types.h"
+#include "utils.h"
 
 ringbuffer_t *ringbuffer_alloc(size_t len)
 {
@@ -28,19 +29,36 @@ void ringbuffer_free(ringbuffer_t *bfr)
     free(bfr);
 }
 
-size_t ringbuffer_read(u8 *target, size_t len, ringbuffer_t *bfr)
+/* Whole words: this carries all of a USB bulk stream, in both directions. */
+static void ringbuffer_copy(u8 *dst, const u8 *src, size_t len)
 {
-    size_t read;
+    while (((u64)dst | (u64)src) & 7 && len) {
+        *dst++ = *src++;
+        len--;
+    }
+    if (!(((u64)dst | (u64)src) & 7)) {
+        for (; len >= 64; len -= 64, dst += 64, src += 64) {
+            u64 *d = (u64 *)dst;
+            const u64 *s = (const u64 *)src;
+            d[0] = s[0], d[1] = s[1], d[2] = s[2], d[3] = s[3];
+            d[4] = s[4], d[5] = s[5], d[6] = s[6], d[7] = s[7];
+        }
+    }
+    while (len--)
+        *dst++ = *src++;
+}
 
-    for (read = 0; read < len; ++read) {
-        if (bfr->read == bfr->write)
-            break;
+size_t ringbuffer_read(u8 *target, size_t len, ringbuffer_t *bfr)
+{
+    size_t read = 0;
 
-        *target = bfr->buffer[bfr->read];
-        target++;
+    while (read < len && bfr->read != bfr->write) {
+        size_t end = bfr->write > bfr->read ? bfr->write : bfr->len;
+        size_t chunk = min(end - bfr->read, len - read);
 
-        bfr->read++;
-        bfr->read %= bfr->len;
+        ringbuffer_copy(target + read, bfr->buffer + bfr->read, chunk);
+        read += chunk;
+        bfr->read = (bfr->read + chunk) % bfr->len;
     }
 
     return read;
@@ -48,17 +66,18 @@ size_t ringbuffer_read(u8 *target, size_t len, ringbuffer_t *bfr)
 
 size_t ringbuffer_write(const u8 *src, size_t len, ringbuffer_t *bfr)
 {
-    size_t written;
+    size_t written = 0;
 
-    for (written = 0; written < len; ++written) {
-        if (((bfr->write + 1) % bfr->len) == bfr->read)
-            break;
+    while (written < len) {
+        /* One slot stays empty, so that read == write means empty. */
+        size_t end = bfr->read > bfr->write ? bfr->read - 1 : bfr->len - (bfr->read == 0);
+        size_t chunk = min(end - bfr->write, len - written);
 
-        bfr->buffer[bfr->write] = *src;
-        src++;
-
-        bfr->write++;
-        bfr->write %= bfr->len;
+        if (!chunk)
+            break;
+        ringbuffer_copy(bfr->buffer + bfr->write, src + written, chunk);
+        written += chunk;
+        bfr->write = (bfr->write + chunk) % bfr->len;
     }
 
     return written;
-- 
