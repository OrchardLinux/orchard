+
+#define WDT_CTL 0x1c
+
+/* SYSTEM_RESET/SYSTEM_OFF wait this long for the other CPUs to park */
+#define RENDEZVOUS_TIMEOUT_US 1000000
 
 struct psci_cpu {
     volatile u64 state;
@@ -39,7 +49,8 @@ struct psci_rdv {
     volatile u64 cpus;  /* MPIDR indices that have been in the pen: handed to the kernel */
     u64 aic;
