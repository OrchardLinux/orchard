@@ -464,14 +465,16 @@ void fb_init(bool clear)
                         &orig_logo);
     }
 
+    // After a re-entry from Linux the payload area behind m1n1 is stale
+    bool payload_ok = !psci_reentered();
     u32 *splash, splash_w, splash_h;
-    if (payload_splash(&splash, &splash_w, &splash_h) && splash_w <= fb.width &&
+    if (payload_ok && payload_splash(&splash, &splash_w, &splash_h) && splash_w <= fb.width &&
         splash_h <= fb.height) {
         custom_logo.ptr = splash;
         custom_logo.width = splash_w;
         custom_logo.height = splash_h;
         logo = &custom_logo;
-    } else if (payload_logo(&custom_128, &custom_256)) {
+    } else if (payload_ok && payload_logo(&custom_128, &custom_256)) {
         custom_logo = *logo;
         if (custom_logo.width == 256) {
             custom_logo.ptr = custom_256;
diff --git a/src/main.c b/src/main.c
index 3f32380..8966e41 100644
--- a/src/main.c
+++ b/src/main.c
@@ -7,6 +7,7 @@
 
 #include "adt.h"
 #include "aic.h"
+#include "bootmgr.h"
 #include "cpufreq.h"
 #include "display.h"
 #include "exception.h"
@@ -127,6 +128,9 @@ void run_actions(void)
         printf("Valid payload found\n");
         return;
     }
+
+    if (psci_reset_reentered() && bootmgr_warm_reset() == 0)
+        return;
     fb_set_active(true);
 
     printf("No valid payload found\n");
@@ -173,9 +177,11 @@ void m1n1_main(void)
     // Kick DCP to sleep, so dodgy monitors which cause reconnect cycles don't cause us to lose the
     // framebuffer.
     display_shutdown(DCP_SLEEP_IF_EXTERNAL);
-    // On idevice we need to always clear, because otherwise it looks scuffed on white devices
-    fb_init(!is_mac);
-    fb_display_logo();
+    // On idevice we need to always clear, because otherwise it looks scuffed on white devices.
+    // After a warm reset, keep the picture until the next system's splash.
+    fb_init(!is_mac && !psci_reset_reentered());
+    if (!psci_reset_reentered())
+        fb_display_logo();
 #ifdef FB_SILENT_MODE
     fb_set_active(!cur_boot_args.video.display);
 #else
@@ -184,7 +190,9 @@ void m1n1_main(void)
 #endif
 
     cpufreq_fixup();
-    sep_init();
+    // SEP was never reset; it is still running what it ran at the first boot
+    if (!psci_reset_reentered())
+        sep_init();
 #endif
 
     printf("Initialization complete.\n");
