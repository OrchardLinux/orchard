+/// One character of a glob pattern at `p[pi]` (not `*`) against `c`: the index
+/// after it if it matches. ASCII case is ignored.
+fn glob_step(p: &[u8], pi: usize, c: u8) -> Option<usize> {
+    let c = c.to_ascii_lowercase();
+    match p[pi] {
+        b'?' => Some(pi + 1),
+        b'\\' if pi + 1 < p.len() => (p[pi + 1].to_ascii_lowercase() == c).then_some(pi + 2),
+        b'[' => {
+            let mut i = pi + 1;
+            let negate = i < p.len() && (p[i] == b'!' || p[i] == b'^');
+            if negate {
+                i += 1;
+            }
+            let (mut matched, mut first) = (false, true);
+            while i < p.len() && (first || p[i] != b']') {
+                first = false;
+                let lo = p[i].to_ascii_lowercase();
+                if i + 2 < p.len() && p[i + 1] == b'-' && p[i + 2] != b']' {
+                    matched |= lo <= c && c <= p[i + 2].to_ascii_lowercase();
+                    i += 3;
+                } else {
+                    matched |= lo == c;
+                    i += 1;
+                }
+            }
+            if i >= p.len() {
+                // No closing bracket: a literal `[`.
+                return (c == b'[').then_some(pi + 1);
+            }
+            (matched != negate).then_some(i + 1)
+        }
+        other => (other.to_ascii_lowercase() == c).then_some(pi + 1),
+    }
+}
