+/// The DTB to check entries against: the file name `devicetree` if it isn't
+/// NULL, else the board m1n1 runs on.
+unsafe fn wanted<'a>(devicetree: *const c_char) -> Wanted<'a> {
+    let text = |p: *const c_char| unsafe { CStr::from_ptr(p) }.to_str().ok();
+    if !devicetree.is_null() {
+        return text(devicetree).map_or(Wanted::Any, Wanted::File);
+    }
+    let board = unsafe { bootmgr_board() };
+    match board.is_null() {
+        true => Wanted::Any,
+        false => text(board).map_or(Wanted::Any, Wanted::Board),
+    }
+}
