+/// A shell glob as systemd-boot matches its `default`: `*`, `?`, `[...]` with
+/// ranges and `!` or `^`, and `\` escapes. ASCII case is ignored.
+pub fn glob_match(pattern: &str, text: &str) -> bool {
+    let (p, t) = (pattern.as_bytes(), text.as_bytes());
+    let (mut pi, mut ti) = (0, 0);
+    let mut star: Option<(usize, usize)> = None;
+    loop {
+        if pi < p.len() && p[pi] == b'*' {
+            pi += 1;
+            star = Some((pi, ti));
+            continue;
+        }
+        if ti == t.len() {
+            if pi == p.len() {
+                return true;
+            }
+        } else if pi < p.len() {
+            if let Some(next) = glob_step(p, pi, t[ti]) {
+                pi = next;
+                ti += 1;
+                continue;
+            }
+        }
+        // Let the last `*` take one more character, if there is one.
+        match star {
+            Some((sp, st)) if st < t.len() => {
+                star = Some((sp, st + 1));
+                pi = sp;
+                ti = st + 1;
+            }
+            _ => return false,
+        }
+    }
+}
