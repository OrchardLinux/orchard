+/// The `default` pattern of loader.conf; none if there is no loader.conf.
+fn read_loader_conf<IO: ReadWriteSeek>(dir: &Dir<IO>) -> Result<Option<String>, String> {
+    let size = match dir.open_file(LOADER_CONF) {
+        Ok(mut file) => file
+            .seek(SeekFrom::End(0))
+            .map_err(|_| format!("{}: read error", LOADER_CONF))?,
+        Err(fatfs::Error::NotFound) => return Ok(None),
+        Err(err) => return Err(fs_error(LOADER_CONF, err)),
+    };
+    if size > MAX_ENTRY_FILE {
+        return Err(format!("{}: too large", LOADER_CONF));
+    }
+    let data = read_file(dir, LOADER_CONF, size as usize)?;
+    let text = String::from_utf8(data).map_err(|_| format!("{}: not UTF-8", LOADER_CONF))?;
+    Ok(loader_default(&text))
 }
 
