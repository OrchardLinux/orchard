+/// The `default` pattern of a loader.conf: one key per line, `#` comments, the
+/// last `default` wins and a pair of quotes around the value goes, as in
+/// systemd-boot. Every other key is ignored.
+pub fn loader_default(text: &str) -> Option<String> {
+    let mut pattern = None;
+    for line in text.lines() {
+        let line = line.trim_matches([' ', '\t', '\r']);
+        if line.starts_with('#') {
+            continue;
+        }
+        let (key, value) = line
+            .split_once([' ', '\t'])
+            .map_or((line, ""), |(k, v)| (k, v.trim_matches([' ', '\t'])));
+        if key == "default" {
+            let value = value
+                .strip_prefix('"')
+                .and_then(|v| v.strip_suffix('"'))
+                .unwrap_or(value);
+            pattern = (!value.is_empty()).then(|| value.to_string());
+        }
+    }
+    pattern
+}
+
+/// The default entry, as systemd-boot picks it without EFI variables: the
+/// first entry in BLS order whose id, with or without `.conf`, matches the
+/// pattern, bootable or not; without a pattern or a match, the first bootable
+/// entry.
+pub fn default_entry(entries: &[Entry], pattern: Option<&str>) -> Option<usize> {
+    pattern
+        .and_then(|p| {
+            entries
+                .iter()
+                .position(|e| glob_match(p, &e.id) || glob_match(p, &format!("{}.conf", e.id)))
+        })
+        .or_else(|| entries.iter().position(Entry::bootable))
 }
 
