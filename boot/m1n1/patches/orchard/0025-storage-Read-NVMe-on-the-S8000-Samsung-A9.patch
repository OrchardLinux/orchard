From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rick <ricktav@gmail.com>
Date: Sun, 22 Nov 2026 22:20:04 +0100
Subject: [PATCH] storage: Read NVMe on the S8000 (Samsung A9)

The S8000 has the S8003's root complex without its phy-ip window, and
iOS's AppleS8000PCIe runs AppleS8003PCIe's sequence without the phy-ip
lane init: the lane setup comes with the apcie-phy-tunables. Take the
S8003 path with the n66 live ADT's phy and root port tunables, skip
the lane wait and phy-ip programming, and don't require the phy-ip reg.

The common and port tunables, the S3E L1SS value and the NVMMU/DART
setup are the S8003's. Linux reads the n66's storage with the same
sequence.

The phy and root port tunables come from one n66 live ADT; other S8000
boards may need their own (PHY tunables can be board-specific).

Assisted-by: LLM
---
 src/apcie_nvme.c | 77 +++++++++++++++++++++++++++++++++++++++++++-----
 src/utils.c      |  3 +-
 2 files changed, 72 insertions(+), 8 deletions(-)

diff --git a/src/apcie_nvme.c b/src/apcie_nvme.c
index 6a06676..a27e891 100644
--- a/src/apcie_nvme.c
+++ b/src/apcie_nvme.c
@@ -1,6 +1,6 @@
 /* SPDX-License-Identifier: MIT */
 /*
- * Read-only NVMe for A9 (S8003) and A10 (T8010), where ANS is an NVMe
+ * Read-only NVMe for A9 (S8000, S8003) and A10 (T8010), where ANS is an NVMe
  * endpoint behind the apcie (H8P/H9P) PCIe root complex instead of an
  * ASC-attached controller.
  *
@@ -249,6 +249,47 @@ static const struct apcie_tunable s8003_port_tunables[] = {
     {0x013c, 0x00000003, 0x00000002}, {0x0140, 0x0073ffff, 0x00704c4b},
 };
 
+/*
+ * S8000 (A9, Samsung): the S8003's root complex without phy-ip. Its PHY lane
+ * setup comes with these apcie-phy-tunables (n66 live ADT), and its
+ * pcie-rc-tunables set 0x154; the common and port tunables are the S8003's.
+ */
+static const struct apcie_tunable s8000_phy_tunables[] = {
+    {0x1a18, 0x0000000f, 0x0000000b}, {0x1a58, 0x000000ff, 0x00000099},
+    {0x0108, 0xffffffff, 0x0000212a}, {0x0118, 0x00001800, 0x00001800},
+    {0x011c, 0x00001800, 0x00001800}, {0x0308, 0xffffffff, 0x0000212a},
+    {0x0318, 0x00001800, 0x00001800}, {0x031c, 0x00001800, 0x00001800},
+    {0x0518, 0x00001800, 0x00001800}, {0x051c, 0x00001800, 0x00001800},
+    {0x0718, 0x00001800, 0x00001800}, {0x071c, 0x00001800, 0x00001800},
+    {0x0918, 0x00001800, 0x00001800}, {0x091c, 0x00001800, 0x00001800},
+    {0x0a24, 0x000000fc, 0x000000a0}, {0x0a34, 0x0000f000, 0x00005000},
+    {0x0a40, 0x00007eff, 0x00000018}, {0x0a44, 0x000000c0, 0x00000040},
+    {0x0c24, 0x000000fc, 0x000000a0}, {0x0c34, 0x0000f000, 0x00005000},
+    {0x0c40, 0x00007eff, 0x00000018}, {0x0c44, 0x000000c0, 0x00000040},
+    {0x0e24, 0x000000fc, 0x000000a0}, {0x0e34, 0x0000f000, 0x00005000},
+    {0x0e40, 0x00007eff, 0x00000018}, {0x0e44, 0x000000c0, 0x00000040},
+    {0x1024, 0x000000fc, 0x000000a0}, {0x1034, 0x0000f000, 0x00005000},
+    {0x1040, 0x00007eff, 0x00000018}, {0x1044, 0x000000c0, 0x00000040},
+    {0x1224, 0x000000fc, 0x000000a0}, {0x1234, 0x0000f000, 0x00005000},
+    {0x1240, 0x00007eff, 0x00000018}, {0x1244, 0x000000c0, 0x00000040},
+    {0x0b4c, 0xffffffff, 0x00000520}, {0x0b50, 0x000001ef, 0x000000e7},
+    {0x0d4c, 0xffffffff, 0x00000520}, {0x0d50, 0x000001ef, 0x000000e7},
+    {0x0f50, 0x000001ef, 0x000000e7}, {0x1150, 0x000001ef, 0x000000e7},
+    {0x1350, 0x000001ef, 0x000000e7},
+};
+
+static const struct apcie_tunable s8000_config_tunables[] = {
+    {0x0098, 0x0000000f, 0x00000000},
+    {0x0154, 0x00f8ff00, 0x00001900},
+};
+
+struct apcie_tunables {
+    const struct apcie_tunable *regs;
+    size_t count;
+};
+
+#define TUNABLES(t) {(t), ARRAY_SIZE(t)}
+
 struct apcie_soc {
     const char *compatible;
     int (*setup_common)(void);
@@ -258,6 +299,9 @@ struct apcie_soc {
     bool nvmmu_inv_fifo;
     u32 gpio_mask;  /* GPIO function and output mode, as Linux/iOS set it */
     u32 gpio_value;
+    /* S8000/S8003: phy-ip window with the driver's lane init, and tunables */
+    bool has_phy_ip;
+    struct apcie_tunables phy_tunables, config_tunables;
 };
 
 struct nvme_sqe {
@@ -429,7 +473,7 @@ static int read_adt(void)
         get_reg(APCIE_PATH, APCIE_REG_NVMMU, &nvmmu_base, NULL) < 0 ||
         get_reg(APCIE_PATH, APCIE_REG_RC, &rc_base, NULL) < 0 ||
         get_reg(APCIE_PATH, APCIE_REG_PHY, &phy_base, NULL) < 0 ||
-        get_reg(APCIE_PATH, APCIE_REG_PHY_IP, &phy_ip_base, NULL) < 0 ||
+        (soc->has_phy_ip && get_reg(APCIE_PATH, APCIE_REG_PHY_IP, &phy_ip_base, NULL) < 0) ||
         get_reg(DART_PATH, 0, &dart_base, NULL) < 0 || get_reg(GPIO_PATH, 0, &gpio_base, NULL) < 0 ||
         get_gpio("function-perst", &perst_pin) < 0 ||
         (soc->setup_link == t8010_setup_link && get_gpio("function-clkreq", &clkreq_pin) < 0)) {
@@ -567,7 +611,7 @@ static int s8003_setup_common(void)
                "common init"))
         return -1;
     write32(rc_base + S8003_RC_COMMON_DONE, 1);
-    apply_tunables(phy_base, s8003_phy_tunables, ARRAY_SIZE(s8003_phy_tunables));
+    apply_tunables(phy_base, soc->phy_tunables.regs, soc->phy_tunables.count);
     apply_tunables(rc_base, s8003_rc_common_tunables, ARRAY_SIZE(s8003_rc_common_tunables));
     return 0;
 }
@@ -675,7 +719,7 @@ static int s8003_start_link(void)
         speed--;
     clear32(root + cap + 0x10, 0x3 | 0x10 | 0x20); /* LNKCTL: ASPM, LD, RL */
     mask32(root + cap + 0x30, 0xf | 0x10, speed);  /* LNKCTL2: TLS, ENTER_COMP */
-    apply_tunables(root, s8003_config_tunables, ARRAY_SIZE(s8003_config_tunables));
+    apply_tunables(root, soc->config_tunables.regs, soc->config_tunables.count);
     apply_tunables(port_base, s8003_port_tunables, ARRAY_SIZE(s8003_port_tunables));
     write32(port_base + PORT_IRQMASK, PORT_IRQMASK_PRE_LINK);
     write32(port_base + PORT_IRQSTAT, PORT_IRQSTAT_PRE_LINK);
@@ -684,9 +728,13 @@ static int s8003_start_link(void)
     write32(port_base + PORT_MSIVECBASE, 0);
     mdelay(100); /* PERST# hold with a stable reference clock */
     gpio_output(perst_pin, 1);
-    if (wait32(phy_base + PHY_PORTMASK, S8003_PORT0_LANES, S8003_PORT0_LANES, 250000, "PHY lanes"))
-        return -1;
-    s8003_program_phy_lanes();
+    /* AppleS8003PCIe's lane init; iOS has none for the S8000 */
+    if (soc->has_phy_ip) {
+        if (wait32(phy_base + PHY_PORTMASK, S8003_PORT0_LANES, S8003_PORT0_LANES, 250000,
+                   "PHY lanes"))
+            return -1;
+        s8003_program_phy_lanes();
+    }
     write32(port_base + PORT_IRQMASK, PORT_IRQMASK_LINK_UP);
     set32(port_base + PORT_LTSSMCTL, BIT(0));
 
@@ -751,6 +799,21 @@ static const struct apcie_soc apcie_socs[] = {
         /* iOS's S8000 GPIO function: mask 0x27e, value 0x202, plus data */
         .gpio_mask = 0x27f,
         .gpio_value = 0x202,
+        .has_phy_ip = true,
+        .phy_tunables = TUNABLES(s8003_phy_tunables),
+        .config_tunables = TUNABLES(s8003_config_tunables),
+    },
+    {
+        .compatible = "apcie,s8000",
+        .setup_common = s8003_setup_common,
+        .setup_link = s8003_setup_link,
+        .l1ss_ctl1 = 0x40440000, /* n66 pci-l1pm-control without its enable bits */
+        .nvmmu_init_busy = NVMMU_TCB_CTRL_INIT,
+        .nvmmu_inv_fifo = true,
+        .gpio_mask = 0x27f,
+        .gpio_value = 0x202,
+        .phy_tunables = TUNABLES(s8000_phy_tunables),
+        .config_tunables = TUNABLES(s8000_config_tunables),
     },
 };
 
diff --git a/src/utils.c b/src/utils.c
index 96e0116..ffb2fa6 100644
--- a/src/utils.c
+++ b/src/utils.c
@@ -327,7 +327,8 @@ static bool main_storage_start(void)
         /* A9/A9X/A10/A10X: ANS is an NVMe endpoint behind apcie */
         int apcie_node = adt_path_offset(adt, "/arm-io/apcie");
         if (apcie_node >= 0 && (adt_is_compatible(adt, apcie_node, "apcie,t8010") ||
-                                adt_is_compatible(adt, apcie_node, "apcie,s8003"))) {
+                                adt_is_compatible(adt, apcie_node, "apcie,s8003") ||
+                                adt_is_compatible(adt, apcie_node, "apcie,s8000"))) {
             storage_type = STORAGE_TYPE_APCIE;
             return apcie_nvme_init();
         }
