From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Mon, 23 Nov 2026 04:13:50 +0800
Subject: [PATCH] usb: Stop waiting for a host that has quit

After the boot request m1n1 flushes its reply and only then starts the
kernel. The flush waited until the host had read everything, so a host
that sent the request and quit left the device on the boot splash: it
reads nothing, and it need not close the port first (orchard's raw USB
client does not).

A flush now gives up once the port is closed or nothing has moved for a
second. Unsent data stays queued and goes out if a host reads again, so
a slow reader loses nothing. Queueing into a full buffer also stops once
the host closes the port, instead of waiting for reads that cannot come.

Assisted-by: LLM
---
 src/usb_dwc2.c | 24 +++++++++++++++++++++++-
 src/usb_dwc3.c | 24 +++++++++++++++++++++++-
 2 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/src/usb_dwc2.c b/src/usb_dwc2.c
index 56117ed..c5511bf 100644
--- a/src/usb_dwc2.c
+++ b/src/usb_dwc2.c
@@ -30,6 +30,8 @@
 
 #define MAX_ENDPOINTS   8
 #define CDC_BUFFER_SIZE SZ_1M
+/* How long a flush waits for a host that reads nothing. */
+#define FLUSH_STALL_US 1000000
 
 #define usb_debug_printf(fmt, ...) // uart_printf("usb-dwc2: " fmt, ##__VA_ARGS__)
 // many printf commented due to strict timing requirements
@@ -1641,6 +1643,9 @@ size_t usb_dwc2_queue(dwc2_dev_t *dev, cdc_acm_pipe_id_t pipe, const void *buf,
         if (count) {
             usb_dwc2_handle_events(dev);
             usb_dwc2_cdc_start_bulk_in_xfer(dev, ep);
+            /* The host closed the port while the buffer was full: drop the rest. */
+            if (!dev->pipe[pipe].ready)
+                break;
         }
     }
 
@@ -1721,7 +1726,24 @@ void usb_dwc2_flush(dwc2_dev_t *dev, cdc_acm_pipe_id_t pipe)
 
     u8 ep = dev->pipe[pipe].ep_in;
 
-    while (ringbuffer_get_used(device2host) != 0 || dev->endpoints[ep].xfer_in_progress) {
+    /*
+     * Wait while the host reads. A host that has quit (after sending a boot request, say)
+     * reads nothing and may not close the port, so give up once nothing has moved for
+     * FLUSH_STALL_US. Unsent data stays queued and goes out if a host reads again.
+     */
+    size_t used = ringbuffer_get_used(device2host);
+    bool busy = dev->endpoints[ep].xfer_in_progress;
+    u64 deadline = timeout_calculate(FLUSH_STALL_US);
+    while (dev->pipe[pipe].ready && (used != 0 || busy)) {
         usb_dwc2_handle_events(dev);
+        size_t now_used = ringbuffer_get_used(device2host);
+        bool now_busy = dev->endpoints[ep].xfer_in_progress;
+        if (now_used != used || now_busy != busy) {
+            used = now_used;
+            busy = now_busy;
+            deadline = timeout_calculate(FLUSH_STALL_US);
+        } else if (timeout_expired(deadline)) {
+            break;
+        }
     }
 }
diff --git a/src/usb_dwc3.c b/src/usb_dwc3.c
index 14db08f..a03a62e 100644
--- a/src/usb_dwc3.c
+++ b/src/usb_dwc3.c
@@ -23,6 +23,8 @@
 
 #define MAX_ENDPOINTS   16
 #define CDC_BUFFER_SIZE SZ_1M
+/* How long a flush waits for a host that reads nothing. */
+#define FLUSH_STALL_US 1000000
 
 #define usb_debug_printf(fmt, ...) debug_printf("usb-dwc3@%lx: " fmt, dev->regs, ##__VA_ARGS__)
 
@@ -1366,6 +1368,9 @@ size_t usb_dwc3_queue(dwc3_dev_t *dev, cdc_acm_pipe_id_t pipe, const void *buf,
         if (count) {
             usb_dwc3_handle_events(dev);
             usb_dwc3_cdc_start_bulk_in_xfer(dev, ep);
+            /* The host closed the port while the buffer was full: drop the rest. */
+            if (!dev->pipe[pipe].ready)
+                break;
         }
     }
 
@@ -1443,7 +1448,24 @@ void usb_dwc3_flush(dwc3_dev_t *dev, cdc_acm_pipe_id_t pipe)
 
     u8 ep = dev->pipe[pipe].ep_in;
 
-    while (ringbuffer_get_used(device2host) != 0 || dev->endpoints[ep].xfer_in_progress) {
+    /*
+     * Wait while the host reads. A host that has quit (after sending a boot request, say)
+     * reads nothing and may not close the port, so give up once nothing has moved for
+     * FLUSH_STALL_US. Unsent data stays queued and goes out if a host reads again.
+     */
+    size_t used = ringbuffer_get_used(device2host);
+    bool busy = dev->endpoints[ep].xfer_in_progress;
+    u64 deadline = timeout_calculate(FLUSH_STALL_US);
+    while (dev->pipe[pipe].ready && (used != 0 || busy)) {
         usb_dwc3_handle_events(dev);
+        size_t now_used = ringbuffer_get_used(device2host);
+        bool now_busy = dev->endpoints[ep].xfer_in_progress;
+        if (now_used != used || now_busy != busy) {
+            used = now_used;
+            busy = now_busy;
+            deadline = timeout_calculate(FLUSH_STALL_US);
+        } else if (timeout_expired(deadline)) {
+            break;
+        }
     }
 }
