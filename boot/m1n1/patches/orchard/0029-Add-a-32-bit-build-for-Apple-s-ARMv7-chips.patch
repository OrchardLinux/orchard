diff --git a/src/arm32/a32_cache_asm.S b/src/arm32/a32_cache_asm.S
new file mode 100644
index 0000000..6e8e8d9
--- /dev/null
+++ b/src/arm32/a32_cache_asm.S
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: MIT */
+
+/* Whole-cache operations by set and way, and turning the MMU off. */
+
+.syntax unified
+.arm
+.text
+
+/*
+ * Walk every data or unified cache level and apply one set/way operation
+ * (CRm of "mcr p15, 0, rX, c7, <CRm>, 2": c6 invalidates, c14 cleans and
+ * invalidates). Uses registers only, so it also runs with the cache off
+ * and dirty lines still in it. Clobbers r0-r5, r7, r9-r11.
+ */
+.macro dcache_all crm
+    mrc     p15, 1, r0, c0, c0, 1       @ CLIDR
+    ands    r3, r0, #0x7000000
+    mov     r3, r3, lsr #23             @ levels of cache * 2
+    beq     5f
+    mov     r10, #0
+1:  add     r2, r10, r10, lsr #1
+    mov     r1, r0, lsr r2
+    and     r1, r1, #7
+    cmp     r1, #2
+    blt     4f                          @ no data cache at this level
+    mcr     p15, 2, r10, c0, c0, 0      @ CSSELR
+    isb
+    mrc     p15, 1, r1, c0, c0, 0       @ CCSIDR
+    and     r2, r1, #7
+    add     r2, r2, #4                  @ log2(line length)
+    movw    r4, #0x3ff
+    ands    r4, r4, r1, lsr #3          @ highest way
+    clz     r5, r4
+    movw    r7, #0x7fff
+    ands    r7, r7, r1, lsr #13         @ highest set
+2:  mov     r9, r4
+3:  orr     r11, r10, r9, lsl r5
+    orr     r11, r11, r7, lsl r2
+    mcr     p15, 0, r11, c7, \crm, 2
+    subs    r9, r9, #1
+    bge     3b
+    subs    r7, r7, #1
+    bge     2b
+4:  add     r10, r10, #2
+    cmp     r3, r10
+    bgt     1b
+5:  mov     r10, #0
+    mcr     p15, 2, r10, c0, c0, 0
+    dsb
+    isb
+.endm
+
+/* void dcache_invalidate_all(void): drop everything, for a cache that is off */
+.globl dcache_invalidate_all
+.type dcache_invalidate_all, %function
+dcache_invalidate_all:
+    push    {r4-r11, lr}
+    dcache_all c6
+    pop     {r4-r11, pc}
+
+/*
+ * void mmu_off(void): data cache off, written back and emptied, then MMU and
+ * instruction cache off. Between turning the cache off and finishing the
+ * write-back nothing may read memory, the stack included.
+ */
+.globl mmu_off
+.type mmu_off, %function
+mmu_off:
+    push    {r4-r11, lr}
+    mrc     p15, 0, r0, c1, c0, 0
+    bic     r0, r0, #(1 << 2)           @ C
+    mcr     p15, 0, r0, c1, c0, 0
+    isb
+    dcache_all c14
+    mrc     p15, 0, r0, c1, c0, 0
+    bic     r0, r0, #(1 << 0)           @ M
+    bic     r0, r0, #(1 << 12)          @ I
+    mcr     p15, 0, r0, c1, c0, 0
+    isb
+    mov     r0, #0
+    mcr     p15, 0, r0, c8, c7, 0       @ TLBIALL
+    mcr     p15, 0, r0, c7, c5, 0       @ ICIALLU
+    mcr     p15, 0, r0, c7, c5, 6       @ BPIALL
+    dsb
+    isb
+    pop     {r4-r11, pc}
diff --git a/src/arm32/a32_cpu.c b/src/arm32/a32_cpu.c
new file mode 100644
index 0000000..96b7148
--- /dev/null
+++ b/src/arm32/a32_cpu.c
@@ -0,0 +1,198 @@
+/* SPDX-License-Identifier: MIT */
+
+/*
+ * What the shared code expects of the processor on a chip where m1n1 only
+ * ever runs on the boot core: Linux starts the second core itself.
+ */
+
+#include "../adt.h"
+#include "../exception.h"
+#include "../smp.h"
+#include "../utils.h"
+
+int boot_cpu_idx = 0;
+u64 boot_cpu_mpidr = 0;
+
+u8 *secondary_stacks[MAX_CPUS];
+
+void smp_secondary_entry(void)
+{
+}
+
+void smp_start_secondaries(void)
+{
+    boot_cpu_mpidr = cp15_read(CP15_MPIDR);
+}
+
+void smp_stop_secondaries(bool deep_sleep)
+{
+    UNUSED(deep_sleep);
+}
+
+void smp_call4(int cpu, void *func, u64 arg0, u64 arg1, u64 arg2, u64 arg3)
+{
+    UNUSED(func);
+    UNUSED(arg0);
+    UNUSED(arg1);
+    UNUSED(arg2);
+    UNUSED(arg3);
+    printf("SMP: no CPU %d to call here\n", cpu);
+}
+
+u64 smp_wait(int cpu)
+{
+    UNUSED(cpu);
+    return 0;
+}
+
+bool smp_is_alive(int cpu)
+{
+    return cpu == boot_cpu_idx;
+}
+
+uint64_t smp_get_mpidr(int cpu)
+{
+    return cpu == boot_cpu_idx ? cp15_read(CP15_MPIDR) : 0;
+}
+
+u64 smp_get_release_addr(int cpu)
+{
+    UNUSED(cpu);
+    return 0;
+}
+
+void smp_set_wfe_mode(bool new_mode)
+{
+    UNUSED(new_mode);
+}
+
+void smp_send_ipi(int cpu)
+{
+    UNUSED(cpu);
+}
+
+/* One core, interrupts masked: a lock only has to count */
+void spin_init(spinlock_t *lock)
+{
+    lock->lock = -1;
+    lock->count = 0;
+}
+
+void spin_lock(spinlock_t *lock)
+{
+    lock->lock = 0;
+    lock->count++;
+}
+
+void spin_unlock(spinlock_t *lock)
+{
+    if (lock->count > 0 && !--lock->count)
+        lock->lock = -1;
+}
+
+void cpu_sleep(bool deep)
+{
+    UNUSED(deep);
+    while (1)
+        sysop("wfi");
+}
+
+void deep_wfi(void)
+{
+    sysop("wfi");
+}
+
+bool supports_arch_retention(void)
+{
+    return false;
+}
+
+bool supports_gxf(void)
+{
+    return false;
+}
+
+bool supports_pan(void)
+{
+    return false;
+}
+
+/* The 64-bit proxy calls into other exception levels; there are none here */
+uint64_t el0_call(void *func, uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+    UNUSED(func);
+    UNUSED(a);
+    UNUSED(b);
+    UNUSED(c);
+    UNUSED(d);
+    return -1;
+}
+
+uint64_t el1_call(void *func, uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+    return el0_call(func, a, b, c, d);
+}
+
+uint64_t el3_call(void *func, uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+    return el0_call(func, a, b, c, d);
+}
+
+/* Tuning the 64-bit chips want before Linux; nothing to do here */
+int cpufreq_init(void)
+{
+    return 0;
+}
+
+void mitigations_perform(void)
+{
+}
+
+void mitigations_configure(const char *config)
+{
+    UNUSED(config);
+}
+
+int display_configure(const char *config)
+{
+    UNUSED(config);
+    return 0;
+}
+
+/*
+ * The outer cache (PL310) of the Cortex-A9 chips. iBoot leaves it off and
+ * m1n1 never turns it on; should a boot stage have left it on, it is
+ * written back and turned off, which is the state Linux expects.
+ */
+#define L2X0_CTRL          0x100
+#define L2X0_CACHE_SYNC    0x730
+#define L2X0_CLEAN_INV_WAY 0x7fc
+
+void l2cache_shutdown(void)
+{
+    int path[8];
+    u64 base;
+
+    if (adt_path_offset_trace(adt, "/arm-io/pl310", path) < 0)
+        return;
+    if (adt_get_reg(adt, path, "reg", 0, &base, NULL))
+        return;
+    if (!(read32(base + L2X0_CTRL) & 1))
+        return;
+
+    write32(base + L2X0_CLEAN_INV_WAY, 0xffff);
+    while (read32(base + L2X0_CLEAN_INV_WAY) & 0xffff)
+        ;
+    write32(base + L2X0_CACHE_SYNC, 0);
+    write32(base + L2X0_CTRL, 0);
+}
+
+/* Starting another m1n1 from storage is the 64-bit chips' two-stage boot */
+int chainload_load(const char *spec, char **chosen, size_t chosen_cnt)
+{
+    UNUSED(spec);
+    UNUSED(chosen);
+    UNUSED(chosen_cnt);
+    printf("chainload: not available on this chip\n");
+    return -1;
+}
diff --git a/src/arm32/a32_exception.c b/src/arm32/a32_exception.c
new file mode 100644
index 0000000..7ce5b29
--- /dev/null
+++ b/src/arm32/a32_exception.c
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "../exception.h"
+#include "../iodev.h"
+#include "../uart.h"
+#include "../utils.h"
+
+extern char _vectors_start[0];
+extern char _exc_stack_bot[0];
+
+void exc_set_stacks(void *stack_bottom);
+void exc_handler(u32 type, struct exc_info *ctx);
+
+volatile enum exc_guard_t exc_guard = GUARD_OFF;
+volatile int exc_count = 0;
+
+enum {
+    EXC_RESET = 0,
+    EXC_UNDEF = 1,
+    EXC_SVC = 2,
+    EXC_PABT = 3,
+    EXC_DABT = 4,
+    EXC_IRQ = 6,
+    EXC_FIQ = 7,
+};
+
+static const char *const exc_names[8] = {
+    "reset",          "undefined instruction", "supervisor call", "prefetch abort",
+    "data abort",     "?",                     "IRQ",             "FIQ",
+};
+
+static const char *const mode_names[32] = {
+    [0x10] = "user", [0x11] = "FIQ",        [0x12] = "IRQ",    [0x13] = "supervisor",
+    [0x17] = "abort", [0x1b] = "undefined", [0x1f] = "system",
+};
+
+void exception_initialize(void)
+{
+    exc_set_stacks(_exc_stack_bot);
+    /* Vectors at VBAR, not at the high or low fixed address */
+    cp15_write(CP15_SCTLR, cp15_read(CP15_SCTLR) & ~SCTLR_V);
+    cp15_write(CP15_VBAR, (u32)_vectors_start);
+    sysop("isb");
+}
+
+void exception_shutdown(void)
+{
+}
+
+static void print_exception(u32 type, struct exc_info *ctx, u32 fsr, u32 far)
+{
+    const char *mode = mode_names[ctx->spsr & 0x1f];
+    u32 *r = ctx->regs;
+
+    printf("Exception: %s\n", exc_names[type & 7]);
+    printf("Exception taken from %s mode\n", mode ? mode : "?");
+    printf("MPIDR: 0x%x\n", cp15_read(CP15_MPIDR));
+    printf("Registers: (@%p)\n", ctx);
+    printf("  r0-r3: %08x %08x %08x %08x\n", r[0], r[1], r[2], r[3]);
+    printf("  r4-r7: %08x %08x %08x %08x\n", r[4], r[5], r[6], r[7]);
+    printf(" r8-r11: %08x %08x %08x %08x\n", r[8], r[9], r[10], r[11]);
+    printf("    r12: %08x\n", r[12]);
+    printf("PC:       0x%x (rel: 0x%x)\n", ctx->pc, ctx->pc - (u32)_base);
+    printf("LR:       0x%x (rel: 0x%x)\n", ctx->lr, ctx->lr - (u32)_base);
+    printf("SP:       0x%x\n", ctx->sp);
+    printf("SPSR:     0x%x\n", ctx->spsr);
+    if (type == EXC_DABT || type == EXC_PABT) {
+        printf("FAR:      0x%x\n", far);
+        printf("FSR:      0x%x\n", fsr);
+    }
+}
+
+void exc_handler(u32 type, struct exc_info *ctx)
+{
+    u32 fsr = 0, far = 0;
+
+    if (type == EXC_DABT) {
+        fsr = cp15_read(CP15_DFSR);
+        far = cp15_read(CP15_DFAR);
+    } else if (type == EXC_PABT) {
+        fsr = cp15_read(CP15_IFSR);
+        far = cp15_read(CP15_IFAR);
+    }
+
+    if (!(exc_guard & GUARD_SILENT))
+        print_exception(type, ctx, fsr, far);
+
+    switch (exc_guard & GUARD_TYPE_MASK) {
+        case GUARD_SKIP:
+            ctx->pc += 4;
+            break;
+        case GUARD_MARK: {
+            /* A load that faulted returns a recognisable value in its Rt */
+            u32 insn = type == EXC_DABT ? read32(ctx->pc) : 0;
+            u32 rt = (insn >> 12) & 0xf;
+
+            if (type == EXC_DABT && rt < 13)
+                ctx->regs[rt] = 0xabad1dea;
+            ctx->pc += 4;
+            break;
+        }
+        case GUARD_RETURN:
+            /* Leave the function that faulted: a 64-bit result is r1:r0 */
+            ctx->regs[0] = 0xabad1dea;
+            ctx->regs[1] = 0xacce5515;
+            ctx->pc = ctx->lr;
+            exc_guard = GUARD_OFF;
+            break;
+        case GUARD_OFF:
+        default:
+            printf("Unhandled exception, rebooting...\n");
+            flush_and_reboot();
+    }
+
+    exc_count++;
+
+    if (!(exc_guard & GUARD_SILENT))
+        printf("Recovering from exception (PC=0x%x)\n", ctx->pc);
+}
diff --git a/src/arm32/a32_exception_asm.S b/src/arm32/a32_exception_asm.S
new file mode 100644
index 0000000..1bd839b
--- /dev/null
+++ b/src/arm32/a32_exception_asm.S
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: MIT */
+
+/*
+ * ARMv7 exception vectors. m1n1 runs in SVC mode with interrupts masked, so
+ * what arrives here is a fault of its own or of something the proxy was
+ * asked to poke. Every exception mode shares one stack (they do not nest
+ * usefully) and hands C a frame laid out as struct exc_info begins.
+ */
+
+.syntax unified
+.arm
+.text
+
+.align 5
+.globl _vectors_start
+_vectors_start:
+    b       v_reset
+    b       v_undef
+    b       v_svc
+    b       v_pabt
+    b       v_dabt
+    b       v_reset
+    b       v_irq
+    b       v_fiq
+
+.macro vector name, type, back
+\name:
+    sub     lr, lr, #\back      @ the instruction that faulted
+    push    {r0-r12, lr}
+    mov     r0, #\type
+    b       exc_common
+.endm
+
+vector v_reset, 0, 0
+vector v_undef, 1, 4
+vector v_svc,   2, 4
+vector v_pabt,  3, 4
+vector v_dabt,  4, 8
+vector v_irq,   6, 4
+vector v_fiq,   7, 4
+
+exc_common:
+    mrs     r1, spsr
+    push    {r1}
+    /* sp and lr of the code that was interrupted (SVC mode) */
+    mrs     r2, cpsr
+    cps     #0x13
+    mov     r3, sp
+    mov     r4, lr
+    msr     cpsr_c, r2
+    push    {r3, r4}
+
+    /* 17 words so far: one more keeps the stack 8-byte aligned for C */
+    mov     r1, sp
+    sub     sp, sp, #4
+    bl      exc_handler
+    add     sp, sp, #4
+
+    pop     {r3, r4}
+    pop     {r1}
+    msr     spsr_cxsf, r1
+    ldm     sp!, {r0-r12, pc}^
+
+/* void exc_set_stacks(void *stack_bottom): the one stack of all exception modes */
+.globl exc_set_stacks
+.type exc_set_stacks, %function
+exc_set_stacks:
+    mrs     r1, cpsr
+    cps     #0x17               @ abort
+    mov     sp, r0
+    cps     #0x1b               @ undefined
+    mov     sp, r0
+    cps     #0x12               @ IRQ
+    mov     sp, r0
+    cps     #0x11               @ FIQ
+    mov     sp, r0
+    msr     cpsr_c, r1
+    bx      lr
diff --git a/src/arm32/a32_kboot.c b/src/arm32/a32_kboot.c
new file mode 100644
index 0000000..ee3bea8
--- /dev/null
+++ b/src/arm32/a32_kboot.c
@@ -0,0 +1,437 @@
+/* SPDX-License-Identifier: MIT */
+
+/*
+ * Starting a 32-bit Linux: fill the board's device tree with what only the
+ * unit knows (memory, framebuffer, serial number, addresses), put initrd and
+ * tree where the kernel's decompressor leaves them alone, and enter the
+ * zImage with r0 = 0, r1 = ~0, r2 = device tree, MMU and caches off.
+ */
+
+#include "../kboot.h"
+#include "../adt.h"
+#include "assert.h"
+#include "../firmware.h"
+#include "../heapblock.h"
+#include "malloc.h"
+#include "../utils.h"
+#include "../xnuboot.h"
+
+#include "../libfdt/libfdt.h"
+
+#define MAX_CHOSEN_PARAMS 16
+
+/*
+ * The decompressor finds the start of RAM by rounding its own address down
+ * to 128 MiB and unpacks the kernel there, so the zImage has to sit in the
+ * first 128 MiB and everything else at or above them.
+ */
+#define KERNEL_WINDOW (128U << 20)
+
+#define ZIMAGE_MAGIC 0x016f2818
+
+#define DT_ALIGN 4096
+#define DT_SLACK (64 * 1024)
+
+static void *dt = NULL;
+static int dt_bufsize = 0;
+static void *initrd_start = NULL;
+static size_t initrd_size = 0;
+static char *chosen_params[MAX_CHOSEN_PARAMS][2];
+
+extern const char *const m1n1_version;
+
+#define bail(...)                                                                                  \
+    do {                                                                                           \
+        printf(__VA_ARGS__);                                                                       \
+        return -1;                                                                                 \
+    } while (0)
+
+/* reg = <base size> in the cell widths of the tree's root */
+static int dt_set_reg(int node, u64 base, u64 size)
+{
+    fdt32_t cells[4];
+    int n = 0;
+    int ac = fdt_address_cells(dt, 0);
+    int sc = fdt_size_cells(dt, 0);
+
+    if (ac < 1 || ac > 2 || sc < 1 || sc > 2)
+        bail("FDT: unsupported root cell sizes %d/%d\n", ac, sc);
+
+    if (ac == 2)
+        cells[n++] = cpu_to_fdt32(base >> 32);
+    cells[n++] = cpu_to_fdt32(base);
+    if (sc == 2)
+        cells[n++] = cpu_to_fdt32(size >> 32);
+    cells[n++] = cpu_to_fdt32(size);
+
+    return fdt_setprop(dt, node, "reg", cells, n * sizeof(fdt32_t));
+}
+
+static int dt_set_cell(int node, const char *name, u64 value)
+{
+    if (fdt_address_cells(dt, 0) == 2)
+        return fdt_setprop_u64(dt, node, name, value);
+    return fdt_setprop_u32(dt, node, name, value);
+}
+
+static int dt_rename(int node, const char *base, u64 addr)
+{
+    char name[48];
+
+    snprintf(name, sizeof(name), "%s@%lx", base, addr);
+    return fdt_set_name(dt, node, name);
+}
+
+/* The simple-framebuffer over the picture iBoot left running, and its reservation */
+static int dt_set_fb(void)
+{
+    if (!cur_boot_args.video.base) {
+        printf("FDT: Framebuffer unavailable, skipping framebuffer initialization\n");
+        return 0;
+    }
+
+    int fb = fdt_node_offset_by_compatible(dt, -1, "simple-framebuffer");
+    if (fb < 0) {
+        printf("FDT: No framebuffer found\n");
+        return 0;
+    }
+
+    u64 fb_base = cur_boot_args.video.base;
+    u64 fb_size = ALIGN_UP(cur_boot_args.video.stride * cur_boot_args.video.height, SZ_4K);
+
+    /* The reserved range first: renaming nodes moves the ones after them */
+    const fdt32_t *region = fdt_getprop(dt, fb, "memory-region", NULL);
+    if (region) {
+        int rnode = fdt_node_offset_by_phandle(dt, fdt32_to_cpu(*region));
+
+        if (rnode >= 0) {
+            if (dt_set_reg(rnode, fb_base, fb_size))
+                bail("FDT: couldn't set the framebuffer reservation\n");
+            if (dt_rename(rnode, "framebuffer", fb_base))
+                bail("FDT: couldn't name the framebuffer reservation\n");
+        }
+        fb = fdt_node_offset_by_compatible(dt, -1, "simple-framebuffer");
+        if (fb < 0)
+            bail("FDT: framebuffer node lost\n");
+    }
+
+    if (dt_set_reg(fb, fb_base, fb_size))
+        bail("FDT: couldn't set framebuffer.reg property\n");
+    if (fdt_setprop_u32(dt, fb, "width", cur_boot_args.video.width))
+        bail("FDT: couldn't set framebuffer width\n");
+    if (fdt_setprop_u32(dt, fb, "height", cur_boot_args.video.height))
+        bail("FDT: couldn't set framebuffer height\n");
+    if (fdt_setprop_u32(dt, fb, "stride", cur_boot_args.video.stride))
+        bail("FDT: couldn't set framebuffer stride\n");
+
+    /* The pixel order stays the board tree's: iBoot's depth does not tell it */
+    switch (cur_boot_args.video.depth & 0xff) {
+        case 32:
+            break;
+        case 16:
+            if (fdt_setprop_string(dt, fb, "format", "r5g6b5"))
+                bail("FDT: couldn't set framebuffer format\n");
+            break;
+        default:
+            printf("FDT: unsupported fb depth %lu, not enabling\n", cur_boot_args.video.depth);
+            return 0;
+    }
+
+    fdt_delprop(dt, fb, "status");
+    if (dt_rename(fb, "framebuffer", fb_base))
+        bail("FDT: couldn't set framebuffer name\n");
+
+    printf("FDT: framebuffer base 0x%lx size 0x%lx\n", fb_base, fb_size);
+    return 0;
+}
+
+static int dt_set_rng_seed(int node)
+{
+    int anode = adt_path_offset(adt, "/chosen");
+    u32 seed_length;
+
+    if (anode < 0)
+        return 0;
+
+    const uint8_t *random_seed = adt_getprop(adt, anode, "random-seed", &seed_length);
+    if (!random_seed || !seed_length) {
+        printf("ADT: no random-seed available!\n");
+        return 0;
+    }
+
+    if (fdt_setprop(dt, node, "rng-seed", random_seed, seed_length))
+        bail("FDT: couldn't set rng-seed\n");
+    printf("FDT: Passing %d bytes of random seed\n", seed_length);
+    return 0;
+}
+
+static int dt_set_chosen(void)
+{
+    int node = fdt_path_offset(dt, "/chosen");
+    if (node < 0)
+        bail("FDT: /chosen node not found in devtree\n");
+
+    for (int i = 0; i < MAX_CHOSEN_PARAMS; i++) {
+        if (!chosen_params[i][0])
+            break;
+
+        const char *name = chosen_params[i][0];
+        const char *value = chosen_params[i][1];
+        if (!value)
+            continue;
+        if (fdt_setprop(dt, node, name, value, strlen(value) + 1) < 0)
+            bail("FDT: couldn't set chosen.%s property\n", name);
+        printf("FDT: %s = '%s'\n", name, value);
+    }
+
+    /* A board tree may carry placeholders; with no initrd they must not point anywhere */
+    u64 start = (u32)initrd_start;
+    u64 end = initrd_size ? start + initrd_size : start;
+    if (initrd_size || fdt_getprop(dt, node, "linux,initrd-start", NULL)) {
+        if (dt_set_cell(node, "linux,initrd-start", start))
+            bail("FDT: couldn't set chosen.linux,initrd-start property\n");
+        if (dt_set_cell(node, "linux,initrd-end", end))
+            bail("FDT: couldn't set chosen.linux,initrd-end property\n");
+    }
+    if (initrd_size) {
+        if (fdt_add_mem_rsv(dt, start, initrd_size))
+            bail("FDT: couldn't add reservation for the initrd\n");
+        printf("FDT: initrd at %p size 0x%zx\n", initrd_start, initrd_size);
+    }
+
+    if (fdt_setprop(dt, node, "asahi,iboot2-version", os_firmware.iboot,
+                    strlen(os_firmware.iboot) + 1))
+        bail("FDT: couldn't set asahi,iboot2-version\n");
+    if (fdt_setprop(dt, node, "asahi,os-fw-version", os_firmware.string,
+                    strlen(os_firmware.string) + 1))
+        bail("FDT: couldn't set asahi,os-fw-version\n");
+    if (fdt_setprop(dt, node, "asahi,m1n1-stage2-version", m1n1_version, strlen(m1n1_version) + 1))
+        bail("FDT: couldn't set asahi,m1n1-stage2-version\n");
+
+    return dt_set_rng_seed(node);
+}
+
+static int dt_set_memory(void)
+{
+    u64 dram_min = cur_boot_args.phys_base;
+    u64 dram_size = cur_boot_args.mem_size;
+
+    int node = fdt_path_offset(dt, "/memory");
+    if (node < 0)
+        bail("FDT: /memory node not found in devtree\n");
+
+    printf("FDT: Usable memory is 0x%lx..0x%lx (0x%lx)\n", dram_min, dram_min + dram_size,
+           dram_size);
+
+    if (dt_set_reg(node, dram_min, dram_size))
+        bail("FDT: couldn't set memory.reg property\n");
+    if (dt_rename(node, "memory", dram_min))
+        bail("FDT: couldn't set the memory node's name\n");
+
+    return 0;
+}
+
+static int dt_set_serial_number(void)
+{
+    u32 sn_len;
+    const char *serial_number = adt_getprop(adt, 0, "serial-number", &sn_len);
+
+    if (!serial_number || !sn_len || !serial_number[0]) {
+        printf("ADT: no serial number\n");
+        return 0;
+    }
+    if (fdt_setprop_string(dt, 0, "serial-number", serial_number))
+        bail("FDT: unable to set device serial number!\n");
+    printf("FDT: reporting device serial number: %s\n", serial_number);
+
+    return 0;
+}
+
+static const struct {
+    const char *alias;
+    const char *fdt_property;
+    bool swap;
+} mac_address_devices[] = {
+    {.alias = "bluetooth0", .fdt_property = "local-bd-address", .swap = true},
+    {.alias = "ethernet0", .fdt_property = "local-mac-address"},
+    {.alias = "wifi0", .fdt_property = "local-mac-address"},
+};
+
+static int dt_set_mac_addresses(void)
+{
+    int anode = adt_path_offset(adt, "/chosen");
+
+    if (anode < 0)
+        bail("ADT: /chosen not found\n");
+
+    for (size_t i = 0; i < ARRAY_SIZE(mac_address_devices); i++) {
+        char propname[32];
+        uint8_t addr[6], zero[6] = {0};
+
+        snprintf(propname, sizeof(propname), "mac-address-%s", mac_address_devices[i].alias);
+        if (ADT_GETPROP_ARRAY(adt, anode, propname, addr) < 0)
+            continue;
+        /* iBoot fills these from the unit's configuration; an unfilled one is no address */
+        if (!memcmp(addr, zero, sizeof(addr)))
+            continue;
+
+        if (mac_address_devices[i].swap) {
+            for (size_t j = 0; j < sizeof(addr) / 2; ++j) {
+                uint8_t tmp = addr[j];
+                addr[j] = addr[sizeof(addr) - j - 1];
+                addr[sizeof(addr) - j - 1] = tmp;
+            }
+        }
+
+        const char *path = fdt_get_alias(dt, mac_address_devices[i].alias);
+        if (path == NULL)
+            continue;
+
+        int node = fdt_path_offset(dt, path);
+        if (node < 0)
+            continue;
+
+        fdt_setprop(dt, node, mac_address_devices[i].fdt_property, addr, sizeof(addr));
+    }
+
+    return 0;
+}
+
+void kboot_set_initrd(void *start, size_t size)
+{
+    initrd_start = start;
+    initrd_size = size;
+}
+
+int kboot_set_chosen(const char *name, const char *value)
+{
+    int i = 0;
+
+    if (!name)
+        return -1;
+
+    for (i = 0; i < MAX_CHOSEN_PARAMS; i++) {
+        if (!chosen_params[i][0]) {
+            chosen_params[i][0] = calloc(strlen(name) + 1, 1);
+            strcpy(chosen_params[i][0], name);
+            break;
+        }
+
+        if (!strcmp(name, chosen_params[i][0])) {
+            free(chosen_params[i][1]);
+            chosen_params[i][1] = NULL;
+            break;
+        }
+    }
+
+    if (i >= MAX_CHOSEN_PARAMS)
+        return -1;
+
+    if (value) {
+        chosen_params[i][1] = calloc(strlen(value) + 1, 1);
+        strcpy(chosen_params[i][1], value);
+    }
+
+    return i;
+}
+
+int kboot_set_uboot(const char *name, const char *value)
+{
+    UNUSED(name);
+    UNUSED(value);
+    return -1;
+}
+
+/* Heap memory at or above the kernel's window, where the decompressor does not write */
+static void *alloc_above_kernel(size_t size, size_t align)
+{
+    u32 floor = (u32)cur_boot_args.phys_base + KERNEL_WINDOW;
+    u32 next = (u32)heapblock_alloc_aligned(0, align);
+
+    if (next < floor)
+        heapblock_alloc_aligned(floor - next, align);
+    return heapblock_alloc_aligned(size, align);
+}
+
+int kboot_prepare_dt(void *fdt)
+{
+    u32 floor = (u32)cur_boot_args.phys_base + KERNEL_WINDOW;
+
+    if (initrd_start && initrd_size && (u32)initrd_start < floor) {
+        void *moved = alloc_above_kernel(initrd_size, SZ_4K);
+
+        printf("FDT: moving the initrd from %p to %p\n", initrd_start, moved);
+        memcpy(moved, initrd_start, initrd_size);
+        initrd_start = moved;
+    }
+
+    dt_bufsize = fdt_totalsize(fdt);
+    assert(dt_bufsize);
+
+    dt_bufsize += DT_SLACK;
+    dt = alloc_above_kernel(dt_bufsize, DT_ALIGN);
+
+    if (fdt_open_into(fdt, dt, dt_bufsize) < 0)
+        bail("FDT: fdt_open_into() failed\n");
+
+    if (fdt_add_mem_rsv(dt, (u32)dt, dt_bufsize))
+        bail("FDT: couldn't add reservation for the devtree\n");
+
+    if (dt_set_chosen())
+        return -1;
+    if (dt_set_fb())
+        return -1;
+    if (dt_set_serial_number())
+        return -1;
+    if (dt_set_mac_addresses())
+        return -1;
+    if (dt_set_memory())
+        return -1;
+
+    if (fdt_pack(dt))
+        bail("FDT: fdt_pack() failed\n");
+
+    printf("FDT prepared at %p\n", dt);
+
+    return 0;
+}
+
+int kboot_boot(void *kernel)
+{
+    u32 base = cur_boot_args.phys_base;
+
+    if (!dt)
+        bail("kboot: no device tree prepared\n");
+    if ((u32)kernel < base || (u32)kernel >= base + KERNEL_WINDOW)
+        bail("kboot: the kernel at %p is outside the first 128 MiB of RAM\n", kernel);
+
+    u32 magic, start, end;
+    memcpy(&magic, (u8 *)kernel + 0x24, 4);
+    memcpy(&start, (u8 *)kernel + 0x28, 4);
+    memcpy(&end, (u8 *)kernel + 0x2c, 4);
+    if (magic != ZIMAGE_MAGIC)
+        bail("kboot: the kernel at %p is not a zImage\n", kernel);
+
+    /*
+     * A kernel built to accept an appended device tree looks for one behind
+     * its own end and prefers it to the one in r2. In a payload the board's
+     * tree, unfilled, can sit exactly there; it has been copied by now.
+     */
+    u8 *behind = (u8 *)kernel + (end - start);
+    if (fdt_magic(behind) == FDT_MAGIC) {
+        printf("kboot: hiding the device tree behind the kernel at %p\n", behind);
+        memset(behind, 0, 4);
+    }
+
+    printf("Preparing to boot kernel at %p with fdt at %p\n", kernel, dt);
+
+    next_stage.entry = kernel;
+    next_stage.args[0] = 0;
+    next_stage.args[1] = 0xffffffff; /* no machine number: the device tree says it all */
+    next_stage.args[2] = (u32)dt;
+    next_stage.args[3] = 0;
+    next_stage.args[4] = 0;
+    next_stage.restore_logo = false;
+
+    return 0;
+}
diff --git a/src/arm32/a32_memory.c b/src/arm32/a32_memory.c
new file mode 100644
index 0000000..8b29cc5
--- /dev/null
+++ b/src/arm32/a32_memory.c
@@ -0,0 +1,282 @@
+/* SPDX-License-Identifier: MIT */
+
+/*
+ * MMU and caches for the 32-bit chips: one first-level table of 1 MiB
+ * sections, everything mapped onto itself. RAM is cached, the device
+ * windows the Apple device tree names are device memory, the rest faults.
+ * The MMU is only on because ARMv7 has no data cache without it.
+ *
+ * A mapping is rounded out to whole sections; where two kinds of memory
+ * share one, the later call decides.
+ */
+
+#include "../memory.h"
+#include "../adt.h"
+#include "../heapblock.h"
+#include "string.h"
+#include "../utils.h"
+#include "../xnuboot.h"
+
+#define SECTION_SHIFT 20
+#define SECTION_SIZE  (1U << SECTION_SHIFT)
+#define SECTIONS      4096
+
+#define SEC_TYPE     0x2
+#define SEC_B        (1U << 2)
+#define SEC_C        (1U << 3)
+#define SEC_XN       (1U << 4)
+#define SEC_AP_RW    (3U << 10)
+#define SEC_TEX(x)   ((u32)(x) << 12)
+#define SEC_AP_RO    (1U << 15)
+
+/* No type extension remap (SCTLR.TRE = 0): TEX, C and B say it directly */
+#define SEC_NORMAL    (SEC_C | SEC_B)
+#define SEC_NORMAL_NC SEC_TEX(1)
+#define SEC_DEVICE    SEC_B
+
+#define SCTLR_TRE (1U << 28)
+#define SCTLR_AFE (1U << 29)
+
+void dcache_invalidate_all(void);
+void mmu_off(void);
+
+uint64_t ram_base = 0;
+
+/*
+ * From the heap: the image is loaded a page into RAM, so a static table
+ * would not keep the 16 KiB alignment the hardware wants.
+ */
+static u32 *pagetable;
+#define PAGETABLE_SIZE (SECTIONS * sizeof(u32))
+
+static u32 cache_line(void)
+{
+    /* CTR.DminLine: log2 of the smallest data cache line, in words */
+    return 4U << ((cp15_read(CP15_CTR) >> 16) & 0xf);
+}
+
+#define CACHE_RANGE_OP(func, ...)                                                                 \
+    void func(void *addr, size_t length)                                                           \
+    {                                                                                              \
+        u32 line = cache_line();                                                                   \
+        u32 p = (u32)addr & ~(line - 1);                                                           \
+        u32 end = (u32)addr + length;                                                              \
+        for (; p < end; p += line)                                                                 \
+            cp15_write(__VA_ARGS__, p);                                                                 \
+        sysop("dsb");                                                                              \
+        sysop("isb");                                                                              \
+    }
+
+CACHE_RANGE_OP(ic_ivau_range, CP15_ICIMVAU)
+CACHE_RANGE_OP(dc_ivac_range, CP15_DCIMVAC)
+CACHE_RANGE_OP(dc_cvac_range, CP15_DCCMVAC)
+CACHE_RANGE_OP(dc_cvau_range, CP15_DCCMVAC)
+CACHE_RANGE_OP(dc_civac_range, CP15_DCCIMVAC)
+
+void dc_zva_range(void *addr, size_t length)
+{
+    memset(addr, 0, length);
+}
+
+void dcsw_op_all(u64 op_type)
+{
+    UNUSED(op_type);
+}
+
+/*
+ * These chips have no cache-coherent DMA. What a device reads or writes
+ * behind the processor's back lives in one uncached section.
+ */
+static u8 *dma_arena;
+static size_t dma_used;
+
+void *dma_alloc(size_t align, size_t size)
+{
+    size_t start = ALIGN_UP(dma_used, align);
+
+    if (!dma_arena || start + size > SECTION_SIZE) {
+        printf("MMU: out of uncached memory (%zu bytes wanted)\n", size);
+        return NULL;
+    }
+    dma_used = start + size;
+    return dma_arena + start;
+}
+
+void dma_release(void)
+{
+    dma_used = 0;
+}
+
+static void tlb_flush(void)
+{
+    cp15_write(CP15_TLBIALL, 0);
+    cp15_write(CP15_BPIALL, 0);
+    sysop("dsb");
+    sysop("isb");
+}
+
+static void map_sections(u64 from, u64 size, u32 attr)
+{
+    u64 end = ALIGN_UP(from + size, SECTION_SIZE);
+    bool live = mmu_active();
+
+    if (end > 0x100000000ULL)
+        end = 0x100000000ULL;
+
+    for (u64 p = ALIGN_DOWN(from, SECTION_SIZE); p < end; p += SECTION_SIZE)
+        pagetable[p >> SECTION_SHIFT] = (u32)p | attr;
+
+    if (live) {
+        /* The table itself is cached memory */
+        dc_cvac_range(pagetable, PAGETABLE_SIZE);
+        tlb_flush();
+    }
+}
+
+void mmu_add_mapping(u64 from, u64 to, size_t size, u8 attribute_index, u64 perms)
+{
+    u32 attr = SEC_TYPE | SEC_AP_RW;
+
+    if (from != to) {
+        printf("MMU: only identity mappings here (0x%lx -> 0x%lx)\n", from, to);
+        return;
+    }
+
+    switch (attribute_index) {
+        case MAIR_IDX_NORMAL:
+            attr |= SEC_NORMAL;
+            break;
+        case MAIR_IDX_NORMAL_NC:
+            attr |= SEC_NORMAL_NC | SEC_XN;
+            break;
+        default:
+            attr |= SEC_DEVICE | SEC_XN;
+            break;
+    }
+    if (perms & PTE_AP_RO)
+        attr |= SEC_AP_RO;
+
+    /* A cached range that turns uncached must not leave lines behind */
+    if (mmu_active() && attribute_index != MAIR_IDX_NORMAL)
+        dc_civac_range((void *)(u32)ALIGN_DOWN(from, SECTION_SIZE),
+                       ALIGN_UP(size + (from & (SECTION_SIZE - 1)), SECTION_SIZE));
+
+    map_sections(from, size, attr);
+}
+
+void mmu_rm_mapping(u64 from, size_t size)
+{
+    map_sections(from, size, 0);
+}
+
+void mmu_map_framebuffer(u64 addr, size_t size)
+{
+    mmu_add_mapping(addr, addr, size, MAIR_IDX_NORMAL_NC, PERM_RW);
+}
+
+/* Every "ranges" entry of /arm-io is a window of device registers */
+static void mmu_map_mmio(void)
+{
+    int node = adt_path_offset(adt, "/arm-io");
+    u32 len = 0;
+    bool mapped = false;
+
+    if (node >= 0) {
+        u32 pa_cells = 2, a_cells = 2, s_cells = 2;
+        const u32 *ranges = adt_getprop(adt, node, "ranges", &len);
+
+        ADT_GETPROP(adt, 0, "#address-cells", &pa_cells);
+        ADT_GETPROP(adt, node, "#address-cells", &a_cells);
+        ADT_GETPROP(adt, node, "#size-cells", &s_cells);
+
+        u32 entry = a_cells + pa_cells + s_cells;
+        for (u32 i = 0; ranges && pa_cells && s_cells && (i + 1) * entry * 4 <= len; i++) {
+            const u32 *r = ranges + i * entry;
+            u64 base = r[a_cells] | (pa_cells > 1 ? (u64)r[a_cells + 1] << 32 : 0);
+            u64 size = r[a_cells + pa_cells] | (s_cells > 1 ? (u64)r[a_cells + pa_cells + 1] << 32 : 0);
+
+            if (!size || base >> 32)
+                continue;
+            printf("MMU: Adding Device mapping 0x%lx (0x%lx)\n", base, size);
+            mmu_add_mapping(base, base, size, MAIR_IDX_DEVICE_nGnRnE, PERM_RW);
+            mapped = true;
+        }
+    }
+
+    if (!mapped)
+        printf("MMU: no /arm-io ranges, no device registers mapped\n");
+}
+
+static void mmu_enable(void)
+{
+    u32 sctlr = cp15_read(CP15_SCTLR);
+
+    dcache_invalidate_all();
+    cp15_write(CP15_ICIALLU, 0);
+    cp15_write(CP15_TTBCR, 0);
+    cp15_write(CP15_TTBR0, (u32)pagetable);
+    cp15_write(CP15_DACR, 1); /* domain 0: client */
+    tlb_flush();
+
+    sctlr &= ~(SCTLR_A | SCTLR_TRE | SCTLR_AFE | SCTLR_TE);
+    sctlr |= SCTLR_M | SCTLR_C | SCTLR_I | SCTLR_Z;
+    cp15_write(CP15_SCTLR, sctlr);
+    sysop("isb");
+}
+
+void mmu_init(void)
+{
+    u64 ram_size = mem_size_actual ? mem_size_actual : cur_boot_args.mem_size;
+
+    printf("MMU: Initializing...\n");
+
+    /* Whatever the boot stage left on goes off first */
+    if (cp15_read(CP15_SCTLR) & (SCTLR_M | SCTLR_C))
+        mmu_off();
+
+    ram_base = cur_boot_args.phys_base;
+    if (!pagetable)
+        pagetable = heapblock_alloc_aligned(PAGETABLE_SIZE, PAGETABLE_SIZE);
+    memset(pagetable, 0, PAGETABLE_SIZE);
+
+    printf("MMU: RAM 0x%lx (0x%lx)\n", ram_base, ram_size);
+    mmu_add_mapping(ram_base, ram_base, ram_size, MAIR_IDX_NORMAL, PERM_RWX);
+    mmu_map_mmio();
+
+    if (!dma_arena)
+        dma_arena = heapblock_alloc_aligned(SECTION_SIZE, SECTION_SIZE);
+    mmu_add_mapping((u32)dma_arena, (u32)dma_arena, SECTION_SIZE, MAIR_IDX_NORMAL_NC, PERM_RW);
+
+    mmu_enable();
+
+    printf("MMU: SCTLR=0x%x\n", cp15_read(CP15_SCTLR));
+    printf("MMU: running with MMU and caches enabled!\n");
+}
+
+void mmu_init_secondary(int cpu)
+{
+    UNUSED(cpu);
+}
+
+void mmu_shutdown(void)
+{
+    printf("MMU: shutting down...\n");
+    mmu_off();
+    printf("MMU: shutdown successful, clearing caches\n");
+}
+
+u64 mmu_disable(void)
+{
+    u32 sctlr = cp15_read(CP15_SCTLR);
+
+    if (!(sctlr & SCTLR_M))
+        return 0;
+    mmu_off();
+    return 1;
+}
+
+void mmu_restore(u64 state)
+{
+    if (state && !mmu_active())
+        mmu_enable();
+}
diff --git a/src/arm32/a32_start.S b/src/arm32/a32_start.S
new file mode 100644
index 0000000..9007cc9
--- /dev/null
+++ b/src/arm32/a32_start.S
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+
+/*
+ * Entry from the 32-bit iBoot, which starts m1n1 as its kernel: ARM state,
+ * MMU and caches off, r0 = boot arguments (physical). m1n1 is linked at 0
+ * and runs wherever iBoot put it.
+ */
+
+.syntax unified
+.arm
+
+.section .init, "ax"
+
+.globl _start
+.type _start, %function
+_start:
+    cpsid   aif, #0x13          @ SVC, IRQ/FIQ/abort masked
+    mov     r8, r0              @ boot arguments
+
+    /* A word holding a symbol reads as its link address until it is relocated */
+    adr     r4, _start
+    ldr     r5, .L_start
+    sub     r9, r4, r5          @ r9 = where the image really starts
+
+    ldr     r0, .L_stack_bot
+    add     sp, r0, r9
+
+    mov     r0, r9
+    ldr     r1, .L_rel_start
+    add     r1, r1, r9
+    ldr     r2, .L_rel_end
+    add     r2, r2, r9
+    bl      apply_rel
+
+    mov     r0, r8
+    mov     r1, r9
+    bl      _start_c
+1:  b       1b
+
+.align 2
+.L_start:       .word _start
+.L_stack_bot:   .word _stack_bot
+.L_rel_start:   .word _rel_start
+.L_rel_end:     .word _rel_end
+
+.globl reboot
+.type reboot, %function
+reboot:
+    bl      wdt_reboot
+1:  b       1b
+
+/*
+ * void next_stage_enter(void *entry, u32 r0, u32 r1, u32 r2)
+ * Jump to the next stage with the first three argument registers set.
+ */
+.globl next_stage_enter
+.type next_stage_enter, %function
+next_stage_enter:
+    mov     r12, r0
+    mov     r0, r1
+    mov     r1, r2
+    mov     r2, r3
+    bx      r12
diff --git a/src/arm32/a32_startup.c b/src/arm32/a32_startup.c
new file mode 100644
index 0000000..3c6831d
--- /dev/null
+++ b/src/arm32/a32_startup.c
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "../adt.h"
+#include "../exception.h"
+#include "../firmware.h"
+#include "../smp.h"
+#include "string.h"
+#include "../types.h"
+#include "../uart.h"
+#include "../utils.h"
+#include "../xnuboot.h"
+
+/* What the 32-bit iBoot passes its kernel (XNU pexpert/arm/boot.h, revision 1) */
+struct boot_args32 {
+    u16 revision;
+    u16 version;
+    u32 virt_base;
+    u32 phys_base;
+    u32 mem_size;
+    u32 top_of_kernel_data;
+    struct {
+        u32 base;
+        u32 display;
+        u32 stride;
+        u32 width;
+        u32 height;
+        u32 depth;
+    } video;
+    u32 machine_type;
+    u32 devtree;
+    u32 devtree_size;
+    char cmdline[CMDLINE_LENGTH_RV1];
+    u32 boot_flags;
+    u32 mem_size_actual;
+};
+
+u64 boot_args_addr;
+struct boot_args cur_boot_args;
+void *adt;
+u64 boot_flags, mem_size_actual;
+
+struct rel_entry {
+    u32 off, info;
+};
+
+void m1n1_main(void);
+void get_device_info(void);
+void time_init(void);
+void apply_rel(u32 base, struct rel_entry *rel_start, struct rel_entry *rel_end);
+void _start_c(void *boot_args, void *base);
+
+extern char _bss_start[0];
+extern char _bss_end[0];
+
+#define R_ARM_NONE     0
+#define R_ARM_RELATIVE 23
+
+/* Runs before relocation: no globals, no calls */
+void apply_rel(u32 base, struct rel_entry *rel_start, struct rel_entry *rel_end)
+{
+    for (struct rel_entry *e = rel_start; e < rel_end; e++) {
+        u32 type = e->info & 0xff;
+
+        if (type == R_ARM_NONE)
+            continue; /* left behind by sections the linker dropped */
+        if (type != R_ARM_RELATIVE)
+            while (1)
+                ;
+        *(u32 *)(base + e->off) += base;
+    }
+}
+
+static void dump_boot_args(struct boot_args *ba)
+{
+    printf("  revision:     %d\n", ba->revision);
+    printf("  version:      %d\n", ba->version);
+    printf("  virt_base:    0x%lx\n", ba->virt_base);
+    printf("  phys_base:    0x%lx\n", ba->phys_base);
+    printf("  mem_size:     0x%lx\n", ba->mem_size);
+    printf("  top_of_kdata: 0x%lx\n", ba->top_of_kernel_data);
+    printf("  video:\n");
+    printf("    base:       0x%lx\n", ba->video.base);
+    printf("    display:    0x%lx\n", ba->video.display);
+    printf("    stride:     0x%lx\n", ba->video.stride);
+    printf("    width:      %lu\n", ba->video.width);
+    printf("    height:     %lu\n", ba->video.height);
+    printf("    depth:      %lubpp\n", ba->video.depth & 0xff);
+    printf("    density:    %lu\n", ba->video.depth >> 16);
+    printf("  machine_type: %d\n", ba->machine_type);
+    printf("  devtree:      %p\n", ba->devtree);
+    printf("  devtree_size: 0x%x\n", ba->devtree_size);
+    printf("  cmdline:      %s\n", ba->rv1.cmdline);
+    printf("  boot_flags:   0x%lx\n", ba->rv1.boot_flags);
+    printf("  mem_size_act: 0x%lx\n", ba->rv1.mem_size_actual);
+
+    boot_flags = ba->rv1.boot_flags;
+    mem_size_actual = ba->rv1.mem_size_actual;
+    if (!mem_size_actual) {
+        /* The usable size stops short of what iBoot keeps at the top (framebuffer) */
+        mem_size_actual = ALIGN_UP(ba->mem_size, BIT(26));
+        printf("Correcting mem_size_actual to 0x%lx\n", mem_size_actual);
+    }
+}
+
+void _start_c(void *boot_args, void *base)
+{
+    UNUSED(base);
+    struct boot_args32 *ba = boot_args;
+
+    memset(_bss_start, 0, _bss_end - _bss_start);
+    boot_args_addr = (u32)boot_args;
+
+    /* The shared code reads the 64-bit shape of the boot arguments */
+    cur_boot_args.revision = ba->revision;
+    cur_boot_args.version = ba->version;
+    cur_boot_args.virt_base = ba->virt_base;
+    cur_boot_args.phys_base = ba->phys_base;
+    cur_boot_args.mem_size = ba->mem_size;
+    cur_boot_args.top_of_kernel_data = ba->top_of_kernel_data;
+    cur_boot_args.video.base = ba->video.base;
+    cur_boot_args.video.display = ba->video.display;
+    cur_boot_args.video.stride = ba->video.stride;
+    cur_boot_args.video.width = ba->video.width;
+    cur_boot_args.video.height = ba->video.height;
+    cur_boot_args.video.depth = ba->video.depth;
+    cur_boot_args.machine_type = ba->machine_type;
+    cur_boot_args.devtree = (void *)ba->devtree;
+    cur_boot_args.devtree_size = ba->devtree_size;
+    memcpy(cur_boot_args.rv1.cmdline, ba->cmdline, sizeof(ba->cmdline));
+    cur_boot_args.rv1.boot_flags = ba->boot_flags;
+    cur_boot_args.rv1.mem_size_actual = ba->mem_size_actual;
+
+    adt = (void *)(ba->devtree - ba->virt_base + ba->phys_base);
+
+    cp15_write(CP15_TPIDRPRW, 0);
+
+    exception_initialize();
+
+    int ret = uart_init();
+    UNUSED(ret);
+
+    uart_puts("Initializing");
+    get_device_info();
+    time_init();
+
+    printf("CPU init (MIDR: 0x%x)...\n", cp15_read(CP15_MIDR));
+    printf("boot_args at %p\n", boot_args);
+
+    dump_boot_args(&cur_boot_args);
+    printf("\n");
+
+    m1n1_main();
+}
