#!/usr/bin/env python3
"""Make a J71t opt-in loader by appending m1n1's psci=1 payload variable.

Use a bare m1n1.bin as input, before assembling any kernel/DTB/logo payload.
The output works with orchard run/build --loader or launch's loaders/m1n1.bin.
It still uses the spin table if m1n1 was entered at EL1.
"""
import argparse
from pathlib import Path
import shutil


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--device', required=True, choices=('j71t',))
    parser.add_argument('--loader', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    if not args.loader.is_file() or not args.loader.stat().st_size:
        parser.error('input must be a nonempty bare m1n1.bin')
    # Exclusive creation: never replace the original or another boot artifact.
    with args.loader.open('rb') as source, args.output.open('xb') as output:
        shutil.copyfileobj(source, output)
        output.write(b'psci=1\n')
    print(args.output)


if __name__ == '__main__':
    main()
