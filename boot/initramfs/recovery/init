#!/bin/busybox sh
# RAM-only Orchard recovery. No internal storage is mounted or written.
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
cd /
/bin/busybox --install -s
mount -t proc -o nodev,noexec,nosuid proc /proc
mount -t sysfs -o nodev,noexec,nosuid sysfs /sys
mount -t devtmpfs -o mode=0755,nosuid dev /dev
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mkdir -p /dev/pts /run/recovery /run/orchard
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
exec </dev/console >/dev/console 2>&1

board=$(tr '\000' '\n' < /proc/device-tree/compatible | head -1)
case "$board" in
apple,*) ;;
*) echo "Not an Apple device for Orchard recovery: $board"; exec sh ;;
esac
# Serial survives networking failures and repeated USB enumeration.
(
    while true; do getty -n -l /bin/sh ttyGS0 115200 vt100; sleep 1; done
) &
if ! /sbin/recovery-usb > /run/orchard/usb.log 2>&1; then
    echo 'Recovery USB setup failed; inspect /run/orchard/usb.log.'
    while :; do sleep 60; done
fi
if ip address add 172.16.42.1/30 dev usb0 && ip link set usb0 up; then
    udhcpd -f /etc/udhcpd.conf &
else
    echo 'Recovery networking failed; USB serial remains available.'
fi
echo "${board#apple,} recovery: USB serial ready; provision an SSH key before SSH starts."
if storage=$(/usr/bin/python3 /usr/libexec/orchard/policy.py storage); then
    if [ "$storage" = automatic ]; then
        /usr/libexec/orchard/storage-fence > /run/orchard/storage.log 2>&1 &
    else
        echo manual > /run/orchard/storage-manual
        echo 'Storage waits for a manual request after serial and authenticated SSH are ready.'
    fi
else
    echo 'Recovery storage policy failed; storage remains unloaded.'
fi
# After an install, `orchard-device start` asks for the new root: if its boot
# entry boots this same kernel, PID 1 switches into it, so the first start
# needs no second DFU boot. Later starts go through the entry (orchard launch).
while :; do
    if [ -e /run/orchard/start.json ]; then
        if /usr/bin/python3 /usr/libexec/orchard/start.py > /run/orchard/start.log 2>&1; then
            # From here on the host sees the system, not a recovery (mode "system").
            g=/sys/kernel/config/usb_gadget/linux-recovery
            name=$(sed -n 's/^NAME=//p' /newroot/etc/os-release /newroot/usr/lib/os-release 2>/dev/null | head -1 | tr -d "\"'")
            udc=$(cat "$g/UDC")
            { echo '' > "$g/UDC" && echo 0x4145 > "$g/idProduct" &&
              echo "${name:-Linux}" > "$g/strings/0x409/product" && echo "$udc" > "$g/UDC"; } 2>/dev/null || true
            kill -TERM -- -1 2>/dev/null || true
            sleep 1
            kill -KILL -- -1 2>/dev/null || true
            for name in dev proc sys run; do mount --move "/$name" "/newroot/$name"; done
            exec switch_root /newroot /sbin/init
        fi
        mv /run/orchard/start.json /run/orchard/start.failed
    fi
    sleep 1
done
