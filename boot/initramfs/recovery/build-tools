#!/usr/bin/env bash
# Acquire pinned public inputs and build static recovery tools for the selected ARM architecture.
set -euo pipefail
# Recipes need only Python 3.11+ and its standard library; Orchard passes its own.
python=${ORCHARD_PYTHON:-python3}
arch=arm64
while [[ $# -gt 0 ]]; do
  case "$1" in
    --arch) [[ $# -ge 2 ]] || { echo '--arch needs arm or arm64' >&2; exit 1; }; arch=$2; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done
case "$arch" in arm|arm64) ;; *) echo '--arch needs arm or arm64' >&2; exit 1 ;; esac
here=$(cd "$(dirname "$0")" && pwd)
work="${OMA_RECOVERY_TOOLS_WORK:-$here/.work/tools-$arch}"
mkdir -p "$work"
"$python" - "$here/upstream.lock" "$work" "$arch" <<'PY'
import hashlib
import json
import pathlib
import sys
import tempfile
import urllib.request

lock = json.loads(pathlib.Path(sys.argv[1]).read_text())
work = pathlib.Path(sys.argv[2])
for component, filename in (('busybox', 'busybox.deb'),
                            ('dropbear', 'dropbear.tar.bz2'),
                            ('libnl', 'libnl.tar.gz'),
                            ('wpa_supplicant', 'wpa_supplicant.tar.gz'),
                            ('iw', 'iw.tar.xz'),
                            ('zstd', 'zstd.tar.gz'),
                            ('e2fsprogs', 'e2fsprogs.tar.gz')):
    key = 'busybox_arm' if component == 'busybox' and sys.argv[3] == 'arm' else component
    item = lock[key]
    target = work / filename
    if target.exists():
        source = target.open('rb')
    else:
        temporary = tempfile.NamedTemporaryFile(dir=work, prefix=filename + '.', delete=False)
        try:
            with urllib.request.urlopen(item['url']) as response, temporary:
                for block in iter(lambda: response.read(1024 * 1024), b''):
                    temporary.write(block)
            source = pathlib.Path(temporary.name).open('rb')
        except BaseException:
            pathlib.Path(temporary.name).unlink(missing_ok=True)
            raise
    with source:
        digest = hashlib.sha256()
        for block in iter(lambda: source.read(1024 * 1024), b''):
            digest.update(block)
    if digest.hexdigest() != item['sha256']:
        if not target.exists():
            pathlib.Path(temporary.name).unlink(missing_ok=True)
        raise SystemExit(f'{component} checksum differs from upstream.lock')
    if not target.exists():
        pathlib.Path(temporary.name).rename(target)
    print(f'Verified {component}: {target}')
PY
image=localhost/orchard-hardware-recovery-tools:bookworm
[[ "$arch" == arm64 ]] || image=localhost/orchard-hardware-recovery-tools-arm:bookworm
"$python" "$here/../../../src/orchard/buildenv.py" build --arch "$arch" --file "$here/Containerfile" \
  --image "$image" --context "$here"
"$python" "$here/../../../src/orchard/buildenv.py" run --arch "$arch" \
  --bind "$work:/work:rw" --bind "$here:/recipe:ro" --env "ORCHARD_RECOVERY_ARCH=$arch" \
  --image "$image" -- bash /recipe/build-tools-in-container
echo "Recovery tools: $work/bin"
