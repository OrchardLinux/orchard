#!/bin/bash
set -euo pipefail
work=${ORCHARD_WORK:-/work}
recipe=${ORCHARD_RECIPE:-/recipe}
arch=${ORCHARD_RECOVERY_ARCH:-arm64}
case "$arch" in arm) deb_arch=armhf ;; arm64) deb_arch=arm64 ;; *) echo 'Unsupported recovery architecture' >&2; exit 1 ;; esac
[[ ! -e "$work/bin" ]] || { echo 'Tool output exists; choose a fresh work directory' >&2; exit 1; }
build=$(mktemp -d "$work/build.XXXXXX")
mkdir "$build/bin"

# Static musl avoids the installed system's NSS/libc ABI.
export CC=musl-gcc
# musl-gcc searches no glibc headers; give it the kernel UAPI headers only.
kernel_headers="$build/kernel-headers"
mkdir "$kernel_headers"
host=()
if [[ $arch == arm && $(uname -m) != armv7* ]]; then
  # ARMv7 on any other machine is cross-compiled (install-toolchain --cross arm):
  # Apple and most ARM64 hosts cannot run 32-bit ARM code at all.
  cat > "$build/arm-musl-gcc" <<'CC'
#!/bin/sh
exec arm-linux-gnueabihf-gcc "$@" -specs /usr/lib/arm-linux-musleabihf/musl-gcc.specs
CC
  chmod 755 "$build/arm-musl-gcc"
  export CC="$build/arm-musl-gcc" AR=arm-linux-gnueabihf-ar RANLIB=arm-linux-gnueabihf-ranlib
  host=(--host=arm-linux-musleabihf)
  ln -s /usr/arm-linux-gnueabihf/include/linux /usr/arm-linux-gnueabihf/include/asm-generic \
    /usr/arm-linux-gnueabihf/include/asm "$kernel_headers/"
else
  ln -s /usr/include/linux /usr/include/asm-generic "$kernel_headers/"
  ln -s "/usr/include/$(gcc -dumpmachine)/asm" "$kernel_headers/asm"
fi
export CFLAGS="-Os -isystem $kernel_headers"

tar -xjf "$work/dropbear.tar.bz2" -C "$build"
(
  cd "$build/dropbear-2026.94"
  printf '%s\n' '#define DROPBEAR_SVR_PASSWORD_AUTH 0' '#define DROPBEAR_SVR_PAM_AUTH 0' > localoptions.h
  ./configure ${host[@]+"${host[@]}"} --enable-static --disable-zlib
  make -j2 PROGRAMS='dropbear dropbearkey'
  cp dropbear dropbearkey "$build/bin/"
)

# Wi-Fi: libnl for the nl80211 interface, then wpa_supplicant (WPA2-PSK with
# its internal crypto, no OpenSSL) and iw, all linked statically.
libnl="$build/libnl"
tar -xzf "$work/libnl.tar.gz" -C "$build"
(
  cd "$build/libnl-3.11.0"
  ./configure ${host[@]+"${host[@]}"} --prefix="$libnl" --enable-static --disable-shared --disable-cli --disable-debug
  make -j2
  make install
)
export PKG_CONFIG_PATH="$libnl/lib/pkgconfig"

tar -xzf "$work/wpa_supplicant.tar.gz" -C "$build"
(
  cd "$build/wpa_supplicant-2.11/wpa_supplicant"
  cat > .config <<'CONFIG'
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_NO_CONFIG_WRITE=y
CONFIG_SME=y
CONFIG_IEEE80211W=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG
  make -j2 EXTRA_CFLAGS="$CFLAGS -I$libnl/include/libnl3" LDFLAGS="-static -L$libnl/lib" \
    wpa_supplicant wpa_cli
  cp wpa_supplicant wpa_cli "$build/bin/"
)

tar -xJf "$work/iw.tar.xz" -C "$build"
(
  cd "$build/iw-6.9"
  make -j2 LDFLAGS=-static
  cp iw "$build/bin/"
)

# The installer's writer and the tools that finish a restored root, on any system.
tar -xzf "$work/zstd.tar.gz" -C "$build"
make -C "$build/zstd-1.5.7/lib" -j2 libzstd.a CC="$CC" ZSTD_LEGACY_SUPPORT=0
$CC $CFLAGS -static -Wall -Wextra -pthread -I"$build/zstd-1.5.7/lib" -o "$build/bin/orchard-write" \
  "$recipe/orchard-write.c" "$build/zstd-1.5.7/lib/libzstd.a"
tar -xzf "$work/e2fsprogs.tar.gz" -C "$build"
(
  cd "$build/e2fsprogs-1.47.4"
  ./configure -q ${host[@]+"${host[@]}"} LDFLAGS=-static --disable-nls --disable-fuse2fs --disable-e2initrd-helper --disable-uuidd
  make -j2 libs
  make -j2 -C resize resize2fs
  make -j2 -C misc tune2fs
  cp resize/resize2fs misc/tune2fs "$build/bin/"
)

[[ $(dpkg-deb -f "$work/busybox.deb" Architecture) == "$deb_arch" ]] || {
  echo 'BusyBox package architecture differs from the target' >&2; exit 1;
}

dpkg-deb -x "$work/busybox.deb" "$build/package"
cp "$build/package/bin/busybox" "$build/bin/busybox"
chmod 755 "$build/bin/"*
python3 "$recipe/check-tools.py" --arch "$arch" "$build/bin/"*
mv "$build/bin" "$work/bin"
echo "Static recovery tools copied to $work/bin"
