+/* Orchard: bounded I/O and one sleep request. */
+#define ORCHARD_MAX_KERNEL_REGIONS 65536u
+#define ORCHARD_HANDOFF_WAIT_SECONDS 90u
+#define ORCHARD_KERNEL_DUMP_BYTES 0xd00000u
+#define ORCHARD_KERNEL_HEADER_BYTES 0x1000u
+#define ORCHARD_KERNEL_READ_BYTES 2048u
+
+static kern_return_t orchard_read_exact(task_t task, vm_address_t address,
+                                       vm_size_t length, pointer_t *buffer,
+                                       mach_msg_type_number_t *size)
+{
+    *buffer = 0;
+    *size = 0;
+    kern_return_t result = vm_read(task, address, length, buffer, size);
+    if (result != KERN_SUCCESS || !*buffer || *size != length) {
+        if (*buffer && *size)
+            vm_deallocate(mach_task_self(), *buffer, *size);
+        *buffer = 0;
+        *size = 0;
+        return KERN_FAILURE;
+    }
+    return KERN_SUCCESS;
+}
+
+static kern_return_t orchard_dump_kernel(task_t task, vm_address_t base,
+                                        uint8_t *destination)
+{
+    if (base > UINT32_MAX - ORCHARD_KERNEL_DUMP_BYTES)
+        return KERN_FAILURE;
+    for (uint32_t offset = ORCHARD_KERNEL_HEADER_BYTES;
+         offset < ORCHARD_KERNEL_DUMP_BYTES; offset += ORCHARD_KERNEL_READ_BYTES) {
+        pointer_t buffer = 0;
+        mach_msg_type_number_t size = 0;
+        if (orchard_read_exact(task, base + offset, ORCHARD_KERNEL_READ_BYTES,
+                               &buffer, &size) != KERN_SUCCESS)
+            return KERN_FAILURE;
+        bcopy((const void *)buffer,
+              destination + offset - ORCHARD_KERNEL_HEADER_BYTES, size);
+        vm_deallocate(mach_task_self(), buffer, size);
+    }
+    return KERN_SUCCESS;
+}
+
+static kern_return_t orchard_sleep_once(void)
+{
+    mach_port_t port = IOPMFindPowerManagement(MACH_PORT_NULL);
+    if (port == MACH_PORT_NULL)
+        return KERN_FAILURE;
+    kern_return_t result = IOPMSleepSystem(port);
+    mach_port_deallocate(mach_task_self(), port);
+    return result;
+}
+static kern_return_t orchard_handoff_once(void)
+{
+    kern_return_t result = orchard_sleep_once();
+    if (result != KERN_SUCCESS)
+        return result;
+    /* Keep the parent's owned wake event alive while iOS enters sleep. */
+    sleep(ORCHARD_HANDOFF_WAIT_SECONDS);
+    return KERN_FAILURE;
+}
+/* End Orchard bounded I/O. */
