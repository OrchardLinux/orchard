#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Build the ARM32 staging loader from source and check its executable entry."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'src'))
from orchard import buildenv
from orchard.image.cascadia import digest, profile, verify_loader


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--profile', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    described = profile(args.profile)
    out = args.output.resolve()
    if out.is_symlink() or (out.exists() and (not out.is_dir() or any(out.iterdir()))):
        parser.error('The loader output must be a new or empty directory')
    out.mkdir(parents=True, exist_ok=True)
    (out / 'cascadia-generated.h').write_text(''.join(
        f'#define {name.upper()} {hex(value)}\n' for name, value in sorted(described.items()) if name != 'schema'))
    template = (ROOT / 'boot/cascadia/linux-boot.ld.in').read_text()
    (out / 'linux-boot.ld').write_text(template.replace('@LOAD_ADDRESS@', hex(described['load_address'])))
    image = 'localhost/orchard-hardware-kernel-toolchain:bookworm'
    buildenv.build(image, ROOT / 'kernel/Containerfile', ROOT / 'kernel')
    buildenv.run(image, ['sh', '/src/boot/cascadia/compile', '/out'],
                 [(ROOT, '/src', True), (out, '/out', False)])
    binary, elf = (out / 'loader.bin').read_bytes(), (out / 'loader.elf').read_bytes()
    verify_loader(binary, described, elf)
    source = ROOT / 'boot/cascadia'
    receipt = {'schema': 1, 'kind': 'cascadia-loader', 'architecture': 'arm',
               'loader_format': 'cascadia', 'profile_sha256': digest(args.profile.read_bytes()),
               'toolchain': buildenv.identity(image),
               'sources': {path.name: digest(path.read_bytes()) for path in sorted(source.iterdir()) if path.is_file()},
               'loader': {'bytes': len(binary), 'sha256': digest(binary)},
               'elf': {'bytes': len(elf), 'sha256': digest(elf)},
               'entry': described['load_address'], 'hardware_boot_verified': False}
    (out / 'loader.json').write_text(json.dumps(receipt, indent=2, sort_keys=True) + '\n')
    for name in ('linux_boot.o', 'linux_boot_start.o', 'cascadia-generated.h', 'linux-boot.ld'):
        (out / name).unlink()
    print(f'Loader: {out / "loader.bin"}')


if __name__ == '__main__':
    main()
