{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hardware device descriptor v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "hardware.device"
    },
    "device": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "apple_products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^i(?:Pad|Phone|Pod)[0-9]+,[0-9]+$"
          }
        },
        "dt_compatible": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "profile",
        "name",
        "apple_products"
      ],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "dfu": {
          "type": "object",
          "properties": {
            "chip": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "board": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "chip",
            "board"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dfu"
      ],
      "additionalProperties": false
    },
    "boot": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "methods"
      ],
      "additionalProperties": false
    },
    "kernel": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "dtb": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        }
      },
      "required": [
        "platform",
        "dtb"
      ],
      "additionalProperties": false
    },
    "firmware": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "recipe"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "reclaims": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "supported",
            "experimental"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "display": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "screen_off": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "backlight": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "touch": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "buttons": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "accelerometer": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "gyroscope": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "light_sensor": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "touch_id": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "storage_read": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "storage_write": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "wifi": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "bluetooth_input": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "bluetooth_audio": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "cellular": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "battery": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "charging": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "charging_control": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "suspend": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "resume": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "usb_serial": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "usb_network": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "audio_output": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "audio_input": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        },
        "camera": {
          "enum": [
            "working",
            "untested",
            "missing",
            "none"
          ]
        }
      },
      "required": [
        "display",
        "screen_off",
        "backlight",
        "touch",
        "buttons",
        "accelerometer",
        "gyroscope",
        "light_sensor",
        "touch_id",
        "storage_read",
        "storage_write",
        "wifi",
        "bluetooth_input",
        "bluetooth_audio",
        "cellular",
        "battery",
        "charging",
        "charging_control",
        "suspend",
        "resume",
        "usb_serial",
        "usb_network",
        "audio_output",
        "audio_input",
        "camera"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "description": "Facts about a board with no [kernel] yet.",
      "properties": {
        "dtb": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "kind",
    "device",
    "match"
  ],
  "additionalProperties": false,
  "if": {
    "required": [
      "kernel"
    ]
  },
  "then": {
    "required": [
      "boot",
      "firmware",
      "support",
      "features"
    ],
    "properties": {
      "device": {
        "required": [
          "dt_compatible"
        ]
      }
    }
  }
}
