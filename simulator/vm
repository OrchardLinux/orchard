#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# The window passes its VM's directory; otherwise the one beside this script.
D=$(CDPATH= cd -- "${ORCHARD_VM_DIR:-$HERE/../out/simulator/vm}" 2>/dev/null && pwd) || { echo 'VM is not prepared.' >&2; exit 1; }
QEMU=/opt/glustore/bin/qemu-system-aarch64
running() {
    [ -f "$D/qemu.pid" ] || return 1
    pid=$(cat "$D/qemu.pid")
    case "$pid" in *[!0-9]*|'') return 1;; esac
    command=$(ps -p "$pid" -o command= 2>/dev/null || true)
    case "$command" in *qemu-system-aarch64*"$D/root.raw"*) return 0;; *) return 1;; esac
}
case "${1:-status}" in
  start)
    if running; then echo "VM already running (PID $pid)"; exit 0; fi
    [ -x "$QEMU" ] || { echo 'Install qemu using glu first.' >&2; exit 1; }
    [ -f "$D/root.raw" ] && [ -f "$D/vmlinuz" ] || { echo 'VM disk/kernel not prepared.' >&2; exit 1; }
    # The simulated device fixes the virtual panel, as a real one does.
    case "$(cat "$D/device" 2>/dev/null || echo ipad6)" in
      iphone7) panel='xres=750,yres=1334' ;;
      *) panel='xres=1536,yres=2048' ;;
    esac
    umask 077
    rm -f "$D/qmp.sock" "$D/agent.sock" "$D/viewer.sock" "$D/display.sock" "$D/control.sock"
    nohup "$QEMU" -machine virt,accel=hvf -cpu host -m 4096 -smp 4 \
      -kernel "$D/vmlinuz" -append 'root=/dev/vda rootwait rw console=ttyAMA0 quiet fbcon=map:9 vt.global_cursor_default=0' \
      -drive "file=$D/root.raw,format=raw,if=virtio" \
      -device virtio-gpu-pci,$panel -device qemu-xhci -device usb-tablet -device virtio-multitouch-pci -device virtio-keyboard-pci \
      -device virtio-serial-pci -chardev "socket,id=screen,path=$D/display.sock,server=on,wait=off" \
      -device virtserialport,chardev=screen,name=org.orchard.display \
      -chardev "socket,id=control,path=$D/control.sock,server=on,wait=off" \
      -device virtserialport,chardev=control,name=org.orchard.control \
      -netdev user,id=guestnet,hostfwd=tcp:127.0.0.1:2228-:22 -device virtio-net-pci,netdev=guestnet,mac=52:54:00:71:00:01 \
      -display dbus,p2p=yes -qmp "unix:$D/viewer.sock,server=on,wait=off" -qmp "unix:$D/qmp.sock,server=on,wait=off" -qmp "unix:$D/agent.sock,server=on,wait=off" \
      -serial "file:$D/serial.log" -no-reboot > "$D/qemu.log" 2>&1 &
    echo $! > "$D/qemu.pid"
    sleep 1
    running || { echo "VM failed to start; see $D/qemu.log" >&2; exit 1; }
    echo "VM started (PID $pid)"
    ;;
  status)
    if running; then echo "VM running (PID $pid)"; else echo 'VM stopped'; exit 1; fi
    ;;
  stop)
    if ! running; then echo 'VM is not running'; exit 0; fi
    python3 - "$D/control.sock" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(4)
s.connect(sys.argv[1])
s.sendall(b'shutdown\n')
s.close()
PY
    for i in $(seq 1 30); do if ! running; then echo 'VM stopped cleanly'; rm -f "$D/qemu.pid"; exit 0; fi; sleep 1; done
    echo 'Shutdown request sent, but VM is still running; not forcing it off.' >&2
    exit 1
    ;;
  kill)
    # Power off at once, like pulling the plug; the guest gets no shutdown.
    if ! running; then echo 'VM is not running'; exit 0; fi
    python3 - "$D/qmp.sock" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(4)
s.connect(sys.argv[1])
s.recv(4096)
s.sendall(b'{"execute":"qmp_capabilities"}\n')
s.recv(4096)
s.sendall(b'{"execute":"quit"}\n')
s.close()
PY
    for i in $(seq 1 10); do if ! running; then echo 'VM forced off'; rm -f "$D/qemu.pid"; exit 0; fi; sleep 1; done
    echo 'VM is still running' >&2
    exit 1
    ;;
  desktop)
    # gpu: the tablets' GPU desktop on software OpenGL (the default); software: the desktop of a board without one.
    case "${2:-}" in gpu|software) ;; *) echo "Usage: $0 desktop {gpu|software}" >&2; exit 2;; esac
    running || { echo 'VM is not running' >&2; exit 1; }
    python3 - "$D/control.sock" "$2" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(4)
s.connect(sys.argv[1])
s.sendall(b'desktop ' + sys.argv[2].encode() + b'\n')
s.close()
PY
    printf '%s\n' "$2" > "$D/desktop"
    echo "Desktop: $2 (the session restarts)"
    ;;
  orientation)
    # Which edge is up as the window holds the device; the VM accelerometer
    # reports the matching gravity.
    case "${2:-}" in normal|left-up|right-up|bottom-up) ;; *) echo "Usage: $0 orientation {normal|left-up|right-up|bottom-up}" >&2; exit 2;; esac
    running || { echo 'VM is not running' >&2; exit 1; }
    python3 - "$D/control.sock" "$2" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(4)
s.connect(sys.argv[1])
s.sendall(b'orientation ' + sys.argv[2].encode() + b'\n')
s.close()
PY
    ;;
  device)
    # The simulated device: its panel is fixed when the VM starts, so a
    # running VM restarts with the new one (same disk, same install).
    case "${2:-}" in ipad6|iphone7) ;; *) echo "Usage: $0 device {ipad6|iphone7}" >&2; exit 2;; esac
    # Recorded only once the old VM is down, so a failed stop changes nothing.
    if running; then "$0" stop; printf '%s\n' "$2" > "$D/device"; "$0" start
    else printf '%s\n' "$2" > "$D/device"; fi
    echo "Device: $2"
    ;;
  *) echo "Usage: $0 {start|stop|kill|status|desktop gpu|software|orientation EDGE|device ipad6|iphone7}" >&2; exit 2;;
esac
